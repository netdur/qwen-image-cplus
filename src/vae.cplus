struct OwnedObjc {
    opaque pointer: *u8,
}

#[repr(C)]
struct MappedDeallocatorBlock {
    opaque isa: *u8,
    flags: i32,
    reserved: i32,
    invoke: fn(*u8, *u8, u64),
    opaque descriptor: *u8,
}

static MAPPED_DEALLOCATOR_DESCRIPTOR: rt::BlockDescriptor = rt::BlockDescriptor {
    reserved: 0 as u64,
    size: 32 as u64,
};

fn mapped_deallocator_invoke(_block: *u8, _pointer: *u8, _length: u64) {}

impl OwnedObjc {
    fn new(pointer: *u8) -> OwnedObjc {
        return OwnedObjc { pointer: pointer };
    }

    fn raw(this) -> *u8 {
        return this.pointer;
    }

    fn drop(ref this) {
        if !this.pointer.is_null() {
            rt::release(this.pointer);
            this.pointer = 0 as *u8;
        }
    }
}

#[repr(C)]
struct ConvParams {
    input_height: u32,
    input_width: u32,
    input_channels: u32,
    output_height: u32,
    output_width: u32,
    output_channels: u32,
    kernel_size: u32,
    padding: u32,
    upsample: u32,
}

#[repr(C)]
struct NormParams {
    pixels: u32,
    channels: u32,
    silu: u32,
}

#[repr(C)]
struct DupParams {
    input_height: u32,
    input_width: u32,
    input_channels: u32,
    output_channels: u32,
    factor_t: u32,
    repeats: u32,
}

#[repr(C)]
struct ElementParams {
    elements: u32,
    channels: u32,
}

struct ConvWeight {
    weight_offset: u64,
    bias_offset: u64,
}

struct Pipelines {
    conv: metal::ComputePipelineState,
    upsample_pack: metal::ComputePipelineState,
    upsample_conv: metal::ComputePipelineState,
    norm: metal::ComputePipelineState,
    add: metal::ComputePipelineState,
    denormalize: metal::ComputePipelineState,
    dup: metal::ComputePipelineState,
    attention: metal::ComputePipelineState,
    softmax: metal::ComputePipelineState,
    nearest_upsample: metal::ComputePipelineState,
    clamp: metal::ComputePipelineState,
    // Non-null selects the MPSGraph FP32 convolution path.
    opaque graph_convs: *graph_conv::Cache,
}

fn round_up(value: usize, alignment: usize) -> usize {
    return (value +% alignment -% (1 as usize)) / alignment *% alignment;
}

fn pipeline(
    device: metal::Device,
    library: metal::Library,
    name: str,
) -> option::Option[OwnedObjc] {
    guard let option::Option[metal::Function]::Some(function) = library.new_function_with_name(name) else {
        io::eprintln("VAE: missing Metal function ${name}");
        return option::Option[OwnedObjc]::None;
    };
    let function_owner: OwnedObjc = OwnedObjc::new(function.raw());
    var error: *u8 = 0 as *u8;
    guard let option::Option[metal::ComputePipelineState]::Some(state) =
        device.new_compute_pipeline_state_with_function(function, #addr_of(error) as *u8) else {
        io::eprintln("VAE: could not build Metal pipeline ${name}");
        return option::Option[OwnedObjc]::None;
    };
    return option::Option[OwnedObjc]::Some(OwnedObjc::new(state.raw()));
}

fn new_buffer(device: metal::Device, bytes: u64) -> option::Option[metal::Buffer] {
    return device.new_buffer_with_length(bytes, metal::resource_options_m_t_l_resource_storage_mode_shared);
}

fn mapped_storage_buffer(
    device: metal::Device,
    file: safetensors::File,
) -> option::Option[metal::Buffer] {
    let mapped_bytes: usize = round_up(file.mapping_length(), VM_PAGE_BYTES);
    if mapped_bytes as u64 > device.max_buffer_length() {
        io::eprintln(
            "VAE: weight mapping ${mapped_bytes} exceeds Metal buffer limit ${device.max_buffer_length()}",
        );
        return option::Option[metal::Buffer]::None;
    }
    var deallocator: MappedDeallocatorBlock = MappedDeallocatorBlock {
        isa: rt::stack_block_isa(),
        flags: 0 as i32,
        reserved: 0 as i32,
        invoke: mapped_deallocator_invoke,
        descriptor: #addr_of(MAPPED_DEALLOCATOR_DESCRIPTOR) as *u8,
    };
    let object: *u8 = rt::msg_id_id_u64_u64_id(
        device.raw(),
        rt::sel(#str_ptr("newBufferWithBytesNoCopy:length:options:deallocator:\0")),
        file.mapping_pointer(),
        mapped_bytes as u64,
        metal::resource_options_m_t_l_resource_storage_mode_shared,
        #addr_of(deallocator) as *u8,
    );
    if object.is_null() {
        return option::Option[metal::Buffer]::None;
    }
    return option::Option[metal::Buffer]::Some(metal::Buffer::from_raw(object));
}

// The no-copy mapping makes the first decode dispatch fault and wire the
// 1.26 GiB weight file inside the timed decode. Copying it into an ordinary
// shared buffer with parallel F_NOCACHE positional reads (as the transformer
// pack does) keeps identical bytes at identical offsets.
// QI_DISABLE_VAE_PREAD=1 restores the no-copy mapping.
const VAE_READ_THREADS: usize = 8;

struct VaeReadJob {
    fd: i32,
    opaque destination: *u8,
    offset: u64,
    length: usize,
}

impl VaeReadJob: Send {}

fn read_vae_job(take job: VaeReadJob) -> i64 {
    return if mapped::read_at_descriptor(job.fd, job.destination, job.length, job.offset) {
        0 as i64
    } else { -1 as i64 };
}

fn read_storage_buffer(
    device: metal::Device,
    path: str,
    length: usize,
) -> option::Option[metal::Buffer] {
    guard let option::Option[metal::Buffer]::Some(buffer) = new_buffer(
        device, round_up(length, VM_PAGE_BYTES) as u64,
    ) else { return option::Option[metal::Buffer]::None; };
    guard let option::Option[mapped::PositionalReader]::Some(reader) =
        mapped::open_positional_reader(path) else {
        rt::release(buffer.raw());
        return option::Option[metal::Buffer]::None;
    };
    let chunk: usize = round_up(length / VAE_READ_THREADS +% (1 as usize), VM_PAGE_BYTES);
    var handles: vec::Vec[thread::JoinHandle[i64]] =
        vec::Vec[thread::JoinHandle[i64]]::with_capacity(VAE_READ_THREADS);
    var ok: bool = true;
    var start: usize = 0 as usize;
    while start < length {
        let count: usize = if length -% start < chunk { length -% start } else { chunk };
        let handle: thread::JoinHandle[i64] = thread::spawn_with::[VaeReadJob, i64](
            VaeReadJob {
                fd: reader.descriptor(),
                destination: buffer.contents() + start,
                offset: start as u64,
                length: count,
            },
            read_vae_job,
        );
        if handles.append(handle) != status::Status::Ok {
            ok = false;
            break;
        }
        start = start +% count;
    }
    while handles.count() > (0 as usize) {
        guard let option::Option[thread::JoinHandle[i64]]::Some(handle) = handles.remove_last() else {
            ok = false;
            break;
        };
        if handle.join() != (0 as i64) { ok = false; }
    }
    if !ok {
        rt::release(buffer.raw());
        return option::Option[metal::Buffer]::None;
    }
    return option::Option[metal::Buffer]::Some(buffer);
}

fn fixture_buffer(
    device: metal::Device,
    fixture_directory: str,
    name: str,
    expected_bytes: u64,
) -> option::Option[metal::Buffer] {
    let path: text::Text = "${fixture_directory}/${name}.f32";
    guard let mapped::MapResult::Ok(file) = mapped::map_readonly(path.view()) else {
        io::eprintln("VAE: missing fixture ${path}");
        return option::Option[metal::Buffer]::None;
    };
    if file.length() as u64 != expected_bytes {
        io::eprintln("VAE: fixture ${name} has ${file.length()} bytes, expected ${expected_bytes}");
        return option::Option[metal::Buffer]::None;
    }
    return device.new_buffer_with_bytes(
        file.pointer(), expected_bytes, metal::resource_options_m_t_l_resource_storage_mode_shared,
    );
}

fn normalized_input_buffer(
    device: metal::Device,
    fixture_directory: str,
    source: *f32,
    expected_bytes: u64,
) -> option::Option[metal::Buffer] {
    if source.is_null() {
        return fixture_buffer(device, fixture_directory, "normalized_latent", expected_bytes);
    }
    return device.new_buffer_with_bytes(
        source as *u8,
        expected_bytes,
        metal::resource_options_m_t_l_resource_storage_mode_shared,
    );
}

fn conv_weight(
    file: safetensors::File,
    prefix: str,
    output_channels: usize,
    input_channels: usize,
    kernel: usize,
) -> option::Option[ConvWeight] {
    let weight_name: text::Text = "${prefix}.weight";
    let bias_name: text::Text = "${prefix}.bias";
    guard let option::Option[safetensors::TensorData]::Some(weight) = file.tensor(weight_name.view()) else {
        io::eprintln("VAE: missing ${weight_name}");
        return option::Option[ConvWeight]::None;
    };
    guard let option::Option[safetensors::TensorData]::Some(bias) = file.tensor(bias_name.view()) else {
        io::eprintln("VAE: missing ${bias_name}");
        return option::Option[ConvWeight]::None;
    };
    let weight_ok: bool = weight.dtype.name() == "F32" && weight.rank == (4 as usize)
        && weight.dimensions[0] == output_channels as u64
        && weight.dimensions[1] == input_channels as u64
        && weight.dimensions[2] == kernel as u64 && weight.dimensions[3] == kernel as u64;
    let bias_ok: bool = bias.dtype.name() == "F32" && bias.rank == (1 as usize)
        && bias.dimensions[0] == output_channels as u64;
    if !weight_ok || !bias_ok {
        io::eprintln("VAE: invalid convolution metadata for ${prefix}");
        return option::Option[ConvWeight]::None;
    }
    return option::Option[ConvWeight]::Some(ConvWeight {
        weight_offset: weight.file_offset,
        bias_offset: bias.file_offset,
    });
}

fn gamma_offset(
    file: safetensors::File,
    name: str,
    channels: usize,
) -> option::Option[u64] {
    guard let option::Option[safetensors::TensorData]::Some(gamma) = file.tensor(name) else {
        io::eprintln("VAE: missing ${name}");
        return option::Option[u64]::None;
    };
    if gamma.dtype.name() != "F32" || gamma.elements != channels as u64 {
        io::eprintln("VAE: invalid norm metadata for ${name}");
        return option::Option[u64]::None;
    }
    return option::Option[u64]::Some(gamma.file_offset);
}

fn finish_dispatch(
    command_buffer: metal::CommandBuffer,
    encoder: metal::ComputeCommandEncoder,
    deferred: bool = false,
) -> f64 {
    let command_encoder: metal::CommandEncoder = metal::CommandEncoder::from_raw(encoder.raw());
    command_encoder.end_encoding();
    if deferred {
        return 0.0f64;
    }
    command_buffer.commit();
    command_buffer.wait_until_completed();
    return (command_buffer.g_p_u_end_time() - command_buffer.g_p_u_start_time()) * 1000.0f64;
}

fn dispatch_command_buffer(
    queue: metal::CommandQueue,
    deferred: *u8,
) -> option::Option[metal::CommandBuffer] {
    if !deferred.is_null() {
        return option::Option[metal::CommandBuffer]::Some(
            metal::CommandBuffer::from_raw(deferred),
        );
    }
    return queue.command_buffer();
}

fn dispatch_conv(
    queue: metal::CommandQueue,
    pipelines: Pipelines,
    storage: metal::Buffer,
    weight: ConvWeight,
    input: metal::Buffer,
    output: metal::Buffer,
    input_height: usize,
    input_width: usize,
    input_channels: usize,
    output_channels: usize,
    kernel: usize,
    padding: usize,
    upsample: bool = false,
    deferred: *u8 = 0 as *u8,
) -> option::Option[f64] {
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return option::Option[f64]::None; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    guard let option::Option[metal::CommandBuffer]::Some(command_buffer) = dispatch_command_buffer(queue, deferred) else {
        return option::Option[f64]::None;
    };
    let command_buffer_owner: OwnedObjc = OwnedObjc::new(rt::retain(command_buffer.raw()));
    if !pipelines.graph_convs.is_null() {
        let conv: *graph_conv::Conv = graph_conv::find_or_create(
            pipelines.graph_convs, input_height, input_width, input_channels,
            output_channels, kernel, padding, upsample,
        );
        // A deferred buffer is already an MPSCommandBuffer; wrap a synchronous one.
        guard let option::Option[graph_attention::CommandBufferContext]::Some(context) =
            graph_attention::wrap_command_buffer(command_buffer, deferred.is_null()) else {
            return option::Option[f64]::None;
        };
        let graph_command_buffer: metal::CommandBuffer = context.metal();
        if !graph_conv::encode(
            conv, graph_command_buffer, input, storage, weight.weight_offset,
            weight.bias_offset, output,
        ) {
            io::eprintln("VAE: MPSGraph convolution failed for ${input_height}x${input_width}x${input_channels}->${output_channels} k${kernel}");
            return option::Option[f64]::None;
        }
        if !deferred.is_null() { return option::Option[f64]::Some(0.0f64); }
        graph_command_buffer.commit();
        graph_command_buffer.wait_until_completed();
        return option::Option[f64]::Some(
            (graph_command_buffer.g_p_u_end_time() - graph_command_buffer.g_p_u_start_time())
                * 1000.0f64,
        );
    }
    guard let option::Option[metal::ComputeCommandEncoder]::Some(encoder) = command_buffer.compute_command_encoder() else {
        return option::Option[f64]::None;
    };
    let encoder_owner: OwnedObjc = OwnedObjc::new(rt::retain(encoder.raw()));
    let output_height: usize = if upsample { input_height *% (2 as usize) } else { input_height };
    let output_width: usize = if upsample { input_width *% (2 as usize) } else { input_width };
    var params: ConvParams = ConvParams {
        input_height: input_height as u32, input_width: input_width as u32,
        input_channels: input_channels as u32, output_height: output_height as u32,
        output_width: output_width as u32, output_channels: output_channels as u32,
        kernel_size: kernel as u32, padding: padding as u32,
        upsample: if upsample { 1 as u32 } else { 0 as u32 },
    };
    encoder.set_compute_pipeline_state(pipelines.conv);
    encoder.set_buffer(input, 0 as u64, 0 as u64);
    encoder.set_buffer(storage, weight.weight_offset, 1 as u64);
    encoder.set_buffer(storage, weight.bias_offset, 2 as u64);
    encoder.set_buffer(output, 0 as u64, 3 as u64);
    encoder.set_bytes(#addr_of(params) as *u8, #size_of::[ConvParams]() as u64, 4 as u64);
    encoder.dispatch_threadgroups(
        metal::Size {
            width: round_up(output_channels, 64 as usize) as u64 / (64 as u64),
            height: round_up(output_height *% output_width, 64 as usize) as u64 / (64 as u64),
            depth: 1 as u64,
        },
        metal::Size { width: 512 as u64, height: 1 as u64, depth: 1 as u64 },
    );
    return option::Option[f64]::Some(finish_dispatch(command_buffer, encoder, !deferred.is_null()));
}

fn dispatch_upsample_conv(
    queue: metal::CommandQueue,
    pack_pipeline: metal::ComputePipelineState,
    conv_pipeline: metal::ComputePipelineState,
    storage: metal::Buffer,
    weight: ConvWeight,
    packed_weight: metal::Buffer,
    input: metal::Buffer,
    output: metal::Buffer,
    input_height: usize,
    input_width: usize,
    channels: usize,
    deferred: *u8 = 0 as *u8,
) -> option::Option[f64] {
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return option::Option[f64]::None; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    guard let option::Option[metal::CommandBuffer]::Some(command_buffer) =
        dispatch_command_buffer(queue, deferred) else {
        return option::Option[f64]::None;
    };
    let command_buffer_owner: OwnedObjc = OwnedObjc::new(rt::retain(command_buffer.raw()));
    var params: ConvParams = ConvParams {
        input_height: input_height as u32,
        input_width: input_width as u32,
        input_channels: channels as u32,
        output_height: (input_height *% (2 as usize)) as u32,
        output_width: (input_width *% (2 as usize)) as u32,
        output_channels: channels as u32,
        kernel_size: 3 as u32,
        padding: 1 as u32,
        upsample: 1 as u32,
    };
    guard let option::Option[metal::ComputeCommandEncoder]::Some(pack_encoder) =
        command_buffer.compute_command_encoder() else {
        return option::Option[f64]::None;
    };
    let pack_encoder_owner: OwnedObjc = OwnedObjc::new(rt::retain(pack_encoder.raw()));
    pack_encoder.set_compute_pipeline_state(pack_pipeline);
    pack_encoder.set_buffer(storage, weight.weight_offset, 0 as u64);
    pack_encoder.set_buffer(packed_weight, 0 as u64, 1 as u64);
    pack_encoder.set_bytes(#addr_of(params) as *u8, #size_of::[ConvParams]() as u64, 2 as u64);
    let packed_values: usize = (16 as usize) *% channels *% channels;
    pack_encoder.dispatch_threads(
        metal::Size { width: packed_values as u64, height: 1 as u64, depth: 1 as u64 },
        metal::Size {
            width: pack_pipeline.thread_execution_width(),
            height: 1 as u64,
            depth: 1 as u64,
        },
    );
    let pack_command_encoder: metal::CommandEncoder =
        metal::CommandEncoder::from_raw(pack_encoder.raw());
    pack_command_encoder.end_encoding();

    guard let option::Option[metal::ComputeCommandEncoder]::Some(conv_encoder) =
        command_buffer.compute_command_encoder() else {
        return option::Option[f64]::None;
    };
    let conv_encoder_owner: OwnedObjc = OwnedObjc::new(rt::retain(conv_encoder.raw()));
    conv_encoder.set_compute_pipeline_state(conv_pipeline);
    conv_encoder.set_buffer(input, 0 as u64, 0 as u64);
    conv_encoder.set_buffer(packed_weight, 0 as u64, 1 as u64);
    conv_encoder.set_buffer(storage, weight.bias_offset, 2 as u64);
    conv_encoder.set_buffer(output, 0 as u64, 3 as u64);
    conv_encoder.set_bytes(#addr_of(params) as *u8, #size_of::[ConvParams]() as u64, 4 as u64);
    conv_encoder.dispatch_threadgroups(
        metal::Size {
            width: round_up(channels, 64 as usize) as u64 / (64 as u64),
            height: round_up(input_height *% input_width, 64 as usize) as u64 / (64 as u64),
            depth: 4 as u64,
        },
        metal::Size { width: 512 as u64, height: 1 as u64, depth: 1 as u64 },
    );
    return option::Option[f64]::Some(
        finish_dispatch(command_buffer, conv_encoder, !deferred.is_null()),
    );
}

fn dispatch_norm(
    queue: metal::CommandQueue,
    pipeline_state: metal::ComputePipelineState,
    storage: metal::Buffer,
    gamma: u64,
    input: metal::Buffer,
    output: metal::Buffer,
    pixels: usize,
    channels: usize,
    silu: bool,
    deferred: *u8 = 0 as *u8,
) -> option::Option[f64] {
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return option::Option[f64]::None; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    guard let option::Option[metal::CommandBuffer]::Some(command_buffer) = dispatch_command_buffer(queue, deferred) else { return option::Option[f64]::None; };
    let command_buffer_owner: OwnedObjc = OwnedObjc::new(rt::retain(command_buffer.raw()));
    guard let option::Option[metal::ComputeCommandEncoder]::Some(encoder) = command_buffer.compute_command_encoder() else { return option::Option[f64]::None; };
    let encoder_owner: OwnedObjc = OwnedObjc::new(rt::retain(encoder.raw()));
    var params: NormParams = NormParams { pixels: pixels as u32, channels: channels as u32, silu: if silu { 1 as u32 } else { 0 as u32 } };
    encoder.set_compute_pipeline_state(pipeline_state);
    encoder.set_buffer(input, 0 as u64, 0 as u64);
    encoder.set_buffer(storage, gamma, 1 as u64);
    encoder.set_buffer(output, 0 as u64, 2 as u64);
    encoder.set_bytes(#addr_of(params) as *u8, #size_of::[NormParams]() as u64, 3 as u64);
    encoder.dispatch_threadgroups(
        metal::Size { width: pixels as u64, height: 1 as u64, depth: 1 as u64 },
        metal::Size { width: REDUCTION_THREADS as u64, height: 1 as u64, depth: 1 as u64 },
    );
    return option::Option[f64]::Some(finish_dispatch(command_buffer, encoder, !deferred.is_null()));
}

fn dispatch_element(
    queue: metal::CommandQueue,
    pipeline_state: metal::ComputePipelineState,
    left: metal::Buffer,
    right: metal::Buffer,
    third: metal::Buffer,
    output: metal::Buffer,
    elements: usize,
    channels: usize,
    mode: u32,
    deferred: *u8 = 0 as *u8,
) -> option::Option[f64] {
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return option::Option[f64]::None; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    guard let option::Option[metal::CommandBuffer]::Some(command_buffer) = dispatch_command_buffer(queue, deferred) else { return option::Option[f64]::None; };
    let command_buffer_owner: OwnedObjc = OwnedObjc::new(rt::retain(command_buffer.raw()));
    guard let option::Option[metal::ComputeCommandEncoder]::Some(encoder) = command_buffer.compute_command_encoder() else { return option::Option[f64]::None; };
    let encoder_owner: OwnedObjc = OwnedObjc::new(rt::retain(encoder.raw()));
    var params: ElementParams = ElementParams { elements: elements as u32, channels: channels as u32 };
    encoder.set_compute_pipeline_state(pipeline_state);
    encoder.set_buffer(left, 0 as u64, 0 as u64);
    encoder.set_buffer(right, 0 as u64, 1 as u64);
    if mode == (2 as u32) {
        encoder.set_buffer(third, 0 as u64, 2 as u64);
        encoder.set_buffer(output, 0 as u64, 3 as u64);
        encoder.set_bytes(#addr_of(params) as *u8, #size_of::[ElementParams]() as u64, 4 as u64);
    } else {
        encoder.set_buffer(output, 0 as u64, 2 as u64);
        encoder.set_bytes(#addr_of(params) as *u8, #size_of::[ElementParams]() as u64, 3 as u64);
    }
    let threads: u64 = pipeline_state.thread_execution_width();
    encoder.dispatch_threads(
        metal::Size { width: elements as u64, height: 1 as u64, depth: 1 as u64 },
        metal::Size { width: threads, height: 1 as u64, depth: 1 as u64 },
    );
    return option::Option[f64]::Some(finish_dispatch(command_buffer, encoder, !deferred.is_null()));
}

fn dispatch_clamp(
    queue: metal::CommandQueue,
    pipeline_state: metal::ComputePipelineState,
    input: metal::Buffer,
    output: metal::Buffer,
    elements: usize,
    deferred: *u8 = 0 as *u8,
