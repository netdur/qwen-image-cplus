    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return option::Option[f64]::None; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    guard let option::Option[metal::CommandBuffer]::Some(command_buffer) = dispatch_command_buffer(queue, deferred) else { return option::Option[f64]::None; };
    let command_buffer_owner: OwnedObjc = OwnedObjc::new(rt::retain(command_buffer.raw()));
    guard let option::Option[metal::ComputeCommandEncoder]::Some(encoder) = command_buffer.compute_command_encoder() else { return option::Option[f64]::None; };
    let encoder_owner: OwnedObjc = OwnedObjc::new(rt::retain(encoder.raw()));
    var params: ElementParams = ElementParams { elements: elements as u32, channels: 0 as u32 };
    encoder.set_compute_pipeline_state(pipeline_state);
    encoder.set_buffer(input, 0 as u64, 0 as u64);
    encoder.set_buffer(output, 0 as u64, 1 as u64);
    encoder.set_bytes(#addr_of(params) as *u8, #size_of::[ElementParams]() as u64, 2 as u64);
    let threads: u64 = pipeline_state.thread_execution_width();
    encoder.dispatch_threads(
        metal::Size { width: elements as u64, height: 1 as u64, depth: 1 as u64 },
        metal::Size { width: threads, height: 1 as u64, depth: 1 as u64 },
    );
    return option::Option[f64]::Some(finish_dispatch(command_buffer, encoder, !deferred.is_null()));
}

fn dispatch_dup(
    queue: metal::CommandQueue,
    pipeline_state: metal::ComputePipelineState,
    input: metal::Buffer,
    output: metal::Buffer,
    input_height: usize,
    input_width: usize,
    input_channels: usize,
    output_channels: usize,
    factor_t: usize,
    deferred: *u8 = 0 as *u8,
) -> option::Option[f64] {
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return option::Option[f64]::None; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    guard let option::Option[metal::CommandBuffer]::Some(command_buffer) = dispatch_command_buffer(queue, deferred) else { return option::Option[f64]::None; };
    let command_buffer_owner: OwnedObjc = OwnedObjc::new(rt::retain(command_buffer.raw()));
    guard let option::Option[metal::ComputeCommandEncoder]::Some(encoder) = command_buffer.compute_command_encoder() else { return option::Option[f64]::None; };
    let encoder_owner: OwnedObjc = OwnedObjc::new(rt::retain(encoder.raw()));
    let factor: usize = factor_t *% (4 as usize);
    var params: DupParams = DupParams {
        input_height: input_height as u32, input_width: input_width as u32,
        input_channels: input_channels as u32, output_channels: output_channels as u32,
        factor_t: factor_t as u32,
        repeats: (output_channels *% factor / input_channels) as u32,
    };
    let elements: usize = input_height *% (2 as usize) *% input_width *% (2 as usize) *% output_channels;
    encoder.set_compute_pipeline_state(pipeline_state);
    encoder.set_buffer(input, 0 as u64, 0 as u64);
    encoder.set_buffer(output, 0 as u64, 1 as u64);
    encoder.set_bytes(#addr_of(params) as *u8, #size_of::[DupParams]() as u64, 2 as u64);
    let threads: u64 = pipeline_state.thread_execution_width();
    encoder.dispatch_threads(
        metal::Size { width: elements as u64, height: 1 as u64, depth: 1 as u64 },
        metal::Size { width: threads, height: 1 as u64, depth: 1 as u64 },
    );
    return option::Option[f64]::Some(finish_dispatch(command_buffer, encoder, !deferred.is_null()));
}

fn dispatch_attention(
    queue: metal::CommandQueue,
    pipeline_state: metal::ComputePipelineState,
    qkv: metal::Buffer,
    output: metal::Buffer,
    pixels: usize,
    deferred: *u8 = 0 as *u8,
) -> option::Option[f64] {
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return option::Option[f64]::None; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    guard let option::Option[metal::CommandBuffer]::Some(command_buffer) = dispatch_command_buffer(queue, deferred) else { return option::Option[f64]::None; };
    let command_buffer_owner: OwnedObjc = OwnedObjc::new(rt::retain(command_buffer.raw()));
    guard let option::Option[metal::ComputeCommandEncoder]::Some(encoder) = command_buffer.compute_command_encoder() else { return option::Option[f64]::None; };
    let encoder_owner: OwnedObjc = OwnedObjc::new(rt::retain(encoder.raw()));
    var params: ElementParams = ElementParams { elements: pixels as u32, channels: 1152 as u32 };
    encoder.set_compute_pipeline_state(pipeline_state);
    encoder.set_buffer(qkv, 0 as u64, 0 as u64);
    encoder.set_buffer(output, 0 as u64, 1 as u64);
    encoder.set_bytes(#addr_of(params) as *u8, #size_of::[ElementParams]() as u64, 2 as u64);
    encoder.dispatch_threadgroups(
        metal::Size { width: pixels as u64, height: 1 as u64, depth: 1 as u64 },
        metal::Size { width: REDUCTION_THREADS as u64, height: 1 as u64, depth: 1 as u64 },
    );
    return option::Option[f64]::Some(finish_dispatch(command_buffer, encoder, !deferred.is_null()));
}

// Middle-block single-head attention as scores = QK^T / sqrt(C) (FP32 MPS
// GEMM over strided column slices of the [pixels, 3C] qkv buffer), an
// in-place row softmax, and output = P V (FP32 MPS GEMM). Replaces one
// threadgroup per query with a barrier reduction per key (about 250 ms at
// 1024). QI_DISABLE_VAE_MPS_ATTENTION=1 restores the streaming kernel.
fn dispatch_attention_mps(
    queue: metal::CommandQueue,
    device: metal::Device,
    softmax_pipeline: metal::ComputePipelineState,
    qkv: metal::Buffer,
    scores: metal::Buffer,
    output: metal::Buffer,
    pixels: usize,
    deferred: *u8 = 0 as *u8,
) -> option::Option[f64] {
    let channels: usize = 1152 as usize;
    let qkv_row_bytes: usize = (3 as usize) *% channels *% #size_of::[f32]();
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return option::Option[f64]::None; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    guard let option::Option[mps::Multiplication]::Some(score_operation) = mps::create_fp32(
        device,
        mps::Fp32Operand { buffer: qkv, offset: 0 as u64, rows: pixels, columns: channels, row_bytes: qkv_row_bytes },
        mps::Fp32Operand { buffer: qkv, offset: (channels *% #size_of::[f32]()) as u64, rows: pixels, columns: channels, row_bytes: qkv_row_bytes },
        mps::Fp32Operand { buffer: scores, offset: 0 as u64, rows: pixels, columns: pixels, row_bytes: pixels *% #size_of::[f32]() },
        false, true, channels, 1.0f64 / (channels as f64).sqrt(),
    ) else { return option::Option[f64]::None; };
    guard let option::Option[mps::Multiplication]::Some(value_operation) = mps::create_fp32(
        device,
        mps::Fp32Operand { buffer: scores, offset: 0 as u64, rows: pixels, columns: pixels, row_bytes: pixels *% #size_of::[f32]() },
        mps::Fp32Operand { buffer: qkv, offset: ((2 as usize) *% channels *% #size_of::[f32]()) as u64, rows: pixels, columns: channels, row_bytes: qkv_row_bytes },
        mps::Fp32Operand { buffer: output, offset: 0 as u64, rows: pixels, columns: channels, row_bytes: channels *% #size_of::[f32]() },
        false, false, pixels, 1.0f64,
    ) else { return option::Option[f64]::None; };
    guard let option::Option[metal::CommandBuffer]::Some(command_buffer) = dispatch_command_buffer(queue, deferred) else { return option::Option[f64]::None; };
    let command_buffer_owner: OwnedObjc = OwnedObjc::new(rt::retain(command_buffer.raw()));
    score_operation.encode(command_buffer);
    guard let option::Option[metal::ComputeCommandEncoder]::Some(encoder) = command_buffer.compute_command_encoder() else { return option::Option[f64]::None; };
    let encoder_owner: OwnedObjc = OwnedObjc::new(rt::retain(encoder.raw()));
    var params: ElementParams = ElementParams { elements: pixels as u32, channels: channels as u32 };
    encoder.set_compute_pipeline_state(softmax_pipeline);
    encoder.set_buffer(scores, 0 as u64, 0 as u64);
    encoder.set_bytes(#addr_of(params) as *u8, #size_of::[ElementParams]() as u64, 1 as u64);
    encoder.dispatch_threadgroups(
        metal::Size { width: pixels as u64, height: 1 as u64, depth: 1 as u64 },
        metal::Size { width: REDUCTION_THREADS as u64, height: 1 as u64, depth: 1 as u64 },
    );
    let command_encoder: metal::CommandEncoder = metal::CommandEncoder::from_raw(encoder.raw());
    command_encoder.end_encoding();
    value_operation.encode(command_buffer);
    if !deferred.is_null() { return option::Option[f64]::Some(0.0f64); }
    command_buffer.commit();
    command_buffer.wait_until_completed();
    return option::Option[f64]::Some(
        (command_buffer.g_p_u_end_time() - command_buffer.g_p_u_start_time()) * 1000.0f64,
    );
}

// Writes the nearest-2x upsampled input into dead scratch, then runs a plain
// 3x3 convolution graph at the doubled shape. The fused resize-plus-conv
// graph made MPSGraph materialise every resize output internally, about
// 2.1 GB of graph scratch at 1024.
fn dispatch_graph_upsample_conv(
    queue: metal::CommandQueue,
    pipelines: Pipelines,
    storage: metal::Buffer,
    weight: ConvWeight,
    input: metal::Buffer,
    upsampled: metal::Buffer,
    output: metal::Buffer,
    height: usize,
    width: usize,
    channels: usize,
    deferred: *u8,
) -> option::Option[f64] {
    let elements: usize = height *% width *% (4 as usize) *% channels;
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return option::Option[f64]::None; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    guard let option::Option[metal::CommandBuffer]::Some(command_buffer) = dispatch_command_buffer(queue, deferred) else { return option::Option[f64]::None; };
    let command_buffer_owner: OwnedObjc = OwnedObjc::new(rt::retain(command_buffer.raw()));
    guard let option::Option[metal::ComputeCommandEncoder]::Some(encoder) = command_buffer.compute_command_encoder() else { return option::Option[f64]::None; };
    let encoder_owner: OwnedObjc = OwnedObjc::new(rt::retain(encoder.raw()));
    var params: ElementParams = ElementParams { elements: width as u32, channels: channels as u32 };
    encoder.set_compute_pipeline_state(pipelines.nearest_upsample);
    encoder.set_buffer(input, 0 as u64, 0 as u64);
    encoder.set_buffer(upsampled, 0 as u64, 1 as u64);
    encoder.set_bytes(#addr_of(params) as *u8, #size_of::[ElementParams]() as u64, 2 as u64);
    encoder.dispatch_threads(
        metal::Size { width: elements as u64, height: 1 as u64, depth: 1 as u64 },
        metal::Size { width: pipelines.nearest_upsample.thread_execution_width(), height: 1 as u64, depth: 1 as u64 },
    );
    let upsample_ms: f64 = finish_dispatch(command_buffer, encoder, !deferred.is_null());
    guard let option::Option[f64]::Some(conv_ms) = dispatch_conv(
        queue, pipelines, storage, weight, upsampled, output,
        height *% (2 as usize), width *% (2 as usize), channels, channels, 3, 1, false, deferred,
    ) else { return option::Option[f64]::None; };
    return option::Option[f64]::Some(upsample_ms + conv_ms);
}

fn execute_residual(
    queue: metal::CommandQueue,
    pipelines: Pipelines,
    file: safetensors::File,
    storage: metal::Buffer,
    prefix: str,
    input: metal::Buffer,
    output: metal::Buffer,
    norm_buffer: metal::Buffer,
    conv_buffer: metal::Buffer,
    shortcut_buffer: metal::Buffer,
    height: usize,
    width: usize,
    input_channels: usize,
    output_channels: usize,
    deferred: *u8 = 0 as *u8,
    profile_dispatches: bool = false,
) -> option::Option[f64] {
    let norm1_name: text::Text = "${prefix}.norm1.gamma";
    let norm2_name: text::Text = "${prefix}.norm2.gamma";
    let conv1_name: text::Text = "${prefix}.conv1";
    let conv2_name: text::Text = "${prefix}.conv2";
    guard let option::Option[u64]::Some(norm1) = gamma_offset(file, norm1_name.view(), input_channels) else { return option::Option[f64]::None; };
    guard let option::Option[u64]::Some(norm2) = gamma_offset(file, norm2_name.view(), output_channels) else { return option::Option[f64]::None; };
    guard let option::Option[ConvWeight]::Some(conv1) = conv_weight(file, conv1_name.view(), output_channels, input_channels, 3) else { return option::Option[f64]::None; };
    guard let option::Option[ConvWeight]::Some(conv2) = conv_weight(file, conv2_name.view(), output_channels, output_channels, 3) else { return option::Option[f64]::None; };
    var total: f64 = 0.0f64;
    var shortcut_ms: f64 = 0.0f64;
    var shortcut: metal::Buffer = input;
    if input_channels != output_channels {
        let shortcut_name: text::Text = "${prefix}.conv_shortcut";
        guard let option::Option[ConvWeight]::Some(shortcut_weight) = conv_weight(file, shortcut_name.view(), output_channels, input_channels, 1) else { return option::Option[f64]::None; };
        guard let option::Option[f64]::Some(elapsed) = dispatch_conv(queue, pipelines, storage, shortcut_weight, input, shortcut_buffer, height, width, input_channels, output_channels, 1, 0, false, deferred) else { return option::Option[f64]::None; };
        total = total + elapsed;
        shortcut_ms = elapsed;
        shortcut = shortcut_buffer;
    }
    guard let option::Option[f64]::Some(norm1_ms) = dispatch_norm(queue, pipelines.norm, storage, norm1, input, norm_buffer, height *% width, input_channels, true, deferred) else { return option::Option[f64]::None; };
    guard let option::Option[f64]::Some(conv1_ms) = dispatch_conv(queue, pipelines, storage, conv1, norm_buffer, conv_buffer, height, width, input_channels, output_channels, 3, 1, false, deferred) else { return option::Option[f64]::None; };
    guard let option::Option[f64]::Some(norm2_ms) = dispatch_norm(queue, pipelines.norm, storage, norm2, conv_buffer, norm_buffer, height *% width, output_channels, true, deferred) else { return option::Option[f64]::None; };
    guard let option::Option[f64]::Some(conv2_ms) = dispatch_conv(queue, pipelines, storage, conv2, norm_buffer, output, height, width, output_channels, output_channels, 3, 1, false, deferred) else { return option::Option[f64]::None; };
    guard let option::Option[f64]::Some(add_ms) = dispatch_element(queue, pipelines.add, output, shortcut, shortcut, output, height *% width *% output_channels, output_channels, 1 as u32, deferred) else { return option::Option[f64]::None; };
    if profile_dispatches {
        io::println("VAE profile: residual=${prefix} height=${height} width=${width} input_channels=${input_channels} output_channels=${output_channels} shortcut_conv_ms=${shortcut_ms} norm_1_ms=${norm1_ms} conv_1_ms=${conv1_ms} norm_2_ms=${norm2_ms} conv_2_ms=${conv2_ms} add_ms=${add_ms}");
    }
    return option::Option[f64]::Some(total + norm1_ms + conv1_ms + norm2_ms + conv2_ms + add_ms);
}

fn normalized_rms_fixture(
    actual: metal::Buffer,
    fixture_directory: str,
    name: str,
    count: usize,
) -> option::Option[f64] {
    let path: text::Text = "${fixture_directory}/${name}.f32";
    guard let mapped::MapResult::Ok(expected) = mapped::map_readonly(path.view()) else {
        return option::Option[f64]::None;
    };
    if expected.length() != count *% #size_of::[f32]() {
        return option::Option[f64]::None;
    }
    let actual_values: *f32 = actual.contents() as *f32;
    let expected_values: *f32 = expected.pointer() as *f32;
    var squared_error: f64 = 0.0f64;
    var squared_reference: f64 = 0.0f64;
    var index: usize = 0 as usize;
    while index < count {
        let difference: f64 = actual_values[index] as f64 - expected_values[index] as f64;
        squared_error = squared_error + difference * difference;
        squared_reference = squared_reference + expected_values[index] as f64 * expected_values[index] as f64;
        index = index +% (1 as usize);
    }
    return option::Option[f64]::Some((squared_error / squared_reference.max(0.000000000001f64)).sqrt());
}

fn finite(buffer: metal::Buffer, count: usize) -> bool {
    let values: *f32 = buffer.contents() as *f32;
    var index: usize = 0 as usize;
    while index < count {
        var value: f32 = values[index];
        let bits: u32 = { *({ #addr_of(value) } as *u32) };
        if (bits & (0x7F800000 as u32)) == (0x7F800000 as u32) {
            io::eprintln("VAE: non-finite output at ${index}");
            return false;
        }
        index = index +% (1 as usize);
    }
    return true;
}

fn report_boundary(
    label: str,
    buffer: metal::Buffer,
    fixture_directory: str,
    fixture_name: str,
    count: usize,
    limit: f64,
) -> bool {
    guard let option::Option[f64]::Some(error) = normalized_rms_fixture(buffer, fixture_directory, fixture_name, count) else {
        io::eprintln("VAE: missing boundary fixture ${fixture_name}");
        return false;
    };
    io::println("VAE ${label}: nRMSE=${error} limit=${limit}");
    return error <= limit && finite(buffer, count);
}

fn run(
    model_root: str,
    requested_case: str,
    fixture_root: str = "tests/fixtures/vae_decoder_fp32",
) -> i32 {
    // The checked-in oracle covers the small diagnostic and 256px product
    // case. A 1024 request is a finite-execution and allocation-shape smoke
    // test with a deterministic zero normalized latent; its numerical oracle
    // is intentionally a separate phase rather than a large Git fixture.
    if requested_case == "1024" || requested_case == "1024-profile" {
        let latent_values: usize = (64 as usize) *% (64 as usize) *% (64 as usize);
        var latent: vec::Vec[f32] = vec::Vec[f32]::with_capacity(latent_values);
        var index: usize = 0 as usize;
        while index < latent_values {
            latent.append(0.0f32);
            index = index +% (1 as usize);
        }
        return run_impl(
            model_root,
            "1024",
            "",
            #slice_ptr(latent.as_slice()),
            0 as *f32,
            false,
            false,
            requested_case == "1024-profile",
        );
    }
    if requested_case == "trajectory-1024" {
        return run_impl(
            model_root,
            requested_case,
            fixture_root,
            0 as *f32,
            0 as *f32,
            true,
            false,
        );
    }
    return run_impl(
        model_root,
        requested_case,
        fixture_root,
        0 as *f32,
        0 as *f32,
        true,
        false,
    );
}

// Decodes a caller-owned normalized [16,16,64] latent and copies the final
// clamped [256,256,4] HWC tensor back to caller-owned memory. The source is
// copied into a Metal shared buffer before dispatch, so it only needs to remain
// valid for this call.
fn decode_trajectory_256_from_host(
    model_root: str,
    normalized_latent: *f32,
    decoded_output: *f32,
    fixture_root: str = "tests/fixtures/vae_decoder_fp32",
) -> i32 {
    if normalized_latent.is_null() || decoded_output.is_null() {
        io::eprintln("VAE: integrated decode received a null host buffer");
        return 2;
    }
    return run_impl(model_root, "256", fixture_root, normalized_latent, decoded_output, true, false);
}

fn decode_native_prompt_256_from_host(
    model_root: str,
    normalized_latent: *f32,
    decoded_output: *f32,
    fixture_root: str = "tests/fixtures/vae_decoder_fp32",
) -> i32 {
    if normalized_latent.is_null() || decoded_output.is_null() {
        io::eprintln("VAE: native-prompt validation received a null host buffer");
        return 2;
    }
    return run_impl(model_root, "256", fixture_root, normalized_latent, decoded_output, true, true);
}

fn decode_256_from_host(
    model_root: str,
    normalized_latent: *f32,
    decoded_output: *f32,
) -> i32 {
    if normalized_latent.is_null() || decoded_output.is_null() {
        io::eprintln("VAE: native generation received a null host buffer");
        return 2;
    }
    return run_impl(model_root, "256", "", normalized_latent, decoded_output, false, false);
}

// Decodes a caller-owned normalized [64,64,64] latent into a clamped
// [1024,1024,4] HWC tensor. This uses the same still-image first-chunk VAE
// semantics as the verified 256px path; model-scale reference validation is a
// separate gate because committing a 16 MiB output fixture is undesirable.
fn decode_1024_from_host(
    model_root: str,
    normalized_latent: *f32,
    decoded_output: *f32,
) -> i32 {
    if normalized_latent.is_null() || decoded_output.is_null() {
        io::eprintln("VAE: 1024px generation received a null host buffer");
        return 2;
    }
    return run_impl(model_root, "1024", "", normalized_latent, decoded_output, false, false);
}

fn run_impl(
    model_root: str,
    requested_case: str,
    fixture_root: str,
    normalized_source: *f32,
    decoded_destination: *f32,
    validate_reference: bool,
    native_prompt_source: bool,
    profile_dispatches: bool = false,
) -> i32 {
    var input_height: usize = 0 as usize;
    var case_directory: str = "";
    if requested_case == "small" {
        input_height = 1 as usize;
        case_directory = "small_1x1";
    } else if requested_case == "256" {
        input_height = 16 as usize;
        case_directory = "trajectory_256";
    } else if requested_case == "1024" {
        input_height = 64 as usize;
        case_directory = "";
    } else if requested_case == "trajectory-1024" {
        input_height = 64 as usize;
        case_directory = "trajectory_1024";
    } else {
        io::eprintln("VAE: case must be small, 256, 1024, or trajectory-1024");
        return 2;
    }
    let input_width: usize = input_height;
    let timing_start_ms: i64 = time::now_millis();
    let fixture_directory_text: text::Text = "${fixture_root}/${case_directory}";
    let fixture_directory: str = fixture_directory_text.view();
    let model_path: text::Text = "${model_root}/vae/diffusion_pytorch_model.safetensors";
    guard let safetensors::LoadResult::Ok(file) = safetensors::load(model_path.view()) else {
        io::eprintln("VAE: could not load ${model_path}");
        return 1;
    };

    let timing_header_ms: i64 = time::now_millis();
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return 1; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    let device_pointer: *u8 = MTLCreateSystemDefaultDevice();
    if device_pointer.is_null() { return 1; }
    let device_owner: OwnedObjc = OwnedObjc::new(rt::retain(device_pointer));
    let device: metal::Device = metal::Device::from_raw(device_owner.raw());
    guard let option::Option[metal::CommandQueue]::Some(queue) = device.new_command_queue() else { return 1; };
    let queue_owner: OwnedObjc = OwnedObjc::new(queue.raw());
    let options_pointer: *u8 = rt::alloc_init(#str_ptr("MTLCompileOptions\0"));
    if options_pointer.is_null() { return 1; }
    let options_owner: OwnedObjc = OwnedObjc::new(options_pointer);
    let options: metal::CompileOptions = metal::CompileOptions::from_raw(options_owner.raw());
    options.set_fast_math_enabled(false);
    var compile_error: *u8 = 0 as *u8;
    guard let option::Option[metal::Library]::Some(library) = device.new_library_with_source(
        #include_str("../kernels/vae.metal"), options, #addr_of(compile_error) as *u8,
    ) else {
        if !compile_error.is_null() {
            let description: *u8 = rt::msg_id(compile_error, rt::sel(#str_ptr("localizedDescription\0")));
            io::eprintln("VAE Metal compile: ${bridge::to_text(description)}");
        }
        return 1;
    };
    let library_owner: OwnedObjc = OwnedObjc::new(library.raw());
    guard let option::Option[OwnedObjc]::Some(conv_owner) = pipeline(device, library, "vae_conv2d_f32_simdgroup_64x64") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(upsample_pack_owner) = pipeline(device, library, "vae_pack_nearest_upsample_3x3") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(upsample_conv_owner) = pipeline(device, library, "vae_nearest_upsample_conv2d_f32_simdgroup_64x64") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(norm_owner) = pipeline(device, library, "vae_rms_norm") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(add_owner) = pipeline(device, library, "vae_add") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(denormalize_owner) = pipeline(device, library, "vae_denormalize") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(dup_owner) = pipeline(device, library, "vae_dup_up_shortcut") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(attention_owner) = pipeline(device, library, "vae_single_head_attention") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(clamp_owner) = pipeline(device, library, "vae_clamp") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(softmax_owner) = pipeline(device, library, "vae_row_softmax") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(nearest_upsample_owner) = pipeline(device, library, "vae_nearest_upsample_2x") else { return 1; };
    // Every convolution, including nearest-2x upsample convolutions, runs
    // through MPSGraph's FP32 convolution: about 6.9 s faster at 1024 and more
    // accurate against the official oracle. QI_DISABLE_VAE_MPSGRAPH_CONV=1
    // restores the custom cooperative-matrix kernels for A/B testing.
    let disable_graph_conv: bool = env::has_var("QI_DISABLE_VAE_MPSGRAPH_CONV");
    let use_graph_conv: bool = !disable_graph_conv && graph_attention::load_frameworks();
    let disable_graph_conv_name: str = if disable_graph_conv { "on" } else { "off" };
    let use_pread: bool = !env::has_var("QI_DISABLE_VAE_PREAD");
    let disable_pread_name: str = if use_pread { "off" } else { "on" };
    let use_mps_attention: bool = !env::has_var("QI_DISABLE_VAE_MPS_ATTENTION")
        && mps::load_framework();
    let disable_mps_attention_name: str = if env::has_var("QI_DISABLE_VAE_MPS_ATTENTION") {
        "on"
    } else { "off" };
    io::println("VAE switches: disable_vae_mpsgraph_conv=${disable_graph_conv_name} graph_conv=${use_graph_conv} disable_vae_pread=${disable_pread_name} disable_vae_mps_attention=${disable_mps_attention_name} mps_attention=${use_mps_attention}");
    var graph_convs: graph_conv::Cache = graph_conv::new_cache();
    let pipelines: Pipelines = Pipelines {
        conv: metal::ComputePipelineState::from_raw(conv_owner.raw()),
        upsample_pack: metal::ComputePipelineState::from_raw(upsample_pack_owner.raw()),
        upsample_conv: metal::ComputePipelineState::from_raw(upsample_conv_owner.raw()),
        norm: metal::ComputePipelineState::from_raw(norm_owner.raw()),
        add: metal::ComputePipelineState::from_raw(add_owner.raw()),
        denormalize: metal::ComputePipelineState::from_raw(denormalize_owner.raw()),
        dup: metal::ComputePipelineState::from_raw(dup_owner.raw()),
        attention: metal::ComputePipelineState::from_raw(attention_owner.raw()),
        softmax: metal::ComputePipelineState::from_raw(softmax_owner.raw()),
        nearest_upsample: metal::ComputePipelineState::from_raw(nearest_upsample_owner.raw()),
        clamp: metal::ComputePipelineState::from_raw(clamp_owner.raw()),
        graph_convs: if use_graph_conv { #addr_of(graph_convs) } else { 0 as *graph_conv::Cache },
    };

    let timing_pipelines_ms: i64 = time::now_millis();
    guard let option::Option[metal::Buffer]::Some(storage) = if use_pread {
        read_storage_buffer(device, model_path.view(), file.mapping_length())
    } else { mapped_storage_buffer(device, file) } else {
        io::eprintln("VAE: could not create the weight buffer");
        return 1;
    };
    let storage_owner: OwnedObjc = OwnedObjc::new(storage.raw());
    let input_elements: usize = input_height *% input_width *% (64 as usize);
    guard let option::Option[metal::Buffer]::Some(normalized) = normalized_input_buffer(
        device,
        fixture_directory,
        normalized_source,
        (input_elements *% #size_of::[f32]()) as u64,
    ) else { return 1; };
    let normalized_owner: OwnedObjc = OwnedObjc::new(normalized.raw());
    guard let option::Option[metal::Buffer]::Some(mean) = device.new_buffer_with_bytes(#addr_of(LATENTS_MEAN[0]) as *u8, (64 as u64) *% (4 as u64), metal::resource_options_m_t_l_resource_storage_mode_shared) else { return 1; };
    let mean_owner: OwnedObjc = OwnedObjc::new(mean.raw());
    guard let option::Option[metal::Buffer]::Some(standard_deviation) = device.new_buffer_with_bytes(#addr_of(LATENTS_STD[0]) as *u8, (64 as u64) *% (4 as u64), metal::resource_options_m_t_l_resource_storage_mode_shared) else { return 1; };
    let standard_deviation_owner: OwnedObjc = OwnedObjc::new(standard_deviation.raw());

    let output_height: usize = input_height *% (16 as usize);
    let output_width: usize = input_width *% (16 as usize);
    // The final two up blocks establish two different maxima. buffer_b and
    // block_shortcut must hold the 288-channel 1024px block-3 upsample, while
    // buffer_c must also hold the 288-channel block-4 norm1 input; the other
    // three residual temporaries peak at the following 144-channel shape.
    // Sizing all six arenas to the larger shape wastes 1.6875 GiB at 1024px.
    let wide_activation_elements: usize = output_height *% output_width *% (288 as usize);
    let narrow_activation_elements: usize = output_height *% output_width *% (144 as usize);
    let wide_activation_bytes: u64 = (wide_activation_elements *% #size_of::[f32]()) as u64;
    let narrow_activation_bytes: u64 = (narrow_activation_elements *% #size_of::[f32]()) as u64;
    let qkv_bytes: u64 = (input_height *% input_width *% (3456 as usize) *% #size_of::[f32]()) as u64;
    // Only the custom upsample kernels read the parity-packed weights.
    let upsample_weight_bytes: u64 = if use_graph_conv { 4 as u64 } else {
        ((16 as usize) *% (1152 as usize) *% (1152 as usize) *% #size_of::[f32]()) as u64
    };
    guard let option::Option[metal::Buffer]::Some(buffer_a) = new_buffer(device, narrow_activation_bytes) else { return 1; }; let buffer_a_owner: OwnedObjc = OwnedObjc::new(buffer_a.raw());
    guard let option::Option[metal::Buffer]::Some(buffer_b) = new_buffer(device, wide_activation_bytes) else { return 1; }; let buffer_b_owner: OwnedObjc = OwnedObjc::new(buffer_b.raw());
    guard let option::Option[metal::Buffer]::Some(buffer_c) = new_buffer(device, wide_activation_bytes) else { return 1; }; let buffer_c_owner: OwnedObjc = OwnedObjc::new(buffer_c.raw());
    guard let option::Option[metal::Buffer]::Some(buffer_d) = new_buffer(device, narrow_activation_bytes) else { return 1; }; let buffer_d_owner: OwnedObjc = OwnedObjc::new(buffer_d.raw());
    guard let option::Option[metal::Buffer]::Some(shortcut) = new_buffer(device, narrow_activation_bytes) else { return 1; }; let shortcut_owner: OwnedObjc = OwnedObjc::new(shortcut.raw());
    guard let option::Option[metal::Buffer]::Some(block_shortcut) = new_buffer(device, wide_activation_bytes) else { return 1; }; let block_shortcut_owner: OwnedObjc = OwnedObjc::new(block_shortcut.raw());
    guard let option::Option[metal::Buffer]::Some(qkv) = new_buffer(device, qkv_bytes) else { return 1; }; let qkv_owner: OwnedObjc = OwnedObjc::new(qkv.raw());
    let attention_pixels: usize = input_height *% input_width;
    let scores_bytes: u64 = if use_mps_attention {
        (attention_pixels *% attention_pixels *% #size_of::[f32]()) as u64
    } else { 4 as u64 };
    guard let option::Option[metal::Buffer]::Some(scores) = new_buffer(device, scores_bytes) else { return 1; }; let scores_owner: OwnedObjc = OwnedObjc::new(scores.raw());
    guard let option::Option[metal::Buffer]::Some(packed_upsample_weight) = new_buffer(device, upsample_weight_bytes) else { return 1; }; let packed_upsample_weight_owner: OwnedObjc = OwnedObjc::new(packed_upsample_weight.raw());
    let timing_buffers_ms: i64 = time::now_millis();
    guard let option::Option[metal::CommandBuffer]::Some(base_decode_command_buffer) =
        queue.command_buffer() else { return 1; };
    let base_decode_command_buffer_owner: OwnedObjc =
        OwnedObjc::new(rt::retain(base_decode_command_buffer.raw()));
    // MPSGraph encodes only into an MPSCommandBuffer, which may internally
    // commit-and-continue; GPU timestamps then cover only the final fragment.
    guard let option::Option[graph_attention::CommandBufferContext]::Some(decode_context) =
        graph_attention::wrap_command_buffer(base_decode_command_buffer, use_graph_conv) else {
        return 1;
    };
    let decode_command_buffer: metal::CommandBuffer = decode_context.metal();
    // Production has no intermediate host reads, so encode the dependency
    // chain before one commit/wait. Small-oracle and explicit profile modes
    // stay synchronous to expose individual command-buffer GPU timestamps.
    let deferred: *u8 = if requested_case != "small" && !profile_dispatches {
        decode_command_buffer.raw()
    } else {
        0 as *u8
    };

    var total_ms: f64 = 0.0f64;
    guard let option::Option[f64]::Some(denormalize_ms) = dispatch_element(queue, pipelines.denormalize, normalized, mean, standard_deviation, buffer_a, input_elements, 64, 2 as u32, deferred) else { return 1; };
    total_ms = total_ms + denormalize_ms;
    var all_ok: bool = true;
    if requested_case == "small" {
        all_ok = report_boundary("latent de-normalization", buffer_a, fixture_directory, "denormalized_latent", input_elements, 0.000001f64) && all_ok;
    }
    guard let option::Option[ConvWeight]::Some(post_quant_weight) = conv_weight(file, "post_quant_conv", 64, 64, 1) else { return 1; };
    guard let option::Option[f64]::Some(post_quant_ms) = dispatch_conv(queue, pipelines, storage, post_quant_weight, buffer_a, buffer_b, input_height, input_width, 64, 64, 1, 0, false, deferred) else { return 1; };
    total_ms = total_ms + post_quant_ms;
    if requested_case == "small" { all_ok = report_boundary("post-quant convolution", buffer_b, fixture_directory, "post_quant", input_height *% input_width *% (64 as usize), 0.000001f64) && all_ok; }
    guard let option::Option[ConvWeight]::Some(conv_in_weight) = conv_weight(file, "decoder.conv_in", 1152, 64, 3) else { return 1; };
    guard let option::Option[f64]::Some(conv_in_ms) = dispatch_conv(queue, pipelines, storage, conv_in_weight, buffer_b, buffer_a, input_height, input_width, 64, 1152, 3, 1, false, deferred) else { return 1; };
    total_ms = total_ms + conv_in_ms;
    if requested_case == "small" { all_ok = report_boundary("decoder conv_in", buffer_a, fixture_directory, "conv_in", input_height *% input_width *% (1152 as usize), 0.000001f64) && all_ok; }

    guard let option::Option[f64]::Some(mid_residual_0_ms) = execute_residual(queue, pipelines, file, storage, "decoder.mid_block.resnets.0", buffer_a, buffer_b, buffer_c, buffer_d, shortcut, input_height, input_width, 1152, 1152, deferred, profile_dispatches) else { return 1; };
    total_ms = total_ms + mid_residual_0_ms;
    guard let option::Option[u64]::Some(attention_norm) = gamma_offset(file, "decoder.mid_block.attentions.0.norm.gamma", 1152) else { return 1; };
    guard let option::Option[f64]::Some(attention_norm_ms) = dispatch_norm(queue, pipelines.norm, storage, attention_norm, buffer_b, buffer_c, input_height *% input_width, 1152, false, deferred) else { return 1; };
    total_ms = total_ms + attention_norm_ms;
    guard let option::Option[ConvWeight]::Some(qkv_weight) = conv_weight(file, "decoder.mid_block.attentions.0.to_qkv", 3456, 1152, 1) else { return 1; };
    guard let option::Option[f64]::Some(qkv_ms) = dispatch_conv(queue, pipelines, storage, qkv_weight, buffer_c, qkv, input_height, input_width, 1152, 3456, 1, 0, false, deferred) else { return 1; };
    total_ms = total_ms + qkv_ms;
    guard let option::Option[f64]::Some(attention_ms) = if use_mps_attention {
        dispatch_attention_mps(queue, device, pipelines.softmax, qkv, scores, buffer_d, attention_pixels, deferred)
    } else {
        dispatch_attention(queue, pipelines.attention, qkv, buffer_d, attention_pixels, deferred)
    } else { return 1; };
    total_ms = total_ms + attention_ms;
    guard let option::Option[ConvWeight]::Some(attention_projection) = conv_weight(file, "decoder.mid_block.attentions.0.proj", 1152, 1152, 1) else { return 1; };
    guard let option::Option[f64]::Some(attention_projection_ms) = dispatch_conv(queue, pipelines, storage, attention_projection, buffer_d, buffer_a, input_height, input_width, 1152, 1152, 1, 0, false, deferred) else { return 1; };
    total_ms = total_ms + attention_projection_ms;
    guard let option::Option[f64]::Some(attention_add_ms) = dispatch_element(queue, pipelines.add, buffer_a, buffer_b, buffer_b, buffer_a, input_height *% input_width *% (1152 as usize), 1152, 1 as u32, deferred) else { return 1; };
    total_ms = total_ms + attention_add_ms;
    guard let option::Option[f64]::Some(mid_residual_1_ms) = execute_residual(queue, pipelines, file, storage, "decoder.mid_block.resnets.1", buffer_a, buffer_b, buffer_c, buffer_d, shortcut, input_height, input_width, 1152, 1152, deferred, profile_dispatches) else { return 1; };
    total_ms = total_ms + mid_residual_1_ms;
    if profile_dispatches {
        io::println("VAE profile: stage=input denormalize_ms=${denormalize_ms} post_quant_ms=${post_quant_ms} conv_in_ms=${conv_in_ms}");
        io::println("VAE profile: stage=middle residual_0_ms=${mid_residual_0_ms} attention_norm_ms=${attention_norm_ms} qkv_ms=${qkv_ms} attention_ms=${attention_ms} attention_projection_ms=${attention_projection_ms} attention_add_ms=${attention_add_ms} residual_1_ms=${mid_residual_1_ms}");
    }
    if requested_case == "small" { all_ok = report_boundary("middle block", buffer_b, fixture_directory, "mid", input_height *% input_width *% (1152 as usize), 0.000001f64) && all_ok; }

    let input_channels_by_block: [usize; 5] = [1152 as usize, 1152 as usize, 1152 as usize, 576 as usize, 288 as usize];
    let output_channels_by_block: [usize; 5] = [1152 as usize, 1152 as usize, 576 as usize, 288 as usize, 144 as usize];
    let temporal_factors: [usize; 4] = [2 as usize, 2 as usize, 2 as usize, 1 as usize];
    var height: usize = input_height;
    var width: usize = input_width;
    var block: usize = 0 as usize;
    while block < (5 as usize) {
        let input_channels: usize = input_channels_by_block[block];
        let output_channels: usize = output_channels_by_block[block];
        let resnet_0: text::Text = "decoder.up_blocks.${block}.resnets.0";
        let resnet_1: text::Text = "decoder.up_blocks.${block}.resnets.1";
        let resnet_2: text::Text = "decoder.up_blocks.${block}.resnets.2";
        var shortcut_ms: f64 = 0.0f64;
        if block < (4 as usize) {
            // DupUp3D consumes the block input (x_copy), not the output of the
            // three residual layers. Materialize it before buffer_b is reused.
            guard let option::Option[f64]::Some(elapsed) = dispatch_dup(queue, pipelines.dup, buffer_b, block_shortcut, height, width, input_channels, output_channels, temporal_factors[block], deferred) else { return 1; };
            shortcut_ms = elapsed;
            if requested_case == "small" {
                let shortcut_name: text::Text = "up_block_0${block}_shortcut";
                all_ok = report_boundary("up block ${block} shortcut", block_shortcut, fixture_directory, shortcut_name.view(), height *% (2 as usize) *% width *% (2 as usize) *% output_channels, 0.000005f64) && all_ok;
            }
        }
        guard let option::Option[f64]::Some(resnet_0_ms) = execute_residual(queue, pipelines, file, storage, resnet_0.view(), buffer_b, buffer_a, buffer_c, buffer_d, shortcut, height, width, input_channels, output_channels, deferred, profile_dispatches) else { return 1; };
        if requested_case == "small" {
            let name: text::Text = "up_block_0${block}_resnet_0";
            all_ok = report_boundary("up block ${block} residual 0", buffer_a, fixture_directory, name.view(), height *% width *% output_channels, 0.000005f64) && all_ok;
        }
        guard let option::Option[f64]::Some(resnet_1_ms) = execute_residual(queue, pipelines, file, storage, resnet_1.view(), buffer_a, buffer_b, buffer_c, buffer_d, shortcut, height, width, output_channels, output_channels, deferred, profile_dispatches) else { return 1; };
        if requested_case == "small" {
            let name: text::Text = "up_block_0${block}_resnet_1";
            all_ok = report_boundary("up block ${block} residual 1", buffer_b, fixture_directory, name.view(), height *% width *% output_channels, 0.000005f64) && all_ok;
        }
        guard let option::Option[f64]::Some(resnet_2_ms) = execute_residual(queue, pipelines, file, storage, resnet_2.view(), buffer_b, buffer_a, buffer_c, buffer_d, shortcut, height, width, output_channels, output_channels, deferred, profile_dispatches) else { return 1; };
        if requested_case == "small" {
            let name: text::Text = "up_block_0${block}_resnet_2";
            all_ok = report_boundary("up block ${block} residual 2", buffer_a, fixture_directory, name.view(), height *% width *% output_channels, 0.000005f64) && all_ok;
        }
        var block_ms: f64 = shortcut_ms + resnet_0_ms + resnet_1_ms + resnet_2_ms;
        total_ms = total_ms + block_ms;
        var boundary: metal::Buffer = buffer_a;
        var upsample_ms_profile: f64 = 0.0f64;
        var upsample_add_ms_profile: f64 = 0.0f64;
        if block < (4 as usize) {
            let upsample_name: text::Text = "decoder.up_blocks.${block}.upsampler.resample.1";
            guard let option::Option[ConvWeight]::Some(upsample_weight) = conv_weight(file, upsample_name.view(), output_channels, output_channels, 3) else { return 1; };
            let upsample_result: option::Option[f64] = if pipelines.graph_convs.is_null() {
                dispatch_upsample_conv(
                    queue, pipelines.upsample_pack, pipelines.upsample_conv, storage,
                    upsample_weight, packed_upsample_weight, buffer_a, buffer_b, height,
                    width, output_channels, deferred,
                )
            } else {
                dispatch_graph_upsample_conv(
                    queue, pipelines, storage, upsample_weight, buffer_a, buffer_c, buffer_b,
                    height, width, output_channels, deferred,
                )
            };
            guard let option::Option[f64]::Some(upsample_ms) = upsample_result else { return 1; };
            if requested_case == "small" {
                let main_name: text::Text = "up_block_0${block}_main_upsample";
                all_ok = report_boundary("up block ${block} main upsample", buffer_b, fixture_directory, main_name.view(), height *% (2 as usize) *% width *% (2 as usize) *% output_channels, 0.000005f64) && all_ok;
            }
            let upsample_elements: usize = height *% (2 as usize) *% width *% (2 as usize) *% output_channels;
            guard let option::Option[f64]::Some(add_ms) = dispatch_element(queue, pipelines.add, buffer_b, block_shortcut, shortcut, buffer_b, upsample_elements, output_channels, 1 as u32, deferred) else { return 1; };
            total_ms = total_ms + upsample_ms + add_ms;
            block_ms = block_ms + upsample_ms + add_ms;
            upsample_ms_profile = upsample_ms;
            upsample_add_ms_profile = add_ms;
            height = height *% (2 as usize);
            width = width *% (2 as usize);
            boundary = buffer_b;
        }
        if requested_case == "small" {
            let boundary_name: text::Text = "up_block_0${block}";
            all_ok = report_boundary("up block ${block}", boundary, fixture_directory, boundary_name.view(), height *% width *% output_channels, 0.000005f64) && all_ok;
        }
        if profile_dispatches {
            io::println("VAE profile: stage=up_block block=${block} height=${height} width=${width} input_channels=${input_channels} output_channels=${output_channels} shortcut_ms=${shortcut_ms} residual_0_ms=${resnet_0_ms} residual_1_ms=${resnet_1_ms} residual_2_ms=${resnet_2_ms} upsample_ms=${upsample_ms_profile} upsample_add_ms=${upsample_add_ms_profile} total_ms=${block_ms}");
        }
        block = block +% (1 as usize);
    }

    guard let option::Option[u64]::Some(final_norm_gamma) = gamma_offset(file, "decoder.norm_out.gamma", 144) else { return 1; };
    if requested_case == "small" {
        guard let option::Option[f64]::Some(final_norm_ms) = dispatch_norm(queue, pipelines.norm, storage, final_norm_gamma, buffer_a, buffer_c, height *% width, 144, false, deferred) else { return 1; };
        total_ms = total_ms + final_norm_ms;
        all_ok = report_boundary("final RMS norm", buffer_c, fixture_directory, "norm_out", height *% width *% (144 as usize), 0.000002f64) && all_ok;
    }
    guard let option::Option[f64]::Some(final_norm_silu_ms) = dispatch_norm(queue, pipelines.norm, storage, final_norm_gamma, buffer_a, buffer_d, height *% width, 144, true, deferred) else { return 1; };
    total_ms = total_ms + final_norm_silu_ms;
    guard let option::Option[ConvWeight]::Some(conv_out_weight) = conv_weight(file, "decoder.conv_out", 4, 144, 3) else { return 1; };
    guard let option::Option[f64]::Some(conv_out_ms) = dispatch_conv(queue, pipelines, storage, conv_out_weight, buffer_d, buffer_b, height, width, 144, 4, 3, 1, false, deferred) else { return 1; };
    total_ms = total_ms + conv_out_ms;
    if requested_case == "small" { all_ok = report_boundary("decoder conv_out", buffer_b, fixture_directory, "conv_out", height *% width *% (4 as usize), 0.000002f64) && all_ok; }
    guard let option::Option[f64]::Some(clamp_ms) = dispatch_clamp(queue, pipelines.clamp, buffer_b, buffer_a, height *% width *% (4 as usize), deferred) else { return 1; };
    total_ms = total_ms + clamp_ms;
    if profile_dispatches {
        io::println("VAE profile: stage=output norm_silu_ms=${final_norm_silu_ms} conv_out_ms=${conv_out_ms} clamp_ms=${clamp_ms}");
    }
    let timing_encoded_ms: i64 = time::now_millis();
    if !deferred.is_null() {
        decode_command_buffer.commit();
        decode_command_buffer.wait_until_completed();
        total_ms = (decode_command_buffer.g_p_u_end_time()
            - decode_command_buffer.g_p_u_start_time()) * 1000.0f64;
    }
    let output_count: usize = height *% width *% (4 as usize);
    var output_error: f64 = 0.0f64;
    var output_limit: f64 = 0.0f64;
    if validate_reference {
        guard let option::Option[f64]::Some(error) = normalized_rms_fixture(buffer_a, fixture_directory, "output", output_count) else { return 1; };
        output_error = error;
        output_limit = if native_prompt_source {
            // The native text/trajectory integration has its own measured
            // 2% latent boundary; do not weaken the 1.3% fixture-fed gate.
            0.02f64
        } else if requested_case == "small" {
            0.000002f64
        } else if normalized_source.is_null() {
            0.000003f64
        } else {
            0.013f64
        };
        all_ok = output_error <= output_limit && all_ok;
    }
    let timing_completed_ms: i64 = time::now_millis();
    all_ok = finite(buffer_a, output_count) && all_ok;
    if !decoded_destination.is_null() {
        let decoded_count: usize = height *% width *% (4 as usize);
        let _copied: *u8 = qi_memcpy(
            decoded_destination as *u8, buffer_a.contents(),
            decoded_count *% #size_of::[f32](),
        );
    }
    io::println("VAE timing: header_ms=${timing_header_ms - timing_start_ms} device_library_pipelines_ms=${timing_pipelines_ms - timing_header_ms} storage_and_buffers_ms=${timing_buffers_ms - timing_pipelines_ms} encode_ms=${timing_encoded_ms - timing_buffers_ms} commit_wait_ms=${timing_completed_ms - timing_encoded_ms} finite_and_readback_ms=${time::now_millis() - timing_completed_ms}");
    if validate_reference {
        io::println("VAE decode: case=${requested_case} input=${input_height}x${input_width} output=${height}x${width} mapped_weight_bytes=${round_up(file.mapping_length(), VM_PAGE_BYTES)} scratch_bytes=${(3 as u64) *% wide_activation_bytes + (3 as u64) *% narrow_activation_bytes + qkv_bytes + upsample_weight_bytes + scores_bytes} gpu_ms=${total_ms} output_nRMSE=${output_error} limit=${output_limit}");
    } else {
        io::println("VAE decode: case=${requested_case} input=${input_height}x${input_width} output=${height}x${width} mapped_weight_bytes=${round_up(file.mapping_length(), VM_PAGE_BYTES)} scratch_bytes=${(3 as u64) *% wide_activation_bytes + (3 as u64) *% narrow_activation_bytes + qkv_bytes + upsample_weight_bytes + scores_bytes} gpu_ms=${total_ms}");
    }
    if all_ok {
        if validate_reference {
            io::println("Qwen-Image-2.1 still-image VAE decoder: verified");
        } else {
            io::println("Qwen-Image-2.1 still-image VAE decoder: complete");
        }
        return 0;
    }
    return 1;
}

#[test]
fn decoder_channel_and_scale_plan_matches_pinned_config() {
    let input_channels: [usize; 5] = [1152 as usize, 1152 as usize, 1152 as usize, 576 as usize, 288 as usize];
    let output_channels: [usize; 5] = [1152 as usize, 1152 as usize, 576 as usize, 288 as usize, 144 as usize];
    assert input_channels[0] == 144 as usize *% (8 as usize);
    assert output_channels[4] == (144 as usize);
    assert (16 as usize) *% (2 as usize) *% (2 as usize) *% (2 as usize) *% (2 as usize) == (256 as usize);
}

#[test]
fn first_chunk_dup_mapping_stays_in_range() {
    let input_channels: usize = 1152 as usize;
    let output_channels: usize = 576 as usize;
    let factor_t: usize = 2 as usize;
    let repeats: usize = output_channels *% factor_t *% (4 as usize) / input_channels;
    assert repeats == (4 as usize);
    let final_repeated_channel: usize = (((output_channels -% (1 as usize)) *% factor_t
        +% (factor_t -% (1 as usize))) *% (2 as usize) +% (1 as usize)) *% (2 as usize)
        +% (1 as usize);
    assert final_repeated_channel / repeats < input_channels;
}
