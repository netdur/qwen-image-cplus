extern fn MTLCreateSystemDefaultDevice() -> *u8;

const ROWS: usize = 4;
const COMPLETE_TEXT_ROWS: usize = 4;
const COMPLETE_IMAGE_ROWS: usize = 12;
const COMPLETE_ROWS: usize = 15;
const IMAGE_CHANNELS: usize = 64;
const WIDTH: usize = 4096;
const HEADS: usize = 32;
const HEAD_DIMENSION: usize = 128;
const MLP_WIDTH: usize = 12288;
const TILE: usize = 16;
const OUTPUT_TILE: usize = 32;
const PACKED_SCHEME_BF16: u32 = 0;
const PACKED_SCHEME_INT8_AFFINE: u32 = 3;
const VM_PAGE_BYTES: usize = 16384;

struct OwnedObjc {
    opaque pointer: *u8,
}

#[repr(C)]
struct PackedDeallocatorBlock {
    opaque isa: *u8,
    flags: i32,
    reserved: i32,
    invoke: fn(*u8, *u8, u64),
    opaque descriptor: *u8,
}

// Metal retains the no-copy deallocator block until the buffer dies, so its
// descriptor cannot live on the stack like a synchronous callback's can.
static PACKED_DEALLOCATOR_DESCRIPTOR: rt::BlockDescriptor = rt::BlockDescriptor {
    reserved: 0 as u64,
    size: 32 as u64,
};

fn packed_deallocator_invoke(_block: *u8, _pointer: *u8, _length: u64) {}

impl OwnedObjc {
    fn new(pointer: *u8) -> OwnedObjc {
        return OwnedObjc { pointer: pointer };
    }

    fn raw(this) -> *u8 {
        return this.pointer;
    }

    fn drop(ref this) {
        if !this.pointer.is_null() {
            rt::release(this.pointer);
            this.pointer = 0 as *u8;
        }
    }
}

#[repr(C)]
struct LinearParams {
    rows: u32,
    output_columns: u32,
    input_columns: u32,
    weight_mode: u32,
}

#[repr(C)]
struct Int8LinearParams {
    rows: u32,
    output_columns: u32,
    input_columns: u32,
    group_size: u32,
}

#[repr(C)]
struct AttentionParams {
    query_rows: u32,
    key_rows: u32,
    heads: u32,
    head_dimension: u32,
    query_position_offset: u32,
    block_causal: u32,
    cached_prefix_rows: u32,
}

struct LinearWeight {
    storage: metal::Buffer,
    scheme: u32,
    weights_offset: u64,
    scales_offset: u64,
    zeros_offset: u64,
}

struct BlockWeights {
    norm_q: metal::Buffer,
    norm_k: metal::Buffer,
    q: LinearWeight,
    k: LinearWeight,
    v: LinearWeight,
    attention_output: LinearWeight,
    gate: LinearWeight,
    projected: LinearWeight,
    mlp_output: LinearWeight,
}

struct Pipelines {
    dense_linear: metal::ComputePipelineState,
    int8_linear: metal::ComputePipelineState,
    norm: metal::ComputePipelineState,
    qk: metal::ComputePipelineState,
    attention: metal::ComputePipelineState,
    residual: metal::ComputePipelineState,
    swiglu: metal::ComputePipelineState,
}

struct BlockWorkspace {
    modulation: metal::Buffer,
    rope: metal::Buffer,
    target_mask: metal::Buffer,
    image_ids: metal::Buffer,
    key_valid: metal::Buffer,
    dummy: metal::Buffer,
    norm1: metal::Buffer,
    query: metal::Buffer,
    key: metal::Buffer,
    value: metal::Buffer,
    query_rope: metal::Buffer,
    key_rope: metal::Buffer,
    attended: metal::Buffer,
    attention_projected: metal::Buffer,
    residual1: metal::Buffer,
    norm2: metal::Buffer,
    gate: metal::Buffer,
    projected: metal::Buffer,
    swiglu: metal::Buffer,
    mlp_projected: metal::Buffer,
}

#[repr(C)]
struct BlockParams {
    rows: u32,
    width: u32,
    heads: u32,
    head_dimension: u32,
    epsilon: f32,
    slot: u32,
}

fn round_up(value: usize, multiple: usize) -> usize {
    return ((value +% multiple -% (1 as usize)) / multiple) *% multiple;
}

fn pipeline(
    device: metal::Device,
    library: metal::Library,
    name: str,
) -> option::Option[OwnedObjc] {
    guard let option::Option[metal::Function]::Some(function) = library.new_function_with_name(name) else {
        io::eprintln("transformer block: missing Metal function ${name}");
        return option::Option[OwnedObjc]::None;
    };
    let function_owner: OwnedObjc = OwnedObjc::new(function.raw());
    guard let option::Option[metal::ComputePipelineState]::Some(value) =
        device.new_compute_pipeline_state_with_function(function, 0 as *u8) else {
        io::eprintln("transformer block: could not create ${name} pipeline");
        return option::Option[OwnedObjc]::None;
    };
    return option::Option[OwnedObjc]::Some(OwnedObjc::new(value.raw()));
}

fn dispatch_linear(
    queue: metal::CommandQueue,
    pipeline: metal::ComputePipelineState,
    input: metal::Buffer,
    weights: metal::Buffer,
    output: metal::Buffer,
    output_columns: usize,
    input_columns: usize,
    rows: usize,
    weights_offset: u64 = 0 as u64,
) -> option::Option[f64] {
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() {
        return option::Option[f64]::None;
    }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    guard let option::Option[metal::CommandBuffer]::Some(command_buffer) = queue.command_buffer() else {
        return option::Option[f64]::None;
    };
    let command_buffer_owner: OwnedObjc = OwnedObjc::new(rt::retain(command_buffer.raw()));
    guard let option::Option[metal::ComputeCommandEncoder]::Some(encoder) =
        command_buffer.compute_command_encoder() else {
        return option::Option[f64]::None;
    };
    let encoder_owner: OwnedObjc = OwnedObjc::new(rt::retain(encoder.raw()));
    var params: LinearParams = LinearParams {
        rows: rows as u32,
        output_columns: output_columns as u32,
        input_columns: input_columns as u32,
        weight_mode: 0 as u32,
    };
    encoder.set_compute_pipeline_state(pipeline);
    encoder.set_buffer(input, 0 as u64, 0 as u64);
    encoder.set_buffer(weights, weights_offset, 1 as u64);
    encoder.set_buffer(output, 0 as u64, 2 as u64);
    encoder.set_bytes(#addr_of(params) as *u8, #size_of::[LinearParams]() as u64, 3 as u64);
    encoder.dispatch_threadgroups(
        metal::Size {
            width: (round_up(output_columns, OUTPUT_TILE) / OUTPUT_TILE) as u64,
            height: (round_up(rows, OUTPUT_TILE) / OUTPUT_TILE) as u64,
            depth: 1 as u64,
        },
        metal::Size { width: TILE as u64, height: TILE as u64, depth: 1 as u64 },
    );
    let command_encoder: metal::CommandEncoder = metal::CommandEncoder::from_raw(encoder.raw());
    command_encoder.end_encoding();
    command_buffer.commit();
    command_buffer.wait_until_completed();
    return option::Option[f64]::Some(
        (command_buffer.g_p_u_end_time() - command_buffer.g_p_u_start_time()) * 1000.0f64,
    );
}

fn dispatch_int8_linear(
    queue: metal::CommandQueue,
    pipeline: metal::ComputePipelineState,
    input: metal::Buffer,
    weight: LinearWeight,
    output: metal::Buffer,
    output_columns: usize,
    input_columns: usize,
    rows: usize,
) -> option::Option[f64] {
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() {
        return option::Option[f64]::None;
    }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    guard let option::Option[metal::CommandBuffer]::Some(command_buffer) = queue.command_buffer() else {
        return option::Option[f64]::None;
    };
    let command_buffer_owner: OwnedObjc = OwnedObjc::new(rt::retain(command_buffer.raw()));
    guard let option::Option[metal::ComputeCommandEncoder]::Some(encoder) =
        command_buffer.compute_command_encoder() else {
        return option::Option[f64]::None;
    };
    let encoder_owner: OwnedObjc = OwnedObjc::new(rt::retain(encoder.raw()));
    var params: Int8LinearParams = Int8LinearParams {
        rows: rows as u32,
        output_columns: output_columns as u32,
        input_columns: input_columns as u32,
        group_size: 64 as u32,
    };
    encoder.set_compute_pipeline_state(pipeline);
    encoder.set_buffer(input, 0 as u64, 0 as u64);
    encoder.set_buffer(weight.storage, weight.weights_offset, 1 as u64);
    encoder.set_buffer(weight.storage, weight.scales_offset, 2 as u64);
    encoder.set_buffer(weight.storage, weight.zeros_offset, 3 as u64);
    encoder.set_buffer(output, 0 as u64, 4 as u64);
    encoder.set_bytes(#addr_of(params) as *u8, #size_of::[Int8LinearParams]() as u64, 5 as u64);
    encoder.dispatch_threadgroups(
        metal::Size {
            width: (round_up(output_columns, OUTPUT_TILE) / OUTPUT_TILE) as u64,
            height: (round_up(rows, OUTPUT_TILE) / OUTPUT_TILE) as u64,
            depth: 1 as u64,
        },
        metal::Size { width: TILE as u64, height: TILE as u64, depth: 1 as u64 },
    );
    let command_encoder: metal::CommandEncoder = metal::CommandEncoder::from_raw(encoder.raw());
    command_encoder.end_encoding();
    command_buffer.commit();
    command_buffer.wait_until_completed();
    return option::Option[f64]::Some(
        (command_buffer.g_p_u_end_time() - command_buffer.g_p_u_start_time()) * 1000.0f64,
    );
}

fn dispatch_weighted_linear(
    queue: metal::CommandQueue,
    pipelines: Pipelines,
    input: metal::Buffer,
    weight: LinearWeight,
    output: metal::Buffer,
    output_columns: usize,
    input_columns: usize,
    rows: usize,
) -> option::Option[f64] {
    if weight.scheme == PACKED_SCHEME_INT8_AFFINE {
        return dispatch_int8_linear(
            queue,
            pipelines.int8_linear,
            input,
            weight,
            output,
            output_columns,
            input_columns,
            rows,
        );
    }
    return dispatch_linear(
        queue,
        pipelines.dense_linear,
        input,
        weight.storage,
        output,
        output_columns,
        input_columns,
        rows,
        weight.weights_offset,
    );
}

fn dispatch_1d(
    queue: metal::CommandQueue,
    pipeline: metal::ComputePipelineState,
    buffer_0: metal::Buffer,
    buffer_1: metal::Buffer,
    buffer_2: metal::Buffer,
    buffer_3: metal::Buffer,
    buffer_5: metal::Buffer,
    buffer_6: metal::Buffer,
    parameters: *BlockParams,
    thread_count: usize,
) -> option::Option[f64] {
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() {
        return option::Option[f64]::None;
    }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    guard let option::Option[metal::CommandBuffer]::Some(command_buffer) = queue.command_buffer() else {
        return option::Option[f64]::None;
    };
    let command_buffer_owner: OwnedObjc = OwnedObjc::new(rt::retain(command_buffer.raw()));
    guard let option::Option[metal::ComputeCommandEncoder]::Some(encoder) =
        command_buffer.compute_command_encoder() else {
        return option::Option[f64]::None;
    };
    let encoder_owner: OwnedObjc = OwnedObjc::new(rt::retain(encoder.raw()));
    encoder.set_compute_pipeline_state(pipeline);
    encoder.set_buffer(buffer_0, 0 as u64, 0 as u64);
    encoder.set_buffer(buffer_1, 0 as u64, 1 as u64);
    encoder.set_buffer(buffer_2, 0 as u64, 2 as u64);
    encoder.set_buffer(buffer_3, 0 as u64, 3 as u64);
    encoder.set_bytes(parameters as *u8, #size_of::[BlockParams]() as u64, 4 as u64);
    encoder.set_buffer(buffer_5, 0 as u64, 5 as u64);
    encoder.set_buffer(buffer_6, 0 as u64, 6 as u64);
    let width: u64 = pipeline.thread_execution_width();
    encoder.dispatch_threads(
        metal::Size { width: thread_count as u64, height: 1 as u64, depth: 1 as u64 },
        metal::Size { width: width, height: 1 as u64, depth: 1 as u64 },
    );
    let command_encoder: metal::CommandEncoder = metal::CommandEncoder::from_raw(encoder.raw());
    command_encoder.end_encoding();
    command_buffer.commit();
    command_buffer.wait_until_completed();
    return option::Option[f64]::Some(
        (command_buffer.g_p_u_end_time() - command_buffer.g_p_u_start_time()) * 1000.0f64,
    );
}

fn dispatch_attention(
    queue: metal::CommandQueue,
    pipeline: metal::ComputePipelineState,
    query: metal::Buffer,
    key: metal::Buffer,
    output: metal::Buffer,
    value: metal::Buffer,
    image_ids: metal::Buffer,
    key_valid: metal::Buffer,
    query_rows: usize,
    key_rows: usize,
    cache_key: metal::Buffer,
    cache_value: metal::Buffer,
    cache_offset: u64,
    query_position_offset: usize = 0 as usize,
    block_causal: bool = true,
    cached_prefix_rows: usize = 0 as usize,
) -> option::Option[f64] {
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return option::Option[f64]::None; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    guard let option::Option[metal::CommandBuffer]::Some(command_buffer) = queue.command_buffer() else {
        return option::Option[f64]::None;
    };
    let command_buffer_owner: OwnedObjc = OwnedObjc::new(rt::retain(command_buffer.raw()));
    guard let option::Option[metal::ComputeCommandEncoder]::Some(encoder) =
        command_buffer.compute_command_encoder() else {
        return option::Option[f64]::None;
    };
    let encoder_owner: OwnedObjc = OwnedObjc::new(rt::retain(encoder.raw()));
    var params: AttentionParams = AttentionParams {
        query_rows: query_rows as u32,
        key_rows: key_rows as u32,
        heads: HEADS as u32,
        head_dimension: HEAD_DIMENSION as u32,
        query_position_offset: query_position_offset as u32,
        block_causal: if block_causal { 1 as u32 } else { 0 as u32 },
        cached_prefix_rows: cached_prefix_rows as u32,
    };
    encoder.set_compute_pipeline_state(pipeline);
    encoder.set_buffer(query, 0 as u64, 0 as u64);
    encoder.set_buffer(key, 0 as u64, 1 as u64);
    encoder.set_buffer(output, 0 as u64, 2 as u64);
    encoder.set_buffer(value, 0 as u64, 3 as u64);
    encoder.set_bytes(#addr_of(params) as *u8, #size_of::[AttentionParams]() as u64, 4 as u64);
    encoder.set_buffer(image_ids, 0 as u64, 5 as u64);
    encoder.set_buffer(key_valid, 0 as u64, 6 as u64);
    encoder.set_buffer(cache_key, cache_offset, 7 as u64);
    encoder.set_buffer(cache_value, cache_offset, 8 as u64);
    encoder.dispatch_threadgroups(
        metal::Size { width: (query_rows *% HEADS) as u64, height: 1 as u64, depth: 1 as u64 },
        metal::Size { width: HEAD_DIMENSION as u64, height: 1 as u64, depth: 1 as u64 },
    );
    let command_encoder: metal::CommandEncoder = metal::CommandEncoder::from_raw(encoder.raw());
    command_encoder.end_encoding();
    command_buffer.commit();
    command_buffer.wait_until_completed();
    return option::Option[f64]::Some(
        (command_buffer.g_p_u_end_time() - command_buffer.g_p_u_start_time()) * 1000.0f64,
    );
}

fn dispatch_copy_prefix(
    queue: metal::CommandQueue,
    pipeline: metal::ComputePipelineState,
    key: metal::Buffer,
    value: metal::Buffer,
    cache_key: metal::Buffer,
    cache_value: metal::Buffer,
    cache_offset: u64,
    rows: usize,
    dummy: metal::Buffer,
) -> option::Option[f64] {
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return option::Option[f64]::None; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    guard let option::Option[metal::CommandBuffer]::Some(command_buffer) = queue.command_buffer() else {
        return option::Option[f64]::None;
    };
    let command_buffer_owner: OwnedObjc = OwnedObjc::new(rt::retain(command_buffer.raw()));
    guard let option::Option[metal::ComputeCommandEncoder]::Some(encoder) = command_buffer.compute_command_encoder() else {
        return option::Option[f64]::None;
    };
    let encoder_owner: OwnedObjc = OwnedObjc::new(rt::retain(encoder.raw()));
    var params: BlockParams = BlockParams { rows: rows as u32, width: WIDTH as u32, heads: HEADS as u32, head_dimension: HEAD_DIMENSION as u32, epsilon: 0.000001f32, slot: 0 as u32 };
    encoder.set_compute_pipeline_state(pipeline);
    encoder.set_buffer(key, 0 as u64, 0 as u64);
    encoder.set_buffer(value, 0 as u64, 1 as u64);
    encoder.set_buffer(cache_key, cache_offset, 2 as u64);
    encoder.set_buffer(cache_value, cache_offset, 3 as u64);
    encoder.set_bytes(#addr_of(params) as *u8, #size_of::[BlockParams]() as u64, 4 as u64);
    encoder.set_buffer(dummy, 0 as u64, 5 as u64);
    encoder.set_buffer(dummy, 0 as u64, 6 as u64);
    let threads: u64 = pipeline.thread_execution_width();
    encoder.dispatch_threads(
        metal::Size { width: (rows *% WIDTH) as u64, height: 1 as u64, depth: 1 as u64 },
        metal::Size { width: threads, height: 1 as u64, depth: 1 as u64 },
    );
    let command_encoder: metal::CommandEncoder = metal::CommandEncoder::from_raw(encoder.raw());
    command_encoder.end_encoding();
    command_buffer.commit();
    command_buffer.wait_until_completed();
    return option::Option[f64]::Some(
        (command_buffer.g_p_u_end_time() - command_buffer.g_p_u_start_time()) * 1000.0f64,
    );
}

// Batched transformer blocks keep one compute encoder open and place an
// explicit buffer barrier between dependent dispatches. The standalone
// dispatch helpers above remain the unfused regression path used by the
// operator and boundary tests.
fn encode_linear(
    encoder: metal::ComputeCommandEncoder,
    pipeline: metal::ComputePipelineState,
    input: metal::Buffer,
    weights: metal::Buffer,
    output: metal::Buffer,
    output_columns: usize,
    input_columns: usize,
    rows: usize,
    weights_offset: u64 = 0 as u64,
) {
    var params: LinearParams = LinearParams {
        rows: rows as u32,
        output_columns: output_columns as u32,
        input_columns: input_columns as u32,
        weight_mode: 0 as u32,
    };
    encoder.set_compute_pipeline_state(pipeline);
    encoder.set_buffer(input, 0 as u64, 0 as u64);
    encoder.set_buffer(weights, weights_offset, 1 as u64);
    encoder.set_buffer(output, 0 as u64, 2 as u64);
    encoder.set_bytes(#addr_of(params) as *u8, #size_of::[LinearParams]() as u64, 3 as u64);
    encoder.dispatch_threadgroups(
        metal::Size {
            width: (round_up(output_columns, OUTPUT_TILE) / OUTPUT_TILE) as u64,
            height: (round_up(rows, OUTPUT_TILE) / OUTPUT_TILE) as u64,
            depth: 1 as u64,
        },
        metal::Size { width: TILE as u64, height: TILE as u64, depth: 1 as u64 },
    );
}

fn encode_int8_linear(
    encoder: metal::ComputeCommandEncoder,
    pipeline: metal::ComputePipelineState,
    input: metal::Buffer,
    weight: LinearWeight,
    output: metal::Buffer,
    output_columns: usize,
    input_columns: usize,
    rows: usize,
) {
    var params: Int8LinearParams = Int8LinearParams {
        rows: rows as u32,
        output_columns: output_columns as u32,
        input_columns: input_columns as u32,
        group_size: 64 as u32,
    };
    encoder.set_compute_pipeline_state(pipeline);
    encoder.set_buffer(input, 0 as u64, 0 as u64);
    encoder.set_buffer(weight.storage, weight.weights_offset, 1 as u64);
    encoder.set_buffer(weight.storage, weight.scales_offset, 2 as u64);
    encoder.set_buffer(weight.storage, weight.zeros_offset, 3 as u64);
    encoder.set_buffer(output, 0 as u64, 4 as u64);
    encoder.set_bytes(#addr_of(params) as *u8, #size_of::[Int8LinearParams]() as u64, 5 as u64);
    encoder.dispatch_threadgroups(
        metal::Size {
            width: (round_up(output_columns, OUTPUT_TILE) / OUTPUT_TILE) as u64,
            height: (round_up(rows, OUTPUT_TILE) / OUTPUT_TILE) as u64,
            depth: 1 as u64,
        },
        metal::Size { width: TILE as u64, height: TILE as u64, depth: 1 as u64 },
    );
}

fn encode_weighted_linear(
    encoder: metal::ComputeCommandEncoder,
    pipelines: Pipelines,
    input: metal::Buffer,
    weight: LinearWeight,
    output: metal::Buffer,
    output_columns: usize,
    input_columns: usize,
    rows: usize,
) {
    if weight.scheme == PACKED_SCHEME_INT8_AFFINE {
        encode_int8_linear(
            encoder,
            pipelines.int8_linear,
            input,
            weight,
            output,
            output_columns,
            input_columns,
            rows,
        );
        return;
    }
    encode_linear(
        encoder,
        pipelines.dense_linear,
        input,
        weight.storage,
        output,
        output_columns,
        input_columns,
        rows,
        weight.weights_offset,
    );
}

fn encode_1d(
    encoder: metal::ComputeCommandEncoder,
    pipeline: metal::ComputePipelineState,
    buffer_0: metal::Buffer,
    buffer_1: metal::Buffer,
    buffer_2: metal::Buffer,
    buffer_3: metal::Buffer,
    buffer_5: metal::Buffer,
    buffer_6: metal::Buffer,
    parameters: *BlockParams,
    thread_count: usize,
) {
    encoder.set_compute_pipeline_state(pipeline);
    encoder.set_buffer(buffer_0, 0 as u64, 0 as u64);
    encoder.set_buffer(buffer_1, 0 as u64, 1 as u64);
    encoder.set_buffer(buffer_2, 0 as u64, 2 as u64);
    encoder.set_buffer(buffer_3, 0 as u64, 3 as u64);
    encoder.set_bytes(parameters as *u8, #size_of::[BlockParams]() as u64, 4 as u64);
    encoder.set_buffer(buffer_5, 0 as u64, 5 as u64);
    encoder.set_buffer(buffer_6, 0 as u64, 6 as u64);
    let width: u64 = pipeline.thread_execution_width();
    encoder.dispatch_threads(
        metal::Size { width: thread_count as u64, height: 1 as u64, depth: 1 as u64 },
        metal::Size { width: width, height: 1 as u64, depth: 1 as u64 },
    );
}

fn encode_attention(
    encoder: metal::ComputeCommandEncoder,
    pipeline: metal::ComputePipelineState,
    query: metal::Buffer,
    key: metal::Buffer,
    output: metal::Buffer,
    value: metal::Buffer,
    image_ids: metal::Buffer,
    key_valid: metal::Buffer,
    query_rows: usize,
    key_rows: usize,
    cache_key: metal::Buffer,
    cache_value: metal::Buffer,
    cache_offset: u64,
    query_position_offset: usize = 0 as usize,
    block_causal: bool = true,
    cached_prefix_rows: usize = 0 as usize,
) {
    var params: AttentionParams = AttentionParams {
        query_rows: query_rows as u32,
        key_rows: key_rows as u32,
        heads: HEADS as u32,
        head_dimension: HEAD_DIMENSION as u32,
        query_position_offset: query_position_offset as u32,
        block_causal: if block_causal { 1 as u32 } else { 0 as u32 },
        cached_prefix_rows: cached_prefix_rows as u32,
    };
    encoder.set_compute_pipeline_state(pipeline);
    encoder.set_buffer(query, 0 as u64, 0 as u64);
    encoder.set_buffer(key, 0 as u64, 1 as u64);
    encoder.set_buffer(output, 0 as u64, 2 as u64);
    encoder.set_buffer(value, 0 as u64, 3 as u64);
    encoder.set_bytes(#addr_of(params) as *u8, #size_of::[AttentionParams]() as u64, 4 as u64);
    encoder.set_buffer(image_ids, 0 as u64, 5 as u64);
    encoder.set_buffer(key_valid, 0 as u64, 6 as u64);
    encoder.set_buffer(cache_key, cache_offset, 7 as u64);
    encoder.set_buffer(cache_value, cache_offset, 8 as u64);
    encoder.dispatch_threadgroups(
        metal::Size { width: (query_rows *% HEADS) as u64, height: 1 as u64, depth: 1 as u64 },
        metal::Size { width: HEAD_DIMENSION as u64, height: 1 as u64, depth: 1 as u64 },
    );
}

fn encode_copy_prefix(
    encoder: metal::ComputeCommandEncoder,
    pipeline: metal::ComputePipelineState,
    key: metal::Buffer,
    value: metal::Buffer,
    cache_key: metal::Buffer,
    cache_value: metal::Buffer,
    cache_offset: u64,
    rows: usize,
    dummy: metal::Buffer,
) {
    var params: BlockParams = BlockParams { rows: rows as u32, width: WIDTH as u32, heads: HEADS as u32, head_dimension: HEAD_DIMENSION as u32, epsilon: 0.000001f32, slot: 0 as u32 };
    encoder.set_compute_pipeline_state(pipeline);
    encoder.set_buffer(key, 0 as u64, 0 as u64);
    encoder.set_buffer(value, 0 as u64, 1 as u64);
    encoder.set_buffer(cache_key, cache_offset, 2 as u64);
    encoder.set_buffer(cache_value, cache_offset, 3 as u64);
    encoder.set_bytes(#addr_of(params) as *u8, #size_of::[BlockParams]() as u64, 4 as u64);
    encoder.set_buffer(dummy, 0 as u64, 5 as u64);
    encoder.set_buffer(dummy, 0 as u64, 6 as u64);
    let threads: u64 = pipeline.thread_execution_width();
    encoder.dispatch_threads(
        metal::Size { width: (rows *% WIDTH) as u64, height: 1 as u64, depth: 1 as u64 },
        metal::Size { width: threads, height: 1 as u64, depth: 1 as u64 },
    );
}

fn encode_buffer_barrier(encoder: metal::ComputeCommandEncoder) {
    encoder.memory_barrier_with_scope(metal::barrier_scope_buffers);
}

fn new_buffer(device: metal::Device, bytes: u64) -> option::Option[metal::Buffer] {
    return device.new_buffer_with_length(
        bytes,
        metal::resource_options_m_t_l_resource_storage_mode_shared,
    );
}

fn packed_storage_buffer(
    device: metal::Device,
    file: packed::File,
) -> option::Option[metal::Buffer] {
    let mapped_bytes: usize = round_up(file.length(), VM_PAGE_BYTES);
    if mapped_bytes as u64 > device.max_buffer_length() {
        io::eprintln(
            "transformer block: packed mapping ${mapped_bytes} exceeds Metal buffer limit ${device.max_buffer_length()}",
        );
        return option::Option[metal::Buffer]::None;
    }
    var deallocator: PackedDeallocatorBlock = PackedDeallocatorBlock {
        isa: rt::stack_block_isa(),
        flags: 0 as i32,
        reserved: 0 as i32,
        invoke: packed_deallocator_invoke,
        descriptor: #addr_of(PACKED_DEALLOCATOR_DESCRIPTOR) as *u8,
    };
    let object: *u8 = rt::msg_id_id_u64_u64_id(
        device.raw(),
        rt::sel(#str_ptr("newBufferWithBytesNoCopy:length:options:deallocator:\0")),
        file.pointer(),
        mapped_bytes as u64,
        metal::resource_options_m_t_l_resource_storage_mode_shared,
        #addr_of(deallocator) as *u8,
    );
    if object.is_null() {
        return option::Option[metal::Buffer]::None;
    }
    return option::Option[metal::Buffer]::Some(metal::Buffer::from_raw(object));
}

fn fixture_buffer(
    device: metal::Device,
    fixture_directory: str,
    name: str,
    expected_bytes: u64,
) -> option::Option[metal::Buffer] {
    let path: text::Text = "${fixture_directory}/${name}.f32";
    guard let mapped::MapResult::Ok(file) = mapped::map_readonly(path.view()) else {
        io::eprintln("transformer block: missing fixture ${path}");
        return option::Option[metal::Buffer]::None;
    };
    if file.length() as u64 != expected_bytes {
        io::eprintln("transformer block: fixture ${name} has ${file.length()} bytes, expected ${expected_bytes}");
        return option::Option[metal::Buffer]::None;
    }
    return device.new_buffer_with_bytes(
        file.pointer(),
        expected_bytes,
        metal::resource_options_m_t_l_resource_storage_mode_shared,
    );
}

fn weight_buffer(
    device: metal::Device,
    file: safetensors::File,
    name: str,
    dimension_0: u64,
    dimension_1: u64 = 0 as u64,
) -> option::Option[metal::Buffer] {
    guard let option::Option[safetensors::TensorData]::Some(tensor) = file.tensor(name) else {
        io::eprintln("transformer block: missing weight ${name}");
        return option::Option[metal::Buffer]::None;
    };
    let expected_rank: usize = if dimension_1 == (0 as u64) { 1 as usize } else { 2 as usize };
    let valid_shape: bool = tensor.rank == expected_rank && tensor.dimensions[0] == dimension_0
        && (expected_rank == (1 as usize) || tensor.dimensions[1] == dimension_1);
    if tensor.dtype.name() != "BF16" || !valid_shape {
        io::eprintln("transformer block: unexpected metadata for ${name}");
        return option::Option[metal::Buffer]::None;
    }
    return device.new_buffer_with_bytes(
        tensor.pointer,
        tensor.byte_length,
        metal::resource_options_m_t_l_resource_storage_mode_shared,
    );
}

fn packed_vector_buffer(
    device: metal::Device,
    file: packed::File,
    name: str,
    elements: u64,
) -> option::Option[metal::Buffer] {
    guard let option::Option[packed::TensorData]::Some(tensor) = file.tensor(name) else {
        io::eprintln("transformer block: missing packed vector ${name}");
        return option::Option[metal::Buffer]::None;
    };
    if tensor.scheme != (0 as u32) || tensor.output != elements || tensor.input != (0 as u64)
        || tensor.weights_length != elements *% (2 as u64) {
        io::eprintln("transformer block: invalid packed vector ${name}");
        return option::Option[metal::Buffer]::None;
    }
    return device.new_buffer_with_bytes(
        tensor.weights,
        tensor.weights_length,
        metal::resource_options_m_t_l_resource_storage_mode_shared,
    );
}

fn packed_linear_weight(
    file: packed::File,
    storage: metal::Buffer,
    name: str,
    output_columns: u64,
    input_columns: u64,
) -> option::Option[LinearWeight] {
    guard let option::Option[packed::TensorData]::Some(tensor) = file.tensor(name) else {
        io::eprintln("transformer block: missing packed matrix ${name}");
        return option::Option[LinearWeight]::None;
    };
    let elements: u64 = output_columns *% input_columns;
    let groups: u64 = output_columns *% (input_columns / (64 as u64));
    let dense_ok: bool = tensor.scheme == PACKED_SCHEME_BF16
        && tensor.weights_length == elements *% (2 as u64)
        && tensor.scales_length == (0 as u64) && tensor.zeros_length == (0 as u64);
    let int8_ok: bool = tensor.scheme == PACKED_SCHEME_INT8_AFFINE
        && tensor.group_size == (64 as u32) && tensor.weights_length == elements
        && tensor.scales_length == groups *% (2 as u64) && tensor.zeros_length == groups;
    if tensor.output != output_columns || tensor.input != input_columns
        || !(dense_ok || int8_ok) {
        io::eprintln("transformer block: invalid packed matrix ${name}");
        return option::Option[LinearWeight]::None;
    }
    return option::Option[LinearWeight]::Some(LinearWeight {
        storage: storage,
        scheme: tensor.scheme,
        weights_offset: tensor.weights_offset,
        scales_offset: tensor.scales_offset,
        zeros_offset: tensor.zeros_offset,
    });
}

fn compare_fixture(
    label: str,
    actual: metal::Buffer,
    fixture_directory: str,
    fixture_name: str,
    count: usize,
    absolute_tolerance: f64,
    relative_tolerance: f64,
) -> bool {
    let path: text::Text = "${fixture_directory}/${fixture_name}.f32";
    guard let mapped::MapResult::Ok(expected) = mapped::map_readonly(path.view()) else {
        io::eprintln("transformer block: missing expected tensor ${path}");
        return false;
    };
    if expected.length() != count *% #size_of::[f32]() {
        io::eprintln("transformer block: wrong byte count for ${fixture_name}");
        return false;
    }
    return metrics::report(
        label,
        metrics::compare_f32(
            actual.contents() as *f32,
            expected.pointer() as *f32,
            count,
            absolute_tolerance,
            relative_tolerance,
        ),
        count,
    );
}

fn finite(label: str, buffer: metal::Buffer, count: usize) -> bool {
    let values: *f32 = buffer.contents() as *f32;
    var index: usize = 0 as usize;
    while index < count {
        var value: f32 = values[index];
        let bits: u32 = { *({ #addr_of(value) } as *u32) };
        if (bits & (0x7F800000 as u32)) == (0x7F800000 as u32) {
            io::eprintln("${label}: non-finite value at ${index}");
            return false;
        }
        index = index +% (1 as usize);
    }
    return true;
}

fn normalized_rms_fixture(
    actual: metal::Buffer,
    fixture_directory: str,
    fixture_name: str,
    count: usize,
) -> option::Option[f64] {
    let path: text::Text = "${fixture_directory}/${fixture_name}.f32";
    guard let mapped::MapResult::Ok(expected) = mapped::map_readonly(path.view()) else {
        return option::Option[f64]::None;
    };
    if expected.length() != count *% #size_of::[f32]() {
        return option::Option[f64]::None;
    }
    let actual_values: *f32 = actual.contents() as *f32;
    let expected_values: *f32 = expected.pointer() as *f32;
    var squared_error: f64 = 0.0f64;
    var squared_reference: f64 = 0.0f64;
    var index: usize = 0 as usize;
    while index < count {
        let difference: f64 = actual_values[index] as f64 - expected_values[index] as f64;
        squared_error = squared_error + difference * difference;
        squared_reference = squared_reference + expected_values[index] as f64 * expected_values[index] as f64;
        index = index +% (1 as usize);
    }
    return option::Option[f64]::Some((squared_error / squared_reference.max(0.000000000001f64)).sqrt());
}

fn normalized_rms_fixture_slice(
    actual: metal::Buffer,
    fixture_directory: str,
    fixture_name: str,
    offset: usize,
    count: usize,
) -> option::Option[f64] {
    let path: text::Text = "${fixture_directory}/${fixture_name}.f32";
    guard let mapped::MapResult::Ok(expected) = mapped::map_readonly(path.view()) else {
        return option::Option[f64]::None;
    };
    if expected.length() < (offset +% count) *% #size_of::[f32]() {
        return option::Option[f64]::None;
    }
    let actual_values: *f32 = actual.contents() as *f32;
    let expected_values: *f32 = expected.pointer() as *f32;
    var squared_error: f64 = 0.0f64;
    var squared_reference: f64 = 0.0f64;
    var index: usize = offset;
    while index < offset +% count {
        let difference: f64 = actual_values[index] as f64 - expected_values[index] as f64;
        squared_error = squared_error + difference * difference;
        squared_reference = squared_reference + expected_values[index] as f64 * expected_values[index] as f64;
        index = index +% (1 as usize);
    }
    return option::Option[f64]::Some((squared_error / squared_reference.max(0.000000000001f64)).sqrt());
}

fn normalized_rms_buffers(
    actual: metal::Buffer,
    actual_offset: usize,
    expected: metal::Buffer,
    expected_offset: usize,
    count: usize,
) -> f64 {
    let actual_values: *f32 = actual.contents() as *f32;
    let expected_values: *f32 = expected.contents() as *f32;
    var squared_error: f64 = 0.0f64;
    var squared_reference: f64 = 0.0f64;
    var index: usize = 0 as usize;
    while index < count {
        let actual_value: f64 = actual_values[actual_offset +% index] as f64;
        let expected_value: f64 = expected_values[expected_offset +% index] as f64;
        let difference: f64 = actual_value - expected_value;
        squared_error = squared_error + difference * difference;
        squared_reference = squared_reference + expected_value * expected_value;
        index = index +% (1 as usize);
    }
    return (squared_error / squared_reference.max(0.000000000001f64)).sqrt();
}

fn normalized_rms_fixture_actual_slice(
    actual: metal::Buffer,
    actual_offset: usize,
    fixture_directory: str,
    fixture_name: str,
    count: usize,
) -> option::Option[f64] {
    let path: text::Text = "${fixture_directory}/${fixture_name}.f32";
    guard let mapped::MapResult::Ok(expected) = mapped::map_readonly(path.view()) else {
        return option::Option[f64]::None;
    };
    if expected.length() != count *% #size_of::[f32]() {
        return option::Option[f64]::None;
    }
    let actual_values: *f32 = actual.contents() as *f32;
    let expected_values: *f32 = expected.pointer() as *f32;
    var squared_error: f64 = 0.0f64;
    var squared_reference: f64 = 0.0f64;
    var index: usize = 0 as usize;
    while index < count {
        let actual_value: f64 = actual_values[actual_offset +% index] as f64;
        let expected_value: f64 = expected_values[index] as f64;
        let difference: f64 = actual_value - expected_value;
        squared_error = squared_error + difference * difference;
        squared_reference = squared_reference + expected_value * expected_value;
        index = index +% (1 as usize);
    }
    return option::Option[f64]::Some(
        (squared_error / squared_reference.max(0.000000000001f64)).sqrt(),
    );
}

fn normalized_rms_sampled_fixture(
    actual: metal::Buffer,
    fixture_directory: str,
    fixture_name: str,
    sample_count: usize,
    actual_rows: usize,
) -> option::Option[f64] {
    let expected_path: text::Text = "${fixture_directory}/${fixture_name}.f32";
    let rows_path: text::Text = "${fixture_directory}/sample_rows.i32";
    guard let mapped::MapResult::Ok(expected) = mapped::map_readonly(expected_path.view()) else {
        return option::Option[f64]::None;
    };
    guard let mapped::MapResult::Ok(sample_rows) = mapped::map_readonly(rows_path.view()) else {
        return option::Option[f64]::None;
    };
    if expected.length() != sample_count *% WIDTH *% #size_of::[f32]() ||
        sample_rows.length() != sample_count *% #size_of::[i32]() {
        return option::Option[f64]::None;
    }
    let actual_values: *f32 = actual.contents() as *f32;
    let expected_values: *f32 = expected.pointer() as *f32;
    let rows: *i32 = sample_rows.pointer() as *i32;
    var squared_error: f64 = 0.0f64;
    var squared_reference: f64 = 0.0f64;
    var sample: usize = 0 as usize;
    while sample < sample_count {
        if rows[sample] < (0 as i32) || rows[sample] as usize >= actual_rows {
            return option::Option[f64]::None;
        }
        let actual_start: usize = rows[sample] as usize *% WIDTH;
        let expected_start: usize = sample *% WIDTH;
        var column: usize = 0 as usize;
        while column < WIDTH {
            let actual_value: f64 = actual_values[actual_start +% column] as f64;
            let expected_value: f64 = expected_values[expected_start +% column] as f64;
            let difference: f64 = actual_value - expected_value;
            squared_error = squared_error + difference * difference;
            squared_reference = squared_reference + expected_value * expected_value;
            column = column +% (1 as usize);
        }
        sample = sample +% (1 as usize);
    }
    return option::Option[f64]::Some(
        (squared_error / squared_reference.max(0.000000000001f64)).sqrt(),
    );
}

fn execute_block(
    device: metal::Device,
    queue: metal::CommandQueue,
    pipelines: Pipelines,
    weights: BlockWeights,
    fixture_directory: str,
    quantized: bool,
) -> i32 {
    let activation_bytes: u64 = (ROWS *% WIDTH *% #size_of::[f32]()) as u64;
    let mlp_bytes: u64 = (ROWS *% MLP_WIDTH *% #size_of::[f32]()) as u64;
    guard let option::Option[metal::Buffer]::Some(hidden) = fixture_buffer(device, fixture_directory, "hidden", activation_bytes) else { return 1; };
    let hidden_owner: OwnedObjc = OwnedObjc::new(hidden.raw());
    guard let option::Option[metal::Buffer]::Some(modulation) = fixture_buffer(device, fixture_directory, "modulation", ((2 as usize) *% (4 as usize) *% WIDTH *% #size_of::[f32]()) as u64) else { return 1; };
    let modulation_owner: OwnedObjc = OwnedObjc::new(modulation.raw());
    guard let option::Option[metal::Buffer]::Some(rope) = fixture_buffer(device, fixture_directory, "rope", (ROWS *% HEAD_DIMENSION *% #size_of::[f32]()) as u64) else { return 1; };
    let rope_owner: OwnedObjc = OwnedObjc::new(rope.raw());

    guard let option::Option[metal::Buffer]::Some(target_mask) = new_buffer(device, ROWS as u64) else { return 1; };
    let target_mask_owner: OwnedObjc = OwnedObjc::new(target_mask.raw());
    let target_values: *u8 = target_mask.contents();
    target_values[0] = 0 as u8; target_values[1] = 0 as u8;
    target_values[2] = 1 as u8; target_values[3] = 1 as u8;
    guard let option::Option[metal::Buffer]::Some(image_ids) = new_buffer(device, (ROWS *% #size_of::[i32]()) as u64) else { return 1; };
    let image_ids_owner: OwnedObjc = OwnedObjc::new(image_ids.raw());
    let image_values: *i32 = image_ids.contents() as *i32;
    image_values[0] = 0 -% (1 as i32); image_values[1] = 0 -% (1 as i32);
    image_values[2] = 0 as i32; image_values[3] = 0 as i32;
    guard let option::Option[metal::Buffer]::Some(key_valid) = new_buffer(device, ROWS as u64) else { return 1; };
    let key_valid_owner: OwnedObjc = OwnedObjc::new(key_valid.raw());
    var index: usize = 0 as usize;
    while index < ROWS { (key_valid.contents())[index] = 1 as u8; index = index +% (1 as usize); }
    guard let option::Option[metal::Buffer]::Some(dummy) = new_buffer(device, 4 as u64) else { return 1; };
    let dummy_owner: OwnedObjc = OwnedObjc::new(dummy.raw());

    guard let option::Option[metal::Buffer]::Some(norm1) = new_buffer(device, activation_bytes) else { return 1; }; let norm1_owner: OwnedObjc = OwnedObjc::new(norm1.raw());
    guard let option::Option[metal::Buffer]::Some(query) = new_buffer(device, activation_bytes) else { return 1; }; let query_owner: OwnedObjc = OwnedObjc::new(query.raw());
    guard let option::Option[metal::Buffer]::Some(key) = new_buffer(device, activation_bytes) else { return 1; }; let key_owner: OwnedObjc = OwnedObjc::new(key.raw());
    guard let option::Option[metal::Buffer]::Some(value) = new_buffer(device, activation_bytes) else { return 1; }; let value_owner: OwnedObjc = OwnedObjc::new(value.raw());
    guard let option::Option[metal::Buffer]::Some(query_rope) = new_buffer(device, activation_bytes) else { return 1; }; let query_rope_owner: OwnedObjc = OwnedObjc::new(query_rope.raw());
    guard let option::Option[metal::Buffer]::Some(key_rope) = new_buffer(device, activation_bytes) else { return 1; }; let key_rope_owner: OwnedObjc = OwnedObjc::new(key_rope.raw());
    guard let option::Option[metal::Buffer]::Some(attended) = new_buffer(device, activation_bytes) else { return 1; }; let attended_owner: OwnedObjc = OwnedObjc::new(attended.raw());
    guard let option::Option[metal::Buffer]::Some(attention_projected) = new_buffer(device, activation_bytes) else { return 1; }; let attention_projected_owner: OwnedObjc = OwnedObjc::new(attention_projected.raw());
    guard let option::Option[metal::Buffer]::Some(residual1) = new_buffer(device, activation_bytes) else { return 1; }; let residual1_owner: OwnedObjc = OwnedObjc::new(residual1.raw());
    guard let option::Option[metal::Buffer]::Some(norm2) = new_buffer(device, activation_bytes) else { return 1; }; let norm2_owner: OwnedObjc = OwnedObjc::new(norm2.raw());
    guard let option::Option[metal::Buffer]::Some(gate) = new_buffer(device, mlp_bytes) else { return 1; }; let gate_owner: OwnedObjc = OwnedObjc::new(gate.raw());
    guard let option::Option[metal::Buffer]::Some(projected) = new_buffer(device, mlp_bytes) else { return 1; }; let projected_owner: OwnedObjc = OwnedObjc::new(projected.raw());
    guard let option::Option[metal::Buffer]::Some(swiglu) = new_buffer(device, mlp_bytes) else { return 1; }; let swiglu_buffer_owner: OwnedObjc = OwnedObjc::new(swiglu.raw());
    guard let option::Option[metal::Buffer]::Some(mlp_projected) = new_buffer(device, activation_bytes) else { return 1; }; let mlp_projected_owner: OwnedObjc = OwnedObjc::new(mlp_projected.raw());
    guard let option::Option[metal::Buffer]::Some(output) = new_buffer(device, activation_bytes) else { return 1; }; let output_owner: OwnedObjc = OwnedObjc::new(output.raw());

    var params: BlockParams = BlockParams { rows: ROWS as u32, width: WIDTH as u32, heads: HEADS as u32, head_dimension: HEAD_DIMENSION as u32, epsilon: 0.000001f32, slot: 0 as u32 };
    var all_ok: bool = true;
    var total_ms: f64 = 0.0f64;
    guard let option::Option[f64]::Some(elapsed) = dispatch_1d(queue, pipelines.norm, hidden, modulation, norm1, target_mask, dummy, dummy, #addr_of(params), ROWS) else { return 1; };
    total_ms = total_ms + elapsed;
    all_ok = compare_fixture("block0 norm1 + scale1", norm1, fixture_directory, "norm1", ROWS *% WIDTH, 0.00005f64, 0.00005f64) && all_ok;

    guard let option::Option[f64]::Some(q_ms) = dispatch_weighted_linear(queue, pipelines, norm1, weights.q, query, WIDTH, WIDTH, ROWS) else { return 1; }; total_ms = total_ms + q_ms;
    guard let option::Option[f64]::Some(k_ms) = dispatch_weighted_linear(queue, pipelines, norm1, weights.k, key, WIDTH, WIDTH, ROWS) else { return 1; }; total_ms = total_ms + k_ms;
    guard let option::Option[f64]::Some(v_ms) = dispatch_weighted_linear(queue, pipelines, norm1, weights.v, value, WIDTH, WIDTH, ROWS) else { return 1; }; total_ms = total_ms + v_ms;
    all_ok = compare_fixture("block0 Q projection", query, fixture_directory, "query", ROWS *% WIDTH, if quantized { 0.25f64 } else { 0.0002f64 }, 0.0f64) && all_ok;
    all_ok = compare_fixture("block0 K projection", key, fixture_directory, "key", ROWS *% WIDTH, if quantized { 0.2f64 } else { 0.0002f64 }, 0.0f64) && all_ok;
    all_ok = compare_fixture("block0 V projection", value, fixture_directory, "value", ROWS *% WIDTH, if quantized { 0.1f64 } else { 0.0002f64 }, 0.0f64) && all_ok;

    guard let option::Option[f64]::Some(qk_q_ms) = dispatch_1d(queue, pipelines.qk, query, weights.norm_q, query_rope, rope, dummy, dummy, #addr_of(params), ROWS *% HEADS) else { return 1; }; total_ms = total_ms + qk_q_ms;
    guard let option::Option[f64]::Some(qk_k_ms) = dispatch_1d(queue, pipelines.qk, key, weights.norm_k, key_rope, rope, dummy, dummy, #addr_of(params), ROWS *% HEADS) else { return 1; }; total_ms = total_ms + qk_k_ms;
    all_ok = compare_fixture("block0 Q RMSNorm + RoPE", query_rope, fixture_directory, "query_rope", ROWS *% WIDTH, if quantized { 0.2f64 } else { 0.0003f64 }, 0.0f64) && all_ok;
    all_ok = compare_fixture("block0 K RMSNorm + RoPE", key_rope, fixture_directory, "key_rope", ROWS *% WIDTH, if quantized { 0.2f64 } else { 0.0003f64 }, 0.0f64) && all_ok;

    guard let option::Option[f64]::Some(attention_ms) = dispatch_attention(queue, pipelines.attention, query_rope, key_rope, attended, value, image_ids, key_valid, ROWS, ROWS, key_rope, value, 0 as u64) else { return 1; }; total_ms = total_ms + attention_ms;
    all_ok = compare_fixture("block0 block-causal attention", attended, fixture_directory, "attention", ROWS *% WIDTH, if quantized { 0.2f64 } else { 0.0005f64 }, 0.0f64) && all_ok;

    guard let option::Option[f64]::Some(attention_projection_ms) = dispatch_weighted_linear(queue, pipelines, attended, weights.attention_output, attention_projected, WIDTH, WIDTH, ROWS) else { return 1; }; total_ms = total_ms + attention_projection_ms;
    all_ok = compare_fixture("block0 attention output projection", attention_projected, fixture_directory, "attention_projected", ROWS *% WIDTH, if quantized { 1.2f64 } else { 0.0005f64 }, 0.0f64) && all_ok;

    params.slot = 1 as u32;
    guard let option::Option[f64]::Some(residual1_ms) = dispatch_1d(queue, pipelines.residual, hidden, modulation, residual1, attention_projected, target_mask, dummy, #addr_of(params), ROWS *% WIDTH) else { return 1; }; total_ms = total_ms + residual1_ms;
    all_ok = compare_fixture("block0 attention gated residual", residual1, fixture_directory, "residual1", ROWS *% WIDTH, if quantized { 0.1f64 } else { 0.0005f64 }, 0.0f64) && all_ok;

    params.slot = 2 as u32;
    guard let option::Option[f64]::Some(norm2_ms) = dispatch_1d(queue, pipelines.norm, residual1, modulation, norm2, target_mask, dummy, dummy, #addr_of(params), ROWS) else { return 1; }; total_ms = total_ms + norm2_ms;
    all_ok = compare_fixture("block0 norm2 + scale2", norm2, fixture_directory, "norm2", ROWS *% WIDTH, if quantized { 0.2f64 } else { 0.0005f64 }, 0.0f64) && all_ok;

    guard let option::Option[f64]::Some(gate_ms) = dispatch_weighted_linear(queue, pipelines, norm2, weights.gate, gate, MLP_WIDTH, WIDTH, ROWS) else { return 1; }; total_ms = total_ms + gate_ms;
    guard let option::Option[f64]::Some(projected_ms) = dispatch_weighted_linear(queue, pipelines, norm2, weights.projected, projected, MLP_WIDTH, WIDTH, ROWS) else { return 1; }; total_ms = total_ms + projected_ms;
    all_ok = compare_fixture("block0 MLP gate projection", gate, fixture_directory, "gate", ROWS *% MLP_WIDTH, if quantized { 0.2f64 } else { 0.0008f64 }, 0.0f64) && all_ok;
    all_ok = compare_fixture("block0 MLP value projection", projected, fixture_directory, "projected", ROWS *% MLP_WIDTH, if quantized { 0.2f64 } else { 0.0008f64 }, 0.0f64) && all_ok;

    guard let option::Option[f64]::Some(swiglu_ms) = dispatch_1d(queue, pipelines.swiglu, gate, projected, swiglu, dummy, dummy, dummy, #addr_of(params), ROWS *% MLP_WIDTH) else { return 1; }; total_ms = total_ms + swiglu_ms;
    all_ok = compare_fixture("block0 SwiGLU", swiglu, fixture_directory, "swiglu", ROWS *% MLP_WIDTH, if quantized { 1.2f64 } else { 0.001f64 }, 0.0f64) && all_ok;

    guard let option::Option[f64]::Some(mlp_projection_ms) = dispatch_weighted_linear(queue, pipelines, swiglu, weights.mlp_output, mlp_projected, WIDTH, MLP_WIDTH, ROWS) else { return 1; }; total_ms = total_ms + mlp_projection_ms;
    all_ok = compare_fixture("block0 MLP output projection", mlp_projected, fixture_directory, "mlp_projected", ROWS *% WIDTH, if quantized { 6.0f64 } else { 0.002f64 }, 0.0f64) && all_ok;

    params.slot = 3 as u32;
    guard let option::Option[f64]::Some(output_ms) = dispatch_1d(queue, pipelines.residual, residual1, modulation, output, mlp_projected, target_mask, dummy, #addr_of(params), ROWS *% WIDTH) else { return 1; }; total_ms = total_ms + output_ms;
    all_ok = compare_fixture("block0 final output", output, fixture_directory, "output", ROWS *% WIDTH, if quantized { 0.5f64 } else { 0.002f64 }, 0.0f64) && all_ok;
    all_ok = finite("block0 final output", output, ROWS *% WIDTH) && all_ok;
    if quantized {
        guard let option::Option[f64]::Some(error) = normalized_rms_fixture(output, fixture_directory, "output", ROWS *% WIDTH) else { return 1; };
        io::println("block0 affine INT8 final normalized RMS: ${error}");
        all_ok = error <= 0.01f64 && all_ok;
    }

    io::println("block0 Metal kernel time: ${total_ms} ms for ${ROWS} tokens; quantized=${quantized}");
    if all_ok {
        io::println("Qwen-Image-2.1 transformer block 0: verified");
        return 0;
    }
    return 1;
}

fn execute_runtime_block(
    queue: metal::CommandQueue,
    pipelines: Pipelines,
    weights: BlockWeights,
    workspace: BlockWorkspace,
    hidden: metal::Buffer,
    output: metal::Buffer,
    rows: usize,
    cache_mode: u32,
    cache_copy_pipeline: metal::ComputePipelineState,
    cache_key: metal::Buffer,
    cache_value: metal::Buffer,
    cache_offset: u64,
    prefix_rows: usize,
) -> option::Option[f64] {
    var params: BlockParams = BlockParams {
        rows: rows as u32,
        width: WIDTH as u32,
        heads: HEADS as u32,
        head_dimension: HEAD_DIMENSION as u32,
        epsilon: 0.000001f32,
        slot: 0 as u32,
    };
    var total_ms: f64 = 0.0f64;
    guard let option::Option[f64]::Some(norm1_ms) = dispatch_1d(
        queue,
        pipelines.norm,
        hidden,
        workspace.modulation,
        workspace.norm1,
        workspace.target_mask,
        workspace.dummy,
        workspace.dummy,
        #addr_of(params),
        rows,
    ) else { return option::Option[f64]::None; };
    total_ms = total_ms + norm1_ms;
    guard let option::Option[f64]::Some(q_ms) = dispatch_weighted_linear(
        queue, pipelines, workspace.norm1, weights.q, workspace.query, WIDTH, WIDTH, rows,
    ) else { return option::Option[f64]::None; };
    guard let option::Option[f64]::Some(k_ms) = dispatch_weighted_linear(
        queue, pipelines, workspace.norm1, weights.k, workspace.key, WIDTH, WIDTH, rows,
    ) else { return option::Option[f64]::None; };
    guard let option::Option[f64]::Some(v_ms) = dispatch_weighted_linear(
        queue, pipelines, workspace.norm1, weights.v, workspace.value, WIDTH, WIDTH, rows,
    ) else { return option::Option[f64]::None; };
    total_ms = total_ms + q_ms + k_ms + v_ms;
    guard let option::Option[f64]::Some(q_norm_ms) = dispatch_1d(
        queue,
        pipelines.qk,
        workspace.query,
        weights.norm_q,
        workspace.query_rope,
        workspace.rope,
        workspace.dummy,
        workspace.dummy,
        #addr_of(params),
        rows *% HEADS,
    ) else { return option::Option[f64]::None; };
    guard let option::Option[f64]::Some(k_norm_ms) = dispatch_1d(
        queue,
        pipelines.qk,
        workspace.key,
        weights.norm_k,
        workspace.key_rope,
        workspace.rope,
        workspace.dummy,
        workspace.dummy,
        #addr_of(params),
        rows *% HEADS,
    ) else { return option::Option[f64]::None; };
    total_ms = total_ms + q_norm_ms + k_norm_ms;
    if cache_mode == (1 as u32) {
        guard let option::Option[f64]::Some(cache_ms) = dispatch_copy_prefix(
            queue,
            cache_copy_pipeline,
            workspace.key_rope,
            workspace.value,
            cache_key,
            cache_value,
            cache_offset,
            prefix_rows,
            workspace.dummy,
        ) else { return option::Option[f64]::None; };
        total_ms = total_ms + cache_ms;
    }
    let cached: bool = cache_mode == (2 as u32);
    guard let option::Option[f64]::Some(attention_ms) = dispatch_attention(
        queue,
        pipelines.attention,
        workspace.query_rope,
        workspace.key_rope,
        workspace.attended,
        workspace.value,
        workspace.image_ids,
        workspace.key_valid,
        rows,
        if cached { prefix_rows +% rows } else { rows },
        cache_key,
        cache_value,
        cache_offset,
        if cached { prefix_rows } else { 0 as usize },
        true,
        if cached { prefix_rows } else { 0 as usize },
    ) else { return option::Option[f64]::None; };
    total_ms = total_ms + attention_ms;
    guard let option::Option[f64]::Some(attention_output_ms) = dispatch_weighted_linear(
        queue,
        pipelines,
        workspace.attended,
        weights.attention_output,
        workspace.attention_projected,
        WIDTH,
        WIDTH,
        rows,
    ) else { return option::Option[f64]::None; };
    total_ms = total_ms + attention_output_ms;
    params.slot = 1 as u32;
    guard let option::Option[f64]::Some(residual1_ms) = dispatch_1d(
        queue,
        pipelines.residual,
        hidden,
        workspace.modulation,
        workspace.residual1,
        workspace.attention_projected,
        workspace.target_mask,
        workspace.dummy,
        #addr_of(params),
        rows *% WIDTH,
    ) else { return option::Option[f64]::None; };
    total_ms = total_ms + residual1_ms;
    params.slot = 2 as u32;
    guard let option::Option[f64]::Some(norm2_ms) = dispatch_1d(
        queue,
        pipelines.norm,
        workspace.residual1,
        workspace.modulation,
        workspace.norm2,
        workspace.target_mask,
        workspace.dummy,
        workspace.dummy,
        #addr_of(params),
        rows,
    ) else { return option::Option[f64]::None; };
    total_ms = total_ms + norm2_ms;
    guard let option::Option[f64]::Some(gate_ms) = dispatch_weighted_linear(
        queue,
        pipelines,
        workspace.norm2,
        weights.gate,
        workspace.gate,
        MLP_WIDTH,
        WIDTH,
        rows,
    ) else { return option::Option[f64]::None; };
    guard let option::Option[f64]::Some(projected_ms) = dispatch_weighted_linear(
        queue,
        pipelines,
        workspace.norm2,
        weights.projected,
        workspace.projected,
        MLP_WIDTH,
        WIDTH,
        rows,
    ) else { return option::Option[f64]::None; };
    total_ms = total_ms + gate_ms + projected_ms;
    guard let option::Option[f64]::Some(swiglu_ms) = dispatch_1d(
        queue,
        pipelines.swiglu,
        workspace.gate,
        workspace.projected,
        workspace.swiglu,
        workspace.dummy,
        workspace.dummy,
        workspace.dummy,
        #addr_of(params),
        rows *% MLP_WIDTH,
    ) else { return option::Option[f64]::None; };
    total_ms = total_ms + swiglu_ms;
    guard let option::Option[f64]::Some(mlp_output_ms) = dispatch_weighted_linear(
        queue,
        pipelines,
        workspace.swiglu,
        weights.mlp_output,
        workspace.mlp_projected,
        WIDTH,
        MLP_WIDTH,
        rows,
    ) else { return option::Option[f64]::None; };
    total_ms = total_ms + mlp_output_ms;
    params.slot = 3 as u32;
    guard let option::Option[f64]::Some(output_ms) = dispatch_1d(
        queue,
        pipelines.residual,
        workspace.residual1,
        workspace.modulation,
        output,
        workspace.mlp_projected,
        workspace.target_mask,
        workspace.dummy,
        #addr_of(params),
        rows *% WIDTH,
    ) else { return option::Option[f64]::None; };
    return option::Option[f64]::Some(total_ms + output_ms);
}

fn execute_batched_runtime_block(
    queue: metal::CommandQueue,
    pipelines: Pipelines,
    weights: BlockWeights,
    workspace: BlockWorkspace,
    hidden: metal::Buffer,
    output: metal::Buffer,
    rows: usize,
    cache_mode: u32,
    cache_copy_pipeline: metal::ComputePipelineState,
    cache_key: metal::Buffer,
    cache_value: metal::Buffer,
    cache_offset: u64,
    prefix_rows: usize,
) -> option::Option[f64] {
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return option::Option[f64]::None; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    guard let option::Option[metal::CommandBuffer]::Some(command_buffer) =
        queue.command_buffer() else { return option::Option[f64]::None; };
    let command_buffer_owner: OwnedObjc = OwnedObjc::new(rt::retain(command_buffer.raw()));
    guard let option::Option[metal::ComputeCommandEncoder]::Some(encoder) =
        command_buffer.compute_command_encoder() else { return option::Option[f64]::None; };
    let encoder_owner: OwnedObjc = OwnedObjc::new(rt::retain(encoder.raw()));
    var params: BlockParams = BlockParams {
        rows: rows as u32,
        width: WIDTH as u32,
        heads: HEADS as u32,
        head_dimension: HEAD_DIMENSION as u32,
        epsilon: 0.000001f32,
        slot: 0 as u32,
    };

    encode_1d(
        encoder, pipelines.norm, hidden, workspace.modulation, workspace.norm1,
        workspace.target_mask, workspace.dummy, workspace.dummy, #addr_of(params), rows,
    );
    encode_buffer_barrier(encoder);
    encode_weighted_linear(
        encoder, pipelines, workspace.norm1, weights.q, workspace.query, WIDTH, WIDTH, rows,
    );
    encode_weighted_linear(
        encoder, pipelines, workspace.norm1, weights.k, workspace.key, WIDTH, WIDTH, rows,
    );
    encode_weighted_linear(
        encoder, pipelines, workspace.norm1, weights.v, workspace.value, WIDTH, WIDTH, rows,
    );
    encode_buffer_barrier(encoder);
    encode_1d(
        encoder, pipelines.qk, workspace.query, weights.norm_q, workspace.query_rope,
        workspace.rope, workspace.dummy, workspace.dummy, #addr_of(params), rows *% HEADS,
    );
    encode_1d(
        encoder, pipelines.qk, workspace.key, weights.norm_k, workspace.key_rope,
        workspace.rope, workspace.dummy, workspace.dummy, #addr_of(params), rows *% HEADS,
    );
    encode_buffer_barrier(encoder);
    if cache_mode == (1 as u32) {
        encode_copy_prefix(
            encoder, cache_copy_pipeline, workspace.key_rope, workspace.value,
            cache_key, cache_value, cache_offset, prefix_rows, workspace.dummy,
        );
        encode_buffer_barrier(encoder);
    }
    let cached: bool = cache_mode == (2 as u32);
    encode_attention(
        encoder,
        pipelines.attention,
        workspace.query_rope,
        workspace.key_rope,
        workspace.attended,
        workspace.value,
        workspace.image_ids,
        workspace.key_valid,
        rows,
        if cached { prefix_rows +% rows } else { rows },
        cache_key,
        cache_value,
        cache_offset,
        if cached { prefix_rows } else { 0 as usize },
        true,
        if cached { prefix_rows } else { 0 as usize },
    );
    encode_buffer_barrier(encoder);
    encode_weighted_linear(
        encoder, pipelines, workspace.attended, weights.attention_output,
        workspace.attention_projected, WIDTH, WIDTH, rows,
    );
    encode_buffer_barrier(encoder);
    params.slot = 1 as u32;
    encode_1d(
        encoder, pipelines.residual, hidden, workspace.modulation, workspace.residual1,
        workspace.attention_projected, workspace.target_mask, workspace.dummy,
        #addr_of(params), rows *% WIDTH,
    );
    encode_buffer_barrier(encoder);
    params.slot = 2 as u32;
    encode_1d(
        encoder, pipelines.norm, workspace.residual1, workspace.modulation, workspace.norm2,
        workspace.target_mask, workspace.dummy, workspace.dummy, #addr_of(params), rows,
    );
    encode_buffer_barrier(encoder);
    encode_weighted_linear(
        encoder, pipelines, workspace.norm2, weights.gate, workspace.gate,
        MLP_WIDTH, WIDTH, rows,
    );
    encode_weighted_linear(
        encoder, pipelines, workspace.norm2, weights.projected, workspace.projected,
        MLP_WIDTH, WIDTH, rows,
    );
    encode_buffer_barrier(encoder);
    encode_1d(
        encoder, pipelines.swiglu, workspace.gate, workspace.projected, workspace.swiglu,
        workspace.dummy, workspace.dummy, workspace.dummy, #addr_of(params), rows *% MLP_WIDTH,
    );
    encode_buffer_barrier(encoder);
    encode_weighted_linear(
        encoder, pipelines, workspace.swiglu, weights.mlp_output, workspace.mlp_projected,
        WIDTH, MLP_WIDTH, rows,
    );
    encode_buffer_barrier(encoder);
    params.slot = 3 as u32;
    encode_1d(
        encoder, pipelines.residual, workspace.residual1, workspace.modulation, output,
        workspace.mlp_projected, workspace.target_mask, workspace.dummy,
        #addr_of(params), rows *% WIDTH,
    );

    let command_encoder: metal::CommandEncoder = metal::CommandEncoder::from_raw(encoder.raw());
    command_encoder.end_encoding();
    command_buffer.commit();
    command_buffer.wait_until_completed();
    return option::Option[f64]::Some(
        (command_buffer.g_p_u_end_time() - command_buffer.g_p_u_start_time()) * 1000.0f64,
    );
}

fn captured_block_name(block: usize) -> str {
    if block == (0 as usize) { return "block_00_output"; }
    if block == (23 as usize) { return "block_23_output"; }
    if block == (24 as usize) { return "block_24_output"; }
    if block == (27 as usize) { return "block_27_output"; }
    if block == (28 as usize) { return "block_28_output"; }
    if block == (31 as usize) { return "block_31_output"; }
    return "";
}

fn run(model_directory: str, fixture_directory: str = "tests/fixtures/block0_fp32") -> i32 {
    let shard_path: text::Text =
        "${model_directory}/transformer/diffusion_pytorch_model-00001-of-00002.safetensors";
    guard let safetensors::LoadResult::Ok(weight_file) = safetensors::load(shard_path.view()) else {
        io::eprintln("transformer block: could not load ${shard_path}");
        return 1;
    };

    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() {
        return 1;
    }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    let device_pointer: *u8 = MTLCreateSystemDefaultDevice();
    if device_pointer.is_null() {
        io::eprintln("transformer block: no Metal device");
        return 1;
    }
    let device_owner: OwnedObjc = OwnedObjc::new(rt::retain(device_pointer));
    let device: metal::Device = metal::Device::from_raw(device_owner.raw());
    guard let option::Option[metal::CommandQueue]::Some(queue) = device.new_command_queue() else {
        return 1;
    };
    let queue_owner: OwnedObjc = OwnedObjc::new(queue.raw());

    let options_pointer: *u8 = rt::alloc_init(#str_ptr("MTLCompileOptions\0"));
    if options_pointer.is_null() {
        return 1;
    }
    let options_owner: OwnedObjc = OwnedObjc::new(options_pointer);
    let options: metal::CompileOptions = metal::CompileOptions::from_raw(options_owner.raw());
    options.set_fast_math_enabled(false);
    var compile_error: *u8 = 0 as *u8;
    guard let option::Option[metal::Library]::Some(library) = device.new_library_with_source(
        #include_str("../kernels/transformer_block.metal"),
        options,
        #addr_of(compile_error) as *u8,
    ) else {
        if !compile_error.is_null() {
            let description: *u8 = rt::msg_id(compile_error, rt::sel(#str_ptr("localizedDescription\0")));
            io::eprintln("transformer block Metal compile: ${bridge::to_text(description)}");
        }
        return 1;
    };
    let library_owner: OwnedObjc = OwnedObjc::new(library.raw());
    guard let option::Option[OwnedObjc]::Some(linear_owner) = pipeline(device, library, "qi_block_linear_32x32") else {
        return 1;
    };
    guard let option::Option[OwnedObjc]::Some(norm_owner) = pipeline(device, library, "qi_block_layernorm_modulate") else {
        return 1;
    };
    guard let option::Option[OwnedObjc]::Some(qk_owner) = pipeline(device, library, "qi_block_qk_norm_rope") else {
        return 1;
    };
    guard let option::Option[OwnedObjc]::Some(attention_owner) = pipeline(device, library, "qi_block_attention") else {
        return 1;
    };
    guard let option::Option[OwnedObjc]::Some(residual_owner) = pipeline(device, library, "qi_block_residual") else {
        return 1;
    };
    guard let option::Option[OwnedObjc]::Some(swiglu_owner) = pipeline(device, library, "qi_block_swiglu") else {
        return 1;
    };
    let linear_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(linear_owner.raw());
    let norm_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(norm_owner.raw());
    let qk_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(qk_owner.raw());
    let attention_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(attention_owner.raw());
    let residual_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(residual_owner.raw());
    let swiglu_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(swiglu_owner.raw());

    let activation_bytes: u64 = (ROWS *% WIDTH *% #size_of::[f32]()) as u64;
    let mlp_bytes: u64 = (ROWS *% MLP_WIDTH *% #size_of::[f32]()) as u64;
    guard let option::Option[metal::Buffer]::Some(hidden) = fixture_buffer(device, fixture_directory, "hidden", activation_bytes) else { return 1; };
    let hidden_owner: OwnedObjc = OwnedObjc::new(hidden.raw());
    guard let option::Option[metal::Buffer]::Some(modulation) = fixture_buffer(device, fixture_directory, "modulation", ((2 as usize) *% (4 as usize) *% WIDTH *% #size_of::[f32]()) as u64) else { return 1; };
    let modulation_owner: OwnedObjc = OwnedObjc::new(modulation.raw());
    guard let option::Option[metal::Buffer]::Some(rope) = fixture_buffer(device, fixture_directory, "rope", (ROWS *% HEAD_DIMENSION *% #size_of::[f32]()) as u64) else { return 1; };
    let rope_owner: OwnedObjc = OwnedObjc::new(rope.raw());

    guard let option::Option[metal::Buffer]::Some(target_mask) = new_buffer(device, ROWS as u64) else { return 1; };
    let target_mask_owner: OwnedObjc = OwnedObjc::new(target_mask.raw());
    let target_values: *u8 = target_mask.contents();
    target_values[0] = 0 as u8; target_values[1] = 0 as u8;
    target_values[2] = 1 as u8; target_values[3] = 1 as u8;
    guard let option::Option[metal::Buffer]::Some(image_ids) = new_buffer(device, (ROWS *% #size_of::[i32]()) as u64) else { return 1; };
    let image_ids_owner: OwnedObjc = OwnedObjc::new(image_ids.raw());
    let image_values: *i32 = image_ids.contents() as *i32;
    image_values[0] = 0 -% (1 as i32); image_values[1] = 0 -% (1 as i32);
    image_values[2] = 0 as i32; image_values[3] = 0 as i32;
    guard let option::Option[metal::Buffer]::Some(key_valid) = new_buffer(device, ROWS as u64) else { return 1; };
    let key_valid_owner: OwnedObjc = OwnedObjc::new(key_valid.raw());
    var index: usize = 0 as usize;
    while index < ROWS { (key_valid.contents())[index] = 1 as u8; index = index +% (1 as usize); }

    guard let option::Option[metal::Buffer]::Some(dummy) = new_buffer(device, 4 as u64) else { return 1; };
    let dummy_owner: OwnedObjc = OwnedObjc::new(dummy.raw());

    guard let option::Option[metal::Buffer]::Some(norm_q_weight) = weight_buffer(device, weight_file, "transformer_blocks.0.attn.norm_q.weight", HEAD_DIMENSION as u64) else { return 1; };
    let norm_q_weight_owner: OwnedObjc = OwnedObjc::new(norm_q_weight.raw());
    guard let option::Option[metal::Buffer]::Some(norm_k_weight) = weight_buffer(device, weight_file, "transformer_blocks.0.attn.norm_k.weight", HEAD_DIMENSION as u64) else { return 1; };
    let norm_k_weight_owner: OwnedObjc = OwnedObjc::new(norm_k_weight.raw());
    guard let option::Option[metal::Buffer]::Some(q_weight) = weight_buffer(device, weight_file, "transformer_blocks.0.attn.to_q.weight", WIDTH as u64, WIDTH as u64) else { return 1; };
    let q_weight_owner: OwnedObjc = OwnedObjc::new(q_weight.raw());
    guard let option::Option[metal::Buffer]::Some(k_weight) = weight_buffer(device, weight_file, "transformer_blocks.0.attn.to_k.weight", WIDTH as u64, WIDTH as u64) else { return 1; };
    let k_weight_owner: OwnedObjc = OwnedObjc::new(k_weight.raw());
    guard let option::Option[metal::Buffer]::Some(v_weight) = weight_buffer(device, weight_file, "transformer_blocks.0.attn.to_v.weight", WIDTH as u64, WIDTH as u64) else { return 1; };
    let v_weight_owner: OwnedObjc = OwnedObjc::new(v_weight.raw());
    guard let option::Option[metal::Buffer]::Some(attention_output_weight) = weight_buffer(device, weight_file, "transformer_blocks.0.attn.to_out.0.weight", WIDTH as u64, WIDTH as u64) else { return 1; };
    let attention_output_weight_owner: OwnedObjc = OwnedObjc::new(attention_output_weight.raw());
    guard let option::Option[metal::Buffer]::Some(gate_weight) = weight_buffer(device, weight_file, "transformer_blocks.0.img_mlp.gate_layer.weight", MLP_WIDTH as u64, WIDTH as u64) else { return 1; };
    let gate_weight_owner: OwnedObjc = OwnedObjc::new(gate_weight.raw());
    guard let option::Option[metal::Buffer]::Some(projected_weight) = weight_buffer(device, weight_file, "transformer_blocks.0.img_mlp.proj.weight", MLP_WIDTH as u64, WIDTH as u64) else { return 1; };
    let projected_weight_owner: OwnedObjc = OwnedObjc::new(projected_weight.raw());
    guard let option::Option[metal::Buffer]::Some(mlp_output_weight) = weight_buffer(device, weight_file, "transformer_blocks.0.img_mlp.out.weight", WIDTH as u64, MLP_WIDTH as u64) else { return 1; };
    let mlp_output_weight_owner: OwnedObjc = OwnedObjc::new(mlp_output_weight.raw());

    guard let option::Option[metal::Buffer]::Some(norm1) = new_buffer(device, activation_bytes) else { return 1; }; let norm1_owner: OwnedObjc = OwnedObjc::new(norm1.raw());
    guard let option::Option[metal::Buffer]::Some(query) = new_buffer(device, activation_bytes) else { return 1; }; let query_owner: OwnedObjc = OwnedObjc::new(query.raw());
    guard let option::Option[metal::Buffer]::Some(key) = new_buffer(device, activation_bytes) else { return 1; }; let key_owner: OwnedObjc = OwnedObjc::new(key.raw());
    guard let option::Option[metal::Buffer]::Some(value) = new_buffer(device, activation_bytes) else { return 1; }; let value_owner: OwnedObjc = OwnedObjc::new(value.raw());
    guard let option::Option[metal::Buffer]::Some(query_rope) = new_buffer(device, activation_bytes) else { return 1; }; let query_rope_owner: OwnedObjc = OwnedObjc::new(query_rope.raw());
    guard let option::Option[metal::Buffer]::Some(key_rope) = new_buffer(device, activation_bytes) else { return 1; }; let key_rope_owner: OwnedObjc = OwnedObjc::new(key_rope.raw());
    guard let option::Option[metal::Buffer]::Some(attended) = new_buffer(device, activation_bytes) else { return 1; }; let attended_owner: OwnedObjc = OwnedObjc::new(attended.raw());
    guard let option::Option[metal::Buffer]::Some(attention_projected) = new_buffer(device, activation_bytes) else { return 1; }; let attention_projected_owner: OwnedObjc = OwnedObjc::new(attention_projected.raw());
    guard let option::Option[metal::Buffer]::Some(residual1) = new_buffer(device, activation_bytes) else { return 1; }; let residual1_owner: OwnedObjc = OwnedObjc::new(residual1.raw());
    guard let option::Option[metal::Buffer]::Some(norm2) = new_buffer(device, activation_bytes) else { return 1; }; let norm2_owner: OwnedObjc = OwnedObjc::new(norm2.raw());
    guard let option::Option[metal::Buffer]::Some(gate) = new_buffer(device, mlp_bytes) else { return 1; }; let gate_owner: OwnedObjc = OwnedObjc::new(gate.raw());
    guard let option::Option[metal::Buffer]::Some(projected) = new_buffer(device, mlp_bytes) else { return 1; }; let projected_owner: OwnedObjc = OwnedObjc::new(projected.raw());
    guard let option::Option[metal::Buffer]::Some(swiglu) = new_buffer(device, mlp_bytes) else { return 1; }; let swiglu_buffer_owner: OwnedObjc = OwnedObjc::new(swiglu.raw());
    guard let option::Option[metal::Buffer]::Some(mlp_projected) = new_buffer(device, activation_bytes) else { return 1; }; let mlp_projected_owner: OwnedObjc = OwnedObjc::new(mlp_projected.raw());
    guard let option::Option[metal::Buffer]::Some(output) = new_buffer(device, activation_bytes) else { return 1; }; let output_owner: OwnedObjc = OwnedObjc::new(output.raw());

    var params: BlockParams = BlockParams {
        rows: ROWS as u32,
        width: WIDTH as u32,
        heads: HEADS as u32,
        head_dimension: HEAD_DIMENSION as u32,
        epsilon: 0.000001f32,
        slot: 0 as u32,
    };
    var all_ok: bool = true;
    var total_ms: f64 = 0.0f64;

    guard let option::Option[f64]::Some(elapsed) = dispatch_1d(queue, norm_pipeline, hidden, modulation, norm1, target_mask, dummy, dummy, #addr_of(params), ROWS) else { return 1; };
    total_ms = total_ms + elapsed;
    all_ok = compare_fixture("block0 norm1 + scale1", norm1, fixture_directory, "norm1", ROWS *% WIDTH, 0.00005f64, 0.00005f64) && all_ok;

    guard let option::Option[f64]::Some(q_ms) = dispatch_linear(queue, linear_pipeline, norm1, q_weight, query, WIDTH, WIDTH, ROWS) else { return 1; }; total_ms = total_ms + q_ms;
    guard let option::Option[f64]::Some(k_ms) = dispatch_linear(queue, linear_pipeline, norm1, k_weight, key, WIDTH, WIDTH, ROWS) else { return 1; }; total_ms = total_ms + k_ms;
    guard let option::Option[f64]::Some(v_ms) = dispatch_linear(queue, linear_pipeline, norm1, v_weight, value, WIDTH, WIDTH, ROWS) else { return 1; }; total_ms = total_ms + v_ms;
    all_ok = compare_fixture("block0 Q projection", query, fixture_directory, "query", ROWS *% WIDTH, 0.0002f64, 0.0002f64) && all_ok;
    all_ok = compare_fixture("block0 K projection", key, fixture_directory, "key", ROWS *% WIDTH, 0.0002f64, 0.0002f64) && all_ok;
    all_ok = compare_fixture("block0 V projection", value, fixture_directory, "value", ROWS *% WIDTH, 0.0002f64, 0.0002f64) && all_ok;

    guard let option::Option[f64]::Some(qk_q_ms) = dispatch_1d(queue, qk_pipeline, query, norm_q_weight, query_rope, rope, dummy, dummy, #addr_of(params), ROWS *% HEADS) else { return 1; }; total_ms = total_ms + qk_q_ms;
    guard let option::Option[f64]::Some(qk_k_ms) = dispatch_1d(queue, qk_pipeline, key, norm_k_weight, key_rope, rope, dummy, dummy, #addr_of(params), ROWS *% HEADS) else { return 1; }; total_ms = total_ms + qk_k_ms;
    all_ok = compare_fixture("block0 Q RMSNorm + RoPE", query_rope, fixture_directory, "query_rope", ROWS *% WIDTH, 0.0003f64, 0.0003f64) && all_ok;
    all_ok = compare_fixture("block0 K RMSNorm + RoPE", key_rope, fixture_directory, "key_rope", ROWS *% WIDTH, 0.0003f64, 0.0003f64) && all_ok;

    guard let option::Option[f64]::Some(attention_ms) = dispatch_attention(queue, attention_pipeline, query_rope, key_rope, attended, value, image_ids, key_valid, ROWS, ROWS, key_rope, value, 0 as u64) else { return 1; }; total_ms = total_ms + attention_ms;
    all_ok = compare_fixture("block0 block-causal attention", attended, fixture_directory, "attention", ROWS *% WIDTH, 0.0005f64, 0.0005f64) && all_ok;

    guard let option::Option[f64]::Some(attention_projection_ms) = dispatch_linear(queue, linear_pipeline, attended, attention_output_weight, attention_projected, WIDTH, WIDTH, ROWS) else { return 1; }; total_ms = total_ms + attention_projection_ms;
    all_ok = compare_fixture("block0 attention output projection", attention_projected, fixture_directory, "attention_projected", ROWS *% WIDTH, 0.0005f64, 0.0005f64) && all_ok;

    params.slot = 1 as u32;
    guard let option::Option[f64]::Some(residual1_ms) = dispatch_1d(queue, residual_pipeline, hidden, modulation, residual1, attention_projected, target_mask, dummy, #addr_of(params), ROWS *% WIDTH) else { return 1; }; total_ms = total_ms + residual1_ms;
    all_ok = compare_fixture("block0 attention gated residual", residual1, fixture_directory, "residual1", ROWS *% WIDTH, 0.0005f64, 0.0005f64) && all_ok;

    params.slot = 2 as u32;
    guard let option::Option[f64]::Some(norm2_ms) = dispatch_1d(queue, norm_pipeline, residual1, modulation, norm2, target_mask, dummy, dummy, #addr_of(params), ROWS) else { return 1; }; total_ms = total_ms + norm2_ms;
    all_ok = compare_fixture("block0 norm2 + scale2", norm2, fixture_directory, "norm2", ROWS *% WIDTH, 0.0005f64, 0.0005f64) && all_ok;

    guard let option::Option[f64]::Some(gate_ms) = dispatch_linear(queue, linear_pipeline, norm2, gate_weight, gate, MLP_WIDTH, WIDTH, ROWS) else { return 1; }; total_ms = total_ms + gate_ms;
    guard let option::Option[f64]::Some(projected_ms) = dispatch_linear(queue, linear_pipeline, norm2, projected_weight, projected, MLP_WIDTH, WIDTH, ROWS) else { return 1; }; total_ms = total_ms + projected_ms;
    all_ok = compare_fixture("block0 MLP gate projection", gate, fixture_directory, "gate", ROWS *% MLP_WIDTH, 0.0008f64, 0.0008f64) && all_ok;
    all_ok = compare_fixture("block0 MLP value projection", projected, fixture_directory, "projected", ROWS *% MLP_WIDTH, 0.0008f64, 0.0008f64) && all_ok;

    params.width = WIDTH as u32;
    guard let option::Option[f64]::Some(swiglu_ms) = dispatch_1d(queue, swiglu_pipeline, gate, projected, swiglu, dummy, dummy, dummy, #addr_of(params), ROWS *% MLP_WIDTH) else { return 1; }; total_ms = total_ms + swiglu_ms;
    all_ok = compare_fixture("block0 SwiGLU", swiglu, fixture_directory, "swiglu", ROWS *% MLP_WIDTH, 0.001f64, 0.001f64) && all_ok;

    guard let option::Option[f64]::Some(mlp_projection_ms) = dispatch_linear(queue, linear_pipeline, swiglu, mlp_output_weight, mlp_projected, WIDTH, MLP_WIDTH, ROWS) else { return 1; }; total_ms = total_ms + mlp_projection_ms;
    all_ok = compare_fixture("block0 MLP output projection", mlp_projected, fixture_directory, "mlp_projected", ROWS *% WIDTH, 0.002f64, 0.002f64) && all_ok;

    params.slot = 3 as u32;
    guard let option::Option[f64]::Some(output_ms) = dispatch_1d(queue, residual_pipeline, residual1, modulation, output, mlp_projected, target_mask, dummy, #addr_of(params), ROWS *% WIDTH) else { return 1; }; total_ms = total_ms + output_ms;
    all_ok = compare_fixture("block0 final output", output, fixture_directory, "output", ROWS *% WIDTH, 0.002f64, 0.002f64) && all_ok;
    all_ok = finite("block0 final output", output, ROWS *% WIDTH) && all_ok;

    io::println("block0 Metal kernel time: ${total_ms} ms for ${ROWS} tokens; weights=416 MiB BF16");
    if all_ok {
        io::println("Qwen-Image-2.1 transformer block 0: verified");
        return 0;
    }
    return 1;
}

fn run_packed(packed_path: str, fixture_directory: str = "tests/fixtures/block0_fp32") -> i32 {
    guard let packed::LoadResult::Ok(weight_file) = packed::load(packed_path) else {
        io::eprintln("transformer block: could not load validated packed file ${packed_path}");
        return 1;
    };
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return 1; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    let device_pointer: *u8 = MTLCreateSystemDefaultDevice();
    if device_pointer.is_null() {
        io::eprintln("transformer block: no Metal device");
        return 1;
    }
    let device_owner: OwnedObjc = OwnedObjc::new(rt::retain(device_pointer));
    let device: metal::Device = metal::Device::from_raw(device_owner.raw());
    guard let option::Option[metal::CommandQueue]::Some(queue) = device.new_command_queue() else { return 1; };
    let queue_owner: OwnedObjc = OwnedObjc::new(queue.raw());
    let options_pointer: *u8 = rt::alloc_init(#str_ptr("MTLCompileOptions\0"));
    if options_pointer.is_null() { return 1; }
    let options_owner: OwnedObjc = OwnedObjc::new(options_pointer);
    let options: metal::CompileOptions = metal::CompileOptions::from_raw(options_owner.raw());
    options.set_fast_math_enabled(false);
    var compile_error: *u8 = 0 as *u8;
    guard let option::Option[metal::Library]::Some(library) = device.new_library_with_source(
        #include_str("../kernels/transformer_block.metal"),
        options,
        #addr_of(compile_error) as *u8,
    ) else {
        if !compile_error.is_null() {
            let description: *u8 = rt::msg_id(compile_error, rt::sel(#str_ptr("localizedDescription\0")));
            io::eprintln("transformer block Metal compile: ${bridge::to_text(description)}");
        }
        return 1;
    };
    let library_owner: OwnedObjc = OwnedObjc::new(library.raw());
    guard let option::Option[OwnedObjc]::Some(dense_owner) = pipeline(device, library, "qi_block_linear_32x32") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(int8_owner) = pipeline(device, library, "qi_block_int8_affine_linear_32x32") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(norm_owner) = pipeline(device, library, "qi_block_layernorm_modulate") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(qk_owner) = pipeline(device, library, "qi_block_qk_norm_rope") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(attention_owner) = pipeline(device, library, "qi_block_attention") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(residual_owner) = pipeline(device, library, "qi_block_residual") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(swiglu_owner) = pipeline(device, library, "qi_block_swiglu") else { return 1; };
    let int8_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(int8_owner.raw());
    let pipelines: Pipelines = Pipelines {
        dense_linear: metal::ComputePipelineState::from_raw(dense_owner.raw()),
        int8_linear: int8_pipeline,
        norm: metal::ComputePipelineState::from_raw(norm_owner.raw()),
        qk: metal::ComputePipelineState::from_raw(qk_owner.raw()),
        attention: metal::ComputePipelineState::from_raw(attention_owner.raw()),
        residual: metal::ComputePipelineState::from_raw(residual_owner.raw()),
        swiglu: metal::ComputePipelineState::from_raw(swiglu_owner.raw()),
    };

    guard let option::Option[metal::Buffer]::Some(storage) =
        packed_storage_buffer(device, weight_file) else { return 1; };
    let storage_owner: OwnedObjc = OwnedObjc::new(storage.raw());
    guard let option::Option[metal::Buffer]::Some(norm_q) = packed_vector_buffer(device, weight_file, "transformer_blocks.0.attn.norm_q.weight", HEAD_DIMENSION as u64) else { return 1; };
    let norm_q_owner: OwnedObjc = OwnedObjc::new(norm_q.raw());
    guard let option::Option[metal::Buffer]::Some(norm_k) = packed_vector_buffer(device, weight_file, "transformer_blocks.0.attn.norm_k.weight", HEAD_DIMENSION as u64) else { return 1; };
    let norm_k_owner: OwnedObjc = OwnedObjc::new(norm_k.raw());
    guard let option::Option[LinearWeight]::Some(q) = packed_linear_weight(weight_file, storage, "transformer_blocks.0.attn.to_q.weight", WIDTH as u64, WIDTH as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(k) = packed_linear_weight(weight_file, storage, "transformer_blocks.0.attn.to_k.weight", WIDTH as u64, WIDTH as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(v) = packed_linear_weight(weight_file, storage, "transformer_blocks.0.attn.to_v.weight", WIDTH as u64, WIDTH as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(attention_output) = packed_linear_weight(weight_file, storage, "transformer_blocks.0.attn.to_out.0.weight", WIDTH as u64, WIDTH as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(gate) = packed_linear_weight(weight_file, storage, "transformer_blocks.0.img_mlp.gate_layer.weight", MLP_WIDTH as u64, WIDTH as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(projected) = packed_linear_weight(weight_file, storage, "transformer_blocks.0.img_mlp.proj.weight", MLP_WIDTH as u64, WIDTH as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(mlp_output) = packed_linear_weight(weight_file, storage, "transformer_blocks.0.img_mlp.out.weight", WIDTH as u64, MLP_WIDTH as u64) else { return 1; };
    return execute_block(
        device,
        queue,
        pipelines,
        BlockWeights {
            norm_q: norm_q,
            norm_k: norm_k,
            q: q,
            k: k,
            v: v,
            attention_output: attention_output,
            gate: gate,
            projected: projected,
            mlp_output: mlp_output,
        },
        fixture_directory,
        true,
    );
}

fn run_full_packed(
    packed_path: str,
    fixture_directory: str = "tests/fixtures/transformer32_fp32",
) -> i32 {
    guard let packed::LoadResult::Ok(weight_file) = packed::load(packed_path) else {
        io::eprintln("transformer runtime: could not load validated packed file ${packed_path}");
        return 1;
    };
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return 1; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    let device_pointer: *u8 = MTLCreateSystemDefaultDevice();
    if device_pointer.is_null() {
        io::eprintln("transformer runtime: no Metal device");
        return 1;
    }
    let device_owner: OwnedObjc = OwnedObjc::new(rt::retain(device_pointer));
    let device: metal::Device = metal::Device::from_raw(device_owner.raw());
    guard let option::Option[metal::CommandQueue]::Some(queue) = device.new_command_queue() else {
        return 1;
    };
    let queue_owner: OwnedObjc = OwnedObjc::new(queue.raw());
    let options_pointer: *u8 = rt::alloc_init(#str_ptr("MTLCompileOptions\0"));
    if options_pointer.is_null() { return 1; }
    let options_owner: OwnedObjc = OwnedObjc::new(options_pointer);
    let options: metal::CompileOptions = metal::CompileOptions::from_raw(options_owner.raw());
    options.set_fast_math_enabled(false);
    var compile_error: *u8 = 0 as *u8;
    guard let option::Option[metal::Library]::Some(library) = device.new_library_with_source(
        #include_str("../kernels/transformer_block.metal"),
        options,
        #addr_of(compile_error) as *u8,
    ) else {
        if !compile_error.is_null() {
            let description: *u8 =
                rt::msg_id(compile_error, rt::sel(#str_ptr("localizedDescription\0")));
            io::eprintln("transformer runtime Metal compile: ${bridge::to_text(description)}");
        }
        return 1;
    };
    let library_owner: OwnedObjc = OwnedObjc::new(library.raw());
    guard let option::Option[OwnedObjc]::Some(dense_owner) =
        pipeline(device, library, "qi_block_linear_32x32") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(int8_owner) =
        pipeline(device, library, "qi_block_int8_affine_linear_32x32") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(norm_owner) =
        pipeline(device, library, "qi_block_layernorm_modulate") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(qk_owner) =
        pipeline(device, library, "qi_block_qk_norm_rope") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(attention_owner) =
        pipeline(device, library, "qi_block_attention") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(residual_owner) =
        pipeline(device, library, "qi_block_residual") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(swiglu_owner) =
        pipeline(device, library, "qi_block_swiglu") else { return 1; };
    let pipelines: Pipelines = Pipelines {
        dense_linear: metal::ComputePipelineState::from_raw(dense_owner.raw()),
        int8_linear: metal::ComputePipelineState::from_raw(int8_owner.raw()),
        norm: metal::ComputePipelineState::from_raw(norm_owner.raw()),
        qk: metal::ComputePipelineState::from_raw(qk_owner.raw()),
        attention: metal::ComputePipelineState::from_raw(attention_owner.raw()),
        residual: metal::ComputePipelineState::from_raw(residual_owner.raw()),
        swiglu: metal::ComputePipelineState::from_raw(swiglu_owner.raw()),
    };
    guard let option::Option[metal::Buffer]::Some(storage) =
        packed_storage_buffer(device, weight_file) else {
        io::eprintln("transformer runtime: could not create no-copy packed buffer");
        return 1;
    };
    let storage_owner: OwnedObjc = OwnedObjc::new(storage.raw());
    io::println(
        "transformer runtime: no-copy packed buffer bytes=${round_up(weight_file.length(), VM_PAGE_BYTES)}",
    );

    let activation_bytes: u64 = (ROWS *% WIDTH *% #size_of::[f32]()) as u64;
    let mlp_bytes: u64 = (ROWS *% MLP_WIDTH *% #size_of::[f32]()) as u64;
    guard let option::Option[metal::Buffer]::Some(first_hidden) =
        fixture_buffer(device, fixture_directory, "hidden", activation_bytes) else { return 1; };
    let first_hidden_owner: OwnedObjc = OwnedObjc::new(first_hidden.raw());
    guard let option::Option[metal::Buffer]::Some(second_hidden) =
        new_buffer(device, activation_bytes) else { return 1; };
    let second_hidden_owner: OwnedObjc = OwnedObjc::new(second_hidden.raw());
    guard let option::Option[metal::Buffer]::Some(modulation) = fixture_buffer(
        device,
        fixture_directory,
        "modulation",
        ((2 as usize) *% (4 as usize) *% WIDTH *% #size_of::[f32]()) as u64,
    ) else { return 1; };
    let modulation_owner: OwnedObjc = OwnedObjc::new(modulation.raw());
    guard let option::Option[metal::Buffer]::Some(rope) = fixture_buffer(
        device,
        fixture_directory,
        "rope",
        (ROWS *% HEAD_DIMENSION *% #size_of::[f32]()) as u64,
    ) else { return 1; };
    let rope_owner: OwnedObjc = OwnedObjc::new(rope.raw());
    guard let option::Option[metal::Buffer]::Some(target_mask) =
        new_buffer(device, ROWS as u64) else { return 1; };
    let target_mask_owner: OwnedObjc = OwnedObjc::new(target_mask.raw());
    let target_values: *u8 = target_mask.contents();
    target_values[0] = 0 as u8;
    target_values[1] = 0 as u8;
    target_values[2] = 1 as u8;
    target_values[3] = 1 as u8;
    guard let option::Option[metal::Buffer]::Some(image_ids) =
        new_buffer(device, (ROWS *% #size_of::[i32]()) as u64) else { return 1; };
    let image_ids_owner: OwnedObjc = OwnedObjc::new(image_ids.raw());
    let image_values: *i32 = image_ids.contents() as *i32;
    image_values[0] = 0 -% (1 as i32);
    image_values[1] = 0 -% (1 as i32);
    image_values[2] = 0 as i32;
    image_values[3] = 0 as i32;
    guard let option::Option[metal::Buffer]::Some(key_valid) =
        new_buffer(device, ROWS as u64) else { return 1; };
    let key_valid_owner: OwnedObjc = OwnedObjc::new(key_valid.raw());
    var row: usize = 0 as usize;
    while row < ROWS {
        (key_valid.contents())[row] = 1 as u8;
        row = row +% (1 as usize);
    }
    guard let option::Option[metal::Buffer]::Some(dummy) = new_buffer(device, 4 as u64) else {
        return 1;
    };
    let dummy_owner: OwnedObjc = OwnedObjc::new(dummy.raw());

    guard let option::Option[metal::Buffer]::Some(norm1) = new_buffer(device, activation_bytes) else { return 1; };
    let norm1_owner: OwnedObjc = OwnedObjc::new(norm1.raw());
    guard let option::Option[metal::Buffer]::Some(query) = new_buffer(device, activation_bytes) else { return 1; };
    let query_owner: OwnedObjc = OwnedObjc::new(query.raw());
    guard let option::Option[metal::Buffer]::Some(key) = new_buffer(device, activation_bytes) else { return 1; };
    let key_owner: OwnedObjc = OwnedObjc::new(key.raw());
    guard let option::Option[metal::Buffer]::Some(value) = new_buffer(device, activation_bytes) else { return 1; };
    let value_owner: OwnedObjc = OwnedObjc::new(value.raw());
    guard let option::Option[metal::Buffer]::Some(query_rope) = new_buffer(device, activation_bytes) else { return 1; };
    let query_rope_owner: OwnedObjc = OwnedObjc::new(query_rope.raw());
    guard let option::Option[metal::Buffer]::Some(key_rope) = new_buffer(device, activation_bytes) else { return 1; };
    let key_rope_owner: OwnedObjc = OwnedObjc::new(key_rope.raw());
    guard let option::Option[metal::Buffer]::Some(attended) = new_buffer(device, activation_bytes) else { return 1; };
    let attended_owner: OwnedObjc = OwnedObjc::new(attended.raw());
    guard let option::Option[metal::Buffer]::Some(attention_projected) = new_buffer(device, activation_bytes) else { return 1; };
    let attention_projected_owner: OwnedObjc = OwnedObjc::new(attention_projected.raw());
    guard let option::Option[metal::Buffer]::Some(residual1) = new_buffer(device, activation_bytes) else { return 1; };
    let residual1_owner: OwnedObjc = OwnedObjc::new(residual1.raw());
    guard let option::Option[metal::Buffer]::Some(norm2) = new_buffer(device, activation_bytes) else { return 1; };
    let norm2_owner: OwnedObjc = OwnedObjc::new(norm2.raw());
    guard let option::Option[metal::Buffer]::Some(gate) = new_buffer(device, mlp_bytes) else { return 1; };
    let gate_owner: OwnedObjc = OwnedObjc::new(gate.raw());
    guard let option::Option[metal::Buffer]::Some(projected) = new_buffer(device, mlp_bytes) else { return 1; };
    let projected_owner: OwnedObjc = OwnedObjc::new(projected.raw());
    guard let option::Option[metal::Buffer]::Some(swiglu) = new_buffer(device, mlp_bytes) else { return 1; };
    let swiglu_buffer_owner: OwnedObjc = OwnedObjc::new(swiglu.raw());
    guard let option::Option[metal::Buffer]::Some(mlp_projected) = new_buffer(device, activation_bytes) else { return 1; };
    let mlp_projected_owner: OwnedObjc = OwnedObjc::new(mlp_projected.raw());
    let workspace: BlockWorkspace = BlockWorkspace {
        modulation: modulation,
        rope: rope,
        target_mask: target_mask,
        image_ids: image_ids,
        key_valid: key_valid,
        dummy: dummy,
        norm1: norm1,
        query: query,
        key: key,
        value: value,
        query_rope: query_rope,
        key_rope: key_rope,
        attended: attended,
        attention_projected: attention_projected,
        residual1: residual1,
        norm2: norm2,
        gate: gate,
        projected: projected,
        swiglu: swiglu,
        mlp_projected: mlp_projected,
    };

    var current: metal::Buffer = first_hidden;
    var next: metal::Buffer = second_hidden;
    var total_ms: f64 = 0.0f64;
    var quantized_matrices: usize = 0 as usize;
    var all_ok: bool = true;
    var block: usize = 0 as usize;
    while block < (32 as usize) {
        let norm_q_name: text::Text = "transformer_blocks.${block}.attn.norm_q.weight";
        let norm_k_name: text::Text = "transformer_blocks.${block}.attn.norm_k.weight";
        let q_name: text::Text = "transformer_blocks.${block}.attn.to_q.weight";
        let k_name: text::Text = "transformer_blocks.${block}.attn.to_k.weight";
        let v_name: text::Text = "transformer_blocks.${block}.attn.to_v.weight";
        let attention_output_name: text::Text =
            "transformer_blocks.${block}.attn.to_out.0.weight";
        let gate_name: text::Text = "transformer_blocks.${block}.img_mlp.gate_layer.weight";
        let projected_name: text::Text = "transformer_blocks.${block}.img_mlp.proj.weight";
        let mlp_output_name: text::Text = "transformer_blocks.${block}.img_mlp.out.weight";
        guard let option::Option[metal::Buffer]::Some(norm_q) = packed_vector_buffer(
            device, weight_file, norm_q_name.view(), HEAD_DIMENSION as u64,
        ) else { return 1; };
        let norm_q_owner: OwnedObjc = OwnedObjc::new(norm_q.raw());
        guard let option::Option[metal::Buffer]::Some(norm_k) = packed_vector_buffer(
            device, weight_file, norm_k_name.view(), HEAD_DIMENSION as u64,
        ) else { return 1; };
        let norm_k_owner: OwnedObjc = OwnedObjc::new(norm_k.raw());
        guard let option::Option[LinearWeight]::Some(q) = packed_linear_weight(
            weight_file, storage, q_name.view(), WIDTH as u64, WIDTH as u64,
        ) else { return 1; };
        guard let option::Option[LinearWeight]::Some(k) = packed_linear_weight(
            weight_file, storage, k_name.view(), WIDTH as u64, WIDTH as u64,
        ) else { return 1; };
        guard let option::Option[LinearWeight]::Some(v) = packed_linear_weight(
            weight_file, storage, v_name.view(), WIDTH as u64, WIDTH as u64,
        ) else { return 1; };
        guard let option::Option[LinearWeight]::Some(attention_output) = packed_linear_weight(
            weight_file, storage, attention_output_name.view(), WIDTH as u64, WIDTH as u64,
        ) else { return 1; };
        guard let option::Option[LinearWeight]::Some(gate_weight) = packed_linear_weight(
            weight_file, storage, gate_name.view(), MLP_WIDTH as u64, WIDTH as u64,
        ) else { return 1; };
        guard let option::Option[LinearWeight]::Some(projected_weight) = packed_linear_weight(
            weight_file, storage, projected_name.view(), MLP_WIDTH as u64, WIDTH as u64,
        ) else { return 1; };
        guard let option::Option[LinearWeight]::Some(mlp_output) = packed_linear_weight(
            weight_file, storage, mlp_output_name.view(), WIDTH as u64, MLP_WIDTH as u64,
        ) else { return 1; };
        let block_quantized: usize =
            (if q.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize })
            +% (if k.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize })
            +% (if v.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize })
            +% (if attention_output.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize })
            +% (if gate_weight.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize })
            +% (if projected_weight.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize })
            +% (if mlp_output.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize });
        quantized_matrices = quantized_matrices +% block_quantized;
        guard let option::Option[f64]::Some(block_ms) = execute_batched_runtime_block(
            queue,
            pipelines,
            BlockWeights {
                norm_q: norm_q,
                norm_k: norm_k,
                q: q,
                k: k,
                v: v,
                attention_output: attention_output,
                gate: gate_weight,
                projected: projected_weight,
                mlp_output: mlp_output,
            },
            workspace,
            current,
            next,
            ROWS,
            0 as u32,
            pipelines.norm,
            workspace.dummy,
            workspace.dummy,
            0 as u64,
            0 as usize,
        ) else { return 1; };
        total_ms = total_ms + block_ms;
        all_ok = finite("transformer block ${block} output", next, ROWS *% WIDTH) && all_ok;
        let capture_name: str = captured_block_name(block);
        if capture_name.count() > (0 as usize) {
            guard let option::Option[f64]::Some(error) = normalized_rms_fixture(
                next,
                fixture_directory,
                capture_name,
                ROWS *% WIDTH,
            ) else { return 1; };
            io::println(
                "transformer block ${block}: q8=${block_quantized} gpu_ms=${block_ms} nRMSE=${error}",
            );
            if block == (31 as usize) { all_ok = error <= 0.01f64 && all_ok; }
        }
        let swap: metal::Buffer = current;
        current = next;
        next = swap;
        block = block +% (1 as usize);
    }
    if quantized_matrices != (40 as usize) {
        io::eprintln("transformer runtime: expected 40 Q8 matrices, found ${quantized_matrices}");
        return 1;
    }
    io::println(
        "transformer runtime: blocks=32 q8=${quantized_matrices} tokens=${ROWS} total_gpu_ms=${total_ms}",
    );
    if all_ok {
        io::println("Qwen-Image-2.1 full mixed transformer path: verified");
        return 0;
    }
    return 1;
}

fn run_complete_packed(
    packed_path: str,
    fixture_directory: str = "tests/fixtures/transformer_model_fp32",
) -> i32 {
    guard let packed::LoadResult::Ok(weight_file) = packed::load(packed_path) else {
        io::eprintln("complete transformer: could not load validated packed file ${packed_path}");
        return 1;
    };
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return 1; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    let device_pointer: *u8 = MTLCreateSystemDefaultDevice();
    if device_pointer.is_null() { return 1; }
    let device_owner: OwnedObjc = OwnedObjc::new(rt::retain(device_pointer));
    let device: metal::Device = metal::Device::from_raw(device_owner.raw());
    guard let option::Option[metal::CommandQueue]::Some(queue) = device.new_command_queue() else { return 1; };
    let queue_owner: OwnedObjc = OwnedObjc::new(queue.raw());
    let options_pointer: *u8 = rt::alloc_init(#str_ptr("MTLCompileOptions\0"));
    if options_pointer.is_null() { return 1; }
    let options_owner: OwnedObjc = OwnedObjc::new(options_pointer);
    let options: metal::CompileOptions = metal::CompileOptions::from_raw(options_owner.raw());
    options.set_fast_math_enabled(false);
    var compile_error: *u8 = 0 as *u8;
    guard let option::Option[metal::Library]::Some(library) = device.new_library_with_source(
        #include_str("../kernels/transformer_block.metal"), options, #addr_of(compile_error) as *u8,
    ) else {
        if !compile_error.is_null() {
            let description: *u8 = rt::msg_id(compile_error, rt::sel(#str_ptr("localizedDescription\0")));
            io::eprintln("complete transformer Metal compile: ${bridge::to_text(description)}");
        }
        return 1;
    };
    let library_owner: OwnedObjc = OwnedObjc::new(library.raw());
    guard let option::Option[OwnedObjc]::Some(dense_owner) = pipeline(device, library, "qi_block_linear_32x32") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(int8_owner) = pipeline(device, library, "qi_block_int8_affine_linear_32x32") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(norm_owner) = pipeline(device, library, "qi_block_layernorm_modulate") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(qk_owner) = pipeline(device, library, "qi_block_qk_norm_rope") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(attention_owner) = pipeline(device, library, "qi_block_attention") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(residual_owner) = pipeline(device, library, "qi_block_residual") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(swiglu_owner) = pipeline(device, library, "qi_block_swiglu") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(time_owner) = pipeline(device, library, "qi_time_projection") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(silu_owner) = pipeline(device, library, "qi_silu") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(gelu_owner) = pipeline(device, library, "qi_gelu_tanh") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(text_norm_owner) = pipeline(device, library, "qi_zero_center_rms_norm") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(assemble_owner) = pipeline(device, library, "qi_joint_assemble") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(final_norm_owner) = pipeline(device, library, "qi_final_layernorm_modulate") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(cache_copy_owner) = pipeline(device, library, "qi_copy_prefix_kv") else { return 1; };
    let pipelines: Pipelines = Pipelines {
        dense_linear: metal::ComputePipelineState::from_raw(dense_owner.raw()),
        int8_linear: metal::ComputePipelineState::from_raw(int8_owner.raw()),
        norm: metal::ComputePipelineState::from_raw(norm_owner.raw()),
        qk: metal::ComputePipelineState::from_raw(qk_owner.raw()),
        attention: metal::ComputePipelineState::from_raw(attention_owner.raw()),
        residual: metal::ComputePipelineState::from_raw(residual_owner.raw()),
        swiglu: metal::ComputePipelineState::from_raw(swiglu_owner.raw()),
    };
    let time_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(time_owner.raw());
    let silu_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(silu_owner.raw());
    let gelu_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(gelu_owner.raw());
    let text_norm_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(text_norm_owner.raw());
    let assemble_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(assemble_owner.raw());
    let final_norm_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(final_norm_owner.raw());
    let cache_copy_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(cache_copy_owner.raw());

    guard let option::Option[metal::Buffer]::Some(storage) = packed_storage_buffer(device, weight_file) else { return 1; };
    let storage_owner: OwnedObjc = OwnedObjc::new(storage.raw());
    io::println("complete transformer: no-copy packed buffer bytes=${round_up(weight_file.length(), VM_PAGE_BYTES)}");

    guard let option::Option[LinearWeight]::Some(img_in_weight) = packed_linear_weight(weight_file, storage, "img_in.weight", WIDTH as u64, IMAGE_CHANNELS as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(text_in_weight) = packed_linear_weight(weight_file, storage, "txt_in.in_layer.weight", WIDTH as u64, WIDTH as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(text_out_weight) = packed_linear_weight(weight_file, storage, "txt_in.out_layer.weight", WIDTH as u64, WIDTH as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(time_1_weight) = packed_linear_weight(weight_file, storage, "time_text_embed.timestep_embedder.linear_1.weight", WIDTH as u64, 256 as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(time_2_weight) = packed_linear_weight(weight_file, storage, "time_text_embed.timestep_embedder.linear_2.weight", WIDTH as u64, WIDTH as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(modulation_weight) = packed_linear_weight(weight_file, storage, "modulation.1.weight", ((4 as usize) *% WIDTH) as u64, WIDTH as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(final_scale_weight) = packed_linear_weight(weight_file, storage, "norm_out.linear.weight", WIDTH as u64, WIDTH as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(proj_out_weight) = packed_linear_weight(weight_file, storage, "proj_out.weight", IMAGE_CHANNELS as u64, WIDTH as u64) else { return 1; };
    guard let option::Option[metal::Buffer]::Some(text_norm_weight) = packed_vector_buffer(device, weight_file, "txt_in.text_norm.weight", WIDTH as u64) else { return 1; };
    let text_norm_weight_owner: OwnedObjc = OwnedObjc::new(text_norm_weight.raw());

    let activation_bytes: u64 = (COMPLETE_ROWS *% WIDTH *% #size_of::[f32]()) as u64;
    let text_bytes: u64 = (COMPLETE_TEXT_ROWS *% WIDTH *% #size_of::[f32]()) as u64;
    let image_input_bytes: u64 = (COMPLETE_IMAGE_ROWS *% IMAGE_CHANNELS *% #size_of::[f32]()) as u64;
    let image_projected_bytes: u64 = (COMPLETE_IMAGE_ROWS *% WIDTH *% #size_of::[f32]()) as u64;
    let mlp_bytes: u64 = (COMPLETE_ROWS *% MLP_WIDTH *% #size_of::[f32]()) as u64;
    guard let option::Option[metal::Buffer]::Some(dummy) = new_buffer(device, 4 as u64) else { return 1; };
    let dummy_owner: OwnedObjc = OwnedObjc::new(dummy.raw());
    guard let option::Option[metal::Buffer]::Some(image_input) = fixture_buffer(device, fixture_directory, "image_input", image_input_bytes) else { return 1; };
    let image_input_owner: OwnedObjc = OwnedObjc::new(image_input.raw());
    guard let option::Option[metal::Buffer]::Some(text_input) = fixture_buffer(device, fixture_directory, "text_input", text_bytes) else { return 1; };
    let text_input_owner: OwnedObjc = OwnedObjc::new(text_input.raw());
    guard let option::Option[metal::Buffer]::Some(timestep) = fixture_buffer(device, fixture_directory, "timestep", ((2 as usize) *% #size_of::[f32]()) as u64) else { return 1; };
    let timestep_owner: OwnedObjc = OwnedObjc::new(timestep.raw());

    guard let option::Option[metal::Buffer]::Some(image_projected) = new_buffer(device, image_projected_bytes) else { return 1; };
    let image_projected_owner: OwnedObjc = OwnedObjc::new(image_projected.raw());
    guard let option::Option[metal::Buffer]::Some(text_normalized) = new_buffer(device, text_bytes) else { return 1; };
    let text_normalized_owner: OwnedObjc = OwnedObjc::new(text_normalized.raw());
    guard let option::Option[metal::Buffer]::Some(text_hidden) = new_buffer(device, text_bytes) else { return 1; };
    let text_hidden_owner: OwnedObjc = OwnedObjc::new(text_hidden.raw());
    guard let option::Option[metal::Buffer]::Some(text_activated) = new_buffer(device, text_bytes) else { return 1; };
    let text_activated_owner: OwnedObjc = OwnedObjc::new(text_activated.raw());
    guard let option::Option[metal::Buffer]::Some(text_projected) = new_buffer(device, text_bytes) else { return 1; };
    let text_projected_owner: OwnedObjc = OwnedObjc::new(text_projected.raw());
    guard let option::Option[metal::Buffer]::Some(time_projection) = new_buffer(device, ((2 as usize) *% (256 as usize) *% #size_of::[f32]()) as u64) else { return 1; };
    let time_projection_owner: OwnedObjc = OwnedObjc::new(time_projection.raw());
    guard let option::Option[metal::Buffer]::Some(time_hidden) = new_buffer(device, ((2 as usize) *% WIDTH *% #size_of::[f32]()) as u64) else { return 1; };
    let time_hidden_owner: OwnedObjc = OwnedObjc::new(time_hidden.raw());
    guard let option::Option[metal::Buffer]::Some(time_activated_hidden) = new_buffer(device, ((2 as usize) *% WIDTH *% #size_of::[f32]()) as u64) else { return 1; };
    let time_activated_hidden_owner: OwnedObjc = OwnedObjc::new(time_activated_hidden.raw());
    guard let option::Option[metal::Buffer]::Some(time_embedding) = new_buffer(device, ((2 as usize) *% WIDTH *% #size_of::[f32]()) as u64) else { return 1; };
    let time_embedding_owner: OwnedObjc = OwnedObjc::new(time_embedding.raw());
    guard let option::Option[metal::Buffer]::Some(activated_time) = new_buffer(device, ((2 as usize) *% WIDTH *% #size_of::[f32]()) as u64) else { return 1; };
    let activated_time_owner: OwnedObjc = OwnedObjc::new(activated_time.raw());
    guard let option::Option[metal::Buffer]::Some(modulation) = new_buffer(device, ((2 as usize) *% (4 as usize) *% WIDTH *% #size_of::[f32]()) as u64) else { return 1; };
    let modulation_owner: OwnedObjc = OwnedObjc::new(modulation.raw());
    guard let option::Option[metal::Buffer]::Some(first_hidden) = new_buffer(device, activation_bytes) else { return 1; };
    let first_hidden_owner: OwnedObjc = OwnedObjc::new(first_hidden.raw());
    guard let option::Option[metal::Buffer]::Some(second_hidden) = new_buffer(device, activation_bytes) else { return 1; };
    let second_hidden_owner: OwnedObjc = OwnedObjc::new(second_hidden.raw());

    var params: BlockParams = BlockParams { rows: COMPLETE_IMAGE_ROWS as u32, width: WIDTH as u32, heads: HEADS as u32, head_dimension: HEAD_DIMENSION as u32, epsilon: 0.000001f32, slot: 0 as u32 };
    var total_ms: f64 = 0.0f64;
    guard let option::Option[f64]::Some(img_ms) = dispatch_weighted_linear(queue, pipelines, image_input, img_in_weight, image_projected, WIDTH, IMAGE_CHANNELS, COMPLETE_IMAGE_ROWS) else { return 1; };
    total_ms = total_ms + img_ms;
    var all_ok: bool = compare_fixture("complete img_in", image_projected, fixture_directory, "image_projected", COMPLETE_IMAGE_ROWS *% WIDTH, 0.0003f64, 0.0003f64);

    params.rows = COMPLETE_TEXT_ROWS as u32;
    guard let option::Option[f64]::Some(text_norm_ms) = dispatch_1d(queue, text_norm_pipeline, text_input, text_norm_weight, text_normalized, dummy, dummy, dummy, #addr_of(params), COMPLETE_TEXT_ROWS) else { return 1; };
    total_ms = total_ms + text_norm_ms;
    guard let option::Option[f64]::Some(text_in_ms) = dispatch_weighted_linear(queue, pipelines, text_normalized, text_in_weight, text_hidden, WIDTH, WIDTH, COMPLETE_TEXT_ROWS) else { return 1; };
    total_ms = total_ms + text_in_ms;
    guard let option::Option[f64]::Some(gelu_ms) = dispatch_1d(queue, gelu_pipeline, text_hidden, dummy, text_activated, dummy, dummy, dummy, #addr_of(params), COMPLETE_TEXT_ROWS *% WIDTH) else { return 1; };
    total_ms = total_ms + gelu_ms;
    guard let option::Option[f64]::Some(text_out_ms) = dispatch_weighted_linear(queue, pipelines, text_activated, text_out_weight, text_projected, WIDTH, WIDTH, COMPLETE_TEXT_ROWS) else { return 1; };
    total_ms = total_ms + text_out_ms;
    all_ok = compare_fixture("complete text projection", text_projected, fixture_directory, "text_projected", COMPLETE_TEXT_ROWS *% WIDTH, 0.002f64, 0.002f64) && all_ok;

    params.rows = 2 as u32;
    params.width = 256 as u32;
    guard let option::Option[f64]::Some(time_projection_ms) = dispatch_1d(queue, time_pipeline, timestep, dummy, time_projection, dummy, dummy, dummy, #addr_of(params), (2 as usize) *% (256 as usize)) else { return 1; };
    total_ms = total_ms + time_projection_ms;
    guard let option::Option[f64]::Some(time_1_ms) = dispatch_weighted_linear(queue, pipelines, time_projection, time_1_weight, time_hidden, WIDTH, 256, 2) else { return 1; };
    total_ms = total_ms + time_1_ms;
    params.width = WIDTH as u32;
    guard let option::Option[f64]::Some(time_silu_ms) = dispatch_1d(queue, silu_pipeline, time_hidden, dummy, time_activated_hidden, dummy, dummy, dummy, #addr_of(params), (2 as usize) *% WIDTH) else { return 1; };
    total_ms = total_ms + time_silu_ms;
    guard let option::Option[f64]::Some(time_2_ms) = dispatch_weighted_linear(queue, pipelines, time_activated_hidden, time_2_weight, time_embedding, WIDTH, WIDTH, 2) else { return 1; };
    total_ms = total_ms + time_2_ms;
    all_ok = compare_fixture("complete timestep embedding", time_embedding, fixture_directory, "time_embedding", (2 as usize) *% WIDTH, 0.002f64, 0.002f64) && all_ok;
    guard let option::Option[f64]::Some(activated_time_ms) = dispatch_1d(queue, silu_pipeline, time_embedding, dummy, activated_time, dummy, dummy, dummy, #addr_of(params), (2 as usize) *% WIDTH) else { return 1; };
    total_ms = total_ms + activated_time_ms;
    guard let option::Option[f64]::Some(modulation_ms) = dispatch_weighted_linear(queue, pipelines, activated_time, modulation_weight, modulation, (4 as usize) *% WIDTH, WIDTH, 2) else { return 1; };
    total_ms = total_ms + modulation_ms;
    all_ok = compare_fixture("complete shared modulation", modulation, fixture_directory, "modulation", (2 as usize) *% (4 as usize) *% WIDTH, 0.005f64, 0.005f64) && all_ok;

    guard let option::Option[metal::Buffer]::Some(source_index) = new_buffer(device, (COMPLETE_ROWS *% #size_of::[i32]()) as u64) else { return 1; };
    let source_index_owner: OwnedObjc = OwnedObjc::new(source_index.raw());
    let sources: *i32 = source_index.contents() as *i32;
    sources[0] = 0 -% (1 as i32); sources[1] = 0 -% (2 as i32);
    sources[2] = 0; sources[3] = 1; sources[4] = 2; sources[5] = 3;
    sources[6] = 0 -% (4 as i32);
    sources[7] = 4; sources[8] = 5; sources[9] = 6; sources[10] = 7;
    sources[11] = 8; sources[12] = 9; sources[13] = 10; sources[14] = 11;
    params.rows = COMPLETE_ROWS as u32;
    guard let option::Option[f64]::Some(assemble_ms) = dispatch_1d(queue, assemble_pipeline, text_projected, image_projected, first_hidden, source_index, dummy, dummy, #addr_of(params), COMPLETE_ROWS *% WIDTH) else { return 1; };
    total_ms = total_ms + assemble_ms;
    all_ok = compare_fixture("complete joint assembly", first_hidden, fixture_directory, "joint_input", COMPLETE_ROWS *% WIDTH, 0.002f64, 0.002f64) && all_ok;

    guard let option::Option[metal::Buffer]::Some(rope) = fixture_buffer(device, fixture_directory, "rope", (COMPLETE_ROWS *% HEAD_DIMENSION *% #size_of::[f32]()) as u64) else { return 1; };
    let rope_owner: OwnedObjc = OwnedObjc::new(rope.raw());
    guard let option::Option[metal::Buffer]::Some(target_mask) = new_buffer(device, COMPLETE_ROWS as u64) else { return 1; };
    let target_mask_owner: OwnedObjc = OwnedObjc::new(target_mask.raw());
    var row: usize = 0 as usize;
    while row < COMPLETE_ROWS { (target_mask.contents())[row] = if row >= (7 as usize) { 1 as u8 } else { 0 as u8 }; row = row +% (1 as usize); }
    guard let option::Option[metal::Buffer]::Some(image_ids) = new_buffer(device, (COMPLETE_ROWS *% #size_of::[i32]()) as u64) else { return 1; };
    let image_ids_owner: OwnedObjc = OwnedObjc::new(image_ids.raw());
    let ids: *i32 = image_ids.contents() as *i32;
    ids[0] = 0 -% (1 as i32); ids[1] = 0 -% (1 as i32);
    ids[2] = 0; ids[3] = 0; ids[4] = 0; ids[5] = 0;
    ids[6] = 0 -% (1 as i32);
    row = 7 as usize; while row < COMPLETE_ROWS { ids[row] = 1; row = row +% (1 as usize); }
    guard let option::Option[metal::Buffer]::Some(key_valid) = new_buffer(device, COMPLETE_ROWS as u64) else { return 1; };
    let key_valid_owner: OwnedObjc = OwnedObjc::new(key_valid.raw());
    row = 0 as usize; while row < COMPLETE_ROWS { (key_valid.contents())[row] = if row == (6 as usize) { 0 as u8 } else { 1 as u8 }; row = row +% (1 as usize); }

    guard let option::Option[metal::Buffer]::Some(norm1) = new_buffer(device, activation_bytes) else { return 1; }; let norm1_owner: OwnedObjc = OwnedObjc::new(norm1.raw());
    guard let option::Option[metal::Buffer]::Some(query) = new_buffer(device, activation_bytes) else { return 1; }; let query_owner: OwnedObjc = OwnedObjc::new(query.raw());
    guard let option::Option[metal::Buffer]::Some(key) = new_buffer(device, activation_bytes) else { return 1; }; let key_owner: OwnedObjc = OwnedObjc::new(key.raw());
    guard let option::Option[metal::Buffer]::Some(value) = new_buffer(device, activation_bytes) else { return 1; }; let value_owner: OwnedObjc = OwnedObjc::new(value.raw());
    guard let option::Option[metal::Buffer]::Some(query_rope) = new_buffer(device, activation_bytes) else { return 1; }; let query_rope_owner: OwnedObjc = OwnedObjc::new(query_rope.raw());
    guard let option::Option[metal::Buffer]::Some(key_rope) = new_buffer(device, activation_bytes) else { return 1; }; let key_rope_owner: OwnedObjc = OwnedObjc::new(key_rope.raw());
    guard let option::Option[metal::Buffer]::Some(attended) = new_buffer(device, activation_bytes) else { return 1; }; let attended_owner: OwnedObjc = OwnedObjc::new(attended.raw());
    guard let option::Option[metal::Buffer]::Some(attention_projected) = new_buffer(device, activation_bytes) else { return 1; }; let attention_projected_owner: OwnedObjc = OwnedObjc::new(attention_projected.raw());
    guard let option::Option[metal::Buffer]::Some(residual1) = new_buffer(device, activation_bytes) else { return 1; }; let residual1_owner: OwnedObjc = OwnedObjc::new(residual1.raw());
    guard let option::Option[metal::Buffer]::Some(norm2) = new_buffer(device, activation_bytes) else { return 1; }; let norm2_owner: OwnedObjc = OwnedObjc::new(norm2.raw());
    guard let option::Option[metal::Buffer]::Some(gate) = new_buffer(device, mlp_bytes) else { return 1; }; let gate_owner: OwnedObjc = OwnedObjc::new(gate.raw());
    guard let option::Option[metal::Buffer]::Some(projected) = new_buffer(device, mlp_bytes) else { return 1; }; let projected_owner: OwnedObjc = OwnedObjc::new(projected.raw());
    guard let option::Option[metal::Buffer]::Some(swiglu) = new_buffer(device, mlp_bytes) else { return 1; }; let swiglu_buffer_owner: OwnedObjc = OwnedObjc::new(swiglu.raw());
    guard let option::Option[metal::Buffer]::Some(mlp_projected) = new_buffer(device, activation_bytes) else { return 1; }; let mlp_projected_owner: OwnedObjc = OwnedObjc::new(mlp_projected.raw());
    let workspace: BlockWorkspace = BlockWorkspace { modulation: modulation, rope: rope, target_mask: target_mask, image_ids: image_ids, key_valid: key_valid, dummy: dummy, norm1: norm1, query: query, key: key, value: value, query_rope: query_rope, key_rope: key_rope, attended: attended, attention_projected: attention_projected, residual1: residual1, norm2: norm2, gate: gate, projected: projected, swiglu: swiglu, mlp_projected: mlp_projected };

    // The prefix is timestep-independent. Store each block's post-RoPE K and
    // raw V in contiguous arenas; target-only passes reuse those values.
    let prefix_rows: usize = 7 as usize;
    let target_rows: usize = COMPLETE_ROWS -% prefix_rows;
    let target_activation_bytes: u64 = (target_rows *% WIDTH *% #size_of::[f32]()) as u64;
    let per_block_cache_bytes: u64 = (prefix_rows *% WIDTH *% #size_of::[f32]()) as u64;
    let cache_arena_bytes: u64 = (32 as u64) *% per_block_cache_bytes;
    guard let option::Option[metal::Buffer]::Some(cache_key_arena) = new_buffer(device, cache_arena_bytes) else { return 1; }; let cache_key_arena_owner: OwnedObjc = OwnedObjc::new(cache_key_arena.raw());
    guard let option::Option[metal::Buffer]::Some(cache_value_arena) = new_buffer(device, cache_arena_bytes) else { return 1; }; let cache_value_arena_owner: OwnedObjc = OwnedObjc::new(cache_value_arena.raw());
    guard let option::Option[metal::Buffer]::Some(cached_first_hidden) = new_buffer(device, target_activation_bytes) else { return 1; }; let cached_first_hidden_owner: OwnedObjc = OwnedObjc::new(cached_first_hidden.raw());
    guard let option::Option[metal::Buffer]::Some(cached_second_hidden) = new_buffer(device, target_activation_bytes) else { return 1; }; let cached_second_hidden_owner: OwnedObjc = OwnedObjc::new(cached_second_hidden.raw());
    let joint_values: *f32 = first_hidden.contents() as *f32;
    let cached_values: *f32 = cached_first_hidden.contents() as *f32;
    var copy_index: usize = 0 as usize;
    while copy_index < target_rows *% WIDTH {
        cached_values[copy_index] = joint_values[prefix_rows *% WIDTH +% copy_index];
        copy_index = copy_index +% (1 as usize);
    }
    guard let option::Option[metal::Buffer]::Some(cached_rope) = new_buffer(device, (target_rows *% HEAD_DIMENSION *% #size_of::[f32]()) as u64) else { return 1; }; let cached_rope_owner: OwnedObjc = OwnedObjc::new(cached_rope.raw());
    let rope_values: *f32 = rope.contents() as *f32;
    let cached_rope_values: *f32 = cached_rope.contents() as *f32;
    copy_index = 0 as usize;
    while copy_index < target_rows *% HEAD_DIMENSION {
        cached_rope_values[copy_index] = rope_values[prefix_rows *% HEAD_DIMENSION +% copy_index];
        copy_index = copy_index +% (1 as usize);
    }
    guard let option::Option[metal::Buffer]::Some(cached_target_mask) = new_buffer(device, target_rows as u64) else { return 1; }; let cached_target_mask_owner: OwnedObjc = OwnedObjc::new(cached_target_mask.raw());
    row = 0 as usize;
    while row < target_rows { (cached_target_mask.contents())[row] = 1 as u8; row = row +% (1 as usize); }
    let cached_workspace: BlockWorkspace = BlockWorkspace { modulation: modulation, rope: cached_rope, target_mask: cached_target_mask, image_ids: image_ids, key_valid: key_valid, dummy: dummy, norm1: norm1, query: query, key: key, value: value, query_rope: query_rope, key_rope: key_rope, attended: attended, attention_projected: attention_projected, residual1: residual1, norm2: norm2, gate: gate, projected: projected, swiglu: swiglu, mlp_projected: mlp_projected };

    var current: metal::Buffer = first_hidden;
    var next: metal::Buffer = second_hidden;
    var cached_current: metal::Buffer = cached_first_hidden;
    var cached_next: metal::Buffer = cached_second_hidden;
    var cached_total_ms: f64 = 0.0f64;
    var quantized_matrices: usize = 0 as usize;
    var block: usize = 0 as usize;
    while block < (32 as usize) {
        let prefix: text::Text = "transformer_blocks.${block}.";
        let norm_q_name: text::Text = "${prefix}attn.norm_q.weight";
        let norm_k_name: text::Text = "${prefix}attn.norm_k.weight";
        guard let option::Option[metal::Buffer]::Some(norm_q) = packed_vector_buffer(device, weight_file, norm_q_name.view(), HEAD_DIMENSION as u64) else { return 1; }; let norm_q_owner: OwnedObjc = OwnedObjc::new(norm_q.raw());
        guard let option::Option[metal::Buffer]::Some(norm_k) = packed_vector_buffer(device, weight_file, norm_k_name.view(), HEAD_DIMENSION as u64) else { return 1; }; let norm_k_owner: OwnedObjc = OwnedObjc::new(norm_k.raw());
        let q_name: text::Text = "${prefix}attn.to_q.weight"; let k_name: text::Text = "${prefix}attn.to_k.weight"; let v_name: text::Text = "${prefix}attn.to_v.weight";
        let attention_output_name: text::Text = "${prefix}attn.to_out.0.weight"; let gate_name: text::Text = "${prefix}img_mlp.gate_layer.weight"; let projected_name: text::Text = "${prefix}img_mlp.proj.weight"; let mlp_output_name: text::Text = "${prefix}img_mlp.out.weight";
        guard let option::Option[LinearWeight]::Some(q) = packed_linear_weight(weight_file, storage, q_name.view(), WIDTH as u64, WIDTH as u64) else { return 1; };
        guard let option::Option[LinearWeight]::Some(k) = packed_linear_weight(weight_file, storage, k_name.view(), WIDTH as u64, WIDTH as u64) else { return 1; };
        guard let option::Option[LinearWeight]::Some(v) = packed_linear_weight(weight_file, storage, v_name.view(), WIDTH as u64, WIDTH as u64) else { return 1; };
        guard let option::Option[LinearWeight]::Some(attention_output) = packed_linear_weight(weight_file, storage, attention_output_name.view(), WIDTH as u64, WIDTH as u64) else { return 1; };
        guard let option::Option[LinearWeight]::Some(gate_weight) = packed_linear_weight(weight_file, storage, gate_name.view(), MLP_WIDTH as u64, WIDTH as u64) else { return 1; };
        guard let option::Option[LinearWeight]::Some(projected_weight) = packed_linear_weight(weight_file, storage, projected_name.view(), MLP_WIDTH as u64, WIDTH as u64) else { return 1; };
        guard let option::Option[LinearWeight]::Some(mlp_output) = packed_linear_weight(weight_file, storage, mlp_output_name.view(), WIDTH as u64, MLP_WIDTH as u64) else { return 1; };
        let block_quantized: usize = (if q.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize }) +% (if k.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize }) +% (if v.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize }) +% (if attention_output.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize }) +% (if gate_weight.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize }) +% (if projected_weight.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize }) +% (if mlp_output.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize });
        quantized_matrices = quantized_matrices +% block_quantized;
        let block_weights: BlockWeights = BlockWeights { norm_q: norm_q, norm_k: norm_k, q: q, k: k, v: v, attention_output: attention_output, gate: gate_weight, projected: projected_weight, mlp_output: mlp_output };
        let cache_offset: u64 = block as u64 *% per_block_cache_bytes;
        guard let option::Option[f64]::Some(block_ms) = execute_batched_runtime_block(
            queue, pipelines, block_weights, workspace, current, next, COMPLETE_ROWS,
            1 as u32, cache_copy_pipeline, cache_key_arena, cache_value_arena,
            cache_offset, prefix_rows,
        ) else { return 1; };
        total_ms = total_ms + block_ms;
        guard let option::Option[f64]::Some(cached_block_ms) = execute_batched_runtime_block(
            queue, pipelines, block_weights, cached_workspace, cached_current, cached_next,
            target_rows, 2 as u32, cache_copy_pipeline, cache_key_arena,
            cache_value_arena, cache_offset, prefix_rows,
        ) else { return 1; };
        cached_total_ms = cached_total_ms + cached_block_ms;
        let capture_name: str = captured_block_name(block);
        if capture_name.count() > (0 as usize) {
            guard let option::Option[f64]::Some(error) = normalized_rms_fixture(next, fixture_directory, capture_name, COMPLETE_ROWS *% WIDTH) else { return 1; };
            let cached_error: f64 = normalized_rms_buffers(
                cached_next, 0 as usize, next, prefix_rows *% WIDTH, target_rows *% WIDTH,
            );
            io::println("complete transformer block ${block}: q8=${block_quantized} gpu_ms=${block_ms} nRMSE=${error} cached_target_nRMSE=${cached_error}");
            all_ok = cached_error <= 0.00001f64 && all_ok;
            if block == (31 as usize) { all_ok = error <= 0.012f64 && all_ok; }
        }
        let swap: metal::Buffer = current; current = next; next = swap;
        let cached_swap: metal::Buffer = cached_current; cached_current = cached_next; cached_next = cached_swap;
        block = block +% (1 as usize);
    }

    guard let option::Option[metal::Buffer]::Some(final_scale) = new_buffer(device, ((2 as usize) *% WIDTH *% #size_of::[f32]()) as u64) else { return 1; }; let final_scale_owner: OwnedObjc = OwnedObjc::new(final_scale.raw());
    guard let option::Option[f64]::Some(final_scale_ms) = dispatch_weighted_linear(queue, pipelines, activated_time, final_scale_weight, final_scale, WIDTH, WIDTH, 2) else { return 1; }; total_ms = total_ms + final_scale_ms;
    guard let option::Option[metal::Buffer]::Some(final_normalized) = new_buffer(device, activation_bytes) else { return 1; }; let final_normalized_owner: OwnedObjc = OwnedObjc::new(final_normalized.raw());
    params.rows = COMPLETE_ROWS as u32; params.width = WIDTH as u32;
    guard let option::Option[f64]::Some(final_norm_ms) = dispatch_1d(queue, final_norm_pipeline, current, final_scale, final_normalized, target_mask, dummy, dummy, #addr_of(params), COMPLETE_ROWS) else { return 1; }; total_ms = total_ms + final_norm_ms;
    guard let option::Option[f64]::Some(final_norm_error) = normalized_rms_fixture(final_normalized, fixture_directory, "final_normalized", COMPLETE_ROWS *% WIDTH) else { return 1; };
    guard let option::Option[metal::Buffer]::Some(output) = new_buffer(device, (COMPLETE_ROWS *% IMAGE_CHANNELS *% #size_of::[f32]()) as u64) else { return 1; }; let output_owner: OwnedObjc = OwnedObjc::new(output.raw());
    guard let option::Option[f64]::Some(output_ms) = dispatch_weighted_linear(queue, pipelines, final_normalized, proj_out_weight, output, IMAGE_CHANNELS, WIDTH, COMPLETE_ROWS) else { return 1; }; total_ms = total_ms + output_ms;
    guard let option::Option[metal::Buffer]::Some(cached_final_normalized) = new_buffer(device, target_activation_bytes) else { return 1; }; let cached_final_normalized_owner: OwnedObjc = OwnedObjc::new(cached_final_normalized.raw());
    params.rows = target_rows as u32;
    guard let option::Option[f64]::Some(cached_final_norm_ms) = dispatch_1d(queue, final_norm_pipeline, cached_current, final_scale, cached_final_normalized, cached_target_mask, dummy, dummy, #addr_of(params), target_rows) else { return 1; }; cached_total_ms = cached_total_ms + cached_final_norm_ms;
    guard let option::Option[metal::Buffer]::Some(cached_output) = new_buffer(device, (target_rows *% IMAGE_CHANNELS *% #size_of::[f32]()) as u64) else { return 1; }; let cached_output_owner: OwnedObjc = OwnedObjc::new(cached_output.raw());
    guard let option::Option[f64]::Some(cached_output_ms) = dispatch_weighted_linear(queue, pipelines, cached_final_normalized, proj_out_weight, cached_output, IMAGE_CHANNELS, WIDTH, target_rows) else { return 1; }; cached_total_ms = cached_total_ms + cached_output_ms;
    let cached_output_error: f64 = normalized_rms_buffers(
        cached_output, 0 as usize, output, prefix_rows *% IMAGE_CHANNELS,
        target_rows *% IMAGE_CHANNELS,
    );
    guard let option::Option[f64]::Some(final_error) = normalized_rms_fixture(output, fixture_directory, "output", COMPLETE_ROWS *% IMAGE_CHANNELS) else { return 1; };
    guard let option::Option[f64]::Some(target_error) = normalized_rms_fixture_slice(output, fixture_directory, "output", (7 as usize) *% IMAGE_CHANNELS, (8 as usize) *% IMAGE_CHANNELS) else { return 1; };
    all_ok = finite("complete transformer output", output, COMPLETE_ROWS *% IMAGE_CHANNELS) && finite("cached target output", cached_output, target_rows *% IMAGE_CHANNELS) && target_error <= 0.012f64 && cached_output_error <= 0.00001f64 && all_ok;
    if quantized_matrices != (40 as usize) { io::eprintln("complete transformer: expected 40 Q8 matrices, found ${quantized_matrices}"); return 1; }
    io::println("complete transformer: rows=${COMPLETE_ROWS} q8=${quantized_matrices} total_gpu_ms=${total_ms} final_norm_nRMSE=${final_norm_error} all_output_nRMSE=${final_error} target_output_nRMSE=${target_error}");
    io::println("complete transformer cache: prefix_rows=${prefix_rows} target_rows=${target_rows} cache_bytes=${(2 as u64) *% cache_arena_bytes} cached_gpu_ms=${cached_total_ms} cached_output_nRMSE=${cached_output_error}");
    if all_ok { io::println("Qwen-Image-2.1 complete transformer boundary: verified"); return 0; }
    return 1;
}

fn scale_capture_name(block: usize) -> str {
    if block == (0 as usize) { return "block_00_sample"; }
    if block == (1 as usize) { return "block_01_sample"; }
    if block == (7 as usize) { return "block_07_sample"; }
    if block == (15 as usize) { return "block_15_sample"; }
    if block == (31 as usize) { return "block_31_sample"; }
    return "";
}

fn run_scale_packed(
    packed_path: str,
    pixels: str,
    fixture_root: str = "tests/fixtures/transformer_scale_fp32",
) -> i32 {
    var text_rows: usize = 0 as usize;
    var target_rows: usize = 0 as usize;
    if pixels == "256" {
        text_rows = 22 as usize;
        target_rows = 256 as usize;
    } else if pixels == "512" {
        text_rows = 58 as usize;
        target_rows = 1024 as usize;
    } else if pixels == "1024" {
        text_rows = 31 as usize;
        target_rows = 4096 as usize;
    } else {
        io::eprintln("scale transformer: pixels must be 256, 512, or 1024");
        return 2;
    }
    let fixture_directory_text: text::Text = "${fixture_root}/${pixels}";
    let fixture_directory: str = fixture_directory_text.view();
    let rows: usize = text_rows +% target_rows;
    let sample_count: usize = 32 as usize;
    guard let packed::LoadResult::Ok(weight_file) = packed::load(packed_path) else {
        io::eprintln("scale transformer: could not load validated packed file ${packed_path}");
        return 1;
    };

    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return 1; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    let device_pointer: *u8 = MTLCreateSystemDefaultDevice();
    if device_pointer.is_null() { return 1; }
    let device_owner: OwnedObjc = OwnedObjc::new(rt::retain(device_pointer));
    let device: metal::Device = metal::Device::from_raw(device_owner.raw());
    guard let option::Option[metal::CommandQueue]::Some(queue) = device.new_command_queue() else { return 1; };
    let queue_owner: OwnedObjc = OwnedObjc::new(queue.raw());
    let options_pointer: *u8 = rt::alloc_init(#str_ptr("MTLCompileOptions\0"));
    if options_pointer.is_null() { return 1; }
    let options_owner: OwnedObjc = OwnedObjc::new(options_pointer);
    let options: metal::CompileOptions = metal::CompileOptions::from_raw(options_owner.raw());
    options.set_fast_math_enabled(false);
    var compile_error: *u8 = 0 as *u8;
    guard let option::Option[metal::Library]::Some(library) = device.new_library_with_source(
        #include_str("../kernels/transformer_block.metal"), options, #addr_of(compile_error) as *u8,
    ) else {
        if !compile_error.is_null() {
            let description: *u8 = rt::msg_id(compile_error, rt::sel(#str_ptr("localizedDescription\0")));
            io::eprintln("scale transformer Metal compile: ${bridge::to_text(description)}");
        }
        return 1;
    };
    let library_owner: OwnedObjc = OwnedObjc::new(library.raw());
    guard let option::Option[OwnedObjc]::Some(dense_owner) = pipeline(device, library, "qi_block_linear_32x32") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(int8_owner) = pipeline(device, library, "qi_block_int8_affine_linear_32x32") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(norm_owner) = pipeline(device, library, "qi_block_layernorm_modulate") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(qk_owner) = pipeline(device, library, "qi_block_qk_norm_rope") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(attention_owner) = pipeline(device, library, "qi_block_attention") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(residual_owner) = pipeline(device, library, "qi_block_residual") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(swiglu_owner) = pipeline(device, library, "qi_block_swiglu") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(time_owner) = pipeline(device, library, "qi_time_projection") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(silu_owner) = pipeline(device, library, "qi_silu") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(gelu_owner) = pipeline(device, library, "qi_gelu_tanh") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(text_norm_owner) = pipeline(device, library, "qi_zero_center_rms_norm") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(assemble_owner) = pipeline(device, library, "qi_joint_assemble") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(final_norm_owner) = pipeline(device, library, "qi_final_layernorm_modulate") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(cache_copy_owner) = pipeline(device, library, "qi_copy_prefix_kv") else { return 1; };
    let pipelines: Pipelines = Pipelines {
        dense_linear: metal::ComputePipelineState::from_raw(dense_owner.raw()),
        int8_linear: metal::ComputePipelineState::from_raw(int8_owner.raw()),
        norm: metal::ComputePipelineState::from_raw(norm_owner.raw()),
        qk: metal::ComputePipelineState::from_raw(qk_owner.raw()),
        attention: metal::ComputePipelineState::from_raw(attention_owner.raw()),
        residual: metal::ComputePipelineState::from_raw(residual_owner.raw()),
        swiglu: metal::ComputePipelineState::from_raw(swiglu_owner.raw()),
    };
    let time_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(time_owner.raw());
    let silu_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(silu_owner.raw());
    let gelu_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(gelu_owner.raw());
    let text_norm_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(text_norm_owner.raw());
    let assemble_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(assemble_owner.raw());
    let final_norm_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(final_norm_owner.raw());
    let cache_copy_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(cache_copy_owner.raw());

    guard let option::Option[metal::Buffer]::Some(storage) = packed_storage_buffer(device, weight_file) else { return 1; };
    let storage_owner: OwnedObjc = OwnedObjc::new(storage.raw());
    guard let option::Option[LinearWeight]::Some(img_in_weight) = packed_linear_weight(weight_file, storage, "img_in.weight", WIDTH as u64, IMAGE_CHANNELS as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(text_in_weight) = packed_linear_weight(weight_file, storage, "txt_in.in_layer.weight", WIDTH as u64, WIDTH as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(text_out_weight) = packed_linear_weight(weight_file, storage, "txt_in.out_layer.weight", WIDTH as u64, WIDTH as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(time_1_weight) = packed_linear_weight(weight_file, storage, "time_text_embed.timestep_embedder.linear_1.weight", WIDTH as u64, 256 as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(time_2_weight) = packed_linear_weight(weight_file, storage, "time_text_embed.timestep_embedder.linear_2.weight", WIDTH as u64, WIDTH as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(modulation_weight) = packed_linear_weight(weight_file, storage, "modulation.1.weight", ((4 as usize) *% WIDTH) as u64, WIDTH as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(final_scale_weight) = packed_linear_weight(weight_file, storage, "norm_out.linear.weight", WIDTH as u64, WIDTH as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(proj_out_weight) = packed_linear_weight(weight_file, storage, "proj_out.weight", IMAGE_CHANNELS as u64, WIDTH as u64) else { return 1; };
    guard let option::Option[metal::Buffer]::Some(text_norm_weight) = packed_vector_buffer(device, weight_file, "txt_in.text_norm.weight", WIDTH as u64) else { return 1; };
    let text_norm_weight_owner: OwnedObjc = OwnedObjc::new(text_norm_weight.raw());

    let activation_bytes: u64 = (rows *% WIDTH *% #size_of::[f32]()) as u64;
    let text_bytes: u64 = (text_rows *% WIDTH *% #size_of::[f32]()) as u64;
    let image_input_bytes: u64 = (target_rows *% IMAGE_CHANNELS *% #size_of::[f32]()) as u64;
    let image_projected_bytes: u64 = (target_rows *% WIDTH *% #size_of::[f32]()) as u64;
    let mlp_bytes: u64 = (rows *% MLP_WIDTH *% #size_of::[f32]()) as u64;
    let per_block_cache_bytes: u64 = (text_rows *% WIDTH *% #size_of::[f32]()) as u64;
    let cache_arena_bytes: u64 = (32 as u64) *% per_block_cache_bytes;
    let working_bytes: u64 = image_input_bytes +% text_bytes +% image_projected_bytes +%
        (4 as u64) *% text_bytes +% (14 as u64) *% activation_bytes +%
        (3 as u64) *% mlp_bytes +% (2 as u64) *% cache_arena_bytes +%
        (rows *% HEAD_DIMENSION *% #size_of::[f32]()) as u64 +%
        (rows *% IMAGE_CHANNELS *% #size_of::[f32]()) as u64 +% (4 as u64) *% 1024 as u64 *% 1024 as u64;
    let working_limit: u64 = (2304 as u64) *% 1024 as u64 *% 1024 as u64;
    if working_bytes > working_limit {
        io::eprintln("scale transformer: declared working buffers ${working_bytes} exceed ${working_limit}");
        return 1;
    }

    guard let option::Option[metal::Buffer]::Some(dummy) = new_buffer(device, 4 as u64) else { return 1; }; let dummy_owner: OwnedObjc = OwnedObjc::new(dummy.raw());
    guard let option::Option[metal::Buffer]::Some(image_input) = fixture_buffer(device, fixture_directory, "image_input", image_input_bytes) else { return 1; }; let image_input_owner: OwnedObjc = OwnedObjc::new(image_input.raw());
    guard let option::Option[metal::Buffer]::Some(text_input) = fixture_buffer(device, fixture_directory, "text_input", text_bytes) else { return 1; }; let text_input_owner: OwnedObjc = OwnedObjc::new(text_input.raw());
    guard let option::Option[metal::Buffer]::Some(timestep) = fixture_buffer(device, fixture_directory, "timestep", ((2 as usize) *% #size_of::[f32]()) as u64) else { return 1; }; let timestep_owner: OwnedObjc = OwnedObjc::new(timestep.raw());
    guard let option::Option[metal::Buffer]::Some(rope) = fixture_buffer(device, fixture_directory, "rope", (rows *% HEAD_DIMENSION *% #size_of::[f32]()) as u64) else { return 1; }; let rope_owner: OwnedObjc = OwnedObjc::new(rope.raw());

    guard let option::Option[metal::Buffer]::Some(image_projected) = new_buffer(device, image_projected_bytes) else { return 1; }; let image_projected_owner: OwnedObjc = OwnedObjc::new(image_projected.raw());
    guard let option::Option[metal::Buffer]::Some(text_normalized) = new_buffer(device, text_bytes) else { return 1; }; let text_normalized_owner: OwnedObjc = OwnedObjc::new(text_normalized.raw());
    guard let option::Option[metal::Buffer]::Some(text_hidden) = new_buffer(device, text_bytes) else { return 1; }; let text_hidden_owner: OwnedObjc = OwnedObjc::new(text_hidden.raw());
    guard let option::Option[metal::Buffer]::Some(text_activated) = new_buffer(device, text_bytes) else { return 1; }; let text_activated_owner: OwnedObjc = OwnedObjc::new(text_activated.raw());
    guard let option::Option[metal::Buffer]::Some(text_projected) = new_buffer(device, text_bytes) else { return 1; }; let text_projected_owner: OwnedObjc = OwnedObjc::new(text_projected.raw());
    guard let option::Option[metal::Buffer]::Some(time_projection) = new_buffer(device, ((2 as usize) *% (256 as usize) *% #size_of::[f32]()) as u64) else { return 1; }; let time_projection_owner: OwnedObjc = OwnedObjc::new(time_projection.raw());
    guard let option::Option[metal::Buffer]::Some(time_hidden) = new_buffer(device, ((2 as usize) *% WIDTH *% #size_of::[f32]()) as u64) else { return 1; }; let time_hidden_owner: OwnedObjc = OwnedObjc::new(time_hidden.raw());
    guard let option::Option[metal::Buffer]::Some(time_activated_hidden) = new_buffer(device, ((2 as usize) *% WIDTH *% #size_of::[f32]()) as u64) else { return 1; }; let time_activated_hidden_owner: OwnedObjc = OwnedObjc::new(time_activated_hidden.raw());
    guard let option::Option[metal::Buffer]::Some(time_embedding) = new_buffer(device, ((2 as usize) *% WIDTH *% #size_of::[f32]()) as u64) else { return 1; }; let time_embedding_owner: OwnedObjc = OwnedObjc::new(time_embedding.raw());
    guard let option::Option[metal::Buffer]::Some(activated_time) = new_buffer(device, ((2 as usize) *% WIDTH *% #size_of::[f32]()) as u64) else { return 1; }; let activated_time_owner: OwnedObjc = OwnedObjc::new(activated_time.raw());
    guard let option::Option[metal::Buffer]::Some(modulation) = new_buffer(device, ((2 as usize) *% (4 as usize) *% WIDTH *% #size_of::[f32]()) as u64) else { return 1; }; let modulation_owner: OwnedObjc = OwnedObjc::new(modulation.raw());
    guard let option::Option[metal::Buffer]::Some(first_hidden) = new_buffer(device, activation_bytes) else { return 1; }; let first_hidden_owner: OwnedObjc = OwnedObjc::new(first_hidden.raw());
    guard let option::Option[metal::Buffer]::Some(second_hidden) = new_buffer(device, activation_bytes) else { return 1; }; let second_hidden_owner: OwnedObjc = OwnedObjc::new(second_hidden.raw());

    var params: BlockParams = BlockParams { rows: target_rows as u32, width: WIDTH as u32, heads: HEADS as u32, head_dimension: HEAD_DIMENSION as u32, epsilon: 0.000001f32, slot: 0 as u32 };
    var total_ms: f64 = 0.0f64;
    guard let option::Option[f64]::Some(img_ms) = dispatch_weighted_linear(queue, pipelines, image_input, img_in_weight, image_projected, WIDTH, IMAGE_CHANNELS, target_rows) else { return 1; }; total_ms = total_ms + img_ms;
    params.rows = text_rows as u32;
    guard let option::Option[f64]::Some(text_norm_ms) = dispatch_1d(queue, text_norm_pipeline, text_input, text_norm_weight, text_normalized, dummy, dummy, dummy, #addr_of(params), text_rows) else { return 1; }; total_ms = total_ms + text_norm_ms;
    guard let option::Option[f64]::Some(text_in_ms) = dispatch_weighted_linear(queue, pipelines, text_normalized, text_in_weight, text_hidden, WIDTH, WIDTH, text_rows) else { return 1; }; total_ms = total_ms + text_in_ms;
    guard let option::Option[f64]::Some(gelu_ms) = dispatch_1d(queue, gelu_pipeline, text_hidden, dummy, text_activated, dummy, dummy, dummy, #addr_of(params), text_rows *% WIDTH) else { return 1; }; total_ms = total_ms + gelu_ms;
    guard let option::Option[f64]::Some(text_out_ms) = dispatch_weighted_linear(queue, pipelines, text_activated, text_out_weight, text_projected, WIDTH, WIDTH, text_rows) else { return 1; }; total_ms = total_ms + text_out_ms;
    params.rows = 2 as u32; params.width = 256 as u32;
    guard let option::Option[f64]::Some(time_projection_ms) = dispatch_1d(queue, time_pipeline, timestep, dummy, time_projection, dummy, dummy, dummy, #addr_of(params), (2 as usize) *% (256 as usize)) else { return 1; }; total_ms = total_ms + time_projection_ms;
    guard let option::Option[f64]::Some(time_1_ms) = dispatch_weighted_linear(queue, pipelines, time_projection, time_1_weight, time_hidden, WIDTH, 256, 2) else { return 1; }; total_ms = total_ms + time_1_ms;
    params.width = WIDTH as u32;
    guard let option::Option[f64]::Some(time_silu_ms) = dispatch_1d(queue, silu_pipeline, time_hidden, dummy, time_activated_hidden, dummy, dummy, dummy, #addr_of(params), (2 as usize) *% WIDTH) else { return 1; }; total_ms = total_ms + time_silu_ms;
    guard let option::Option[f64]::Some(time_2_ms) = dispatch_weighted_linear(queue, pipelines, time_activated_hidden, time_2_weight, time_embedding, WIDTH, WIDTH, 2) else { return 1; }; total_ms = total_ms + time_2_ms;
    guard let option::Option[f64]::Some(activated_time_ms) = dispatch_1d(queue, silu_pipeline, time_embedding, dummy, activated_time, dummy, dummy, dummy, #addr_of(params), (2 as usize) *% WIDTH) else { return 1; }; total_ms = total_ms + activated_time_ms;
    guard let option::Option[f64]::Some(modulation_ms) = dispatch_weighted_linear(queue, pipelines, activated_time, modulation_weight, modulation, (4 as usize) *% WIDTH, WIDTH, 2) else { return 1; }; total_ms = total_ms + modulation_ms;

    guard let option::Option[metal::Buffer]::Some(source_index) = new_buffer(device, (rows *% #size_of::[i32]()) as u64) else { return 1; }; let source_index_owner: OwnedObjc = OwnedObjc::new(source_index.raw());
    let sources: *i32 = source_index.contents() as *i32;
    var row: usize = 0 as usize;
    while row < text_rows { sources[row] = 0 -% (row as i32) -% (1 as i32); row = row +% (1 as usize); }
    while row < rows { sources[row] = (row -% text_rows) as i32; row = row +% (1 as usize); }
    params.rows = rows as u32;
    guard let option::Option[f64]::Some(assemble_ms) = dispatch_1d(queue, assemble_pipeline, text_projected, image_projected, first_hidden, source_index, dummy, dummy, #addr_of(params), rows *% WIDTH) else { return 1; }; total_ms = total_ms + assemble_ms;

    guard let option::Option[metal::Buffer]::Some(target_mask) = new_buffer(device, rows as u64) else { return 1; }; let target_mask_owner: OwnedObjc = OwnedObjc::new(target_mask.raw());
    guard let option::Option[metal::Buffer]::Some(image_ids) = new_buffer(device, (rows *% #size_of::[i32]()) as u64) else { return 1; }; let image_ids_owner: OwnedObjc = OwnedObjc::new(image_ids.raw());
    guard let option::Option[metal::Buffer]::Some(key_valid) = new_buffer(device, rows as u64) else { return 1; }; let key_valid_owner: OwnedObjc = OwnedObjc::new(key_valid.raw());
    let ids: *i32 = image_ids.contents() as *i32;
    row = 0 as usize;
    while row < rows {
        (target_mask.contents())[row] = if row >= text_rows { 1 as u8 } else { 0 as u8 };
        ids[row] = if row >= text_rows { 0 as i32 } else { 0 -% (1 as i32) };
        (key_valid.contents())[row] = 1 as u8;
        row = row +% (1 as usize);
    }

    guard let option::Option[metal::Buffer]::Some(norm1) = new_buffer(device, activation_bytes) else { return 1; }; let norm1_owner: OwnedObjc = OwnedObjc::new(norm1.raw());
    guard let option::Option[metal::Buffer]::Some(query) = new_buffer(device, activation_bytes) else { return 1; }; let query_owner: OwnedObjc = OwnedObjc::new(query.raw());
    guard let option::Option[metal::Buffer]::Some(key) = new_buffer(device, activation_bytes) else { return 1; }; let key_owner: OwnedObjc = OwnedObjc::new(key.raw());
    guard let option::Option[metal::Buffer]::Some(value) = new_buffer(device, activation_bytes) else { return 1; }; let value_owner: OwnedObjc = OwnedObjc::new(value.raw());
    guard let option::Option[metal::Buffer]::Some(query_rope) = new_buffer(device, activation_bytes) else { return 1; }; let query_rope_owner: OwnedObjc = OwnedObjc::new(query_rope.raw());
    guard let option::Option[metal::Buffer]::Some(key_rope) = new_buffer(device, activation_bytes) else { return 1; }; let key_rope_owner: OwnedObjc = OwnedObjc::new(key_rope.raw());
    guard let option::Option[metal::Buffer]::Some(attended) = new_buffer(device, activation_bytes) else { return 1; }; let attended_owner: OwnedObjc = OwnedObjc::new(attended.raw());
    guard let option::Option[metal::Buffer]::Some(attention_projected) = new_buffer(device, activation_bytes) else { return 1; }; let attention_projected_owner: OwnedObjc = OwnedObjc::new(attention_projected.raw());
    guard let option::Option[metal::Buffer]::Some(residual1) = new_buffer(device, activation_bytes) else { return 1; }; let residual1_owner: OwnedObjc = OwnedObjc::new(residual1.raw());
    guard let option::Option[metal::Buffer]::Some(norm2) = new_buffer(device, activation_bytes) else { return 1; }; let norm2_owner: OwnedObjc = OwnedObjc::new(norm2.raw());
    guard let option::Option[metal::Buffer]::Some(gate) = new_buffer(device, mlp_bytes) else { return 1; }; let gate_owner: OwnedObjc = OwnedObjc::new(gate.raw());
    guard let option::Option[metal::Buffer]::Some(projected) = new_buffer(device, mlp_bytes) else { return 1; }; let projected_owner: OwnedObjc = OwnedObjc::new(projected.raw());
    guard let option::Option[metal::Buffer]::Some(swiglu) = new_buffer(device, mlp_bytes) else { return 1; }; let swiglu_buffer_owner: OwnedObjc = OwnedObjc::new(swiglu.raw());
    guard let option::Option[metal::Buffer]::Some(mlp_projected) = new_buffer(device, activation_bytes) else { return 1; }; let mlp_projected_owner: OwnedObjc = OwnedObjc::new(mlp_projected.raw());
    guard let option::Option[metal::Buffer]::Some(cache_key_arena) = new_buffer(device, cache_arena_bytes) else { return 1; }; let cache_key_arena_owner: OwnedObjc = OwnedObjc::new(cache_key_arena.raw());
    guard let option::Option[metal::Buffer]::Some(cache_value_arena) = new_buffer(device, cache_arena_bytes) else { return 1; }; let cache_value_arena_owner: OwnedObjc = OwnedObjc::new(cache_value_arena.raw());
    let workspace: BlockWorkspace = BlockWorkspace { modulation: modulation, rope: rope, target_mask: target_mask, image_ids: image_ids, key_valid: key_valid, dummy: dummy, norm1: norm1, query: query, key: key, value: value, query_rope: query_rope, key_rope: key_rope, attended: attended, attention_projected: attention_projected, residual1: residual1, norm2: norm2, gate: gate, projected: projected, swiglu: swiglu, mlp_projected: mlp_projected };

    var current: metal::Buffer = first_hidden;
    var next: metal::Buffer = second_hidden;
    var quantized_matrices: usize = 0 as usize;
    var all_ok: bool = true;
    var block: usize = 0 as usize;
    while block < (32 as usize) {
        let prefix: text::Text = "transformer_blocks.${block}.";
        let norm_q_name: text::Text = "${prefix}attn.norm_q.weight";
        let norm_k_name: text::Text = "${prefix}attn.norm_k.weight";
        guard let option::Option[metal::Buffer]::Some(norm_q) = packed_vector_buffer(device, weight_file, norm_q_name.view(), HEAD_DIMENSION as u64) else { return 1; }; let norm_q_owner: OwnedObjc = OwnedObjc::new(norm_q.raw());
        guard let option::Option[metal::Buffer]::Some(norm_k) = packed_vector_buffer(device, weight_file, norm_k_name.view(), HEAD_DIMENSION as u64) else { return 1; }; let norm_k_owner: OwnedObjc = OwnedObjc::new(norm_k.raw());
        let q_name: text::Text = "${prefix}attn.to_q.weight"; let k_name: text::Text = "${prefix}attn.to_k.weight"; let v_name: text::Text = "${prefix}attn.to_v.weight";
        let attention_output_name: text::Text = "${prefix}attn.to_out.0.weight"; let gate_name: text::Text = "${prefix}img_mlp.gate_layer.weight"; let projected_name: text::Text = "${prefix}img_mlp.proj.weight"; let mlp_output_name: text::Text = "${prefix}img_mlp.out.weight";
        guard let option::Option[LinearWeight]::Some(q) = packed_linear_weight(weight_file, storage, q_name.view(), WIDTH as u64, WIDTH as u64) else { return 1; };
        guard let option::Option[LinearWeight]::Some(k) = packed_linear_weight(weight_file, storage, k_name.view(), WIDTH as u64, WIDTH as u64) else { return 1; };
        guard let option::Option[LinearWeight]::Some(v) = packed_linear_weight(weight_file, storage, v_name.view(), WIDTH as u64, WIDTH as u64) else { return 1; };
        guard let option::Option[LinearWeight]::Some(attention_output) = packed_linear_weight(weight_file, storage, attention_output_name.view(), WIDTH as u64, WIDTH as u64) else { return 1; };
        guard let option::Option[LinearWeight]::Some(gate_weight) = packed_linear_weight(weight_file, storage, gate_name.view(), MLP_WIDTH as u64, WIDTH as u64) else { return 1; };
        guard let option::Option[LinearWeight]::Some(projected_weight) = packed_linear_weight(weight_file, storage, projected_name.view(), MLP_WIDTH as u64, WIDTH as u64) else { return 1; };
        guard let option::Option[LinearWeight]::Some(mlp_output) = packed_linear_weight(weight_file, storage, mlp_output_name.view(), WIDTH as u64, MLP_WIDTH as u64) else { return 1; };
        let block_quantized: usize = (if q.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize }) +% (if k.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize }) +% (if v.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize }) +% (if attention_output.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize }) +% (if gate_weight.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize }) +% (if projected_weight.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize }) +% (if mlp_output.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize });
        quantized_matrices = quantized_matrices +% block_quantized;
        let cache_offset: u64 = block as u64 *% per_block_cache_bytes;
        guard let option::Option[f64]::Some(block_ms) = execute_batched_runtime_block(
            queue, pipelines, BlockWeights { norm_q: norm_q, norm_k: norm_k, q: q, k: k, v: v, attention_output: attention_output, gate: gate_weight, projected: projected_weight, mlp_output: mlp_output }, workspace, current, next, rows,
            1 as u32, cache_copy_pipeline, cache_key_arena, cache_value_arena,
            cache_offset, text_rows,
        ) else { return 1; };
        total_ms = total_ms + block_ms;
        let capture_name: str = scale_capture_name(block);
        if capture_name.count() > (0 as usize) {
            guard let option::Option[f64]::Some(error) = normalized_rms_sampled_fixture(next, fixture_directory, capture_name, sample_count, rows) else {
                io::eprintln("scale transformer: missing sampled oracle ${capture_name}");
                return 1;
            };
            io::println("scale transformer ${pixels}px block ${block}: q8=${block_quantized} gpu_ms=${block_ms} sampled_nRMSE=${error}");
            all_ok = error <= 0.03f64 && finite("scale block ${block}", next, rows *% WIDTH) && all_ok;
        }
        let swap: metal::Buffer = current; current = next; next = swap;
        block = block +% (1 as usize);
    }

    guard let option::Option[metal::Buffer]::Some(final_scale) = new_buffer(device, ((2 as usize) *% WIDTH *% #size_of::[f32]()) as u64) else { return 1; }; let final_scale_owner: OwnedObjc = OwnedObjc::new(final_scale.raw());
    guard let option::Option[f64]::Some(final_scale_ms) = dispatch_weighted_linear(queue, pipelines, activated_time, final_scale_weight, final_scale, WIDTH, WIDTH, 2) else { return 1; }; total_ms = total_ms + final_scale_ms;
    guard let option::Option[metal::Buffer]::Some(final_normalized) = new_buffer(device, activation_bytes) else { return 1; }; let final_normalized_owner: OwnedObjc = OwnedObjc::new(final_normalized.raw());
    params.rows = rows as u32; params.width = WIDTH as u32;
    guard let option::Option[f64]::Some(final_norm_ms) = dispatch_1d(queue, final_norm_pipeline, current, final_scale, final_normalized, target_mask, dummy, dummy, #addr_of(params), rows) else { return 1; }; total_ms = total_ms + final_norm_ms;
    guard let option::Option[metal::Buffer]::Some(output) = new_buffer(device, (rows *% IMAGE_CHANNELS *% #size_of::[f32]()) as u64) else { return 1; }; let output_owner: OwnedObjc = OwnedObjc::new(output.raw());
    guard let option::Option[f64]::Some(output_ms) = dispatch_weighted_linear(queue, pipelines, final_normalized, proj_out_weight, output, IMAGE_CHANNELS, WIDTH, rows) else { return 1; }; total_ms = total_ms + output_ms;
    guard let option::Option[f64]::Some(output_error) = normalized_rms_fixture_actual_slice(
        output, text_rows *% IMAGE_CHANNELS, fixture_directory, "output", target_rows *% IMAGE_CHANNELS,
    ) else { return 1; };
    all_ok = output_error <= 0.015f64 && finite("scale transformer output", output, rows *% IMAGE_CHANNELS) && all_ok;
    if quantized_matrices != (40 as usize) { io::eprintln("scale transformer: expected 40 Q8 matrices, found ${quantized_matrices}"); return 1; }
    io::println("scale transformer: pixels=${pixels} text_rows=${text_rows} target_rows=${target_rows} joint_rows=${rows} q8=${quantized_matrices} working_bytes=${working_bytes} cache_bytes=${(2 as u64) *% cache_arena_bytes} total_gpu_ms=${total_ms} target_output_nRMSE=${output_error}");
    if all_ok { io::println("Qwen-Image-2.1 ${pixels}px full noise prediction: verified"); return 0; }
    return 1;
}

fn fill_target_rope_256(destination: *f32, text_rows: usize) -> bool {
    if destination.is_null() { return false; }
    let side: usize = 16 as usize;
    let target_rows: usize = side *% side;
    let rows: usize = text_rows +% target_rows;
    let theta_log: f32 = (10000.0f32).ln();
    var row: usize = 0 as usize;
    while row < rows {
        let is_image: bool = row >= text_rows;
        let image_row: usize = if is_image { row -% text_rows } else { 0 as usize };
        let frame_position: i32 = if is_image { text_rows as i32 } else { row as i32 };
        let height_position: i32 = if is_image {
            (image_row / side) as i32 - (8 as i32)
        } else {
            row as i32
        };
        let width_position: i32 = if is_image {
            (image_row % side) as i32 - (8 as i32)
        } else {
            row as i32
        };
        let positions: [i32; 3] = [frame_position, height_position, width_position];
        let dimensions: [usize; 3] = [16 as usize, 56 as usize, 56 as usize];
        var complex_offset: usize = 0 as usize;
        var axis: usize = 0 as usize;
        while axis < (3 as usize) {
            let dimension: usize = dimensions[axis];
            let complex_count: usize = dimension / (2 as usize);
            var pair: usize = 0 as usize;
            while pair < complex_count {
                let exponent: f32 = (0.0f32 - theta_log) * ((2 as usize) *% pair) as f32
                    / dimension as f32;
                let angle: f32 = positions[axis] as f32 * exponent.exp();
                let output_index: usize = row *% HEAD_DIMENSION +% complex_offset +% pair;
                destination[output_index] = angle.cos();
                destination[output_index +% (HEAD_DIMENSION / (2 as usize))] = angle.sin();
                pair = pair +% (1 as usize);
            }
            complex_offset = complex_offset +% complex_count;
            axis = axis +% (1 as usize);
        }
        row = row +% (1 as usize);
    }
    return true;
}

fn fill_seeded_latent(destination: *f32, count: usize, seed: u64) -> bool {
    if !random::torch_randn_f32(destination, count, seed) { return false; }
    var index: usize = 0 as usize;
    while index < count {
        destination[index] = cpu::bf16_to_f32(cpu::f32_to_bf16(destination[index]));
        index = index +% (1 as usize);
    }
    return true;
}

fn host_normalized_rms(actual: *f32, expected: *f32, count: usize) -> f64 {
    var squared_error: f64 = 0.0f64;
    var squared_reference: f64 = 0.0f64;
    var index: usize = 0 as usize;
    while index < count {
        let difference: f64 = actual[index] as f64 - expected[index] as f64;
        squared_error = squared_error + difference * difference;
        squared_reference = squared_reference + expected[index] as f64 * expected[index] as f64;
        index = index +% (1 as usize);
    }
    return (squared_error / squared_reference.max(0.000000000001f64)).sqrt();
}

fn test_native_inputs_256(
    fixture_directory: str = "tests/fixtures/trajectory_256_fp32",
) -> i32 {
    let text_rows: usize = 22 as usize;
    let target_rows: usize = 256 as usize;
    let latent_count: usize = target_rows *% IMAGE_CHANNELS;
    let rope_count: usize = (text_rows +% target_rows) *% HEAD_DIMENSION;
    var noise: [f32; 16384] = [0.0f32; 16384];
    var rope: [f32; 35584] = [0.0f32; 35584];
    if !fill_seeded_latent(#addr_of(noise[0]), latent_count, 1101 as u64)
        || !fill_target_rope_256(#addr_of(rope[0]), text_rows) {
        return 1;
    }
    let noise_path: text::Text = "${fixture_directory}/image_input.f32";
    let rope_path: text::Text = "${fixture_directory}/rope.f32";
    guard let mapped::MapResult::Ok(expected_noise) = mapped::map_readonly(noise_path.view()) else {
        return 1;
    };
    guard let mapped::MapResult::Ok(expected_rope) = mapped::map_readonly(rope_path.view()) else {
        return 1;
    };
    if expected_noise.length() != latent_count *% #size_of::[f32]()
        || expected_rope.length() != rope_count *% #size_of::[f32]() {
        return 1;
    }
    let noise_error: f64 = host_normalized_rms(
        #addr_of(noise[0]),
        expected_noise.pointer() as *f32,
        latent_count,
    );
    let rope_error: f64 = host_normalized_rms(
        #addr_of(rope[0]),
        expected_rope.pointer() as *f32,
        rope_count,
    );
    io::println("native inputs: seed=1101 noise_nRMSE=${noise_error} rope_nRMSE=${rope_error}");
    if noise_error <= (0.000001f64) && rope_error <= (0.000001f64) {
        io::println("PyTorch-compatible noise and dynamic Qwen-Image RoPE: verified");
        return 0;
    }
    return 1;
}

fn run_trajectory_packed(
    packed_path: str,
    requested_steps: str,
    fixture_directory: str = "tests/fixtures/trajectory_256_fp32",
) -> i32 {
    return run_trajectory_packed_impl(
        packed_path,
        requested_steps,
        fixture_directory,
        0 as *f32,
        0 as *f32,
        0 as usize,
        0 as u64,
        false,
        true,
    );
}

// Runs the canonical 40-step 256px trajectory and copies the final
// BF16-rounded normalized latent into caller-owned memory. All Metal resources
// and the 12.42 GiB packed mapping are released when this function returns, so
// the caller can begin the VAE memory phase without overlapping model weights.
fn run_trajectory_256_to_host(
    packed_path: str,
    final_latent: *f32,
    fixture_directory: str = "tests/fixtures/trajectory_256_fp32",
) -> i32 {
    if final_latent.is_null() {
        io::eprintln("trajectory: final latent destination is null");
        return 2;
    }
    return run_trajectory_packed_impl(
        packed_path,
        "40",
        fixture_directory,
        final_latent,
        0 as *f32,
        0 as usize,
        0 as u64,
        false,
        true,
    );
}

// Runs a native-prompt 256px trajectory. The text encoder and transformer are
// deliberately separate calls so their 17.5 GB and 12.4 GB mappings never
// overlap on a 32 GB machine.
fn run_prompt_trajectory_256_to_host(
    packed_path: str,
    text_input: *f32,
    text_rows: usize,
    seed: u64,
    final_latent: *f32,
    validate_reference: bool = false,
    fixture_directory: str = "tests/fixtures/trajectory_256_fp32",
) -> i32 {
    if text_input.is_null() || final_latent.is_null() {
        io::eprintln("trajectory: native prompt handoff received a null buffer");
        return 2;
    }
    return run_trajectory_packed_impl(
        packed_path,
        "40",
        fixture_directory,
        final_latent,
        text_input,
        text_rows,
        seed,
        true,
        validate_reference,
    );
}

fn run_trajectory_packed_impl(
    packed_path: str,
    requested_steps: str,
    fixture_directory: str,
    final_latent: *f32,
    native_text_input: *f32,
    native_text_rows: usize,
    latent_seed: u64,
    native_inputs: bool,
    validate_reference: bool,
) -> i32 {
    var step_limit: usize = 0 as usize;
    if requested_steps == "1" {
        step_limit = 1 as usize;
    } else if requested_steps == "2" {
        step_limit = 2 as usize;
    } else if requested_steps == "40" {
        step_limit = 40 as usize;
    } else {
        io::eprintln("trajectory: steps must be 1, 2, or 40");
        return 2;
    }
    let text_rows: usize = if native_inputs { native_text_rows } else { 22 as usize };
    if text_rows == (0 as usize) || text_rows > (512 as usize) {
        io::eprintln("trajectory: text row count must be 1..512, got ${text_rows}");
        return 2;
    }
    let target_rows: usize = 256 as usize;
    let rows: usize = text_rows +% target_rows;
    let latent_count: usize = target_rows *% IMAGE_CHANNELS;
    var sigmas: [f32; 41] = [0.0f32; 41];
    var timesteps: [f32; 40] = [0.0f32; 40];
    if !flow::fill_schedule(
        40 as usize,
        target_rows,
        #addr_of(sigmas[0]),
        #addr_of(timesteps[0]),
    ) {
        io::eprintln("trajectory: could not construct the 40-step FlowMatch schedule");
        return 1;
    }
    guard let packed::LoadResult::Ok(weight_file) = packed::load(packed_path) else {
        io::eprintln("trajectory: could not load validated packed file ${packed_path}");
        return 1;
    };

    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return 1; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    let device_pointer: *u8 = MTLCreateSystemDefaultDevice();
    if device_pointer.is_null() { return 1; }
    let device_owner: OwnedObjc = OwnedObjc::new(rt::retain(device_pointer));
    let device: metal::Device = metal::Device::from_raw(device_owner.raw());
    guard let option::Option[metal::CommandQueue]::Some(queue) = device.new_command_queue() else { return 1; };
    let queue_owner: OwnedObjc = OwnedObjc::new(queue.raw());
    let options_pointer: *u8 = rt::alloc_init(#str_ptr("MTLCompileOptions\0"));
    if options_pointer.is_null() { return 1; }
    let options_owner: OwnedObjc = OwnedObjc::new(options_pointer);
    let options: metal::CompileOptions = metal::CompileOptions::from_raw(options_owner.raw());
    options.set_fast_math_enabled(false);
    var compile_error: *u8 = 0 as *u8;
    guard let option::Option[metal::Library]::Some(library) = device.new_library_with_source(
        #include_str("../kernels/transformer_block.metal"), options, #addr_of(compile_error) as *u8,
    ) else {
        if !compile_error.is_null() {
            let description: *u8 = rt::msg_id(compile_error, rt::sel(#str_ptr("localizedDescription\0")));
            io::eprintln("trajectory Metal compile: ${bridge::to_text(description)}");
        }
        return 1;
    };
    let library_owner: OwnedObjc = OwnedObjc::new(library.raw());
    guard let option::Option[OwnedObjc]::Some(dense_owner) = pipeline(device, library, "qi_block_linear_32x32") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(int8_owner) = pipeline(device, library, "qi_block_int8_affine_linear_32x32") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(norm_owner) = pipeline(device, library, "qi_block_layernorm_modulate") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(qk_owner) = pipeline(device, library, "qi_block_qk_norm_rope") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(attention_owner) = pipeline(device, library, "qi_block_attention") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(residual_owner) = pipeline(device, library, "qi_block_residual") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(swiglu_owner) = pipeline(device, library, "qi_block_swiglu") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(time_owner) = pipeline(device, library, "qi_time_projection") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(silu_owner) = pipeline(device, library, "qi_silu") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(gelu_owner) = pipeline(device, library, "qi_gelu_tanh") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(text_norm_owner) = pipeline(device, library, "qi_zero_center_rms_norm") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(assemble_owner) = pipeline(device, library, "qi_joint_assemble") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(final_norm_owner) = pipeline(device, library, "qi_final_layernorm_modulate") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(cache_copy_owner) = pipeline(device, library, "qi_copy_prefix_kv") else { return 1; };
    let pipelines: Pipelines = Pipelines {
        dense_linear: metal::ComputePipelineState::from_raw(dense_owner.raw()),
        int8_linear: metal::ComputePipelineState::from_raw(int8_owner.raw()),
        norm: metal::ComputePipelineState::from_raw(norm_owner.raw()),
        qk: metal::ComputePipelineState::from_raw(qk_owner.raw()),
        attention: metal::ComputePipelineState::from_raw(attention_owner.raw()),
        residual: metal::ComputePipelineState::from_raw(residual_owner.raw()),
        swiglu: metal::ComputePipelineState::from_raw(swiglu_owner.raw()),
    };
    let time_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(time_owner.raw());
    let silu_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(silu_owner.raw());
    let gelu_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(gelu_owner.raw());
    let text_norm_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(text_norm_owner.raw());
    let assemble_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(assemble_owner.raw());
    let final_norm_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(final_norm_owner.raw());
    let cache_copy_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(cache_copy_owner.raw());

    guard let option::Option[metal::Buffer]::Some(storage) = packed_storage_buffer(device, weight_file) else { return 1; };
    let storage_owner: OwnedObjc = OwnedObjc::new(storage.raw());
    guard let option::Option[LinearWeight]::Some(img_in_weight) = packed_linear_weight(weight_file, storage, "img_in.weight", WIDTH as u64, IMAGE_CHANNELS as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(text_in_weight) = packed_linear_weight(weight_file, storage, "txt_in.in_layer.weight", WIDTH as u64, WIDTH as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(text_out_weight) = packed_linear_weight(weight_file, storage, "txt_in.out_layer.weight", WIDTH as u64, WIDTH as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(time_1_weight) = packed_linear_weight(weight_file, storage, "time_text_embed.timestep_embedder.linear_1.weight", WIDTH as u64, 256 as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(time_2_weight) = packed_linear_weight(weight_file, storage, "time_text_embed.timestep_embedder.linear_2.weight", WIDTH as u64, WIDTH as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(modulation_weight) = packed_linear_weight(weight_file, storage, "modulation.1.weight", ((4 as usize) *% WIDTH) as u64, WIDTH as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(final_scale_weight) = packed_linear_weight(weight_file, storage, "norm_out.linear.weight", WIDTH as u64, WIDTH as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(proj_out_weight) = packed_linear_weight(weight_file, storage, "proj_out.weight", IMAGE_CHANNELS as u64, WIDTH as u64) else { return 1; };
    guard let option::Option[metal::Buffer]::Some(text_norm_weight) = packed_vector_buffer(device, weight_file, "txt_in.text_norm.weight", WIDTH as u64) else { return 1; };
    let text_norm_weight_owner: OwnedObjc = OwnedObjc::new(text_norm_weight.raw());

    let activation_bytes: u64 = (rows *% WIDTH *% #size_of::[f32]()) as u64;
    let text_bytes: u64 = (text_rows *% WIDTH *% #size_of::[f32]()) as u64;
    let image_input_bytes: u64 = (latent_count *% #size_of::[f32]()) as u64;
    let image_projected_bytes: u64 = (target_rows *% WIDTH *% #size_of::[f32]()) as u64;
    let mlp_bytes: u64 = (rows *% MLP_WIDTH *% #size_of::[f32]()) as u64;
    let per_block_cache_bytes: u64 = (text_rows *% WIDTH *% #size_of::[f32]()) as u64;
    let cache_arena_bytes: u64 = (32 as u64) *% per_block_cache_bytes;

    guard let option::Option[metal::Buffer]::Some(dummy) = new_buffer(device, 4 as u64) else { return 1; }; let dummy_owner: OwnedObjc = OwnedObjc::new(dummy.raw());
    guard let option::Option[metal::Buffer]::Some(latents) = if native_inputs {
        new_buffer(device, image_input_bytes)
    } else {
        fixture_buffer(device, fixture_directory, "image_input", image_input_bytes)
    } else { return 1; };
    let latents_owner: OwnedObjc = OwnedObjc::new(latents.raw());
    if native_inputs && !fill_seeded_latent(latents.contents() as *f32, latent_count, latent_seed) {
        io::eprintln("trajectory: could not generate the seeded latent");
        return 1;
    }
    guard let option::Option[metal::Buffer]::Some(text_input) = if native_inputs {
        device.new_buffer_with_bytes(
            native_text_input as *u8,
            text_bytes,
            metal::resource_options_m_t_l_resource_storage_mode_shared,
        )
    } else {
        fixture_buffer(device, fixture_directory, "text_input", text_bytes)
    } else { return 1; };
    let text_input_owner: OwnedObjc = OwnedObjc::new(text_input.raw());
    let rope_bytes: u64 = (rows *% HEAD_DIMENSION *% #size_of::[f32]()) as u64;
    guard let option::Option[metal::Buffer]::Some(rope) = if native_inputs {
        new_buffer(device, rope_bytes)
    } else {
        fixture_buffer(device, fixture_directory, "rope", rope_bytes)
    } else { return 1; };
    let rope_owner: OwnedObjc = OwnedObjc::new(rope.raw());
    if native_inputs && !fill_target_rope_256(rope.contents() as *f32, text_rows) {
        io::eprintln("trajectory: could not construct dynamic RoPE");
        return 1;
    }
    if validate_reference {
        guard let option::Option[metal::Buffer]::Some(expected_sigmas) = fixture_buffer(device, fixture_directory, "sigmas", ((41 as usize) *% #size_of::[f32]()) as u64) else { return 1; };
        let expected_sigmas_owner: OwnedObjc = OwnedObjc::new(expected_sigmas.raw());
        guard let option::Option[metal::Buffer]::Some(expected_timesteps) = fixture_buffer(device, fixture_directory, "timesteps", ((40 as usize) *% #size_of::[f32]()) as u64) else { return 1; };
        let expected_timesteps_owner: OwnedObjc = OwnedObjc::new(expected_timesteps.raw());
        let sigma_reference: *f32 = expected_sigmas.contents() as *f32;
        let timestep_reference: *f32 = expected_timesteps.contents() as *f32;
        var schedule_index: usize = 0 as usize;
        while schedule_index < (40 as usize) {
            if (sigmas[schedule_index] - sigma_reference[schedule_index]).abs() > 0.000002f32
                || (timesteps[schedule_index] - timestep_reference[schedule_index]).abs() > 0.002f32 {
                io::eprintln("trajectory: scheduler mismatch at step ${schedule_index}");
                return 1;
            }
            schedule_index = schedule_index +% (1 as usize);
        }
        if sigmas[40] != sigma_reference[40] {
            io::eprintln("trajectory: scheduler endpoint mismatch");
            return 1;
        }
        if native_inputs {
            guard let option::Option[metal::Buffer]::Some(expected_noise) = fixture_buffer(device, fixture_directory, "image_input", image_input_bytes) else { return 1; };
            let expected_noise_owner: OwnedObjc = OwnedObjc::new(expected_noise.raw());
            let noise_error: f64 = normalized_rms_buffers(latents, 0 as usize, expected_noise, 0 as usize, latent_count);
            guard let option::Option[metal::Buffer]::Some(expected_rope) = fixture_buffer(device, fixture_directory, "rope", rope_bytes) else { return 1; };
            let expected_rope_owner: OwnedObjc = OwnedObjc::new(expected_rope.raw());
            let rope_error: f64 = normalized_rms_buffers(rope, 0 as usize, expected_rope, 0 as usize, rows *% HEAD_DIMENSION);
            io::println("trajectory native inputs: seed=${latent_seed} noise_nRMSE=${noise_error} rope_nRMSE=${rope_error}");
            if noise_error > (0.000001f64) || rope_error > (0.000001f64) { return 1; }
        }
    }

    guard let option::Option[metal::Buffer]::Some(image_projected) = new_buffer(device, image_projected_bytes) else { return 1; }; let image_projected_owner: OwnedObjc = OwnedObjc::new(image_projected.raw());
    guard let option::Option[metal::Buffer]::Some(text_normalized) = new_buffer(device, text_bytes) else { return 1; }; let text_normalized_owner: OwnedObjc = OwnedObjc::new(text_normalized.raw());
    guard let option::Option[metal::Buffer]::Some(text_hidden) = new_buffer(device, text_bytes) else { return 1; }; let text_hidden_owner: OwnedObjc = OwnedObjc::new(text_hidden.raw());
    guard let option::Option[metal::Buffer]::Some(text_activated) = new_buffer(device, text_bytes) else { return 1; }; let text_activated_owner: OwnedObjc = OwnedObjc::new(text_activated.raw());
    guard let option::Option[metal::Buffer]::Some(text_projected) = new_buffer(device, text_bytes) else { return 1; }; let text_projected_owner: OwnedObjc = OwnedObjc::new(text_projected.raw());
    guard let option::Option[metal::Buffer]::Some(timestep) = new_buffer(device, ((2 as usize) *% #size_of::[f32]()) as u64) else { return 1; }; let timestep_owner: OwnedObjc = OwnedObjc::new(timestep.raw());
    guard let option::Option[metal::Buffer]::Some(time_projection) = new_buffer(device, ((2 as usize) *% (256 as usize) *% #size_of::[f32]()) as u64) else { return 1; }; let time_projection_owner: OwnedObjc = OwnedObjc::new(time_projection.raw());
    guard let option::Option[metal::Buffer]::Some(time_hidden) = new_buffer(device, ((2 as usize) *% WIDTH *% #size_of::[f32]()) as u64) else { return 1; }; let time_hidden_owner: OwnedObjc = OwnedObjc::new(time_hidden.raw());
    guard let option::Option[metal::Buffer]::Some(time_activated_hidden) = new_buffer(device, ((2 as usize) *% WIDTH *% #size_of::[f32]()) as u64) else { return 1; }; let time_activated_hidden_owner: OwnedObjc = OwnedObjc::new(time_activated_hidden.raw());
    guard let option::Option[metal::Buffer]::Some(time_embedding) = new_buffer(device, ((2 as usize) *% WIDTH *% #size_of::[f32]()) as u64) else { return 1; }; let time_embedding_owner: OwnedObjc = OwnedObjc::new(time_embedding.raw());
    guard let option::Option[metal::Buffer]::Some(activated_time) = new_buffer(device, ((2 as usize) *% WIDTH *% #size_of::[f32]()) as u64) else { return 1; }; let activated_time_owner: OwnedObjc = OwnedObjc::new(activated_time.raw());
    guard let option::Option[metal::Buffer]::Some(modulation) = new_buffer(device, ((2 as usize) *% (4 as usize) *% WIDTH *% #size_of::[f32]()) as u64) else { return 1; }; let modulation_owner: OwnedObjc = OwnedObjc::new(modulation.raw());
    guard let option::Option[metal::Buffer]::Some(first_hidden) = new_buffer(device, activation_bytes) else { return 1; }; let first_hidden_owner: OwnedObjc = OwnedObjc::new(first_hidden.raw());
    guard let option::Option[metal::Buffer]::Some(second_hidden) = new_buffer(device, activation_bytes) else { return 1; }; let second_hidden_owner: OwnedObjc = OwnedObjc::new(second_hidden.raw());

    var params: BlockParams = BlockParams { rows: text_rows as u32, width: WIDTH as u32, heads: HEADS as u32, head_dimension: HEAD_DIMENSION as u32, epsilon: 0.000001f32, slot: 0 as u32 };
    var total_ms: f64 = 0.0f64;
    guard let option::Option[f64]::Some(text_norm_ms) = dispatch_1d(queue, text_norm_pipeline, text_input, text_norm_weight, text_normalized, dummy, dummy, dummy, #addr_of(params), text_rows) else { return 1; }; total_ms = total_ms + text_norm_ms;
    guard let option::Option[f64]::Some(text_in_ms) = dispatch_weighted_linear(queue, pipelines, text_normalized, text_in_weight, text_hidden, WIDTH, WIDTH, text_rows) else { return 1; }; total_ms = total_ms + text_in_ms;
    guard let option::Option[f64]::Some(gelu_ms) = dispatch_1d(queue, gelu_pipeline, text_hidden, dummy, text_activated, dummy, dummy, dummy, #addr_of(params), text_rows *% WIDTH) else { return 1; }; total_ms = total_ms + gelu_ms;
    guard let option::Option[f64]::Some(text_out_ms) = dispatch_weighted_linear(queue, pipelines, text_activated, text_out_weight, text_projected, WIDTH, WIDTH, text_rows) else { return 1; }; total_ms = total_ms + text_out_ms;

    guard let option::Option[metal::Buffer]::Some(source_index) = new_buffer(device, (rows *% #size_of::[i32]()) as u64) else { return 1; }; let source_index_owner: OwnedObjc = OwnedObjc::new(source_index.raw());
    let sources: *i32 = source_index.contents() as *i32;
    var row: usize = 0 as usize;
    while row < text_rows { sources[row] = 0 -% (row as i32) -% (1 as i32); row = row +% (1 as usize); }
    while row < rows { sources[row] = (row -% text_rows) as i32; row = row +% (1 as usize); }
    guard let option::Option[metal::Buffer]::Some(target_mask) = new_buffer(device, rows as u64) else { return 1; }; let target_mask_owner: OwnedObjc = OwnedObjc::new(target_mask.raw());
    guard let option::Option[metal::Buffer]::Some(image_ids) = new_buffer(device, (rows *% #size_of::[i32]()) as u64) else { return 1; }; let image_ids_owner: OwnedObjc = OwnedObjc::new(image_ids.raw());
    guard let option::Option[metal::Buffer]::Some(key_valid) = new_buffer(device, rows as u64) else { return 1; }; let key_valid_owner: OwnedObjc = OwnedObjc::new(key_valid.raw());
    let ids: *i32 = image_ids.contents() as *i32;
    row = 0 as usize;
    while row < rows {
        (target_mask.contents())[row] = if row >= text_rows { 1 as u8 } else { 0 as u8 };
        ids[row] = if row >= text_rows { 0 as i32 } else { 0 -% (1 as i32) };
        (key_valid.contents())[row] = 1 as u8;
        row = row +% (1 as usize);
    }
    guard let option::Option[metal::Buffer]::Some(cached_rope) = new_buffer(device, (target_rows *% HEAD_DIMENSION *% #size_of::[f32]()) as u64) else { return 1; }; let cached_rope_owner: OwnedObjc = OwnedObjc::new(cached_rope.raw());
    let rope_values: *f32 = rope.contents() as *f32;
    let cached_rope_values: *f32 = cached_rope.contents() as *f32;
    var copy_index: usize = 0 as usize;
    while copy_index < target_rows *% HEAD_DIMENSION {
        cached_rope_values[copy_index] = rope_values[text_rows *% HEAD_DIMENSION +% copy_index];
        copy_index = copy_index +% (1 as usize);
    }
    guard let option::Option[metal::Buffer]::Some(cached_target_mask) = new_buffer(device, target_rows as u64) else { return 1; }; let cached_target_mask_owner: OwnedObjc = OwnedObjc::new(cached_target_mask.raw());
    row = 0 as usize;
    while row < target_rows { (cached_target_mask.contents())[row] = 1 as u8; row = row +% (1 as usize); }

    guard let option::Option[metal::Buffer]::Some(norm1) = new_buffer(device, activation_bytes) else { return 1; }; let norm1_owner: OwnedObjc = OwnedObjc::new(norm1.raw());
    guard let option::Option[metal::Buffer]::Some(query) = new_buffer(device, activation_bytes) else { return 1; }; let query_owner: OwnedObjc = OwnedObjc::new(query.raw());
    guard let option::Option[metal::Buffer]::Some(key) = new_buffer(device, activation_bytes) else { return 1; }; let key_owner: OwnedObjc = OwnedObjc::new(key.raw());
    guard let option::Option[metal::Buffer]::Some(value) = new_buffer(device, activation_bytes) else { return 1; }; let value_owner: OwnedObjc = OwnedObjc::new(value.raw());
    guard let option::Option[metal::Buffer]::Some(query_rope) = new_buffer(device, activation_bytes) else { return 1; }; let query_rope_owner: OwnedObjc = OwnedObjc::new(query_rope.raw());
    guard let option::Option[metal::Buffer]::Some(key_rope) = new_buffer(device, activation_bytes) else { return 1; }; let key_rope_owner: OwnedObjc = OwnedObjc::new(key_rope.raw());
    guard let option::Option[metal::Buffer]::Some(attended) = new_buffer(device, activation_bytes) else { return 1; }; let attended_owner: OwnedObjc = OwnedObjc::new(attended.raw());
    guard let option::Option[metal::Buffer]::Some(attention_projected) = new_buffer(device, activation_bytes) else { return 1; }; let attention_projected_owner: OwnedObjc = OwnedObjc::new(attention_projected.raw());
    guard let option::Option[metal::Buffer]::Some(residual1) = new_buffer(device, activation_bytes) else { return 1; }; let residual1_owner: OwnedObjc = OwnedObjc::new(residual1.raw());
    guard let option::Option[metal::Buffer]::Some(norm2) = new_buffer(device, activation_bytes) else { return 1; }; let norm2_owner: OwnedObjc = OwnedObjc::new(norm2.raw());
    guard let option::Option[metal::Buffer]::Some(gate) = new_buffer(device, mlp_bytes) else { return 1; }; let gate_owner: OwnedObjc = OwnedObjc::new(gate.raw());
    guard let option::Option[metal::Buffer]::Some(projected) = new_buffer(device, mlp_bytes) else { return 1; }; let projected_owner: OwnedObjc = OwnedObjc::new(projected.raw());
    guard let option::Option[metal::Buffer]::Some(swiglu) = new_buffer(device, mlp_bytes) else { return 1; }; let swiglu_buffer_owner: OwnedObjc = OwnedObjc::new(swiglu.raw());
    guard let option::Option[metal::Buffer]::Some(mlp_projected) = new_buffer(device, activation_bytes) else { return 1; }; let mlp_projected_owner: OwnedObjc = OwnedObjc::new(mlp_projected.raw());
    guard let option::Option[metal::Buffer]::Some(cache_key_arena) = new_buffer(device, cache_arena_bytes) else { return 1; }; let cache_key_arena_owner: OwnedObjc = OwnedObjc::new(cache_key_arena.raw());
    guard let option::Option[metal::Buffer]::Some(cache_value_arena) = new_buffer(device, cache_arena_bytes) else { return 1; }; let cache_value_arena_owner: OwnedObjc = OwnedObjc::new(cache_value_arena.raw());
    let workspace: BlockWorkspace = BlockWorkspace { modulation: modulation, rope: rope, target_mask: target_mask, image_ids: image_ids, key_valid: key_valid, dummy: dummy, norm1: norm1, query: query, key: key, value: value, query_rope: query_rope, key_rope: key_rope, attended: attended, attention_projected: attention_projected, residual1: residual1, norm2: norm2, gate: gate, projected: projected, swiglu: swiglu, mlp_projected: mlp_projected };
    let cached_workspace: BlockWorkspace = BlockWorkspace { modulation: modulation, rope: cached_rope, target_mask: cached_target_mask, image_ids: image_ids, key_valid: key_valid, dummy: dummy, norm1: norm1, query: query, key: key, value: value, query_rope: query_rope, key_rope: key_rope, attended: attended, attention_projected: attention_projected, residual1: residual1, norm2: norm2, gate: gate, projected: projected, swiglu: swiglu, mlp_projected: mlp_projected };
    guard let option::Option[metal::Buffer]::Some(final_scale) = new_buffer(device, ((2 as usize) *% WIDTH *% #size_of::[f32]()) as u64) else { return 1; }; let final_scale_owner: OwnedObjc = OwnedObjc::new(final_scale.raw());
    guard let option::Option[metal::Buffer]::Some(final_normalized) = new_buffer(device, activation_bytes) else { return 1; }; let final_normalized_owner: OwnedObjc = OwnedObjc::new(final_normalized.raw());
    guard let option::Option[metal::Buffer]::Some(noise_output) = new_buffer(device, (rows *% IMAGE_CHANNELS *% #size_of::[f32]()) as u64) else { return 1; }; let noise_output_owner: OwnedObjc = OwnedObjc::new(noise_output.raw());

    var all_ok: bool = true;
    var total_quantized_matrices: usize = 0 as usize;
    let trajectory_wall_start_ms: i64 = time::now_millis();
    var step: usize = 0 as usize;
    while step < step_limit {
        let step_wall_start_ms: i64 = time::now_millis();
        var step_ms: f64 = 0.0f64;
        let timestep_values: *f32 = timestep.contents() as *f32;
        timestep_values[0] = cpu::bf16_to_f32(cpu::f32_to_bf16(timesteps[step] / 1000.0f32));
        timestep_values[1] = 0.0f32;
        params.rows = 2 as u32; params.width = 256 as u32;
        guard let option::Option[f64]::Some(time_projection_ms) = dispatch_1d(queue, time_pipeline, timestep, dummy, time_projection, dummy, dummy, dummy, #addr_of(params), (2 as usize) *% (256 as usize)) else { return 1; }; step_ms = step_ms + time_projection_ms;
        guard let option::Option[f64]::Some(time_1_ms) = dispatch_weighted_linear(queue, pipelines, time_projection, time_1_weight, time_hidden, WIDTH, 256, 2) else { return 1; }; step_ms = step_ms + time_1_ms;
        params.width = WIDTH as u32;
        guard let option::Option[f64]::Some(time_silu_ms) = dispatch_1d(queue, silu_pipeline, time_hidden, dummy, time_activated_hidden, dummy, dummy, dummy, #addr_of(params), (2 as usize) *% WIDTH) else { return 1; }; step_ms = step_ms + time_silu_ms;
        guard let option::Option[f64]::Some(time_2_ms) = dispatch_weighted_linear(queue, pipelines, time_activated_hidden, time_2_weight, time_embedding, WIDTH, WIDTH, 2) else { return 1; }; step_ms = step_ms + time_2_ms;
        guard let option::Option[f64]::Some(activated_time_ms) = dispatch_1d(queue, silu_pipeline, time_embedding, dummy, activated_time, dummy, dummy, dummy, #addr_of(params), (2 as usize) *% WIDTH) else { return 1; }; step_ms = step_ms + activated_time_ms;
        guard let option::Option[f64]::Some(modulation_ms) = dispatch_weighted_linear(queue, pipelines, activated_time, modulation_weight, modulation, (4 as usize) *% WIDTH, WIDTH, 2) else { return 1; }; step_ms = step_ms + modulation_ms;
        guard let option::Option[f64]::Some(img_ms) = dispatch_weighted_linear(queue, pipelines, latents, img_in_weight, image_projected, WIDTH, IMAGE_CHANNELS, target_rows) else { return 1; }; step_ms = step_ms + img_ms;

        var active_rows: usize = target_rows;
        var cache_mode: u32 = 2 as u32;
        var active_workspace: BlockWorkspace = cached_workspace;
        var current: metal::Buffer = image_projected;
        var next: metal::Buffer = first_hidden;
        if step == (0 as usize) {
            params.rows = rows as u32;
            guard let option::Option[f64]::Some(assemble_ms) = dispatch_1d(queue, assemble_pipeline, text_projected, image_projected, first_hidden, source_index, dummy, dummy, #addr_of(params), rows *% WIDTH) else { return 1; }; step_ms = step_ms + assemble_ms;
            active_rows = rows;
            cache_mode = 1 as u32;
            active_workspace = workspace;
            current = first_hidden;
            next = second_hidden;
        }

        var step_quantized_matrices: usize = 0 as usize;
        var block: usize = 0 as usize;
        while block < (32 as usize) {
            let prefix: text::Text = "transformer_blocks.${block}.";
            let norm_q_name: text::Text = "${prefix}attn.norm_q.weight";
            let norm_k_name: text::Text = "${prefix}attn.norm_k.weight";
            guard let option::Option[metal::Buffer]::Some(norm_q) = packed_vector_buffer(device, weight_file, norm_q_name.view(), HEAD_DIMENSION as u64) else { return 1; }; let norm_q_owner: OwnedObjc = OwnedObjc::new(norm_q.raw());
            guard let option::Option[metal::Buffer]::Some(norm_k) = packed_vector_buffer(device, weight_file, norm_k_name.view(), HEAD_DIMENSION as u64) else { return 1; }; let norm_k_owner: OwnedObjc = OwnedObjc::new(norm_k.raw());
            let q_name: text::Text = "${prefix}attn.to_q.weight"; let k_name: text::Text = "${prefix}attn.to_k.weight"; let v_name: text::Text = "${prefix}attn.to_v.weight";
            let attention_output_name: text::Text = "${prefix}attn.to_out.0.weight"; let gate_name: text::Text = "${prefix}img_mlp.gate_layer.weight"; let projected_name: text::Text = "${prefix}img_mlp.proj.weight"; let mlp_output_name: text::Text = "${prefix}img_mlp.out.weight";
            guard let option::Option[LinearWeight]::Some(q) = packed_linear_weight(weight_file, storage, q_name.view(), WIDTH as u64, WIDTH as u64) else { return 1; };
            guard let option::Option[LinearWeight]::Some(k) = packed_linear_weight(weight_file, storage, k_name.view(), WIDTH as u64, WIDTH as u64) else { return 1; };
            guard let option::Option[LinearWeight]::Some(v) = packed_linear_weight(weight_file, storage, v_name.view(), WIDTH as u64, WIDTH as u64) else { return 1; };
            guard let option::Option[LinearWeight]::Some(attention_output) = packed_linear_weight(weight_file, storage, attention_output_name.view(), WIDTH as u64, WIDTH as u64) else { return 1; };
            guard let option::Option[LinearWeight]::Some(gate_weight) = packed_linear_weight(weight_file, storage, gate_name.view(), MLP_WIDTH as u64, WIDTH as u64) else { return 1; };
            guard let option::Option[LinearWeight]::Some(projected_weight) = packed_linear_weight(weight_file, storage, projected_name.view(), MLP_WIDTH as u64, WIDTH as u64) else { return 1; };
            guard let option::Option[LinearWeight]::Some(mlp_output) = packed_linear_weight(weight_file, storage, mlp_output_name.view(), WIDTH as u64, MLP_WIDTH as u64) else { return 1; };
            step_quantized_matrices = step_quantized_matrices +%
                (if q.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize }) +%
                (if k.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize }) +%
                (if v.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize }) +%
                (if attention_output.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize }) +%
                (if gate_weight.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize }) +%
                (if projected_weight.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize }) +%
                (if mlp_output.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize });
            let cache_offset: u64 = block as u64 *% per_block_cache_bytes;
            guard let option::Option[f64]::Some(block_ms) = execute_batched_runtime_block(
                queue, pipelines, BlockWeights { norm_q: norm_q, norm_k: norm_k, q: q, k: k, v: v, attention_output: attention_output, gate: gate_weight, projected: projected_weight, mlp_output: mlp_output }, active_workspace, current, next, active_rows,
                cache_mode, cache_copy_pipeline, cache_key_arena, cache_value_arena,
                cache_offset, text_rows,
            ) else { return 1; };
            step_ms = step_ms + block_ms;
            let swap: metal::Buffer = current; current = next; next = swap;
            block = block +% (1 as usize);
        }
        if step_quantized_matrices != (40 as usize) {
            io::eprintln("trajectory: expected 40 Q8 matrices at step ${step +% (1 as usize)}, found ${step_quantized_matrices}");
            return 1;
        }
        total_quantized_matrices = total_quantized_matrices +% step_quantized_matrices;

        guard let option::Option[f64]::Some(final_scale_ms) = dispatch_weighted_linear(queue, pipelines, activated_time, final_scale_weight, final_scale, WIDTH, WIDTH, 2) else { return 1; }; step_ms = step_ms + final_scale_ms;
        params.rows = active_rows as u32; params.width = WIDTH as u32;
        guard let option::Option[f64]::Some(final_norm_ms) = dispatch_1d(queue, final_norm_pipeline, current, final_scale, final_normalized, active_workspace.target_mask, dummy, dummy, #addr_of(params), active_rows) else { return 1; }; step_ms = step_ms + final_norm_ms;
        guard let option::Option[f64]::Some(output_ms) = dispatch_weighted_linear(queue, pipelines, final_normalized, proj_out_weight, noise_output, IMAGE_CHANNELS, WIDTH, active_rows) else { return 1; }; step_ms = step_ms + output_ms;
        if !finite("trajectory noise step ${step +% (1 as usize)}", noise_output, active_rows *% IMAGE_CHANNELS) { return 1; }
        let noise_offset: usize = if step == (0 as usize) { text_rows *% IMAGE_CHANNELS } else { 0 as usize };
        flow::euler_step_bf16(
            latents.contents() as *f32,
            (noise_output.contents() as *f32) + noise_offset,
            latents.contents() as *f32,
            latent_count,
            sigmas[step],
            sigmas[step +% (1 as usize)],
        );
        total_ms = total_ms + step_ms;
        let step_wall_ms: i64 = time::now_millis() - step_wall_start_ms;
        let completed_step: usize = step +% (1 as usize);
        if validate_reference && (
            completed_step == (1 as usize) || completed_step == (2 as usize)
                || completed_step == (40 as usize)
        ) {
            let checkpoint_name: text::Text = if completed_step < (10 as usize) { "latent_step_0${completed_step}" } else { "latent_step_${completed_step}" };
            guard let option::Option[f64]::Some(error) = normalized_rms_fixture(latents, fixture_directory, checkpoint_name.view(), latent_count) else { return 1; };
            let cache_mode_name: str = if step == (0 as usize) { "extract" } else { "cached" };
            let error_limit: f64 = if completed_step == (1 as usize) {
                0.001f64
            } else if completed_step == (2 as usize) {
                0.0015f64
            } else if native_inputs {
                // The native Qwen3-VL path is independently bounded at 4%
                // against the Torch text fixture. Its small prompt-embedding
                // drift accumulates through 40 denoising steps, so preserve
                // the stricter 1.1% fixture-fed gate and give this integrated
                // boundary its own measured 2% budget.
                0.02f64
            } else {
                0.011f64
            };
            io::println("trajectory step ${completed_step}: mode=${cache_mode_name} timestep=${timesteps[step]} sigma=${sigmas[step]} gpu_ms=${step_ms} wall_ms=${step_wall_ms} latent_nRMSE=${error} limit=${error_limit}");
            all_ok = error <= error_limit && finite("trajectory latent step ${completed_step}", latents, latent_count) && all_ok;
        } else {
            let cache_mode_name: str = if step == (0 as usize) { "extract" } else { "cached" };
            io::println("trajectory step ${completed_step}: mode=${cache_mode_name} timestep=${timesteps[step]} sigma=${sigmas[step]} gpu_ms=${step_ms} wall_ms=${step_wall_ms}");
            all_ok = finite("trajectory latent step ${completed_step}", latents, latent_count) && all_ok;
        }
        step = step +% (1 as usize);
    }
    if !final_latent.is_null() {
        let latent_values: *f32 = latents.contents() as *f32;
        var latent_index: usize = 0 as usize;
        while latent_index < latent_count {
            final_latent[latent_index] = latent_values[latent_index];
            latent_index = latent_index +% (1 as usize);
        }
    }
    let trajectory_wall_ms: i64 = time::now_millis() - trajectory_wall_start_ms;
    io::println("trajectory: pixels=256 steps=${step_limit} q8_dispatch_matrices=${total_quantized_matrices} cache_bytes=${(2 as u64) *% cache_arena_bytes} total_gpu_ms=${total_ms} total_wall_ms=${trajectory_wall_ms}");
    if all_ok {
        if validate_reference {
            io::println("Qwen-Image-2.1 latent trajectory prefix: verified");
        } else {
            io::println("Qwen-Image-2.1 native-prompt latent trajectory: complete");
        }
        return 0;
    }
    return 1;
}

fn test_attention_cache(
    fixture_directory: str = "tests/fixtures/attention_cache_fp32",
) -> i32 {
    let cache_rows: usize = 7 as usize;
    let prefix_rows: usize = 5 as usize;
    let target_rows: usize = 2 as usize;
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return 1; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    let device_pointer: *u8 = MTLCreateSystemDefaultDevice();
    if device_pointer.is_null() { io::eprintln("attention cache: no Metal device"); return 1; }
    let device_owner: OwnedObjc = OwnedObjc::new(rt::retain(device_pointer));
    let device: metal::Device = metal::Device::from_raw(device_owner.raw());
    guard let option::Option[metal::CommandQueue]::Some(queue) = device.new_command_queue() else { return 1; };
    let queue_owner: OwnedObjc = OwnedObjc::new(queue.raw());
    let options_pointer: *u8 = rt::alloc_init(#str_ptr("MTLCompileOptions\0"));
    if options_pointer.is_null() { return 1; }
    let options_owner: OwnedObjc = OwnedObjc::new(options_pointer);
    let options: metal::CompileOptions = metal::CompileOptions::from_raw(options_owner.raw());
    options.set_fast_math_enabled(false);
    var compile_error: *u8 = 0 as *u8;
    guard let option::Option[metal::Library]::Some(library) = device.new_library_with_source(
        #include_str("../kernels/transformer_block.metal"), options, #addr_of(compile_error) as *u8,
    ) else {
        if !compile_error.is_null() {
            let description: *u8 = rt::msg_id(compile_error, rt::sel(#str_ptr("localizedDescription\0")));
            io::eprintln("attention cache Metal compile: ${bridge::to_text(description)}");
        }
        return 1;
    };
    let library_owner: OwnedObjc = OwnedObjc::new(library.raw());
    guard let option::Option[OwnedObjc]::Some(attention_owner) = pipeline(device, library, "qi_block_attention") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(copy_owner) = pipeline(device, library, "qi_copy_prefix_kv") else { return 1; };
    let attention_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(attention_owner.raw());
    let copy_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(copy_owner.raw());
    let full_bytes: u64 = (cache_rows *% WIDTH *% #size_of::[f32]()) as u64;
    let prefix_bytes: u64 = (prefix_rows *% WIDTH *% #size_of::[f32]()) as u64;
    let target_bytes: u64 = (target_rows *% WIDTH *% #size_of::[f32]()) as u64;
    guard let option::Option[metal::Buffer]::Some(query) = fixture_buffer(device, fixture_directory, "query", full_bytes) else { return 1; }; let query_owner: OwnedObjc = OwnedObjc::new(query.raw());
    guard let option::Option[metal::Buffer]::Some(key) = fixture_buffer(device, fixture_directory, "key", full_bytes) else { return 1; }; let key_owner: OwnedObjc = OwnedObjc::new(key.raw());
    guard let option::Option[metal::Buffer]::Some(value) = fixture_buffer(device, fixture_directory, "value", full_bytes) else { return 1; }; let value_owner: OwnedObjc = OwnedObjc::new(value.raw());
    guard let option::Option[metal::Buffer]::Some(output) = new_buffer(device, full_bytes) else { return 1; }; let output_owner: OwnedObjc = OwnedObjc::new(output.raw());
    guard let option::Option[metal::Buffer]::Some(image_ids) = new_buffer(device, (cache_rows *% #size_of::[i32]()) as u64) else { return 1; }; let image_ids_owner: OwnedObjc = OwnedObjc::new(image_ids.raw());
    let ids: *i32 = image_ids.contents() as *i32;
    ids[0] = 0; ids[1] = 0; ids[2] = 1; ids[3] = 1; ids[4] = 0 -% (1 as i32); ids[5] = 2; ids[6] = 2;
    guard let option::Option[metal::Buffer]::Some(key_valid) = new_buffer(device, cache_rows as u64) else { return 1; }; let key_valid_owner: OwnedObjc = OwnedObjc::new(key_valid.raw());
    var row: usize = 0 as usize;
    while row < cache_rows { (key_valid.contents())[row] = if row == (4 as usize) { 0 as u8 } else { 1 as u8 }; row = row +% (1 as usize); }
    guard let option::Option[f64]::Some(prefill_ms) = dispatch_attention(
        queue, attention_pipeline, query, key, output, value, image_ids, key_valid,
        cache_rows, cache_rows, key, value, 0 as u64,
    ) else { return 1; };
    var all_ok: bool = compare_fixture("tiled block-causal prefill", output, fixture_directory, "output", cache_rows *% WIDTH, 0.00001f64, 0.00001f64);

    guard let option::Option[metal::Buffer]::Some(cache_key) = new_buffer(device, prefix_bytes) else { return 1; }; let cache_key_owner: OwnedObjc = OwnedObjc::new(cache_key.raw());
    guard let option::Option[metal::Buffer]::Some(cache_value) = new_buffer(device, prefix_bytes) else { return 1; }; let cache_value_owner: OwnedObjc = OwnedObjc::new(cache_value.raw());
    guard let option::Option[metal::Buffer]::Some(dummy) = new_buffer(device, 4 as u64) else { return 1; }; let dummy_owner: OwnedObjc = OwnedObjc::new(dummy.raw());
    guard let option::Option[f64]::Some(copy_ms) = dispatch_copy_prefix(
        queue, copy_pipeline, key, value, cache_key, cache_value,
        0 as u64, prefix_rows, dummy,
    ) else { return 1; };
    all_ok = compare_fixture("cached post-RoPE prefix K", cache_key, fixture_directory, "prefix_key", prefix_rows *% WIDTH, 0.0f64, 0.0f64) && all_ok;
    all_ok = compare_fixture("cached raw prefix V", cache_value, fixture_directory, "prefix_value", prefix_rows *% WIDTH, 0.0f64, 0.0f64) && all_ok;

    guard let option::Option[metal::Buffer]::Some(target_query) = fixture_buffer(device, fixture_directory, "target_query", target_bytes) else { return 1; }; let target_query_owner: OwnedObjc = OwnedObjc::new(target_query.raw());
    guard let option::Option[metal::Buffer]::Some(target_key) = fixture_buffer(device, fixture_directory, "target_key", target_bytes) else { return 1; }; let target_key_owner: OwnedObjc = OwnedObjc::new(target_key.raw());
    guard let option::Option[metal::Buffer]::Some(target_value) = fixture_buffer(device, fixture_directory, "target_value", target_bytes) else { return 1; }; let target_value_owner: OwnedObjc = OwnedObjc::new(target_value.raw());
    guard let option::Option[metal::Buffer]::Some(target_output) = new_buffer(device, target_bytes) else { return 1; }; let target_output_owner: OwnedObjc = OwnedObjc::new(target_output.raw());
    guard let option::Option[f64]::Some(cached_ms) = dispatch_attention(
        queue, attention_pipeline, target_query, target_key, target_output, target_value,
        image_ids, key_valid, target_rows, cache_rows, cache_key, cache_value, 0 as u64,
        prefix_rows, true, prefix_rows,
    ) else { return 1; };
    all_ok = compare_fixture("cached target decode", target_output, fixture_directory, "target_output", target_rows *% WIDTH, 0.00001f64, 0.00001f64) && all_ok;
    io::println("attention cache: prefill_gpu_ms=${prefill_ms} cache_copy_gpu_ms=${copy_ms} cached_gpu_ms=${cached_ms} cache_bytes=${(2 as u64) *% prefix_bytes}");
    if all_ok { io::println("tiled prefill and prefix KV cached decode: verified"); return 0; }
    return 1;
}

fn benchmark_attention(rows: usize = 4096 as usize) -> i32 {
    if rows == (0 as usize) || rows > (4096 as usize) {
        io::eprintln("attention benchmark: token count must be 1..4096");
        return 2;
    }
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return 1; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    let device_pointer: *u8 = MTLCreateSystemDefaultDevice();
    if device_pointer.is_null() { io::eprintln("attention benchmark: no Metal device"); return 1; }
    let device_owner: OwnedObjc = OwnedObjc::new(rt::retain(device_pointer));
    let device: metal::Device = metal::Device::from_raw(device_owner.raw());
    guard let option::Option[metal::CommandQueue]::Some(queue) = device.new_command_queue() else { return 1; };
    let queue_owner: OwnedObjc = OwnedObjc::new(queue.raw());
    let options_pointer: *u8 = rt::alloc_init(#str_ptr("MTLCompileOptions\0"));
    if options_pointer.is_null() { return 1; }
    let options_owner: OwnedObjc = OwnedObjc::new(options_pointer);
    let options: metal::CompileOptions = metal::CompileOptions::from_raw(options_owner.raw());
    options.set_fast_math_enabled(false);
    var compile_error: *u8 = 0 as *u8;
    guard let option::Option[metal::Library]::Some(library) = device.new_library_with_source(
        #include_str("../kernels/transformer_block.metal"), options, #addr_of(compile_error) as *u8,
    ) else { return 1; };
    let library_owner: OwnedObjc = OwnedObjc::new(library.raw());
    guard let option::Option[OwnedObjc]::Some(attention_owner) = pipeline(device, library, "qi_block_attention") else { return 1; };
    let attention_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(attention_owner.raw());
    let activation_bytes: u64 = (rows *% WIDTH *% #size_of::[f32]()) as u64;
    guard let option::Option[metal::Buffer]::Some(query) = new_buffer(device, activation_bytes) else { return 1; }; let query_owner: OwnedObjc = OwnedObjc::new(query.raw());
    guard let option::Option[metal::Buffer]::Some(key) = new_buffer(device, activation_bytes) else { return 1; }; let key_owner: OwnedObjc = OwnedObjc::new(key.raw());
    guard let option::Option[metal::Buffer]::Some(value) = new_buffer(device, activation_bytes) else { return 1; }; let value_owner: OwnedObjc = OwnedObjc::new(value.raw());
    guard let option::Option[metal::Buffer]::Some(output) = new_buffer(device, activation_bytes) else { return 1; }; let output_owner: OwnedObjc = OwnedObjc::new(output.raw());
    let query_values: *f32 = query.contents() as *f32;
    let key_values: *f32 = key.contents() as *f32;
    let value_values: *f32 = value.contents() as *f32;
    var index: usize = 0 as usize;
    while index < rows *% WIDTH {
        query_values[index] = ((index % (251 as usize)) as f32 - 125.0f32) / 512.0f32;
        key_values[index] = ((index % (239 as usize)) as f32 - 119.0f32) / 512.0f32;
        value_values[index] = ((index % (233 as usize)) as f32 - 116.0f32) / 256.0f32;
        index = index +% (1 as usize);
    }
    guard let option::Option[metal::Buffer]::Some(image_ids) = new_buffer(device, (rows *% #size_of::[i32]()) as u64) else { return 1; }; let image_ids_owner: OwnedObjc = OwnedObjc::new(image_ids.raw());
    guard let option::Option[metal::Buffer]::Some(key_valid) = new_buffer(device, rows as u64) else { return 1; }; let key_valid_owner: OwnedObjc = OwnedObjc::new(key_valid.raw());
    index = 0 as usize;
    while index < rows { (image_ids.contents() as *i32)[index] = 0; (key_valid.contents())[index] = 1 as u8; index = index +% (1 as usize); }
    guard let option::Option[f64]::Some(gpu_ms) = dispatch_attention(
        queue, attention_pipeline, query, key, output, value, image_ids, key_valid,
        rows, rows, key, value, 0 as u64,
    ) else { return 1; };
    if !finite("attention benchmark output", output, rows *% WIDTH) { return 1; }
    let temporary_bytes: u64 = (4 as u64) *% activation_bytes;
    let avoided_score_bytes: u64 = rows as u64 *% rows as u64 *% HEADS as u64 *% (4 as u64);
    io::println("tiled attention benchmark: tokens=${rows} gpu_ms=${gpu_ms} activation_bytes=${temporary_bytes} avoided_score_bytes=${avoided_score_bytes}");
    return 0;
}

#[test]
fn block_dimensions_match_pinned_model() {
    assert HEADS *% HEAD_DIMENSION == WIDTH;
    assert MLP_WIDTH == WIDTH *% (3 as usize);
    assert ROWS == (4 as usize);
}

#[test]
fn tile_rounding_covers_model_width() {
    assert round_up(WIDTH, OUTPUT_TILE) == WIDTH;
    assert round_up(ROWS, OUTPUT_TILE) == (32 as usize);
    assert round_up((278 as usize), OUTPUT_TILE) == (288 as usize);
    assert round_up((256 as usize), OUTPUT_TILE) == (256 as usize);
}
