import "stdlib/fs" as fs;
import "stdlib/option" as option;
import "stdlib/result" as result;
import "stdlib/text" as text;

#[link_name = "open"]
extern fn qi_open(path: *u8, flags: i32, ...) -> i32;

#[link_name = "close"]
extern fn qi_close(fd: i32) -> i32;

#[link_name = "mmap"]
extern fn qi_mmap(address: *u8, length: usize, protection: i32, flags: i32, fd: i32, offset: i64) -> *u8;

#[link_name = "munmap"]
extern fn qi_munmap(address: *u8, length: usize) -> i32;

#[link_name = "madvise"]
extern fn qi_madvise(address: *u8, length: usize, advice: i32) -> i32;

#[link_name = "pread"]
extern fn qi_pread(fd: i32, buffer: *u8, count: usize, offset: i64) -> isize;

#[link_name = "fcntl"]
extern fn qi_fcntl(fd: i32, command: i32, ...) -> i32;

const PROT_READ: i32 = 1;
const MAP_PRIVATE: i32 = 2;
const MADV_WILLNEED: i32 = 3;
const F_NOCACHE: i32 = 48;

enum MapError {
    NotFound,
    Empty,
    TooLarge,
    InvalidPath,
    MapFailed,
}

struct MappedFile {
    opaque _ptr: *u8,
    _length: usize,
}

// A positional reader for large, one-pass weight streams. F_NOCACHE keeps
// those reads from evicting the denoiser and VAE working sets from the unified
// page cache after the text phase has consumed them.
struct PositionalReader {
    opaque _fd: i32,
}

impl PositionalReader {
    fn descriptor(this) -> i32 {
        return this._fd;
    }

    fn read_at(this, destination: *u8, length: usize, offset: u64) -> bool {
        return read_at_descriptor(this._fd, destination, length, offset);
    }

    fn drop(ref this) {
        if this._fd >= (0 as i32) {
            let _closed: i32 = qi_close(this._fd);
            this._fd = -1 as i32;
        }
    }
}

fn read_at_descriptor(fd: i32, destination: *u8, length: usize, offset: u64) -> bool {
    if destination.is_null() || length == (0 as usize) {
        return length == (0 as usize);
    }
    var completed: usize = 0 as usize;
    while completed < length {
        let count: isize = qi_pread(
            fd,
            destination + completed,
            length -% completed,
            (offset +% completed as u64) as i64,
        );
        if count <= (0 as isize) {
            return false;
        }
        completed = completed +% count as usize;
    }
    return true;
}

impl MappedFile {
    fn pointer(this) -> *u8 {
        return this._ptr;
    }

    fn length(this) -> usize {
        return this._length;
    }

    fn drop(ref this) {
        if !this._ptr.is_null() && this._length > (0 as usize) {
            let _status: i32 = qi_munmap(this._ptr, this._length);
            this._ptr = 0 as *u8;
            this._length = 0 as usize;
        }
    }
}

enum MapResult {
    Ok(MappedFile),
    Err(MapError),
}

// Ask the kernel to start faulting this mapping into the page cache. This is
// only a hint: a failure changes performance, never correctness. On macOS a
// multi-gigabyte WILLNEED call can itself take seconds, so callers should time
// it and avoid advising tensors they will not consume.
fn advise_range_willneed(pointer: *u8, length: usize) -> bool {
    if pointer.is_null() || length == (0 as usize) {
        return false;
    }
    return qi_madvise(pointer, length, MADV_WILLNEED) == (0 as i32);
}

fn open_positional_reader(path: str) -> option::Option[PositionalReader] {
    let path_owner: text::Text = text::from_str(path);
    guard let option::Option[text::CString]::Some(c_path) = path_owner.c_str() else {
        return option::Option[PositionalReader]::None;
    };
    let fd: i32 = qi_open(c_path.as_ptr(), 0 as i32, 0 as i32);
    if fd < (0 as i32) {
        return option::Option[PositionalReader]::None;
    }
    // This is a performance policy rather than a correctness requirement.
    // Continue if an older platform rejects the advisory command.
    let _no_cache: i32 = qi_fcntl(fd, F_NOCACHE, 1 as i32);
    return option::Option[PositionalReader]::Some(PositionalReader { _fd: fd });
}

fn map_readonly(path: str) -> MapResult {
    let metadata = fs::metadata(path);
    guard let result::Result[fs::Metadata, result::IoError]::Ok(info) = metadata else {
        return MapResult::Err(MapError::NotFound);
    };
    if info.size <= (0 as i64) {
        return MapResult::Err(MapError::Empty);
    }
    let max_size: u64 = ((0 as usize) -% (1 as usize)) as u64;
    if info.size as u64 > max_size {
        return MapResult::Err(MapError::TooLarge);
    }

    let path_owner: text::Text = text::from_str(path);
    guard let option::Option[text::CString]::Some(c_path) = path_owner.c_str() else {
        return MapResult::Err(MapError::InvalidPath);
    };
    let fd: i32 = qi_open(c_path.as_ptr(), 0 as i32, 0 as i32);
    if fd < (0 as i32) {
        return MapResult::Err(MapError::NotFound);
    }

    let length: usize = info.size as usize;
    let pointer: *u8 = qi_mmap(0 as *u8, length, PROT_READ, MAP_PRIVATE, fd, 0 as i64);
    let _closed: i32 = qi_close(fd);
    let map_failed: usize = (0 as usize) -% (1 as usize);
    if #addr(pointer) == map_failed {
        return MapResult::Err(MapError::MapFailed);
    }
    return MapResult::Ok(MappedFile { _ptr: pointer, _length: length });
}
