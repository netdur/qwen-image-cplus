import "./metal_probe" as metal_probe;
import "./metal_primitives" as metal_primitives;
import "./metal_linear" as metal_linear;
import "./transformer_block" as transformer_block;
import "./model_inventory" as model_inventory;
import "./safetensors" as safetensors;
import "./scheduler" as scheduler;
import "./tensor" as tensor;
import "./cpu_ops" as cpu_ops;
import "stdlib/env" as env;
import "stdlib/io" as io;
import "stdlib/option" as option;
import "stdlib/text" as text;

fn main() -> i32 {
    if env::argc() < (2 as usize) {
        io::println(
            "usage: qwen-image-cplus <probe | probe-stress | test-metal-primitives | test-metal-linear | benchmark-linear | test-transformer-block MODEL_DIR [FIXTURE_DIR] | inspect FILE | verify-model MODEL_DIR>",
        );
        return 0;
    }

    guard let option::Option[text::Text]::Some(command) = env::arg(1 as usize) else {
        io::eprintln("missing command");
        return 2;
    };

    if command == "probe" {
        return metal_probe::run();
    }
    if command == "probe-stress" {
        return metal_probe::stress();
    }
    if command == "test-metal-primitives" {
        return metal_primitives::run();
    }
    if command == "test-metal-linear" {
        return metal_linear::run_validation();
    }
    if command == "benchmark-linear" {
        return metal_linear::run_benchmark();
    }
    if command == "test-transformer-block" {
        guard let option::Option[text::Text]::Some(path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus test-transformer-block MODEL_DIR [FIXTURE_DIR]");
            return 2;
        };
        match env::arg(3 as usize) {
            option::Option[text::Text]::Some(fixtures) => {
                return transformer_block::run(path.view(), fixtures.view());
            }
            option::Option[text::Text]::None => {
                return transformer_block::run(path.view());
            }
        }
    }
    if command == "inspect" {
        guard let option::Option[text::Text]::Some(path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus inspect FILE [NAME_FILTER]");
            return 2;
        };
        match env::arg(3 as usize) {
            option::Option[text::Text]::Some(filter) => { return safetensors::inspect(path, filter); }
            option::Option[text::Text]::None => { return safetensors::inspect(path); }
        }
    }
    if command == "verify-model" || command == "verify" {
        guard let option::Option[text::Text]::Some(path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus verify-model MODEL_DIR");
            return 2;
        };
        return model_inventory::verify_model(path);
    }

    io::eprintln("unknown command: ${command}");
    return 2;
}
