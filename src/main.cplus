            io::eprintln("usage: qwen-image-cplus benchmark-process-reuse-256 PACKED MODEL_DIR OUTPUT PROMPT 0.12|0.24 REQUESTS [SEED]");
            return 2;
        };
        guard let option::Option[text::Text]::Some(threshold_text) = env::arg(6 as usize) else {
            io::eprintln("usage: qwen-image-cplus benchmark-process-reuse-256 PACKED MODEL_DIR OUTPUT PROMPT 0.12|0.24 REQUESTS [SEED]");
            return 2;
        };
        let threshold: f64 = if threshold_text == "0.12" {
            0.12f64
        } else if threshold_text == "0.24" {
            0.24f64
        } else {
            io::eprintln("benchmark-process-reuse-256: threshold must be 0.12 or 0.24");
            return 2;
        };
        guard let option::Option[text::Text]::Some(request_count_text) = env::arg(7 as usize) else {
            io::eprintln("usage: qwen-image-cplus benchmark-process-reuse-256 PACKED MODEL_DIR OUTPUT PROMPT 0.12|0.24 REQUESTS [SEED]");
            return 2;
        };
        guard let option::Option[u64]::Some(request_count_value) =
            parse_u64_decimal(request_count_text.view()) else {
            io::eprintln("benchmark-process-reuse-256: requests must be an integer from 2 through 16");
            return 2;
        };
        if request_count_value < (2 as u64) || request_count_value > (16 as u64) {
            io::eprintln("benchmark-process-reuse-256: requests must be an integer from 2 through 16");
            return 2;
        }
        var seed: u64 = 42 as u64;
        match env::arg(8 as usize) {
            option::Option[text::Text]::Some(seed_text) => {
                guard let option::Option[u64]::Some(parsed) = parse_u64_decimal(seed_text.view()) else {
                    io::eprintln("benchmark-process-reuse-256: seed must be an unsigned decimal integer");
                    return 2;
                };
                seed = parsed;
            }
            option::Option[text::Text]::None => {}
        }
        return pipeline::benchmark_process_reuse_256(
            packed_path.view(),
            model_path.view(),
            output_path.view(),
            prompt.view(),
            request_count_value as usize,
            seed,
            threshold,
        );
    }
    if command == "test-native-pipeline-256" {
        guard let option::Option[text::Text]::Some(packed_path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus test-native-pipeline-256 PACKED MODEL_DIR OUTPUT");
            return 2;
        };
        guard let option::Option[text::Text]::Some(model_path) = env::arg(3 as usize) else {
            io::eprintln("usage: qwen-image-cplus test-native-pipeline-256 PACKED MODEL_DIR OUTPUT");
            return 2;
        };
        guard let option::Option[text::Text]::Some(output_path) = env::arg(4 as usize) else {
            io::eprintln("usage: qwen-image-cplus test-native-pipeline-256 PACKED MODEL_DIR OUTPUT");
            return 2;
        };
        return pipeline::test_native_256(
            packed_path.view(),
            model_path.view(),
            output_path.view(),
        );
    }
    if command == "test-image-output" {
        guard let option::Option[text::Text]::Some(output_path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus test-image-output OUTPUT [FIXTURE_DIR]");
            return 2;
        };
        match env::arg(3 as usize) {
            option::Option[text::Text]::Some(fixtures) => {
                return image_output::run_reference(output_path.view(), fixtures.view());
            }
            option::Option[text::Text]::None => {
                return image_output::run_reference(output_path.view());
            }
        }
    }
    if command == "test-tokenizer" {
        guard let option::Option[text::Text]::Some(model_path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus test-tokenizer MODEL_DIR [FIXTURE_DIR]");
            return 2;
        };
        match env::arg(3 as usize) {
            option::Option[text::Text]::Some(fixtures) => {
                return tokenizer::run(model_path.view(), fixtures.view());
            }
            option::Option[text::Text]::None => {
                return tokenizer::run(model_path.view());
            }
        }
    }
    if command == "test-text-encoder" {
        guard let option::Option[text::Text]::Some(model_path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus test-text-encoder MODEL_DIR");
            return 2;
        };
        return qwen3vl_text::run(model_path.view());
    }
    if command == "quantize-block0" {
        guard let option::Option[text::Text]::Some(model_path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus quantize-block0 MODEL_DIR OUTPUT");
            return 2;
        };
        guard let option::Option[text::Text]::Some(output_path) = env::arg(3 as usize) else {
            io::eprintln("usage: qwen-image-cplus quantize-block0 MODEL_DIR OUTPUT");
            return 2;
        };
        return packed_model::quantize_block0(model_path.view(), output_path.view());
    }
    if command == "quantize-transformer" {
        guard let option::Option[text::Text]::Some(model_path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus quantize-transformer MODEL_DIR OUTPUT");
            return 2;
        };
        guard let option::Option[text::Text]::Some(output_path) = env::arg(3 as usize) else {
            io::eprintln("usage: qwen-image-cplus quantize-transformer MODEL_DIR OUTPUT");
            return 2;
        };
        return packed_model::quantize_transformer(model_path.view(), output_path.view());
    }
    if command == "verify-packed" {
        guard let option::Option[text::Text]::Some(path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus verify-packed FILE");
            return 2;
        };
        return packed_model::verify_packed(path.view());
    }
    if command == "verify-packed-source" {
        guard let option::Option[text::Text]::Some(path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus verify-packed-source FILE MODEL_DIR");
            return 2;
        };
        guard let option::Option[text::Text]::Some(model_path) = env::arg(3 as usize) else {
            io::eprintln("usage: qwen-image-cplus verify-packed-source FILE MODEL_DIR");
            return 2;
        };
        return packed_model::verify_packed_source(path.view(), model_path.view());
    }
    if command == "inspect" {
        guard let option::Option[text::Text]::Some(path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus inspect FILE [NAME_FILTER]");
            return 2;
        };
        match env::arg(3 as usize) {
            option::Option[text::Text]::Some(filter) => { return safetensors::inspect(path, filter); }
            option::Option[text::Text]::None => { return safetensors::inspect(path); }
        }
    }
    if command == "verify-model" || command == "verify" {
        guard let option::Option[text::Text]::Some(path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus verify-model MODEL_DIR");
            return 2;
        };
        return model_inventory::verify_model(path);
    }

    io::eprintln("unknown command: ${command}");
    return 2;
}
