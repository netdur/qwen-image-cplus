import "./metal_probe" as metal_probe;
import "./metal_primitives" as metal_primitives;
import "./metal_linear" as metal_linear;
import "./metal_int8_linear" as metal_int8_linear;
import "./transformer_block" as transformer_block;
import "./packed_model" as packed_model;
import "./model_inventory" as model_inventory;
import "./safetensors" as safetensors;
import "./scheduler" as scheduler;
import "./vae" as vae;
import "./tensor" as tensor;
import "./cpu_ops" as cpu_ops;
import "stdlib/env" as env;
import "stdlib/io" as io;
import "stdlib/option" as option;
import "stdlib/text" as text;

fn main() -> i32 {
    if env::argc() < (2 as usize) {
        io::println(
            "usage: qwen-image-cplus <probe | probe-stress | test-metal-primitives | test-metal-linear | benchmark-linear | test-metal-int8-linear | benchmark-int8-linear | test-attention-cache [FIXTURE_DIR] | benchmark-attention | test-transformer-block MODEL_DIR [FIXTURE_DIR] | test-transformer-block-int8 PACKED [FIXTURE_DIR] | test-transformer-mixed PACKED [FIXTURE_DIR] | test-transformer-complete PACKED [FIXTURE_DIR] | test-transformer-scale PACKED 256|512|1024 [FIXTURE_ROOT] | test-transformer-trajectory PACKED 1|2|40 [FIXTURE_DIR] | test-vae-decoder MODEL_DIR small|256 [FIXTURE_ROOT] | quantize-block0 MODEL_DIR OUTPUT | quantize-transformer MODEL_DIR OUTPUT | verify-packed FILE | verify-packed-source FILE MODEL_DIR | inspect FILE | verify-model MODEL_DIR>",
        );
        return 0;
    }

    guard let option::Option[text::Text]::Some(command) = env::arg(1 as usize) else {
        io::eprintln("missing command");
        return 2;
    };

    if command == "probe" {
        return metal_probe::run();
    }
    if command == "probe-stress" {
        return metal_probe::stress();
    }
    if command == "test-metal-primitives" {
        return metal_primitives::run();
    }
    if command == "test-metal-linear" {
        return metal_linear::run_validation();
    }
    if command == "benchmark-linear" {
        return metal_linear::run_benchmark();
    }
    if command == "test-metal-int8-linear" {
        return metal_int8_linear::run_validation();
    }
    if command == "benchmark-int8-linear" {
        return metal_int8_linear::run_benchmark();
    }
    if command == "test-attention-cache" {
        match env::arg(2 as usize) {
            option::Option[text::Text]::Some(fixtures) => {
                return transformer_block::test_attention_cache(fixtures.view());
            }
            option::Option[text::Text]::None => {
                return transformer_block::test_attention_cache();
            }
        }
    }
    if command == "benchmark-attention" {
        return transformer_block::benchmark_attention();
    }
    if command == "test-transformer-block" {
        guard let option::Option[text::Text]::Some(path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus test-transformer-block MODEL_DIR [FIXTURE_DIR]");
            return 2;
        };
        match env::arg(3 as usize) {
            option::Option[text::Text]::Some(fixtures) => {
                return transformer_block::run(path.view(), fixtures.view());
            }
            option::Option[text::Text]::None => {
                return transformer_block::run(path.view());
            }
        }
    }
    if command == "test-transformer-block-int8" {
        guard let option::Option[text::Text]::Some(path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus test-transformer-block-int8 PACKED [FIXTURE_DIR]");
            return 2;
        };
        match env::arg(3 as usize) {
            option::Option[text::Text]::Some(fixtures) => {
                return transformer_block::run_packed(path.view(), fixtures.view());
            }
            option::Option[text::Text]::None => {
                return transformer_block::run_packed(path.view());
            }
        }
    }
    if command == "test-transformer-mixed" {
        guard let option::Option[text::Text]::Some(path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus test-transformer-mixed PACKED [FIXTURE_DIR]");
            return 2;
        };
        match env::arg(3 as usize) {
            option::Option[text::Text]::Some(fixtures) => {
                return transformer_block::run_full_packed(path.view(), fixtures.view());
            }
            option::Option[text::Text]::None => {
                return transformer_block::run_full_packed(path.view());
            }
        }
    }
    if command == "test-transformer-complete" {
        guard let option::Option[text::Text]::Some(path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus test-transformer-complete PACKED [FIXTURE_DIR]");
            return 2;
        };
        match env::arg(3 as usize) {
            option::Option[text::Text]::Some(fixtures) => {
                return transformer_block::run_complete_packed(path.view(), fixtures.view());
            }
            option::Option[text::Text]::None => {
                return transformer_block::run_complete_packed(path.view());
            }
        }
    }
    if command == "test-transformer-scale" {
        guard let option::Option[text::Text]::Some(path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus test-transformer-scale PACKED 256|512|1024 [FIXTURE_ROOT]");
            return 2;
        };
        guard let option::Option[text::Text]::Some(pixels) = env::arg(3 as usize) else {
            io::eprintln("usage: qwen-image-cplus test-transformer-scale PACKED 256|512|1024 [FIXTURE_ROOT]");
            return 2;
        };
        match env::arg(4 as usize) {
            option::Option[text::Text]::Some(fixtures) => {
                return transformer_block::run_scale_packed(path.view(), pixels.view(), fixtures.view());
            }
            option::Option[text::Text]::None => {
                return transformer_block::run_scale_packed(path.view(), pixels.view());
            }
        }
    }
    if command == "test-transformer-trajectory" {
        guard let option::Option[text::Text]::Some(path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus test-transformer-trajectory PACKED 1|2|40 [FIXTURE_DIR]");
            return 2;
        };
        guard let option::Option[text::Text]::Some(steps) = env::arg(3 as usize) else {
            io::eprintln("usage: qwen-image-cplus test-transformer-trajectory PACKED 1|2|40 [FIXTURE_DIR]");
            return 2;
        };
        match env::arg(4 as usize) {
            option::Option[text::Text]::Some(fixtures) => {
                return transformer_block::run_trajectory_packed(path.view(), steps.view(), fixtures.view());
            }
            option::Option[text::Text]::None => {
                return transformer_block::run_trajectory_packed(path.view(), steps.view());
            }
        }
    }
    if command == "test-vae-decoder" {
        guard let option::Option[text::Text]::Some(path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus test-vae-decoder MODEL_DIR small|256 [FIXTURE_ROOT]");
            return 2;
        };
        guard let option::Option[text::Text]::Some(test_case) = env::arg(3 as usize) else {
            io::eprintln("usage: qwen-image-cplus test-vae-decoder MODEL_DIR small|256 [FIXTURE_ROOT]");
            return 2;
        };
        match env::arg(4 as usize) {
            option::Option[text::Text]::Some(fixtures) => {
                return vae::run(path.view(), test_case.view(), fixtures.view());
            }
            option::Option[text::Text]::None => {
                return vae::run(path.view(), test_case.view());
            }
        }
    }
    if command == "quantize-block0" {
        guard let option::Option[text::Text]::Some(model_path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus quantize-block0 MODEL_DIR OUTPUT");
            return 2;
        };
        guard let option::Option[text::Text]::Some(output_path) = env::arg(3 as usize) else {
            io::eprintln("usage: qwen-image-cplus quantize-block0 MODEL_DIR OUTPUT");
            return 2;
        };
        return packed_model::quantize_block0(model_path.view(), output_path.view());
    }
    if command == "quantize-transformer" {
        guard let option::Option[text::Text]::Some(model_path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus quantize-transformer MODEL_DIR OUTPUT");
            return 2;
        };
        guard let option::Option[text::Text]::Some(output_path) = env::arg(3 as usize) else {
            io::eprintln("usage: qwen-image-cplus quantize-transformer MODEL_DIR OUTPUT");
            return 2;
        };
        return packed_model::quantize_transformer(model_path.view(), output_path.view());
    }
    if command == "verify-packed" {
        guard let option::Option[text::Text]::Some(path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus verify-packed FILE");
            return 2;
        };
        return packed_model::verify_packed(path.view());
    }
    if command == "verify-packed-source" {
        guard let option::Option[text::Text]::Some(path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus verify-packed-source FILE MODEL_DIR");
            return 2;
        };
        guard let option::Option[text::Text]::Some(model_path) = env::arg(3 as usize) else {
            io::eprintln("usage: qwen-image-cplus verify-packed-source FILE MODEL_DIR");
            return 2;
        };
        return packed_model::verify_packed_source(path.view(), model_path.view());
    }
    if command == "inspect" {
        guard let option::Option[text::Text]::Some(path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus inspect FILE [NAME_FILTER]");
            return 2;
        };
        match env::arg(3 as usize) {
            option::Option[text::Text]::Some(filter) => { return safetensors::inspect(path, filter); }
            option::Option[text::Text]::None => { return safetensors::inspect(path); }
        }
    }
    if command == "verify-model" || command == "verify" {
        guard let option::Option[text::Text]::Some(path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus verify-model MODEL_DIR");
            return 2;
        };
        return model_inventory::verify_model(path);
    }

    io::eprintln("unknown command: ${command}");
    return 2;
}
