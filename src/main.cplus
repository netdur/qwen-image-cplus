fn parse_u64_decimal(value: str) -> option::Option[u64] {
    if value.count() == (0 as usize) { return option::Option[u64]::None; }
    var result: u64 = 0 as u64;
    var index: usize = 0 as usize;
    while index < value.count() {
        guard let option::Option[u8]::Some(byte) = value.byte_at(index) else {
            return option::Option[u64]::None;
        };
        if byte < (48 as u8) || byte > (57 as u8) {
            return option::Option[u64]::None;
        }
        let digit: u64 = (byte -% (48 as u8)) as u64;
        if result > ((18446744073709551615 as u64) -% digit) / (10 as u64) {
            return option::Option[u64]::None;
        }
        result = result *% (10 as u64) +% digit;
        index = index +% (1 as usize);
    }
    return option::Option[u64]::Some(result);
}

#[test]
fn decimal_seed_parser_checks_syntax_and_overflow() {
    guard let option::Option[u64]::Some(zero) = parse_u64_decimal("0") else {
        assert false;
        return;
    };
    guard let option::Option[u64]::Some(seed) = parse_u64_decimal("1101") else {
        assert false;
        return;
    };
    guard let option::Option[u64]::Some(maximum) = parse_u64_decimal("18446744073709551615") else {
        assert false;
        return;
    };
    assert zero == (0 as u64);
    assert seed == (1101 as u64);
    assert maximum == (18446744073709551615 as u64);
    match parse_u64_decimal("") {
        option::Option[u64]::None => {}
        option::Option[u64]::Some(_) => { assert false; }
    }
    match parse_u64_decimal("-1") {
        option::Option[u64]::None => {}
        option::Option[u64]::Some(_) => { assert false; }
    }
    match parse_u64_decimal("18446744073709551616") {
        option::Option[u64]::None => {}
        option::Option[u64]::Some(_) => { assert false; }
    }
}

