    guard let option::Option[f64]::Some(_warmup) = dispatch_direct_half4_gemm(
        queue, pipeline, input, weights, scales, output, params, rows_per_group,
    ) else { return option::Option[f64]::None; };
    var total_ms: f64 = 0.0f64;
    var repetition: usize = 0 as usize;
    while repetition < (5 as usize) {
        guard let option::Option[f64]::Some(elapsed) = dispatch_direct_half4_gemm(
            queue, pipeline, input, weights, scales, output, params, rows_per_group,
        ) else { return option::Option[f64]::None; };
        total_ms = total_ms + elapsed;
        repetition = repetition +% (1 as usize);
    }
    return option::Option[f64]::Some(total_ms / 5.0f64);
}

fn benchmark_gemm(
    device: metal::Device,
    queue: metal::CommandQueue,
    fp16_pipeline: metal::ComputePipelineState,
    q4_pipeline: metal::ComputePipelineState,
    q4_direct_pipeline: metal::ComputePipelineState,
    scale_pipeline: metal::ComputePipelineState,
    direct_half4_pipeline: metal::ComputePipelineState,
    direct_half4_8_pipeline: metal::ComputePipelineState,
    direct_half4_16_pipeline: metal::ComputePipelineState,
    fp16_weights: metal::Buffer,
    q4_weights: metal::Buffer,
    scales: metal::Buffer,
) -> bool {
    let rows: usize = 256;
    let output_columns: usize = 4096;
    let input_columns: usize = 4096;
    guard let option::Option[metal::Buffer]::Some(input) = new_buffer(
        device, (rows *% input_columns *% #size_of::[u16]()) as u64,
    ) else { return false; };
    let input_owner: OwnedObjc = OwnedObjc::new(input.raw());
    guard let option::Option[metal::Buffer]::Some(output) = new_buffer(
        device, (rows *% output_columns *% #size_of::[f32]()) as u64,
    ) else { return false; };
    let output_owner: OwnedObjc = OwnedObjc::new(output.raw());
    guard let option::Option[metal::Buffer]::Some(interleaved_weights) = new_buffer(
        device, (output_columns *% input_columns / (2 as usize)) as u64,
    ) else { return false; };
    let interleaved_weights_owner: OwnedObjc = OwnedObjc::new(interleaved_weights.raw());
    let interleaved_values: *u16 = interleaved_weights.contents() as *u16;
    let packed_word: u16 = pack_q4(0 as i32, 1 as i32, 2 as i32, 3 as i32);
    var interleaved_index: usize = 0 as usize;
    while interleaved_index < output_columns *% input_columns / (4 as usize) {
        interleaved_values[interleaved_index] = packed_word;
        interleaved_index = interleaved_index +% (1 as usize);
    }
    let input_values: *u16 = input.contents() as *u16;
    var index: usize = 0 as usize;
    while index < rows *% input_columns {
        input_values[index] = cpu::f32_to_fp16(0.0625f32);
        index = index +% (1 as usize);
    }
    var params: Q4GemmParams = Q4GemmParams {
        rows: rows as u32,
        output_columns: output_columns as u32,
        input_columns: input_columns as u32,
        reserved: 0 as u32,
    };
    guard let option::Option[f64]::Some(fp16_ms) = average_gemm(
        queue, fp16_pipeline, input, fp16_weights, scales, output, #addr_of(params),
    ) else { return false; };
    guard let option::Option[f64]::Some(q4_ms) = average_gemm(
        queue, q4_pipeline, input, q4_weights, scales, output, #addr_of(params),
    ) else { return false; };
    guard let option::Option[f64]::Some(q4_direct_ms) = average_gemm(
        queue, q4_direct_pipeline, input, q4_weights, scales, output, #addr_of(params),
    ) else { return false; };
    guard let option::Option[f64]::Some(q4_complete_ms) = average_gemm_then_scale(
        queue,
        q4_direct_pipeline,
        scale_pipeline,
        input,
        q4_weights,
        scales,
        output,
        #addr_of(params),
    ) else { return false; };
    guard let option::Option[f64]::Some(direct_half4_ms) = average_direct_half4_gemm(
        queue,
        direct_half4_pipeline,
        input,
        interleaved_weights,
        scales,
        output,
        #addr_of(params),
        4 as u32,
    ) else { return false; };
    guard let option::Option[f64]::Some(direct_half4_8_ms) = average_direct_half4_gemm(
        queue,
        direct_half4_8_pipeline,
        input,
        interleaved_weights,
        scales,
        output,
        #addr_of(params),
        8 as u32,
    ) else { return false; };
    guard let option::Option[f64]::Some(direct_half4_16_ms) = average_direct_half4_gemm(
        queue,
        direct_half4_16_pipeline,
        input,
        interleaved_weights,
        scales,
        output,
        #addr_of(params),
        16 as u32,
    ) else { return false; };
    let operations: f64 =
        2.0f64 * rows as f64 * output_columns as f64 * input_columns as f64;
    io::println(
        "FP16 GEMM M=256 N=4096 K=4096: time=${fp16_ms} ms TFLOP/s=${operations / (fp16_ms * 1000000000.0f64)}",
    );
    io::println(
        "Q4 destination-expand GEMM M=256 N=4096 K=4096: time=${q4_ms} ms TFLOP/s=${operations / (q4_ms * 1000000000.0f64)} speedup=${fp16_ms / q4_ms}x",
    );
    io::println(
        "Q4 unscaled direct GEMM M=256 N=4096 K=4096: time=${q4_direct_ms} ms TFLOP/s=${operations / (q4_direct_ms * 1000000000.0f64)} speedup=${fp16_ms / q4_direct_ms}x",
    );
    io::println(
        "Q4 direct GEMM + destination scale M=256 N=4096 K=4096: time=${q4_complete_ms} ms effective-TFLOP/s=${operations / (q4_complete_ms * 1000000000.0f64)} speedup=${fp16_ms / q4_complete_ms}x",
    );
    io::println(
        "direct packed-Q4 half4 GEMM M=256 N=4096 K=4096: time=${direct_half4_ms} ms effective-TFLOP/s=${operations / (direct_half4_ms * 1000000000.0f64)} speedup=${fp16_ms / direct_half4_ms}x",
    );
    io::println(
        "direct packed-Q4 half4 8-row GEMM M=256 N=4096 K=4096: time=${direct_half4_8_ms} ms effective-TFLOP/s=${operations / (direct_half4_8_ms * 1000000000.0f64)} speedup=${fp16_ms / direct_half4_8_ms}x",
    );
    io::println(
        "direct packed-Q4 half4 16-row GEMM M=256 N=4096 K=4096: time=${direct_half4_16_ms} ms effective-TFLOP/s=${operations / (direct_half4_16_ms * 1000000000.0f64)} speedup=${fp16_ms / direct_half4_16_ms}x",
    );
    let output_values: *f32 = output.contents() as *f32;
    index = 0 as usize;
    while index < rows *% output_columns {
        if (output_values[index] - 48.0f32).abs() > 0.0001f32 {
            io::eprintln("Q4 GEMM benchmark: invalid output ${index}: ${output_values[index]}");
            return false;
        }
        index = index +% (1 as usize);
    }
    return true;
}

fn benchmark(
    device: metal::Device,
    queue: metal::CommandQueue,
    fp16_pipeline: metal::ComputePipelineState,
    half4_pipeline: metal::ComputePipelineState,
    scalar_pipeline: metal::ComputePipelineState,
    fp16_gemm_pipeline: metal::ComputePipelineState,
    q4_gemm_pipeline: metal::ComputePipelineState,
    q4_direct_pipeline: metal::ComputePipelineState,
    scale_pipeline: metal::ComputePipelineState,
    direct_half4_pipeline: metal::ComputePipelineState,
    direct_half4_8_pipeline: metal::ComputePipelineState,
    direct_half4_16_pipeline: metal::ComputePipelineState,
) -> bool {
    let vector_count: usize = 16384;
    let dimension: usize = 4096;
    let words_per_row: usize = dimension / (4 as usize);
    let fp16_weight_bytes: u64 =
        (vector_count *% dimension *% #size_of::[u16]()) as u64;
    let q4_weight_bytes: u64 =
        (vector_count *% words_per_row *% #size_of::[u16]()) as u64;
    guard let option::Option[metal::Buffer]::Some(query) =
        new_buffer(device, (dimension *% #size_of::[u16]()) as u64) else { return false; };
    let query_owner: OwnedObjc = OwnedObjc::new(query.raw());
    guard let option::Option[metal::Buffer]::Some(fp16_weights) =
        new_buffer(device, fp16_weight_bytes) else { return false; };
    let fp16_weights_owner: OwnedObjc = OwnedObjc::new(fp16_weights.raw());
    guard let option::Option[metal::Buffer]::Some(q4_weights) =
        new_buffer(device, q4_weight_bytes) else { return false; };
    let q4_weights_owner: OwnedObjc = OwnedObjc::new(q4_weights.raw());
    guard let option::Option[metal::Buffer]::Some(scales) =
        new_buffer(device, (vector_count *% #size_of::[u16]()) as u64) else { return false; };
    let scales_owner: OwnedObjc = OwnedObjc::new(scales.raw());
    guard let option::Option[metal::Buffer]::Some(output) =
        new_buffer(device, (vector_count *% #size_of::[f32]()) as u64) else { return false; };
    let output_owner: OwnedObjc = OwnedObjc::new(output.raw());

    let query_values: *u16 = query.contents() as *u16;
    var index: usize = 0 as usize;
    while index < dimension {
        query_values[index] = cpu::f32_to_fp16(0.0625f32);
        index = index +% (1 as usize);
    }
    let fp16_values: *u16 = fp16_weights.contents() as *u16;
    index = 0 as usize;
    while index < vector_count *% dimension {
        let q: f32 = (index % (4 as usize)) as f32;
        fp16_values[index] = cpu::f32_to_fp16(q * 0.125f32);
        index = index +% (1 as usize);
    }
    let packed_word: u16 = pack_q4(0 as i32, 1 as i32, 2 as i32, 3 as i32);
    let q4_values: *u16 = q4_weights.contents() as *u16;
    index = 0 as usize;
    while index < vector_count *% words_per_row {
        q4_values[index] = packed_word;
        index = index +% (1 as usize);
    }
    let scale_bits: u16 = cpu::f32_to_fp16(0.125f32);
    let scale_values: *u16 = scales.contents() as *u16;
    index = 0 as usize;
    while index < vector_count {
        scale_values[index] = scale_bits;
        index = index +% (1 as usize);
    }

    var params: Q4DotParams = Q4DotParams {
        vector_count: vector_count as u32,
        dimension: dimension as u32,
    };
    guard let option::Option[f64]::Some(fp16_ms) = average_dispatch(
        queue, fp16_pipeline, query, fp16_weights, scales, output, #addr_of(params),
    ) else { return false; };
    guard let option::Option[f64]::Some(half4_ms) = average_dispatch(
        queue, half4_pipeline, query, q4_weights, scales, output, #addr_of(params),
    ) else { return false; };
    guard let option::Option[f64]::Some(scalar_ms) = average_dispatch(
        queue, scalar_pipeline, query, q4_weights, scales, output, #addr_of(params),
    ) else { return false; };

    let fp16_gbps: f64 = fp16_weight_bytes as f64 / (fp16_ms * 1000000.0f64);
    let half4_gbps: f64 = q4_weight_bytes as f64 / (half4_ms * 1000000.0f64);
    let scalar_gbps: f64 = q4_weight_bytes as f64 / (scalar_ms * 1000000.0f64);
    io::println(
        "FP16 stream: weights=${fp16_weight_bytes} bytes time=${fp16_ms} ms effective=${fp16_gbps} GB/s",
    );
    io::println(
        "Q4 half4: weights=${q4_weight_bytes} bytes time=${half4_ms} ms effective=${half4_gbps} GB/s speedup=${fp16_ms / half4_ms}x",
    );
    io::println(
        "Q4 scalar: weights=${q4_weight_bytes} bytes time=${scalar_ms} ms effective=${scalar_gbps} GB/s speedup=${fp16_ms / scalar_ms}x",
    );
    let expected: f32 = 48.0f32;
    let output_values: *f32 = output.contents() as *f32;
    index = 0 as usize;
    while index < vector_count {
        if (output_values[index] - expected).abs() > 0.0001f32 {
            io::eprintln("Q4 dot benchmark: invalid output ${index}: ${output_values[index]}");
            return false;
        }
        index = index +% (1 as usize);
    }
    return benchmark_gemm(
        device,
        queue,
        fp16_gemm_pipeline,
        q4_gemm_pipeline,
        q4_direct_pipeline,
        scale_pipeline,
        direct_half4_pipeline,
        direct_half4_8_pipeline,
        direct_half4_16_pipeline,
        fp16_weights,
        q4_weights,
        scales,
    );
}

fn run_mode(benchmark_mode: bool) -> i32 {
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return 1; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    let device_pointer: *u8 = MTLCreateSystemDefaultDevice();
    if device_pointer.is_null() {
        io::eprintln("Q4 dot: no Metal device");
        return 1;
    }
    let device_owner: OwnedObjc = OwnedObjc::new(rt::retain(device_pointer));
    let device: metal::Device = metal::Device::from_raw(device_owner.raw());
    guard let option::Option[metal::CommandQueue]::Some(queue) =
        device.new_command_queue() else { return 1; };
    let queue_owner: OwnedObjc = OwnedObjc::new(queue.raw());
    let options_pointer: *u8 = rt::alloc_init(#str_ptr("MTLCompileOptions\0"));
    if options_pointer.is_null() { return 1; }
    let options_owner: OwnedObjc = OwnedObjc::new(options_pointer);
    let options: metal::CompileOptions = metal::CompileOptions::from_raw(options_owner.raw());
    options.set_fast_math_enabled(false);
    var compile_error: *u8 = 0 as *u8;
    guard let option::Option[metal::Library]::Some(library) = device.new_library_with_source(
        #include_str("../kernels/q4_dot.metal"),
        options,
        #addr_of(compile_error) as *u8,
    ) else {
        if !compile_error.is_null() {
            let description: *u8 = rt::msg_id(
                compile_error, rt::sel(#str_ptr("localizedDescription\0")),
            );
            io::eprintln("Q4 dot Metal compile: ${bridge::to_text(description)}");
        }
        return 1;
    };
    let library_owner: OwnedObjc = OwnedObjc::new(library.raw());
    guard let option::Option[[OwnedObjc; 2]]::Some(fp16_objects) = make_pipeline(
        device, library, "qi_fp16_streaming_dot",
    ) else { return 1; };
    guard let option::Option[[OwnedObjc; 2]]::Some(half4_objects) = make_pipeline(
        device, library, "qi_q4_streaming_dot_half4",
    ) else { return 1; };
    guard let option::Option[[OwnedObjc; 2]]::Some(scalar_objects) = make_pipeline(
        device, library, "qi_q4_streaming_dot_scalar",
    ) else { return 1; };
    guard let option::Option[[OwnedObjc; 2]]::Some(fp16_gemm_objects) = make_pipeline(
        device, library, "qi_fp16_gemm_64x64",
    ) else { return 1; };
    guard let option::Option[[OwnedObjc; 2]]::Some(q4_gemm_objects) = make_pipeline(
        device, library, "qi_q4_gemm_64x64",
    ) else { return 1; };
    guard let option::Option[[OwnedObjc; 2]]::Some(q4_direct_objects) = make_pipeline(
        device, library, "qi_q4_gemm_64x64_unscaled_direct",
    ) else { return 1; };
    guard let option::Option[[OwnedObjc; 2]]::Some(scale_objects) = make_pipeline(
        device, library, "qi_q4_scale_output",
    ) else { return 1; };
    guard let option::Option[[OwnedObjc; 2]]::Some(direct_half4_objects) = make_pipeline(
        device, library, "qi_q4_direct_half4_gemm_4x32_interleaved",
    ) else { return 1; };
    guard let option::Option[[OwnedObjc; 2]]::Some(direct_half4_8_objects) = make_pipeline(
        device, library, "qi_q4_direct_half4_gemm_8x32_interleaved",
    ) else { return 1; };
    guard let option::Option[[OwnedObjc; 2]]::Some(direct_half4_16_objects) = make_pipeline(
        device, library, "qi_q4_direct_half4_gemm_16x32_interleaved",
    ) else { return 1; };
    let fp16_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(
        fp16_objects[1].raw(),
    );
    let half4_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(
        half4_objects[1].raw(),
    );
    let scalar_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(
        scalar_objects[1].raw(),
    );
    let fp16_gemm_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(
        fp16_gemm_objects[1].raw(),
    );
    let q4_gemm_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(
        q4_gemm_objects[1].raw(),
    );
    let q4_direct_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(
        q4_direct_objects[1].raw(),
    );
    let scale_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(
        scale_objects[1].raw(),
    );
    let direct_half4_pipeline: metal::ComputePipelineState =
        metal::ComputePipelineState::from_raw(direct_half4_objects[1].raw());
    let direct_half4_8_pipeline: metal::ComputePipelineState =
        metal::ComputePipelineState::from_raw(direct_half4_8_objects[1].raw());
    let direct_half4_16_pipeline: metal::ComputePipelineState =
        metal::ComputePipelineState::from_raw(direct_half4_16_objects[1].raw());
    if !benchmark_mode {
        if validate(
            device,
            queue,
            fp16_pipeline,
            half4_pipeline,
            scalar_pipeline,
            fp16_gemm_pipeline,
            q4_gemm_pipeline,
            q4_direct_pipeline,
            scale_pipeline,
            direct_half4_pipeline,
            direct_half4_8_pipeline,
            direct_half4_16_pipeline,
        ) {
            io::println("Metal packed Q4 dot validation: ok");
            return 0;
        }
        return 1;
    }
    if benchmark(
        device,
        queue,
        fp16_pipeline,
        half4_pipeline,
        scalar_pipeline,
        fp16_gemm_pipeline,
        q4_gemm_pipeline,
        q4_direct_pipeline,
        scale_pipeline,
        direct_half4_pipeline,
        direct_half4_8_pipeline,
        direct_half4_16_pipeline,
    ) {
        io::println("Metal packed Q4 dot benchmark: ok");
        return 0;
    }
    return 1;
}

fn run_validation() -> i32 {
    return run_mode(false);
}

fn run_benchmark() -> i32 {
    return run_mode(true);
}

fn run_integer_probe() -> i32 {
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return 1; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    let device_pointer: *u8 = MTLCreateSystemDefaultDevice();
    if device_pointer.is_null() {
        io::eprintln("Q4 integer probe: no Metal device");
        return 1;
    }
    let device_owner: OwnedObjc = OwnedObjc::new(rt::retain(device_pointer));
    let device: metal::Device = metal::Device::from_raw(device_owner.raw());
    let options_pointer: *u8 = rt::alloc_init(#str_ptr("MTLCompileOptions\0"));
    if options_pointer.is_null() { return 1; }
    let options_owner: OwnedObjc = OwnedObjc::new(options_pointer);
    let options: metal::CompileOptions = metal::CompileOptions::from_raw(options_owner.raw());
    options.set_fast_math_enabled(false);
    var compile_error: *u8 = 0 as *u8;
    guard let option::Option[metal::Library]::Some(library) = device.new_library_with_source(
        #include_str("../kernels/q4_integer_probe.metal"),
        options,
        #addr_of(compile_error) as *u8,
    ) else {
        if !compile_error.is_null() {
            let description: *u8 = rt::msg_id(
                compile_error, rt::sel(#str_ptr("localizedDescription\0")),
            );
            io::println("Metal signed-char4 dot: unsupported (${bridge::to_text(description)})");
        } else {
            io::println("Metal signed-char4 dot: unsupported");
        }
        return 0;
    };
    let library_owner: OwnedObjc = OwnedObjc::new(library.raw());
    guard let option::Option[metal::Function]::Some(function) =
        library.new_function_with_name("qi_probe_char4_dot") else {
        io::println("Metal signed-char4 dot: compiler accepted source but no function exists");
        return 1;
    };
    let function_owner: OwnedObjc = OwnedObjc::new(function.raw());
    guard let option::Option[metal::ComputePipelineState]::Some(pipeline) =
        device.new_compute_pipeline_state_with_function(function, 0 as *u8) else {
        io::println("Metal signed-char4 dot: function exists but pipeline creation failed");
        return 1;
    };
    let pipeline_owner: OwnedObjc = OwnedObjc::new(pipeline.raw());
    io::println("Metal signed-char4 dot: supported");
    return 0;
}

#[test]
fn signed_q4_pack_roundtrips_all_representable_values() {
    var a: i32 = -8 as i32;
    while a <= (7 as i32) {
        var b: i32 = -8 as i32;
        while b <= (7 as i32) {
            var c: i32 = -8 as i32;
            while c <= (7 as i32) {
                var d: i32 = -8 as i32;
                while d <= (7 as i32) {
                    let word: u16 = pack_q4(a, b, c, d);
                    assert decode_q4(word, 0 as u16) == a;
                    assert decode_q4(word, 4 as u16) == b;
                    assert decode_q4(word, 8 as u16) == c;
                    assert decode_q4(word, 12 as u16) == d;
                    d = d +% (1 as i32);
                }
                c = c +% (1 as i32);
            }
            b = b +% (1 as i32);
        }
        a = a +% (1 as i32);
    }
}

#[test]
fn q4_dot_parameters_match_metal_abi() {
    assert #size_of::[Q4DotParams]() == (8 as usize);
    assert #size_of::[Q4GemmParams]() == (16 as usize);
    assert (256 as usize) % (4 as usize) == (0 as usize);
    assert (4096 as usize) % (4 as usize) == (0 as usize);
}
