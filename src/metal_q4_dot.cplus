    ) else { return option::Option[f64]::None; };
    var total_ms: f64 = 0.0f64;
    var repetition: usize = 0 as usize;
    while repetition < (5 as usize) {
        guard let option::Option[f64]::Some(elapsed) = dispatch_gemm_then_scale(
            queue, gemm_pipeline, scale_pipeline, input, weights, scales, output, params,
        ) else { return option::Option[f64]::None; };
        total_ms = total_ms + elapsed;
        repetition = repetition +% (1 as usize);
    }
    return option::Option[f64]::Some(total_ms / 5.0f64);
}

fn average_direct_half4_gemm(
    queue: metal::CommandQueue,
    pipeline: metal::ComputePipelineState,
    input: metal::Buffer,
    weights: metal::Buffer,
    scales: metal::Buffer,
    output: metal::Buffer,
    params: *Q4GemmParams,
    rows_per_group: u32,
