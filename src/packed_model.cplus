import "./cpu_ops" as cpu;
import "./mmap_macos" as mapped;
import "./safetensors" as safetensors;
import "stdlib/io" as io;
import "stdlib/math" as _;
import "stdlib/option" as option;
import "stdlib/text" as text;
import "stdlib/vec" as vec;
import "stdlib/status" as status;

#[link_name = "open"]
extern fn qi_pack_open(path: *u8, flags: i32, mode: i32) -> i32;
#[link_name = "write"]
extern fn qi_pack_write(fd: i32, bytes: *u8, count: usize) -> isize;
#[link_name = "lseek"]
extern fn qi_pack_lseek(fd: i32, offset: i64, whence: i32) -> i64;
#[link_name = "fsync"]
extern fn qi_pack_fsync(fd: i32) -> i32;
#[link_name = "fchmod"]
extern fn qi_pack_fchmod(fd: i32, mode: u16) -> i32;
#[link_name = "close"]
extern fn qi_pack_close(fd: i32) -> i32;
#[link_name = "rename"]
extern fn qi_pack_rename(source: *u8, destination: *u8) -> i32;
#[link_name = "unlink"]
extern fn qi_pack_unlink(path: *u8) -> i32;
extern fn malloc(size: usize) -> *u8;
extern fn free(pointer: *u8);

const VERSION: u32 = 1;
const HEADER_BYTES: u64 = 256;
const RECORD_BYTES: u64 = 256;
const DATA_ALIGNMENT: u64 = 4096;
const TENSOR_ALIGNMENT: u64 = 256;
const TENSOR_COUNT: usize = 9;
const O_WRONLY: i32 = 1;
const O_CREAT: i32 = 0x0200;
const O_TRUNC: i32 = 0x0400;
const SEEK_SET: i32 = 0;
const SCHEME_BF16: u32 = 0;
const SCHEME_INT8_AFFINE: u32 = 3;
const TYPE_NONE: u32 = 0;
const TYPE_F16: u32 = 1;
const TYPE_U8: u32 = 2;
const FNV_OFFSET: u64 = 14695981039346656037;
const FNV_PRIME: u64 = 1099511628211;
const SNAPSHOT: str = "b3179ad355be050328e483a9dfdd9e60cd62adfa";
const DIFFUSERS_COMMIT: str = "80c7ed262aeffbeb43ef13ae04baeb9b84515a69";

#[repr(C)]
struct PackedHeader {
    magic: [u8; 8],
    version: u32,
    header_bytes: u32,
    tensor_count: u32,
    scope: u32,
    directory_offset: u64,
    data_offset: u64,
    file_bytes: u64,
    payload_checksum: u64,
    model_snapshot: [u8; 40],
    diffusers_commit: [u8; 40],
    policy: [u8; 32],
    reserved: [u8; 88],
}

#[repr(C)]
struct PackedRecord {
    name: [u8; 128],
    scheme: u32,
    rank: u32,
    dimensions: [u64; 4],
    group_axis: u32,
    group_size: u32,
    scale_type: u32,
    zero_type: u32,
    weights_offset: u64,
    weights_length: u64,
    scales_offset: u64,
    scales_length: u64,
    zeros_offset: u64,
    zeros_length: u64,
    elements: u64,
    tensor_checksum: u64,
    reserved: [u8; 8],
}

struct TensorSpec {
    name: str,
    output: u64,
    input: u64,
    quantized: bool,
}

struct OwnedBytes {
    opaque pointer: *u8,
    length: usize,
}

impl OwnedBytes {
    fn allocate(length: usize) -> option::Option[OwnedBytes] {
        if length == (0 as usize) {
            return option::Option[OwnedBytes]::None;
        }
        let pointer: *u8 = malloc(length);
        if pointer.is_null() {
            return option::Option[OwnedBytes]::None;
        }
        return option::Option[OwnedBytes]::Some(OwnedBytes { pointer: pointer, length: length });
    }

    fn drop(ref this) {
        if !this.pointer.is_null() {
            free(this.pointer);
            this.pointer = 0 as *u8;
            this.length = 0 as usize;
        }
    }
}

fn align_up(value: u64, alignment: u64) -> u64 {
    return ((value +% alignment -% (1 as u64)) / alignment) *% alignment;
}

fn hash_update(hash: u64, bytes: *u8, count: usize) -> u64 {
    var result: u64 = hash;
    var index: usize = 0 as usize;
    while index < count {
        result = (result ^ bytes[index] as u64) *% FNV_PRIME;
        index = index +% (1 as usize);
    }
    return result;
}

fn fixed_text(destination: *u8, capacity: usize, source: str) -> bool {
    if source.count() > capacity {
        return false;
    }
    var index: usize = 0 as usize;
    while index < capacity {
        destination[index] = 0 as u8;
        index = index +% (1 as usize);
    }
    index = 0 as usize;
    while index < source.count() {
        guard let option::Option[u8]::Some(byte) = source.byte_at(index) else { return false; };
        destination[index] = byte;
        index = index +% (1 as usize);
    }
    return true;
}

fn fixed_matches(source: *u8, capacity: usize, expected: str) -> bool {
    if expected.count() > capacity {
        return false;
    }
    var index: usize = 0 as usize;
    while index < expected.count() {
        guard let option::Option[u8]::Some(byte) = expected.byte_at(index) else { return false; };
        if source[index] != byte {
            return false;
        }
        index = index +% (1 as usize);
    }
    while index < capacity {
        if source[index] != (0 as u8) {
            return false;
        }
        index = index +% (1 as usize);
    }
    return true;
}

fn magic_matches(header: *PackedHeader) -> bool {
    let expected: [u8; 8] = [
        81 as u8, 73 as u8, 80 as u8, 65 as u8,
        67 as u8, 75 as u8, 49 as u8, 0 as u8,
    ];
    var index: usize = 0 as usize;
    while index < (8 as usize) {
        if (*header).magic[index] != expected[index] {
            return false;
        }
        index = index +% (1 as usize);
    }
    return true;
}

fn write_all(fd: i32, bytes: *u8, count: usize) -> bool {
    var written: usize = 0 as usize;
    while written < count {
        let result: isize = qi_pack_write(fd, bytes + written, count -% written);
        if result <= (0 as isize) {
            return false;
        }
        written = written +% result as usize;
    }
    return true;
}

fn write_zeroes(fd: i32, count: u64, ref checksum: u64, include_in_checksum: bool) -> bool {
    var zeroes: [u8; 256] = [0 as u8; 256];
    var remaining: u64 = count;
    while remaining > (0 as u64) {
        let amount: usize = if remaining < (256 as u64) { remaining as usize } else { 256 as usize };
        if !write_all(fd, #addr_of(zeroes[0]), amount) {
            return false;
        }
        if include_in_checksum {
            checksum = hash_update(checksum, #addr_of(zeroes[0]), amount);
        }
        remaining = remaining -% amount as u64;
    }
    return true;
}

fn write_payload(fd: i32, bytes: *u8, count: usize, ref checksum: u64) -> bool {
    if !write_all(fd, bytes, count) {
        return false;
    }
    checksum = hash_update(checksum, bytes, count);
    return true;
}

fn make_specs() -> [TensorSpec; 9] {
    return [
        TensorSpec { name: "transformer_blocks.0.attn.norm_k.weight", output: 128 as u64, input: 0 as u64, quantized: false },
        TensorSpec { name: "transformer_blocks.0.attn.norm_q.weight", output: 128 as u64, input: 0 as u64, quantized: false },
        TensorSpec { name: "transformer_blocks.0.attn.to_k.weight", output: 4096 as u64, input: 4096 as u64, quantized: true },
        TensorSpec { name: "transformer_blocks.0.attn.to_out.0.weight", output: 4096 as u64, input: 4096 as u64, quantized: true },
        TensorSpec { name: "transformer_blocks.0.attn.to_q.weight", output: 4096 as u64, input: 4096 as u64, quantized: true },
        TensorSpec { name: "transformer_blocks.0.attn.to_v.weight", output: 4096 as u64, input: 4096 as u64, quantized: true },
        TensorSpec { name: "transformer_blocks.0.img_mlp.gate_layer.weight", output: 12288 as u64, input: 4096 as u64, quantized: true },
        TensorSpec { name: "transformer_blocks.0.img_mlp.out.weight", output: 4096 as u64, input: 12288 as u64, quantized: true },
        TensorSpec { name: "transformer_blocks.0.img_mlp.proj.weight", output: 12288 as u64, input: 4096 as u64, quantized: true },
    ];
}

fn make_record(spec: TensorSpec, ref cursor: u64) -> PackedRecord {
    let elements: u64 = if spec.input == (0 as u64) { spec.output } else { spec.output *% spec.input };
    let groups: u64 = if spec.quantized { spec.output *% (spec.input / (64 as u64)) } else { 0 as u64 };
    var record: PackedRecord = PackedRecord {
        name: [0 as u8; 128],
        scheme: if spec.quantized { SCHEME_INT8_AFFINE } else { SCHEME_BF16 },
        rank: if spec.input == (0 as u64) { 1 as u32 } else { 2 as u32 },
        dimensions: [spec.output, spec.input, 0 as u64, 0 as u64],
        group_axis: if spec.quantized { 1 as u32 } else { (0xFFFFFFFF as u32) },
        group_size: if spec.quantized { 64 as u32 } else { 0 as u32 },
        scale_type: if spec.quantized { TYPE_F16 } else { TYPE_NONE },
        zero_type: if spec.quantized { TYPE_U8 } else { TYPE_NONE },
        weights_offset: 0 as u64,
        weights_length: if spec.quantized { elements } else { elements *% (2 as u64) },
        scales_offset: 0 as u64,
        scales_length: groups *% (2 as u64),
        zeros_offset: 0 as u64,
        zeros_length: groups,
        elements: elements,
        tensor_checksum: 0 as u64,
        reserved: [0 as u8; 8],
    };
    let _name_ok: bool = fixed_text(#addr_of(record.name[0]), 128 as usize, spec.name);
    cursor = align_up(cursor, TENSOR_ALIGNMENT);
    record.weights_offset = cursor;
    cursor = cursor +% record.weights_length;
    if spec.quantized {
        cursor = align_up(cursor, TENSOR_ALIGNMENT);
        record.scales_offset = cursor;
        cursor = cursor +% record.scales_length;
        cursor = align_up(cursor, TENSOR_ALIGNMENT);
        record.zeros_offset = cursor;
        cursor = cursor +% record.zeros_length;
    }
    return record;
}

fn quantize_tensor(tensor: safetensors::TensorData, record: PackedRecord) -> option::Option[[OwnedBytes; 3]] {
    guard let option::Option[OwnedBytes]::Some(weights) = OwnedBytes::allocate(record.weights_length as usize) else {
        return option::Option[[OwnedBytes; 3]]::None;
    };
    guard let option::Option[OwnedBytes]::Some(scales) = OwnedBytes::allocate(record.scales_length as usize) else {
        return option::Option[[OwnedBytes; 3]]::None;
    };
    guard let option::Option[OwnedBytes]::Some(zeros) = OwnedBytes::allocate(record.zeros_length as usize) else {
        return option::Option[[OwnedBytes; 3]]::None;
    };
    let source: *u16 = tensor.pointer as *u16;
    let scale_values: *u16 = scales.pointer as *u16;
    let output_count: usize = record.dimensions[0] as usize;
    let input_count: usize = record.dimensions[1] as usize;
    let group_size: usize = record.group_size as usize;
    let groups_per_row: usize = input_count / group_size;
    var row: usize = 0 as usize;
    while row < output_count {
        var group: usize = 0 as usize;
        while group < groups_per_row {
            let start: usize = row *% input_count +% group *% group_size;
            var minimum: f32 = cpu::bf16_to_f32(source[start]);
            var maximum: f32 = minimum;
            var inner: usize = 1 as usize;
            while inner < group_size {
                let value: f32 = cpu::bf16_to_f32(source[start +% inner]);
                minimum = minimum.min(value);
                maximum = maximum.max(value);
                inner = inner +% (1 as usize);
            }
            var scale: f32 = (maximum - minimum) / 255.0f32;
            if scale == 0.0f32 {
                scale = 1.0f32;
            }
            let scale_bits: u16 = cpu::f32_to_fp16(scale);
            let stored_scale: f32 = cpu::fp16_to_f32(scale_bits);
            var zero_value: f32 = (0.0f32 - minimum) / stored_scale;
            zero_value = zero_value.round().max(0.0f32).min(255.0f32);
            let zero: u8 = zero_value as u8;
            let group_index: usize = row *% groups_per_row +% group;
            scale_values[group_index] = scale_bits;
            zeros.pointer[group_index] = zero;
            inner = 0 as usize;
            while inner < group_size {
                let value: f32 = cpu::bf16_to_f32(source[start +% inner]);
                var quantized: f32 = (value / stored_scale).round() + zero as f32;
                quantized = quantized.max(0.0f32).min(255.0f32);
                weights.pointer[start +% inner] = quantized as u8;
                inner = inner +% (1 as usize);
            }
            group = group +% (1 as usize);
        }
        row = row +% (1 as usize);
    }
    return option::Option[[OwnedBytes; 3]]::Some([weights, scales, zeros]);
}

fn verify_packed(path: str, quiet: bool = false) -> i32 {
    guard let mapped::MapResult::Ok(file) = mapped::map_readonly(path) else {
        if !quiet { io::eprintln("packed model: could not map ${path}"); }
        return 1;
    };
    if file.length() < DATA_ALIGNMENT as usize {
        if !quiet { io::eprintln("packed model: file is too small"); }
        return 1;
    }
    let header: *PackedHeader = file.pointer() as *PackedHeader;
    if !magic_matches(header) || (*header).version != VERSION
        || (*header).header_bytes != HEADER_BYTES as u32
        || (*header).tensor_count != TENSOR_COUNT as u32
        || (*header).directory_offset != HEADER_BYTES
        || (*header).data_offset != DATA_ALIGNMENT
        || (*header).file_bytes != file.length() as u64
        || !fixed_matches(#addr_of((*header).model_snapshot[0]), 40 as usize, SNAPSHOT)
        || !fixed_matches(#addr_of((*header).diffusers_commit[0]), 40 as usize, DIFFUSERS_COMMIT)
        || !fixed_matches(#addr_of((*header).policy[0]), 32 as usize, "block0:int8-affine-g64") {
        if !quiet { io::eprintln("packed model: invalid header or model identity"); }
        return 1;
    }
    let payload_length: usize = file.length() -% (*header).data_offset as usize;
    let payload_hash: u64 = hash_update(
        FNV_OFFSET,
        file.pointer() + (*header).data_offset as usize,
        payload_length,
    );
    if payload_hash != (*header).payload_checksum {
        if !quiet { io::eprintln("packed model: payload checksum mismatch"); }
        return 1;
    }

    let records: *PackedRecord =
        (file.pointer() + (*header).directory_offset as usize) as *PackedRecord;
    let specs: [TensorSpec; 9] = make_specs();
    var cursor: u64 = (*header).data_offset;
    var index: usize = 0 as usize;
    while index < TENSOR_COUNT {
        let record: *PackedRecord = records + index;
        let spec: TensorSpec = specs[index];
        let expected_rank: u32 = if spec.input == (0 as u64) { 1 as u32 } else { 2 as u32 };
        let expected_elements: u64 = if spec.input == (0 as u64) {
            spec.output
        } else {
            spec.output *% spec.input
        };
        if !fixed_matches(#addr_of((*record).name[0]), 128 as usize, spec.name)
            || (*record).rank != expected_rank
            || (*record).dimensions[0] != spec.output
            || (expected_rank == (2 as u32) && (*record).dimensions[1] != spec.input)
            || (*record).elements != expected_elements
            || (spec.quantized && (*record).scheme != SCHEME_INT8_AFFINE)
            || (!spec.quantized && (*record).scheme != SCHEME_BF16)
            || (spec.quantized && (*record).weights_length != expected_elements)
            || (*record).weights_offset % TENSOR_ALIGNMENT != (0 as u64)
            || (*record).weights_offset < cursor
            || (*record).weights_offset > (*header).file_bytes
            || (*record).weights_length > (*header).file_bytes -% (*record).weights_offset {
            if !quiet { io::eprintln("packed model: invalid tensor record ${index}"); }
            return 1;
        }
        var tensor_hash: u64 = hash_update(
            FNV_OFFSET,
            file.pointer() + (*record).weights_offset as usize,
            (*record).weights_length as usize,
        );
        cursor = (*record).weights_offset +% (*record).weights_length;
        if (*record).scheme == SCHEME_INT8_AFFINE {
            if (*record).group_axis != (1 as u32) || (*record).group_size != (64 as u32)
                || (*record).scale_type != TYPE_F16 || (*record).zero_type != TYPE_U8
                || (*record).scales_length
                    != spec.output *% (spec.input / (64 as u64)) *% (2 as u64)
                || (*record).zeros_length != spec.output *% (spec.input / (64 as u64))
                || (*record).scales_offset % TENSOR_ALIGNMENT != (0 as u64)
                || (*record).zeros_offset % TENSOR_ALIGNMENT != (0 as u64)
                || (*record).scales_offset < cursor
                || (*record).scales_offset > (*header).file_bytes
                || (*record).scales_length > (*header).file_bytes -% (*record).scales_offset {
                if !quiet { io::eprintln("packed model: invalid quantization metadata ${index}"); }
                return 1;
            }
            tensor_hash = hash_update(
                tensor_hash,
                file.pointer() + (*record).scales_offset as usize,
                (*record).scales_length as usize,
            );
            cursor = (*record).scales_offset +% (*record).scales_length;
            if (*record).zeros_offset < cursor
                || (*record).zeros_offset > (*header).file_bytes
                || (*record).zeros_length > (*header).file_bytes -% (*record).zeros_offset {
                if !quiet { io::eprintln("packed model: invalid zero-point range ${index}"); }
                return 1;
            }
            tensor_hash = hash_update(
                tensor_hash,
                file.pointer() + (*record).zeros_offset as usize,
                (*record).zeros_length as usize,
            );
            cursor = (*record).zeros_offset +% (*record).zeros_length;
        } else if (*record).scheme != SCHEME_BF16
            || (*record).weights_length != expected_elements *% (2 as u64)
            || (*record).scales_offset != (0 as u64)
            || (*record).scales_length != (0 as u64)
            || (*record).zeros_offset != (0 as u64)
            || (*record).zeros_length != (0 as u64) {
            if !quiet { io::eprintln("packed model: unsupported scheme ${(*record).scheme}"); }
            return 1;
        }
        if tensor_hash != (*record).tensor_checksum {
            if !quiet { io::eprintln("packed model: tensor checksum mismatch ${index}"); }
            return 1;
        }
        index = index +% (1 as usize);
    }
    if align_up(cursor, TENSOR_ALIGNMENT) != (*header).file_bytes {
        if !quiet { io::eprintln("packed model: trailing data does not match directory"); }
        return 1;
    }
    if !quiet {
        let bytes: u64 = (*header).file_bytes;
        io::println("packed block0: tensors=${TENSOR_COUNT} bytes=${bytes} checksum=${(*header).payload_checksum}");
        io::println("packed block0: verified");
    }
    return 0;
}

fn verify_against_source(
    packed_path: str,
    source: safetensors::File,
    quiet: bool = false,
) -> i32 {
    guard let mapped::MapResult::Ok(packed) = mapped::map_readonly(packed_path) else {
        if !quiet { io::eprintln("packed model: could not map ${packed_path}"); }
        return 1;
    };
    if packed.length() < DATA_ALIGNMENT as usize {
        return 1;
    }
    let header: *PackedHeader = packed.pointer() as *PackedHeader;
    if !magic_matches(header) || (*header).tensor_count != TENSOR_COUNT as u32 {
        return 1;
    }
    let records: *PackedRecord =
        (packed.pointer() + (*header).directory_offset as usize) as *PackedRecord;
    let specs: [TensorSpec; 9] = make_specs();
    var index: usize = 0 as usize;
    while index < TENSOR_COUNT {
        let record: *PackedRecord = records + index;
        let spec: TensorSpec = specs[index];
        if !fixed_matches(#addr_of((*record).name[0]), 128 as usize, spec.name) {
            if !quiet { io::eprintln("packed model: tensor order/name mismatch ${index}"); }
            return 1;
        }
        guard let option::Option[safetensors::TensorData]::Some(tensor) = source.tensor(spec.name) else {
            return 1;
        };
        if !spec.quantized {
            var byte_index: usize = 0 as usize;
            while byte_index < tensor.byte_length as usize {
                if tensor.pointer[byte_index]
                    != (packed.pointer() + (*record).weights_offset as usize)[byte_index] {
                    if !quiet { io::eprintln("packed model: raw round-trip mismatch ${spec.name}"); }
                    return 1;
                }
                byte_index = byte_index +% (1 as usize);
            }
        } else {
            let source_values: *u16 = tensor.pointer as *u16;
            let packed_weights: *u8 = packed.pointer() + (*record).weights_offset as usize;
            let packed_scales: *u16 =
                (packed.pointer() + (*record).scales_offset as usize) as *u16;
            let packed_zeros: *u8 = packed.pointer() + (*record).zeros_offset as usize;
            let output_count: usize = spec.output as usize;
            let input_count: usize = spec.input as usize;
            let group_size: usize = 64 as usize;
            let groups_per_row: usize = input_count / group_size;
            var row: usize = 0 as usize;
            while row < output_count {
                var group: usize = 0 as usize;
                while group < groups_per_row {
                    let start: usize = row *% input_count +% group *% group_size;
                    var minimum: f32 = cpu::bf16_to_f32(source_values[start]);
                    var maximum: f32 = minimum;
                    var inner: usize = 1 as usize;
                    while inner < group_size {
                        let value: f32 = cpu::bf16_to_f32(source_values[start +% inner]);
                        minimum = minimum.min(value);
                        maximum = maximum.max(value);
                        inner = inner +% (1 as usize);
                    }
                    var scale: f32 = (maximum - minimum) / 255.0f32;
                    if scale == 0.0f32 { scale = 1.0f32; }
                    let scale_bits: u16 = cpu::f32_to_fp16(scale);
                    let stored_scale: f32 = cpu::fp16_to_f32(scale_bits);
                    var zero_value: f32 = (0.0f32 - minimum) / stored_scale;
                    zero_value = zero_value.round().max(0.0f32).min(255.0f32);
                    let zero: u8 = zero_value as u8;
                    let group_index: usize = row *% groups_per_row +% group;
                    if packed_scales[group_index] != scale_bits || packed_zeros[group_index] != zero {
                        if !quiet { io::eprintln("packed model: group metadata round-trip mismatch ${spec.name}"); }
                        return 1;
                    }
                    inner = 0 as usize;
                    while inner < group_size {
                        let value: f32 = cpu::bf16_to_f32(source_values[start +% inner]);
                        var expected: f32 = (value / stored_scale).round() + zero as f32;
                        expected = expected.max(0.0f32).min(255.0f32);
                        if packed_weights[start +% inner] != expected as u8 {
                            if !quiet { io::eprintln("packed model: quantized round-trip mismatch ${spec.name}"); }
                            return 1;
                        }
                        inner = inner +% (1 as usize);
                    }
                    group = group +% (1 as usize);
                }
                row = row +% (1 as usize);
            }
        }
        index = index +% (1 as usize);
    }
    if !quiet { io::println("packed block0: source round-trip verified"); }
    return 0;
}

fn verify_packed_source(path: str, model_directory: str) -> i32 {
    if verify_packed(path) != (0 as i32) {
        return 1;
    }
    let shard_path: text::Text =
        "${model_directory}/transformer/diffusion_pytorch_model-00001-of-00002.safetensors";
    guard let safetensors::LoadResult::Ok(source) = safetensors::load(shard_path.view()) else {
        return 1;
    };
    return verify_against_source(path, source);
}

fn quantize_block0(model_directory: str, output_path: str) -> i32 {
    if #size_of::[PackedHeader]() != HEADER_BYTES as usize
        || #size_of::[PackedRecord]() != RECORD_BYTES as usize {
        io::eprintln("packed model: ABI layout does not match the format");
        return 1;
    }
    let shard_path: text::Text =
        "${model_directory}/transformer/diffusion_pytorch_model-00001-of-00002.safetensors";
    guard let safetensors::LoadResult::Ok(file) = safetensors::load(shard_path.view()) else {
        io::eprintln("packed model: could not load ${shard_path}");
        return 1;
    };
    let specs: [TensorSpec; 9] = make_specs();
    var records: vec::Vec[PackedRecord] = vec::Vec[PackedRecord]::with_capacity(TENSOR_COUNT);
    var cursor: u64 = DATA_ALIGNMENT;
    var index: usize = 0 as usize;
    while index < TENSOR_COUNT {
        let record: PackedRecord = make_record(specs[index], cursor);
        if records.append(record) != status::Status::Ok {
            return 1;
        }
        index = index +% (1 as usize);
    }
    let file_bytes: u64 = align_up(cursor, TENSOR_ALIGNMENT);
    var header: PackedHeader = PackedHeader {
        magic: [81 as u8, 73 as u8, 80 as u8, 65 as u8, 67 as u8, 75 as u8, 49 as u8, 0 as u8],
        version: VERSION,
        header_bytes: HEADER_BYTES as u32,
        tensor_count: TENSOR_COUNT as u32,
        scope: 1 as u32,
        directory_offset: HEADER_BYTES,
        data_offset: DATA_ALIGNMENT,
        file_bytes: file_bytes,
        payload_checksum: 0 as u64,
        model_snapshot: [0 as u8; 40],
        diffusers_commit: [0 as u8; 40],
        policy: [0 as u8; 32],
        reserved: [0 as u8; 88],
    };
    let _snapshot_ok: bool = fixed_text(#addr_of(header.model_snapshot[0]), 40 as usize, SNAPSHOT);
    let _commit_ok: bool = fixed_text(#addr_of(header.diffusers_commit[0]), 40 as usize, DIFFUSERS_COMMIT);
    let _policy_ok: bool = fixed_text(#addr_of(header.policy[0]), 32 as usize, "block0:int8-affine-g64");

    let temporary_path: text::Text = "${output_path}.tmp";
    guard let option::Option[text::CString]::Some(c_temporary) = temporary_path.c_str() else { return 1; };
    // POSIX 0644, written as decimal because the current C+ integer grammar
    // does not treat an `0o` prefix as a portable octal literal.
    let fd: i32 = qi_pack_open(c_temporary.as_ptr(), O_WRONLY | O_CREAT | O_TRUNC, 420 as i32);
    if fd < (0 as i32) {
        io::eprintln("packed model: could not create ${temporary_path}");
        return 1;
    }
    if qi_pack_fchmod(fd, 420 as u16) != (0 as i32) {
        let _closed: i32 = qi_pack_close(fd);
        let _removed: i32 = qi_pack_unlink(c_temporary.as_ptr());
        io::eprintln("packed model: could not set safe output permissions");
        return 1;
    }
    var ok: bool = write_all(fd, #addr_of(header) as *u8, HEADER_BYTES as usize);
    index = 0 as usize;
    while ok && index < TENSOR_COUNT {
        guard let option::Option[*PackedRecord]::Some(record) = records.at_ptr(index) else {
            ok = false;
            break;
        };
        ok = write_all(fd, record as *u8, RECORD_BYTES as usize);
        index = index +% (1 as usize);
    }
    var payload_checksum: u64 = FNV_OFFSET;
    let directory_end: u64 = HEADER_BYTES +% RECORD_BYTES *% TENSOR_COUNT as u64;
    if ok {
        ok = write_zeroes(fd, DATA_ALIGNMENT -% directory_end, payload_checksum, false);
    }
    var position: u64 = DATA_ALIGNMENT;
    index = 0 as usize;
    while ok && index < TENSOR_COUNT {
        guard let option::Option[*PackedRecord]::Some(record) = records.at_ptr(index) else {
            ok = false;
            break;
        };
        let spec: TensorSpec = specs[index];
        guard let option::Option[safetensors::TensorData]::Some(tensor) = file.tensor(spec.name) else {
            io::eprintln("packed model: missing ${spec.name}");
            ok = false;
            break;
        };
        let expected_rank: usize = if spec.input == (0 as u64) { 1 as usize } else { 2 as usize };
        if tensor.dtype.name() != "BF16" || tensor.rank != expected_rank
            || tensor.dimensions[0] != spec.output
            || (expected_rank == (2 as usize) && tensor.dimensions[1] != spec.input) {
            io::eprintln("packed model: wrong metadata for ${spec.name}");
            ok = false;
            break;
        }
        if position < { (*record).weights_offset } {
            ok = write_zeroes(fd, { (*record).weights_offset } -% position, payload_checksum, true);
            position = { (*record).weights_offset };
        }
        var tensor_hash: u64 = FNV_OFFSET;
        if !spec.quantized {
            ok = write_payload(fd, tensor.pointer, tensor.byte_length as usize, payload_checksum);
            tensor_hash = hash_update(tensor_hash, tensor.pointer, tensor.byte_length as usize);
            position = position +% tensor.byte_length;
        } else {
            guard let option::Option[[OwnedBytes; 3]]::Some(buffers) = quantize_tensor(tensor, { *record }) else {
                ok = false;
                break;
            };
            ok = write_payload(fd, buffers[0].pointer, buffers[0].length, payload_checksum);
            tensor_hash = hash_update(tensor_hash, buffers[0].pointer, buffers[0].length);
            position = position +% buffers[0].length as u64;
            if ok && position < { (*record).scales_offset } {
                ok = write_zeroes(fd, { (*record).scales_offset } -% position, payload_checksum, true);
                position = { (*record).scales_offset };
            }
            if ok { ok = write_payload(fd, buffers[1].pointer, buffers[1].length, payload_checksum); }
            tensor_hash = hash_update(tensor_hash, buffers[1].pointer, buffers[1].length);
            position = position +% buffers[1].length as u64;
            if ok && position < { (*record).zeros_offset } {
                ok = write_zeroes(fd, { (*record).zeros_offset } -% position, payload_checksum, true);
                position = { (*record).zeros_offset };
            }
            if ok { ok = write_payload(fd, buffers[2].pointer, buffers[2].length, payload_checksum); }
            tensor_hash = hash_update(tensor_hash, buffers[2].pointer, buffers[2].length);
            position = position +% buffers[2].length as u64;
        }
        (*record).tensor_checksum = tensor_hash;
        io::println("packed ${spec.name}: ${(*record).weights_length} weight bytes");
        index = index +% (1 as usize);
    }
    if ok && position < file_bytes {
        ok = write_zeroes(fd, file_bytes -% position, payload_checksum, true);
    }
    header.payload_checksum = payload_checksum;
    if ok && qi_pack_lseek(fd, 0 as i64, SEEK_SET) != (0 as i64) { ok = false; }
    if ok { ok = write_all(fd, #addr_of(header) as *u8, HEADER_BYTES as usize); }
    index = 0 as usize;
    while ok && index < TENSOR_COUNT {
        guard let option::Option[*PackedRecord]::Some(record) = records.at_ptr(index) else { ok = false; break; };
        ok = write_all(fd, record as *u8, RECORD_BYTES as usize);
        index = index +% (1 as usize);
    }
    if ok && qi_pack_fsync(fd) != (0 as i32) { ok = false; }
    let _closed: i32 = qi_pack_close(fd);
    if !ok || verify_packed(temporary_path.view(), true) != (0 as i32)
        || verify_against_source(temporary_path.view(), file, true) != (0 as i32) {
        let _removed: i32 = qi_pack_unlink(c_temporary.as_ptr());
        io::eprintln("packed model: temporary output failed validation");
        return 1;
    }
    let output_owner: text::Text = text::from_str(output_path);
    guard let option::Option[text::CString]::Some(c_output) = output_owner.c_str() else {
        let _removed: i32 = qi_pack_unlink(c_temporary.as_ptr());
        return 1;
    };
    if qi_pack_rename(c_temporary.as_ptr(), c_output.as_ptr()) != (0 as i32) {
        let _removed: i32 = qi_pack_unlink(c_temporary.as_ptr());
        io::eprintln("packed model: could not install ${output_path}");
        return 1;
    }
    io::println("packed block0 written atomically: ${output_path}");
    if verify_packed(output_path) != (0 as i32) {
        return 1;
    }
    io::println("packed block0: source round-trip verified");
    return 0;
}

#[test]
fn packed_layout_is_fixed_and_aligned() {
    assert #size_of::[PackedHeader]() == (256 as usize);
    assert #size_of::[PackedRecord]() == (256 as usize);
    assert align_up(257 as u64, 256 as u64) == (512 as u64);
}

#[test]
fn packed_checksum_detects_a_bit_flip() {
    var bytes: [u8; 4] = [1 as u8, 2 as u8, 3 as u8, 4 as u8];
    let original: u64 = hash_update(FNV_OFFSET, #addr_of(bytes[0]), 4 as usize);
    bytes[2] = bytes[2] ^ (1 as u8);
    let corrupted: u64 = hash_update(FNV_OFFSET, #addr_of(bytes[0]), 4 as usize);
    assert original != corrupted;
}
