// Writes and verifies INT4 transformer packs for the CUDA engine.

import "qwen_image/int4_pack" as int4_pack;
import "stdlib/env" as env;
import "stdlib/io" as io;
import "stdlib/option" as option;
import "stdlib/text" as text;

fn usage() -> i32 {
    io::eprintln("usage: qwen-image-quantize w4a16|w4a4 SOURCE_FP16_QIPACK OUTPUT [GROUP] [clip]");
    io::eprintln("       qwen-image-quantize verify FILE");
    return 2;
}

fn main() -> i32 {
    guard let option::Option[text::Text]::Some(command) = env::arg(1 as usize) else { return usage(); };
    if command.view() == "verify" {
        guard let option::Option[text::Text]::Some(path) = env::arg(2 as usize) else { return usage(); };
        return int4_pack::verify(path.view());
    }
    let format: int4_pack::Format = if command.view() == "w4a16" {
        int4_pack::Format::W4A16
    } else if command.view() == "w4a4" {
        int4_pack::Format::W4A4
    } else {
        return usage();
    };
    guard let option::Option[text::Text]::Some(source) = env::arg(2 as usize) else { return usage(); };
    guard let option::Option[text::Text]::Some(output) = env::arg(3 as usize) else { return usage(); };
    var group: usize = 64 as usize;
    var clip: bool = false;
    var index: usize = 4 as usize;
    while index < env::argc() {
        guard let option::Option[text::Text]::Some(argument) = env::arg(index) else { return usage(); };
        if argument.view() == "clip" {
            clip = true;
        } else if argument.view() == "32" {
            group = 32 as usize;
        } else if argument.view() == "64" {
            group = 64 as usize;
        } else if argument.view() == "128" {
            group = 128 as usize;
        } else if argument.view() == "256" {
            group = 256 as usize;
        } else {
            return usage();
        }
        index = index +% (1 as usize);
    }
    return int4_pack::write(source.view(), output.view(), int4_pack::Options {
        format: format,
        group: group,
        clip: clip,
    });
}
