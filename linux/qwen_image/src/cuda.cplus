// CUDA runtime access for the Linux engine. The kernels and these entry points
// live in cuda/*.cu, compiled by linux/build_cuda.sh into
// cuda/target/libqwen_image_cuda.a. Every entry point returns a cudaError_t
// value; 0 is success.

import "stdlib/option" as option;
import "stdlib/text" as text;

#[link_name = "qi_cuda_device"]
extern fn qi_cuda_device(name: *u8, name_capacity: i32, major: *i32, minor: *i32,
    memory_bytes: *u64, multiprocessors: *i32) -> i32;
#[link_name = "qi_cuda_malloc"]
extern fn qi_cuda_malloc(pointer: **u8, bytes: u64) -> i32;
#[link_name = "qi_cuda_free"]
extern fn qi_cuda_free(pointer: *u8) -> i32;
#[link_name = "qi_cuda_upload"]
extern fn qi_cuda_upload(device: *u8, host: *u8, bytes: u64) -> i32;
#[link_name = "qi_cuda_download"]
extern fn qi_cuda_download(host: *u8, device: *u8, bytes: u64) -> i32;
#[link_name = "qi_cuda_synchronize"]
extern fn qi_cuda_synchronize() -> i32;
#[link_name = "qi_cuda_axpy"]
extern fn qi_cuda_axpy(y: *f32, x: *f32, a: f32, count: u64) -> i32;

