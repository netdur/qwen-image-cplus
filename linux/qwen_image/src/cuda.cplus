    query_offset: i32, causal_rows: i32) -> i32;


// Exported wrappers: an extern fn is private to this module.
fn malloc(pointer: **u8, bytes: u64) -> i32 { return qi_cuda_malloc(pointer, bytes); }
fn free(pointer: *u8) -> i32 { return qi_cuda_free(pointer); }
fn upload(device: *u8, host: *u8, bytes: u64) -> i32 { return qi_cuda_upload(device, host, bytes); }
fn download(host: *u8, device: *u8, bytes: u64) -> i32 { return qi_cuda_download(host, device, bytes); }
fn axpy(y: *f32, x: *f32, a: f32, count: u64) -> i32 { return qi_cuda_axpy(y, x, a, count); }
fn layer_norm_scale(x: *f32, scale: *f32, scale_stride: i32, out: *f32, rows: i32, width: i32, split: i32) -> i32 { return qi_layer_norm_scale(x, scale, scale_stride, out, rows, width, split); }
fn rms_norm(x: *f32, weight: *f32, offset: f32, out: *f32, rows: i32, width: i32) -> i32 { return qi_rms_norm(x, weight, offset, out, rows, width); }
fn head_norm_rope(x: *f32, weight: *f32, rope: *f32, rope_offset: i32, rows: i32, heads: i32) -> i32 { return qi_head_norm_rope(x, weight, rope, rope_offset, rows, heads); }
fn gated_residual(hidden: *f32, update: *f32, gate: *f32, gate_stride: i32, rows: i32, width: i32, split: i32) -> i32 { return qi_gated_residual(hidden, update, gate, gate_stride, rows, width, split); }
fn swiglu(gate: *f32, up: *f32, out: *f32, count: u64) -> i32 { return qi_swiglu(gate, up, out, count); }
fn silu(x: *f32, out: *f32, count: u64) -> i32 { return qi_silu(x, out, count); }
fn gelu_tanh(x: *f32, out: *f32, count: u64) -> i32 { return qi_gelu_tanh(x, out, count); }
fn timestep_projection(timesteps: *f32, out: *f32, count: i32) -> i32 { return qi_timestep_projection(timesteps, out, count); }
fn bf16_to_f32(source: *u8, out: *f32, count: u64) -> i32 { return qi_bf16_to_f32(source, out, count); }
fn f16_to_f32(source: *u8, out: *f32, count: u64) -> i32 { return qi_f16_to_f32(source, out, count); }
fn f32_to_f16(source: *f32, out: *u8, count: u64) -> i32 { return qi_f32_to_f16(source, out, count); }
fn copy(destination: *u8, source: *u8, bytes: u64) -> i32 { return qi_copy(destination, source, bytes); }
fn zero(destination: *u8, bytes: u64) -> i32 { return qi_zero(destination, bytes); }
fn copy_rows(destination: *f32, destination_stride: i32, source: *f32, source_stride: i32, rows: i32, width: i32) -> i32 { return qi_copy_rows(destination, destination_stride, source, source_stride, rows, width); }
fn w4a4_quantize_activations(x: *f32, codes: *u8, scales: *u8, m: i32, k: i32) -> i32 { return qi_w4a4_quantize_activations(x, codes, scales, m, k); }
fn w4a4_gemm(a_codes: *u8, a_scales: *u8, w_codes: *u8, w_scales: *u8, y: *f32, m: i32, n: i32, k: i32) -> i32 { return qi_w4a4_gemm(a_codes, a_scales, w_codes, w_scales, y, m, n, k); }
fn w4a16_gemm(x_half: *u8, codes: *u8, scales: *u8, minimums: *u8, y: *f32, m: i32, n: i32, k: i32) -> i32 { return qi_w4a16_gemm(x_half, codes, scales, minimums, y, m, n, k); }
fn linear_f32(x: *f32, weights: *f32, y: *f32, m: i32, n: i32, k: i32, accumulate: i32) -> i32 { return qi_linear_f32(x, weights, y, m, n, k, accumulate); }
fn euler(latents: *f32, velocity: *f32, delta: f32, count: u64) -> i32 { return qi_euler(latents, velocity, delta, count); }
fn linear_f32_strided(x: *f32, weights: *f32, y: *f32, m: i32, n: i32, k: i32, ldy: i32) -> i32 { return qi_linear_f32_strided(x, weights, y, m, n, k, ldy); }

// Free device memory in bytes, or 0 when the query fails.
fn free_memory() -> u64 {
    var free_bytes: u64 = 0 as u64;
    var total_bytes: u64 = 0 as u64;
    if qi_cuda_memory(#addr_of(free_bytes), #addr_of(total_bytes)) != (0 as i32) { return 0 as u64; }
    return free_bytes;
}

fn to_half(source: *f32, out: *u8, count: u64) -> i32 { return qi_to_half(source, out, count); }
fn attention_half(q: *f32, k_half: *u8, v_half: *u8, out: *f32, scratch: *u8, queries: i32, keys: i32, heads: i32, query_offset: i32, causal_rows: i32) -> i32 { return qi_attention_half(q, k_half, v_half, out, scratch, queries, keys, heads, query_offset, causal_rows); }
fn attention_f16(q: *f32, k: *f32, v: *f32, out: *f32, scores: *f32, halves: *u8, queries: i32, keys: i32, heads: i32, query_offset: i32, causal_rows: i32) -> i32 { return qi_attention_f16(q, k, v, out, scores, halves, queries, keys, heads, query_offset, causal_rows); }
fn attention(q: *f32, k: *f32, v: *f32, out: *f32, scores: *f32, queries: i32, keys: i32, heads: i32, query_offset: i32, causal_rows: i32) -> i32 { return qi_attention(q, k, v, out, scores, queries, keys, heads, query_offset, causal_rows); }

struct Device {
    name: text::Text,
    major: i32,
    minor: i32,
    memory_bytes: u64,
    multiprocessors: i32,
}

fn device() -> option::Option[Device] {
    var name: [u8; 256] = [0 as u8; 256];
    var major: i32 = 0;
    var minor: i32 = 0;
    var memory_bytes: u64 = 0 as u64;
    var multiprocessors: i32 = 0;
    if qi_cuda_device(#addr_of(name[0]), 256 as i32, #addr_of(major), #addr_of(minor),
        #addr_of(memory_bytes), #addr_of(multiprocessors)) != (0 as i32) {
        return option::Option[Device]::None;
    }
    var length: usize = 0 as usize;
    while length < (255 as usize) && name[length] != (0 as u8) {
        length = length +% (1 as usize);
    }
    return option::Option[Device]::Some(Device {
        name: text::from_str(#str_from_raw_parts(#addr_of(name[0]), length)),
        major: major,
        minor: minor,
        memory_bytes: memory_bytes,
        multiprocessors: multiprocessors,
    });
}

// An owned device allocation.
struct DeviceBuffer {
    opaque pointer: *u8,
    bytes: u64,
}

impl DeviceBuffer {
    fn allocate(bytes: u64) -> option::Option[DeviceBuffer] {
        var pointer: *u8 = 0 as *u8;
        if qi_cuda_malloc(#addr_of(pointer), bytes) != (0 as i32) {
            return option::Option[DeviceBuffer]::None;
        }
        return option::Option[DeviceBuffer]::Some(DeviceBuffer { pointer: pointer, bytes: bytes });
    }

    fn upload(this, host: *u8, bytes: u64) -> bool {
        return bytes <= this.bytes && qi_cuda_upload(this.pointer, host, bytes) == (0 as i32);
    }

    fn download(this, host: *u8, bytes: u64) -> bool {
        return bytes <= this.bytes && qi_cuda_download(host, this.pointer, bytes) == (0 as i32);
    }

    fn drop(ref this) {
        if !this.pointer.is_null() {
            let _freed: i32 = qi_cuda_free(this.pointer);
            this.pointer = 0 as *u8;
        }
    }
}

// An owned page-locked host allocation, for full-speed uploads.
struct PinnedBuffer {
    opaque pointer: *u8,
    bytes: u64,
}

impl PinnedBuffer {
    fn allocate(bytes: u64) -> option::Option[PinnedBuffer] {
        var pointer: *u8 = 0 as *u8;
        if qi_cuda_malloc_host(#addr_of(pointer), bytes) != (0 as i32) {
            return option::Option[PinnedBuffer]::None;
        }
        return option::Option[PinnedBuffer]::Some(PinnedBuffer { pointer: pointer, bytes: bytes });
    }

    fn drop(ref this) {
        if !this.pointer.is_null() {
            let _freed: i32 = qi_cuda_free_host(this.pointer);
            this.pointer = 0 as *u8;
        }
    }
}

// A non-blocking stream (never implicitly ordered with the default stream).
struct Stream {
    opaque handle: *u8,
}

impl Stream {
    fn create() -> option::Option[Stream] {
        var handle: *u8 = 0 as *u8;
        if qi_cuda_stream_create(#addr_of(handle)) != (0 as i32) { return option::Option[Stream]::None; }
        return option::Option[Stream]::Some(Stream { handle: handle });
    }

    fn drop(ref this) {
        if !this.handle.is_null() {
            let _destroyed: i32 = qi_cuda_stream_destroy(this.handle);
            this.handle = 0 as *u8;
        }
    }
}

struct Event {
    opaque handle: *u8,
}

impl Event {
    fn create() -> option::Option[Event] {
        var handle: *u8 = 0 as *u8;
        if qi_cuda_event_create(#addr_of(handle)) != (0 as i32) { return option::Option[Event]::None; }
        return option::Option[Event]::Some(Event { handle: handle });
    }

    fn drop(ref this) {
        if !this.handle.is_null() {
            let _destroyed: i32 = qi_cuda_event_destroy(this.handle);
            this.handle = 0 as *u8;
        }
    }
}

// Null stream handles below mean the default stream.
fn record(event: *u8, stream: *u8) -> bool {
    return qi_cuda_event_record(event, stream) == (0 as i32);
}

fn wait(stream: *u8, event: *u8) -> bool {
    return qi_cuda_stream_wait(stream, event) == (0 as i32);
}

fn upload_async(device: *u8, host: *u8, bytes: u64, stream: *u8) -> bool {
    return qi_cuda_upload_async(device, host, bytes, stream) == (0 as i32);
}

fn synchronize() -> bool {
    return qi_cuda_synchronize() == (0 as i32);
}

#[test]
fn cuda_device_runs_a_kernel() {
    guard let option::Option[Device]::Some(gpu) = device() else {
        assert false;
        return;
    };
    assert gpu.major >= (7 as i32);
    var x: [f32; 1000] = [0.0f32; 1000];
    var y: [f32; 1000] = [0.0f32; 1000];
    var index: usize = 0 as usize;
    while index < (1000 as usize) {
        x[index] = index as f32;
        y[index] = 1.0f32;
        index = index +% (1 as usize);
    }
    let bytes: u64 = 4000 as u64;
    guard let option::Option[DeviceBuffer]::Some(device_x) = DeviceBuffer::allocate(bytes) else { assert false; return; };
    guard let option::Option[DeviceBuffer]::Some(device_y) = DeviceBuffer::allocate(bytes) else { assert false; return; };
    assert device_x.upload(#addr_of(x[0]) as *u8, bytes);
    assert device_y.upload(#addr_of(y[0]) as *u8, bytes);
    assert qi_cuda_axpy(device_y.pointer as *f32, device_x.pointer as *f32, 2.0f32, 1000 as u64) == (0 as i32);
    assert synchronize();
    assert device_y.download(#addr_of(y[0]) as *u8, bytes);
    index = 0 as usize;
    while index < (1000 as usize) {
        assert y[index] == 2.0f32 * (index as f32) + 1.0f32;
        index = index +% (1 as usize);
    }
}
