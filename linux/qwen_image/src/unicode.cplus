// Unicode properties and NFC for the tokenizer, from tables generated by
// tools/generate_unicode_tables.py (Unicode 15.0) and embedded in the binary.
// The macOS engine takes these from Foundation.

import "stdlib/option" as option;
import "stdlib/status" as status;
import "stdlib/text" as text;
import "stdlib/vec" as vec;

const TABLE_BYTES: usize = 60788;

struct Tables {
    opaque words: *u32,
    letters: usize,        // word index of the first range
    letter_count: usize,
    numbers: usize,
    number_count: usize,
    spaces: usize,
    space_count: usize,
    combining: usize,
    combining_count: usize,
    decompositions: usize,
    decomposition_count: usize,
    pool: usize,
    compositions: usize,
    composition_count: usize,
}

fn tables() -> Tables {
    let blob: *[u8; 60788] = #include_bytes("../data/unicode.bin");
    let words: *u32 = blob as *u32;
    var at: usize = 2 as usize;
    let letter_count: usize = words[at] as usize;
    let letters: usize = at +% (1 as usize);
    at = letters +% letter_count *% (2 as usize);
    let number_count: usize = words[at] as usize;
    let numbers: usize = at +% (1 as usize);
    at = numbers +% number_count *% (2 as usize);
    let space_count: usize = words[at] as usize;
    let spaces: usize = at +% (1 as usize);
    at = spaces +% space_count *% (2 as usize);
    let combining_count: usize = words[at] as usize;
    let combining: usize = at +% (1 as usize);
    at = combining +% combining_count *% (3 as usize);
    let decomposition_count: usize = words[at] as usize;
    let decompositions: usize = at +% (1 as usize);
    at = decompositions +% decomposition_count *% (3 as usize);
    let pool_count: usize = words[at] as usize;
    let pool: usize = at +% (1 as usize);
    at = pool +% pool_count;
    let composition_count: usize = words[at] as usize;
    let compositions: usize = at +% (1 as usize);
    return Tables {
        words: words, letters: letters, letter_count: letter_count, numbers: numbers, number_count: number_count,
        spaces: spaces, space_count: space_count, combining: combining, combining_count: combining_count,
        decompositions: decompositions, decomposition_count: decomposition_count, pool: pool,
        compositions: compositions, composition_count: composition_count,
    };
}

// Binary search over `count` records of `stride` words starting at `base`,
// each beginning with an inclusive (first, last) range. Returns the record's
// word index.
fn find_range(words: *u32, base: usize, count: usize, stride: usize, codepoint: u32) -> option::Option[usize] {
    var low: usize = 0 as usize;
    var high: usize = count;
    while low < high {
        let middle: usize = (low +% high) / (2 as usize);
        let record: usize = base +% middle *% stride;
        if codepoint < words[record] {
            high = middle;
        } else if codepoint > words[record +% (1 as usize)] {
            low = middle +% (1 as usize);
        } else {
            return option::Option[usize]::Some(record);
        }
    }
    return option::Option[usize]::None;
}

fn is_letter(t: Tables, codepoint: u32) -> bool {
    return match find_range(t.words, t.letters, t.letter_count, 2 as usize, codepoint) {
        option::Option::Some(_) => true,
        option::Option::None => false,
    };
}

fn is_number(t: Tables, codepoint: u32) -> bool {
    return match find_range(t.words, t.numbers, t.number_count, 2 as usize, codepoint) {
        option::Option::Some(_) => true,
        option::Option::None => false,
    };
}

fn is_whitespace(t: Tables, codepoint: u32) -> bool {
    return match find_range(t.words, t.spaces, t.space_count, 2 as usize, codepoint) {
        option::Option::Some(_) => true,
        option::Option::None => false,
    };
}

fn combining_class(t: Tables, codepoint: u32) -> u32 {
    return match find_range(t.words, t.combining, t.combining_count, 3 as usize, codepoint) {
        option::Option::Some(record) => t.words[record +% (2 as usize)],
        option::Option::None => 0 as u32,
    };
}

// MARK: - UTF-8

// Decodes UTF-8 into scalars; invalid sequences become U+FFFD.
fn decode_utf8(source: str) -> vec::Vec[u32] {
    var result: vec::Vec[u32] = vec::Vec[u32]::with_capacity(source.count());
    var index: usize = 0 as usize;
    while index < source.count() {
        let lead: u32 = match source.byte_at(index) { option::Option::Some(b) => b as u32, option::Option::None => 0 as u32 };
        var length: usize = 1 as usize;
        var codepoint: u32 = 0xFFFD as u32;
        if lead < (0x80 as u32) {
            codepoint = lead;
        } else if lead >= (0xC0 as u32) && lead < (0xE0 as u32) {
            length = 2 as usize;
            codepoint = lead & (0x1F as u32);
        } else if lead >= (0xE0 as u32) && lead < (0xF0 as u32) {
            length = 3 as usize;
            codepoint = lead & (0x0F as u32);
        } else if lead >= (0xF0 as u32) && lead < (0xF8 as u32) {
            length = 4 as usize;
            codepoint = lead & (0x07 as u32);
        }
        if length > (1 as usize) {
            var valid: bool = index +% length <= source.count();
            var part: usize = 1 as usize;
            while valid && part < length {
                let byte: u32 = match source.byte_at(index +% part) { option::Option::Some(b) => b as u32, option::Option::None => 0 as u32 };
                if (byte & (0xC0 as u32)) != (0x80 as u32) {
                    valid = false;
                } else {
                    codepoint = (codepoint << (6 as u32)) | (byte & (0x3F as u32));
                }
                part = part +% (1 as usize);
            }
            if !valid {
                codepoint = 0xFFFD as u32;
                length = 1 as usize;
            }
        }
        let _appended: status::Status = result.append(codepoint);
        index = index +% length;
    }
    return result;
}

fn append_utf8(ref output: text::Text, codepoint: u32) {
    var bytes: [u8; 4] = [0 as u8; 4];
    var count: usize = 1 as usize;
    if codepoint < (0x80 as u32) {
        bytes[0] = codepoint as u8;
    } else if codepoint < (0x800 as u32) {
        bytes[0] = ((0xC0 as u32) | (codepoint >> (6 as u32))) as u8;
        bytes[1] = ((0x80 as u32) | (codepoint & (0x3F as u32))) as u8;
        count = 2 as usize;
    } else if codepoint < (0x10000 as u32) {
        bytes[0] = ((0xE0 as u32) | (codepoint >> (12 as u32))) as u8;
        bytes[1] = ((0x80 as u32) | ((codepoint >> (6 as u32)) & (0x3F as u32))) as u8;
        bytes[2] = ((0x80 as u32) | (codepoint & (0x3F as u32))) as u8;
        count = 3 as usize;
    } else {
        bytes[0] = ((0xF0 as u32) | (codepoint >> (18 as u32))) as u8;
        bytes[1] = ((0x80 as u32) | ((codepoint >> (12 as u32)) & (0x3F as u32))) as u8;
        bytes[2] = ((0x80 as u32) | ((codepoint >> (6 as u32)) & (0x3F as u32))) as u8;
        bytes[3] = ((0x80 as u32) | (codepoint & (0x3F as u32))) as u8;
        count = 4 as usize;
    }
    let _appended: status::Status = output.append(#str_from_raw_parts(#addr_of(bytes[0]), count));
}

// MARK: - NFC

const HANGUL_S_BASE: u32 = 0xAC00;
const HANGUL_L_BASE: u32 = 0x1100;
const HANGUL_V_BASE: u32 = 0x1161;
const HANGUL_T_BASE: u32 = 0x11A7;
const HANGUL_L_COUNT: u32 = 19;
const HANGUL_V_COUNT: u32 = 21;
const HANGUL_T_COUNT: u32 = 28;
const HANGUL_N_COUNT: u32 = 588;
const HANGUL_S_COUNT: u32 = 11172;

fn decompose_into(t: Tables, codepoint: u32, ref output: vec::Vec[u32]) {
    if codepoint >= HANGUL_S_BASE && codepoint < HANGUL_S_BASE +% HANGUL_S_COUNT {
        let index: u32 = codepoint -% HANGUL_S_BASE;
        let _l: status::Status = output.append(HANGUL_L_BASE +% index / HANGUL_N_COUNT);
        let _v: status::Status = output.append(HANGUL_V_BASE +% (index % HANGUL_N_COUNT) / HANGUL_T_COUNT);
        let trailing: u32 = index % HANGUL_T_COUNT;
        if trailing != (0 as u32) { let _t: status::Status = output.append(HANGUL_T_BASE +% trailing); }
        return;
    }
    var low: usize = 0 as usize;
    var high: usize = t.decomposition_count;
    while low < high {
        let middle: usize = (low +% high) / (2 as usize);
        let record: usize = t.decompositions +% middle *% (3 as usize);
        let key: u32 = t.words[record];
        if codepoint < key {
            high = middle;
        } else if codepoint > key {
            low = middle +% (1 as usize);
        } else {
            let offset: usize = t.words[record +% (1 as usize)] as usize;
            let length: usize = t.words[record +% (2 as usize)] as usize;
            var index: usize = 0 as usize;
            while index < length {
                let _appended: status::Status = output.append(t.words[t.pool +% offset +% index]);
                index = index +% (1 as usize);
            }
            return;
        }
    }
    let _appended: status::Status = output.append(codepoint);
}

fn compose_pair(t: Tables, first: u32, second: u32) -> option::Option[u32] {
    if first >= HANGUL_L_BASE && first < HANGUL_L_BASE +% HANGUL_L_COUNT
        && second >= HANGUL_V_BASE && second < HANGUL_V_BASE +% HANGUL_V_COUNT {
        return option::Option[u32]::Some(HANGUL_S_BASE +% ((first -% HANGUL_L_BASE) *% HANGUL_V_COUNT +% (second -% HANGUL_V_BASE)) *% HANGUL_T_COUNT);
    }
    if first >= HANGUL_S_BASE && first < HANGUL_S_BASE +% HANGUL_S_COUNT && (first -% HANGUL_S_BASE) % HANGUL_T_COUNT == (0 as u32)
        && second > HANGUL_T_BASE && second < HANGUL_T_BASE +% HANGUL_T_COUNT {
        return option::Option[u32]::Some(first +% (second -% HANGUL_T_BASE));
    }
    var low: usize = 0 as usize;
    var high: usize = t.composition_count;
    while low < high {
        let middle: usize = (low +% high) / (2 as usize);
        let record: usize = t.compositions +% middle *% (3 as usize);
        let key_first: u32 = t.words[record];
        let key_second: u32 = t.words[record +% (1 as usize)];
        if first < key_first || (first == key_first && second < key_second) {
            high = middle;
        } else if first > key_first || second > key_second {
            low = middle +% (1 as usize);
        } else {
            return option::Option[u32]::Some(t.words[record +% (2 as usize)]);
        }
    }
    return option::Option[u32]::None;
}

// Canonical decomposition, canonical ordering, and canonical composition
// (Unicode Standard Annex #15) over scalars.
fn nfc_scalars(t: Tables, source: vec::Vec[u32]) -> vec::Vec[u32] {
    var decomposed: vec::Vec[u32] = vec::Vec[u32]::with_capacity(source.count() *% (2 as usize));
    var index: usize = 0 as usize;
    while index < source.count() {
        match source.at(index) {
            option::Option::Some(codepoint) => decompose_into(t, codepoint, decomposed),
            option::Option::None => {}
        }
        index = index +% (1 as usize);
    }
    // Canonical ordering: stable insertion sort of each run of nonzero classes.
    let values: *u32 = #slice_ptr(decomposed.as_slice());
    index = 1 as usize;
    while index < decomposed.count() {
        let class: u32 = combining_class(t, values[index]);
        if class != (0 as u32) {
            var at: usize = index;
            while at > (0 as usize) {
                let previous: u32 = combining_class(t, values[at -% (1 as usize)]);
                if previous <= class || previous == (0 as u32) { break; }
                let swap: u32 = values[at];
                values[at] = values[at -% (1 as usize)];
                values[at -% (1 as usize)] = swap;
                at = at -% (1 as usize);
            }
        }
        index = index +% (1 as usize);
    }
    // Composition with the blocking rule.
    var result: vec::Vec[u32] = vec::Vec[u32]::with_capacity(decomposed.count());
    var starter: usize = 0 as usize;
    var have_starter: bool = false;
    var last_class: u32 = 0 as u32;
    index = 0 as usize;
    while index < decomposed.count() {
        let codepoint: u32 = values[index];
        let class: u32 = combining_class(t, codepoint);
        var composed: bool = false;
        if have_starter {
            let output: *u32 = #slice_ptr(result.as_slice());
            let blocked: bool = result.count() -% (1 as usize) != starter && (last_class == (0 as u32) || last_class >= class);
            if !blocked {
                match compose_pair(t, output[starter], codepoint) {
                    option::Option::Some(combined) => {
                        output[starter] = combined;
                        composed = true;
                    }
                    option::Option::None => {}
                }
            }
        }
        if !composed {
            if class == (0 as u32) {
                starter = result.count();
                have_starter = true;
            }
            last_class = class;
            let _appended: status::Status = result.append(codepoint);
        }
        index = index +% (1 as usize);
    }
    return result;
}

#[test]
fn tables_classify_ascii_and_beyond() {
    let t: Tables = tables();
    assert is_letter(t, 65 as u32);
    assert is_letter(t, 0x4E2D as u32);
    assert !is_letter(t, 49 as u32);
    assert is_number(t, 49 as u32);
    assert is_number(t, 0x0663 as u32);
    assert is_whitespace(t, 32 as u32);
    assert is_whitespace(t, 0x3000 as u32);
    assert !is_whitespace(t, 65 as u32);
    assert combining_class(t, 0x0301 as u32) == (230 as u32);
    assert combining_class(t, 65 as u32) == (0 as u32);
}

#[test]
fn nfc_composes_and_orders() {
    let t: Tables = tables();
    // "e" + combining acute -> U+00E9; Hangul jamo -> syllable; ordering puts
    // the dot below (220) before the acute (230) and composes where allowed.
    var source: vec::Vec[u32] = vec::new::[u32]();
    let _a: status::Status = source.append(0x65 as u32);
    let _b: status::Status = source.append(0x301 as u32);
    let _c: status::Status = source.append(0x1100 as u32);
    let _d: status::Status = source.append(0x1161 as u32);
    let result: vec::Vec[u32] = nfc_scalars(t, source);
    assert result.count() == (2 as usize);
    match result.at(0 as usize) { option::Option::Some(v) => { assert v == (0xE9 as u32); } option::Option::None => { assert false; } }
    match result.at(1 as usize) { option::Option::Some(v) => { assert v == (0xAC00 as u32); } option::Option::None => { assert false; } }
}
