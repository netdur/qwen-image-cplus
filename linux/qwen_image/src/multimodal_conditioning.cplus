// Linux image-conditioned generation (CUDA). The signature matches the macOS
// `run_multi_image_transformer` that `api` calls.
//
// Phases, each releasing its GPU memory before the next: decode and resize
// every reference image; the vision tower (weights loaded once) for the
// Qwen3-VL image rows and DeepStack features; the VAE encoder for the
// condition latents; the prompt template with image placeholders through the
// text encoder with M-RoPE positions; the conditioned transformer prefix and
// the denoising steps; VAE decode and PNG.

import "./generation_control" as control;
import "./cuda" as cuda;
import "./image_conditioning" as conditioning;
import "./image_input" as image_input;
import "./inputs" as inputs;
import "./int4_pack" as pack;
import "./pipeline" as pipeline;
import "./text_encoder" as text_encoder;
import "./tokenizer" as tokenizer;
import "./transformer" as transformer;
import "./vae" as vae;
import "./vision" as vision;
import "stdlib/env" as env;
import "stdlib/io" as io;
import "stdlib/math" as _;
import "stdlib/option" as option;
import "stdlib/status" as status;
import "stdlib/str" as _;
import "stdlib/text" as text;
import "stdlib/vec" as vec;

const WIDTH: usize = 4096;
const LATENT: usize = 64;
const DEEPSTACK_LAYERS: usize = 3;
const SYSTEM_TOKENS: usize = 14;
const IMAGE_PAD_TOKEN: u32 = 151655;

struct Encoded {
    prompt: pack::Buffer,
    image_pad: pack::Buffer,
    prompt_rows: usize,
    condition_latents: pack::Buffer,
    condition_rows: usize,
    shapes: vec::Vec[conditioning::Shape],
}

// Vision rows and DeepStack features for every image, image after image
// (DeepStack layer-major across all images, as the language model reads it).
fn encode_vision(model_root: str, images: vec::Vec[image_input::Image], vision_rows: usize, embeddings: *f32,
                 deepstack: *f32) -> bool {
    guard let option::Option[vision::Vision]::Some(tower) = vision::load(model_root) else { return false; };
    var row: usize = 0 as usize;
    var index: usize = 0 as usize;
    while index < images.count() {
        guard let option::Option[*image_input::Image]::Some(image) = images.at_ptr(index) else { return false; };
        let shape: conditioning::Shape = (*image).shape;
        let patches: usize = shape.vision_grid_width *% shape.vision_grid_height;
        guard let option::Option[pack::Buffer]::Some(pixels) = pack::Buffer::allocate(patches *% (1536 as usize) *% (4 as usize)) else { return false; };
        image_input::vision_patches(*image, pixels.pointer as *f32);
        if !vision::encode(tower, pixels.pointer as *f32, shape.vision_grid_height, shape.vision_grid_width,
                embeddings + row *% WIDTH, deepstack + row *% WIDTH, vision_rows *% WIDTH) {
            return false;
        }
        row = row +% shape.vision_tokens;
        index = index +% (1 as usize);
    }
    return true;
}

// Normalized, packed condition latents for every image, image after image.
fn encode_latents(model_root: str, images: vec::Vec[image_input::Image], latents_host: *f32) -> bool {
    let vae_path: text::Text = "${model_root}/vae/diffusion_pytorch_model.safetensors";
    guard let option::Option[vae::Weights]::Some(weights) = vae::load_weights(vae_path.view(), true) else { return false; };
    var row: usize = 0 as usize;
    var index: usize = 0 as usize;
    while index < images.count() {
        guard let option::Option[*image_input::Image]::Some(image) = images.at_ptr(index) else { return false; };
        let shape: conditioning::Shape = (*image).shape;
        let pixels: usize = shape.width *% shape.height;
        guard let option::Option[pack::Buffer]::Some(host) = pack::Buffer::allocate(pixels *% (16 as usize)) else { return false; };
        image_input::vae_input(*image, host.pointer as *f32);
        guard let option::Option[cuda::DeviceBuffer]::Some(device_image) = cuda::DeviceBuffer::allocate(host.length as u64) else { return false; };
        guard let option::Option[cuda::DeviceBuffer]::Some(latents) = cuda::DeviceBuffer::allocate((shape.latent_tokens *% LATENT *% (4 as usize)) as u64) else { return false; };
        guard let option::Option[vae::EncoderScratch]::Some(allocated) = vae::allocate_encoder_scratch(shape.height, shape.width) else {
            io::eprintln("multimodal conditioning: could not allocate the VAE encoder scratch");
            return false;
        };
        var scratch: vae::EncoderScratch = allocated;
        if !device_image.upload(host.pointer, host.length as u64)
            || !vae::encode(weights, scratch, device_image.pointer as *f32, shape.height, shape.width, latents.pointer as *f32)
            || !latents.download((latents_host + row *% LATENT) as *u8, (shape.latent_tokens *% LATENT *% (4 as usize)) as u64) {
            return false;
        }
        row = row +% shape.latent_tokens;
        index = index +% (1 as usize);
    }
    return true;
}

// With QI_DUMP_DIR set, writes `bytes` at `data` to that directory as `name`
// (development checks against tools/dump_oracle_edit.py).
fn dump(name: str, data: *u8, bytes: usize) {
    match env::var("QI_DUMP_DIR") {
        option::Option::Some(directory) => {
            let path: text::Text = "${directory.view()}/${name}";
            if !transformer::write_floats(path.view(), data, bytes) { io::eprintln("could not write ${path.view()}"); }
        }
        option::Option::None => {}
    }
}

// References are resized to the output area, as the reference pipeline's
// `output_resolution` does for both the vision tower and the VAE.
fn encode_images(model_root: str, prompt: str, image_paths: *str, image_count: usize, output_resolution: usize,
                 observer: control::Observer) -> option::Option[Encoded] {
    if !conditioning::reference_count_supported(image_count) {
        control::diagnose(observer, "Image editing takes 1 to 10 reference images.");
        return option::Option[Encoded]::None;
    }
    var phase: f64 = transformer::seconds();
    var images: vec::Vec[image_input::Image] = vec::Vec[image_input::Image]::with_capacity(image_count);
    var shapes: vec::Vec[conditioning::Shape] = vec::Vec[conditioning::Shape]::with_capacity(image_count);
    var token_counts: vec::Vec[usize] = vec::Vec[usize]::with_capacity(image_count);
    var vision_rows: usize = 0 as usize;
    var condition_rows: usize = 0 as usize;
    var index: usize = 0 as usize;
    while index < image_count {
        if !control::report(observer, control::Phase::EncodingReferences, index, image_count) { return option::Option[Encoded]::None; }
        guard let option::Option[image_input::Image]::Some(image) = image_input::load_resized(image_paths[index], output_resolution) else {
            control::diagnose(observer, "Could not open reference image ${image_paths[index]}.");
            return option::Option[Encoded]::None;
        };
        let shape: conditioning::Shape = image.shape;
        if shapes.append(shape) != status::Status::Ok || token_counts.append(shape.vision_tokens) != status::Status::Ok
            || images.append(image) != status::Status::Ok {
            return option::Option[Encoded]::None;
        }
        vision_rows = vision_rows +% shape.vision_tokens;
        condition_rows = condition_rows +% shape.latent_tokens;
        index = index +% (1 as usize);
    }
    io::println("references: ${image_count} decoded and resized, ${transformer::seconds() - phase} s");

    phase = transformer::seconds();
    guard let option::Option[pack::Buffer]::Some(embeddings) = pack::Buffer::allocate(vision_rows *% WIDTH *% (4 as usize)) else { return option::Option[Encoded]::None; };
    guard let option::Option[pack::Buffer]::Some(deepstack) = pack::Buffer::allocate(DEEPSTACK_LAYERS *% vision_rows *% WIDTH *% (4 as usize)) else { return option::Option[Encoded]::None; };
    if !encode_vision(model_root, images, vision_rows, embeddings.pointer as *f32, deepstack.pointer as *f32) {
        control::diagnose(observer, "The vision encoder failed on the reference images. Check the text_encoder shards and GPU memory.");
        return option::Option[Encoded]::None;
    }
    io::println("vision: ${vision_rows} rows, ${transformer::seconds() - phase} s");

    phase = transformer::seconds();
    guard let option::Option[pack::Buffer]::Some(condition_latents) = pack::Buffer::allocate(condition_rows *% LATENT *% (4 as usize)) else { return option::Option[Encoded]::None; };
    if !encode_latents(model_root, images, condition_latents.pointer as *f32) {
        control::diagnose(observer, "The VAE encoder failed on the reference images. Check the VAE file and GPU memory.");
        return option::Option[Encoded]::None;
    }
    io::println("vae encode: ${condition_rows} rows, ${transformer::seconds() - phase} s");

    phase = transformer::seconds();
    if !control::report(observer, control::Phase::EncodingText, 0 as usize, 0 as usize) { return option::Option[Encoded]::None; }
    guard let option::Option[vec::Vec[u32]]::Some(tokens) = tokenizer::tokenize_full_prompt_with_images(model_root, prompt,
            #slice_ptr(token_counts.as_slice()), image_count) else {
        control::diagnose(observer, "Could not tokenize the prompt and references. Check the processor files.");
        return option::Option[Encoded]::None;
    };
    let count: usize = tokens.count();
    guard let option::Option[pack::Buffer]::Some(positions) = pack::Buffer::allocate(count *% (12 as usize)) else { return option::Option[Encoded]::None; };
    if count <= SYSTEM_TOKENS || !conditioning::fill_language_positions(#slice_ptr(tokens.as_slice()), count,
            #slice_ptr(shapes.as_slice()), image_count, positions.pointer as *u32) {
        io::eprintln("multimodal conditioning: could not build M-RoPE positions");
        return option::Option[Encoded]::None;
    }
    let prompt_rows: usize = count -% SYSTEM_TOKENS;
    guard let option::Option[pack::Buffer]::Some(prompt_embeddings) = pack::Buffer::allocate(prompt_rows *% WIDTH *% (4 as usize)) else { return option::Option[Encoded]::None; };
    let multimodal: text_encoder::Multimodal = text_encoder::Multimodal {
        positions: positions.pointer as *u32,
        vision: embeddings.pointer as *f32,
        deepstack: deepstack.pointer as *f32,
        vision_rows: vision_rows,
    };
    if !text_encoder::encode(model_root, #slice_ptr(tokens.as_slice()) as *i32, count, text_encoder::Options { bf16_boundaries: true, half_gemm: true },
            prompt_embeddings.pointer as *f32, multimodal) {
        control::diagnose(observer, "The text encoder failed while combining the prompt and references.");
        return option::Option[Encoded]::None;
    }
    dump("input_ids.i32", #slice_ptr(tokens.as_slice()) as *u8, count *% (4 as usize));
    dump("positions.i32", positions.pointer, positions.length);
    dump("vision_embeds.f32", embeddings.pointer, embeddings.length);
    dump("deepstack.f32", deepstack.pointer, deepstack.length);
    dump("condition_latents.f32", condition_latents.pointer, condition_latents.length);
    dump("prompt_embeds.f32", prompt_embeddings.pointer, prompt_embeddings.length);
    guard let option::Option[pack::Buffer]::Some(image_pad) = pack::Buffer::allocate(prompt_rows) else { return option::Option[Encoded]::None; };
    let token_values: *u32 = #slice_ptr(tokens.as_slice());
    var row: usize = 0 as usize;
    while row < prompt_rows {
        image_pad.pointer[row] = if token_values[row +% SYSTEM_TOKENS] == IMAGE_PAD_TOKEN { 1 as u8 } else { 0 as u8 };
        row = row +% (1 as usize);
    }
    dump("image_pad_mask.u8", image_pad.pointer, prompt_rows);
    io::println("text: ${count} tokens (${vision_rows} image), ${transformer::seconds() - phase} s");
    return option::Option[Encoded]::Some(Encoded {
        prompt: prompt_embeddings,
        image_pad: image_pad,
        prompt_rows: prompt_rows,
        condition_latents: condition_latents,
        condition_rows: condition_rows,
        shapes: shapes,
    });
}

// Conditioned prefix, then the denoising steps, to final latents on the host.
fn denoise(pack_path: str, mode: transformer::WeightMode, encoded: Encoded, latent_height: usize, latent_width: usize,
           seed: u64, steps: usize, observer: control::Observer, latents_host: *f32) -> i32 {
    let image_rows: usize = latent_height *% latent_width;
    let pad_rows: usize = encoded.condition_rows / (4 as usize);
    let prefix_rows: usize = encoded.prompt_rows -% pad_rows +% encoded.condition_rows;
    let blocks: usize = encoded.shapes.count();
    guard let option::Option[pack::Buffer]::Some(heights) = pack::Buffer::allocate(blocks *% (8 as usize)) else { return 1; };
    guard let option::Option[pack::Buffer]::Some(widths) = pack::Buffer::allocate(blocks *% (8 as usize)) else { return 1; };
    let shape_values: *conditioning::Shape = #slice_ptr(encoded.shapes.as_slice());
    var block: usize = 0 as usize;
    while block < blocks {
        (heights.pointer as *usize)[block] = shape_values[block].height / (16 as usize);
        (widths.pointer as *usize)[block] = shape_values[block].width / (16 as usize);
        block = block +% (1 as usize);
    }
    guard let option::Option[pack::Buffer]::Some(rope_host) = pack::Buffer::allocate((prefix_rows +% image_rows) *% (512 as usize)) else { return 1; };
    if inputs::rope_table_conditioned(encoded.image_pad.pointer, encoded.prompt_rows, heights.pointer as *usize, widths.pointer as *usize,
            blocks, latent_height, latent_width, rope_host.pointer as *f32) != prefix_rows +% image_rows {
        io::eprintln("multimodal conditioning: image placeholders do not match the condition images");
        return 1;
    }
    dump("rope.f32", rope_host.pointer, rope_host.length);
    guard let option::Option[pack::Buffer]::Some(scratch) = pack::Buffer::allocate(image_rows *% LATENT *% (4 as usize)) else { return 1; };
    if !inputs::initial_noise(seed, latent_height, latent_width, inputs::NoiseDtype::Float16, scratch.pointer as *f32, latents_host) {
        return 1;
    }
    guard let option::Option[cuda::DeviceBuffer]::Some(rope) = cuda::DeviceBuffer::allocate(rope_host.length as u64) else { return 1; };
    guard let option::Option[cuda::DeviceBuffer]::Some(latents) = cuda::DeviceBuffer::allocate((image_rows *% LATENT *% (4 as usize)) as u64) else { return 1; };
    if !rope.upload(rope_host.pointer, rope_host.length as u64)
        || !latents.upload(latents_host as *u8, (image_rows *% LATENT *% (4 as usize)) as u64) {
        return 1;
    }
    let largest: usize = if prefix_rows > image_rows { prefix_rows } else { image_rows };
    guard let option::Option[transformer::Work]::Some(allocated) = transformer::allocate_work(
        if largest > encoded.prompt_rows { largest } else { encoded.prompt_rows }, prefix_rows +% image_rows) else {
        control::diagnose(observer, "Not enough GPU memory for the transformer activations at this size.");
        return 1;
    };
    var work: transformer::Work = allocated;
    guard let option::Option[transformer::Model]::Some(loaded) = transformer::load(pack_path, mode, true, transformer::cache_bytes(prefix_rows)) else {
        control::diagnose(observer, "Could not load the transformer pack.");
        return 1;
    };
    var model: transformer::Model = loaded;
    guard let option::Option[transformer::PrefixCache]::Some(computed) = transformer::prefix_conditioned(model, work,
            encoded.prompt.pointer as *f32, encoded.image_pad.pointer, encoded.prompt_rows, encoded.condition_latents.pointer as *f32,
            encoded.condition_rows, rope.pointer as *f32) else {
        return 1;
    };
    var cache: transformer::PrefixCache = computed;
    if !control::report(observer, control::Phase::Denoising, 0 as usize, steps) { return 3; }
    if !transformer::denoise(model, work, cache, latents.pointer as *f32, image_rows, steps, rope.pointer as *f32) {
        return 1;
    }
    if !control::report(observer, control::Phase::Denoising, steps, steps) { return 3; }
    if !latents.download(latents_host as *u8, (image_rows *% LATENT *% (4 as usize)) as u64) { return 1; }
    dump("final_latents.f32", latents_host as *u8, image_rows *% LATENT *% (4 as usize));
    return 0;
}

fn run_multi_image_transformer(
    packed_path: str,
    model_root: str,
    image_paths: *str,
    image_count: usize,
    prompt: str = "Use Picture 1 and Picture 2 to create a coherent new scene.",
    requested_steps: str = "1",
    output_path: str = "",
    seed: u64 = 1301 as u64,
    output_resolution: usize = 512 as usize,
    observer: control::Observer = control::none(),
    output_width: usize = 0 as usize,
    output_height: usize = 0 as usize,
    benchmark_only: bool = false,
) -> i32 {
    let started: f64 = transformer::seconds();
    if !control::report(observer, control::Phase::Preparing, 0 as usize, 0 as usize) { return 3; }
    let width: usize = if output_width == (0 as usize) { output_resolution } else { output_width };
    let height: usize = if output_height == (0 as usize) { output_resolution } else { output_height };
    if !pipeline::output_dimensions_supported(width, height) {
        control::diagnose(observer, "Output sides must be at least 256 and divisible by 32.");
        return 2;
    }
    guard let option::Option[transformer::WeightMode]::Some(mode) = pipeline::weight_mode(packed_path) else {
        control::diagnose(observer, "The Linux engine needs a w4a4-h256-g64-v6 or w4a16-g64-v6 QIPACK.");
        return 2;
    };
    let steps: usize = pipeline::parse_steps(requested_steps);
    if steps == (0 as usize) { return 2; }
    let reference_resolution: usize = ((width *% height) as f64).sqrt() as usize;
    guard let option::Option[Encoded]::Some(encoded) = encode_images(model_root, prompt, image_paths, image_count,
            reference_resolution, observer) else {
        return 1;
    };
    let latent_height: usize = height / (16 as usize);
    let latent_width: usize = width / (16 as usize);
    guard let option::Option[pack::Buffer]::Some(latents) = pack::Buffer::allocate(latent_height *% latent_width *% LATENT *% (4 as usize)) else { return 1; };
    var phase: f64 = transformer::seconds();
    let denoised: i32 = denoise(packed_path, mode, encoded, latent_height, latent_width, seed, steps, observer, latents.pointer as *f32);
    if denoised != (0 as i32) { return denoised; }
    io::println("transformer: ${transformer::seconds() - phase} s (load, conditioned prefix of ${encoded.condition_rows} condition rows, ${steps} steps)");
    if benchmark_only || output_path.count() == (0 as usize) {
        io::println("end to end (no decode): ${transformer::seconds() - started} s");
        return 0;
    }
    if !control::report(observer, control::Phase::Decoding, steps, steps) { return 3; }
    phase = transformer::seconds();
    if pipeline::decode(model_root, latents.pointer as *f32, latent_height, latent_width, output_path) != (0 as i32) {
        control::diagnose(observer, "VAE decoding or PNG output failed.");
        return 1;
    }
    io::println("vae + png: ${transformer::seconds() - phase} s");
    io::println("end to end: ${transformer::seconds() - started} s -> ${output_path}");
    return 0;
}
