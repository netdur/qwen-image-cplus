#[link_name = "open"]
extern fn qi_pack_open(path: *u8, flags: i32, mode: i32) -> i32;
#[link_name = "write"]
extern fn qi_pack_write(fd: i32, bytes: *u8, count: usize) -> isize;
#[link_name = "lseek"]
extern fn qi_pack_lseek(fd: i32, offset: i64, whence: i32) -> i64;
#[link_name = "pwrite"]
extern fn qi_pack_pwrite(fd: i32, bytes: *u8, count: usize, offset: i64) -> isize;
#[link_name = "fsync"]
extern fn qi_pack_fsync(fd: i32) -> i32;
#[link_name = "fchmod"]
extern fn qi_pack_fchmod(fd: i32, mode: u16) -> i32;
#[link_name = "close"]
extern fn qi_pack_close(fd: i32) -> i32;
#[link_name = "rename"]
extern fn qi_pack_rename(source: *u8, destination: *u8) -> i32;
#[link_name = "unlink"]
extern fn qi_pack_unlink(path: *u8) -> i32;
extern fn malloc(size: usize) -> *u8;
extern fn free(pointer: *u8);

const VERSION: u32 = 1;
const HEADER_BYTES: u64 = 256;
const RECORD_BYTES: u64 = 256;
const DATA_ALIGNMENT: u64 = 4096;
const TENSOR_ALIGNMENT: u64 = 256;
const BLOCK0_TENSOR_COUNT: usize = 9;
const FULL_TENSOR_COUNT: usize = 297;
const GLOBAL_TENSOR_COUNT: usize = 9;
const BLOCK_TENSOR_COUNT: usize = 9;
const TRANSFORMER_BLOCK_COUNT: usize = 32;
const SCOPE_BLOCK0: u32 = 1;
const SCOPE_TRANSFORMER: u32 = 2;
const O_WRONLY: i32 = 1;
const O_RDWR: i32 = 2;
const O_CREAT: i32 = 0x0200;
const O_TRUNC: i32 = 0x0400;
const SEEK_SET: i32 = 0;
const SCHEME_BF16: u32 = 0;
const SCHEME_FP16: u32 = 1;
const SCHEME_INT8_AFFINE: u32 = 3;
const SCHEME_INT4_ROTATED: u32 = 4;
const TYPE_NONE: u32 = 0;
const TYPE_F16: u32 = 1;
const TYPE_U8: u32 = 2;
const FNV_OFFSET: u64 = 14695981039346656037;
const FNV_PRIME: u64 = 1099511628211;
const SNAPSHOT: str = "b3179ad355be050328e483a9dfdd9e60cd62adfa";
const DIFFUSERS_COMMIT: str = "80c7ed262aeffbeb43ef13ae04baeb9b84515a69";
const LEGACY_FULL_POLICY: str = "transformer:mixed-q8-g64-v1";
const FP16_MLP_POLICY: str = "transformer:q8-g64-f16-v2";
const QKV_FP16_Q8_POLICY: str = "transformer:qkv-f16-q8-g64-v3";
const FULL_POLICY: str = "transformer:all-matrix-f16-v4";
const INT4_ROTATED_POLICY: str = "transformer:int4-rot-h256-v5";
const FULL_PARAMETER_COUNT: u64 = 7115124736;
const LEGACY_FULL_FILE_BYTES: u64 = 13334843392;
const FULL_FILE_BYTES: u64 = 14230327296;
const INT4_ROTATED_FILE_BYTES: u64 = 3561009408;

#[repr(C)]
struct PackedHeader {
    magic: [u8; 8],
    version: u32,
    header_bytes: u32,
    tensor_count: u32,
    scope: u32,
    directory_offset: u64,
    data_offset: u64,
    file_bytes: u64,
    payload_checksum: u64,
    model_snapshot: [u8; 40],
    diffusers_commit: [u8; 40],
    policy: [u8; 32],
    // Optional key/value metadata block (see docs/packed-format-v1.md).
    // All zero means the pack carries no metadata.
    metadata_offset: u64,
    metadata_bytes: u32,
    metadata_version: u32,
    metadata_checksum: u64,
    reserved: [u8; 64],
}

#[repr(C)]
struct PackedRecord {
    name: [u8; 128],
    scheme: u32,
    rank: u32,
    dimensions: [u64; 4],
    group_axis: u32,
    group_size: u32,
    scale_type: u32,
    zero_type: u32,
    weights_offset: u64,
    weights_length: u64,
    scales_offset: u64,
    scales_length: u64,
    zeros_offset: u64,
    zeros_length: u64,
    elements: u64,
    tensor_checksum: u64,
    reserved: [u8; 8],
}

struct TensorSpec {
    name: str,
    output: u64,
    input: u64,
    quantized: bool,
}

struct FullTensorSpec {
    output: u64,
    input: u64,
    quantized: bool,
}

struct OwnedBytes {
    opaque pointer: *u8,
    length: usize,
}

// An owning, validated mapping of a QIPACK1 artifact. TensorData values are
// borrowed views and must not outlive this File.
struct File {
    _mapping: mapped::MappedFile,
}

struct TensorData {
    opaque weights: *u8,
    opaque scales: *u8,
    opaque zeros: *u8,
    weights_offset: u64,
    scales_offset: u64,
    zeros_offset: u64,
    weights_length: u64,
    scales_length: u64,
    zeros_length: u64,
    output: u64,
    input: u64,
    scheme: u32,
    group_size: u32,
    eager_fp16_offset: u64,
}

struct RuntimeHashJob {
    opaque file_pointer: *u8,
    opaque records: *PackedRecord,
    start: usize,
    end: usize,
}

// The mapped file remains owned by load() until every worker is joined. Jobs
// only read disjoint record ranges and immutable mapped bytes.
impl RuntimeHashJob: Send {}

enum LoadResult {
    Ok(File),
    Err,
}

impl File {
    fn pointer(this) -> *u8 {
        return this._mapping.pointer();
    }

    fn length(this) -> usize {
        return this._mapping.length();
    }

    fn tensor(this, name: str) -> option::Option[TensorData] {
        let header: *PackedHeader = this._mapping.pointer() as *PackedHeader;
        let records: *PackedRecord =
            (this._mapping.pointer() + (*header).directory_offset as usize) as *PackedRecord;
        var index: usize = 0 as usize;
        while index < (*header).tensor_count as usize {
            let record: *PackedRecord = records + index;
            if fixed_matches(#addr_of((*record).name[0]), 128 as usize, name) {
                return option::Option[TensorData]::Some(TensorData {
                    weights: this._mapping.pointer() + (*record).weights_offset as usize,
                    scales: this._mapping.pointer() + (*record).scales_offset as usize,
                    zeros: this._mapping.pointer() + (*record).zeros_offset as usize,
                    weights_offset: (*record).weights_offset,
                    scales_offset: (*record).scales_offset,
                    zeros_offset: (*record).zeros_offset,
                    weights_length: (*record).weights_length,
                    scales_length: (*record).scales_length,
                    zeros_length: (*record).zeros_length,
                    output: (*record).dimensions[0],
                    input: (*record).dimensions[1],
                    scheme: (*record).scheme,
                    group_size: (*record).group_size,
                    eager_fp16_offset: full_fp16_weight_offset(index),
                });
            }
            index = index +% (1 as usize);
        }
        return option::Option[TensorData]::None;
    }

    fn quantized_matrix_count(this) -> usize {
        let header: *PackedHeader = this._mapping.pointer() as *PackedHeader;
        let records: *PackedRecord =
            (this._mapping.pointer() + (*header).directory_offset as usize) as *PackedRecord;
        var count: usize = 0 as usize;
        var index: usize = 0 as usize;
        while index < (*header).tensor_count as usize {
            let record: *PackedRecord = records + index;
            if (*record).scheme == SCHEME_INT8_AFFINE {
                count = count +% (1 as usize);
            }
            index = index +% (1 as usize);
        }
        return count;
    }

    fn all_block_matrices_fp16(this) -> bool {
        let header: *PackedHeader = this._mapping.pointer() as *PackedHeader;
        return fixed_matches(
            #addr_of((*header).policy[0]), 32 as usize, FULL_POLICY,
        );
    }

    fn int4_rotated(this) -> bool {
        let header: *PackedHeader = this._mapping.pointer() as *PackedHeader;
        return fixed_matches(
            #addr_of((*header).policy[0]), 32 as usize, INT4_ROTATED_POLICY,
        );
    }

    fn tensor_count(this) -> usize {
        let header: *PackedHeader = this._mapping.pointer() as *PackedHeader;
        return (*header).tensor_count as usize;
    }

    fn tensor_at(this, index: usize) -> option::Option[TensorData] {
        let header: *PackedHeader = this._mapping.pointer() as *PackedHeader;
        if index >= (*header).tensor_count as usize {
            return option::Option[TensorData]::None;
        }
        let records: *PackedRecord =
            (this._mapping.pointer() + (*header).directory_offset as usize) as *PackedRecord;
        let record: *PackedRecord = records + index;
        return option::Option[TensorData]::Some(TensorData {
            weights: this._mapping.pointer() + (*record).weights_offset as usize,
            scales: this._mapping.pointer() + (*record).scales_offset as usize,
            zeros: this._mapping.pointer() + (*record).zeros_offset as usize,
            weights_offset: (*record).weights_offset,
            scales_offset: (*record).scales_offset,
            zeros_offset: (*record).zeros_offset,
            weights_length: (*record).weights_length,
            scales_length: (*record).scales_length,
            zeros_length: (*record).zeros_length,
            output: (*record).dimensions[0],
            input: (*record).dimensions[1],
            scheme: (*record).scheme,
            group_size: (*record).group_size,
            eager_fp16_offset: full_fp16_weight_offset(index),
        });
    }

    fn eager_fp16_bytes(this) -> u64 {
        return FULL_FILE_BYTES;
    }
}

impl OwnedBytes {
    fn allocate(length: usize) -> option::Option[OwnedBytes] {
        if length == (0 as usize) {
            return option::Option[OwnedBytes]::None;
        }
        let pointer: *u8 = malloc(length);
        if pointer.is_null() {
            return option::Option[OwnedBytes]::None;
        }
        return option::Option[OwnedBytes]::Some(OwnedBytes { pointer: pointer, length: length });
    }

    fn drop(ref this) {
        if !this.pointer.is_null() {
            free(this.pointer);
            this.pointer = 0 as *u8;
            this.length = 0 as usize;
        }
    }
}

fn align_up(value: u64, alignment: u64) -> u64 {
    return ((value +% alignment -% (1 as u64)) / alignment) *% alignment;
}

fn hash_update(hash: u64, bytes: *u8, count: usize) -> u64 {
    var result: u64 = hash;
    var index: usize = 0 as usize;
    while index < count {
        result = (result ^ bytes[index] as u64) *% FNV_PRIME;
        index = index +% (1 as usize);
    }
    return result;
}

fn fixed_text(destination: *u8, capacity: usize, source: str) -> bool {
    if source.count() > capacity {
        return false;
    }
    var index: usize = 0 as usize;
    while index < capacity {
        destination[index] = 0 as u8;
        index = index +% (1 as usize);
    }
    index = 0 as usize;
    while index < source.count() {
        guard let option::Option[u8]::Some(byte) = source.byte_at(index) else { return false; };
        destination[index] = byte;
        index = index +% (1 as usize);
    }
    return true;
}

fn fixed_matches(source: *u8, capacity: usize, expected: str) -> bool {
    if expected.count() > capacity {
        return false;
    }
    var index: usize = 0 as usize;
    while index < expected.count() {
        guard let option::Option[u8]::Some(byte) = expected.byte_at(index) else { return false; };
        if source[index] != byte {
            return false;
        }
        index = index +% (1 as usize);
    }
    while index < capacity {
        if source[index] != (0 as u8) {
            return false;
        }
        index = index +% (1 as usize);
    }
    return true;
}

fn magic_matches(header: *PackedHeader) -> bool {
    let expected: [u8; 8] = [
        81 as u8, 73 as u8, 80 as u8, 65 as u8,
        67 as u8, 75 as u8, 49 as u8, 0 as u8,
    ];
    var index: usize = 0 as usize;
    while index < (8 as usize) {
        if (*header).magic[index] != expected[index] {
            return false;
        }
        index = index +% (1 as usize);
    }
    return true;
}

fn write_all(fd: i32, bytes: *u8, count: usize) -> bool {
    var written: usize = 0 as usize;
    while written < count {
        let result: isize = qi_pack_write(fd, bytes + written, count -% written);
        if result <= (0 as isize) {
            return false;
        }
        written = written +% result as usize;
    }
    return true;
}

fn write_zeroes(fd: i32, count: u64, ref checksum: u64, include_in_checksum: bool) -> bool {
    var zeroes: [u8; 256] = [0 as u8; 256];
    var remaining: u64 = count;
    while remaining > (0 as u64) {
        let amount: usize = if remaining < (256 as u64) { remaining as usize } else { 256 as usize };
        if !write_all(fd, #addr_of(zeroes[0]), amount) {
            return false;
        }
        if include_in_checksum {
            checksum = hash_update(checksum, #addr_of(zeroes[0]), amount);
        }
        remaining = remaining -% amount as u64;
    }
    return true;
}

fn write_payload(fd: i32, bytes: *u8, count: usize, ref checksum: u64) -> bool {
    if !write_all(fd, bytes, count) {
        return false;
    }
    checksum = hash_update(checksum, bytes, count);
    return true;
}

fn make_specs() -> [TensorSpec; 9] {
    return [
        TensorSpec { name: "transformer_blocks.0.attn.norm_k.weight", output: 128 as u64, input: 0 as u64, quantized: false },
        TensorSpec { name: "transformer_blocks.0.attn.norm_q.weight", output: 128 as u64, input: 0 as u64, quantized: false },
        TensorSpec { name: "transformer_blocks.0.attn.to_k.weight", output: 4096 as u64, input: 4096 as u64, quantized: true },
        TensorSpec { name: "transformer_blocks.0.attn.to_out.0.weight", output: 4096 as u64, input: 4096 as u64, quantized: true },
        TensorSpec { name: "transformer_blocks.0.attn.to_q.weight", output: 4096 as u64, input: 4096 as u64, quantized: true },
        TensorSpec { name: "transformer_blocks.0.attn.to_v.weight", output: 4096 as u64, input: 4096 as u64, quantized: true },
        TensorSpec { name: "transformer_blocks.0.img_mlp.gate_layer.weight", output: 12288 as u64, input: 4096 as u64, quantized: true },
        TensorSpec { name: "transformer_blocks.0.img_mlp.out.weight", output: 4096 as u64, input: 12288 as u64, quantized: true },
        TensorSpec { name: "transformer_blocks.0.img_mlp.proj.weight", output: 12288 as u64, input: 4096 as u64, quantized: true },
    ];
}

fn full_tensor_name(index: usize, qkv_policy: bool = false) -> text::Text {
    if index == (0 as usize) { return text::from_str("img_in.weight"); }
    if index == (1 as usize) { return text::from_str("modulation.1.weight"); }
    if index == (2 as usize) { return text::from_str("norm_out.linear.weight"); }
    if index == (3 as usize) { return text::from_str("proj_out.weight"); }
    if index == (4 as usize) {
        return text::from_str("time_text_embed.timestep_embedder.linear_1.weight");
    }
    if index == (5 as usize) {
        return text::from_str("time_text_embed.timestep_embedder.linear_2.weight");
    }
    if index == (6 as usize) { return text::from_str("txt_in.in_layer.weight"); }
    if index == (7 as usize) { return text::from_str("txt_in.out_layer.weight"); }
    if index == (8 as usize) { return text::from_str("txt_in.text_norm.weight"); }

    let block_index: usize = (index -% GLOBAL_TENSOR_COUNT) / BLOCK_TENSOR_COUNT;
    let role_index: usize = (index -% GLOBAL_TENSOR_COUNT) % BLOCK_TENSOR_COUNT;
    if role_index == (0 as usize) {
        return "transformer_blocks.${block_index}.attn.norm_k.weight";
    }
    if role_index == (1 as usize) {
        return "transformer_blocks.${block_index}.attn.norm_q.weight";
    }
    if role_index == (2 as usize) {
        return if qkv_policy {
            "transformer_blocks.${block_index}.attn.to_q.weight"
        } else {
            "transformer_blocks.${block_index}.attn.to_k.weight"
        };
    }
    if role_index == (3 as usize) {
        return if qkv_policy {
            "transformer_blocks.${block_index}.attn.to_k.weight"
        } else {
            "transformer_blocks.${block_index}.attn.to_out.0.weight"
        };
    }
    if role_index == (4 as usize) {
        return if qkv_policy {
            "transformer_blocks.${block_index}.attn.to_v.weight"
        } else {
            "transformer_blocks.${block_index}.attn.to_q.weight"
        };
    }
    if role_index == (5 as usize) {
        return if qkv_policy {
            "transformer_blocks.${block_index}.attn.to_out.0.weight"
        } else {
            "transformer_blocks.${block_index}.attn.to_v.weight"
        };
    }
    if role_index == (6 as usize) {
        return "transformer_blocks.${block_index}.img_mlp.gate_layer.weight";
    }
    if role_index == (7 as usize) {
        return "transformer_blocks.${block_index}.img_mlp.out.weight";
    }
    return "transformer_blocks.${block_index}.img_mlp.proj.weight";
}

fn full_tensor_spec(index: usize) -> FullTensorSpec {
    if index == (0 as usize) {
        return FullTensorSpec { output: 4096 as u64, input: 64 as u64, quantized: false };
    }
    if index == (1 as usize) {
        return FullTensorSpec { output: 16384 as u64, input: 4096 as u64, quantized: false };
    }
    if index == (2 as usize) {
        return FullTensorSpec { output: 4096 as u64, input: 4096 as u64, quantized: false };
    }
    if index == (3 as usize) {
        return FullTensorSpec { output: 64 as u64, input: 4096 as u64, quantized: false };
    }
    if index == (4 as usize) {
        return FullTensorSpec { output: 4096 as u64, input: 256 as u64, quantized: false };
    }
    if index == (5 as usize) || index == (6 as usize) || index == (7 as usize) {
        return FullTensorSpec { output: 4096 as u64, input: 4096 as u64, quantized: false };
    }
    if index == (8 as usize) {
        return FullTensorSpec { output: 4096 as u64, input: 0 as u64, quantized: false };
    }

    let block_index: usize = (index -% GLOBAL_TENSOR_COUNT) / BLOCK_TENSOR_COUNT;
    let role_index: usize = (index -% GLOBAL_TENSOR_COUNT) % BLOCK_TENSOR_COUNT;
    if role_index == (0 as usize) || role_index == (1 as usize) {
        return FullTensorSpec { output: 128 as u64, input: 0 as u64, quantized: false };
    }
    if role_index >= (2 as usize) && role_index <= (5 as usize) {
        return FullTensorSpec {
            output: 4096 as u64,
            input: 4096 as u64,
            quantized: block_index >= (24 as usize),
        };
    }
    if role_index == (6 as usize) {
        return FullTensorSpec { output: 12288 as u64, input: 4096 as u64, quantized: false };
    }
    if role_index == (7 as usize) {
        return FullTensorSpec {
            output: 4096 as u64,
            input: 12288 as u64,
            quantized: block_index >= (28 as usize),
        };
    }
    return FullTensorSpec {
        output: 12288 as u64,
        input: 4096 as u64,
        quantized: block_index >= (28 as usize),
    };
}

// MPS accepts FP16 but not BF16 matrices on Apple family 7. The v4 policy
// stores every block matrix in FP16; older policies retain their measured
// mixtures so existing artifacts remain readable.
fn full_tensor_uses_fp16(
    index: usize,
    qkv_policy: bool = false,
    all_matrix_policy: bool = false,
) -> bool {
    if index < GLOBAL_TENSOR_COUNT { return false; }
    let spec: FullTensorSpec = full_tensor_spec(index);
    if all_matrix_policy { return spec.input != (0 as u64); }
    let role_index: usize = (index -% GLOBAL_TENSOR_COUNT) % BLOCK_TENSOR_COUNT;
    let dense_qkv: bool = qkv_policy
        && role_index >= (2 as usize) && role_index <= (4 as usize);
    return (dense_qkv || role_index >= (6 as usize)) && !spec.quantized;
}

// H256 rotation requires a matrix K dimension divisible by 256. The only
// excluded matrix is img_in.weight with K=64; vectors remain BF16.
fn full_tensor_uses_int4_rotated(index: usize) -> bool {
    let spec: FullTensorSpec = full_tensor_spec(index);
    return spec.input >= (256 as u64) && spec.input % (256 as u64) == (0 as u64);
}

fn full_expected_scheme(
    index: usize,
    fp16_policy: bool,
    qkv_policy: bool = false,
    all_matrix_policy: bool = false,
    int4_rotated_policy: bool = false,
) -> u32 {
    if int4_rotated_policy && full_tensor_uses_int4_rotated(index) {
        return SCHEME_INT4_ROTATED;
    }
    let spec: FullTensorSpec = full_tensor_spec(index);
    if fp16_policy && full_tensor_uses_fp16(index, qkv_policy, all_matrix_policy) {
        return SCHEME_FP16;
    }
    if spec.quantized { return SCHEME_INT8_AFFINE; }
    return SCHEME_BF16;
}

fn make_full_record(
    index: usize,
    name: str,
    spec: FullTensorSpec,
    ref cursor: u64,
    int4_rotated_policy: bool = false,
) -> PackedRecord {
    let elements: u64 = if spec.input == (0 as u64) { spec.output } else { spec.output *% spec.input };
    let scheme: u32 = full_expected_scheme(index, true, true, true, int4_rotated_policy);
    let quantized: bool = scheme == SCHEME_INT8_AFFINE;
    let int4_rotated: bool = scheme == SCHEME_INT4_ROTATED;
    let groups: u64 = if quantized { spec.output *% (spec.input / (64 as u64)) } else { 0 as u64 };
    var record: PackedRecord = PackedRecord {
        name: [0 as u8; 128],
        scheme: scheme,
        rank: if spec.input == (0 as u64) { 1 as u32 } else { 2 as u32 },
        dimensions: [spec.output, spec.input, 0 as u64, 0 as u64],
        group_axis: if quantized || int4_rotated { 1 as u32 } else { (0xFFFFFFFF as u32) },
        group_size: if int4_rotated { 256 as u32 } else if quantized { 64 as u32 } else { 0 as u32 },
        scale_type: if quantized || int4_rotated { TYPE_F16 } else { TYPE_NONE },
        zero_type: if quantized { TYPE_U8 } else { TYPE_NONE },
        weights_offset: 0 as u64,
        weights_length: if int4_rotated {
            (elements +% (1 as u64)) / (2 as u64)
        } else if quantized { elements } else { elements *% (2 as u64) },
        scales_offset: 0 as u64,
        scales_length: if int4_rotated { spec.output *% (2 as u64) } else { groups *% (2 as u64) },
        zeros_offset: 0 as u64,
        zeros_length: groups,
        elements: elements,
        tensor_checksum: 0 as u64,
        reserved: [0 as u8; 8],
    };
    let _name_ok: bool = fixed_text(#addr_of(record.name[0]), 128 as usize, name);
    cursor = align_up(cursor, TENSOR_ALIGNMENT);
    record.weights_offset = cursor;
    cursor = cursor +% record.weights_length;
    if quantized || int4_rotated {
        cursor = align_up(cursor, TENSOR_ALIGNMENT);
        record.scales_offset = cursor;
        cursor = cursor +% record.scales_length;
    }
    if quantized {
        cursor = align_up(cursor, TENSOR_ALIGNMENT);
        record.zeros_offset = cursor;
        cursor = cursor +% record.zeros_length;
    }
    return record;
}

// Eager Q4 expansion deliberately uses the established all-FP16 v4 offsets.
// In particular, Q/K/V stay adjacent so the production runtime can retain its
// single 4096-to-12288 MPS multiplication after expansion.
fn full_fp16_weight_offset(target_index: usize) -> u64 {
    var cursor: u64 = align_up(
        HEADER_BYTES +% RECORD_BYTES *% FULL_TENSOR_COUNT as u64,
        DATA_ALIGNMENT,
    );
    var index: usize = 0 as usize;
    while index <= target_index && index < FULL_TENSOR_COUNT {
        let name: text::Text = full_tensor_name(index, true);
        let record: PackedRecord = make_full_record(
            index, name.view(), full_tensor_spec(index), cursor, false,
        );
        if index == target_index { return record.weights_offset; }
        index = index +% (1 as usize);
    }
    return 0 as u64;
}

fn full_layout_file_bytes(int4_rotated_policy: bool) -> u64 {
    var cursor: u64 = align_up(
        HEADER_BYTES +% RECORD_BYTES *% FULL_TENSOR_COUNT as u64,
        DATA_ALIGNMENT,
    );
    var index: usize = 0 as usize;
    while index < FULL_TENSOR_COUNT {
        let name: text::Text = full_tensor_name(index, true);
        let _record: PackedRecord = make_full_record(
            index, name.view(), full_tensor_spec(index), cursor, int4_rotated_policy,
        );
        index = index +% (1 as usize);
    }
    return align_up(cursor, TENSOR_ALIGNMENT);
}

fn make_record(spec: TensorSpec, ref cursor: u64) -> PackedRecord {
    let elements: u64 = if spec.input == (0 as u64) { spec.output } else { spec.output *% spec.input };
    let groups: u64 = if spec.quantized { spec.output *% (spec.input / (64 as u64)) } else { 0 as u64 };
    var record: PackedRecord = PackedRecord {
        name: [0 as u8; 128],
        scheme: if spec.quantized { SCHEME_INT8_AFFINE } else { SCHEME_BF16 },
        rank: if spec.input == (0 as u64) { 1 as u32 } else { 2 as u32 },
        dimensions: [spec.output, spec.input, 0 as u64, 0 as u64],
        group_axis: if spec.quantized { 1 as u32 } else { (0xFFFFFFFF as u32) },
        group_size: if spec.quantized { 64 as u32 } else { 0 as u32 },
        scale_type: if spec.quantized { TYPE_F16 } else { TYPE_NONE },
        zero_type: if spec.quantized { TYPE_U8 } else { TYPE_NONE },
        weights_offset: 0 as u64,
        weights_length: if spec.quantized { elements } else { elements *% (2 as u64) },
        scales_offset: 0 as u64,
        scales_length: groups *% (2 as u64),
        zeros_offset: 0 as u64,
        zeros_length: groups,
        elements: elements,
        tensor_checksum: 0 as u64,
        reserved: [0 as u8; 8],
    };
    let _name_ok: bool = fixed_text(#addr_of(record.name[0]), 128 as usize, spec.name);
    cursor = align_up(cursor, TENSOR_ALIGNMENT);
    record.weights_offset = cursor;
    cursor = cursor +% record.weights_length;
    if spec.quantized {
        cursor = align_up(cursor, TENSOR_ALIGNMENT);
        record.scales_offset = cursor;
        cursor = cursor +% record.scales_length;
        cursor = align_up(cursor, TENSOR_ALIGNMENT);
        record.zeros_offset = cursor;
        cursor = cursor +% record.zeros_length;
    }
    return record;
}

fn quantize_tensor(tensor: safetensors::TensorData, record: PackedRecord) -> option::Option[[OwnedBytes; 3]] {
    guard let option::Option[OwnedBytes]::Some(weights) = OwnedBytes::allocate(record.weights_length as usize) else {
        return option::Option[[OwnedBytes; 3]]::None;
    };
    guard let option::Option[OwnedBytes]::Some(scales) = OwnedBytes::allocate(record.scales_length as usize) else {
        return option::Option[[OwnedBytes; 3]]::None;
    };
    guard let option::Option[OwnedBytes]::Some(zeros) = OwnedBytes::allocate(record.zeros_length as usize) else {
        return option::Option[[OwnedBytes; 3]]::None;
    };
    let source: *u16 = tensor.pointer as *u16;
    let scale_values: *u16 = scales.pointer as *u16;
    let output_count: usize = record.dimensions[0] as usize;
    let input_count: usize = record.dimensions[1] as usize;
    let group_size: usize = record.group_size as usize;
    let groups_per_row: usize = input_count / group_size;
    var row: usize = 0 as usize;
    while row < output_count {
        var group: usize = 0 as usize;
        while group < groups_per_row {
            let start: usize = row *% input_count +% group *% group_size;
            var minimum: f32 = cpu::bf16_to_f32(source[start]);
            var maximum: f32 = minimum;
            var inner: usize = 1 as usize;
            while inner < group_size {
                let value: f32 = cpu::bf16_to_f32(source[start +% inner]);
                minimum = minimum.min(value);
                maximum = maximum.max(value);
                inner = inner +% (1 as usize);
            }
            var scale: f32 = (maximum - minimum) / 255.0f32;
            if scale == 0.0f32 {
                scale = 1.0f32;
            }
            let scale_bits: u16 = cpu::f32_to_fp16(scale);
            let stored_scale: f32 = cpu::fp16_to_f32(scale_bits);
            var zero_value: f32 = (0.0f32 - minimum) / stored_scale;
            zero_value = zero_value.round().max(0.0f32).min(255.0f32);
            let zero: u8 = zero_value as u8;
            let group_index: usize = row *% groups_per_row +% group;
            scale_values[group_index] = scale_bits;
            zeros.pointer[group_index] = zero;
            inner = 0 as usize;
            while inner < group_size {
                let value: f32 = cpu::bf16_to_f32(source[start +% inner]);
                var quantized: f32 = (value / stored_scale).round() + zero as f32;
                quantized = quantized.max(0.0f32).min(255.0f32);
                weights.pointer[start +% inner] = quantized as u8;
                inner = inner +% (1 as usize);
            }
            group = group +% (1 as usize);
        }
        row = row +% (1 as usize);
    }
    return option::Option[[OwnedBytes; 3]]::Some([weights, scales, zeros]);
}

fn hadamard_256_in_place(values: *f32) {
    var stride: usize = 1 as usize;
    while stride < (256 as usize) {
        let span: usize = stride *% (4 as usize);
        var base: usize = 0 as usize;
        while base < (256 as usize) {
            var offset: usize = 0 as usize;
            while offset < stride {
                let a: f32 = values[base +% offset];
                let b: f32 = values[base +% stride +% offset];
                let c: f32 = values[base +% (2 as usize) *% stride +% offset];
                let d: f32 = values[base +% (3 as usize) *% stride +% offset];
                values[base +% offset] = (a + b + c - d) * 0.5f32;
                values[base +% stride +% offset] = (a + b - c + d) * 0.5f32;
                values[base +% (2 as usize) *% stride +% offset] =
                    (a - b + c + d) * 0.5f32;
                values[base +% (3 as usize) *% stride +% offset] =
                    (0.0f32 - a + b + c + d) * 0.5f32;
                offset = offset +% (1 as usize);
            }
            base = base +% span;
        }
        stride = stride *% (4 as usize);
    }
}

// Rotate each contiguous H256 input group, then apply one symmetric signed-Q4
// scale per output row. Nibbles are two's-complement signed values in [-7, 7]
// with the even input column in the low nibble; -8 is intentionally unused.
fn quantize_tensor_int4_rotated(
    tensor: safetensors::TensorData,
    record: PackedRecord,
) -> option::Option[[OwnedBytes; 2]] {
    guard let option::Option[OwnedBytes]::Some(weights) = OwnedBytes::allocate(
        record.weights_length as usize,
    ) else { return option::Option[[OwnedBytes; 2]]::None; };
    guard let option::Option[OwnedBytes]::Some(scales) = OwnedBytes::allocate(
        record.scales_length as usize,
    ) else { return option::Option[[OwnedBytes; 2]]::None; };
    let input_count: usize = record.dimensions[1] as usize;
    guard let option::Option[OwnedBytes]::Some(row_storage) = OwnedBytes::allocate(
        input_count *% #size_of::[f32](),
    ) else { return option::Option[[OwnedBytes; 2]]::None; };
    let source: *u16 = tensor.pointer as *u16;
    let rotated: *f32 = row_storage.pointer as *f32;
    let scale_values: *u16 = scales.pointer as *u16;
    let output_count: usize = record.dimensions[0] as usize;
    var row: usize = 0 as usize;
    while row < output_count {
        var maximum: f32 = 0.0f32;
        var group_start: usize = 0 as usize;
        while group_start < input_count {
            var inner: usize = 0 as usize;
            while inner < (256 as usize) {
                rotated[group_start +% inner] = cpu::bf16_to_f32(
                    source[row *% input_count +% group_start +% inner],
                );
                inner = inner +% (1 as usize);
            }
            hadamard_256_in_place(rotated + group_start);
            inner = 0 as usize;
            while inner < (256 as usize) {
                maximum = maximum.max(rotated[group_start +% inner].abs());
                inner = inner +% (1 as usize);
            }
            group_start = group_start +% (256 as usize);
        }
        var scale: f32 = maximum / 7.0f32;
        if scale == 0.0f32 { scale = 1.0f32; }
        let scale_bits: u16 = cpu::f32_to_fp16(scale);
        let stored_scale: f32 = cpu::fp16_to_f32(scale_bits);
        scale_values[row] = scale_bits;
        var column: usize = 0 as usize;
        while column < input_count {
            var low: f32 = (rotated[column] / stored_scale).round();
            low = low.max(0.0f32 - 7.0f32).min(7.0f32);
            var high: f32 = (rotated[column +% (1 as usize)] / stored_scale).round();
            high = high.max(0.0f32 - 7.0f32).min(7.0f32);
            let low_nibble: u8 = ((low as i32) & (15 as i32)) as u8;
            let high_nibble: u8 = ((high as i32) & (15 as i32)) as u8;
            let packed_index: usize = (row *% input_count +% column) / (2 as usize);
            weights.pointer[packed_index] = low_nibble | (high_nibble << (4 as u8));
            column = column +% (2 as usize);
        }
        row = row +% (1 as usize);
    }
    return option::Option[[OwnedBytes; 2]]::Some([weights, scales]);
}

fn convert_tensor_to_fp16(tensor: safetensors::TensorData) -> option::Option[OwnedBytes] {
    guard let option::Option[OwnedBytes]::Some(output) = OwnedBytes::allocate(
        tensor.byte_length as usize,
    ) else { return option::Option[OwnedBytes]::None; };
    let source: *u16 = tensor.pointer as *u16;
    let destination: *u16 = output.pointer as *u16;
    let elements: usize = tensor.byte_length as usize / (2 as usize);
    var index: usize = 0 as usize;
    while index < elements {
        destination[index] = cpu::f32_to_fp16(cpu::bf16_to_f32(source[index]));
        index = index +% (1 as usize);
    }
    return option::Option[OwnedBytes]::Some(output);
}

fn verify_full_packed(file: mapped::MappedFile, quiet: bool) -> i32 {
    // The loader rejects invalid metadata, so the verifier must too.
    match mapped_metadata(file.pointer(), file.length()) {
        MetadataResult::Ok(_metadata) => {}
        MetadataResult::Err(message) => {
            if !quiet { io::eprintln("packed model: invalid metadata: ${message}"); }
            return 1;
        }
    }
    let header: *PackedHeader = file.pointer() as *PackedHeader;
    let all_matrix_policy: bool = fixed_matches(
        #addr_of((*header).policy[0]), 32 as usize, FULL_POLICY,
    );
    let qkv_fp16_q8_policy: bool = fixed_matches(
        #addr_of((*header).policy[0]), 32 as usize, QKV_FP16_Q8_POLICY,
    );
    let int4_rotated_policy: bool = fixed_matches(
        #addr_of((*header).policy[0]), 32 as usize, INT4_ROTATED_POLICY,
    );
    let qkv_policy: bool = all_matrix_policy || qkv_fp16_q8_policy || int4_rotated_policy;
    let fp16_mlp_policy: bool = fixed_matches(
        #addr_of((*header).policy[0]), 32 as usize, FP16_MLP_POLICY,
    );
    let fp16_policy: bool = qkv_policy || fp16_mlp_policy;
    let legacy_policy: bool = fixed_matches(
        #addr_of((*header).policy[0]), 32 as usize, LEGACY_FULL_POLICY,
    );
    let expected_data_offset: u64 = align_up(
        HEADER_BYTES +% RECORD_BYTES *% FULL_TENSOR_COUNT as u64,
        DATA_ALIGNMENT,
    );
    if !magic_matches(header) || (*header).version != VERSION
        || (*header).header_bytes != HEADER_BYTES as u32
        || (*header).tensor_count != FULL_TENSOR_COUNT as u32
        || (*header).scope != SCOPE_TRANSFORMER
        || (*header).directory_offset != HEADER_BYTES
        || (*header).data_offset != expected_data_offset
        || (*header).file_bytes != if int4_rotated_policy {
        INT4_ROTATED_FILE_BYTES
    } else if all_matrix_policy {
        FULL_FILE_BYTES
    } else { LEGACY_FULL_FILE_BYTES }
    || (*header).file_bytes != file.length() as u64
        || !fixed_matches(#addr_of((*header).model_snapshot[0]), 40 as usize, SNAPSHOT)
        || !fixed_matches(#addr_of((*header).diffusers_commit[0]), 40 as usize, DIFFUSERS_COMMIT)
        || !(all_matrix_policy || qkv_fp16_q8_policy || fp16_mlp_policy
            || legacy_policy || int4_rotated_policy) {
        if !quiet { io::eprintln("packed transformer: invalid header or model identity"); }
        return 1;
    }
    let payload_hash: u64 = hash_update(
        FNV_OFFSET,
        file.pointer() + (*header).data_offset as usize,
        file.length() -% (*header).data_offset as usize,
    );
    if payload_hash != (*header).payload_checksum {
        if !quiet { io::eprintln("packed transformer: payload checksum mismatch"); }
        return 1;
    }

    let records: *PackedRecord =
        (file.pointer() + (*header).directory_offset as usize) as *PackedRecord;
    var cursor: u64 = (*header).data_offset;
    var parameter_count: u64 = 0 as u64;
    var quantized_count: usize = 0 as usize;
    var int4_count: usize = 0 as usize;
    var index: usize = 0 as usize;
    while index < FULL_TENSOR_COUNT {
        let record: *PackedRecord = records + index;
        let name: text::Text = full_tensor_name(index, qkv_policy);
        let spec: FullTensorSpec = full_tensor_spec(index);
        let expected_scheme: u32 = full_expected_scheme(
            index, fp16_policy, qkv_policy, all_matrix_policy, int4_rotated_policy,
        );
        let expected_rank: u32 = if spec.input == (0 as u64) { 1 as u32 } else { 2 as u32 };
        let expected_elements: u64 = if spec.input == (0 as u64) {
            spec.output
        } else {
            spec.output *% spec.input
        };
        parameter_count = parameter_count +% expected_elements;
        if expected_scheme == SCHEME_INT8_AFFINE {
            quantized_count = quantized_count +% (1 as usize);
        }
        if expected_scheme == SCHEME_INT4_ROTATED {
            int4_count = int4_count +% (1 as usize);
        }
        if !fixed_matches(#addr_of((*record).name[0]), 128 as usize, name.view())
            || (*record).rank != expected_rank
            || (*record).dimensions[0] != spec.output
            || (expected_rank == (2 as u32) && (*record).dimensions[1] != spec.input)
            || (*record).elements != expected_elements
            || (*record).scheme != expected_scheme
            || (expected_scheme == SCHEME_INT8_AFFINE
                && (*record).weights_length != expected_elements)
            || (expected_scheme == SCHEME_INT4_ROTATED
                && (*record).weights_length != (expected_elements +% (1 as u64)) / (2 as u64))
            || (*record).weights_offset % TENSOR_ALIGNMENT != (0 as u64)
            || (*record).weights_offset < cursor
            || (*record).weights_offset > (*header).file_bytes
            || (*record).weights_length > (*header).file_bytes -% (*record).weights_offset {
            if !quiet { io::eprintln("packed transformer: invalid tensor record ${index} (${name})"); }
            return 1;
        }
        var tensor_hash: u64 = hash_update(
            FNV_OFFSET,
            file.pointer() + (*record).weights_offset as usize,
            (*record).weights_length as usize,
        );
        cursor = (*record).weights_offset +% (*record).weights_length;
        if (*record).scheme == SCHEME_INT8_AFFINE {
            let groups: u64 = spec.output *% (spec.input / (64 as u64));
            if (*record).group_axis != (1 as u32) || (*record).group_size != (64 as u32)
                || (*record).scale_type != TYPE_F16 || (*record).zero_type != TYPE_U8
                || (*record).scales_length != groups *% (2 as u64)
                || (*record).zeros_length != groups
                || (*record).scales_offset % TENSOR_ALIGNMENT != (0 as u64)
                || (*record).zeros_offset % TENSOR_ALIGNMENT != (0 as u64)
                || (*record).scales_offset < cursor
                || (*record).scales_offset > (*header).file_bytes
                || (*record).scales_length > (*header).file_bytes -% (*record).scales_offset {
                if !quiet { io::eprintln("packed transformer: invalid quantization metadata ${index}"); }
                return 1;
            }
            tensor_hash = hash_update(
                tensor_hash,
                file.pointer() + (*record).scales_offset as usize,
                (*record).scales_length as usize,
            );
            cursor = (*record).scales_offset +% (*record).scales_length;
            if (*record).zeros_offset < cursor
                || (*record).zeros_offset > (*header).file_bytes
                || (*record).zeros_length > (*header).file_bytes -% (*record).zeros_offset {
                if !quiet { io::eprintln("packed transformer: invalid zero-point range ${index}"); }
                return 1;
            }
            tensor_hash = hash_update(
                tensor_hash,
                file.pointer() + (*record).zeros_offset as usize,
                (*record).zeros_length as usize,
            );
            cursor = (*record).zeros_offset +% (*record).zeros_length;
        } else if (*record).scheme == SCHEME_INT4_ROTATED {
            if (*record).group_axis != (1 as u32) || (*record).group_size != (256 as u32)
                || (*record).scale_type != TYPE_F16 || (*record).zero_type != TYPE_NONE
                || (*record).scales_length != spec.output *% (2 as u64)
                || (*record).zeros_offset != (0 as u64)
                || (*record).zeros_length != (0 as u64)
                || (*record).scales_offset % TENSOR_ALIGNMENT != (0 as u64)
                || (*record).scales_offset < cursor
                || (*record).scales_offset > (*header).file_bytes
                || (*record).scales_length > (*header).file_bytes -% (*record).scales_offset {
                if !quiet { io::eprintln("packed transformer: invalid INT4 rotation metadata ${index}"); }
                return 1;
            }
            tensor_hash = hash_update(
                tensor_hash,
                file.pointer() + (*record).scales_offset as usize,
                (*record).scales_length as usize,
            );
            cursor = (*record).scales_offset +% (*record).scales_length;
        } else if ((*record).scheme != SCHEME_BF16 && (*record).scheme != SCHEME_FP16)
            || (*record).weights_length != expected_elements *% (2 as u64)
            || (*record).scales_offset != (0 as u64)
            || (*record).scales_length != (0 as u64)
            || (*record).zeros_offset != (0 as u64)
            || (*record).zeros_length != (0 as u64) {
            if !quiet { io::eprintln("packed transformer: unsupported scheme ${(*record).scheme}"); }
            return 1;
        }
        if tensor_hash != (*record).tensor_checksum {
            if !quiet { io::eprintln("packed transformer: tensor checksum mismatch ${index}"); }
            return 1;
        }
        index = index +% (1 as usize);
    }
    let expected_quantized_count: usize = if all_matrix_policy || int4_rotated_policy {
        0 as usize
    } else { 40 as usize };
    let expected_int4_count: usize = if int4_rotated_policy { 231 as usize } else { 0 as usize };
    if parameter_count != FULL_PARAMETER_COUNT || quantized_count != expected_quantized_count
        || int4_count != expected_int4_count
        || align_up(cursor, TENSOR_ALIGNMENT) != (*header).file_bytes {
        if !quiet { io::eprintln("packed transformer: inventory or trailing data mismatch"); }
        return 1;
    }
    if !quiet {
        io::println(
            "packed transformer: tensors=${FULL_TENSOR_COUNT} parameters=${parameter_count} q8=${quantized_count} q4_rotated=${int4_count} bytes=${(*header).file_bytes}",
        );
        io::println("packed transformer: verified");
    }
    return 0;
}

// Runtime loading validates the exact header, inventory, layouts, and byte
// ranges without scanning the multi-gigabyte payload. Hash verification is a
// separate policy decision made by load(); verify-packed always retains both
// the whole-payload and per-tensor checksum layers.
fn verify_full_runtime_structure(file: mapped::MappedFile, quiet: bool) -> i32 {
    let header: *PackedHeader = file.pointer() as *PackedHeader;
    let all_matrix_policy: bool = fixed_matches(
        #addr_of((*header).policy[0]), 32 as usize, FULL_POLICY,
    );
    let qkv_fp16_q8_policy: bool = fixed_matches(
        #addr_of((*header).policy[0]), 32 as usize, QKV_FP16_Q8_POLICY,
    );
    let int4_rotated_policy: bool = fixed_matches(
        #addr_of((*header).policy[0]), 32 as usize, INT4_ROTATED_POLICY,
    );
    let qkv_policy: bool = all_matrix_policy || qkv_fp16_q8_policy || int4_rotated_policy;
    let fp16_mlp_policy: bool = fixed_matches(
        #addr_of((*header).policy[0]), 32 as usize, FP16_MLP_POLICY,
    );
    let fp16_policy: bool = qkv_policy || fp16_mlp_policy;
    let legacy_policy: bool = fixed_matches(
        #addr_of((*header).policy[0]), 32 as usize, LEGACY_FULL_POLICY,
    );
    let expected_data_offset: u64 = align_up(
        HEADER_BYTES +% RECORD_BYTES *% FULL_TENSOR_COUNT as u64,
        DATA_ALIGNMENT,
    );
    if !magic_matches(header) || (*header).version != VERSION
        || (*header).header_bytes != HEADER_BYTES as u32
        || (*header).tensor_count != FULL_TENSOR_COUNT as u32
        || (*header).scope != SCOPE_TRANSFORMER
        || (*header).directory_offset != HEADER_BYTES
        || (*header).data_offset != expected_data_offset
        || (*header).file_bytes != if int4_rotated_policy {
        INT4_ROTATED_FILE_BYTES
    } else if all_matrix_policy {
        FULL_FILE_BYTES
    } else { LEGACY_FULL_FILE_BYTES }
    || (*header).file_bytes != file.length() as u64
        || !fixed_matches(#addr_of((*header).model_snapshot[0]), 40 as usize, SNAPSHOT)
        || !fixed_matches(#addr_of((*header).diffusers_commit[0]), 40 as usize, DIFFUSERS_COMMIT)
        || !(all_matrix_policy || qkv_fp16_q8_policy || fp16_mlp_policy
            || legacy_policy || int4_rotated_policy) {
        if !quiet { io::eprintln("packed transformer: invalid runtime header or model identity"); }
        return 1;
    }

    let records: *PackedRecord =
        (file.pointer() + (*header).directory_offset as usize) as *PackedRecord;
    var cursor: u64 = (*header).data_offset;
    var parameter_count: u64 = 0 as u64;
    var quantized_count: usize = 0 as usize;
    var int4_count: usize = 0 as usize;
    var index: usize = 0 as usize;
    while index < FULL_TENSOR_COUNT {
        let record: *PackedRecord = records + index;
        let name: text::Text = full_tensor_name(index, qkv_policy);
        let spec: FullTensorSpec = full_tensor_spec(index);
        let expected_scheme: u32 = full_expected_scheme(
            index, fp16_policy, qkv_policy, all_matrix_policy, int4_rotated_policy,
        );
        let expected_rank: u32 = if spec.input == (0 as u64) { 1 as u32 } else { 2 as u32 };
        let expected_elements: u64 = if spec.input == (0 as u64) {
            spec.output
        } else {
            spec.output *% spec.input
        };
        parameter_count = parameter_count +% expected_elements;
        if expected_scheme == SCHEME_INT8_AFFINE {
            quantized_count = quantized_count +% (1 as usize);
        }
        if expected_scheme == SCHEME_INT4_ROTATED {
            int4_count = int4_count +% (1 as usize);
        }
        if !fixed_matches(#addr_of((*record).name[0]), 128 as usize, name.view())
            || (*record).rank != expected_rank
            || (*record).dimensions[0] != spec.output
            || (expected_rank == (2 as u32) && (*record).dimensions[1] != spec.input)
            || (*record).elements != expected_elements
            || (*record).scheme != expected_scheme
            || (expected_scheme == SCHEME_INT8_AFFINE
                && (*record).weights_length != expected_elements)
            || (expected_scheme == SCHEME_INT4_ROTATED
                && (*record).weights_length != (expected_elements +% (1 as u64)) / (2 as u64))
            || (*record).weights_offset % TENSOR_ALIGNMENT != (0 as u64)
            || (*record).weights_offset < cursor
            || (*record).weights_offset > (*header).file_bytes
            || (*record).weights_length > (*header).file_bytes -% (*record).weights_offset {
            if !quiet { io::eprintln("packed transformer: invalid runtime tensor record ${index} (${name})"); }
            return 1;
        }
        cursor = (*record).weights_offset +% (*record).weights_length;
        if (*record).scheme == SCHEME_INT8_AFFINE {
            let groups: u64 = spec.output *% (spec.input / (64 as u64));
            if (*record).group_axis != (1 as u32) || (*record).group_size != (64 as u32)
                || (*record).scale_type != TYPE_F16 || (*record).zero_type != TYPE_U8
                || (*record).scales_length != groups *% (2 as u64)
                || (*record).zeros_length != groups
                || (*record).scales_offset % TENSOR_ALIGNMENT != (0 as u64)
                || (*record).zeros_offset % TENSOR_ALIGNMENT != (0 as u64)
                || (*record).scales_offset < cursor
                || (*record).scales_offset > (*header).file_bytes
                || (*record).scales_length > (*header).file_bytes -% (*record).scales_offset {
                if !quiet { io::eprintln("packed transformer: invalid runtime quantization metadata ${index}"); }
                return 1;
            }
            cursor = (*record).scales_offset +% (*record).scales_length;
            if (*record).zeros_offset < cursor
                || (*record).zeros_offset > (*header).file_bytes
                || (*record).zeros_length > (*header).file_bytes -% (*record).zeros_offset {
                if !quiet { io::eprintln("packed transformer: invalid runtime zero-point range ${index}"); }
                return 1;
            }
            cursor = (*record).zeros_offset +% (*record).zeros_length;
        } else if (*record).scheme == SCHEME_INT4_ROTATED {
            if (*record).group_axis != (1 as u32) || (*record).group_size != (256 as u32)
                || (*record).scale_type != TYPE_F16 || (*record).zero_type != TYPE_NONE
                || (*record).scales_length != spec.output *% (2 as u64)
                || (*record).zeros_offset != (0 as u64)
                || (*record).zeros_length != (0 as u64)
                || (*record).scales_offset % TENSOR_ALIGNMENT != (0 as u64)
                || (*record).scales_offset < cursor
                || (*record).scales_offset > (*header).file_bytes
                || (*record).scales_length > (*header).file_bytes -% (*record).scales_offset {
                if !quiet { io::eprintln("packed transformer: invalid runtime INT4 metadata ${index}"); }
                return 1;
            }
            cursor = (*record).scales_offset +% (*record).scales_length;
        } else if ((*record).scheme != SCHEME_BF16 && (*record).scheme != SCHEME_FP16)
            || (*record).weights_length != expected_elements *% (2 as u64)
            || (*record).scales_offset != (0 as u64)
            || (*record).scales_length != (0 as u64)
            || (*record).zeros_offset != (0 as u64)
            || (*record).zeros_length != (0 as u64) {
            if !quiet { io::eprintln("packed transformer: unsupported runtime scheme ${(*record).scheme}"); }
            return 1;
        }
        index = index +% (1 as usize);
    }
    let expected_quantized_count: usize = if all_matrix_policy {
        0 as usize
    } else { 40 as usize };
    let expected_int4_count: usize = if int4_rotated_policy { 231 as usize } else { 0 as usize };
    let adjusted_quantized_count: usize = if int4_rotated_policy {
        0 as usize
    } else { expected_quantized_count };
    if parameter_count != FULL_PARAMETER_COUNT || quantized_count != adjusted_quantized_count
        || int4_count != expected_int4_count
        || align_up(cursor, TENSOR_ALIGNMENT) != (*header).file_bytes {
        if !quiet { io::eprintln("packed transformer: runtime inventory or trailing data mismatch"); }
        return 1;
    }
    return 0;
}

fn verify_runtime_hash_range(take job: RuntimeHashJob) -> i32 {
    var index: usize = job.start;
    while index < job.end {
        let record: *PackedRecord = job.records + index;
        var tensor_hash: u64 = hash_update(
            FNV_OFFSET,
            job.file_pointer + (*record).weights_offset as usize,
            (*record).weights_length as usize,
        );
        if (*record).scheme == SCHEME_INT8_AFFINE {
            tensor_hash = hash_update(
                tensor_hash,
                job.file_pointer + (*record).scales_offset as usize,
                (*record).scales_length as usize,
            );
            tensor_hash = hash_update(
                tensor_hash,
                job.file_pointer + (*record).zeros_offset as usize,
                (*record).zeros_length as usize,
            );
        } else if (*record).scheme == SCHEME_INT4_ROTATED {
            tensor_hash = hash_update(
                tensor_hash,
                job.file_pointer + (*record).scales_offset as usize,
                (*record).scales_length as usize,
            );
        }
        if tensor_hash != (*record).tensor_checksum {
            return 1;
        }
        index = index +% (1 as usize);
    }
    return 0;
}

fn verify_full_runtime_hashes(file: mapped::MappedFile) -> i32 {
    let header: *PackedHeader = file.pointer() as *PackedHeader;
    let records: *PackedRecord =
        (file.pointer() + (*header).directory_offset as usize) as *PackedRecord;
    // Boundaries follow the pinned inventory's stored byte sizes rather than
    // record counts. Each worker hashes 1.64-1.74 GB.
    let h0: thread::JoinHandle[i32] = thread::spawn_with::[RuntimeHashJob, i32](
        RuntimeHashJob { file_pointer: file.pointer(), records: records, start: 0, end: 41 },
        verify_runtime_hash_range,
    );
    let h1: thread::JoinHandle[i32] = thread::spawn_with::[RuntimeHashJob, i32](
        RuntimeHashJob { file_pointer: file.pointer(), records: records, start: 41, end: 74 },
        verify_runtime_hash_range,
    );
    let h2: thread::JoinHandle[i32] = thread::spawn_with::[RuntimeHashJob, i32](
        RuntimeHashJob { file_pointer: file.pointer(), records: records, start: 74, end: 107 },
        verify_runtime_hash_range,
    );
    let h3: thread::JoinHandle[i32] = thread::spawn_with::[RuntimeHashJob, i32](
        RuntimeHashJob { file_pointer: file.pointer(), records: records, start: 107, end: 143 },
        verify_runtime_hash_range,
    );
    let h4: thread::JoinHandle[i32] = thread::spawn_with::[RuntimeHashJob, i32](
        RuntimeHashJob { file_pointer: file.pointer(), records: records, start: 143, end: 178 },
        verify_runtime_hash_range,
    );
    let h5: thread::JoinHandle[i32] = thread::spawn_with::[RuntimeHashJob, i32](
        RuntimeHashJob { file_pointer: file.pointer(), records: records, start: 178, end: 213 },
        verify_runtime_hash_range,
    );
    let h6: thread::JoinHandle[i32] = thread::spawn_with::[RuntimeHashJob, i32](
        RuntimeHashJob { file_pointer: file.pointer(), records: records, start: 213, end: 250 },
        verify_runtime_hash_range,
    );
    let h7: thread::JoinHandle[i32] = thread::spawn_with::[RuntimeHashJob, i32](
        RuntimeHashJob { file_pointer: file.pointer(), records: records, start: 250, end: 297 },
        verify_runtime_hash_range,
    );
    let failures: i32 = h0.join() +% h1.join() +% h2.join() +% h3.join()
        +% h4.join() +% h5.join() +% h6.join() +% h7.join();
    return if failures == (0 as i32) { 0 } else { 1 };
}

fn verify_packed(path: str, quiet: bool = false) -> i32 {
    guard let mapped::MapResult::Ok(file) = mapped::map_readonly(path) else {
        if !quiet { io::eprintln("packed model: could not map ${path}"); }
        return 1;
    };
    if file.length() < DATA_ALIGNMENT as usize {
        if !quiet { io::eprintln("packed model: file is too small"); }
        return 1;
    }
    let header: *PackedHeader = file.pointer() as *PackedHeader;
    if magic_matches(header) && (*header).scope == SCOPE_TRANSFORMER {
        return verify_full_packed(file, quiet);
    }
    if !magic_matches(header) || (*header).version != VERSION
        || (*header).header_bytes != HEADER_BYTES as u32
        || (*header).tensor_count != BLOCK0_TENSOR_COUNT as u32
        || (*header).scope != SCOPE_BLOCK0
        || (*header).directory_offset != HEADER_BYTES
        || (*header).data_offset != DATA_ALIGNMENT
        || (*header).file_bytes != file.length() as u64
        || !fixed_matches(#addr_of((*header).model_snapshot[0]), 40 as usize, SNAPSHOT)
        || !fixed_matches(#addr_of((*header).diffusers_commit[0]), 40 as usize, DIFFUSERS_COMMIT)
        || !fixed_matches(#addr_of((*header).policy[0]), 32 as usize, "block0:int8-affine-g64") {
        if !quiet { io::eprintln("packed model: invalid header or model identity"); }
        return 1;
    }
    match mapped_metadata(file.pointer(), file.length()) {
        MetadataResult::Ok(_metadata) => {}
        MetadataResult::Err(message) => {
            if !quiet { io::eprintln("packed model: invalid metadata: ${message}"); }
            return 1;
        }
    }
    let payload_length: usize = file.length() -% (*header).data_offset as usize;
    let payload_hash: u64 = hash_update(
        FNV_OFFSET,
        file.pointer() + (*header).data_offset as usize,
        payload_length,
    );
    if payload_hash != (*header).payload_checksum {
        if !quiet { io::eprintln("packed model: payload checksum mismatch"); }
        return 1;
    }

    let records: *PackedRecord =
        (file.pointer() + (*header).directory_offset as usize) as *PackedRecord;
    let specs: [TensorSpec; 9] = make_specs();
    var cursor: u64 = (*header).data_offset;
    var index: usize = 0 as usize;
    while index < BLOCK0_TENSOR_COUNT {
        let record: *PackedRecord = records + index;
        let spec: TensorSpec = specs[index];
        let expected_rank: u32 = if spec.input == (0 as u64) { 1 as u32 } else { 2 as u32 };
        let expected_elements: u64 = if spec.input == (0 as u64) {
            spec.output
        } else {
            spec.output *% spec.input
        };
        if !fixed_matches(#addr_of((*record).name[0]), 128 as usize, spec.name)
            || (*record).rank != expected_rank
            || (*record).dimensions[0] != spec.output
            || (expected_rank == (2 as u32) && (*record).dimensions[1] != spec.input)
            || (*record).elements != expected_elements
            || (spec.quantized && (*record).scheme != SCHEME_INT8_AFFINE)
            || (!spec.quantized && (*record).scheme != SCHEME_BF16)
            || (spec.quantized && (*record).weights_length != expected_elements)
            || (*record).weights_offset % TENSOR_ALIGNMENT != (0 as u64)
            || (*record).weights_offset < cursor
            || (*record).weights_offset > (*header).file_bytes
            || (*record).weights_length > (*header).file_bytes -% (*record).weights_offset {
            if !quiet { io::eprintln("packed model: invalid tensor record ${index}"); }
            return 1;
        }
        var tensor_hash: u64 = hash_update(
            FNV_OFFSET,
            file.pointer() + (*record).weights_offset as usize,
            (*record).weights_length as usize,
        );
        cursor = (*record).weights_offset +% (*record).weights_length;
        if (*record).scheme == SCHEME_INT8_AFFINE {
            if (*record).group_axis != (1 as u32) || (*record).group_size != (64 as u32)
                || (*record).scale_type != TYPE_F16 || (*record).zero_type != TYPE_U8
                || (*record).scales_length
                    != spec.output *% (spec.input / (64 as u64)) *% (2 as u64)
                || (*record).zeros_length != spec.output *% (spec.input / (64 as u64))
                || (*record).scales_offset % TENSOR_ALIGNMENT != (0 as u64)
                || (*record).zeros_offset % TENSOR_ALIGNMENT != (0 as u64)
                || (*record).scales_offset < cursor
                || (*record).scales_offset > (*header).file_bytes
                || (*record).scales_length > (*header).file_bytes -% (*record).scales_offset {
                if !quiet { io::eprintln("packed model: invalid quantization metadata ${index}"); }
                return 1;
            }
            tensor_hash = hash_update(
                tensor_hash,
                file.pointer() + (*record).scales_offset as usize,
                (*record).scales_length as usize,
            );
            cursor = (*record).scales_offset +% (*record).scales_length;
            if (*record).zeros_offset < cursor
                || (*record).zeros_offset > (*header).file_bytes
                || (*record).zeros_length > (*header).file_bytes -% (*record).zeros_offset {
                if !quiet { io::eprintln("packed model: invalid zero-point range ${index}"); }
                return 1;
            }
            tensor_hash = hash_update(
                tensor_hash,
                file.pointer() + (*record).zeros_offset as usize,
                (*record).zeros_length as usize,
            );
            cursor = (*record).zeros_offset +% (*record).zeros_length;
        } else if (*record).scheme != SCHEME_BF16
            || (*record).weights_length != expected_elements *% (2 as u64)
            || (*record).scales_offset != (0 as u64)
            || (*record).scales_length != (0 as u64)
            || (*record).zeros_offset != (0 as u64)
            || (*record).zeros_length != (0 as u64) {
            if !quiet { io::eprintln("packed model: unsupported scheme ${(*record).scheme}"); }
            return 1;
        }
        if tensor_hash != (*record).tensor_checksum {
            if !quiet { io::eprintln("packed model: tensor checksum mismatch ${index}"); }
            return 1;
        }
        index = index +% (1 as usize);
    }
    if align_up(cursor, TENSOR_ALIGNMENT) != (*header).file_bytes {
        if !quiet { io::eprintln("packed model: trailing data does not match directory"); }
        return 1;
    }
    if !quiet {
        let bytes: u64 = (*header).file_bytes;
        io::println("packed block0: tensors=${BLOCK0_TENSOR_COUNT} bytes=${bytes} checksum=${(*header).payload_checksum}");
        io::println("packed block0: verified");
    }
    return 0;
}

// Inference always validates the header, model identity, tensor inventory,
// ordering, dimensions, quantization schemes, and byte ranges. Per-tensor
// checksums additionally rescan the complete 13.3 GB payload, which dominated
// measured startup, so they are opt-in: pass `verify_hashes`, or set
// QI_VERIFY_PACKED_CHECKSUMS in the environment. The explicit `verify-packed`
// command is unchanged and still runs both checksum layers.
fn load(path: str, verify_hashes: bool = false) -> LoadResult {
    guard let mapped::MapResult::Ok(mapping) = mapped::map_readonly(path) else {
        return LoadResult::Err;
    };
    if mapping.length() < DATA_ALIGNMENT as usize {
        return LoadResult::Err;
    }
    let header: *PackedHeader = mapping.pointer() as *PackedHeader;
    if magic_matches(header) && (*header).scope == SCOPE_TRANSFORMER {
        if verify_full_runtime_structure(mapping, true) != (0 as i32) {
            return LoadResult::Err;
        }
        match mapped_metadata(mapping.pointer(), mapping.length()) {
            MetadataResult::Ok(_metadata) => {}
            MetadataResult::Err(message) => {
                io::eprintln("packed model: invalid metadata in ${path}: ${message}");
                return LoadResult::Err;
            }
        }
        let checksum_requested: bool =
            verify_hashes || env::has_var("QI_VERIFY_PACKED_CHECKSUMS");
        if checksum_requested && verify_full_runtime_hashes(mapping) != (0 as i32) {
            return LoadResult::Err;
        }
        // Deliberately no MADV_WILLNEED here. The checksum pass used to warm
        // the page cache as a side effect, and without it that I/O reappears
        // when Metal first touches the no-copy buffer. A measured A/B showed
        // explicit readahead is the slower of the two: 5,163 ms in load plus
        // 1,923 ms at first touch, versus 5,968 ms at first touch alone.
        // Metal's own first-touch paging wins on this mapping.
        return LoadResult::Ok(File { _mapping: mapping });
    }
    // The compact block fixture is not on the product startup path. Keep its
    // exhaustive verifier, including the whole-payload checksum.
    if verify_packed(path, true) != (0 as i32) {
        return LoadResult::Err;
    }
    return LoadResult::Ok(File { _mapping: mapping });
}

fn verify_against_source(
    packed_path: str,
    source: safetensors::File,
    quiet: bool = false,
) -> i32 {
    guard let mapped::MapResult::Ok(packed) = mapped::map_readonly(packed_path) else {
        if !quiet { io::eprintln("packed model: could not map ${packed_path}"); }
        return 1;
    };
    if packed.length() < DATA_ALIGNMENT as usize {
        return 1;
    }
    let header: *PackedHeader = packed.pointer() as *PackedHeader;
    if !magic_matches(header) || (*header).tensor_count != BLOCK0_TENSOR_COUNT as u32 {
        return 1;
    }
    let records: *PackedRecord =
        (packed.pointer() + (*header).directory_offset as usize) as *PackedRecord;
    let specs: [TensorSpec; 9] = make_specs();
    var index: usize = 0 as usize;
    while index < BLOCK0_TENSOR_COUNT {
        let record: *PackedRecord = records + index;
        let spec: TensorSpec = specs[index];
        if !fixed_matches(#addr_of((*record).name[0]), 128 as usize, spec.name) {
            if !quiet { io::eprintln("packed model: tensor order/name mismatch ${index}"); }
            return 1;
        }
        guard let option::Option[safetensors::TensorData]::Some(tensor) = source.tensor(spec.name) else {
            return 1;
        };
        if !spec.quantized {
            var byte_index: usize = 0 as usize;
            while byte_index < tensor.byte_length as usize {
                if tensor.pointer[byte_index]
                    != (packed.pointer() + (*record).weights_offset as usize)[byte_index] {
                    if !quiet { io::eprintln("packed model: raw round-trip mismatch ${spec.name}"); }
                    return 1;
                }
                byte_index = byte_index +% (1 as usize);
            }
        } else {
            let source_values: *u16 = tensor.pointer as *u16;
            let packed_weights: *u8 = packed.pointer() + (*record).weights_offset as usize;
            let packed_scales: *u16 =
                (packed.pointer() + (*record).scales_offset as usize) as *u16;
            let packed_zeros: *u8 = packed.pointer() + (*record).zeros_offset as usize;
            let output_count: usize = spec.output as usize;
            let input_count: usize = spec.input as usize;
            let group_size: usize = 64 as usize;
            let groups_per_row: usize = input_count / group_size;
            var row: usize = 0 as usize;
            while row < output_count {
                var group: usize = 0 as usize;
                while group < groups_per_row {
                    let start: usize = row *% input_count +% group *% group_size;
                    var minimum: f32 = cpu::bf16_to_f32(source_values[start]);
                    var maximum: f32 = minimum;
                    var inner: usize = 1 as usize;
                    while inner < group_size {
                        let value: f32 = cpu::bf16_to_f32(source_values[start +% inner]);
                        minimum = minimum.min(value);
                        maximum = maximum.max(value);
                        inner = inner +% (1 as usize);
                    }
                    var scale: f32 = (maximum - minimum) / 255.0f32;
                    if scale == 0.0f32 { scale = 1.0f32; }
                    let scale_bits: u16 = cpu::f32_to_fp16(scale);
                    let stored_scale: f32 = cpu::fp16_to_f32(scale_bits);
                    var zero_value: f32 = (0.0f32 - minimum) / stored_scale;
                    zero_value = zero_value.round().max(0.0f32).min(255.0f32);
                    let zero: u8 = zero_value as u8;
                    let group_index: usize = row *% groups_per_row +% group;
                    if packed_scales[group_index] != scale_bits || packed_zeros[group_index] != zero {
                        if !quiet { io::eprintln("packed model: group metadata round-trip mismatch ${spec.name}"); }
                        return 1;
                    }
                    inner = 0 as usize;
                    while inner < group_size {
                        let value: f32 = cpu::bf16_to_f32(source_values[start +% inner]);
                        var expected: f32 = (value / stored_scale).round() + zero as f32;
                        expected = expected.max(0.0f32).min(255.0f32);
                        if packed_weights[start +% inner] != expected as u8 {
                            if !quiet { io::eprintln("packed model: quantized round-trip mismatch ${spec.name}"); }
                            return 1;
                        }
                        inner = inner +% (1 as usize);
                    }
                    group = group +% (1 as usize);
                }
                row = row +% (1 as usize);
            }
        }
        index = index +% (1 as usize);
    }
    if !quiet { io::println("packed block0: source round-trip verified"); }
    return 0;
}

fn tensor_from_sources(
    first: safetensors::File,
    second: safetensors::File,
    name: str,
) -> option::Option[safetensors::TensorData] {
    return match first.tensor(name) {
        option::Option[safetensors::TensorData]::Some(tensor) => {
            option::Option[safetensors::TensorData]::Some(tensor)
        }
        option::Option[safetensors::TensorData]::None => second.tensor(name),
    };
}

fn verify_full_against_source(
    packed_path: str,
    first: safetensors::File,
    second: safetensors::File,
    quiet: bool = false,
) -> i32 {
    if first.tensor_count() +% second.tensor_count() != FULL_TENSOR_COUNT
        || first.parameter_count() +% second.parameter_count() != FULL_PARAMETER_COUNT {
        if !quiet { io::eprintln("packed transformer: source inventory mismatch"); }
        return 1;
    }
    guard let mapped::MapResult::Ok(packed) = mapped::map_readonly(packed_path) else {
        if !quiet { io::eprintln("packed transformer: could not map ${packed_path}"); }
        return 1;
    };
    let header: *PackedHeader = packed.pointer() as *PackedHeader;
    let int4_rotated_policy: bool = fixed_matches(
        #addr_of((*header).policy[0]), 32 as usize, INT4_ROTATED_POLICY,
    );
    let qkv_policy: bool = fixed_matches(
        #addr_of((*header).policy[0]), 32 as usize, FULL_POLICY,
    ) || fixed_matches(
        #addr_of((*header).policy[0]), 32 as usize, QKV_FP16_Q8_POLICY,
    ) || int4_rotated_policy;
    if !magic_matches(header) || (*header).scope != SCOPE_TRANSFORMER
        || (*header).tensor_count != FULL_TENSOR_COUNT as u32 {
        return 1;
    }
    let records: *PackedRecord =
        (packed.pointer() + (*header).directory_offset as usize) as *PackedRecord;
    var index: usize = 0 as usize;
    while index < FULL_TENSOR_COUNT {
        let record: *PackedRecord = records + index;
        let name: text::Text = full_tensor_name(index, qkv_policy);
        let spec: FullTensorSpec = full_tensor_spec(index);
        if !fixed_matches(#addr_of((*record).name[0]), 128 as usize, name.view()) {
            if !quiet { io::eprintln("packed transformer: tensor order/name mismatch ${index}"); }
            return 1;
        }
        guard let option::Option[safetensors::TensorData]::Some(tensor) = tensor_from_sources(
            first,
            second,
            name.view(),
        ) else {
            if !quiet { io::eprintln("packed transformer: source is missing ${name}"); }
            return 1;
        };
        let expected_rank: usize = if spec.input == (0 as u64) { 1 as usize } else { 2 as usize };
        if tensor.dtype.name() != "BF16" || tensor.rank != expected_rank
            || tensor.dimensions[0] != spec.output
            || (expected_rank == (2 as usize) && tensor.dimensions[1] != spec.input) {
            if !quiet { io::eprintln("packed transformer: wrong source metadata for ${name}"); }
            return 1;
        }
        if (*record).scheme == SCHEME_BF16 {
            var byte_index: usize = 0 as usize;
            let packed_weights: *u8 = packed.pointer() + (*record).weights_offset as usize;
            while byte_index < tensor.byte_length as usize {
                if tensor.pointer[byte_index] != packed_weights[byte_index] {
                    if !quiet { io::eprintln("packed transformer: raw round-trip mismatch ${name}"); }
                    return 1;
                }
                byte_index = byte_index +% (1 as usize);
            }
        } else if (*record).scheme == SCHEME_FP16 {
            let source_values: *u16 = tensor.pointer as *u16;
            let packed_weights: *u16 =
                (packed.pointer() + (*record).weights_offset as usize) as *u16;
            let elements: usize = tensor.byte_length as usize / (2 as usize);
            var element: usize = 0 as usize;
            while element < elements {
                let expected: u16 = cpu::f32_to_fp16(cpu::bf16_to_f32(source_values[element]));
                if packed_weights[element] != expected {
                    if !quiet {
                        io::eprintln("packed transformer: FP16 round-trip mismatch ${name}");
                    }
                    return 1;
                }
                element = element +% (1 as usize);
            }
        } else if (*record).scheme == SCHEME_INT4_ROTATED {
            guard let option::Option[[OwnedBytes; 2]]::Some(buffers) =
                quantize_tensor_int4_rotated(tensor, { *record }) else { return 1; };
            let packed_weights: *u8 = packed.pointer() + (*record).weights_offset as usize;
            let packed_scales: *u8 = packed.pointer() + (*record).scales_offset as usize;
            var byte_index: usize = 0 as usize;
            while byte_index < buffers[0].length {
                if packed_weights[byte_index] != buffers[0].pointer[byte_index] {
                    if !quiet { io::eprintln("packed transformer: INT4 rotated round-trip mismatch ${name}"); }
                    return 1;
                }
                byte_index = byte_index +% (1 as usize);
            }
            byte_index = 0 as usize;
            while byte_index < buffers[1].length {
                if packed_scales[byte_index] != buffers[1].pointer[byte_index] {
                    if !quiet { io::eprintln("packed transformer: INT4 scale round-trip mismatch ${name}"); }
                    return 1;
                }
                byte_index = byte_index +% (1 as usize);
            }
        } else {
            let source_values: *u16 = tensor.pointer as *u16;
            let packed_weights: *u8 = packed.pointer() + (*record).weights_offset as usize;
            let packed_scales: *u16 =
                (packed.pointer() + (*record).scales_offset as usize) as *u16;
            let packed_zeros: *u8 = packed.pointer() + (*record).zeros_offset as usize;
            let output_count: usize = spec.output as usize;
            let input_count: usize = spec.input as usize;
            let group_size: usize = 64 as usize;
            let groups_per_row: usize = input_count / group_size;
            var row: usize = 0 as usize;
            while row < output_count {
                var group: usize = 0 as usize;
                while group < groups_per_row {
                    let start: usize = row *% input_count +% group *% group_size;
                    var minimum: f32 = cpu::bf16_to_f32(source_values[start]);
                    var maximum: f32 = minimum;
                    var inner: usize = 1 as usize;
                    while inner < group_size {
                        let value: f32 = cpu::bf16_to_f32(source_values[start +% inner]);
                        minimum = minimum.min(value);
                        maximum = maximum.max(value);
                        inner = inner +% (1 as usize);
                    }
                    var scale: f32 = (maximum - minimum) / 255.0f32;
                    if scale == 0.0f32 { scale = 1.0f32; }
                    let scale_bits: u16 = cpu::f32_to_fp16(scale);
                    let stored_scale: f32 = cpu::fp16_to_f32(scale_bits);
                    var zero_value: f32 = (0.0f32 - minimum) / stored_scale;
                    zero_value = zero_value.round().max(0.0f32).min(255.0f32);
                    let zero: u8 = zero_value as u8;
                    let group_index: usize = row *% groups_per_row +% group;
                    if packed_scales[group_index] != scale_bits || packed_zeros[group_index] != zero {
                        if !quiet {
                            io::eprintln("packed transformer: group metadata round-trip mismatch ${name}");
                        }
                        return 1;
                    }
                    inner = 0 as usize;
                    while inner < group_size {
                        let value: f32 = cpu::bf16_to_f32(source_values[start +% inner]);
                        var expected: f32 = (value / stored_scale).round() + zero as f32;
                        expected = expected.max(0.0f32).min(255.0f32);
                        if packed_weights[start +% inner] != expected as u8 {
                            if !quiet {
                                io::eprintln("packed transformer: quantized round-trip mismatch ${name}");
                            }
                            return 1;
                        }
                        inner = inner +% (1 as usize);
                    }
                    group = group +% (1 as usize);
                }
                row = row +% (1 as usize);
            }
        }
        index = index +% (1 as usize);
    }
    if !quiet { io::println("packed transformer: source round-trip verified"); }
    return 0;
}

fn verify_packed_source(path: str, model_directory: str) -> i32 {
    if verify_packed(path) != (0 as i32) {
        return 1;
    }
    guard let mapped::MapResult::Ok(packed) = mapped::map_readonly(path) else { return 1; };
    let header: *PackedHeader = packed.pointer() as *PackedHeader;
    let first_path: text::Text =
        "${model_directory}/transformer/diffusion_pytorch_model-00001-of-00002.safetensors";
    guard let safetensors::LoadResult::Ok(first) = safetensors::load(first_path.view()) else {
        return 1;
    };
    if (*header).scope == SCOPE_BLOCK0 {
        return verify_against_source(path, first);
    }
    let second_path: text::Text =
        "${model_directory}/transformer/diffusion_pytorch_model-00002-of-00002.safetensors";
    guard let safetensors::LoadResult::Ok(second) = safetensors::load(second_path.view()) else {
        return 1;
    };
    return verify_full_against_source(path, first, second);
}

fn quantize_block0(model_directory: str, output_path: str) -> i32 {
    if #size_of::[PackedHeader]() != HEADER_BYTES as usize
        || #size_of::[PackedRecord]() != RECORD_BYTES as usize {
        io::eprintln("packed model: ABI layout does not match the format");
        return 1;
    }
    let shard_path: text::Text =
        "${model_directory}/transformer/diffusion_pytorch_model-00001-of-00002.safetensors";
    guard let safetensors::LoadResult::Ok(file) = safetensors::load(shard_path.view()) else {
        io::eprintln("packed model: could not load ${shard_path}");
        return 1;
    };
    let specs: [TensorSpec; 9] = make_specs();
    var records: vec::Vec[PackedRecord] = vec::Vec[PackedRecord]::with_capacity(BLOCK0_TENSOR_COUNT);
    var cursor: u64 = DATA_ALIGNMENT;
    var index: usize = 0 as usize;
    while index < BLOCK0_TENSOR_COUNT {
        let record: PackedRecord = make_record(specs[index], cursor);
        if records.append(record) != status::Status::Ok {
            return 1;
        }
        index = index +% (1 as usize);
    }
    let file_bytes: u64 = align_up(cursor, TENSOR_ALIGNMENT);
    var header: PackedHeader = PackedHeader {
        magic: [81 as u8, 73 as u8, 80 as u8, 65 as u8, 67 as u8, 75 as u8, 49 as u8, 0 as u8],
        version: VERSION,
        header_bytes: HEADER_BYTES as u32,
        tensor_count: BLOCK0_TENSOR_COUNT as u32,
        scope: SCOPE_BLOCK0,
        directory_offset: HEADER_BYTES,
        data_offset: DATA_ALIGNMENT,
        file_bytes: file_bytes,
        payload_checksum: 0 as u64,
        model_snapshot: [0 as u8; 40],
        diffusers_commit: [0 as u8; 40],
        policy: [0 as u8; 32],
        metadata_offset: 0 as u64,
        metadata_bytes: 0 as u32,
        metadata_version: 0 as u32,
        metadata_checksum: 0 as u64,
        reserved: [0 as u8; 64],
    };
    let _snapshot_ok: bool = fixed_text(#addr_of(header.model_snapshot[0]), 40 as usize, SNAPSHOT);
    let _commit_ok: bool = fixed_text(#addr_of(header.diffusers_commit[0]), 40 as usize, DIFFUSERS_COMMIT);
    let _policy_ok: bool = fixed_text(#addr_of(header.policy[0]), 32 as usize, "block0:int8-affine-g64");

    let temporary_path: text::Text = "${output_path}.tmp";
    guard let option::Option[text::CString]::Some(c_temporary) = temporary_path.c_str() else { return 1; };
    // POSIX 0644, written as decimal because the current C+ integer grammar
    // does not treat an `0o` prefix as a portable octal literal.
    let fd: i32 = qi_pack_open(c_temporary.as_ptr(), O_WRONLY | O_CREAT | O_TRUNC, 420 as i32);
    if fd < (0 as i32) {
        io::eprintln("packed model: could not create ${temporary_path}");
        return 1;
    }
    if qi_pack_fchmod(fd, 420 as u16) != (0 as i32) {
        let _closed: i32 = qi_pack_close(fd);
        let _removed: i32 = qi_pack_unlink(c_temporary.as_ptr());
        io::eprintln("packed model: could not set safe output permissions");
        return 1;
    }
    var ok: bool = write_all(fd, #addr_of(header) as *u8, HEADER_BYTES as usize);
    index = 0 as usize;
    while ok && index < BLOCK0_TENSOR_COUNT {
        guard let option::Option[*PackedRecord]::Some(record) = records.at_ptr(index) else {
            ok = false;
            break;
        };
        ok = write_all(fd, record as *u8, RECORD_BYTES as usize);
        index = index +% (1 as usize);
    }
    var payload_checksum: u64 = FNV_OFFSET;
    let directory_end: u64 = HEADER_BYTES +% RECORD_BYTES *% BLOCK0_TENSOR_COUNT as u64;
    if ok {
        ok = write_zeroes(fd, DATA_ALIGNMENT -% directory_end, payload_checksum, false);
    }
    var position: u64 = DATA_ALIGNMENT;
    index = 0 as usize;
    while ok && index < BLOCK0_TENSOR_COUNT {
        guard let option::Option[*PackedRecord]::Some(record) = records.at_ptr(index) else {
            ok = false;
            break;
        };
        let spec: TensorSpec = specs[index];
        guard let option::Option[safetensors::TensorData]::Some(tensor) = file.tensor(spec.name) else {
            io::eprintln("packed model: missing ${spec.name}");
            ok = false;
            break;
        };
        let expected_rank: usize = if spec.input == (0 as u64) { 1 as usize } else { 2 as usize };
        if tensor.dtype.name() != "BF16" || tensor.rank != expected_rank
            || tensor.dimensions[0] != spec.output
            || (expected_rank == (2 as usize) && tensor.dimensions[1] != spec.input) {
            io::eprintln("packed model: wrong metadata for ${spec.name}");
            ok = false;
            break;
        }
        if position < { (*record).weights_offset } {
            ok = write_zeroes(fd, { (*record).weights_offset } -% position, payload_checksum, true);
            position = { (*record).weights_offset };
        }
        var tensor_hash: u64 = FNV_OFFSET;
        if !spec.quantized {
            ok = write_payload(fd, tensor.pointer, tensor.byte_length as usize, payload_checksum);
            tensor_hash = hash_update(tensor_hash, tensor.pointer, tensor.byte_length as usize);
            position = position +% tensor.byte_length;
        } else {
            guard let option::Option[[OwnedBytes; 3]]::Some(buffers) = quantize_tensor(tensor, { *record }) else {
                ok = false;
                break;
            };
            ok = write_payload(fd, buffers[0].pointer, buffers[0].length, payload_checksum);
            tensor_hash = hash_update(tensor_hash, buffers[0].pointer, buffers[0].length);
            position = position +% buffers[0].length as u64;
            if ok && position < { (*record).scales_offset } {
                ok = write_zeroes(fd, { (*record).scales_offset } -% position, payload_checksum, true);
                position = { (*record).scales_offset };
            }
            if ok { ok = write_payload(fd, buffers[1].pointer, buffers[1].length, payload_checksum); }
            tensor_hash = hash_update(tensor_hash, buffers[1].pointer, buffers[1].length);
            position = position +% buffers[1].length as u64;
            if ok && position < { (*record).zeros_offset } {
                ok = write_zeroes(fd, { (*record).zeros_offset } -% position, payload_checksum, true);
                position = { (*record).zeros_offset };
            }
            if ok { ok = write_payload(fd, buffers[2].pointer, buffers[2].length, payload_checksum); }
            tensor_hash = hash_update(tensor_hash, buffers[2].pointer, buffers[2].length);
            position = position +% buffers[2].length as u64;
        }
        (*record).tensor_checksum = tensor_hash;
        io::println("packed ${spec.name}: ${(*record).weights_length} weight bytes");
        index = index +% (1 as usize);
    }
    if ok && position < file_bytes {
        ok = write_zeroes(fd, file_bytes -% position, payload_checksum, true);
    }
    header.payload_checksum = payload_checksum;
    if ok && qi_pack_lseek(fd, 0 as i64, SEEK_SET) != (0 as i64) { ok = false; }
    if ok { ok = write_all(fd, #addr_of(header) as *u8, HEADER_BYTES as usize); }
    index = 0 as usize;
    while ok && index < BLOCK0_TENSOR_COUNT {
        guard let option::Option[*PackedRecord]::Some(record) = records.at_ptr(index) else { ok = false; break; };
        ok = write_all(fd, record as *u8, RECORD_BYTES as usize);
        index = index +% (1 as usize);
    }
    if ok && qi_pack_fsync(fd) != (0 as i32) { ok = false; }
    let _closed: i32 = qi_pack_close(fd);
    if !ok || verify_packed(temporary_path.view(), true) != (0 as i32)
        || verify_against_source(temporary_path.view(), file, true) != (0 as i32) {
        let _removed: i32 = qi_pack_unlink(c_temporary.as_ptr());
        io::eprintln("packed model: temporary output failed validation");
        return 1;
    }
    let output_owner: text::Text = text::from_str(output_path);
    guard let option::Option[text::CString]::Some(c_output) = output_owner.c_str() else {
        let _removed: i32 = qi_pack_unlink(c_temporary.as_ptr());
        return 1;
    };
    if qi_pack_rename(c_temporary.as_ptr(), c_output.as_ptr()) != (0 as i32) {
        let _removed: i32 = qi_pack_unlink(c_temporary.as_ptr());
        io::eprintln("packed model: could not install ${output_path}");
        return 1;
    }
    io::println("packed block0 written atomically: ${output_path}");
    if verify_packed(output_path) != (0 as i32) {
        return 1;
    }
    io::println("packed block0: source round-trip verified");
    return 0;
}

fn quantize_transformer_impl(
    model_directory: str,
    output_path: str,
    int4_rotated_policy: bool,
) -> i32 {
    if #size_of::[PackedHeader]() != HEADER_BYTES as usize
        || #size_of::[PackedRecord]() != RECORD_BYTES as usize {
        io::eprintln("packed transformer: ABI layout does not match the format");
        return 1;
    }
    let first_path: text::Text =
        "${model_directory}/transformer/diffusion_pytorch_model-00001-of-00002.safetensors";
    let second_path: text::Text =
        "${model_directory}/transformer/diffusion_pytorch_model-00002-of-00002.safetensors";
    guard let safetensors::LoadResult::Ok(first) = safetensors::load(first_path.view()) else {
        io::eprintln("packed transformer: could not load ${first_path}");
        return 1;
    };
    guard let safetensors::LoadResult::Ok(second) = safetensors::load(second_path.view()) else {
        io::eprintln("packed transformer: could not load ${second_path}");
        return 1;
    };
    if first.tensor_count() +% second.tensor_count() != FULL_TENSOR_COUNT
        || first.parameter_count() +% second.parameter_count() != FULL_PARAMETER_COUNT {
        io::eprintln("packed transformer: source inventory does not match the pinned model");
        return 1;
    }

    let data_offset: u64 = align_up(
        HEADER_BYTES +% RECORD_BYTES *% FULL_TENSOR_COUNT as u64,
        DATA_ALIGNMENT,
    );
    var records: vec::Vec[PackedRecord] =
        vec::Vec[PackedRecord]::with_capacity(FULL_TENSOR_COUNT);
    var cursor: u64 = data_offset;
    var index: usize = 0 as usize;
    while index < FULL_TENSOR_COUNT {
        let name: text::Text = full_tensor_name(index, true);
        let record: PackedRecord = make_full_record(
            index, name.view(), full_tensor_spec(index), cursor, int4_rotated_policy,
        );
        if records.append(record) != status::Status::Ok {
            return 1;
        }
        index = index +% (1 as usize);
    }
    let file_bytes: u64 = align_up(cursor, TENSOR_ALIGNMENT);
    let expected_file_bytes: u64 = if int4_rotated_policy {
        INT4_ROTATED_FILE_BYTES
    } else { FULL_FILE_BYTES };
    if file_bytes != expected_file_bytes {
        io::eprintln("packed transformer: generated layout does not match the pinned size");
        return 1;
    }
    var header: PackedHeader = PackedHeader {
        magic: [81 as u8, 73 as u8, 80 as u8, 65 as u8, 67 as u8, 75 as u8, 49 as u8, 0 as u8],
        version: VERSION,
        header_bytes: HEADER_BYTES as u32,
        tensor_count: FULL_TENSOR_COUNT as u32,
        scope: SCOPE_TRANSFORMER,
        directory_offset: HEADER_BYTES,
        data_offset: data_offset,
        file_bytes: file_bytes,
        payload_checksum: 0 as u64,
        model_snapshot: [0 as u8; 40],
        diffusers_commit: [0 as u8; 40],
        policy: [0 as u8; 32],
        metadata_offset: 0 as u64,
        metadata_bytes: 0 as u32,
        metadata_version: 0 as u32,
        metadata_checksum: 0 as u64,
        reserved: [0 as u8; 64],
    };
    let _snapshot_ok: bool = fixed_text(#addr_of(header.model_snapshot[0]), 40 as usize, SNAPSHOT);
    let _commit_ok: bool = fixed_text(#addr_of(header.diffusers_commit[0]), 40 as usize, DIFFUSERS_COMMIT);
    let _policy_ok: bool = fixed_text(
        #addr_of(header.policy[0]),
        32 as usize,
        if int4_rotated_policy { INT4_ROTATED_POLICY } else { FULL_POLICY },
    );

    let temporary_path: text::Text = "${output_path}.tmp";
    guard let option::Option[text::CString]::Some(c_temporary) = temporary_path.c_str() else {
        return 1;
    };
    let fd: i32 = qi_pack_open(c_temporary.as_ptr(), O_WRONLY | O_CREAT | O_TRUNC, 420 as i32);
    if fd < (0 as i32) {
        io::eprintln("packed transformer: could not create ${temporary_path}");
        return 1;
    }
    if qi_pack_fchmod(fd, 420 as u16) != (0 as i32) {
        let _closed: i32 = qi_pack_close(fd);
        let _removed: i32 = qi_pack_unlink(c_temporary.as_ptr());
        io::eprintln("packed transformer: could not set safe output permissions");
        return 1;
    }
    var ok: bool = write_all(fd, #addr_of(header) as *u8, HEADER_BYTES as usize);
    index = 0 as usize;
    while ok && index < FULL_TENSOR_COUNT {
        guard let option::Option[*PackedRecord]::Some(record) = records.at_ptr(index) else {
            ok = false;
            break;
        };
        ok = write_all(fd, record as *u8, RECORD_BYTES as usize);
        index = index +% (1 as usize);
    }
    var payload_checksum: u64 = FNV_OFFSET;
    let directory_end: u64 = HEADER_BYTES +% RECORD_BYTES *% FULL_TENSOR_COUNT as u64;
    if ok {
        ok = write_zeroes(fd, data_offset -% directory_end, payload_checksum, false);
    }
    var position: u64 = data_offset;
    index = 0 as usize;
    while ok && index < FULL_TENSOR_COUNT {
        guard let option::Option[*PackedRecord]::Some(record) = records.at_ptr(index) else {
            ok = false;
            break;
        };
        let name: text::Text = full_tensor_name(index, true);
        let spec: FullTensorSpec = full_tensor_spec(index);
        if index >= GLOBAL_TENSOR_COUNT
            && (index -% GLOBAL_TENSOR_COUNT) % BLOCK_TENSOR_COUNT == (0 as usize) {
            let block_index: usize = (index -% GLOBAL_TENSOR_COUNT) / BLOCK_TENSOR_COUNT;
            io::println("packing transformer block ${block_index}/${TRANSFORMER_BLOCK_COUNT}");
        }
        guard let option::Option[safetensors::TensorData]::Some(tensor) = tensor_from_sources(
            first,
            second,
            name.view(),
        ) else {
            io::eprintln("packed transformer: missing ${name}");
            ok = false;
            break;
        };
        let expected_rank: usize = if spec.input == (0 as u64) { 1 as usize } else { 2 as usize };
        if tensor.dtype.name() != "BF16" || tensor.rank != expected_rank
            || tensor.dimensions[0] != spec.output
            || (expected_rank == (2 as usize) && tensor.dimensions[1] != spec.input) {
            io::eprintln("packed transformer: wrong metadata for ${name}");
            ok = false;
            break;
        }
        if position < { (*record).weights_offset } {
            ok = write_zeroes(fd, { (*record).weights_offset } -% position, payload_checksum, true);
            position = { (*record).weights_offset };
        }
        var tensor_hash: u64 = FNV_OFFSET;
        if (*record).scheme == SCHEME_BF16 {
            ok = write_payload(fd, tensor.pointer, tensor.byte_length as usize, payload_checksum);
            tensor_hash = hash_update(tensor_hash, tensor.pointer, tensor.byte_length as usize);
            position = position +% tensor.byte_length;
        } else if (*record).scheme == SCHEME_FP16 {
            guard let option::Option[OwnedBytes]::Some(converted) =
                convert_tensor_to_fp16(tensor) else {
                ok = false;
                break;
            };
            ok = write_payload(fd, converted.pointer, converted.length, payload_checksum);
            tensor_hash = hash_update(tensor_hash, converted.pointer, converted.length);
            position = position +% converted.length as u64;
        } else if (*record).scheme == SCHEME_INT4_ROTATED {
            guard let option::Option[[OwnedBytes; 2]]::Some(buffers) =
                quantize_tensor_int4_rotated(tensor, { *record }) else {
                ok = false;
                break;
            };
            ok = write_payload(fd, buffers[0].pointer, buffers[0].length, payload_checksum);
            tensor_hash = hash_update(tensor_hash, buffers[0].pointer, buffers[0].length);
            position = position +% buffers[0].length as u64;
            if ok && position < { (*record).scales_offset } {
                ok = write_zeroes(fd, { (*record).scales_offset } -% position, payload_checksum, true);
                position = { (*record).scales_offset };
            }
            if ok {
                ok = write_payload(fd, buffers[1].pointer, buffers[1].length, payload_checksum);
            }
            tensor_hash = hash_update(tensor_hash, buffers[1].pointer, buffers[1].length);
            position = position +% buffers[1].length as u64;
        } else {
            guard let option::Option[[OwnedBytes; 3]]::Some(buffers) = quantize_tensor(
                tensor,
                { *record },
            ) else {
                ok = false;
                break;
            };
            ok = write_payload(fd, buffers[0].pointer, buffers[0].length, payload_checksum);
            tensor_hash = hash_update(tensor_hash, buffers[0].pointer, buffers[0].length);
            position = position +% buffers[0].length as u64;
            if ok && position < { (*record).scales_offset } {
                ok = write_zeroes(fd, { (*record).scales_offset } -% position, payload_checksum, true);
                position = { (*record).scales_offset };
            }
            if ok {
                ok = write_payload(fd, buffers[1].pointer, buffers[1].length, payload_checksum);
            }
            tensor_hash = hash_update(tensor_hash, buffers[1].pointer, buffers[1].length);
            position = position +% buffers[1].length as u64;
            if ok && position < { (*record).zeros_offset } {
                ok = write_zeroes(fd, { (*record).zeros_offset } -% position, payload_checksum, true);
                position = { (*record).zeros_offset };
            }
            if ok {
                ok = write_payload(fd, buffers[2].pointer, buffers[2].length, payload_checksum);
            }
            tensor_hash = hash_update(tensor_hash, buffers[2].pointer, buffers[2].length);
            position = position +% buffers[2].length as u64;
        }
        (*record).tensor_checksum = tensor_hash;
        index = index +% (1 as usize);
    }
    if ok && position < file_bytes {
        ok = write_zeroes(fd, file_bytes -% position, payload_checksum, true);
    }
    header.payload_checksum = payload_checksum;
    if ok && qi_pack_lseek(fd, 0 as i64, SEEK_SET) != (0 as i64) { ok = false; }
    if ok { ok = write_all(fd, #addr_of(header) as *u8, HEADER_BYTES as usize); }
    index = 0 as usize;
    while ok && index < FULL_TENSOR_COUNT {
        guard let option::Option[*PackedRecord]::Some(record) = records.at_ptr(index) else {
            ok = false;
            break;
        };
        ok = write_all(fd, record as *u8, RECORD_BYTES as usize);
        index = index +% (1 as usize);
    }
    if ok && qi_pack_fsync(fd) != (0 as i32) { ok = false; }
    let _closed: i32 = qi_pack_close(fd);
    if !ok || verify_packed(temporary_path.view(), true) != (0 as i32)
        || verify_full_against_source(temporary_path.view(), first, second, true) != (0 as i32) {
        let _removed: i32 = qi_pack_unlink(c_temporary.as_ptr());
        io::eprintln("packed transformer: temporary output failed validation");
        return 1;
    }
    let output_owner: text::Text = text::from_str(output_path);
    guard let option::Option[text::CString]::Some(c_output) = output_owner.c_str() else {
        let _removed: i32 = qi_pack_unlink(c_temporary.as_ptr());
        return 1;
    };
    if qi_pack_rename(c_temporary.as_ptr(), c_output.as_ptr()) != (0 as i32) {
        let _removed: i32 = qi_pack_unlink(c_temporary.as_ptr());
        io::eprintln("packed transformer: could not install ${output_path}");
        return 1;
    }
    io::println("packed transformer written atomically: ${output_path}");
    if verify_packed(output_path) != (0 as i32) { return 1; }
    io::println("packed transformer: source round-trip verified");
    return 0;
}

fn quantize_transformer(model_directory: str, output_path: str) -> i32 {
    return quantize_transformer_impl(model_directory, output_path, false);
}

fn quantize_transformer_int4_rotated(model_directory: str, output_path: str) -> i32 {
    return quantize_transformer_impl(model_directory, output_path, true);
}

// MARK: - Key/value metadata

// Metadata is a UTF-8 block of `key=value` lines stored in the unused padding
// between the tensor directory and the page-aligned data section. That space
// is outside the payload checksum, so metadata can be added to an existing
// pack in place. Keys use [a-z0-9._-]; values are single-line. Unknown keys
// are preserved and ignored; the known keys below are validated on load.
const METADATA_VERSION: u32 = 1;
const METADATA_BASE_PREFIX: str = "Qwen/Qwen-Image-2.1@";

struct MetadataEntry {
    key: text::Text,
    value: text::Text,
}

struct Metadata {
    entries: vec::Vec[MetadataEntry],
}

enum MetadataResult {
    Ok(Metadata),
    Err(text::Text),
}

impl Metadata {
    // The returned view borrows this Metadata and must not outlive it.
    fn get(this, key: str) -> option::Option[str] {
        var index: usize = 0 as usize;
        while index < this.entries.count() {
            guard let option::Option[*MetadataEntry]::Some(entry) = this.entries.at_ptr(index) else {
                return option::Option[str]::None;
            };
            if (*entry).key.view() == key {
                return option::Option[str]::Some((*entry).value.view());
            }
            index = index +% (1 as usize);
        }
        return option::Option[str]::None;
    }

    // An empty value removes the key.
    fn set(ref this, key: str, value: str) -> status::Status {
        var index: usize = 0 as usize;
        while index < this.entries.count() {
            guard let option::Option[*MetadataEntry]::Some(entry) = this.entries.at_ptr(index) else {
                return status::Status::OutOfBounds;
            };
            if (*entry).key.view() == key {
                if value.count() == (0 as usize) {
                    let _removed: option::Option[MetadataEntry] = this.entries.remove(index);
                    return status::Status::Ok;
                }
                (*entry).value = text::from_str(value);
                return status::Status::Ok;
            }
            index = index +% (1 as usize);
        }
        if value.count() == (0 as usize) { return status::Status::Ok; }
        return this.entries.append(MetadataEntry {
            key: text::from_str(key),
            value: text::from_str(value),
        });
    }

    fn serialize(this) -> text::Text {
        var output: text::Text = text::new();
        var index: usize = 0 as usize;
        while index < this.entries.count() {
            guard let option::Option[*MetadataEntry]::Some(entry) = this.entries.at_ptr(index) else {
                return output;
            };
            let _key: status::Status = output.append((*entry).key.view());
            let _equals: status::Status = output.append("=");
            let _value: status::Status = output.append((*entry).value.view());
            let _newline: status::Status = output.append("\n");
            index = index +% (1 as usize);
        }
        return output;
    }
}

fn empty_metadata() -> Metadata {
    return Metadata { entries: vec::Vec[MetadataEntry]::with_capacity(8 as usize) };
}

fn metadata_key_valid(key: str) -> bool {
    if key.count() == (0 as usize) || key.count() > (64 as usize) { return false; }
    var index: usize = 0 as usize;
    while index < key.count() {
        guard let option::Option[u8]::Some(byte) = key.byte_at(index) else { return false; };
        let ok: bool = (byte >= (97 as u8) && byte <= (122 as u8))
            || (byte >= (48 as u8) && byte <= (57 as u8))
            || byte == (46 as u8) || byte == (95 as u8) || byte == (45 as u8);
        if !ok { return false; }
        index = index +% (1 as usize);
    }
    return true;
}

fn metadata_value_valid(value: str) -> bool {
    if value.count() == (0 as usize) || value.count() > (512 as usize) { return false; }
    var index: usize = 0 as usize;
    while index < value.count() {
        guard let option::Option[u8]::Some(byte) = value.byte_at(index) else { return false; };
        if byte < (32 as u8) || byte == (127 as u8) { return false; }
        index = index +% (1 as usize);
    }
    return true;
}

fn parse_decimal_usize(value: str) -> option::Option[usize] {
    if value.count() == (0 as usize) || value.count() > (6 as usize) {
        return option::Option[usize]::None;
    }
    var result: usize = 0 as usize;
    var index: usize = 0 as usize;
    while index < value.count() {
        guard let option::Option[u8]::Some(byte) = value.byte_at(index) else {
            return option::Option[usize]::None;
        };
        if byte < (48 as u8) || byte > (57 as u8) { return option::Option[usize]::None; }
        result = result *% (10 as usize) +% (byte -% (48 as u8)) as usize;
        index = index +% (1 as usize);
    }
    return option::Option[usize]::Some(result);
}

// Returns an error message for an invalid known key, or an empty Text.
fn validate_known_metadata(metadata: Metadata) -> text::Text {
    match metadata.get("base") {
        option::Option[str]::Some(value) => {
            let expected: text::Text = "${METADATA_BASE_PREFIX}${SNAPSHOT}";
            if value != expected.view() {
                return "base must be ${expected}, got ${value}";
            }
        }
        option::Option[str]::None => {}
    }
    match metadata.get("kind") {
        option::Option[str]::Some(value) => {
            if value != "base" && value != "distilled" {
                return "kind must be base or distilled, got ${value}";
            }
        }
        option::Option[str]::None => {}
    }
    match metadata.get("steps") {
        option::Option[str]::Some(value) => {
            guard let option::Option[usize]::Some(steps) = parse_decimal_usize(value) else {
                return "steps must be a whole number, got ${value}";
            };
            // Only the counts generate-1024 can run; anything else would be
            // refused at generation time.
            if !(steps == (3 as usize) || steps == (4 as usize) || steps == (8 as usize)
                || steps == (25 as usize) || steps == (40 as usize)) {
                return "steps must be 3, 4, 8, 25, or 40, got ${value}";
            }
        }
        option::Option[str]::None => {}
    }
    match metadata.get("shift_terminal") {
        option::Option[str]::Some(value) => {
            if value != "0.02" && value != "none" {
                return "shift_terminal must be 0.02 or none, got ${value}";
            }
        }
        option::Option[str]::None => {}
    }
    match metadata.get("cache") {
        option::Option[str]::Some(value) => {
            if value != "none" && value != "taylorseer" && value != "cache-dit-0.16" {
                return "cache must be none, taylorseer, or cache-dit-0.16, got ${value}";
            }
            if value != "none" && metadata_is_distilled(metadata) {
                return "cache=${value} is invalid for kind=distilled; few-step distills have no steps to cache";
            }
        }
        option::Option[str]::None => {}
    }
    return text::new();
}

fn metadata_is_distilled(metadata: Metadata) -> bool {
    return match metadata.get("kind") {
        option::Option[str]::Some(value) => value == "distilled",
        option::Option[str]::None => false,
    };
}

fn parse_metadata(source: str) -> MetadataResult {
    var metadata: Metadata = empty_metadata();
    var line_start: usize = 0 as usize;
    while line_start < source.count() {
        var line_end: usize = line_start;
        while line_end < source.count() {
            guard let option::Option[u8]::Some(byte) = source.byte_at(line_end) else {
                return MetadataResult::Err("metadata is not readable");
            };
            if byte == (10 as u8) { break; }
            line_end = line_end +% (1 as usize);
        }
        if line_end == source.count() {
            return MetadataResult::Err("metadata must end with a newline");
        }
        guard let option::Option[str]::Some(line) = source.slice(line_start, line_end) else {
            return MetadataResult::Err("metadata line is not valid UTF-8");
        };
        guard let option::Option[usize]::Some(equals) = line.find("=") else {
            return MetadataResult::Err("metadata line has no '=': ${line}");
        };
        guard let option::Option[str]::Some(key) = line.slice(0 as usize, equals) else {
            return MetadataResult::Err("metadata key is not readable");
        };
        guard let option::Option[str]::Some(value) = line.slice(equals +% (1 as usize), line.count()) else {
            return MetadataResult::Err("metadata value is not readable");
        };
        if !metadata_key_valid(key) {
            return MetadataResult::Err("invalid metadata key: ${key}");
        }
        if !metadata_value_valid(value) {
            return MetadataResult::Err("invalid metadata value for ${key}");
        }
        match metadata.get(key) {
            option::Option[str]::Some(_existing) => {
                return MetadataResult::Err("duplicate metadata key: ${key}");
            }
            option::Option[str]::None => {}
        }
        if metadata.set(key, value) != status::Status::Ok {
            return MetadataResult::Err("could not store metadata");
        }
        line_start = line_end +% (1 as usize);
    }
    let known_error: text::Text = validate_known_metadata(metadata);
    if known_error.view().count() > (0 as usize) {
        return MetadataResult::Err(known_error);
    }
    return MetadataResult::Ok(metadata);
}

fn directory_end(header: *PackedHeader) -> u64 {
    return (*header).directory_offset +% RECORD_BYTES *% (*header).tensor_count as u64;
}

// Reads and validates the metadata block of a mapped pack. A pack without
// metadata yields an empty Metadata.
fn mapped_metadata(pointer: *u8, length: usize) -> MetadataResult {
    if length < HEADER_BYTES as usize {
        return MetadataResult::Err("file is too small for a header");
    }
    let header: *PackedHeader = pointer as *PackedHeader;
    if !magic_matches(header) {
        return MetadataResult::Err("not a QIPACK1 file");
    }
    if (*header).metadata_offset == (0 as u64) && (*header).metadata_bytes == (0 as u32)
        && (*header).metadata_version == (0 as u32)
        && (*header).metadata_checksum == (0 as u64) {
        return MetadataResult::Ok(empty_metadata());
    }
    if (*header).metadata_version != METADATA_VERSION {
        return MetadataResult::Err("unsupported metadata version ${(*header).metadata_version}");
    }
    let start: u64 = (*header).metadata_offset;
    let directory: u64 = (*header).directory_offset;
    let count: u64 = (*header).tensor_count as u64;
    let data: u64 = (*header).data_offset;
    // Check each bound before adding an offset or forming a mapped pointer.
    if directory < HEADER_BYTES || directory > data
        || count > (data -% directory) / RECORD_BYTES
        || data > length as u64
        || start < directory +% count *% RECORD_BYTES || start > data
        || (*header).metadata_bytes as u64 > data -% start {
        return MetadataResult::Err("metadata block is outside the directory padding");
    }
    let bytes: *u8 = pointer + start as usize;
    if hash_update(FNV_OFFSET, bytes, (*header).metadata_bytes as usize)
        != (*header).metadata_checksum {
        return MetadataResult::Err("metadata checksum mismatch");
    }
    return parse_metadata(#str_from_raw_parts(bytes, (*header).metadata_bytes as usize));
}

fn read_metadata(path: str) -> MetadataResult {
    guard let mapped::MapResult::Ok(file) = mapped::map_readonly(path) else {
        return MetadataResult::Err("could not map ${path}");
    };
    return mapped_metadata(file.pointer(), file.length());
}

fn pwrite_all(fd: i32, bytes: *u8, count: usize, offset: u64) -> bool {
    var written: usize = 0 as usize;
    while written < count {
        let result: isize = qi_pack_pwrite(
            fd, bytes + written, count -% written, (offset +% written as u64) as i64,
        );
        if result <= (0 as isize) { return false; }
        written = written +% result as usize;
    }
    return true;
}

// Replaces the metadata block in place, in three fsync'd stages so a crash or
// a full disk never leaves a pack that neither the loader nor this tool
// accepts: (1) the header's metadata descriptor is cleared, which reads as
// "no metadata"; (2) the padding is cleared and the new block written;
// (3) the header points at the new block.
fn write_metadata(path: str, metadata: Metadata) -> i32 {
    let known_error: text::Text = validate_known_metadata(metadata);
    if known_error.view().count() > (0 as usize) {
        io::eprintln("pack metadata: ${known_error}");
        return 2;
    }
    var header: PackedHeader = PackedHeader {
        magic: [0 as u8; 8], version: 0 as u32, header_bytes: 0 as u32,
        tensor_count: 0 as u32, scope: 0 as u32, directory_offset: 0 as u64,
        data_offset: 0 as u64, file_bytes: 0 as u64, payload_checksum: 0 as u64,
        model_snapshot: [0 as u8; 40], diffusers_commit: [0 as u8; 40],
        policy: [0 as u8; 32], metadata_offset: 0 as u64, metadata_bytes: 0 as u32,
        metadata_version: 0 as u32, metadata_checksum: 0 as u64, reserved: [0 as u8; 64],
    };
    {
        guard let mapped::MapResult::Ok(file) = mapped::map_readonly(path) else {
            io::eprintln("pack metadata: could not map ${path}");
            return 1;
        };
        if file.length() < HEADER_BYTES as usize || !magic_matches(file.pointer() as *PackedHeader) {
            io::eprintln("pack metadata: ${path} is not a QIPACK1 file");
            return 1;
        }
        header = *(file.pointer() as *PackedHeader);
        // Never derive a write range from a damaged header.
        if header.version != VERSION || header.header_bytes != HEADER_BYTES as u32
            || header.directory_offset != HEADER_BYTES
            || header.file_bytes != file.length() as u64
            || header.data_offset < directory_end(#addr_of(header))
            || header.data_offset > file.length() as u64
            || header.data_offset -% directory_end(#addr_of(header)) > DATA_ALIGNMENT {
            io::eprintln("pack metadata: ${path} has an inconsistent header; refusing to write");
            return 1;
        }
    }
    let block: text::Text = metadata.serialize();
    let start: u64 = directory_end(#addr_of(header));
    let capacity: u64 = header.data_offset -% start;
    if block.view().count() as u64 > capacity {
        io::eprintln("pack metadata: ${block.view().count()} bytes exceed the ${capacity}-byte directory padding");
        return 2;
    }
    let path_owner: text::Text = text::from_str(path);
    guard let option::Option[text::CString]::Some(c_path) = path_owner.c_str() else { return 1; };
    let fd: i32 = qi_pack_open(c_path.as_ptr(), O_RDWR, 0 as i32);
    if fd < (0 as i32) {
        io::eprintln("pack metadata: could not open ${path} for writing");
        return 1;
    }
    // Stage 1: detach the old block.
    var detached: PackedHeader = header;
    detached.metadata_offset = 0 as u64;
    detached.metadata_bytes = 0 as u32;
    detached.metadata_version = 0 as u32;
    detached.metadata_checksum = 0 as u64;
    var ok: bool = pwrite_all(fd, #addr_of(detached) as *u8, HEADER_BYTES as usize, 0 as u64);
    if ok { ok = qi_pack_fsync(fd) == (0 as i32); }
    // Stage 2: clear the whole padding, then write the block at its start.
    var zeroes: [u8; 256] = [0 as u8; 256];
    var cleared: u64 = 0 as u64;
    while ok && cleared < capacity {
        let amount: u64 = if capacity -% cleared < (256 as u64) { capacity -% cleared } else { 256 as u64 };
        ok = pwrite_all(fd, #addr_of(zeroes[0]), amount as usize, start +% cleared);
        cleared = cleared +% amount;
    }
    let block_bytes: usize = block.view().count();
    if ok && block_bytes > (0 as usize) {
        ok = pwrite_all(fd, #str_ptr(block.view()), block_bytes, start);
    }
    if ok { ok = qi_pack_fsync(fd) == (0 as i32); }
    if block_bytes == (0 as usize) {
        header.metadata_offset = 0 as u64;
        header.metadata_bytes = 0 as u32;
        header.metadata_version = 0 as u32;
        header.metadata_checksum = 0 as u64;
    } else {
        header.metadata_offset = start;
        header.metadata_bytes = block_bytes as u32;
        header.metadata_version = METADATA_VERSION;
        header.metadata_checksum = hash_update(FNV_OFFSET, #str_ptr(block.view()), block_bytes);
    }
    if ok { ok = pwrite_all(fd, #addr_of(header) as *u8, HEADER_BYTES as usize, 0 as u64); }
    if ok { ok = qi_pack_fsync(fd) == (0 as i32); }
    let _closed: i32 = qi_pack_close(fd);
    if !ok {
        io::eprintln("pack metadata: write failed for ${path}");
        return 1;
    }
    return 0;
}

// `pack-metadata FILE [key=value ...]`: show metadata, or set/remove keys
// (an empty value removes) and show the result.
fn pack_metadata_command(path: str, assignments: vec::Vec[text::Text]) -> i32 {
    var metadata: Metadata = empty_metadata();
    match read_metadata(path) {
        MetadataResult::Ok(found) => { metadata = found; }
        MetadataResult::Err(message) => {
            // Unreadable metadata can be replaced, never silently shown.
            if assignments.count() == (0 as usize) {
                io::eprintln("pack metadata: ${message}");
                return 1;
            }
            io::eprintln("pack metadata: ${message}; replacing it with only the given keys");
        }
    }
    if assignments.count() > (0 as usize) {
        var index: usize = 0 as usize;
        while index < assignments.count() {
            guard let option::Option[*text::Text]::Some(assignment) = assignments.at_ptr(index) else {
                return 1;
            };
            let view: str = (*assignment).view();
            guard let option::Option[usize]::Some(equals) = view.find("=") else {
                io::eprintln("pack metadata: expected key=value, got ${view}");
                return 2;
            };
            guard let option::Option[str]::Some(key) = view.slice(0 as usize, equals) else { return 2; };
            guard let option::Option[str]::Some(value) = view.slice(equals +% (1 as usize), view.count()) else { return 2; };
            if !metadata_key_valid(key)
                || (value.count() > (0 as usize) && !metadata_value_valid(value)) {
                io::eprintln("pack metadata: invalid key or value in ${view}");
                return 2;
            }
            if metadata.set(key, value) != status::Status::Ok { return 1; }
            index = index +% (1 as usize);
        }
        let written: i32 = write_metadata(path, metadata);
        if written != (0 as i32) { return written; }
        match read_metadata(path) {
            MetadataResult::Ok(found) => { metadata = found; }
            MetadataResult::Err(message) => {
                io::eprintln("pack metadata: reread failed: ${message}");
                return 1;
            }
        }
    }
    if metadata.entries.count() == (0 as usize) {
        io::println("${path}: no metadata");
        return 0;
    }
    io::println("${path}:");
    io::print(metadata.serialize().view());
    return 0;
}

#[test]
fn metadata_round_trips_and_validates_known_keys() {
    let source: str = "base=Qwen/Qwen-Image-2.1@b3179ad355be050328e483a9dfdd9e60cd62adfa\nkind=distilled\nsteps=4\nshift_terminal=none\nnote.custom=kept as is\n";
    match parse_metadata(source) {
        MetadataResult::Ok(metadata) => {
            assert metadata.entries.count() == (5 as usize);
            match metadata.get("steps") {
                option::Option[str]::Some(value) => { assert value == "4"; }
                option::Option[str]::None => { assert false; }
            }
            match metadata.get("note.custom") {
                option::Option[str]::Some(value) => { assert value == "kept as is"; }
                option::Option[str]::None => { assert false; }
            }
            assert metadata.serialize().view() == source;
        }
        MetadataResult::Err(_message) => { assert false; }
    }
}

#[test]
fn metadata_rejects_invalid_blocks() {
    match parse_metadata("kind=turbo\n") {
        MetadataResult::Ok(_m) => { assert false; }
        MetadataResult::Err(_message) => {}
    }
    match parse_metadata("steps=0\n") {
        MetadataResult::Ok(_m) => { assert false; }
        MetadataResult::Err(_message) => {}
    }
    // Only step counts generate-1024 can run are accepted.
    match parse_metadata("steps=6\n") {
        MetadataResult::Ok(_m) => { assert false; }
        MetadataResult::Err(_message) => {}
    }
    match parse_metadata("steps=4\n") {
        MetadataResult::Ok(_m) => {}
        MetadataResult::Err(_message) => { assert false; }
    }
    match parse_metadata("shift_terminal=0.5\n") {
        MetadataResult::Ok(_m) => { assert false; }
        MetadataResult::Err(_message) => {}
    }
    match parse_metadata("kind=distilled\ncache=taylorseer\n") {
        MetadataResult::Ok(_m) => { assert false; }
        MetadataResult::Err(_message) => {}
    }
    match parse_metadata("cache=fast\n") {
        MetadataResult::Ok(_m) => { assert false; }
        MetadataResult::Err(_message) => {}
    }
    match parse_metadata("base=Other/Model@abc\n") {
        MetadataResult::Ok(_m) => { assert false; }
        MetadataResult::Err(_message) => {}
    }
    match parse_metadata("Kind=base\n") {
        MetadataResult::Ok(_m) => { assert false; }
        MetadataResult::Err(_message) => {}
    }
    match parse_metadata("kind=base\nkind=base\n") {
        MetadataResult::Ok(_m) => { assert false; }
        MetadataResult::Err(_message) => {}
    }
    match parse_metadata("kind=base") {
        MetadataResult::Ok(_m) => { assert false; }
        MetadataResult::Err(_message) => {}
    }
}

#[test]
fn metadata_set_replaces_and_removes() {
    var metadata: Metadata = empty_metadata();
    assert metadata.set("steps", "40") == status::Status::Ok;
    assert metadata.set("steps", "4") == status::Status::Ok;
    assert metadata.entries.count() == (1 as usize);
    assert metadata.set("steps", "") == status::Status::Ok;
    assert metadata.entries.count() == (0 as usize);
}

#[test]
fn mapped_metadata_checks_ranges_before_reading() {
    var raw: [u64; 512] = [0 as u64; 512];
    let pointer: *u8 = #addr_of(raw[0]) as *u8;
    let header: *PackedHeader = pointer as *PackedHeader;
    (*header).magic = [81 as u8, 73 as u8, 80 as u8, 65 as u8,
        67 as u8, 75 as u8, 49 as u8, 0 as u8];
    (*header).directory_offset = HEADER_BYTES;
    (*header).data_offset = 4096 as u64;
    (*header).metadata_version = METADATA_VERSION;
    (*header).metadata_checksum = FNV_OFFSET;

    // An empty block at the data boundary is valid.
    (*header).metadata_offset = 4096 as u64;
    match mapped_metadata(pointer, 4096 as usize) {
        MetadataResult::Ok(metadata) => { assert metadata.entries.count() == (0 as usize); }
        MetadataResult::Err(_message) => { assert false; }
    }

    // A truncated block and an offset that wraps on addition are rejected.
    (*header).metadata_bytes = 1 as u32;
    match mapped_metadata(pointer, 4096 as usize) {
        MetadataResult::Ok(_metadata) => { assert false; }
        MetadataResult::Err(_message) => {}
    }
    (*header).metadata_offset = (0 as u64) -% (1 as u64) -% ((1 as u64) << (31 as u64));
    (*header).metadata_bytes = ((1 as u64) << (31 as u64)) as u32 +% (2 as u32);
    match mapped_metadata(pointer, 4096 as usize) {
        MetadataResult::Ok(_metadata) => { assert false; }
        MetadataResult::Err(_message) => {}
    }

    // A directory claiming records beyond the data boundary is rejected.
    (*header).metadata_offset = 4096 as u64;
    (*header).metadata_bytes = 0 as u32;
    (*header).tensor_count = 16 as u32;
    match mapped_metadata(pointer, 4096 as usize) {
        MetadataResult::Ok(_metadata) => { assert false; }
        MetadataResult::Err(_message) => {}
    }
}

#[test]
fn packed_layout_is_fixed_and_aligned() {
    assert #size_of::[PackedHeader]() == (256 as usize);
    assert #size_of::[PackedRecord]() == (256 as usize);
    assert align_up(257 as u64, 256 as u64) == (512 as u64);
}

#[test]
fn full_transformer_layout_matches_inventory_and_policy() {
    let data_offset: u64 = align_up(
        HEADER_BYTES +% RECORD_BYTES *% FULL_TENSOR_COUNT as u64,
        DATA_ALIGNMENT,
    );
    var cursor: u64 = data_offset;
    var parameters: u64 = 0 as u64;
    var quantized: usize = 0 as usize;
    var fp16: usize = 0 as usize;
    var index: usize = 0 as usize;
    while index < FULL_TENSOR_COUNT {
        let name: text::Text = full_tensor_name(index, true);
        let spec: FullTensorSpec = full_tensor_spec(index);
        let record: PackedRecord = make_full_record(index, name.view(), spec, cursor);
        parameters = parameters +% record.elements;
        if record.scheme == SCHEME_INT8_AFFINE {
            quantized = quantized +% (1 as usize);
        }
        if record.scheme == SCHEME_FP16 { fp16 = fp16 +% (1 as usize); }
        index = index +% (1 as usize);
    }
    assert data_offset == (77824 as u64);
    assert parameters == FULL_PARAMETER_COUNT;
    assert quantized == (0 as usize);
    assert fp16 == (224 as usize);
    assert align_up(cursor, TENSOR_ALIGNMENT) == FULL_FILE_BYTES;
}

#[test]
fn full_transformer_policy_boundaries_match_calibration() {
    let block0: usize = GLOBAL_TENSOR_COUNT;
    let block23: usize = GLOBAL_TENSOR_COUNT +% (23 as usize) *% BLOCK_TENSOR_COUNT;
    let block24: usize = GLOBAL_TENSOR_COUNT +% (24 as usize) *% BLOCK_TENSOR_COUNT;
    let block28: usize = GLOBAL_TENSOR_COUNT +% (28 as usize) *% BLOCK_TENSOR_COUNT;
    assert !full_tensor_spec(block23 +% (2 as usize)).quantized;
    assert full_tensor_spec(block24 +% (2 as usize)).quantized;
    assert full_tensor_spec(block24 +% (5 as usize)).quantized;
    assert !full_tensor_spec(block24 +% (6 as usize)).quantized;
    assert !full_tensor_spec(block24 +% (7 as usize)).quantized;
    assert !full_tensor_spec(block24 +% (8 as usize)).quantized;
    assert !full_tensor_spec(block28 +% (6 as usize)).quantized;
    assert full_tensor_spec(block28 +% (7 as usize)).quantized;
    assert full_tensor_spec(block28 +% (8 as usize)).quantized;
    assert full_tensor_name(block28 +% (8 as usize), true)
        == "transformer_blocks.28.img_mlp.proj.weight";
    assert full_tensor_name(block0 +% (2 as usize), true)
        == "transformer_blocks.0.attn.to_q.weight";
    assert full_tensor_name(block0 +% (3 as usize), true)
        == "transformer_blocks.0.attn.to_k.weight";
    assert full_tensor_name(block0 +% (4 as usize), true)
        == "transformer_blocks.0.attn.to_v.weight";
    assert full_expected_scheme(block0 +% (2 as usize), true, true, true)
        == SCHEME_FP16;
    assert full_expected_scheme(block24 +% (2 as usize), true, true, true)
        == SCHEME_FP16;
    assert full_expected_scheme(block24 +% (2 as usize), true, true)
        == SCHEME_INT8_AFFINE;
}

#[test]
fn int4_rotated_layout_covers_every_h256_matrix() {
    let data_offset: u64 = align_up(
        HEADER_BYTES +% RECORD_BYTES *% FULL_TENSOR_COUNT as u64,
        DATA_ALIGNMENT,
    );
    var cursor: u64 = data_offset;
    var int4_count: usize = 0 as usize;
    var index: usize = 0 as usize;
    while index < FULL_TENSOR_COUNT {
        let name: text::Text = full_tensor_name(index, true);
        let record: PackedRecord = make_full_record(
            index, name.view(), full_tensor_spec(index), cursor, true,
        );
        if record.scheme == SCHEME_INT4_ROTATED {
            assert record.group_axis == (1 as u32);
            assert record.group_size == (256 as u32);
            assert record.scale_type == TYPE_F16;
            assert record.zero_type == TYPE_NONE;
            assert record.scales_length == record.dimensions[0] *% (2 as u64);
            assert record.zeros_length == (0 as u64);
            int4_count = int4_count +% (1 as usize);
        }
        index = index +% (1 as usize);
    }
    assert int4_count == (231 as usize);
    assert align_up(cursor, TENSOR_ALIGNMENT) == INT4_ROTATED_FILE_BYTES;
    assert full_layout_file_bytes(true) == INT4_ROTATED_FILE_BYTES;
}

#[test]
fn normalized_hadamard_256_is_an_involution() {
    var values: [f32; 256] = [0.0f32; 256];
    var original: [f32; 256] = [0.0f32; 256];
    var index: usize = 0 as usize;
    while index < (256 as usize) {
        let value: f32 = (index % (17 as usize)) as f32 - 8.0f32;
        values[index] = value;
        original[index] = value;
        index = index +% (1 as usize);
    }
    hadamard_256_in_place(#addr_of(values[0]));
    hadamard_256_in_place(#addr_of(values[0]));
    index = 0 as usize;
    while index < (256 as usize) {
        assert (values[index] - original[index]).abs() < 0.00001f32;
        index = index +% (1 as usize);
    }
}

#[test]
fn packed_checksum_detects_a_bit_flip() {
    var bytes: [u8; 4] = [1 as u8, 2 as u8, 3 as u8, 4 as u8];
    let original: u64 = hash_update(FNV_OFFSET, #addr_of(bytes[0]), 4 as usize);
    bytes[2] = bytes[2] ^ (1 as u8);
    let corrupted: u64 = hash_update(FNV_OFFSET, #addr_of(bytes[0]), 4 as usize);
    assert original != corrupted;
}

#[test]
fn runtime_tensor_verifier_detects_a_bit_flip() {
    var bytes: [u8; 4] = [1 as u8, 2 as u8, 3 as u8, 4 as u8];
    var record: PackedRecord = PackedRecord {
        name: [0 as u8; 128],
        scheme: SCHEME_BF16,
        rank: 1 as u32,
        dimensions: [2 as u64, 0 as u64, 0 as u64, 0 as u64],
        group_axis: 0xFFFFFFFF as u32,
        group_size: 0 as u32,
        scale_type: TYPE_NONE,
        zero_type: TYPE_NONE,
        weights_offset: 0 as u64,
        weights_length: 4 as u64,
        scales_offset: 0 as u64,
        scales_length: 0 as u64,
        zeros_offset: 0 as u64,
        zeros_length: 0 as u64,
        elements: 2 as u64,
        tensor_checksum: hash_update(FNV_OFFSET, #addr_of(bytes[0]), 4 as usize),
        reserved: [0 as u8; 8],
    };
    assert verify_runtime_hash_range(RuntimeHashJob {
        file_pointer: #addr_of(bytes[0]),
        records: #addr_of(record),
        start: 0 as usize,
        end: 1 as usize,
    }) == (0 as i32);
    bytes[2] = bytes[2] ^ (1 as u8);
    assert verify_runtime_hash_range(RuntimeHashJob {
        file_pointer: #addr_of(bytes[0]),
        records: #addr_of(record),
        start: 0 as usize,
        end: 1 as usize,
    }) != (0 as i32);
}
