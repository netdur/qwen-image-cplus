import "metal/metal" as metal;
import "objc/runtime" as rt;
import "stdlib/option" as option;

#[link_name = "dlopen"]
extern fn qi_dlopen(path: *u8, mode: i32) -> *u8;

#[link_name = "objc_msgSend"]
extern fn qi_msg_id_u64_u64_u64_u32(
    receiver: *u8,
    selector: *u8,
    first: u64,
    second: u64,
    third: u64,
    fourth: u32,
) -> *u8;

#[link_name = "objc_msgSend"]
extern fn qi_msg_id_id_u64_id(
    receiver: *u8,
    selector: *u8,
    first: *u8,
    second: u64,
    third: *u8,
) -> *u8;

#[link_name = "objc_msgSend"]
extern fn qi_msg_id_id_i8_i8_u64_u64_u64_f64_f64(
    receiver: *u8,
    selector: *u8,
    device: *u8,
    transpose_left: i8,
    transpose_right: i8,
    rows: u64,
    columns: u64,
    inner: u64,
    alpha: f64,
    beta: f64,
) -> *u8;

#[link_name = "objc_msgSend"]
extern fn qi_msg_void_id_id_id_id(
    receiver: *u8,
    selector: *u8,
    command_buffer: *u8,
    left: *u8,
    right: *u8,
    output: *u8,
);

const RTLD_LAZY: i32 = 1;
const MPS_DATA_TYPE_FLOAT16: u32 = 0x10000010;
const MPS_DATA_TYPE_FLOAT32: u32 = 0x10000020;

struct OwnedObjc {
    opaque pointer: *u8,
}

impl OwnedObjc {
    fn new(pointer: *u8) -> OwnedObjc {
        return OwnedObjc { pointer: pointer };
    }

    fn raw(this) -> *u8 {
        return this.pointer;
    }

    fn drop(ref this) {
        if !this.pointer.is_null() {
            rt::release(this.pointer);
            this.pointer = 0 as *u8;
        }
    }
}

struct Multiplication {
    opaque left_descriptor: OwnedObjc,
    opaque right_descriptor: OwnedObjc,
    opaque output_descriptor: OwnedObjc,
    opaque left_matrix: OwnedObjc,
    opaque right_matrix: OwnedObjc,
    opaque output_matrix: OwnedObjc,
    opaque kernel: OwnedObjc,
}

impl Multiplication {
    fn encode(this, command_buffer: metal::CommandBuffer) {
        qi_msg_void_id_id_id_id(
            this.kernel.raw(),
            rt::sel(#str_ptr("encodeToCommandBuffer:leftMatrix:rightMatrix:resultMatrix:\0")),
            command_buffer.raw(),
            this.left_matrix.raw(),
            this.right_matrix.raw(),
            this.output_matrix.raw(),
        );
    }
}

fn load_framework() -> bool {
    let handle: *u8 = qi_dlopen(
        #str_ptr("/System/Library/Frameworks/MetalPerformanceShaders.framework/MetalPerformanceShaders\0"),
        RTLD_LAZY,
    );
    return !handle.is_null();
}

fn descriptor(rows: usize, columns: usize, element_bytes: usize, data_type: u32)
    -> option::Option[OwnedObjc] {
    let class: *u8 = rt::get_class(#str_ptr("MPSMatrixDescriptor\0"));
    if class.is_null() { return option::Option[OwnedObjc]::None; }
    let value: *u8 = qi_msg_id_u64_u64_u64_u32(
        class,
        rt::sel(#str_ptr("matrixDescriptorWithRows:columns:rowBytes:dataType:\0")),
        rows as u64,
        columns as u64,
        (columns *% element_bytes) as u64,
        data_type,
    );
    if value.is_null() { return option::Option[OwnedObjc]::None; }
    return option::Option[OwnedObjc]::Some(OwnedObjc::new(rt::retain(value)));
}

fn matrix(
    buffer: metal::Buffer,
    offset: u64,
    descriptor: *u8,
) -> option::Option[OwnedObjc] {
    let class: *u8 = rt::get_class(#str_ptr("MPSMatrix\0"));
    if class.is_null() { return option::Option[OwnedObjc]::None; }
    let allocated: *u8 = rt::msg_id(class, rt::sel(#str_ptr("alloc\0")));
    if allocated.is_null() { return option::Option[OwnedObjc]::None; }
    let value: *u8 = qi_msg_id_id_u64_id(
        allocated,
        rt::sel(#str_ptr("initWithBuffer:offset:descriptor:\0")),
        buffer.raw(),
        offset,
        descriptor,
    );
    if value.is_null() { return option::Option[OwnedObjc]::None; }
    return option::Option[OwnedObjc]::Some(OwnedObjc::new(value));
}

fn create(
    device: metal::Device,
    left_buffer: metal::Buffer,
    left_offset: u64,
    right_buffer: metal::Buffer,
    right_offset: u64,
    output_buffer: metal::Buffer,
    output_offset: u64,
    rows: usize,
    columns: usize,
    inner: usize,
) -> option::Option[Multiplication] {
    guard let option::Option[OwnedObjc]::Some(left_descriptor) = descriptor(
        rows, inner, 2 as usize, MPS_DATA_TYPE_FLOAT16,
    ) else { return option::Option[Multiplication]::None; };
    guard let option::Option[OwnedObjc]::Some(right_descriptor) = descriptor(
        columns, inner, 2 as usize, MPS_DATA_TYPE_FLOAT16,
    ) else { return option::Option[Multiplication]::None; };
    guard let option::Option[OwnedObjc]::Some(output_descriptor) = descriptor(
        rows, columns, 4 as usize, MPS_DATA_TYPE_FLOAT32,
    ) else { return option::Option[Multiplication]::None; };
    guard let option::Option[OwnedObjc]::Some(left_matrix) = matrix(
        left_buffer, left_offset, left_descriptor.raw(),
    ) else { return option::Option[Multiplication]::None; };
    guard let option::Option[OwnedObjc]::Some(right_matrix) = matrix(
        right_buffer, right_offset, right_descriptor.raw(),
    ) else { return option::Option[Multiplication]::None; };
    guard let option::Option[OwnedObjc]::Some(output_matrix) = matrix(
        output_buffer, output_offset, output_descriptor.raw(),
    ) else { return option::Option[Multiplication]::None; };
    let class: *u8 = rt::get_class(#str_ptr("MPSMatrixMultiplication\0"));
    if class.is_null() { return option::Option[Multiplication]::None; }
    let allocated: *u8 = rt::msg_id(class, rt::sel(#str_ptr("alloc\0")));
    if allocated.is_null() { return option::Option[Multiplication]::None; }
    let kernel_pointer: *u8 = qi_msg_id_id_i8_i8_u64_u64_u64_f64_f64(
        allocated,
        rt::sel(#str_ptr("initWithDevice:transposeLeft:transposeRight:resultRows:resultColumns:interiorColumns:alpha:beta:\0")),
        device.raw(),
        0 as i8,
        1 as i8,
        rows as u64,
        columns as u64,
        inner as u64,
        1.0f64,
        0.0f64,
    );
    if kernel_pointer.is_null() { return option::Option[Multiplication]::None; }
    return option::Option[Multiplication]::Some(Multiplication {
        left_descriptor: left_descriptor,
        right_descriptor: right_descriptor,
        output_descriptor: output_descriptor,
        left_matrix: left_matrix,
        right_matrix: right_matrix,
        output_matrix: output_matrix,
        kernel: OwnedObjc::new(kernel_pointer),
    });
}

// Encodes a large row-major FP16 x FP16 -> FP32 multiplication in bounded
// row slices. MPSMatrix produced partial non-finite output for the 2048x2048
// prefill (16,384 image rows plus text) on the M1 Max. Single operations up to
// 8,192 rows are measured clean: the 1024 prefill (about 4,130 rows) and the
// 1536x1024 and 1984x1024 prefills (about 6,170 and 7,970 rows) all produce
// finite steps and correct images. Taller matrices use 4096-row slices. Weight
// rows are shared by every slice, while input/output offsets advance through
// their contiguous row-major buffers.
fn encode_row_tiled(
    device: metal::Device,
    command_buffer: metal::CommandBuffer,
    left_buffer: metal::Buffer,
    left_offset: u64,
    right_buffer: metal::Buffer,
    right_offset: u64,
    output_buffer: metal::Buffer,
    output_offset: u64,
    rows: usize,
    columns: usize,
    inner: usize,
    tile_rows: usize = 4096 as usize,
) -> bool {
    if rows == (0 as usize) || columns == (0 as usize)
        || inner == (0 as usize) || tile_rows == (0 as usize) {
        return false;
    }
    // Preserve the single operation at the measured shapes above; slicing
    // would change MPS kernel selection, and with it the 1024 output bits.
    let bounded_rows: usize = if rows <= (8192 as usize) { rows } else { tile_rows };
    var row: usize = 0 as usize;
    while row < rows {
        let remaining: usize = rows -% row;
        let count: usize = if remaining < bounded_rows { remaining } else { bounded_rows };
        guard let option::Option[Multiplication]::Some(operation) = create(
            device,
            left_buffer,
            left_offset +% (row *% inner *% (2 as usize)) as u64,
            right_buffer,
            right_offset,
            output_buffer,
            output_offset +% (row *% columns *% (4 as usize)) as u64,
            count,
            columns,
            inner,
        ) else { return false; };
        operation.encode(command_buffer);
        row = row +% count;
    }
    return true;
}

fn strided_descriptor(rows: usize, columns: usize, row_bytes: usize, data_type: u32)
    -> option::Option[OwnedObjc] {
    let class: *u8 = rt::get_class(#str_ptr("MPSMatrixDescriptor\0"));
    if class.is_null() { return option::Option[OwnedObjc]::None; }
    let value: *u8 = qi_msg_id_u64_u64_u64_u32(
        class,
        rt::sel(#str_ptr("matrixDescriptorWithRows:columns:rowBytes:dataType:\0")),
        rows as u64,
        columns as u64,
        row_bytes as u64,
        data_type,
    );
    if value.is_null() { return option::Option[OwnedObjc]::None; }
    return option::Option[OwnedObjc]::Some(OwnedObjc::new(rt::retain(value)));
}

// One FP32 operand: `rows` x `columns` elements starting at `offset`, with
// `row_bytes` between rows (a column slice of a wider matrix is allowed).
struct Fp32Operand {
    buffer: metal::Buffer,
    offset: u64,
    rows: usize,
    columns: usize,
    row_bytes: usize,
}

// FP32 C = alpha * op(A) * op(B), with optional transposes and strided
// operands. Used where FP16 inputs would lose accuracy (the VAE).
fn create_fp32(
    device: metal::Device,
    left: Fp32Operand,
    right: Fp32Operand,
    output: Fp32Operand,
    transpose_left: bool,
    transpose_right: bool,
    inner: usize,
    alpha: f64,
) -> option::Option[Multiplication] {
    guard let option::Option[OwnedObjc]::Some(left_descriptor) = strided_descriptor(
        left.rows, left.columns, left.row_bytes, MPS_DATA_TYPE_FLOAT32,
    ) else { return option::Option[Multiplication]::None; };
    guard let option::Option[OwnedObjc]::Some(right_descriptor) = strided_descriptor(
        right.rows, right.columns, right.row_bytes, MPS_DATA_TYPE_FLOAT32,
    ) else { return option::Option[Multiplication]::None; };
    guard let option::Option[OwnedObjc]::Some(output_descriptor) = strided_descriptor(
        output.rows, output.columns, output.row_bytes, MPS_DATA_TYPE_FLOAT32,
    ) else { return option::Option[Multiplication]::None; };
    guard let option::Option[OwnedObjc]::Some(left_matrix) = matrix(
        left.buffer, left.offset, left_descriptor.raw(),
    ) else { return option::Option[Multiplication]::None; };
    guard let option::Option[OwnedObjc]::Some(right_matrix) = matrix(
        right.buffer, right.offset, right_descriptor.raw(),
    ) else { return option::Option[Multiplication]::None; };
    guard let option::Option[OwnedObjc]::Some(output_matrix) = matrix(
        output.buffer, output.offset, output_descriptor.raw(),
    ) else { return option::Option[Multiplication]::None; };
    let class: *u8 = rt::get_class(#str_ptr("MPSMatrixMultiplication\0"));
    if class.is_null() { return option::Option[Multiplication]::None; }
    let allocated: *u8 = rt::msg_id(class, rt::sel(#str_ptr("alloc\0")));
    if allocated.is_null() { return option::Option[Multiplication]::None; }
    let kernel_pointer: *u8 = qi_msg_id_id_i8_i8_u64_u64_u64_f64_f64(
        allocated,
        rt::sel(#str_ptr("initWithDevice:transposeLeft:transposeRight:resultRows:resultColumns:interiorColumns:alpha:beta:\0")),
        device.raw(),
        if transpose_left { 1 as i8 } else { 0 as i8 },
        if transpose_right { 1 as i8 } else { 0 as i8 },
        output.rows as u64,
        output.columns as u64,
        inner as u64,
        alpha,
        0.0f64,
    );
    if kernel_pointer.is_null() { return option::Option[Multiplication]::None; }
    return option::Option[Multiplication]::Some(Multiplication {
        left_descriptor: left_descriptor,
        right_descriptor: right_descriptor,
        output_descriptor: output_descriptor,
        left_matrix: left_matrix,
        right_matrix: right_matrix,
        output_matrix: output_matrix,
        kernel: OwnedObjc::new(kernel_pointer),
    });
}
