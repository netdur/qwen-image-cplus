// End-to-end native assembly of Qwen-Image-2.1 reference-image conditioning.
//
// The vision features replace `<|image_pad|>` rows in the Qwen3-VL prompt.
// Separately, normalized VAE latents are concatenated in image order for the
// denoiser's image prefix. DeepStack features are layer-major across images.

import "./image_conditioning" as conditioning;
import "./image_input" as image_input;
import "./qwen3vl_text" as text_encoder;
import "./qwen3vl_vision" as vision_encoder;
import "./tokenizer" as tokenizer;
import "./vae" as vae;
import "stdlib/io" as io;
import "stdlib/math" as _;
import "stdlib/option" as option;
import "stdlib/status" as status;
import "stdlib/time" as time;
import "stdlib/vec" as vec;

const WIDTH: usize = 4096;
const LATENT_CHANNELS: usize = 64;
const DEEPSTACK_LAYERS: usize = 3;
const SYSTEM_PREFIX_TOKENS: usize = 14;
const IMAGE_PAD_TOKEN: u32 = 151655;

struct Encoded {
    prompt_embeddings: vec::Vec[f32],
    prompt_image_mask: vec::Vec[u8],
    prompt_rows: usize,
    condition_latents: vec::Vec[f32],
    condition_rows: usize,
    first_shape: conditioning::Shape,
    second_shape: conditioning::Shape,
}

fn zero_f32(count: usize) -> option::Option[vec::Vec[f32]] {
    var values: vec::Vec[f32] = vec::Vec[f32]::with_capacity(count);
    var index: usize = 0 as usize;
    while index < count {
        if values.append(0.0f32) != status::Status::Ok {
            return option::Option[vec::Vec[f32]]::None;
        }
        index = index +% (1 as usize);
    }
    return option::Option[vec::Vec[f32]]::Some(values);
}

fn zero_u32(count: usize) -> option::Option[vec::Vec[u32]] {
    var values: vec::Vec[u32] = vec::Vec[u32]::with_capacity(count);
    var index: usize = 0 as usize;
    while index < count {
        if values.append(0 as u32) != status::Status::Ok {
            return option::Option[vec::Vec[u32]]::None;
        }
        index = index +% (1 as usize);
    }
    return option::Option[vec::Vec[u32]]::Some(values);
}

fn encode_two_images_512(
    model_root: str,
    prompt: str,
    first_path: str,
    second_path: str,
) -> option::Option[Encoded] {
    if !conditioning::reference_count_supported(2 as usize) {
        return option::Option[Encoded]::None;
    }
    let started_ms: i64 = time::now_millis();
    guard let option::Option[image_input::Image]::Some(first) =
        image_input::load_resized(first_path, 512 as usize) else {
        io::eprintln("multimodal conditioning: could not load ${first_path}");
        return option::Option[Encoded]::None;
    };
    guard let option::Option[image_input::Image]::Some(second) =
        image_input::load_resized(second_path, 512 as usize) else {
        io::eprintln("multimodal conditioning: could not load ${second_path}");
        return option::Option[Encoded]::None;
    };
    let input_ms: i64 = time::now_millis() - started_ms;
    let first_shape: conditioning::Shape = first.shape;
    let second_shape: conditioning::Shape = second.shape;
    let vision_rows: usize = first_shape.vision_tokens +% second_shape.vision_tokens;
    let condition_rows: usize = first_shape.latent_tokens +% second_shape.latent_tokens;
    guard let option::Option[vec::Vec[f32]]::Some(vision) = zero_f32(
        vision_rows *% WIDTH,
    ) else { return option::Option[Encoded]::None; };
    guard let option::Option[vec::Vec[f32]]::Some(deepstack) = zero_f32(
        DEEPSTACK_LAYERS *% vision_rows *% WIDTH,
    ) else { return option::Option[Encoded]::None; };

    let first_deep_values: usize =
        DEEPSTACK_LAYERS *% first_shape.vision_tokens *% WIDTH;
    guard let option::Option[vec::Vec[f32]]::Some(first_deep) = zero_f32(
        first_deep_values,
    ) else { return option::Option[Encoded]::None; };
    if vision_encoder::encode_sized_to_host(
        model_root,
        #slice_ptr(first.vision_pixels.as_slice()),
        first_shape.width,
        first_shape.height,
        #slice_ptr(vision.as_slice()),
        #slice_ptr(first_deep.as_slice()),
    ) != (0 as i32) { return option::Option[Encoded]::None; }

    let second_vision_offset: usize = first_shape.vision_tokens *% WIDTH;
    let second_deep_values: usize =
        DEEPSTACK_LAYERS *% second_shape.vision_tokens *% WIDTH;
    guard let option::Option[vec::Vec[f32]]::Some(second_deep) = zero_f32(
        second_deep_values,
    ) else { return option::Option[Encoded]::None; };
    if vision_encoder::encode_sized_to_host(
        model_root,
        #slice_ptr(second.vision_pixels.as_slice()),
        second_shape.width,
        second_shape.height,
        #slice_ptr(vision.as_slice()) + second_vision_offset,
        #slice_ptr(second_deep.as_slice()),
    ) != (0 as i32) { return option::Option[Encoded]::None; }

    // Each per-image encoder returns [layer, local token, channel]. Repack to
    // [layer, all images' tokens, channel] for the language model.
    let deep_values: *f32 = #slice_ptr(deepstack.as_slice());
    let first_deep_values_pointer: *f32 = #slice_ptr(first_deep.as_slice());
    let second_deep_values_pointer: *f32 = #slice_ptr(second_deep.as_slice());
    var layer: usize = 0 as usize;
    while layer < DEEPSTACK_LAYERS {
        var local: usize = 0 as usize;
        while local < first_shape.vision_tokens *% WIDTH {
            deep_values[layer *% vision_rows *% WIDTH +% local] =
                first_deep_values_pointer[
                    layer *% first_shape.vision_tokens *% WIDTH +% local
                ];
            local = local +% (1 as usize);
        }
        local = 0 as usize;
        while local < second_shape.vision_tokens *% WIDTH {
            deep_values[
                layer *% vision_rows *% WIDTH +% second_vision_offset +% local
            ] = second_deep_values_pointer[
                layer *% second_shape.vision_tokens *% WIDTH +% local
            ];
            local = local +% (1 as usize);
        }
        layer = layer +% (1 as usize);
    }
    let vision_ms: i64 = time::now_millis() - started_ms - input_ms;

    var image_token_counts: [usize; 2] = [
        first_shape.vision_tokens, second_shape.vision_tokens,
    ];
    guard let option::Option[vec::Vec[u32]]::Some(tokens) =
        tokenizer::tokenize_full_prompt_with_images(
            model_root, prompt, #addr_of(image_token_counts[0]), 2 as usize,
    ) else {
        io::eprintln("multimodal conditioning: could not tokenize prompt");
        return option::Option[Encoded]::None;
    };
    guard let option::Option[vec::Vec[u32]]::Some(positions) = zero_u32(
        tokens.count() *% (3 as usize),
    ) else { return option::Option[Encoded]::None; };
    var shapes: [conditioning::Shape; 2] = [first_shape, second_shape];
    if !conditioning::fill_language_positions(
        #slice_ptr(tokens.as_slice()), tokens.count(), #addr_of(shapes[0]),
        2 as usize, #slice_ptr(positions.as_slice()),
    ) {
        io::eprintln("multimodal conditioning: could not build MRoPE positions");
        return option::Option[Encoded]::None;
    }
    let prompt_rows: usize = tokens.count() -% SYSTEM_PREFIX_TOKENS;
    guard let option::Option[vec::Vec[f32]]::Some(prompt_embeddings) = zero_f32(
        prompt_rows *% WIDTH,
    ) else { return option::Option[Encoded]::None; };
    var encoded_rows: usize = 0 as usize;
    if text_encoder::encode_multimodal_tokens_to_host(
        model_root,
        #slice_ptr(tokens.as_slice()),
        tokens.count(),
        #slice_ptr(positions.as_slice()),
        #slice_ptr(vision.as_slice()),
        vision_rows,
        #slice_ptr(deepstack.as_slice()),
        #slice_ptr(prompt_embeddings.as_slice()),
        prompt_rows *% WIDTH,
        #addr_of(encoded_rows),
    ) != (0 as i32) || encoded_rows != prompt_rows {
        io::eprintln(
            "multimodal conditioning: text rows expected=${prompt_rows} actual=${encoded_rows}",
        );
        return option::Option[Encoded]::None;
    }
    var prompt_image_mask: vec::Vec[u8] = vec::Vec[u8]::with_capacity(prompt_rows);
    let token_values: *u32 = #slice_ptr(tokens.as_slice());
    var token: usize = SYSTEM_PREFIX_TOKENS;
    while token < tokens.count() {
        if prompt_image_mask.append(
            if token_values[token] == IMAGE_PAD_TOKEN { 1 as u8 } else { 0 as u8 },
        ) != status::Status::Ok { return option::Option[Encoded]::None; }
        token = token +% (1 as usize);
    }
    let text_ms: i64 = time::now_millis() - started_ms - input_ms - vision_ms;

    guard let option::Option[vec::Vec[f32]]::Some(condition_latents) = zero_f32(
        condition_rows *% LATENT_CHANNELS,
    ) else { return option::Option[Encoded]::None; };
    if vae::encode_sized_from_host(
        model_root,
        #slice_ptr(first.vae_pixels.as_slice()),
        first_shape.width,
        first_shape.height,
        #slice_ptr(condition_latents.as_slice()),
    ) != (0 as i32) { return option::Option[Encoded]::None; }
    if vae::encode_sized_from_host(
        model_root,
        #slice_ptr(second.vae_pixels.as_slice()),
        second_shape.width,
        second_shape.height,
        #slice_ptr(condition_latents.as_slice())
            + first_shape.latent_tokens *% LATENT_CHANNELS,
    ) != (0 as i32) { return option::Option[Encoded]::None; }
    let vae_ms: i64 = time::now_millis() - started_ms - input_ms - vision_ms - text_ms;

    io::println(
        "multi-image conditioning: images=2 output_resolution=512 vision_rows=${vision_rows} prompt_rows=${prompt_rows} condition_rows=${condition_rows} input_ms=${input_ms} vision_ms=${vision_ms} text_ms=${text_ms} vae_ms=${vae_ms} total_wall_ms=${time::now_millis() - started_ms}",
    );
    return option::Option[Encoded]::Some(Encoded {
        prompt_embeddings: prompt_embeddings,
        prompt_image_mask: prompt_image_mask,
        prompt_rows: prompt_rows,
        condition_latents: condition_latents,
        condition_rows: condition_rows,
        first_shape: first_shape,
        second_shape: second_shape,
    });
}

fn finite_nonzero(values: *f32, count: usize) -> bool {
    var absolute_sum: f64 = 0.0f64;
    var index: usize = 0 as usize;
    while index < count {
        let value: f32 = values[index];
        let bits: u32 = #bitcast::[u32](value);
        if (bits & (0x7F800000 as u32)) == (0x7F800000 as u32) {
            return false;
        }
        absolute_sum = absolute_sum + (value as f64).abs();
        index = index +% (1 as usize);
    }
    return absolute_sum > 0.000001f64;
}

fn run_two_image_512(
    model_root: str,
    first_path: str,
    second_path: str,
    prompt: str = "Use Picture 1 and Picture 2 to create a coherent new scene.",
) -> i32 {
    guard let option::Option[Encoded]::Some(encoded) = encode_two_images_512(
        model_root, prompt, first_path, second_path,
    ) else {
        return 1;
    };
    var mask_count: usize = 0 as usize;
    let mask_values: *u8 = #slice_ptr(encoded.prompt_image_mask.as_slice());
    var row: usize = 0 as usize;
    while row < encoded.prompt_image_mask.count() {
        if mask_values[row] != (0 as u8) {
            mask_count = mask_count +% (1 as usize);
        }
        row = row +% (1 as usize);
    }
    let expected_vision_rows: usize =
        encoded.first_shape.vision_tokens +% encoded.second_shape.vision_tokens;
    let shape_rows: usize =
        encoded.first_shape.latent_tokens +% encoded.second_shape.latent_tokens;
    let prompt_ok: bool = finite_nonzero(
        #slice_ptr(encoded.prompt_embeddings.as_slice()),
        encoded.prompt_rows *% WIDTH,
    );
    let latent_ok: bool = finite_nonzero(
        #slice_ptr(encoded.condition_latents.as_slice()),
        encoded.condition_rows *% LATENT_CHANNELS,
    );
    if mask_count != expected_vision_rows || encoded.condition_rows != shape_rows
        || !prompt_ok || !latent_ok {
        io::eprintln(
            "multi-image conditioning: mask=${mask_count}/${expected_vision_rows} latents=${encoded.condition_rows}/${shape_rows} prompt_finite=${prompt_ok} latent_finite=${latent_ok}",
        );
        return 1;
    }
    io::println(
        "Qwen-Image-2.1 two-image 512 conditioning: verified prompt_rows=${encoded.prompt_rows} vision_rows=${expected_vision_rows} condition_rows=${encoded.condition_rows}",
    );
    return 0;
}
