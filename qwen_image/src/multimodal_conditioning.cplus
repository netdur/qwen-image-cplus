// End-to-end native assembly of Qwen-Image-2.1 reference-image conditioning.
//
// The vision features replace `<|image_pad|>` rows in the Qwen3-VL prompt.
// Separately, normalized VAE latents are concatenated in image order for the
// denoiser's image prefix. DeepStack features are layer-major across images.

import "./image_conditioning" as conditioning;
import "./image_input" as image_input;
import "./image_output" as image_output;
import "./qwen3vl_text" as text_encoder;
import "./qwen3vl_vision" as vision_encoder;
import "./tokenizer" as tokenizer;
import "./transformer_block" as transformer;
import "./vae" as vae;
import "stdlib/io" as io;
import "stdlib/math" as _;
import "stdlib/option" as option;
import "stdlib/status" as status;
import "stdlib/text" as text;
import "stdlib/time" as time;
import "stdlib/vec" as vec;

const WIDTH: usize = 4096;
const LATENT_CHANNELS: usize = 64;
const DEEPSTACK_LAYERS: usize = 3;
const SYSTEM_PREFIX_TOKENS: usize = 14;
const IMAGE_PAD_TOKEN: u32 = 151655;

struct Encoded {
    prompt_embeddings: vec::Vec[f32],
    prompt_image_mask: vec::Vec[u8],
    prompt_rows: usize,
    condition_latents: vec::Vec[f32],
    condition_rows: usize,
    shapes: vec::Vec[conditioning::Shape],
}

fn zero_f32(count: usize) -> option::Option[vec::Vec[f32]] {
    var values: vec::Vec[f32] = vec::Vec[f32]::with_capacity(count);
    var index: usize = 0 as usize;
    while index < count {
        if values.append(0.0f32) != status::Status::Ok {
            return option::Option[vec::Vec[f32]]::None;
        }
        index = index +% (1 as usize);
    }
    return option::Option[vec::Vec[f32]]::Some(values);
}

fn zero_u32(count: usize) -> option::Option[vec::Vec[u32]] {
    var values: vec::Vec[u32] = vec::Vec[u32]::with_capacity(count);
    var index: usize = 0 as usize;
    while index < count {
        if values.append(0 as u32) != status::Status::Ok {
            return option::Option[vec::Vec[u32]]::None;
        }
        index = index +% (1 as usize);
    }
    return option::Option[vec::Vec[u32]]::Some(values);
}

fn encode_images_512(
    model_root: str,
    prompt: str,
    image_paths: *str,
    image_count: usize,
) -> option::Option[Encoded] {
    if !conditioning::reference_count_supported(image_count) {
        io::eprintln("multimodal conditioning: reference image count must be 1 through 10");
        return option::Option[Encoded]::None;
    }
    let started_ms: i64 = time::now_millis();
    var input_ms: i64 = 0 as i64;
    var vision_ms: i64 = 0 as i64;
    var vae_ms: i64 = 0 as i64;
    var shapes: vec::Vec[conditioning::Shape] =
        vec::Vec[conditioning::Shape]::with_capacity(image_count);
    var image_token_counts: vec::Vec[usize] = vec::Vec[usize]::with_capacity(image_count);
    var vision_rows: usize = 0 as usize;
    var condition_rows: usize = 0 as usize;

    // Discover every resized shape before allocating the combined outputs.
    // Image input is intentionally reloaded for the encoder pass below. The
    // extra native decode is milliseconds and avoids retaining up to ten RGBA
    // and RGB float images simultaneously.
    var image_index: usize = 0 as usize;
    while image_index < image_count {
        let input_start_ms: i64 = time::now_millis();
        guard let option::Option[image_input::Image]::Some(image) =
            image_input::load_resized(image_paths[image_index], 512 as usize) else {
            io::eprintln(
                "multimodal conditioning: could not load ${image_paths[image_index]}",
            );
            return option::Option[Encoded]::None;
        };
        input_ms = input_ms + (time::now_millis() - input_start_ms);
        let shape: conditioning::Shape = image.shape;
        if shapes.append(shape) != status::Status::Ok
            || image_token_counts.append(shape.vision_tokens) != status::Status::Ok {
            return option::Option[Encoded]::None;
        }
        vision_rows = vision_rows +% shape.vision_tokens;
        condition_rows = condition_rows +% shape.latent_tokens;
        image_index = image_index +% (1 as usize);
    }

    guard let option::Option[vec::Vec[f32]]::Some(vision) = zero_f32(
        vision_rows *% WIDTH,
    ) else { return option::Option[Encoded]::None; };
    guard let option::Option[vec::Vec[f32]]::Some(deepstack) = zero_f32(
        DEEPSTACK_LAYERS *% vision_rows *% WIDTH,
    ) else { return option::Option[Encoded]::None; };
    guard let option::Option[vec::Vec[f32]]::Some(condition_latents) = zero_f32(
        condition_rows *% LATENT_CHANNELS,
    ) else { return option::Option[Encoded]::None; };

    let shape_values: *conditioning::Shape = #slice_ptr(shapes.as_slice());
    let vision_values: *f32 = #slice_ptr(vision.as_slice());
    let deep_values: *f32 = #slice_ptr(deepstack.as_slice());
    let latent_values: *f32 = #slice_ptr(condition_latents.as_slice());
    var vision_row_offset: usize = 0 as usize;
    var latent_row_offset: usize = 0 as usize;
    image_index = 0 as usize;
    while image_index < image_count {
        let shape: conditioning::Shape = shape_values[image_index];
        let input_start_ms: i64 = time::now_millis();
        guard let option::Option[image_input::Image]::Some(image) =
            image_input::load_resized(image_paths[image_index], 512 as usize) else {
            io::eprintln(
                "multimodal conditioning: could not reload ${image_paths[image_index]}",
            );
            return option::Option[Encoded]::None;
        };
        input_ms = input_ms + (time::now_millis() - input_start_ms);

        let local_deep_values: usize =
            DEEPSTACK_LAYERS *% shape.vision_tokens *% WIDTH;
        guard let option::Option[vec::Vec[f32]]::Some(local_deep) = zero_f32(
            local_deep_values,
        ) else { return option::Option[Encoded]::None; };
        let vision_start_ms: i64 = time::now_millis();
        if vision_encoder::encode_sized_to_host(
            model_root,
            #slice_ptr(image.vision_pixels.as_slice()),
            shape.width,
            shape.height,
            vision_values + vision_row_offset *% WIDTH,
            #slice_ptr(local_deep.as_slice()),
        ) != (0 as i32) { return option::Option[Encoded]::None; }
        vision_ms = vision_ms + (time::now_millis() - vision_start_ms);

        // Each image returns [layer, local token, channel]. Repack it into
        // [layer, all images' tokens, channel] for the language model.
        let local_deep_pointer: *f32 = #slice_ptr(local_deep.as_slice());
        var layer: usize = 0 as usize;
        while layer < DEEPSTACK_LAYERS {
            var local: usize = 0 as usize;
            while local < shape.vision_tokens *% WIDTH {
                deep_values[
                    layer *% vision_rows *% WIDTH
                        +% vision_row_offset *% WIDTH +% local
                ] = local_deep_pointer[
                    layer *% shape.vision_tokens *% WIDTH +% local
                ];
                local = local +% (1 as usize);
            }
            layer = layer +% (1 as usize);
        }

        let vae_start_ms: i64 = time::now_millis();
        if vae::encode_sized_from_host(
            model_root,
            #slice_ptr(image.vae_pixels.as_slice()),
            shape.width,
            shape.height,
            latent_values + latent_row_offset *% LATENT_CHANNELS,
        ) != (0 as i32) { return option::Option[Encoded]::None; }
        vae_ms = vae_ms + (time::now_millis() - vae_start_ms);
        vision_row_offset = vision_row_offset +% shape.vision_tokens;
        latent_row_offset = latent_row_offset +% shape.latent_tokens;
        image_index = image_index +% (1 as usize);
    }

    let text_start_ms: i64 = time::now_millis();
    guard let option::Option[vec::Vec[u32]]::Some(tokens) =
        tokenizer::tokenize_full_prompt_with_images(
            model_root, prompt, #slice_ptr(image_token_counts.as_slice()), image_count,
    ) else {
        io::eprintln("multimodal conditioning: could not tokenize prompt");
        return option::Option[Encoded]::None;
    };
    guard let option::Option[vec::Vec[u32]]::Some(positions) = zero_u32(
        tokens.count() *% (3 as usize),
    ) else { return option::Option[Encoded]::None; };
    if !conditioning::fill_language_positions(
        #slice_ptr(tokens.as_slice()), tokens.count(), shape_values,
        image_count, #slice_ptr(positions.as_slice()),
    ) {
        io::eprintln("multimodal conditioning: could not build MRoPE positions");
        return option::Option[Encoded]::None;
    }
    let prompt_rows: usize = tokens.count() -% SYSTEM_PREFIX_TOKENS;
    guard let option::Option[vec::Vec[f32]]::Some(prompt_embeddings) = zero_f32(
        prompt_rows *% WIDTH,
    ) else { return option::Option[Encoded]::None; };
    var encoded_rows: usize = 0 as usize;
    if text_encoder::encode_multimodal_tokens_to_host(
        model_root,
        #slice_ptr(tokens.as_slice()),
        tokens.count(),
        #slice_ptr(positions.as_slice()),
        vision_values,
        vision_rows,
        deep_values,
        #slice_ptr(prompt_embeddings.as_slice()),
        prompt_rows *% WIDTH,
        #addr_of(encoded_rows),
    ) != (0 as i32) || encoded_rows != prompt_rows {
        io::eprintln(
            "multimodal conditioning: text rows expected=${prompt_rows} actual=${encoded_rows}",
        );
        return option::Option[Encoded]::None;
    }
    var prompt_image_mask: vec::Vec[u8] = vec::Vec[u8]::with_capacity(prompt_rows);
    let token_values: *u32 = #slice_ptr(tokens.as_slice());
    var token: usize = SYSTEM_PREFIX_TOKENS;
    while token < tokens.count() {
        if prompt_image_mask.append(
            if token_values[token] == IMAGE_PAD_TOKEN { 1 as u8 } else { 0 as u8 },
        ) != status::Status::Ok { return option::Option[Encoded]::None; }
        token = token +% (1 as usize);
    }
    let text_ms: i64 = time::now_millis() - text_start_ms;

    io::println(
        "multi-image conditioning: images=${image_count} output_resolution=512 vision_rows=${vision_rows} prompt_rows=${prompt_rows} condition_rows=${condition_rows} input_ms=${input_ms} vision_ms=${vision_ms} text_ms=${text_ms} vae_ms=${vae_ms} total_wall_ms=${time::now_millis() - started_ms}",
    );
    return option::Option[Encoded]::Some(Encoded {
        prompt_embeddings: prompt_embeddings,
        prompt_image_mask: prompt_image_mask,
        prompt_rows: prompt_rows,
        condition_latents: condition_latents,
        condition_rows: condition_rows,
        shapes: shapes,
    });
}

fn encode_two_images_512(
    model_root: str,
    prompt: str,
    first_path: str,
    second_path: str,
) -> option::Option[Encoded] {
    var image_paths: [str; 2] = [first_path, second_path];
    return encode_images_512(model_root, prompt, #addr_of(image_paths[0]), 2 as usize);
}

fn finite_nonzero(values: *f32, count: usize) -> bool {
    var absolute_sum: f64 = 0.0f64;
    var index: usize = 0 as usize;
    while index < count {
        let value: f32 = values[index];
        let bits: u32 = #bitcast::[u32](value);
        if (bits & (0x7F800000 as u32)) == (0x7F800000 as u32) {
            return false;
        }
        absolute_sum = absolute_sum + (value as f64).abs();
        index = index +% (1 as usize);
    }
    return absolute_sum > 0.000001f64;
}

fn run_two_image_512(
    model_root: str,
    first_path: str,
    second_path: str,
    prompt: str = "Use Picture 1 and Picture 2 to create a coherent new scene.",
) -> i32 {
    guard let option::Option[Encoded]::Some(encoded) = encode_two_images_512(
        model_root, prompt, first_path, second_path,
    ) else {
        return 1;
    };
    var mask_count: usize = 0 as usize;
    let mask_values: *u8 = #slice_ptr(encoded.prompt_image_mask.as_slice());
    var row: usize = 0 as usize;
    while row < encoded.prompt_image_mask.count() {
        if mask_values[row] != (0 as u8) {
            mask_count = mask_count +% (1 as usize);
        }
        row = row +% (1 as usize);
    }
    let shape_values: *conditioning::Shape = #slice_ptr(encoded.shapes.as_slice());
    let expected_vision_rows: usize =
        shape_values[0].vision_tokens +% shape_values[1].vision_tokens;
    let shape_rows: usize =
        shape_values[0].latent_tokens +% shape_values[1].latent_tokens;
    let prompt_ok: bool = finite_nonzero(
        #slice_ptr(encoded.prompt_embeddings.as_slice()),
        encoded.prompt_rows *% WIDTH,
    );
    let latent_ok: bool = finite_nonzero(
        #slice_ptr(encoded.condition_latents.as_slice()),
        encoded.condition_rows *% LATENT_CHANNELS,
    );
    if mask_count != expected_vision_rows || encoded.condition_rows != shape_rows
        || !prompt_ok || !latent_ok {
        io::eprintln(
            "multi-image conditioning: mask=${mask_count}/${expected_vision_rows} latents=${encoded.condition_rows}/${shape_rows} prompt_finite=${prompt_ok} latent_finite=${latent_ok}",
        );
        return 1;
    }
    io::println(
        "Qwen-Image-2.1 two-image 512 conditioning: verified prompt_rows=${encoded.prompt_rows} vision_rows=${expected_vision_rows} condition_rows=${encoded.condition_rows}",
    );
    return 0;
}

// Full native handoff through a short 512x512 transformer smoke or the complete
// 40-step trajectory. Two steps prove that target-only decoding can reuse the
// interleaved prefix K/V cache; an output path also performs native VAE decode
// and PNG output.
fn run_multi_image_transformer_512(
    packed_path: str,
    model_root: str,
    image_paths: *str,
    image_count: usize,
    prompt: str = "Use Picture 1 and Picture 2 to create a coherent new scene.",
    requested_steps: str = "1",
    output_path: str = "",
    seed: u64 = 1301 as u64,
) -> i32 {
    if !(requested_steps == "1" || requested_steps == "2" || requested_steps == "40") {
        io::eprintln("multi-image transformer: steps must be 1, 2, or 40");
        return 2;
    }
    let started_ms: i64 = time::now_millis();
    guard let option::Option[Encoded]::Some(encoded) = encode_images_512(
        model_root, prompt, image_paths, image_count,
    ) else { return 1; };
    var shapes: vec::Vec[transformer::LatentShape] =
        vec::Vec[transformer::LatentShape]::with_capacity(image_count);
    let condition_shapes: *conditioning::Shape = #slice_ptr(encoded.shapes.as_slice());
    var shape_index: usize = 0 as usize;
    while shape_index < image_count {
        if shapes.append(transformer::LatentShape {
            height: condition_shapes[shape_index].height / (16 as usize),
            width: condition_shapes[shape_index].width / (16 as usize),
        }) != status::Status::Ok { return 1; }
        shape_index = shape_index +% (1 as usize);
    }
    let target_rows: usize = (512 as usize) / (16 as usize)
        *% ((512 as usize) / (16 as usize));
    guard let option::Option[vec::Vec[f32]]::Some(target) = zero_f32(
        target_rows *% LATENT_CHANNELS,
    ) else { return 1; };
    let transformer_start_ms: i64 = time::now_millis();
    let result: i32 = transformer::run_conditioned_trajectory_sized_to_host(
        packed_path,
        #slice_ptr(encoded.prompt_embeddings.as_slice()),
        encoded.prompt_rows,
        #slice_ptr(encoded.prompt_image_mask.as_slice()),
        #slice_ptr(encoded.condition_latents.as_slice()),
        encoded.condition_rows,
        #slice_ptr(shapes.as_slice()),
        image_count,
        seed,
        #slice_ptr(target.as_slice()),
        512 as usize,
        512 as usize,
        requested_steps,
    );
    let transformer_ms: i64 = time::now_millis() - transformer_start_ms;
    if result != (0 as i32) || !finite_nonzero(
        #slice_ptr(target.as_slice()), target_rows *% LATENT_CHANNELS,
    ) {
        io::eprintln("multi-image transformer: trajectory target is invalid");
        return 1;
    }
    if output_path.count() > (0 as usize) {
        guard let option::Option[vec::Vec[f32]]::Some(decoded) = zero_f32(
            (512 as usize) *% (512 as usize) *% (4 as usize),
        ) else { return 1; };
        let vae_start_ms: i64 = time::now_millis();
        if vae::decode_sized_from_host(
            model_root,
            #slice_ptr(target.as_slice()),
            #slice_ptr(decoded.as_slice()),
            32 as usize,
            32 as usize,
        ) != (0 as i32) {
            return 1;
        }
        let vae_ms: i64 = time::now_millis() - vae_start_ms;
        let output_start_ms: i64 = time::now_millis();
        if !image_output::write_png_sized(
            #slice_ptr(decoded.as_slice()), output_path, 512 as usize, 512 as usize,
        ) {
            return 1;
        }
        io::println(
            "Qwen-Image-2.1 multi-image generation: images=${image_count} output=${output_path} pixels=512x512 steps=${requested_steps} seed=${seed} transformer_ms=${transformer_ms} vae_ms=${vae_ms} image_output_ms=${time::now_millis() - output_start_ms} total_wall_ms=${time::now_millis() - started_ms}",
        );
        return 0;
    }
    io::println(
        "Qwen-Image-2.1 multi-image transformer: verified images=${image_count} output=512x512 steps=${requested_steps} prompt_rows=${encoded.prompt_rows} condition_rows=${encoded.condition_rows} transformer_wall_ms=${transformer_ms} total_wall_ms=${time::now_millis() - started_ms}",
    );
    return 0;
}

fn run_two_image_transformer_512(
    packed_path: str,
    model_root: str,
    first_path: str,
    second_path: str,
    prompt: str = "Use Picture 1 and Picture 2 to create a coherent new scene.",
    requested_steps: str = "1",
    output_path: str = "",
    seed: u64 = 1301 as u64,
) -> i32 {
    var image_paths: [str; 2] = [first_path, second_path];
    return run_multi_image_transformer_512(
        packed_path,
        model_root,
        #addr_of(image_paths[0]),
        2 as usize,
        prompt,
        requested_steps,
        output_path,
        seed,
    );
}
