fn test_native_256(
    packed_path: str,
    model_root: str,
    output_path: str,
) -> i32 {
    return run_native_impl(
        packed_path,
        model_root,
        output_path,
        "A red fox asleep beside a mossy stone in soft morning light.",
        1101 as u64,
        256 as usize,
        true,
        false,
        false,
        false,
        0.0f64,
    );
}

#[test]
fn vertical_slice_shapes_match_handoff_contract() {
    assert LATENT_VALUES == (16384 as usize);
    assert DECODED_VALUES == (262144 as usize);
    assert LATENT_VALUES_1024 == (262144 as usize);
    assert DECODED_VALUES_1024 == (4194304 as usize);
}
