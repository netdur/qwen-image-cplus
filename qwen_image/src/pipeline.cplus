import "./image_output" as image_output;
import "./mmap_macos" as mapped;
import "./qwen3vl_text" as qwen3vl_text;
import "./tokenizer" as tokenizer;
import "./transformer_block" as transformer;
import "./vae" as vae;
import "stdlib/io" as io;
import "stdlib/option" as option;
import "stdlib/text" as text;
import "stdlib/time" as time;
import "stdlib/vec" as vec;

const LATENT_VALUES: usize = 16 * 16 * 64;
const DECODED_VALUES: usize = 256 * 256 * 4;
const LATENT_VALUES_1024: usize = 64 * 64 * 64;
const DECODED_VALUES_1024: usize = 1024 * 1024 * 4;
const TEXT_WIDTH: usize = 4096;
const SYSTEM_PREFIX_TOKENS: usize = 14;

fn normalized_rms_fixture(actual: *f32, path: str, count: usize) -> option::Option[f64] {
    guard let mapped::MapResult::Ok(expected) = mapped::map_readonly(path) else {
        return option::Option[f64]::None;
    };
    if expected.length() != count *% #size_of::[f32]() {
        return option::Option[f64]::None;
    }
    let expected_values: *f32 = expected.pointer() as *f32;
    var squared_error: f64 = 0.0f64;
    var squared_reference: f64 = 0.0f64;
    var index: usize = 0 as usize;
    while index < count {
        let difference: f64 = actual[index] as f64 - expected_values[index] as f64;
        squared_error = squared_error + difference * difference;
        squared_reference = squared_reference
            + expected_values[index] as f64 * expected_values[index] as f64;
        index = index +% (1 as usize);
    }
    return option::Option[f64]::Some(
        (squared_error / squared_reference.max(0.000000000001f64)).sqrt(),
    );
}

fn run_fixture_256(
    packed_path: str,
    model_root: str,
    output_path: str,
    trajectory_fixture: str = "tests/fixtures/trajectory_256_fp32",
    vae_fixture_root: str = "tests/fixtures/vae_decoder_fp32",
) -> i32 {
    let vae_fixture = "${vae_fixture_root}/trajectory_256";
    if !image_output::validate_reference_postprocess(vae_fixture.view()) {
        return 1;
    }

    var latent: [f32; 16384] = [0.0f32; 16384];
    io::println("pipeline: phase=transformer-scheduler weights=${packed_path}");
    if transformer::run_trajectory_256_to_host(
        packed_path,
        #addr_of(latent[0]),
        trajectory_fixture,
    ) != (0 as i32) {
        return 1;
    }

    var decoded: [f32; 262144] = [0.0f32; 262144];
    io::println("pipeline: phase=vae model=${model_root}");
    if vae::decode_trajectory_256_from_host(
        model_root,
        #addr_of(latent[0]),
        #addr_of(decoded[0]),
        vae_fixture_root,
    ) != (0 as i32) {
        return 1;
    }

    if !image_output::write_png_and_compare(
        #addr_of(decoded[0]),
        vae_fixture.view(),
        output_path,
        0.008f64,
    ) {
        return 1;
    }
    io::println("Qwen-Image-2.1 fixture-driven 256px pipeline: verified");
    return 0;
}

fn cache_dit_threshold_is_supported(threshold: f64) -> bool {
    return threshold == 0.12f64 || threshold == 0.14f64
        || threshold == 0.16f64 || threshold == 0.24f64;
}

fn run_fixture_cache_dit_256(
    packed_path: str,
    model_root: str,
    output_path: str,
    threshold: f64,
    trajectory_fixture: str = "tests/fixtures/trajectory_256_fp32",
    vae_fixture_root: str = "tests/fixtures/vae_decoder_fp32",
) -> i32 {
    if !cache_dit_threshold_is_supported(threshold) {
        io::eprintln("pipeline Cache-DiT: unsupported threshold");
        return 2;
    }
    let vae_fixture = "${vae_fixture_root}/trajectory_256";
    if !image_output::validate_reference_postprocess(vae_fixture.view()) {
        return 1;
    }

    var latent: [f32; 16384] = [0.0f32; 16384];
    io::println("pipeline: phase=transformer-scheduler cache_dit=${threshold}");
    if transformer::run_trajectory_cache_dit_256_to_host(
        packed_path,
        #addr_of(latent[0]),
        threshold,
        trajectory_fixture,
    ) != (0 as i32) {
        return 1;
    }

    var decoded: [f32; 262144] = [0.0f32; 262144];
    io::println("pipeline: phase=vae model=${model_root}");
    if vae::decode_256_from_host(
        model_root,
        #addr_of(latent[0]),
        #addr_of(decoded[0]),
    ) != (0 as i32) {
        return 1;
    }
    let decoded_path = "${vae_fixture}/output.f32";
    guard let option::Option[f64]::Some(decoded_error) = normalized_rms_fixture(
        #addr_of(decoded[0]), decoded_path.view(), DECODED_VALUES,
    ) else { return 1; };
    io::println("pipeline Cache-DiT: threshold=${threshold} decoded_fp32_nRMSE=${decoded_error} validation=measured-only");

    if !image_output::write_png_and_compare(
        #addr_of(decoded[0]),
        vae_fixture.view(),
        output_path,
        1.0f64,
    ) {
        return 1;
    }
    io::println("Qwen-Image-2.1 fixture-driven Cache-DiT pipeline: complete; quality requires visual acceptance");
    return 0;
}

// Executes the native 1024px/40-step transformer from the official fixture's
// exact text embedding and seed, then decodes the resulting latent. This is a
// measured diagnostic: it reports both latent and decoded-output drift and
// always retains the native PNG for visual review instead of hiding a useful
// artifact behind an arbitrary image-similarity threshold.
fn run_fixture_1024(
    packed_path: str,
    model_root: str,
    output_path: str,
    trajectory_fixture: str,
    vae_fixture_root: str,
) -> i32 {
    return run_fixture_1024_impl(
        packed_path, model_root, output_path, trajectory_fixture,
        vae_fixture_root, false, 0.0f64,
    );
}

fn run_fixture_cache_dit_1024(
    packed_path: str,
    model_root: str,
    output_path: str,
    threshold: f64,
    trajectory_fixture: str,
    vae_fixture_root: str,
) -> i32 {
    if !cache_dit_threshold_is_supported(threshold) {
        io::eprintln("pipeline 1024 oracle Cache-DiT: unsupported threshold");
        return 2;
    }
    return run_fixture_1024_impl(
        packed_path, model_root, output_path, trajectory_fixture,
        vae_fixture_root, true, threshold,
    );
}

fn run_fixture_1024_impl(
    packed_path: str,
    model_root: str,
    output_path: str,
    trajectory_fixture: str,
    vae_fixture_root: str,
    cache_dit: bool,
    cache_dit_threshold: f64,
) -> i32 {
    let text_path: text::Text = "${trajectory_fixture}/text_input.f32";
    guard let mapped::MapResult::Ok(text_mapping) = mapped::map_readonly(text_path.view()) else {
        io::eprintln("pipeline 1024 oracle: could not map ${text_path}");
        return 1;
    };
    let text_row_bytes: usize = TEXT_WIDTH *% #size_of::[f32]();
    if text_mapping.length() == (0 as usize)
        || text_mapping.length() % text_row_bytes != (0 as usize) {
        io::eprintln("pipeline 1024 oracle: invalid text fixture byte count");
        return 1;
    }
    let text_rows: usize = text_mapping.length() / text_row_bytes;
    if text_rows != (31 as usize) {
        io::eprintln("pipeline 1024 oracle: expected the pinned 31-row CASABLANCA fixture, got ${text_rows}");
        return 1;
    }
    var latent: vec::Vec[f32] = vec::Vec[f32]::with_capacity(LATENT_VALUES_1024);
    var index: usize = 0 as usize;
    while index < LATENT_VALUES_1024 {
        latent.append(0.0f32);
        index = index +% (1 as usize);
    }

    let total_start_ms: i64 = time::now_millis();
    let transformer_start_ms: i64 = time::now_millis();
    let transformer_status: i32 = if cache_dit {
        transformer::run_prompt_trajectory_cache_dit_1024_to_host(
            packed_path,
            text_mapping.pointer() as *f32,
            text_rows,
            1301 as u64,
            #slice_ptr(latent.as_slice()),
            cache_dit_threshold,
            "40",
        )
    } else {
        transformer::run_prompt_trajectory_1024_to_host(
            packed_path,
            text_mapping.pointer() as *f32,
            text_rows,
            1301 as u64,
            #slice_ptr(latent.as_slice()),
            "40",
        )
    };
    if transformer_status != (0 as i32) {
        return 1;
    }
    let transformer_wall_ms: i64 = time::now_millis() - transformer_start_ms;
    let expected_latent_path: text::Text = "${trajectory_fixture}/latent_step_40.f32";
    guard let option::Option[f64]::Some(latent_error) = normalized_rms_fixture(
        #slice_ptr(latent.as_slice()), expected_latent_path.view(), LATENT_VALUES_1024,
    ) else { return 1; };

    var decoded: vec::Vec[f32] = vec::Vec[f32]::with_capacity(DECODED_VALUES_1024);
    index = 0 as usize;
    while index < DECODED_VALUES_1024 {
        decoded.append(0.0f32);
        index = index +% (1 as usize);
    }
    let vae_start_ms: i64 = time::now_millis();
    if vae::decode_1024_from_host(
        model_root,
        #slice_ptr(latent.as_slice()),
        #slice_ptr(decoded.as_slice()),
    ) != (0 as i32) {
        return 1;
    }
    let vae_wall_ms: i64 = time::now_millis() - vae_start_ms;
    let decoded_path: text::Text = "${vae_fixture_root}/trajectory_1024/output.f32";
    guard let option::Option[f64]::Some(decoded_error) = normalized_rms_fixture(
        #slice_ptr(decoded.as_slice()), decoded_path.view(), DECODED_VALUES_1024,
    ) else { return 1; };
    let image_start_ms: i64 = time::now_millis();
    if !image_output::write_png_sized(
        #slice_ptr(decoded.as_slice()), output_path, 1024 as usize, 1024 as usize,
    ) {
        return 1;
    }
    io::println(
        "pipeline 1024 oracle: cache_dit=${cache_dit} threshold=${cache_dit_threshold} latent_nRMSE=${latent_error} decoded_nRMSE=${decoded_error} transformer_wall_ms=${transformer_wall_ms} vae_wall_ms=${vae_wall_ms} image_output_wall_ms=${time::now_millis() - image_start_ms} total_wall_ms=${time::now_millis() - total_start_ms} validation=measured-only",
    );
    return 0;
}

fn run_native_impl(
    packed_path: str,
    model_root: str,
    output_path: str,
    prompt: str,
    seed: u64,
    pixels: usize,
    validate_reference: bool,
    cache_dit: bool,
    taylorseer: bool,
    bottleneck: bool,
    cache_dit_threshold: f64,
    steps: str = "40",
    q4_eager_expand: bool = false,
    q4_direct_packed: bool = false,
    output_width: usize = 0 as usize,
    output_height: usize = 0 as usize,
) -> i32 {
    let pipeline_wall_start_ms: i64 = time::now_millis();
    guard let option::Option[vec::Vec[u32]]::Some(full_tokens) =
        tokenizer::tokenize_full_prompt(model_root, prompt) else {
        return 1;
    };
    return run_native_tokens_impl(
        packed_path,
        model_root,
        output_path,
        full_tokens,
        seed,
        pixels,
        validate_reference,
        cache_dit,
        taylorseer,
        bottleneck,
        cache_dit_threshold,
        steps,
        pipeline_wall_start_ms,
        pipeline_wall_start_ms,
        q4_eager_expand,
        q4_direct_packed,
        output_width,
        output_height,
    );
}

fn run_native_tokens_impl(
    packed_path: str,
    model_root: str,
    output_path: str,
    full_tokens: vec::Vec[u32],
    seed: u64,
    pixels: usize,
    validate_reference: bool,
    cache_dit: bool,
    taylorseer: bool,
    bottleneck: bool,
    cache_dit_threshold: f64,
    steps: str,
    pipeline_wall_start_ms: i64,
    text_wall_start_ms: i64,
    q4_eager_expand: bool = false,
    q4_direct_packed: bool = false,
    output_width: usize = 0 as usize,
    output_height: usize = 0 as usize,
) -> i32 {
    let image_width: usize = if output_width == (0 as usize) { pixels } else { output_width };
    let image_height: usize = if output_height == (0 as usize) { pixels } else { output_height };
    if image_width < (256 as usize) || image_height < (256 as usize)
        || image_width % (32 as usize) != (0 as usize)
        || image_height % (32 as usize) != (0 as usize)
        || (image_width / (16 as usize)) *% (image_height / (16 as usize)) > (16384 as usize) {
        io::eprintln("pipeline: width and height must be at least 256, divisible by 32, and no more than 16384 latent tokens total");
        return 2;
    }
    if validate_reference && !(image_width == (256 as usize) && image_height == (256 as usize)) {
        io::eprintln("pipeline: native reference validation is available only at 256px");
        return 2;
    }
    if (cache_dit || taylorseer || bottleneck)
        && !((image_width == (256 as usize) && image_height == (256 as usize))
            || (image_width == (1024 as usize) && image_height == (1024 as usize))) {
        io::eprintln("pipeline: cache and bottleneck modes are calibrated only for 256x256 or 1024x1024");
        return 2;
    }
    let vae_fixture: str = "tests/fixtures/vae_decoder_fp32/trajectory_256";
    if validate_reference && !image_output::validate_reference_postprocess(vae_fixture) {
        return 1;
    }
    if full_tokens.count() <= SYSTEM_PREFIX_TOKENS || full_tokens.count() > (512 as usize) {
        io::eprintln("pipeline: unsupported full prompt token count ${full_tokens.count()}");
        return 2;
    }
    let expected_text_rows: usize = full_tokens.count() -% SYSTEM_PREFIX_TOKENS;
    let text_capacity: usize = expected_text_rows *% TEXT_WIDTH;
    var text_embeddings: vec::Vec[f32] = vec::Vec[f32]::with_capacity(text_capacity);
    var value_index: usize = 0 as usize;
    while value_index < text_capacity {
        text_embeddings.append(0.0f32);
        value_index = value_index +% (1 as usize);
    }
    var text_rows: usize = 0 as usize;
    io::println("pipeline: phase=text prompt_tokens=${expected_text_rows}");
    if qwen3vl_text::encode_tokens_to_host(
        model_root,
        #slice_ptr(full_tokens.as_slice()),
        full_tokens.count(),
        #slice_ptr(text_embeddings.as_slice()),
        text_capacity,
        #addr_of(text_rows),
    ) != (0 as i32) {
        return 1;
    }
    if text_rows != expected_text_rows {
        io::eprintln("pipeline: tokenizer/text row disagreement expected=${expected_text_rows} actual=${text_rows}");
        return 1;
    }
    io::println("pipeline timing: text_wall_ms=${time::now_millis() - text_wall_start_ms}");

    let latent_width: usize = image_width / (16 as usize);
    let latent_height: usize = image_height / (16 as usize);
    let latent_values: usize = latent_width *% latent_height *% (64 as usize);
    var latent: vec::Vec[f32] = vec::Vec[f32]::with_capacity(latent_values);
    value_index = 0 as usize;
    while value_index < latent_values {
        latent.append(0.0f32);
        value_index = value_index +% (1 as usize);
    }
    io::println("pipeline: phase=transformer-scheduler output=${image_width}x${image_height} text_rows=${text_rows} seed=${seed}");
    let transformer_wall_start_ms: i64 = time::now_millis();
    let transformer_status: i32 = if image_width == (1024 as usize)
        && image_height == (1024 as usize) && (bottleneck || taylorseer || cache_dit) {
        if bottleneck {
            transformer::run_prompt_trajectory_bottleneck_1024_to_host(
                packed_path,
                #slice_ptr(text_embeddings.as_slice()),
                text_rows,
                seed,
                #slice_ptr(latent.as_slice()),
            )
        } else if taylorseer {
            transformer::run_prompt_trajectory_taylorseer_1024_to_host(
                packed_path,
                #slice_ptr(text_embeddings.as_slice()),
                text_rows,
                seed,
                #slice_ptr(latent.as_slice()),
                cache_dit_threshold,
                steps,
            )
        } else if cache_dit {
            transformer::run_prompt_trajectory_cache_dit_1024_to_host(
                packed_path,
                #slice_ptr(text_embeddings.as_slice()),
                text_rows,
                seed,
                #slice_ptr(latent.as_slice()),
                cache_dit_threshold,
                steps,
            )
        } else {
            transformer::run_prompt_trajectory_1024_to_host(
                packed_path,
                #slice_ptr(text_embeddings.as_slice()),
                text_rows,
                seed,
                #slice_ptr(latent.as_slice()),
                steps,
                q4_eager_expand,
                q4_direct_packed,
            )
        }
    } else if image_width == (256 as usize) && image_height == (256 as usize) && bottleneck {
        transformer::run_prompt_trajectory_bottleneck_256_to_host(
            packed_path,
            #slice_ptr(text_embeddings.as_slice()),
            text_rows,
            seed,
            #slice_ptr(latent.as_slice()),
        )
    } else if image_width == (256 as usize) && image_height == (256 as usize) && cache_dit {
        transformer::run_prompt_trajectory_cache_dit_256_to_host(
            packed_path,
            #slice_ptr(text_embeddings.as_slice()),
            text_rows,
            seed,
            #slice_ptr(latent.as_slice()),
            cache_dit_threshold,
            steps,
        )
    } else {
        transformer::run_prompt_trajectory_sized_to_host(
            packed_path,
            #slice_ptr(text_embeddings.as_slice()),
            text_rows,
            seed,
            #slice_ptr(latent.as_slice()),
            image_width,
            image_height,
            steps,
            validate_reference,
            "tests/fixtures/trajectory_256_fp32",
            q4_eager_expand,
            q4_direct_packed,
        )
    };
    if transformer_status != (0 as i32) {
        return 1;
    }
    io::println("pipeline timing: transformer_wall_ms=${time::now_millis() - transformer_wall_start_ms}");

    let decoded_values: usize = image_width *% image_height *% (4 as usize);
    var decoded: vec::Vec[f32] = vec::Vec[f32]::with_capacity(decoded_values);
    value_index = 0 as usize;
    while value_index < decoded_values {
        decoded.append(0.0f32);
        value_index = value_index +% (1 as usize);
    }
    io::println("pipeline: phase=vae model=${model_root}");
    let vae_wall_start_ms: i64 = time::now_millis();
    let decode_status: i32 = if image_width == (1024 as usize) && image_height == (1024 as usize) {
        vae::decode_1024_from_host(
            model_root,
            #slice_ptr(latent.as_slice()),
            #slice_ptr(decoded.as_slice()),
        )
    } else if validate_reference {
        vae::decode_native_prompt_256_from_host(
            model_root,
            #slice_ptr(latent.as_slice()),
            #slice_ptr(decoded.as_slice()),
        )
    } else if image_width == (256 as usize) && image_height == (256 as usize) {
        vae::decode_256_from_host(
            model_root,
            #slice_ptr(latent.as_slice()),
            #slice_ptr(decoded.as_slice()),
        )
    } else {
        vae::decode_sized_from_host(
            model_root,
            #slice_ptr(latent.as_slice()),
            #slice_ptr(decoded.as_slice()),
            latent_width,
            latent_height,
        )
    };
    if decode_status != (0 as i32) {
        return 1;
    }
    io::println("pipeline timing: vae_wall_ms=${time::now_millis() - vae_wall_start_ms}");
    let image_wall_start_ms: i64 = time::now_millis();
    let write_ok: bool = if validate_reference {
        image_output::write_png_and_compare(
            #slice_ptr(decoded.as_slice()),
            vae_fixture,
            output_path,
            0.013f64,
        )
    } else {
        image_output::write_png_sized(
            #slice_ptr(decoded.as_slice()), output_path, image_width, image_height,
        )
    };
    if !write_ok { return 1; }
    io::println("pipeline timing: image_output_wall_ms=${time::now_millis() - image_wall_start_ms}");
    io::println("pipeline timing: total_wall_ms=${time::now_millis() - pipeline_wall_start_ms}");
    if validate_reference {
        io::println("Qwen-Image-2.1 native prompt ${image_width}x${image_height} pipeline: verified");
    } else {
        io::println("Qwen-Image-2.1 native prompt ${image_width}x${image_height} generation: complete");
    }
    return 0;
}

// Establish the warm-request baseline before retaining multi-gigabyte model
// runtimes. This keeps one process and one parsed tokenizer alive across all
// requests, while the text, transformer, and VAE mappings retain their normal
// phase-scoped lifetimes. That distinction is intentional: the measurement
// tells us how much process/tokenizer reuse earns before increasing the 32 GB
// machine's simultaneous mapped working set.
fn benchmark_process_reuse_256(
    packed_path: str,
    model_root: str,
    output_path: str,
    prompt: str,
    request_count: usize = 2 as usize,
    seed: u64 = 42 as u64,
    threshold: f64 = 0.24f64,
) -> i32 {
    if request_count < (2 as usize) || request_count > (16 as usize) {
        io::eprintln("resident benchmark: request count must be 2..16");
        return 2;
    }
    if !cache_dit_threshold_is_supported(threshold) {
        io::eprintln("resident benchmark: unsupported threshold");
        return 2;
    }
    let session_start_ms: i64 = time::now_millis();
    guard let tokenizer::LoadResult::Ok(resident_tokenizer) =
        tokenizer::load(model_root) else tokenizer::LoadResult::Err {
        return 1;
    };
    let tokenizer_init_ms: i64 = time::now_millis() - session_start_ms;
    io::println(
        "resident session: tokenizer_init_ms=${tokenizer_init_ms} requests=${request_count}",
    );

    var request: usize = 0 as usize;
    while request < request_count {
        let request_start_ms: i64 = time::now_millis();
        guard let option::Option[vec::Vec[u32]]::Some(full_tokens) =
            tokenizer::tokenize_full_prompt_with(resident_tokenizer, prompt) else {
            return 1;
        };
        io::println("resident session: request=${request +% (1 as usize)} begin");
        let status: i32 = run_native_tokens_impl(
            packed_path,
            model_root,
            output_path,
            full_tokens,
            seed,
            256 as usize,
            false,
            true,
            false,
            false,
            threshold,
            "40",
            request_start_ms,
            request_start_ms,
        );
        if status != (0 as i32) { return status; }
        io::println(
            "resident session: request=${request +% (1 as usize)} wall_ms=${time::now_millis() - request_start_ms}",
        );
        request = request +% (1 as usize);
    }
    io::println(
        "resident session: total_wall_ms=${time::now_millis() - session_start_ms} complete",
    );
    return 0;
}

fn generate_256(
    packed_path: str,
    model_root: str,
    output_path: str,
    prompt: str,
    seed: u64 = 1101 as u64,
    steps: str = "40",
) -> i32 {
    return run_native_impl(
        packed_path, model_root, output_path, prompt, seed, 256 as usize,
        false, false, false, false, 0.0f64, steps,
    );
}

fn generate_256_cache_dit(
    packed_path: str,
    model_root: str,
    output_path: str,
    prompt: str,
    seed: u64 = 1101 as u64,
    threshold: f64 = 0.12f64,
    steps: str = "40",
) -> i32 {
