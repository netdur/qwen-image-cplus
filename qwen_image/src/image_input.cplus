// Native reference-image decode and resize for image-conditioned generation.
//
// ImageIO decodes common macOS image formats and Core Graphics resamples into
// an explicit top-down RGBA surface. The result retains straight-alpha RGBA
// for the VAE and also provides RGB composited over white for Qwen3-VL, which
// is the split used by the pinned official pipeline.

import "./host_buffers" as host_buffers;
import "./image_conditioning" as conditioning;
import "./image_output" as image_output;
import "objc/runtime" as rt;
import "stdlib/io" as io;
import "stdlib/math" as _;
import "stdlib/option" as option;
import "stdlib/status" as status;
import "stdlib/text" as text;
import "stdlib/vec" as vec;

extern fn CFURLCreateFromFileSystemRepresentation(
    allocator: *u8,
    bytes: *u8,
    length: isize,
    is_directory: bool,
) -> *u8;
extern fn CGImageSourceCreateWithURL(url: *u8, options: *u8) -> *u8;
extern fn CGImageSourceCreateImageAtIndex(
    source: *u8,
    index: usize,
    options: *u8,
) -> *u8;
extern fn CGImageGetWidth(image: *u8) -> usize;
extern fn CGImageGetHeight(image: *u8) -> usize;
extern fn CGColorSpaceCreateDeviceRGB() -> *u8;
extern fn CGBitmapContextCreate(
    data: *u8,
    width: usize,
    height: usize,
    bits_per_component: usize,
    bytes_per_row: usize,
    color_space: *u8,
    bitmap_info: u32,
) -> *u8;
extern fn CGContextSetInterpolationQuality(context: *u8, quality: i32);
extern fn CGContextDrawImage(context: *u8, rect: rt::Rect, image: *u8);
extern fn CGContextTranslateCTM(context: *u8, x: f64, y: f64);
extern fn CGContextRotateCTM(context: *u8, angle: f64);
extern fn CGContextScaleCTM(context: *u8, x: f64, y: f64);
extern fn CGImageSourceCopyPropertiesAtIndex(
    source: *u8,
    index: usize,
    options: *u8,
) -> *u8;
extern fn CFStringCreateWithCString(allocator: *u8, bytes: *u8, encoding: u32) -> *u8;
extern fn CFDictionaryGetValue(dictionary: *u8, key: *u8) -> *u8;
extern fn CFNumberGetValue(number: *u8, number_type: isize, value: *u8) -> bool;
extern fn CFRelease(value: *u8);

const CHANNELS: usize = 3;
const RGBA_CHANNELS: usize = 4;
const ALPHA_PREMULTIPLIED_LAST: u32 = 1;
const BYTE_ORDER_32_BIG: u32 = 4 << 12;
const INTERPOLATION_HIGH: i32 = 3;
const CF_STRING_ENCODING_UTF8: u32 = 0x08000100;
const CF_NUMBER_SINT32: isize = 3;
const HALF_PI: f64 = 1.5707963267948966;

struct OwnedCf {
    pointer: *u8,
}

impl OwnedCf {
    fn new(pointer: *u8) -> OwnedCf { return OwnedCf { pointer: pointer }; }

    fn drop(ref this) {
        if !this.pointer.is_null() { CFRelease(this.pointer); }
        this.pointer = 0 as *u8;
    }
}

struct Image {
    shape: conditioning::Shape,
    vision_pixels: vec::Vec[f32],
    vae_pixels: vec::Vec[f32],
}

// EXIF/TIFF orientation (1-8) of the first image, or 1 when absent. The
// reference loader (diffusers `load_image`) applies `exif_transpose`, so a
// phone photo stored sideways must be upright before resizing.
fn source_orientation(source: *u8) -> i32 {
    let properties: *u8 = CGImageSourceCopyPropertiesAtIndex(source, 0 as usize, 0 as *u8);
    if properties.is_null() { return 1 as i32; }
    let properties_owner: OwnedCf = OwnedCf::new(properties);
    // kCGImagePropertyOrientation is the CFString "Orientation".
    let key: *u8 = CFStringCreateWithCString(
        0 as *u8, #str_ptr("Orientation\0"), CF_STRING_ENCODING_UTF8,
    );
    if key.is_null() { return 1 as i32; }
    let key_owner: OwnedCf = OwnedCf::new(key);
    let number: *u8 = CFDictionaryGetValue(properties, key);
    if number.is_null() { return 1 as i32; }
    var orientation: i32 = 1 as i32;
    if !CFNumberGetValue(number, CF_NUMBER_SINT32, #addr_of(orientation) as *u8) {
        return 1 as i32;
    }
    if orientation < (1 as i32) || orientation > (8 as i32) { return 1 as i32; }
    return orientation;
}

// Orientations 5-8 swap the stored width and height.
fn orientation_transposes(orientation: i32) -> bool {
    return orientation >= (5 as i32);
}

// Maps the stored image, drawn into (0, 0, stored width, stored height), onto
// the upright width x height surface. Core Graphics is y-up here, and a later
// CTM call applies to user coordinates first.
fn apply_orientation(context: *u8, orientation: i32, width: f64, height: f64) {
    if orientation == (2 as i32) {
        CGContextTranslateCTM(context, width, 0.0f64);
        CGContextScaleCTM(context, -1.0f64, 1.0f64);
    } else if orientation == (3 as i32) {
        CGContextTranslateCTM(context, width, height);
        CGContextScaleCTM(context, -1.0f64, -1.0f64);
    } else if orientation == (4 as i32) {
        CGContextTranslateCTM(context, 0.0f64, height);
        CGContextScaleCTM(context, 1.0f64, -1.0f64);
    } else if orientation == (5 as i32) {
        CGContextTranslateCTM(context, width, height);
        CGContextRotateCTM(context, HALF_PI);
        CGContextScaleCTM(context, -1.0f64, 1.0f64);
    } else if orientation == (6 as i32) {
        CGContextTranslateCTM(context, 0.0f64, height);
        CGContextRotateCTM(context, 0.0f64 - HALF_PI);
    } else if orientation == (7 as i32) {
        CGContextRotateCTM(context, HALF_PI);
        CGContextScaleCTM(context, 1.0f64, -1.0f64);
    } else if orientation == (8 as i32) {
        CGContextTranslateCTM(context, width, 0.0f64);
        CGContextRotateCTM(context, HALF_PI);
    }
}

fn load_resized(
    path: str,
    output_resolution: usize = 512 as usize,
) -> option::Option[Image] {
    if path.count() == (0 as usize) { return option::Option[Image]::None; }
    let url_pointer: *u8 = CFURLCreateFromFileSystemRepresentation(
        0 as *u8, #str_ptr(path), path.count() as isize, false,
    );
    if url_pointer.is_null() { return option::Option[Image]::None; }
    let url_owner: OwnedCf = OwnedCf::new(url_pointer);
    let source_pointer: *u8 = CGImageSourceCreateWithURL(url_pointer, 0 as *u8);
    if source_pointer.is_null() { return option::Option[Image]::None; }
    let source_owner: OwnedCf = OwnedCf::new(source_pointer);
    let image_pointer: *u8 = CGImageSourceCreateImageAtIndex(
        source_pointer, 0 as usize, 0 as *u8,
    );
    if image_pointer.is_null() { return option::Option[Image]::None; }
    let image_owner: OwnedCf = OwnedCf::new(image_pointer);

    let orientation: i32 = source_orientation(source_pointer);
    let transposed: bool = orientation_transposes(orientation);
    let stored_width: usize = CGImageGetWidth(image_pointer);
    let stored_height: usize = CGImageGetHeight(image_pointer);
    let source_width: usize = if transposed { stored_height } else { stored_width };
    let source_height: usize = if transposed { stored_width } else { stored_height };
    guard let option::Option[conditioning::Shape]::Some(shape) =
        conditioning::calculate_shape(
            source_width, source_height, output_resolution,
    ) else { return option::Option[Image]::None; };
    let rgba_count: usize = shape.width *% shape.height *% RGBA_CHANNELS;
    guard let option::Option[vec::Vec[u8]]::Some(rgba) = host_buffers::zeroed_u8(rgba_count)
        else { return option::Option[Image]::None; };
    let color_space_pointer: *u8 = CGColorSpaceCreateDeviceRGB();
    if color_space_pointer.is_null() { return option::Option[Image]::None; }
    let color_space_owner: OwnedCf = OwnedCf::new(color_space_pointer);
    let context_pointer: *u8 = CGBitmapContextCreate(
        #slice_ptr(rgba.as_slice()),
        shape.width,
        shape.height,
        8 as usize,
        shape.width *% RGBA_CHANNELS,
        color_space_pointer,
        ALPHA_PREMULTIPLIED_LAST | BYTE_ORDER_32_BIG,
    );
    if context_pointer.is_null() { return option::Option[Image]::None; }
    let context_owner: OwnedCf = OwnedCf::new(context_pointer);
    CGContextSetInterpolationQuality(context_pointer, INTERPOLATION_HIGH);
    // CGImage drawing into this explicit bitmap layout leaves the first
    // memory row at the visual top. Only the EXIF orientation transforms the
    // coordinates; an extra Core Graphics y-flip here would invert the image
    // processor input.
    apply_orientation(
        context_pointer, orientation, shape.width as f64, shape.height as f64,
    );
    CGContextDrawImage(
        context_pointer,
        rt::Rect {
            x: 0.0f64,
            y: 0.0f64,
            w: if transposed { shape.height as f64 } else { shape.width as f64 },
            h: if transposed { shape.width as f64 } else { shape.height as f64 },
        },
        image_pointer,
    );

    let pixel_count: usize = shape.width *% shape.height;
    var vision_pixels: vec::Vec[f32] = vec::Vec[f32]::with_capacity(
        pixel_count *% CHANNELS,
    );
    var vae_pixels: vec::Vec[f32] = vec::Vec[f32]::with_capacity(
        pixel_count *% RGBA_CHANNELS,
    );
    let rgba_values: *u8 = #slice_ptr(rgba.as_slice());
    var pixel: usize = 0 as usize;
    while pixel < pixel_count {
        let source_offset: usize = pixel *% RGBA_CHANNELS;
        let alpha_u8: u8 = rgba_values[source_offset +% (3 as usize)];
        let alpha: f32 = alpha_u8 as f32 / 255.0f32;
        var channel: usize = 0 as usize;
        while channel < CHANNELS {
            let premultiplied: f32 =
                rgba_values[source_offset +% channel] as f32 / 255.0f32;
            // Core Graphics supplies premultiplied color. White composition
            // can use it directly; recover straight color for the VAE where
            // alpha is nonzero.
            let vision_value: f32 = premultiplied + (1.0f32 - alpha);
            let vae_value: f32 = if alpha_u8 == (0 as u8) {
                0.0f32
            } else { (premultiplied / alpha).min(1.0f32) };
            if vision_pixels.append(vision_value.min(1.0f32)) != status::Status::Ok
                || vae_pixels.append(vae_value) != status::Status::Ok {
                return option::Option[Image]::None;
            }
            channel = channel +% (1 as usize);
        }
        if vae_pixels.append(alpha) != status::Status::Ok {
            return option::Option[Image]::None;
        }
        pixel = pixel +% (1 as usize);
    }
    return option::Option[Image]::Some(Image {
        shape: shape,
        vision_pixels: vision_pixels,
        vae_pixels: vae_pixels,
    });
}

// Creates an asymmetric source image so the smoke checks decode, exact 512
// area-resize dimensions, RGB channel order, and top-down row orientation.
fn run_reference(source_path: str) -> i32 {
    let source_width: usize = 64;
    let source_height: usize = 32;
    var source: vec::Vec[f32] = vec::Vec[f32]::with_capacity(
        source_width *% source_height *% RGBA_CHANNELS,
    );
    var y: usize = 0 as usize;
    while y < source_height {
        var x: usize = 0 as usize;
        while x < source_width {
            let top: bool = y < source_height / (2 as usize);
            source.append(if top { 1.0f32 } else { -1.0f32 });
            source.append(-1.0f32);
            source.append(if top { -1.0f32 } else { 1.0f32 });
            source.append(if x < source_width / (2 as usize) {
                1.0f32
            } else { 0.0f32 });
            x = x +% (1 as usize);
        }
        y = y +% (1 as usize);
    }
    if !image_output::write_png_sized(
        #slice_ptr(source.as_slice()), source_path, source_width, source_height,
    ) { return 1; }
    guard let option::Option[Image]::Some(decoded) = load_resized(
        source_path, 512 as usize,
    ) else {
        io::eprintln("image input: could not decode generated reference");
        return 1;
    };
    if decoded.shape.width != (736 as usize)
        || decoded.shape.height != (352 as usize)
        || decoded.shape.vision_tokens != (253 as usize)
        || decoded.shape.latent_tokens != (1012 as usize) {
        io::eprintln(
            "image input: unexpected 512-area shape ${decoded.shape.width}x${decoded.shape.height}",
        );
        return 1;
    }
    let center_x: usize = decoded.shape.width / (4 as usize);
    let top_offset: usize = center_x *% CHANNELS;
    let bottom_offset: usize = (
        (decoded.shape.height -% (1 as usize)) *% decoded.shape.width +% center_x
    ) *% CHANNELS;
    guard let option::Option[f32]::Some(top_red) = decoded.vision_pixels.at(top_offset)
        else { return 1; };
    guard let option::Option[f32]::Some(top_blue) = decoded.vision_pixels.at(
        top_offset +% (2 as usize),
    ) else { return 1; };
    guard let option::Option[f32]::Some(bottom_red) = decoded.vision_pixels.at(bottom_offset)
        else { return 1; };
    guard let option::Option[f32]::Some(bottom_blue) = decoded.vision_pixels.at(
        bottom_offset +% (2 as usize),
    ) else { return 1; };
    if top_red < 0.99f32 || top_blue > 0.01f32
        || bottom_red > 0.01f32 || bottom_blue < 0.99f32 {
        io::eprintln(
            "image input: channel/orientation mismatch top=${top_red},${top_blue} bottom=${bottom_red},${bottom_blue}",
        );
        return 1;
    }
    let translucent_x: usize = decoded.shape.width *% (3 as usize) / (4 as usize);
    let translucent_vision: usize = translucent_x *% CHANNELS;
    let translucent_vae: usize = translucent_x *% RGBA_CHANNELS;
    guard let option::Option[f32]::Some(vision_green) = decoded.vision_pixels.at(
        translucent_vision +% (1 as usize),
    ) else { return 1; };
    guard let option::Option[f32]::Some(vae_red) = decoded.vae_pixels.at(translucent_vae)
        else { return 1; };
    guard let option::Option[f32]::Some(vae_alpha) = decoded.vae_pixels.at(
        translucent_vae +% (3 as usize),
    ) else { return 1; };
    if vision_green < 0.49f32 || vision_green > 0.51f32
        || vae_red < 0.99f32 || vae_alpha < 0.49f32 || vae_alpha > 0.51f32 {
        io::eprintln(
            "image input: alpha split mismatch vision_green=${vision_green} vae_red=${vae_red} vae_alpha=${vae_alpha}",
        );
        return 1;
    }
    io::println(
        "reference image input: source=64x32 resized=736x352 output_resolution=512 vision_tokens=253 latent_tokens=1012 RGBA/vision-white/top-down=verified",
    );
    return 0;
}

// Loads orientation_1.jpg through orientation_8.jpg from `directory`. Each file
// stores the same upright picture under a different EXIF orientation, so
// every decode must match orientation 1 in shape and in pixels.
fn run_orientation(directory: str) -> i32 {
    let reference_path: text::Text = "${directory}/orientation_1.jpg";
    guard let option::Option[Image]::Some(reference) = load_resized(
        reference_path.view(), 512 as usize,
    ) else {
        io::eprintln("image orientation: could not decode ${reference_path}");
        return 1;
    };
    let reference_values: *f32 = #slice_ptr(reference.vision_pixels.as_slice());
    var all_ok: bool = true;
    var orientation: usize = 2 as usize;
    while orientation <= (8 as usize) {
        let path: text::Text = "${directory}/orientation_${orientation}.jpg";
        guard let option::Option[Image]::Some(decoded) = load_resized(
            path.view(), 512 as usize,
        ) else {
            io::eprintln("image orientation: could not decode ${path}");
            return 1;
        };
        if decoded.shape.width != reference.shape.width
            || decoded.shape.height != reference.shape.height {
            io::eprintln(
                "image orientation ${orientation}: shape ${decoded.shape.width}x${decoded.shape.height} expected ${reference.shape.width}x${reference.shape.height}",
            );
            all_ok = false;
        } else {
            let values: *f32 = #slice_ptr(decoded.vision_pixels.as_slice());
            var absolute_sum: f64 = 0.0f64;
            var index: usize = 0 as usize;
            while index < decoded.vision_pixels.count() {
                absolute_sum = absolute_sum
                    + (values[index] as f64 - reference_values[index] as f64).abs();
                index = index +% (1 as usize);
            }
            let mean_error: f64 = absolute_sum / decoded.vision_pixels.count() as f64;
            io::println(
                "image orientation ${orientation}: shape=${decoded.shape.width}x${decoded.shape.height} mean_abs_error=${mean_error}",
            );
            // JPEG re-encoding of the rotated storage differs slightly; a
            // wrong orientation moves whole colour blocks and is far larger.
            if mean_error > 0.02f64 { all_ok = false; }
        }
        orientation = orientation +% (1 as usize);
    }
    if !all_ok { return 1; }
    io::println("reference image EXIF orientations 1-8: verified");
    return 0;
}
