fn dispatch_attention(
    queue: metal::CommandQueue,
    pipeline_state: metal::ComputePipelineState,
    query: metal::Buffer,
    key: metal::Buffer,
    output: metal::Buffer,
    value: metal::Buffer,
    params: *TextParams,
) -> option::Option[f64] {
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return option::Option[f64]::None; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    guard let option::Option[metal::CommandBuffer]::Some(command_buffer) = queue.command_buffer() else { return option::Option[f64]::None; };
    let command_buffer_owner: OwnedObjc = OwnedObjc::new(rt::retain(command_buffer.raw()));
    guard let option::Option[metal::ComputeCommandEncoder]::Some(encoder) = command_buffer.compute_command_encoder() else { return option::Option[f64]::None; };
    let encoder_owner: OwnedObjc = OwnedObjc::new(rt::retain(encoder.raw()));
    encoder.set_compute_pipeline_state(pipeline_state);
    encoder.set_buffer(query, 0 as u64, 0 as u64);
    encoder.set_buffer(key, 0 as u64, 1 as u64);
    encoder.set_buffer(output, 0 as u64, 2 as u64);
    encoder.set_buffer(value, 0 as u64, 3 as u64);
    encoder.set_bytes(params as *u8, #size_of::[TextParams]() as u64, 4 as u64);
    encoder.dispatch_threadgroups(
        metal::Size { width: ((*params).rows as usize *% HEADS) as u64, height: 1 as u64, depth: 1 as u64 },
        metal::Size { width: HEAD_DIMENSION as u64, height: 1 as u64, depth: 1 as u64 },
    );
    metal::CommandEncoder::from_raw(encoder.raw()).end_encoding();
    command_buffer.commit();
    command_buffer.wait_until_completed();
    return option::Option[f64]::Some((command_buffer.g_p_u_end_time() - command_buffer.g_p_u_start_time()) * 1000.0f64);
}

// Causal grouped-query attention as matrix work for long prompts. Query head
// h reads KV head h / (HEADS / KV_HEADS); Q, K, V and the output are strided
// [rows, heads, 128] FP32 views. Per head: scaled QK^T, causal softmax, PV
// into that head's output columns; the output is rounded to BF16 as
// qt_causal_gqa does.
fn dispatch_attention_mps(
    queue: metal::CommandQueue,
    pipelines: Pipelines,
    linear: MpsLinear,
    query: metal::Buffer,
    key: metal::Buffer,
    output: metal::Buffer,
    value: metal::Buffer,
    scores: metal::Buffer,
    rows: usize,
) -> option::Option[f64] {
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return option::Option[f64]::None; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    guard let option::Option[metal::CommandBuffer]::Some(command_buffer) = queue.command_buffer() else { return option::Option[f64]::None; };
    let command_buffer_owner: OwnedObjc = OwnedObjc::new(rt::retain(command_buffer.raw()));
    let query_row_bytes: usize = WIDTH *% #size_of::[f32]();
    let kv_row_bytes: usize = KV_WIDTH *% #size_of::[f32]();
    let score_row_bytes: usize = rows *% #size_of::[f32]();
    var row_count: u32 = rows as u32;
    var head: usize = 0 as usize;
    while head < HEADS {
        let query_offset: u64 = (head *% HEAD_DIMENSION *% #size_of::[f32]()) as u64;
        let kv_offset: u64 = (head / (HEADS / KV_HEADS) *% HEAD_DIMENSION *% #size_of::[f32]()) as u64;
        guard let option::Option[mps::Multiplication]::Some(score_operation) = mps::create_fp32(
            linear.device,
            mps::Fp32Operand { buffer: query, offset: query_offset, rows: rows, columns: HEAD_DIMENSION, row_bytes: query_row_bytes },
            mps::Fp32Operand { buffer: key, offset: kv_offset, rows: rows, columns: HEAD_DIMENSION, row_bytes: kv_row_bytes },
            mps::Fp32Operand { buffer: scores, offset: 0 as u64, rows: rows, columns: rows, row_bytes: score_row_bytes },
            false, true, HEAD_DIMENSION, 1.0f64 / (HEAD_DIMENSION as f64).sqrt(),
        ) else { return option::Option[f64]::None; };
        guard let option::Option[mps::Multiplication]::Some(value_operation) = mps::create_fp32(
            linear.device,
            mps::Fp32Operand { buffer: scores, offset: 0 as u64, rows: rows, columns: rows, row_bytes: score_row_bytes },
            mps::Fp32Operand { buffer: value, offset: kv_offset, rows: rows, columns: HEAD_DIMENSION, row_bytes: kv_row_bytes },
            mps::Fp32Operand { buffer: output, offset: query_offset, rows: rows, columns: HEAD_DIMENSION, row_bytes: query_row_bytes },
            false, false, rows, 1.0f64,
        ) else { return option::Option[f64]::None; };
        score_operation.encode(command_buffer);
        guard let option::Option[metal::ComputeCommandEncoder]::Some(encoder) = command_buffer.compute_command_encoder() else { return option::Option[f64]::None; };
        let encoder_owner: OwnedObjc = OwnedObjc::new(rt::retain(encoder.raw()));
        encoder.set_compute_pipeline_state(pipelines.causal_softmax);
        encoder.set_buffer(scores, 0 as u64, 0 as u64);
        encoder.set_bytes(#addr_of(row_count) as *u8, #size_of::[u32]() as u64, 1 as u64);
        encoder.dispatch_threadgroups(
            metal::Size { width: rows as u64, height: 1 as u64, depth: 1 as u64 },
            metal::Size { width: 256 as u64, height: 1 as u64, depth: 1 as u64 },
        );
        metal::CommandEncoder::from_raw(encoder.raw()).end_encoding();
        value_operation.encode(command_buffer);
        head = head +% (1 as usize);
    }
    guard let option::Option[metal::ComputeCommandEncoder]::Some(round_encoder) = command_buffer.compute_command_encoder() else { return option::Option[f64]::None; };
    let round_encoder_owner: OwnedObjc = OwnedObjc::new(rt::retain(round_encoder.raw()));
    var output_count: u32 = (rows *% WIDTH) as u32;
    round_encoder.set_compute_pipeline_state(pipelines.round_bf16);
    round_encoder.set_buffer(output, 0 as u64, 0 as u64);
    round_encoder.set_bytes(#addr_of(output_count) as *u8, #size_of::[u32]() as u64, 1 as u64);
    dispatch_one_count(round_encoder, pipelines.round_bf16, output_count as usize);
    metal::CommandEncoder::from_raw(round_encoder.raw()).end_encoding();
    command_buffer.commit();
    command_buffer.wait_until_completed();
    return option::Option[f64]::Some((command_buffer.g_p_u_end_time() - command_buffer.g_p_u_start_time()) * 1000.0f64);
}

fn normalized_rms_output(
    actual: metal::Buffer,
    actual_row_offset: usize,
    actual_rows: usize,
    fixture_path: str,
) -> option::Option[f64] {
    guard let mapped::MapResult::Ok(expected) = mapped::map_readonly(fixture_path) else {
        io::eprintln("text encoder: missing fixture ${fixture_path}");
        return option::Option[f64]::None;
    };
    let count: usize = actual_rows *% WIDTH;
    if expected.length() != count *% #size_of::[f32]() {
        io::eprintln("text encoder: output fixture has wrong byte count");
        return option::Option[f64]::None;
    }
    let actual_values: *f32 = actual.contents() as *f32;
    let expected_values: *f32 = expected.pointer() as *f32;
    var squared_error: f64 = 0.0f64;
    var squared_reference: f64 = 0.0f64;
    var index: usize = 0 as usize;
    let offset: usize = actual_row_offset *% WIDTH;
    while index < count {
        let difference: f64 = actual_values[offset +% index] as f64 - expected_values[index] as f64;
        squared_error = squared_error + difference * difference;
        squared_reference = squared_reference + expected_values[index] as f64 * expected_values[index] as f64;
        index = index +% (1 as usize);
    }
    return option::Option[f64]::Some((squared_error / squared_reference.max(0.000000000001f64)).sqrt());
}

fn finite(buffer: metal::Buffer, count: usize) -> bool {
    let values: *f32 = buffer.contents() as *f32;
    var index: usize = 0 as usize;
    while index < count {
        let value: f32 = values[index];
        let bits: u32 = #bitcast::[u32](value);
        if (bits & (0x7F800000 as u32)) == (0x7F800000 as u32) {
            io::eprintln("text encoder: non-finite value at ${index}");
            return false;
        }
        index = index +% (1 as usize);
    }
    return true;
}

// Token IDs are supplied by the caller. The pipeline already tokenizes the
// prompt to size its embedding buffer, and loading the tokenizer parses
// 151,643 vocabulary entries plus 151,387 merges, so doing it a second time
// here was pure duplicated startup work.
fn run_impl(
    model_root: str,
    token_ids: *u32,
    token_count: usize,
    fixture_path: str,
    output: *f32,
    output_capacity: usize,
    output_row_count: *usize,
    validate_reference: bool,
    position_ids: *u32 = 0 as *u32,
    vision_embeddings: *f32 = 0 as *f32,
    vision_token_count: usize = 0 as usize,
    deepstack_embeddings: *f32 = 0 as *f32,
) -> i32 {
    if token_ids.is_null() {
        io::eprintln("text encoder: token IDs must not be null");
        return 2;
    }
    let rows: usize = token_count;
    if rows <= SYSTEM_PREFIX_TOKENS || rows > (4096 as usize) {
        io::eprintln("text encoder: unsupported full token count ${rows}");
        return 1;
    }
    let output_rows: usize = rows -% SYSTEM_PREFIX_TOKENS;
    let output_values: usize = output_rows *% WIDTH;
    if !output.is_null() && output_capacity < output_values {
        io::eprintln("text encoder: output capacity ${output_capacity} is smaller than ${output_values}");
        return 2;
    }
    if vision_embeddings.is_null() != (vision_token_count == (0 as usize))
        || (!vision_embeddings.is_null()
            && (position_ids.is_null() || deepstack_embeddings.is_null())) {
        io::eprintln("text encoder: incomplete multimodal inputs");
        return 2;
    }

    let run_wall_start_ms: i64 = time::now_millis();
    let mapping_start_ms: i64 = time::now_millis();
    let directory: text::Text = "${model_root}/text_encoder";
    let shard_0_path: text::Text = "${directory}/model-00001-of-00004.safetensors";
    let shard_1_path: text::Text = "${directory}/model-00002-of-00004.safetensors";
    let shard_2_path: text::Text = "${directory}/model-00003-of-00004.safetensors";
    let shard_3_path: text::Text = "${directory}/model-00004-of-00004.safetensors";
    guard let safetensors::LoadResult::Ok(file_0) = safetensors::load(shard_0_path.view()) else safetensors::LoadResult::Err(error) { io::eprintln("text encoder: shard 1: ${error.name()}"); return 1; };
    guard let safetensors::LoadResult::Ok(file_1) = safetensors::load(shard_1_path.view()) else safetensors::LoadResult::Err(error) { io::eprintln("text encoder: shard 2: ${error.name()}"); return 1; };
    guard let safetensors::LoadResult::Ok(file_2) = safetensors::load(shard_2_path.view()) else safetensors::LoadResult::Err(error) { io::eprintln("text encoder: shard 3: ${error.name()}"); return 1; };
    guard let safetensors::LoadResult::Ok(file_3) = safetensors::load(shard_3_path.view()) else safetensors::LoadResult::Err(error) { io::eprintln("text encoder: shard 4: ${error.name()}"); return 1; };
    let mapping_wall_ms: i64 = time::now_millis() - mapping_start_ms;
    let reader_start_ms: i64 = time::now_millis();
    guard let option::Option[mapped::PositionalReader]::Some(reader_0) = mapped::open_positional_reader(shard_0_path.view()) else { io::eprintln("text encoder: could not open shard 1 stream"); return 1; };
    guard let option::Option[mapped::PositionalReader]::Some(reader_1) = mapped::open_positional_reader(shard_1_path.view()) else { io::eprintln("text encoder: could not open shard 2 stream"); return 1; };
    guard let option::Option[mapped::PositionalReader]::Some(reader_2) = mapped::open_positional_reader(shard_2_path.view()) else { io::eprintln("text encoder: could not open shard 3 stream"); return 1; };
    guard let option::Option[mapped::PositionalReader]::Some(reader_3) = mapped::open_positional_reader(shard_3_path.view()) else { io::eprintln("text encoder: could not open shard 4 stream"); return 1; };
    let reader_wall_ms: i64 = time::now_millis() - reader_start_ms;

    let device_queue_start_ms: i64 = time::now_millis();
    let device_pointer: *u8 = MTLCreateSystemDefaultDevice();
    if device_pointer.is_null() { io::eprintln("text encoder: no Metal device"); return 1; }
    let device_owner: OwnedObjc = OwnedObjc::new(rt::retain(device_pointer));
    let device: metal::Device = metal::Device::from_raw(device_owner.raw());
    guard let option::Option[metal::CommandQueue]::Some(queue) = device.new_command_queue() else { return 1; };
    let queue_owner: OwnedObjc = OwnedObjc::new(queue.raw());
    let device_queue_wall_ms: i64 = time::now_millis() - device_queue_start_ms;

    let compile_start_ms: i64 = time::now_millis();
    let options_pointer: *u8 = rt::alloc_init(#str_ptr("MTLCompileOptions\0"));
    if options_pointer.is_null() { return 1; }
    let options_owner: OwnedObjc = OwnedObjc::new(options_pointer);
    let options: metal::CompileOptions = metal::CompileOptions::from_raw(options_owner.raw());
    options.set_fast_math_enabled(false);
    var compile_error: *u8 = 0 as *u8;
    guard let option::Option[metal::Library]::Some(library) = device.new_library_with_source(
        #include_str("../kernels/text_encoder.metal"),
        options,
        #addr_of(compile_error) as *u8,
    ) else {
        if !compile_error.is_null() {
            let description: *u8 = rt::msg_id(compile_error, rt::sel(#str_ptr("localizedDescription\0")));
            io::eprintln("text encoder Metal compile: ${bridge::to_text(description)}");
        }
        return 1;
    };
    let library_owner: OwnedObjc = OwnedObjc::new(library.raw());
    guard let option::Option[OwnedObjc]::Some(embedding_owner) = pipeline(device, library, "qt_embedding") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(rms_norm_owner) = pipeline(device, library, "qt_rms_norm") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(linear_owner) = pipeline(device, library, "qt_linear_16x16") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(qk_norm_rope_owner) = pipeline(device, library, "qt_qk_norm_rope") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(attention_owner) = pipeline(device, library, "qt_causal_gqa") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(add_owner) = pipeline(device, library, "qt_add") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(add_visual_owner) = pipeline(
        device, library, "qt_add_visual",
    ) else { return 1; };
    guard let option::Option[OwnedObjc]::Some(swiglu_owner) = pipeline(device, library, "qt_swiglu") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(bf16_to_f32_owner) = pipeline(device, library, "qt_bf16_to_f32") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(round_bf16_owner) = pipeline(device, library, "qt_round_bf16_inplace") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(causal_softmax_owner) = pipeline(device, library, "qt_causal_row_softmax") else { return 1; };
    let pipelines: Pipelines = Pipelines {
        embedding: metal::ComputePipelineState::from_raw(embedding_owner.raw()),
        rms_norm: metal::ComputePipelineState::from_raw(rms_norm_owner.raw()),
        linear: metal::ComputePipelineState::from_raw(linear_owner.raw()),
        qk_norm_rope: metal::ComputePipelineState::from_raw(qk_norm_rope_owner.raw()),
        attention: metal::ComputePipelineState::from_raw(attention_owner.raw()),
        add: metal::ComputePipelineState::from_raw(add_owner.raw()),
        add_visual: metal::ComputePipelineState::from_raw(add_visual_owner.raw()),
        swiglu: metal::ComputePipelineState::from_raw(swiglu_owner.raw()),
        bf16_to_f32: metal::ComputePipelineState::from_raw(bf16_to_f32_owner.raw()),
        round_bf16: metal::ComputePipelineState::from_raw(round_bf16_owner.raw()),
        causal_softmax: metal::ComputePipelineState::from_raw(causal_softmax_owner.raw()),
    };
    let compile_wall_ms: i64 = time::now_millis() - compile_start_ms;

    guard let option::Option[SourceTensor]::Some(embedding_source) = source_tensor(
        file_0,
        file_1,
        file_2,
        file_3,
        "model.language_model.embed_tokens.weight",
        VOCABULARY as u64,
        WIDTH as u64,
    ) else { return 1; };

    let scratch_start_ms: i64 = time::now_millis();
    let hidden_bytes: u64 = (rows *% WIDTH *% #size_of::[f32]()) as u64;
    let kv_bytes: u64 = (rows *% KV_WIDTH *% #size_of::[f32]()) as u64;
    let intermediate_bytes: u64 = (rows *% INTERMEDIATE_WIDTH *% #size_of::[f32]()) as u64;
    guard let option::Option[metal::Buffer]::Some(ids) = new_buffer(device, (rows *% #size_of::[u32]()) as u64) else { return 1; };
    let ids_owner: OwnedObjc = OwnedObjc::new(ids.raw());
    guard let option::Option[metal::Buffer]::Some(positions) = new_buffer(
        device, (rows *% (3 as usize) *% #size_of::[u32]()) as u64,
    ) else { return 1; };
    let positions_owner: OwnedObjc = OwnedObjc::new(positions.raw());
    let position_values: *u32 = positions.contents() as *u32;
    var position_row: usize = 0 as usize;
    while position_row < rows {
        var axis: usize = 0 as usize;
        while axis < (3 as usize) {
            position_values[position_row *% (3 as usize) +% axis] =
                if position_ids.is_null() {
                position_row as u32
            } else {
                position_ids[position_row *% (3 as usize) +% axis]
            };
            axis = axis +% (1 as usize);
        }
        position_row = position_row +% (1 as usize);
    }
    guard let option::Option[metal::Buffer]::Some(visual_rows) = new_buffer(
        device, (rows *% #size_of::[i32]()) as u64,
    ) else { return 1; };
    let visual_rows_owner: OwnedObjc = OwnedObjc::new(visual_rows.raw());
    let visual_row_values: *i32 = visual_rows.contents() as *i32;
    var visual_row: usize = 0 as usize;
    var row_index: usize = 0 as usize;
    // Text-only prompts embed a literal `<|image_pad|>` as an ordinary token,
    // as the reference encoder does without pixel values.
    while row_index < rows {
        if token_ids[row_index] == (151655 as u32) && !vision_embeddings.is_null() {
            if visual_row >= vision_token_count {
                io::eprintln("text encoder: image placeholder has no vision feature");
                return 2;
            }
            visual_row_values[row_index] = visual_row as i32;
            visual_row = visual_row +% (1 as usize);
        } else {
            visual_row_values[row_index] = 0 -% (1 as i32);
        }
        row_index = row_index +% (1 as usize);
    }
    if visual_row != vision_token_count {
        io::eprintln(
            "text encoder: prompt has ${visual_row} image placeholders for ${vision_token_count} vision features",
        );
        return 2;
    }
    let deepstack_values: usize = (3 as usize) *% vision_token_count *% WIDTH;
    guard let option::Option[metal::Buffer]::Some(deepstack) = new_buffer(
        device,
        if deepstack_values == (0 as usize) {
            #size_of::[f32]() as u64
        } else { (deepstack_values *% #size_of::[f32]()) as u64 },
    ) else { return 1; };
    let deepstack_owner: OwnedObjc = OwnedObjc::new(deepstack.raw());
    if deepstack_values > (0 as usize) {
        let deepstack_values_gpu: *f32 = deepstack.contents() as *f32;
        var deepstack_index: usize = 0 as usize;
        while deepstack_index < deepstack_values {
            deepstack_values_gpu[deepstack_index] = deepstack_embeddings[deepstack_index];
            deepstack_index = deepstack_index +% (1 as usize);
        }
    }
    guard let option::Option[metal::Buffer]::Some(embedding_rows) = new_buffer(device, (rows *% WIDTH *% #size_of::[u16]()) as u64) else { return 1; };
    let embedding_rows_owner: OwnedObjc = OwnedObjc::new(embedding_rows.raw());
    guard let option::Option[metal::Buffer]::Some(layer_storage_0) = new_buffer(device, LAYER_STREAM_BYTES as u64) else { return 1; };
    let layer_storage_0_owner: OwnedObjc = OwnedObjc::new(layer_storage_0.raw());
    guard let option::Option[metal::Buffer]::Some(layer_storage_1) = new_buffer(device, LAYER_STREAM_BYTES as u64) else { return 1; };
    let layer_storage_1_owner: OwnedObjc = OwnedObjc::new(layer_storage_1.raw());
    guard let option::Option[metal::Buffer]::Some(hidden_a_buffer) = new_buffer(device, hidden_bytes) else { return 1; }; let hidden_a_owner: OwnedObjc = OwnedObjc::new(hidden_a_buffer.raw());
    guard let option::Option[metal::Buffer]::Some(hidden_b_buffer) = new_buffer(device, hidden_bytes) else { return 1; }; let hidden_b_owner: OwnedObjc = OwnedObjc::new(hidden_b_buffer.raw());
    var hidden_a: metal::Buffer = hidden_a_buffer;
    var hidden_b: metal::Buffer = hidden_b_buffer;
    guard let option::Option[metal::Buffer]::Some(norm) = new_buffer(device, hidden_bytes) else { return 1; }; let norm_owner: OwnedObjc = OwnedObjc::new(norm.raw());
    guard let option::Option[metal::Buffer]::Some(query) = new_buffer(device, hidden_bytes) else { return 1; }; let query_owner: OwnedObjc = OwnedObjc::new(query.raw());
    guard let option::Option[metal::Buffer]::Some(key) = new_buffer(device, kv_bytes) else { return 1; }; let key_owner: OwnedObjc = OwnedObjc::new(key.raw());
    guard let option::Option[metal::Buffer]::Some(value) = new_buffer(device, kv_bytes) else { return 1; }; let value_owner: OwnedObjc = OwnedObjc::new(value.raw());
    guard let option::Option[metal::Buffer]::Some(query_rope) = new_buffer(device, hidden_bytes) else { return 1; }; let query_rope_owner: OwnedObjc = OwnedObjc::new(query_rope.raw());
    guard let option::Option[metal::Buffer]::Some(key_rope) = new_buffer(device, kv_bytes) else { return 1; }; let key_rope_owner: OwnedObjc = OwnedObjc::new(key_rope.raw());
    guard let option::Option[metal::Buffer]::Some(attended) = new_buffer(device, hidden_bytes) else { return 1; }; let attended_owner: OwnedObjc = OwnedObjc::new(attended.raw());
    guard let option::Option[metal::Buffer]::Some(branch) = new_buffer(device, hidden_bytes) else { return 1; }; let branch_owner: OwnedObjc = OwnedObjc::new(branch.raw());
    guard let option::Option[metal::Buffer]::Some(gate) = new_buffer(device, intermediate_bytes) else { return 1; }; let gate_owner: OwnedObjc = OwnedObjc::new(gate.raw());
    guard let option::Option[metal::Buffer]::Some(up) = new_buffer(device, intermediate_bytes) else { return 1; }; let up_owner: OwnedObjc = OwnedObjc::new(up.raw());
    guard let option::Option[metal::Buffer]::Some(activated) = new_buffer(device, intermediate_bytes) else { return 1; }; let activated_owner: OwnedObjc = OwnedObjc::new(activated.raw());
    // QI_FORCE_TEXT_MPS_LINEAR lets the short-prompt oracle check this path.
    let use_mps_linear: bool = (rows >= MPS_LINEAR_MIN_ROWS
        || env::has_var("QI_FORCE_TEXT_MPS_LINEAR"))
        && !env::has_var("QI_DISABLE_TEXT_MPS_LINEAR") && mps::load_framework();
    guard let option::Option[metal::Buffer]::Some(linear_scratch) = new_buffer(
        device,
        if use_mps_linear {
            (INTERMEDIATE_WIDTH *% WIDTH *% #size_of::[f32]()) as u64
        } else { #size_of::[f32]() as u64 },
    ) else { return 1; };
    let linear_scratch_owner: OwnedObjc = OwnedObjc::new(linear_scratch.raw());
    let use_mps_attention: bool = use_mps_linear
        && !env::has_var("QI_DISABLE_TEXT_MPS_ATTENTION");
    guard let option::Option[metal::Buffer]::Some(attention_scores) = new_buffer(
        device,
        if use_mps_attention {
            (rows *% rows *% #size_of::[f32]()) as u64
        } else { #size_of::[f32]() as u64 },
    ) else { return 1; };
    let attention_scores_owner: OwnedObjc = OwnedObjc::new(attention_scores.raw());
    let mps_linear: MpsLinear = MpsLinear {
        enabled: use_mps_linear,
        device: device,
        scratch: linear_scratch,
    };
    let scratch_wall_ms: i64 = time::now_millis() - scratch_start_ms;

    let embedding_stream_start_ms: i64 = time::now_millis();
    let compact_ids: *u32 = ids.contents() as *u32;
    let compact_embedding: *u8 = embedding_rows.contents();
    let embedding_row_bytes: usize = WIDTH *% #size_of::[u16]();
    var embedding_row: usize = 0 as usize;
    while embedding_row < rows {
        compact_ids[embedding_row] = embedding_row as u32;
        let token: u64 = token_ids[embedding_row] as u64;
        if token >= VOCABULARY as u64 {
            io::eprintln("text encoder: token ID ${token} exceeds vocabulary");
            return 1;
        }
        if token_ids[embedding_row] == (151655 as u32) && !vision_embeddings.is_null() {
            let source_row: usize = visual_row_values[embedding_row] as usize;
            let destination: *u16 =
                (compact_embedding + embedding_row *% embedding_row_bytes) as *u16;
            var column: usize = 0 as usize;
            while column < WIDTH {
                destination[column] = cpu::f32_to_bf16(
                    vision_embeddings[source_row *% WIDTH +% column],
                );
                column = column +% (1 as usize);
            }
        } else {
            if !stream_source_range(
                reader_0,
                reader_1,
                reader_2,
                reader_3,
                compact_embedding + embedding_row *% embedding_row_bytes,
                embedding_source,
                token *% embedding_row_bytes as u64,
                embedding_row_bytes,
            ) {
                io::eprintln("text encoder: could not stream embedding row ${embedding_row}");
                return 1;
            }
        }
        embedding_row = embedding_row +% (1 as usize);
    }
    let embedding_stream_wall_ms: i64 = time::now_millis() - embedding_stream_start_ms;

    let execution_start_ms: i64 = time::now_millis();
    var params: TextParams = TextParams {
        rows: rows as u32,
        width: WIDTH as u32,
        heads: HEADS as u32,
        kv_heads: KV_HEADS as u32,
        head_dimension: HEAD_DIMENSION as u32,
        intermediate_width: INTERMEDIATE_WIDTH as u32,
        epsilon: 0.000001f32,
        rope_theta: 5000000.0f32,
    };
    guard let option::Option[f64]::Some(embedding_ms) = dispatch_element(queue, pipelines.embedding, ids, embedding_rows, hidden_a, #addr_of(params), rows *% WIDTH) else { return 1; };
    var total_ms: f64 = embedding_ms;
    var attention_total_ms: f64 = 0.0f64;
    if validate_reference {
        match normalized_rms_output(hidden_a, SYSTEM_PREFIX_TOKENS, output_rows, "tests/fixtures/text_encoder_fp32/embedding.f32") {
            option::Option[f64]::Some(error) => { io::println("text encoder embedding: nRMSE=${error}"); }
            option::Option[f64]::None => {}
        }
    }

    var layer: usize = 0 as usize;
    var prefetched_stream_wall_ms: i64 = 0 as i64;
    while layer < LAYERS {
        let layer_wall_start_ms: i64 = time::now_millis();
        let prefix: text::Text = "model.language_model.layers.${layer}.";
        guard let option::Option[SourceTensor]::Some(input_norm_source) = source_tensor(file_0, file_1, file_2, file_3, "${prefix}input_layernorm.weight", WIDTH as u64) else { return 1; };
        guard let option::Option[SourceTensor]::Some(q_weight_source) = source_tensor(file_0, file_1, file_2, file_3, "${prefix}self_attn.q_proj.weight", WIDTH as u64, WIDTH as u64) else { return 1; };
        guard let option::Option[SourceTensor]::Some(k_weight_source) = source_tensor(file_0, file_1, file_2, file_3, "${prefix}self_attn.k_proj.weight", KV_WIDTH as u64, WIDTH as u64) else { return 1; };
        guard let option::Option[SourceTensor]::Some(v_weight_source) = source_tensor(file_0, file_1, file_2, file_3, "${prefix}self_attn.v_proj.weight", KV_WIDTH as u64, WIDTH as u64) else { return 1; };
        guard let option::Option[SourceTensor]::Some(q_norm_source) = source_tensor(file_0, file_1, file_2, file_3, "${prefix}self_attn.q_norm.weight", HEAD_DIMENSION as u64) else { return 1; };
        guard let option::Option[SourceTensor]::Some(k_norm_source) = source_tensor(file_0, file_1, file_2, file_3, "${prefix}self_attn.k_norm.weight", HEAD_DIMENSION as u64) else { return 1; };
        guard let option::Option[SourceTensor]::Some(o_weight_source) = source_tensor(file_0, file_1, file_2, file_3, "${prefix}self_attn.o_proj.weight", WIDTH as u64, WIDTH as u64) else { return 1; };
        guard let option::Option[SourceTensor]::Some(post_norm_source) = source_tensor(file_0, file_1, file_2, file_3, "${prefix}post_attention_layernorm.weight", WIDTH as u64) else { return 1; };
        guard let option::Option[SourceTensor]::Some(gate_weight_source) = source_tensor(file_0, file_1, file_2, file_3, "${prefix}mlp.gate_proj.weight", INTERMEDIATE_WIDTH as u64, WIDTH as u64) else { return 1; };
        guard let option::Option[SourceTensor]::Some(up_weight_source) = source_tensor(file_0, file_1, file_2, file_3, "${prefix}mlp.up_proj.weight", INTERMEDIATE_WIDTH as u64, WIDTH as u64) else { return 1; };
        guard let option::Option[SourceTensor]::Some(down_weight_source) = source_tensor(file_0, file_1, file_2, file_3, "${prefix}mlp.down_proj.weight", WIDTH as u64, INTERMEDIATE_WIDTH as u64) else { return 1; };

        guard let option::Option[LayerSpanLayout]::Some(layout) = layer_span_layout(file_0, file_1, file_2, file_3, layer) else { return 1; };
        let span_0: ShardSpan = layout.span_0;
        let span_1: ShardSpan = layout.span_1;
        let span_2: ShardSpan = layout.span_2;
        let span_3: ShardSpan = layout.span_3;
        let layer_storage: metal::Buffer = if layer % (2 as usize) == (0 as usize) { layer_storage_0 } else { layer_storage_1 };
        var layer_stream_wall_ms: i64 = prefetched_stream_wall_ms;
        if layer == (0 as usize) {
            let layer_stream_start_ms: i64 = time::now_millis();
            let layer_destination: *u8 = layer_storage.contents();
            if !read_span_parallel(reader_0.descriptor(), layer_destination, span_0)
                || !read_span_parallel(reader_1.descriptor(), layer_destination, span_1)
                || !read_span_parallel(reader_2.descriptor(), layer_destination, span_2)
                || !read_span_parallel(reader_3.descriptor(), layer_destination, span_3) {
                io::eprintln("text encoder: could not stream layer ${layer}");
                return 1;
            }
            layer_stream_wall_ms = time::now_millis() - layer_stream_start_ms;
        }
        var next_layout: LayerSpanLayout = empty_layer_layout();
        if layer +% (1 as usize) < LAYERS {
            guard let option::Option[LayerSpanLayout]::Some(found_next_layout) = layer_span_layout(file_0, file_1, file_2, file_3, layer +% (1 as usize)) else { return 1; };
            next_layout = found_next_layout;
        }
        let next_storage: metal::Buffer = if layer % (2 as usize) == (0 as usize) { layer_storage_1 } else { layer_storage_0 };
        // Every exit below joins this worker first: it writes into a slot that
        // this function owns and releases on return.
        let prefetch_handle: thread::JoinHandle[i64] = thread::spawn_with::[LayerReadJob, i64](
            LayerReadJob {
                fd_0: reader_0.descriptor(),
                fd_1: reader_1.descriptor(),
                fd_2: reader_2.descriptor(),
                fd_3: reader_3.descriptor(),
                destination: next_storage.contents(),
                layout: next_layout,
            },
            read_layer_job,
        );
        let input_norm: Weight = streamed_weight(layer_storage, input_norm_source, span_0, span_1, span_2, span_3);
        let q_weight: Weight = streamed_weight(layer_storage, q_weight_source, span_0, span_1, span_2, span_3);
        let k_weight: Weight = streamed_weight(layer_storage, k_weight_source, span_0, span_1, span_2, span_3);
        let v_weight: Weight = streamed_weight(layer_storage, v_weight_source, span_0, span_1, span_2, span_3);
        let q_norm: Weight = streamed_weight(layer_storage, q_norm_source, span_0, span_1, span_2, span_3);
        let k_norm: Weight = streamed_weight(layer_storage, k_norm_source, span_0, span_1, span_2, span_3);
        let o_weight: Weight = streamed_weight(layer_storage, o_weight_source, span_0, span_1, span_2, span_3);
        let post_norm: Weight = streamed_weight(layer_storage, post_norm_source, span_0, span_1, span_2, span_3);
        let gate_weight: Weight = streamed_weight(layer_storage, gate_weight_source, span_0, span_1, span_2, span_3);
        let up_weight: Weight = streamed_weight(layer_storage, up_weight_source, span_0, span_1, span_2, span_3);
        let down_weight: Weight = streamed_weight(layer_storage, down_weight_source, span_0, span_1, span_2, span_3);

        guard let option::Option[f64]::Some(norm_ms) = dispatch_element(queue, pipelines.rms_norm, hidden_a, input_norm.storage, norm, #addr_of(params), rows, 0 as u64, input_norm.offset) else { let _joined: i64 = prefetch_handle.join(); return 1; }; total_ms = total_ms + norm_ms;
        guard let option::Option[f64]::Some(q_ms) = dispatch_linear_selected(queue, pipelines, mps_linear, norm, q_weight, query, rows, WIDTH, WIDTH) else { let _joined: i64 = prefetch_handle.join(); return 1; }; total_ms = total_ms + q_ms;
        guard let option::Option[f64]::Some(k_ms) = dispatch_linear_selected(queue, pipelines, mps_linear, norm, k_weight, key, rows, KV_WIDTH, WIDTH) else { let _joined: i64 = prefetch_handle.join(); return 1; }; total_ms = total_ms + k_ms;
        guard let option::Option[f64]::Some(v_ms) = dispatch_linear_selected(queue, pipelines, mps_linear, norm, v_weight, value, rows, KV_WIDTH, WIDTH) else { let _joined: i64 = prefetch_handle.join(); return 1; }; total_ms = total_ms + v_ms;
        params.heads = HEADS as u32;
        guard let option::Option[f64]::Some(q_rope_ms) = dispatch_qk_rope(
            queue, pipelines.qk_norm_rope, query, q_norm, query_rope,
            positions, #addr_of(params), rows *% HEADS,
        ) else { let _joined: i64 = prefetch_handle.join(); return 1; }; total_ms = total_ms + q_rope_ms;
        params.heads = KV_HEADS as u32;
        guard let option::Option[f64]::Some(k_rope_ms) = dispatch_qk_rope(
            queue, pipelines.qk_norm_rope, key, k_norm, key_rope,
            positions, #addr_of(params), rows *% KV_HEADS,
        ) else { let _joined: i64 = prefetch_handle.join(); return 1; }; total_ms = total_ms + k_rope_ms;
        params.heads = HEADS as u32;
        guard let option::Option[f64]::Some(attention_ms) = if use_mps_attention { dispatch_attention_mps(queue, pipelines, mps_linear, query_rope, key_rope, attended, value, attention_scores, rows) } else { dispatch_attention(queue, pipelines.attention, query_rope, key_rope, attended, value, #addr_of(params)) } else { let _joined: i64 = prefetch_handle.join(); return 1; }; total_ms = total_ms + attention_ms; attention_total_ms = attention_total_ms + attention_ms;
        guard let option::Option[f64]::Some(o_ms) = dispatch_linear_selected(queue, pipelines, mps_linear, attended, o_weight, branch, rows, WIDTH, WIDTH) else { let _joined: i64 = prefetch_handle.join(); return 1; }; total_ms = total_ms + o_ms;
        guard let option::Option[f64]::Some(add_attention_ms) = dispatch_element(queue, pipelines.add, hidden_a, branch, hidden_b, #addr_of(params), rows *% WIDTH) else { let _joined: i64 = prefetch_handle.join(); return 1; }; total_ms = total_ms + add_attention_ms;
        guard let option::Option[f64]::Some(post_norm_ms) = dispatch_element(queue, pipelines.rms_norm, hidden_b, post_norm.storage, norm, #addr_of(params), rows, 0 as u64, post_norm.offset) else { let _joined: i64 = prefetch_handle.join(); return 1; }; total_ms = total_ms + post_norm_ms;
        guard let option::Option[f64]::Some(gate_ms) = dispatch_linear_selected(queue, pipelines, mps_linear, norm, gate_weight, gate, rows, INTERMEDIATE_WIDTH, WIDTH) else { let _joined: i64 = prefetch_handle.join(); return 1; }; total_ms = total_ms + gate_ms;
        guard let option::Option[f64]::Some(up_ms) = dispatch_linear_selected(queue, pipelines, mps_linear, norm, up_weight, up, rows, INTERMEDIATE_WIDTH, WIDTH) else { let _joined: i64 = prefetch_handle.join(); return 1; }; total_ms = total_ms + up_ms;
        guard let option::Option[f64]::Some(swiglu_ms) = dispatch_element(queue, pipelines.swiglu, gate, up, activated, #addr_of(params), rows *% INTERMEDIATE_WIDTH) else { let _joined: i64 = prefetch_handle.join(); return 1; }; total_ms = total_ms + swiglu_ms;
        guard let option::Option[f64]::Some(down_ms) = dispatch_linear_selected(queue, pipelines, mps_linear, activated, down_weight, branch, rows, WIDTH, INTERMEDIATE_WIDTH) else { let _joined: i64 = prefetch_handle.join(); return 1; }; total_ms = total_ms + down_ms;
        guard let option::Option[f64]::Some(add_mlp_ms) = dispatch_element(queue, pipelines.add, hidden_b, branch, hidden_a, #addr_of(params), rows *% WIDTH) else { let _joined: i64 = prefetch_handle.join(); return 1; }; total_ms = total_ms + add_mlp_ms;
        if layer < (3 as usize) && vision_token_count > (0 as usize) {
            let deepstack_offset: u64 =
                (layer *% vision_token_count *% WIDTH *% #size_of::[f32]()) as u64;
            guard let option::Option[f64]::Some(deepstack_ms) = dispatch_add_visual(
                queue, pipelines.add_visual, hidden_a, deepstack, deepstack_offset,
                hidden_b, visual_rows, #addr_of(params),
            ) else { let _joined: i64 = prefetch_handle.join(); return 1; };
            total_ms = total_ms + deepstack_ms;
            let swapped: metal::Buffer = hidden_a;
            hidden_a = hidden_b;
            hidden_b = swapped;
        }
        let prefetch_wait_start_ms: i64 = time::now_millis();
        prefetched_stream_wall_ms = prefetch_handle.join();
        let prefetch_wait_wall_ms: i64 = time::now_millis() - prefetch_wait_start_ms;
        if prefetched_stream_wall_ms < (0 as i64) {
            io::eprintln("text encoder: could not prefetch layer ${layer +% (1 as usize)}");
            return 1;
        }
        io::println("text encoder: layer=${layer} bytes=${layout.bytes} stream_ms=${layer_stream_wall_ms} next_stream_ms=${prefetched_stream_wall_ms} prefetch_wait_ms=${prefetch_wait_wall_ms} cumulative_gpu_ms=${total_ms} wall_ms=${time::now_millis() - layer_wall_start_ms} cumulative_wall_ms=${time::now_millis() - execution_start_ms}");
        if validate_reference && (
            layer == (0 as usize) || layer == (17 as usize) || layer == (23 as usize)
                || layer >= (31 as usize)
        ) {
            let fixture_name: str = if layer == (0 as usize) {
                "layer_00"
            } else if layer == (17 as usize) {
                "layer_17"
            } else if layer == (23 as usize) {
                "layer_23"
            } else if layer == (31 as usize) {
                "layer_31"
            } else if layer == (32 as usize) {
                "layer_32"
            } else if layer == (33 as usize) {
                "layer_33"
            } else if layer == (34 as usize) {
                "layer_34"
            } else {
                "layer_35"
            };
            let boundary_path: text::Text = "tests/fixtures/text_encoder_fp32/${fixture_name}.f32";
            match normalized_rms_output(hidden_a, SYSTEM_PREFIX_TOKENS, rows -% SYSTEM_PREFIX_TOKENS, boundary_path.view()) {
                option::Option[f64]::Some(boundary_error) => { io::println("text encoder ${fixture_name}: nRMSE=${boundary_error}"); }
                option::Option[f64]::None => {}
            }
        }
        layer = layer +% (1 as usize);
    }

    let finite_ok: bool = finite(hidden_a, rows *% WIDTH);
    if !finite_ok { return 1; }
    let execution_wall_ms: i64 = time::now_millis() - execution_start_ms;
    io::println(
        "text encoder timing: mapping_ms=${mapping_wall_ms} reader_open_ms=${reader_wall_ms} device_queue_ms=${device_queue_wall_ms} metal_compile_pipeline_ms=${compile_wall_ms} scratch_buffers_ms=${scratch_wall_ms} embedding_stream_ms=${embedding_stream_wall_ms} execution_ms=${execution_wall_ms} total_wall_ms=${time::now_millis() - run_wall_start_ms}",
    );
    if !output.is_null() {
        let values: *f32 = hidden_a.contents() as *f32;
        let source_offset: usize = SYSTEM_PREFIX_TOKENS *% WIDTH;
        var output_index: usize = 0 as usize;
        while output_index < output_values {
            output[output_index] = values[source_offset +% output_index];
            output_index = output_index +% (1 as usize);
        }
    }
    if !output_row_count.is_null() { *output_row_count = output_rows; }
    if validate_reference {
        guard let option::Option[f64]::Some(error) = normalized_rms_output(hidden_a, SYSTEM_PREFIX_TOKENS, output_rows, fixture_path) else { return 1; };
        io::println("Qwen3-VL text encoder: full_tokens=${rows} output_tokens=${output_rows} gpu_ms=${total_ms} output_nRMSE=${error} finite=${finite_ok}");
        if error > (0.04f64) { return 1; }
        io::println("Qwen3-VL native text conditioning: verified");
    } else {
        io::println("Qwen3-VL text encoder: full_tokens=${rows} output_tokens=${output_rows} gpu_ms=${total_ms} attention_gpu_ms=${attention_total_ms} mps_linear=${use_mps_linear} mps_attention=${use_mps_attention} finite=${finite_ok}");
    }
    return 0;
}

// The integrated pipeline entry point: the caller owns the token IDs it
// already produced, so no tokenizer assets are loaded here.
fn encode_tokens_to_host(
    model_root: str,
    token_ids: *u32,
    token_count: usize,
    output: *f32,
    output_capacity: usize,
    output_row_count: *usize,
) -> i32 {
    if output.is_null() || output_row_count.is_null() {
        io::eprintln("text encoder: integrated output pointers must not be null");
        return 2;
    }
    return run_impl(
        model_root,
        token_ids,
        token_count,
        "",
        output,
        output_capacity,
        output_row_count,
        false,
    );
}

fn encode_multimodal_tokens_to_host(
    model_root: str,
    token_ids: *u32,
    token_count: usize,
    position_ids: *u32,
    vision_embeddings: *f32,
    vision_token_count: usize,
    deepstack_embeddings: *f32,
    output: *f32,
    output_capacity: usize,
    output_row_count: *usize,
) -> i32 {
    if output.is_null() || output_row_count.is_null() {
        io::eprintln("text encoder: integrated output pointers must not be null");
        return 2;
    }
    return run_impl(
        model_root, token_ids, token_count, "", output, output_capacity,
        output_row_count, false, position_ids, vision_embeddings,
        vision_token_count, deepstack_embeddings,
    );
}

// Retained for callers that hold only a prompt string; it tokenizes once and
// forwards the IDs.
fn encode_prompt_to_host(
    model_root: str,
    prompt: str,
    output: *f32,
    output_capacity: usize,
    output_row_count: *usize,
) -> i32 {
    if output.is_null() || output_row_count.is_null() {
        io::eprintln("text encoder: integrated output pointers must not be null");
        return 2;
    }
    guard let option::Option[vec::Vec[u32]]::Some(token_ids) =
        tokenizer::tokenize_full_prompt(model_root, prompt) else {
        return 1;
    };
    return run_impl(
        model_root,
        #slice_ptr(token_ids.as_slice()),
        token_ids.count(),
        "",
        output,
        output_capacity,
        output_row_count,
        false,
    );
}

fn run(
    model_root: str,
    prompt: str = "A red fox asleep beside a mossy stone in soft morning light.",
    fixture_path: str = "tests/fixtures/trajectory_256_fp32/text_input.f32",
) -> i32 {
    guard let option::Option[vec::Vec[u32]]::Some(token_ids) =
        tokenizer::tokenize_full_prompt(model_root, prompt) else {
        return 1;
    };
    return run_impl(
        model_root,
        #slice_ptr(token_ids.as_slice()),
        token_ids.count(),
        fixture_path,
        0 as *f32,
        0 as usize,
        0 as *usize,
        true,
    );
}
