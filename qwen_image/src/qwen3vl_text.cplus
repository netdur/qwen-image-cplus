import "./mmap_macos" as mapped;
import "./mps_matrix" as mps;
import "./cpu_ops" as cpu;
import "./safetensors" as safetensors;
import "./tokenizer" as tokenizer;
import "metal/metal" as metal;
import "objc/bridge" as bridge;
import "objc/runtime" as rt;
import "stdlib/env" as env;
import "stdlib/io" as io;
import "stdlib/math" as _;
import "stdlib/option" as option;
import "stdlib/status" as status;
import "stdlib/text" as text;
import "stdlib/thread" as thread;
import "stdlib/time" as time;
import "stdlib/vec" as vec;

extern fn MTLCreateSystemDefaultDevice() -> *u8;

const WIDTH: usize = 4096;
const HEADS: usize = 32;
const KV_HEADS: usize = 8;
const HEAD_DIMENSION: usize = 128;
const KV_WIDTH: usize = KV_HEADS * HEAD_DIMENSION;
const INTERMEDIATE_WIDTH: usize = 12288;
const LAYERS: usize = 36;
const VOCABULARY: usize = 151936;
const SYSTEM_PREFIX_TOKENS: usize = 14;
const TILE: usize = 16;
const LAYER_STREAM_BYTES: usize = 416 * 1024 * 1024;
// F_NOCACHE reads take the direct path only when the file offset, the
// destination and the length are page-aligned. Every layer span starts at an
// unaligned offset in the shards, so spans are widened to whole 16 KiB pages
// and placed at page-aligned destinations. Each span is then read by
// STREAM_READ_THREADS page-aligned jobs, like the transformer pack copy.
const STREAM_ALIGNMENT: usize = 16384;
const STREAM_READ_THREADS: usize = 8;

struct OwnedObjc {
    opaque pointer: *u8,
}

impl OwnedObjc {
    fn new(pointer: *u8) -> OwnedObjc { return OwnedObjc { pointer: pointer }; }
    fn raw(this) -> *u8 { return this.pointer; }
    fn drop(ref this) {
        if !this.pointer.is_null() {
            rt::release(this.pointer);
            this.pointer = 0 as *u8;
        }
    }
}

#[repr(C)]
struct LinearParams {
    rows: u32,
    output_columns: u32,
    input_columns: u32,
    weight_mode: u32,
}

#[repr(C)]
struct TextParams {
    rows: u32,
    width: u32,
    heads: u32,
    kv_heads: u32,
    head_dimension: u32,
    intermediate_width: u32,
    epsilon: f32,
    rope_theta: f32,
}

struct Weight {
    storage: metal::Buffer,
    offset: u64,
}

struct SourceTensor {
    tensor: safetensors::TensorData,
    shard: u32,
}

struct ShardSpan {
    begin: u64,
    end: u64,
    destination: u64,
}

struct LayerSpanLayout {
    span_0: ShardSpan,
    span_1: ShardSpan,
    span_2: ShardSpan,
    span_3: ShardSpan,
    bytes: u64,
}

struct LayerReadJob {
    fd_0: i32,
    fd_1: i32,
    fd_2: i32,
    fd_3: i32,
    opaque destination: *u8,
    layout: LayerSpanLayout,
}

impl LayerReadJob: Send {}

impl ShardSpan {
    fn empty() -> ShardSpan {
        return ShardSpan {
            begin: (0 as u64) -% (1 as u64),
            end: 0 as u64,
            destination: 0 as u64,
        };
    }

    fn include(ref this, tensor: safetensors::TensorData) {
        if tensor.file_offset < this.begin { this.begin = tensor.file_offset; }
        let end: u64 = tensor.file_offset +% tensor.byte_length;
        if end > this.end { this.end = end; }
    }

    fn length(this) -> u64 {
        if this.end <= this.begin { return 0 as u64; }
        return this.end -% this.begin;
    }
}

struct Pipelines {
    embedding: metal::ComputePipelineState,
    rms_norm: metal::ComputePipelineState,
    linear: metal::ComputePipelineState,
    qk_norm_rope: metal::ComputePipelineState,
    attention: metal::ComputePipelineState,
    add: metal::ComputePipelineState,
    add_visual: metal::ComputePipelineState,
    swiglu: metal::ComputePipelineState,
    bf16_to_f32: metal::ComputePipelineState,
    round_bf16: metal::ComputePipelineState,
    causal_softmax: metal::ComputePipelineState,
}

// Long prompts (reference images add a vision token per merged patch) run
// the linears as MPS FP32 multiplications. `scratch` holds one expanded FP32
// weight matrix at a time.
struct MpsLinear {
    enabled: bool,
    device: metal::Device,
    scratch: metal::Buffer,
}

// Below this many rows the linears are bandwidth-bound on the BF16 weights,
// and expanding them to FP32 first would cost more than it saves.
const MPS_LINEAR_MIN_ROWS: usize = 256;

fn round_up(value: usize, alignment: usize) -> usize {
    return (value +% alignment -% (1 as usize)) / alignment *% alignment;
}

fn new_buffer(device: metal::Device, bytes: u64) -> option::Option[metal::Buffer] {
    return device.new_buffer_with_length(
        bytes,
        metal::resource_options_m_t_l_resource_storage_mode_shared,
    );
}

fn pipeline(device: metal::Device, library: metal::Library, name: str) -> option::Option[OwnedObjc] {
    guard let option::Option[metal::Function]::Some(function) = library.new_function_with_name(name) else {
        io::eprintln("text encoder: missing Metal function ${name}");
        return option::Option[OwnedObjc]::None;
    };
    let function_owner: OwnedObjc = OwnedObjc::new(function.raw());
    var error: *u8 = 0 as *u8;
    guard let option::Option[metal::ComputePipelineState]::Some(state) =
        device.new_compute_pipeline_state_with_function(function, #addr_of(error) as *u8) else {
        io::eprintln("text encoder: could not build Metal pipeline ${name}");
        return option::Option[OwnedObjc]::None;
    };
    return option::Option[OwnedObjc]::Some(OwnedObjc::new(state.raw()));
}

fn source_tensor_in(
    file: safetensors::File,
    shard: u32,
    name: str,
    dimension_0: u64,
    dimension_1: u64 = 0 as u64,
) -> option::Option[SourceTensor] {
    if !file.has_tensor(name) { return option::Option[SourceTensor]::None; }
    guard let option::Option[safetensors::TensorData]::Some(tensor) = file.tensor(name) else {
        return option::Option[SourceTensor]::None;
    };
    let rank: usize = if dimension_1 == (0 as u64) { 1 as usize } else { 2 as usize };
    if tensor.dtype.name() != "BF16" || tensor.rank != rank
        || tensor.dimensions[0] != dimension_0
        || (rank == (2 as usize) && tensor.dimensions[1] != dimension_1) {
        io::eprintln("text encoder: invalid tensor metadata for ${name}");
        return option::Option[SourceTensor]::None;
    }
    return option::Option[SourceTensor]::Some(SourceTensor { tensor: tensor, shard: shard });
}

fn source_tensor(
    file_0: safetensors::File,
    file_1: safetensors::File,
    file_2: safetensors::File,
    file_3: safetensors::File,
    name: str,
    dimension_0: u64,
    dimension_1: u64 = 0 as u64,
) -> option::Option[SourceTensor] {
    if file_0.has_tensor(name) { return source_tensor_in(file_0, 0 as u32, name, dimension_0, dimension_1); }
    if file_1.has_tensor(name) { return source_tensor_in(file_1, 1 as u32, name, dimension_0, dimension_1); }
    if file_2.has_tensor(name) { return source_tensor_in(file_2, 2 as u32, name, dimension_0, dimension_1); }
    if file_3.has_tensor(name) { return source_tensor_in(file_3, 3 as u32, name, dimension_0, dimension_1); }
    io::eprintln("text encoder: missing tensor ${name}");
    return option::Option[SourceTensor]::None;
}

fn include_source(
    ref span_0: ShardSpan,
    ref span_1: ShardSpan,
    ref span_2: ShardSpan,
    ref span_3: ShardSpan,
    source: SourceTensor,
) {
    if source.shard == (0 as u32) { span_0.include(source.tensor); }
    else if source.shard == (1 as u32) { span_1.include(source.tensor); }
    else if source.shard == (2 as u32) { span_2.include(source.tensor); }
    else { span_3.include(source.tensor); }
}

// Widens a non-empty span to whole pages, clamped to the shard's end.
fn align_span(ref span: ShardSpan, file_length: u64) {
    if span.length() == (0 as u64) { return; }
    span.begin = span.begin / STREAM_ALIGNMENT as u64 *% STREAM_ALIGNMENT as u64;
    let aligned_end: u64 = round_up(span.end as usize, STREAM_ALIGNMENT) as u64;
    span.end = if aligned_end < file_length { aligned_end } else { file_length };
}

fn place_span(ref span: ShardSpan, destination: u64) -> u64 {
    span.destination = destination;
    return round_up((destination +% span.length()) as usize, STREAM_ALIGNMENT) as u64;
}

fn stream_source_range(
    reader_0: mapped::PositionalReader,
    reader_1: mapped::PositionalReader,
    reader_2: mapped::PositionalReader,
    reader_3: mapped::PositionalReader,
    destination: *u8,
    source: SourceTensor,
    source_offset: u64,
    length: usize,
) -> bool {
    let file_offset: u64 = source.tensor.file_offset +% source_offset;
    if source.shard == (0 as u32) { return reader_0.read_at(destination, length, file_offset); }
    if source.shard == (1 as u32) { return reader_1.read_at(destination, length, file_offset); }
    if source.shard == (2 as u32) { return reader_2.read_at(destination, length, file_offset); }
    return reader_3.read_at(destination, length, file_offset);
}

fn streamed_weight(
    storage: metal::Buffer,
    source: SourceTensor,
    span_0: ShardSpan,
    span_1: ShardSpan,
    span_2: ShardSpan,
    span_3: ShardSpan,
) -> Weight {
    let span: ShardSpan = if source.shard == (0 as u32) { span_0 }
    else if source.shard == (1 as u32) { span_1 }
    else if source.shard == (2 as u32) { span_2 }
    else { span_3 };
    return Weight {
        storage: storage,
        offset: span.destination +% (source.tensor.file_offset -% span.begin),
    };
}

fn empty_layer_layout() -> LayerSpanLayout {
    return LayerSpanLayout {
        span_0: ShardSpan::empty(),
        span_1: ShardSpan::empty(),
        span_2: ShardSpan::empty(),
        span_3: ShardSpan::empty(),
        bytes: 0 as u64,
    };
}

fn layer_span_layout(
    file_0: safetensors::File,
    file_1: safetensors::File,
    file_2: safetensors::File,
    file_3: safetensors::File,
    layer: usize,
) -> option::Option[LayerSpanLayout] {
    let prefix: text::Text = "model.language_model.layers.${layer}.";
    guard let option::Option[SourceTensor]::Some(input_norm) = source_tensor(file_0, file_1, file_2, file_3, "${prefix}input_layernorm.weight", WIDTH as u64) else { return option::Option[LayerSpanLayout]::None; };
    guard let option::Option[SourceTensor]::Some(q_weight) = source_tensor(file_0, file_1, file_2, file_3, "${prefix}self_attn.q_proj.weight", WIDTH as u64, WIDTH as u64) else { return option::Option[LayerSpanLayout]::None; };
    guard let option::Option[SourceTensor]::Some(k_weight) = source_tensor(file_0, file_1, file_2, file_3, "${prefix}self_attn.k_proj.weight", KV_WIDTH as u64, WIDTH as u64) else { return option::Option[LayerSpanLayout]::None; };
    guard let option::Option[SourceTensor]::Some(v_weight) = source_tensor(file_0, file_1, file_2, file_3, "${prefix}self_attn.v_proj.weight", KV_WIDTH as u64, WIDTH as u64) else { return option::Option[LayerSpanLayout]::None; };
    guard let option::Option[SourceTensor]::Some(q_norm) = source_tensor(file_0, file_1, file_2, file_3, "${prefix}self_attn.q_norm.weight", HEAD_DIMENSION as u64) else { return option::Option[LayerSpanLayout]::None; };
    guard let option::Option[SourceTensor]::Some(k_norm) = source_tensor(file_0, file_1, file_2, file_3, "${prefix}self_attn.k_norm.weight", HEAD_DIMENSION as u64) else { return option::Option[LayerSpanLayout]::None; };
    guard let option::Option[SourceTensor]::Some(o_weight) = source_tensor(file_0, file_1, file_2, file_3, "${prefix}self_attn.o_proj.weight", WIDTH as u64, WIDTH as u64) else { return option::Option[LayerSpanLayout]::None; };
    guard let option::Option[SourceTensor]::Some(post_norm) = source_tensor(file_0, file_1, file_2, file_3, "${prefix}post_attention_layernorm.weight", WIDTH as u64) else { return option::Option[LayerSpanLayout]::None; };
    guard let option::Option[SourceTensor]::Some(gate_weight) = source_tensor(file_0, file_1, file_2, file_3, "${prefix}mlp.gate_proj.weight", INTERMEDIATE_WIDTH as u64, WIDTH as u64) else { return option::Option[LayerSpanLayout]::None; };
    guard let option::Option[SourceTensor]::Some(up_weight) = source_tensor(file_0, file_1, file_2, file_3, "${prefix}mlp.up_proj.weight", INTERMEDIATE_WIDTH as u64, WIDTH as u64) else { return option::Option[LayerSpanLayout]::None; };
    guard let option::Option[SourceTensor]::Some(down_weight) = source_tensor(file_0, file_1, file_2, file_3, "${prefix}mlp.down_proj.weight", WIDTH as u64, INTERMEDIATE_WIDTH as u64) else { return option::Option[LayerSpanLayout]::None; };
    var layout: LayerSpanLayout = empty_layer_layout();
    include_source(layout.span_0, layout.span_1, layout.span_2, layout.span_3, input_norm);
    include_source(layout.span_0, layout.span_1, layout.span_2, layout.span_3, q_weight);
    include_source(layout.span_0, layout.span_1, layout.span_2, layout.span_3, k_weight);
    include_source(layout.span_0, layout.span_1, layout.span_2, layout.span_3, v_weight);
    include_source(layout.span_0, layout.span_1, layout.span_2, layout.span_3, q_norm);
    include_source(layout.span_0, layout.span_1, layout.span_2, layout.span_3, k_norm);
    include_source(layout.span_0, layout.span_1, layout.span_2, layout.span_3, o_weight);
    include_source(layout.span_0, layout.span_1, layout.span_2, layout.span_3, post_norm);
    include_source(layout.span_0, layout.span_1, layout.span_2, layout.span_3, gate_weight);
    include_source(layout.span_0, layout.span_1, layout.span_2, layout.span_3, up_weight);
    include_source(layout.span_0, layout.span_1, layout.span_2, layout.span_3, down_weight);
    align_span(layout.span_0, file_0.mapping_length() as u64);
    align_span(layout.span_1, file_1.mapping_length() as u64);
    align_span(layout.span_2, file_2.mapping_length() as u64);
    align_span(layout.span_3, file_3.mapping_length() as u64);
    layout.bytes = place_span(layout.span_0, 0 as u64);
    layout.bytes = place_span(layout.span_1, layout.bytes);
    layout.bytes = place_span(layout.span_2, layout.bytes);
    layout.bytes = place_span(layout.span_3, layout.bytes);
    if layout.bytes > LAYER_STREAM_BYTES as u64 {
        io::eprintln("text encoder: layer ${layer} stream needs ${layout.bytes} bytes, capacity is ${LAYER_STREAM_BYTES}");
        return option::Option[LayerSpanLayout]::None;
    }
    return option::Option[LayerSpanLayout]::Some(layout);
}

struct SpanChunkJob {
    fd: i32,
    opaque destination: *u8,
    offset: u64,
    length: usize,
}

impl SpanChunkJob: Send {}

fn read_span_chunk(take job: SpanChunkJob) -> i64 {
    return if mapped::read_at_descriptor(job.fd, job.destination, job.length, job.offset) {
        0 as i64
    } else { -1 as i64 };
}

// Reads one span with up to STREAM_READ_THREADS page-aligned jobs. Every job
// is joined before returning, including on failure.
fn read_span_parallel(fd: i32, base: *u8, span: ShardSpan) -> bool {
    let length: usize = span.length() as usize;
    if length == (0 as usize) { return true; }
    let chunk: usize = round_up(length / STREAM_READ_THREADS +% (1 as usize), STREAM_ALIGNMENT);
    var handles: vec::Vec[thread::JoinHandle[i64]] =
        vec::Vec[thread::JoinHandle[i64]]::with_capacity(STREAM_READ_THREADS);
    var ok: bool = true;
    var start: usize = 0 as usize;
    while start < length {
        let count: usize = if length -% start < chunk { length -% start } else { chunk };
        let handle: thread::JoinHandle[i64] = thread::spawn_with::[SpanChunkJob, i64](
            SpanChunkJob {
                fd: fd,
                destination: base + span.destination as usize + start,
                offset: span.begin +% start as u64,
                length: count,
            },
            read_span_chunk,
        );
        if handles.append(handle) != status::Status::Ok {
            ok = false;
            break;
        }
        start = start +% count;
    }
    while handles.count() > (0 as usize) {
        guard let option::Option[thread::JoinHandle[i64]]::Some(handle) = handles.remove_last() else {
            return false;
        };
        if handle.join() != (0 as i64) { ok = false; }
    }
    return ok;
}

fn read_layer_job(take job: LayerReadJob) -> i64 {
    let started_ms: i64 = time::now_millis();
    if !read_span_parallel(job.fd_0, job.destination, job.layout.span_0)
        || !read_span_parallel(job.fd_1, job.destination, job.layout.span_1)
        || !read_span_parallel(job.fd_2, job.destination, job.layout.span_2)
        || !read_span_parallel(job.fd_3, job.destination, job.layout.span_3) {
        return -1 as i64;
    }
    return time::now_millis() - started_ms;
}

fn dispatch_linear(
    queue: metal::CommandQueue,
    pipeline_state: metal::ComputePipelineState,
    input: metal::Buffer,
    weight: Weight,
    output: metal::Buffer,
    rows: usize,
    output_columns: usize,
    input_columns: usize,
) -> option::Option[f64] {
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return option::Option[f64]::None; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    guard let option::Option[metal::CommandBuffer]::Some(command_buffer) = queue.command_buffer() else { return option::Option[f64]::None; };
    let command_buffer_owner: OwnedObjc = OwnedObjc::new(rt::retain(command_buffer.raw()));
    guard let option::Option[metal::ComputeCommandEncoder]::Some(encoder) = command_buffer.compute_command_encoder() else { return option::Option[f64]::None; };
    let encoder_owner: OwnedObjc = OwnedObjc::new(rt::retain(encoder.raw()));
    var params: LinearParams = LinearParams {
        rows: rows as u32,
        output_columns: output_columns as u32,
        input_columns: input_columns as u32,
        weight_mode: 0 as u32,
    };
    encoder.set_compute_pipeline_state(pipeline_state);
    encoder.set_buffer(input, 0 as u64, 0 as u64);
    encoder.set_buffer(weight.storage, weight.offset, 1 as u64);
    encoder.set_buffer(output, 0 as u64, 2 as u64);
    encoder.set_bytes(#addr_of(params) as *u8, #size_of::[LinearParams]() as u64, 3 as u64);
    encoder.dispatch_threads(
        metal::Size { width: round_up(output_columns, TILE) as u64, height: round_up(rows, TILE) as u64, depth: 1 as u64 },
        metal::Size { width: TILE as u64, height: TILE as u64, depth: 1 as u64 },
    );
    metal::CommandEncoder::from_raw(encoder.raw()).end_encoding();
    command_buffer.commit();
    command_buffer.wait_until_completed();
    return option::Option[f64]::Some((command_buffer.g_p_u_end_time() - command_buffer.g_p_u_start_time()) * 1000.0f64);
}

fn dispatch_one_count(
    encoder: metal::ComputeCommandEncoder,
    pipeline_state: metal::ComputePipelineState,
    count: usize,
) {
    let width: u64 = pipeline_state.thread_execution_width();
    encoder.dispatch_threads(
        metal::Size { width: count as u64, height: 1 as u64, depth: 1 as u64 },
        metal::Size { width: width, height: 1 as u64, depth: 1 as u64 },
    );
}

// output[rows, out] = bf16(input[rows, in] x W^T) with W the BF16 [out, in]
// weight: the weight is expanded to FP32 scratch, multiplied by MPS, and the
// result rounded to BF16, all in one command buffer.
fn dispatch_linear_mps(
    queue: metal::CommandQueue,
    pipelines: Pipelines,
    linear: MpsLinear,
    input: metal::Buffer,
    weight: Weight,
    output: metal::Buffer,
    rows: usize,
    output_columns: usize,
    input_columns: usize,
) -> option::Option[f64] {
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return option::Option[f64]::None; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    guard let option::Option[mps::Multiplication]::Some(operation) = mps::create_fp32(
        linear.device,
        mps::Fp32Operand { buffer: input, offset: 0 as u64, rows: rows, columns: input_columns, row_bytes: input_columns *% #size_of::[f32]() },
        mps::Fp32Operand { buffer: linear.scratch, offset: 0 as u64, rows: output_columns, columns: input_columns, row_bytes: input_columns *% #size_of::[f32]() },
        mps::Fp32Operand { buffer: output, offset: 0 as u64, rows: rows, columns: output_columns, row_bytes: output_columns *% #size_of::[f32]() },
        false, true, input_columns, 1.0f64,
    ) else { return option::Option[f64]::None; };
    guard let option::Option[metal::CommandBuffer]::Some(command_buffer) = queue.command_buffer() else { return option::Option[f64]::None; };
    let command_buffer_owner: OwnedObjc = OwnedObjc::new(rt::retain(command_buffer.raw()));
    guard let option::Option[metal::ComputeCommandEncoder]::Some(convert_encoder) = command_buffer.compute_command_encoder() else { return option::Option[f64]::None; };
    let convert_encoder_owner: OwnedObjc = OwnedObjc::new(rt::retain(convert_encoder.raw()));
    var weight_count: u32 = (output_columns *% input_columns) as u32;
    convert_encoder.set_compute_pipeline_state(pipelines.bf16_to_f32);
    convert_encoder.set_buffer(weight.storage, weight.offset, 0 as u64);
    convert_encoder.set_buffer(linear.scratch, 0 as u64, 1 as u64);
    convert_encoder.set_bytes(#addr_of(weight_count) as *u8, #size_of::[u32]() as u64, 2 as u64);
    dispatch_one_count(convert_encoder, pipelines.bf16_to_f32, weight_count as usize);
    metal::CommandEncoder::from_raw(convert_encoder.raw()).end_encoding();
    operation.encode(command_buffer);
    guard let option::Option[metal::ComputeCommandEncoder]::Some(round_encoder) = command_buffer.compute_command_encoder() else { return option::Option[f64]::None; };
    let round_encoder_owner: OwnedObjc = OwnedObjc::new(rt::retain(round_encoder.raw()));
    var output_count: u32 = (rows *% output_columns) as u32;
    round_encoder.set_compute_pipeline_state(pipelines.round_bf16);
    round_encoder.set_buffer(output, 0 as u64, 0 as u64);
    round_encoder.set_bytes(#addr_of(output_count) as *u8, #size_of::[u32]() as u64, 1 as u64);
    dispatch_one_count(round_encoder, pipelines.round_bf16, output_count as usize);
    metal::CommandEncoder::from_raw(round_encoder.raw()).end_encoding();
    command_buffer.commit();
    command_buffer.wait_until_completed();
    return option::Option[f64]::Some((command_buffer.g_p_u_end_time() - command_buffer.g_p_u_start_time()) * 1000.0f64);
}

fn dispatch_linear_selected(
    queue: metal::CommandQueue,
    pipelines: Pipelines,
    linear: MpsLinear,
    input: metal::Buffer,
    weight: Weight,
    output: metal::Buffer,
    rows: usize,
    output_columns: usize,
    input_columns: usize,
) -> option::Option[f64] {
    if linear.enabled {
        return dispatch_linear_mps(
            queue, pipelines, linear, input, weight, output, rows, output_columns, input_columns,
        );
    }
    return dispatch_linear(
        queue, pipelines.linear, input, weight, output, rows, output_columns, input_columns,
    );
}

fn dispatch_element(
    queue: metal::CommandQueue,
    pipeline_state: metal::ComputePipelineState,
    buffer_0: metal::Buffer,
    buffer_1: metal::Buffer,
    buffer_2: metal::Buffer,
    params: *TextParams,
    threads: usize,
    buffer_0_offset: u64 = 0 as u64,
    buffer_1_offset: u64 = 0 as u64,
    buffer_2_offset: u64 = 0 as u64,
) -> option::Option[f64] {
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return option::Option[f64]::None; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    guard let option::Option[metal::CommandBuffer]::Some(command_buffer) = queue.command_buffer() else { return option::Option[f64]::None; };
    let command_buffer_owner: OwnedObjc = OwnedObjc::new(rt::retain(command_buffer.raw()));
    guard let option::Option[metal::ComputeCommandEncoder]::Some(encoder) = command_buffer.compute_command_encoder() else { return option::Option[f64]::None; };
    let encoder_owner: OwnedObjc = OwnedObjc::new(rt::retain(encoder.raw()));
    encoder.set_compute_pipeline_state(pipeline_state);
    encoder.set_buffer(buffer_0, buffer_0_offset, 0 as u64);
    encoder.set_buffer(buffer_1, buffer_1_offset, 1 as u64);
    encoder.set_buffer(buffer_2, buffer_2_offset, 2 as u64);
    encoder.set_bytes(params as *u8, #size_of::[TextParams]() as u64, 3 as u64);
    let width: u64 = pipeline_state.thread_execution_width();
    encoder.dispatch_threads(
        metal::Size { width: threads as u64, height: 1 as u64, depth: 1 as u64 },
        metal::Size { width: width, height: 1 as u64, depth: 1 as u64 },
    );
    metal::CommandEncoder::from_raw(encoder.raw()).end_encoding();
    command_buffer.commit();
    command_buffer.wait_until_completed();
    return option::Option[f64]::Some((command_buffer.g_p_u_end_time() - command_buffer.g_p_u_start_time()) * 1000.0f64);
}

