// Native C+ API for Qwen Image generation.
//
// This first surface is deliberately synchronous and file-oriented. It keeps
// the command-line client out of the inference implementation while preserving
// the current phase-scoped model-memory behavior. A resident Engine can be
// added behind this module later without changing the C ABI entry module.

import "./pipeline" as pipeline;
import "./generation_control" as control;
import "./multimodal_conditioning" as multimodal_conditioning;
import "stdlib/option" as option;
import "stdlib/text" as text;
import "stdlib/vec" as vec;

enum CacheMode {
    None,
    TaylorSeer,
    CacheDiT,
}

enum GenerateStatus {
    Ok,
    InvalidArgument,
    Failed,
    Cancelled,
}

struct GenerateRequest {
    packed_path: str,
    model_root: str,
    output_path: str,
    prompt: str,
    pixels: usize,
    steps: usize,
    seed: u64,
    cache: CacheMode,
    cache_threshold: f64,
    // Set both to select a rectangular output. When both are zero, `pixels`
    // remains the backward-compatible square dimension.
    width: usize,
    height: usize,
}

// The original square image-conditioned entry point remains available for
// existing FFI clients. `image_paths` is borrowed for the synchronous call.
struct MultiImageGenerateRequest {
    packed_path: str,
    model_root: str,
    output_path: str,
    prompt: str,
    opaque image_paths: *str,
    image_count: usize,
    pixels: usize,
    steps: usize,
    seed: u64,
}

struct MultiImageSizedGenerateRequest {
    packed_path: str,
    model_root: str,
    output_path: str,
    prompt: str,
    opaque image_paths: *str,
    image_count: usize,
    width: usize,
    height: usize,
    steps: usize,
    seed: u64,
}

fn _request_width(request: GenerateRequest) -> usize {
    return if request.width == (0 as usize) { request.pixels } else { request.width };
}

fn _request_height(request: GenerateRequest) -> usize {
    return if request.height == (0 as usize) { request.pixels } else { request.height };
}

fn _step_name(steps: usize) -> option::Option[str] {
    if steps == (3 as usize) { return option::Option[str]::Some("3"); }
    if steps == (4 as usize) { return option::Option[str]::Some("4"); }
    if steps == (8 as usize) { return option::Option[str]::Some("8"); }
    if steps == (25 as usize) { return option::Option[str]::Some("25"); }
    if steps == (40 as usize) { return option::Option[str]::Some("40"); }
    return option::Option[str]::None;
}

fn _threshold_supported(value: f64) -> bool {
    return value == 0.12f64 || value == 0.14f64
        || value == 0.16f64 || value == 0.24f64;
}

fn _validate_multi_image(
    request: MultiImageGenerateRequest,
    observer: control::Observer = control::none(),
) -> GenerateStatus {
    if request.packed_path.count() == (0 as usize)
        || request.model_root.count() == (0 as usize)
        || request.output_path.count() == (0 as usize)
        || request.prompt.count() == (0 as usize)
        || request.image_paths.is_null()
        || request.image_count < (1 as usize)
        || request.image_count > (10 as usize)
        || (request.pixels != (512 as usize) && request.pixels != (1024 as usize)) {
        control::diagnose(observer, "Reference generation needs 1–10 images, a prompt, model, output path, and a 512 or 1024 square output.");
        return GenerateStatus::InvalidArgument;
    }
    match _step_name(request.steps) {
        option::Option::Some(_) => {}
        option::Option::None => {
            control::diagnose(observer, "Unsupported step count; choose 3, 4, 8, 25, or 40.");
            return GenerateStatus::InvalidArgument;
        }
    }
    var image_index: usize = 0 as usize;
    while image_index < request.image_count {
        if request.image_paths[image_index].count() == (0 as usize) {
            control::diagnose(observer, "A reference-image path is empty.");
            return GenerateStatus::InvalidArgument;
        }
        image_index = image_index +% (1 as usize);
    }
    return GenerateStatus::Ok;
}

fn _validate_multi_image_sized(
    request: MultiImageSizedGenerateRequest,
    observer: control::Observer = control::none(),
) -> GenerateStatus {
    if request.packed_path.count() == (0 as usize)
        || request.model_root.count() == (0 as usize)
        || request.output_path.count() == (0 as usize)
        || request.prompt.count() == (0 as usize)
        || request.image_paths.is_null()
        || request.image_count < (1 as usize)
        || request.image_count > (10 as usize)
        || request.width < (256 as usize)
        || request.height < (256 as usize)
        || request.width > (2048 as usize)
        || request.height > (2048 as usize)
        || request.width % (32 as usize) != (0 as usize)
        || request.height % (32 as usize) != (0 as usize)
        || request.width > (1048576 as usize) / request.height {
        control::diagnose(observer, "Reference output needs 1–10 images and a valid size: each side 256–2048 in multiples of 32, at most 1 MP total.");
        return GenerateStatus::InvalidArgument;
    }
    match _step_name(request.steps) {
        option::Option::Some(_) => {}
        option::Option::None => {
            control::diagnose(observer, "Unsupported step count; choose 3, 4, 8, 25, or 40.");
            return GenerateStatus::InvalidArgument;
        }
    }
    var image_index: usize = 0 as usize;
    while image_index < request.image_count {
        if request.image_paths[image_index].count() == (0 as usize) {
            control::diagnose(observer, "A reference-image path is empty.");
            return GenerateStatus::InvalidArgument;
        }
        image_index = image_index +% (1 as usize);
    }
    return GenerateStatus::Ok;
}

fn _validate(
    request: GenerateRequest,
    observer: control::Observer = control::none(),
) -> GenerateStatus {
    if request.packed_path.count() == (0 as usize)
        || request.model_root.count() == (0 as usize)
        || request.output_path.count() == (0 as usize)
        || request.prompt.count() == (0 as usize) {
        control::diagnose(observer, "The prompt, model file, model folder, and output path are required.");
        return GenerateStatus::InvalidArgument;
    }
    if (request.width == (0 as usize)) != (request.height == (0 as usize)) {
        control::diagnose(observer, "Set both output width and height.");
        return GenerateStatus::InvalidArgument;
    }
    if request.width == (0 as usize)
        && request.pixels != (256 as usize) && request.pixels != (1024 as usize) {
        control::diagnose(observer, "Unsupported square output size.");
        return GenerateStatus::InvalidArgument;
    }
    let width: usize = _request_width(request);
    let height: usize = _request_height(request);
    if !pipeline::output_dimensions_supported(width, height) {
        control::diagnose(observer, "Output size must use multiples of 32 and fit within the model's token limit.");
        return GenerateStatus::InvalidArgument;
    }
    match _step_name(request.steps) {
        option::Option::Some(_) => {}
        option::Option::None => {
            control::diagnose(observer, "Unsupported step count; choose 3, 4, 8, 25, or 40.");
            return GenerateStatus::InvalidArgument;
        }
    }
    if width == (256 as usize) && height == (256 as usize)
        && request.steps != (25 as usize) && request.steps != (40 as usize) {
        control::diagnose(observer, "256 × 256 output requires 25 or 40 steps.");
        return GenerateStatus::InvalidArgument;
    }
    if width == (256 as usize) && height == (256 as usize)
        && request.cache == CacheMode::TaylorSeer {
        control::diagnose(observer, "TaylorSeer is unavailable at 256 × 256.");
        return GenerateStatus::InvalidArgument;
    }
    if request.cache != CacheMode::None
        && !((width == (256 as usize) && height == (256 as usize))
            || (width == (1024 as usize) && height == (1024 as usize))) {
        control::diagnose(observer, "Cache modes are supported only for 256 × 256 or 1024 × 1024 output.");
        return GenerateStatus::InvalidArgument;
    }
    if request.cache != CacheMode::None && !_threshold_supported(request.cache_threshold) {
        control::diagnose(observer, "Unsupported cache threshold.");
        return GenerateStatus::InvalidArgument;
    }
    return GenerateStatus::Ok;
}

fn _from_pipeline_status(status: i32) -> GenerateStatus {
    if status == (0 as i32) { return GenerateStatus::Ok; }
    if status == (2 as i32) { return GenerateStatus::InvalidArgument; }
    if status == (3 as i32) { return GenerateStatus::Cancelled; }
    return GenerateStatus::Failed;
}

fn generate_to_png(
    request: GenerateRequest,
    observer: control::Observer = control::none(),
) -> GenerateStatus {
    let validation: GenerateStatus = _validate(request, observer);
    if validation != GenerateStatus::Ok { return validation; }
    guard let option::Option[str]::Some(steps) = _step_name(request.steps) else {
        return GenerateStatus::InvalidArgument;
    };
    let width: usize = _request_width(request);
    let height: usize = _request_height(request);

    let status: i32 = if width == (256 as usize) && height == (256 as usize) {
        match request.cache {
            CacheMode::None => pipeline::generate_256(
                request.packed_path,
                request.model_root,
                request.output_path,
                request.prompt,
                request.seed,
                steps,
                observer,
            ),
            CacheMode::CacheDiT => pipeline::generate_256_cache_dit(
                request.packed_path,
                request.model_root,
                request.output_path,
                request.prompt,
                request.seed,
                request.cache_threshold,
                steps,
                observer,
            ),
            CacheMode::TaylorSeer => 2,
        }
    } else if width == (1024 as usize) && height == (1024 as usize) {
        match request.cache {
            CacheMode::None => pipeline::generate_1024(
                request.packed_path,
                request.model_root,
                request.output_path,
                request.prompt,
                request.seed,
                steps,
                observer,
            ),
            CacheMode::TaylorSeer => pipeline::generate_1024_taylorseer(
                request.packed_path,
                request.model_root,
                request.output_path,
                request.prompt,
                request.seed,
                request.cache_threshold,
                steps,
                observer,
            ),
            CacheMode::CacheDiT => pipeline::generate_1024_cache_dit(
                request.packed_path,
                request.model_root,
                request.output_path,
                request.prompt,
                request.seed,
                request.cache_threshold,
                steps,
                observer,
            ),
        }
    } else {
        pipeline::generate_sized(
            request.packed_path,
            request.model_root,
            request.output_path,
            request.prompt,
            width,
            height,
            request.seed,
            steps,
            observer,
        )
    };
    return _from_pipeline_status(status);
}

fn generate_multi_image_to_png(
    request: MultiImageGenerateRequest,
    observer: control::Observer = control::none(),
) -> GenerateStatus {
    let validation: GenerateStatus = _validate_multi_image(request, observer);
    if validation != GenerateStatus::Ok { return validation; }
    return generate_multi_image_sized_to_png(MultiImageSizedGenerateRequest {
        packed_path: request.packed_path,
        model_root: request.model_root,
        output_path: request.output_path,
        prompt: request.prompt,
        image_paths: request.image_paths,
        image_count: request.image_count,
        width: request.pixels,
        height: request.pixels,
        steps: request.steps,
        seed: request.seed,
    }, observer);
}

fn generate_multi_image_sized_to_png(
    request: MultiImageSizedGenerateRequest,
    observer: control::Observer = control::none(),
) -> GenerateStatus {
    let validation: GenerateStatus = _validate_multi_image_sized(request, observer);
    if validation != GenerateStatus::Ok { return validation; }
    guard let option::Option[str]::Some(steps) = _step_name(request.steps) else {
        return GenerateStatus::InvalidArgument;
    };
    return _from_pipeline_status(
        multimodal_conditioning::run_multi_image_transformer(
            request.packed_path,
            request.model_root,
            request.image_paths,
            request.image_count,
            request.prompt,
            steps,
            request.output_path,
            request.seed,
            request.width,
            observer,
            output_width: request.width,
            output_height: request.height,
        ),
    );
}

fn _cancel_immediately(_progress: control::Progress, _context: *u8) -> bool {
    return false;
}

struct DiagnosticCapture { message: text::Text }

fn _capture_diagnostic(message: str, raw: *u8) {
    let capture: *DiagnosticCapture = raw as *DiagnosticCapture;
    { (*capture).message = message.to_text(); }
}

#[test]
fn invalid_generation_reports_a_specific_reason_without_model_io() {
    var capture: DiagnosticCapture = DiagnosticCapture { message: text::new() };
    let observer: control::Observer = control::Observer {
        callback: 0 as fn(control::Progress, *u8) -> bool,
        diagnostic: _capture_diagnostic,
        context: #addr_of(capture) as *u8,
    };
    let request: GenerateRequest = GenerateRequest {
        packed_path: "absent.qipack",
        model_root: "absent-model",
        output_path: "unused.png",
        prompt: "test",
        pixels: 256 as usize,
        steps: 4 as usize,
        seed: 1 as u64,
        cache: CacheMode::None,
        cache_threshold: 0.0f64,
        width: 0 as usize,
        height: 0 as usize,
    };
    assert generate_to_png(request, observer) == GenerateStatus::InvalidArgument;
    assert capture.message.view() == "256 × 256 output requires 25 or 40 steps.";
}

#[test]
fn observer_cancels_both_api_paths_before_model_io() {
    let observer: control::Observer = control::Observer {
        callback: _cancel_immediately,
        diagnostic: 0 as fn(str, *u8),
        context: 0 as *u8,
    };
    let request: GenerateRequest = GenerateRequest {
        packed_path: "absent.qipack",
        model_root: "absent-model",
        output_path: "unused.png",
        prompt: "test",
        pixels: 256 as usize,
        steps: 25 as usize,
        seed: 1 as u64,
        cache: CacheMode::None,
        cache_threshold: 0.0f64,
        width: 0 as usize,
        height: 0 as usize,
    };
    assert generate_to_png(request, observer) == GenerateStatus::Cancelled;
    var paths: vec::Vec[str] = vec::new::[str]();
    let _added = paths.append("absent.png");
    let multi: MultiImageGenerateRequest = MultiImageGenerateRequest {
        packed_path: "absent.qipack",
        model_root: "absent-model",
        output_path: "unused.png",
        prompt: "test",
        image_paths: #slice_ptr(paths.as_slice()),
        image_count: 1 as usize,
        pixels: 512 as usize,
        steps: 25 as usize,
        seed: 1 as u64,
    };
    assert generate_multi_image_to_png(multi, observer) == GenerateStatus::Cancelled;
}

#[test]
fn public_generation_request_validation_is_typed() {
    let valid: GenerateRequest = GenerateRequest {
        packed_path: "model.qipack",
        model_root: "models/qwen",
        output_path: "output.png",
        prompt: "A geometric poster",
        pixels: 1024 as usize,
        steps: 40 as usize,
        seed: 1301 as u64,
        cache: CacheMode::None,
        cache_threshold: 0.0f64,
        width: 0 as usize,
        height: 0 as usize,
    };
    assert _validate(valid) == GenerateStatus::Ok;

    let bad_pixels: GenerateRequest = GenerateRequest {
        packed_path: valid.packed_path,
        model_root: valid.model_root,
        output_path: valid.output_path,
        prompt: valid.prompt,
        pixels: 512 as usize,
        steps: valid.steps,
        seed: valid.seed,
        cache: valid.cache,
        cache_threshold: valid.cache_threshold,
        width: 0 as usize,
        height: 0 as usize,
    };
    assert _validate(bad_pixels) == GenerateStatus::InvalidArgument;

    let unsupported_cache: GenerateRequest = GenerateRequest {
        packed_path: valid.packed_path,
        model_root: valid.model_root,
        output_path: valid.output_path,
        prompt: valid.prompt,
        pixels: 256 as usize,
        steps: 40 as usize,
        seed: valid.seed,
        cache: CacheMode::TaylorSeer,
        cache_threshold: 0.24f64,
        width: 0 as usize,
        height: 0 as usize,
    };
    assert _validate(unsupported_cache) == GenerateStatus::InvalidArgument;

    let rectangle: GenerateRequest = GenerateRequest {
        packed_path: valid.packed_path,
        model_root: valid.model_root,
        output_path: valid.output_path,
        prompt: valid.prompt,
        pixels: 0 as usize,
        steps: valid.steps,
        seed: valid.seed,
        cache: CacheMode::None,
        cache_threshold: 0.0f64,
        width: 1344 as usize,
        height: 768 as usize,
    };
    assert _validate(rectangle) == GenerateStatus::Ok;

    let native_2048: GenerateRequest = GenerateRequest {
        packed_path: valid.packed_path,
        model_root: valid.model_root,
        output_path: valid.output_path,
        prompt: valid.prompt,
        pixels: 0 as usize,
        steps: 4 as usize,
        seed: valid.seed,
        cache: CacheMode::None,
        cache_threshold: 0.0f64,
        width: 2048 as usize,
        height: 2048 as usize,
    };
    assert _validate(native_2048) == GenerateStatus::Ok;

    let too_large: GenerateRequest = GenerateRequest {
        packed_path: valid.packed_path,
        model_root: valid.model_root,
        output_path: valid.output_path,
        prompt: valid.prompt,
        pixels: 0 as usize,
        steps: 4 as usize,
        seed: valid.seed,
        cache: CacheMode::None,
        cache_threshold: 0.0f64,
        width: 2080 as usize,
        height: 2048 as usize,
    };
    assert _validate(too_large) == GenerateStatus::InvalidArgument;
}

#[test]
fn public_multi_image_request_enforces_count_resolution_and_steps() {
    var paths: [str; 2] = ["first.png", "second.png"];
    let valid: MultiImageGenerateRequest = MultiImageGenerateRequest {
        packed_path: "model.qipack",
        model_root: "models/qwen",
        output_path: "output.png",
        prompt: "Combine both references",
        image_paths: #addr_of(paths[0]),
        image_count: 2 as usize,
        pixels: 512 as usize,
        steps: 40 as usize,
        seed: 1301 as u64,
    };
    assert _validate_multi_image(valid) == GenerateStatus::Ok;

    let empty: MultiImageGenerateRequest = MultiImageGenerateRequest {
        packed_path: valid.packed_path,
        model_root: valid.model_root,
        output_path: valid.output_path,
        prompt: valid.prompt,
        image_paths: valid.image_paths,
        image_count: 0 as usize,
        pixels: valid.pixels,
        steps: valid.steps,
        seed: valid.seed,
    };
    assert _validate_multi_image(empty) == GenerateStatus::InvalidArgument;

    let wrong_resolution: MultiImageGenerateRequest = MultiImageGenerateRequest {
        packed_path: valid.packed_path,
        model_root: valid.model_root,
        output_path: valid.output_path,
        prompt: valid.prompt,
        image_paths: valid.image_paths,
        image_count: valid.image_count,
        pixels: 768 as usize,
        steps: valid.steps,
        seed: valid.seed,
    };
    assert _validate_multi_image(wrong_resolution) == GenerateStatus::InvalidArgument;

    // One and two steps are truncated smoke trajectories, not generation.
    let smoke_steps: MultiImageGenerateRequest = MultiImageGenerateRequest {
        packed_path: valid.packed_path,
        model_root: valid.model_root,
        output_path: valid.output_path,
        prompt: valid.prompt,
        image_paths: valid.image_paths,
        image_count: valid.image_count,
        pixels: valid.pixels,
        steps: 2 as usize,
        seed: valid.seed,
    };
    assert _validate_multi_image(smoke_steps) == GenerateStatus::InvalidArgument;

    let distilled_steps: MultiImageGenerateRequest = MultiImageGenerateRequest {
        packed_path: valid.packed_path,
        model_root: valid.model_root,
        output_path: valid.output_path,
        prompt: valid.prompt,
        image_paths: valid.image_paths,
        image_count: valid.image_count,
        pixels: valid.pixels,
        steps: 4 as usize,
        seed: valid.seed,
    };
    assert _validate_multi_image(distilled_steps) == GenerateStatus::Ok;
}

#[test]
fn sized_multi_image_request_preserves_aspect_within_budget() {
    var paths: [str; 1] = ["first.png"];
    let portrait: MultiImageSizedGenerateRequest = MultiImageSizedGenerateRequest {
        packed_path: "model.qipack",
        model_root: "models/qwen",
        output_path: "output.png",
        prompt: "Edit this image",
        image_paths: #addr_of(paths[0]),
        image_count: 1 as usize,
        width: 768 as usize,
        height: 1024 as usize,
        steps: 4 as usize,
        seed: 1301 as u64,
    };
    assert _validate_multi_image_sized(portrait) == GenerateStatus::Ok;
    let over_budget: MultiImageSizedGenerateRequest = MultiImageSizedGenerateRequest {
        packed_path: portrait.packed_path,
        model_root: portrait.model_root,
        output_path: portrait.output_path,
        prompt: portrait.prompt,
        image_paths: portrait.image_paths,
        image_count: portrait.image_count,
        width: 1024 as usize,
        height: 1056 as usize,
        steps: portrait.steps,
        seed: portrait.seed,
    };
    assert _validate_multi_image_sized(over_budget) == GenerateStatus::InvalidArgument;
}
