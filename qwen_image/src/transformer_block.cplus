    guard let option::Option[metal::CommandBuffer]::Some(command_buffer) =
        queue.command_buffer() else { return option::Option[f64]::None; };
    let command_buffer_owner: OwnedObjc = OwnedObjc::new(rt::retain(command_buffer.raw()));
    guard let option::Option[metal::ComputeCommandEncoder]::Some(encoder) =
        command_buffer.compute_command_encoder() else { return option::Option[f64]::None; };
    let encoder_owner: OwnedObjc = OwnedObjc::new(rt::retain(encoder.raw()));
    encode_q4_direct_linear(
        encoder, pipeline, input, weight, output,
        output_columns, input_columns, rows,
    );
    let command_encoder: metal::CommandEncoder = metal::CommandEncoder::from_raw(encoder.raw());
    command_encoder.end_encoding();
    command_buffer.commit();
    command_buffer.wait_until_completed();
    return option::Option[f64]::Some(
        (command_buffer.g_p_u_end_time() - command_buffer.g_p_u_start_time()) * 1000.0f64,
    );
}

fn convert_mps_weight(
    queue: metal::CommandQueue,
    bf16_pipeline: metal::ComputePipelineState,
    q8_pipeline: metal::ComputePipelineState,
    weight: LinearWeight,
    output: metal::Buffer,
    output_columns: usize,
    input_columns: usize,
) -> option::Option[f64] {
    guard let option::Option[metal::CommandBuffer]::Some(command_buffer) =
        queue.command_buffer() else { return option::Option[f64]::None; };
    let command_buffer_owner: OwnedObjc = OwnedObjc::new(rt::retain(command_buffer.raw()));
    guard let option::Option[metal::ComputeCommandEncoder]::Some(encoder) =
        command_buffer.compute_command_encoder() else { return option::Option[f64]::None; };
    let encoder_owner: OwnedObjc = OwnedObjc::new(rt::retain(encoder.raw()));
    let count: usize = output_columns *% input_columns;
    if weight.scheme == PACKED_SCHEME_INT8_AFFINE {
        var params: Int8LinearParams = Int8LinearParams {
            rows: 0 as u32,
            output_columns: output_columns as u32,
            input_columns: input_columns as u32,
            group_size: 64 as u32,
        };
        encoder.set_compute_pipeline_state(q8_pipeline);
        encoder.set_buffer(weight.storage, weight.weights_offset, 0 as u64);
        encoder.set_buffer(weight.storage, weight.scales_offset, 1 as u64);
        encoder.set_buffer(weight.storage, weight.zeros_offset, 2 as u64);
        encoder.set_buffer(output, 0 as u64, 3 as u64);
        encoder.set_bytes(
            #addr_of(params) as *u8, #size_of::[Int8LinearParams]() as u64, 4 as u64,
        );
        encoder.dispatch_threads(
            metal::Size { width: count as u64, height: 1 as u64, depth: 1 as u64 },
            metal::Size { width: q8_pipeline.thread_execution_width(), height: 1 as u64, depth: 1 as u64 },
        );
    } else {
        var params: LinearParams = LinearParams {
            rows: 0 as u32,
            output_columns: output_columns as u32,
            input_columns: input_columns as u32,
            weight_mode: 0 as u32,
        };
        encoder.set_compute_pipeline_state(bf16_pipeline);
        encoder.set_buffer(weight.storage, weight.weights_offset, 0 as u64);
        encoder.set_buffer(output, 0 as u64, 1 as u64);
        encoder.set_bytes(
            #addr_of(params) as *u8, #size_of::[LinearParams]() as u64, 2 as u64,
        );
        encoder.dispatch_threads(
            metal::Size { width: count as u64, height: 1 as u64, depth: 1 as u64 },
            metal::Size { width: bf16_pipeline.thread_execution_width(), height: 1 as u64, depth: 1 as u64 },
        );
    }
    let command_encoder: metal::CommandEncoder = metal::CommandEncoder::from_raw(encoder.raw());
    command_encoder.end_encoding();
    command_buffer.commit();
    command_buffer.wait_until_completed();
    return option::Option[f64]::Some(
        (command_buffer.g_p_u_end_time() - command_buffer.g_p_u_start_time()) * 1000.0f64,
    );
}

fn encode_mps_input_conversion(
    encoder: metal::ComputeCommandEncoder,
    pipeline: metal::ComputePipelineState,
    input: metal::Buffer,
    output: metal::Buffer,
    rows: usize,
    input_columns: usize,
    output_offset: u64 = 0 as u64,
) {
    var params: LinearParams = LinearParams {
        rows: rows as u32,
        output_columns: 0 as u32,
        input_columns: input_columns as u32,
        weight_mode: 0 as u32,
    };
    encoder.set_compute_pipeline_state(pipeline);
    encoder.set_buffer(input, 0 as u64, 0 as u64);
    encoder.set_buffer(output, output_offset, 1 as u64);
    encoder.set_bytes(
        #addr_of(params) as *u8, #size_of::[LinearParams]() as u64, 2 as u64,
    );
    encoder.dispatch_threads(
        metal::Size {
            width: (rows *% input_columns) as u64,
            height: 1 as u64,
            depth: 1 as u64,
        },
        metal::Size { width: pipeline.thread_execution_width(), height: 1 as u64, depth: 1 as u64 },
    );
}

fn encode_mps_weight_conversion(
    encoder: metal::ComputeCommandEncoder,
    workspace: MpsWorkspace,
    weight: LinearWeight,
    output_columns: usize,
    input_columns: usize,
) {
    if weight.scheme == PACKED_SCHEME_FP16 { return; }
    let count: usize = output_columns *% input_columns;
    if weight.scheme == PACKED_SCHEME_INT8_AFFINE {
        var params: Int8LinearParams = Int8LinearParams {
            rows: 0 as u32,
            output_columns: output_columns as u32,
            input_columns: input_columns as u32,
            group_size: 64 as u32,
        };
        encoder.set_compute_pipeline_state(workspace.q8_pipeline);
        encoder.set_buffer(weight.storage, weight.weights_offset, 0 as u64);
        encoder.set_buffer(weight.storage, weight.scales_offset, 1 as u64);
        encoder.set_buffer(weight.storage, weight.zeros_offset, 2 as u64);
        encoder.set_buffer(workspace.half_weight, 0 as u64, 3 as u64);
        encoder.set_bytes(
            #addr_of(params) as *u8, #size_of::[Int8LinearParams]() as u64, 4 as u64,
        );
        encoder.dispatch_threads(
            metal::Size { width: count as u64, height: 1 as u64, depth: 1 as u64 },
            metal::Size { width: workspace.q8_pipeline.thread_execution_width(), height: 1 as u64, depth: 1 as u64 },
        );
    } else {
        var params: LinearParams = LinearParams {
            rows: 0 as u32,
            output_columns: output_columns as u32,
            input_columns: input_columns as u32,
            weight_mode: 0 as u32,
        };
        encoder.set_compute_pipeline_state(workspace.bf16_pipeline);
        encoder.set_buffer(weight.storage, weight.weights_offset, 0 as u64);
        encoder.set_buffer(workspace.half_weight, 0 as u64, 1 as u64);
        encoder.set_bytes(
            #addr_of(params) as *u8, #size_of::[LinearParams]() as u64, 2 as u64,
        );
        encoder.dispatch_threads(
            metal::Size { width: count as u64, height: 1 as u64, depth: 1 as u64 },
            metal::Size { width: workspace.bf16_pipeline.thread_execution_width(), height: 1 as u64, depth: 1 as u64 },
        );
    }
}

fn dispatch_mps_preconverted_linear(
    queue: metal::CommandQueue,
    input_pipeline: metal::ComputePipelineState,
    ref operation: mps::Multiplication,
    input: metal::Buffer,
    half_input: metal::Buffer,
    rows: usize,
    input_columns: usize,
) -> option::Option[f64] {
    guard let option::Option[metal::CommandBuffer]::Some(command_buffer) =
        queue.command_buffer() else { return option::Option[f64]::None; };
    let command_buffer_owner: OwnedObjc = OwnedObjc::new(rt::retain(command_buffer.raw()));
    guard let option::Option[metal::ComputeCommandEncoder]::Some(encoder) =
        command_buffer.compute_command_encoder() else { return option::Option[f64]::None; };
    let encoder_owner: OwnedObjc = OwnedObjc::new(rt::retain(encoder.raw()));
    var params: LinearParams = LinearParams {
        rows: rows as u32,
        output_columns: 0 as u32,
        input_columns: input_columns as u32,
        weight_mode: 0 as u32,
    };
    encoder.set_compute_pipeline_state(input_pipeline);
    encoder.set_buffer(input, 0 as u64, 0 as u64);
    encoder.set_buffer(half_input, 0 as u64, 1 as u64);
    encoder.set_bytes(
        #addr_of(params) as *u8, #size_of::[LinearParams]() as u64, 2 as u64,
    );
    encoder.dispatch_threads(
        metal::Size { width: (rows *% input_columns) as u64, height: 1 as u64, depth: 1 as u64 },
        metal::Size { width: input_pipeline.thread_execution_width(), height: 1 as u64, depth: 1 as u64 },
    );
    let command_encoder: metal::CommandEncoder = metal::CommandEncoder::from_raw(encoder.raw());
    command_encoder.end_encoding();
    operation.encode(command_buffer);
    command_buffer.commit();
    command_buffer.wait_until_completed();
    return option::Option[f64]::Some(
        (command_buffer.g_p_u_end_time() - command_buffer.g_p_u_start_time()) * 1000.0f64,
    );
}

fn dispatch_weighted_linear(
    queue: metal::CommandQueue,
    pipelines: Pipelines,
    input: metal::Buffer,
    weight: LinearWeight,
    output: metal::Buffer,
    output_columns: usize,
    input_columns: usize,
    rows: usize,
) -> option::Option[f64] {
    if weight.scheme == RUNTIME_SCHEME_INT4_DIRECT {
        return dispatch_q4_direct_linear(
            queue, pipelines.q4_direct_linear, input, weight, output,
            output_columns, input_columns, rows,
        );
    }
    if weight.scheme == PACKED_SCHEME_INT4_ROTATED {
        return dispatch_q4_linear(
            queue, pipelines.q4_linear, pipelines.q4_linear_exact, input, weight, output,
            output_columns, input_columns, rows,
        );
    }
    if weight.scheme == PACKED_SCHEME_INT8_AFFINE {
        if rows == (256 as usize) {
            return dispatch_simdgroup_int8_linear(
                queue, pipelines.int8_linear_cached, input, weight, output,
                output_columns, input_columns, rows,
                64 as usize, 512 as usize, 64 as usize,
            );
        }
        if rows >= (64 as usize) {
            return dispatch_simdgroup_int8_linear(
                queue, pipelines.int8_linear_fast, input, weight, output,
                output_columns, input_columns, rows,
            );
        }
        return dispatch_int8_linear(
            queue,
            pipelines.int8_linear,
            input,
            weight,
            output,
            output_columns,
            input_columns,
            rows,
        );
    }
    let weight_mode: u32 = if weight.scheme == PACKED_SCHEME_FP16 {
        1 as u32
    } else {
        0 as u32
    };
    if rows == (256 as usize) {
        return dispatch_simdgroup_linear(
            queue, pipelines.dense_linear_cached, input, weight.storage, output,
            output_columns, input_columns, rows, weight.weights_offset,
            64 as usize, 512 as usize, 64 as usize, weight_mode,
        );
    }
    if rows >= (64 as usize) {
        return dispatch_simdgroup_linear(
            queue, pipelines.dense_linear_fast, input, weight.storage, output,
            output_columns, input_columns, rows, weight.weights_offset, 64 as usize,
            512 as usize, OUTPUT_TILE, weight_mode,
        );
    }
    return dispatch_linear(
        queue,
        pipelines.dense_linear,
        input,
        weight.storage,
        output,
        output_columns,
        input_columns,
        rows,
        weight.weights_offset,
        weight_mode,
    );
}

// Conditioning precomputation batches all scheduler rows while retaining the
// scalar FP32-operand kernel used by the original two-row path. Selecting the
// >=64-row SIMD-group kernel here would round activations and BF16 weights to
// FP16 and would therefore change the conditioning values.
fn dispatch_weighted_linear_scalar(
    queue: metal::CommandQueue,
    pipelines: Pipelines,
    input: metal::Buffer,
    weight: LinearWeight,
    output: metal::Buffer,
    output_columns: usize,
    input_columns: usize,
    rows: usize,
) -> option::Option[f64] {
    if weight.scheme == RUNTIME_SCHEME_INT4_DIRECT {
        return dispatch_q4_direct_linear(
            queue, pipelines.q4_direct_linear, input, weight, output,
            output_columns, input_columns, rows,
        );
    }
    if weight.scheme == PACKED_SCHEME_INT4_ROTATED {
        return dispatch_q4_linear(
            queue, pipelines.q4_linear, pipelines.q4_linear_exact, input, weight, output,
            output_columns, input_columns, rows,
        );
    }
    if weight.scheme == PACKED_SCHEME_INT8_AFFINE {
        return dispatch_int8_linear(
            queue, pipelines.int8_linear, input, weight, output,
            output_columns, input_columns, rows,
        );
    }
    return dispatch_linear(
        queue, pipelines.dense_linear, input, weight.storage, output,
        output_columns, input_columns, rows, weight.weights_offset,
        if weight.scheme == PACKED_SCHEME_FP16 { 1 as u32 } else { 0 as u32 },
    );
}

fn dispatch_1d(
    queue: metal::CommandQueue,
    pipeline: metal::ComputePipelineState,
    buffer_0: metal::Buffer,
    buffer_1: metal::Buffer,
    buffer_2: metal::Buffer,
    buffer_3: metal::Buffer,
    buffer_5: metal::Buffer,
    buffer_6: metal::Buffer,
    parameters: *BlockParams,
    thread_count: usize,
) -> option::Option[f64] {
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() {
        return option::Option[f64]::None;
    }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    guard let option::Option[metal::CommandBuffer]::Some(command_buffer) = queue.command_buffer() else {
        return option::Option[f64]::None;
    };
    let command_buffer_owner: OwnedObjc = OwnedObjc::new(rt::retain(command_buffer.raw()));
    guard let option::Option[metal::ComputeCommandEncoder]::Some(encoder) =
        command_buffer.compute_command_encoder() else {
        return option::Option[f64]::None;
    };
    let encoder_owner: OwnedObjc = OwnedObjc::new(rt::retain(encoder.raw()));
    encoder.set_compute_pipeline_state(pipeline);
    encoder.set_buffer(buffer_0, 0 as u64, 0 as u64);
    encoder.set_buffer(buffer_1, 0 as u64, 1 as u64);
    encoder.set_buffer(buffer_2, 0 as u64, 2 as u64);
    encoder.set_buffer(buffer_3, 0 as u64, 3 as u64);
    encoder.set_bytes(parameters as *u8, #size_of::[BlockParams]() as u64, 4 as u64);
    encoder.set_buffer(buffer_5, 0 as u64, 5 as u64);
    encoder.set_buffer(buffer_6, 0 as u64, 6 as u64);
    let width: u64 = pipeline.thread_execution_width();
    encoder.dispatch_threads(
        metal::Size { width: thread_count as u64, height: 1 as u64, depth: 1 as u64 },
        metal::Size { width: width, height: 1 as u64, depth: 1 as u64 },
    );
    let command_encoder: metal::CommandEncoder = metal::CommandEncoder::from_raw(encoder.raw());
    command_encoder.end_encoding();
    command_buffer.commit();
    command_buffer.wait_until_completed();
    return option::Option[f64]::Some(
        (command_buffer.g_p_u_end_time() - command_buffer.g_p_u_start_time()) * 1000.0f64,
    );
}

fn dispatch_simdgroup_1d(
