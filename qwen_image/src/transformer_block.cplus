fn zero_f32_vector(count: usize) -> option::Option[vec::Vec[f32]] {
    var values: vec::Vec[f32] = vec::Vec[f32]::with_capacity(count);
    var index: usize = 0 as usize;
    while index < count {
        if values.append(0.0f32) != status::Status::Ok {
            return option::Option[vec::Vec[f32]]::None;
        }
        index = index +% (1 as usize);
    }
    return option::Option[vec::Vec[f32]]::Some(values);
}

fn run_prompt_trajectory_bottleneck_to_host(
    packed_path: str,
    text_input: *f32,
    text_rows: usize,
    seed: u64,
    final_latent: *f32,
    pixels: usize,
) -> i32 {
    if text_input.is_null() || final_latent.is_null()
        || !(pixels == (256 as usize) || pixels == (1024 as usize)) {
        io::eprintln("trajectory: invalid Bottleneck Sampling handoff");
        return 2;
    }
    let full_side: usize = pixels / (16 as usize);
    let low_pixels: usize = pixels / (2 as usize);
    let low_side: usize = low_pixels / (16 as usize);
    let full_count: usize = full_side *% full_side *% IMAGE_CHANNELS;
    let low_count: usize = low_side *% low_side *% IMAGE_CHANNELS;
    let bottleneck_wall_start_ms: i64 = time::now_millis();

    io::println("bottleneck trajectory: stage=1 pixels=${pixels} steps=4 strength=1 shift=9");
    if run_trajectory_packed_impl(
        packed_path, "4", "", final_latent, text_input, text_rows, seed,
        true, false, false, 0.0f64, pixels, false,
        0 as *f32, 9.0f32, 1.0f32,
    ) != (0 as i32) {
        return 1;
    }

    guard let option::Option[vec::Vec[f32]]::Some(low_latent) =
        zero_f32_vector(low_count) else { return 1; };
    guard let option::Option[vec::Vec[f32]]::Some(low_noise) =
        zero_f32_vector(low_count) else { return 1; };
    if !resize_latent_lanczos3(
        final_latent, full_side, #slice_ptr(low_latent.as_slice()), low_side,
    ) || !fill_seeded_latent(
        #slice_ptr(low_noise.as_slice()), low_count, seed +% (1 as u64),
    ) || !reintroduce_bottleneck_noise(
        #slice_ptr(low_latent.as_slice()), #slice_ptr(low_noise.as_slice()),
        low_count, 0.8f32,
    ) {
        io::eprintln("bottleneck trajectory: low-resolution transition failed");
        return 1;
    }
    io::println("bottleneck trajectory: stage=2 pixels=${low_pixels} steps=13 strength=0.8 shift=6");
    if run_trajectory_packed_impl(
        packed_path, "13", "", #slice_ptr(low_latent.as_slice()),
        text_input, text_rows, seed +% (1 as u64), true, false, false, 0.0f64,
        low_pixels, false, #slice_ptr(low_latent.as_slice()), 6.0f32, 0.8f32,
    ) != (0 as i32) {
        return 1;
    }

    if !resize_latent_lanczos3(
        #slice_ptr(low_latent.as_slice()), low_side, final_latent, full_side,
    ) {
        io::eprintln("bottleneck trajectory: high-resolution transition failed");
        return 1;
    }
    guard let option::Option[vec::Vec[f32]]::Some(high_noise) =
        zero_f32_vector(full_count) else { return 1; };
    if !fill_seeded_latent(
        #slice_ptr(high_noise.as_slice()), full_count, seed +% (2 as u64),
    ) || !reintroduce_bottleneck_noise(
        final_latent, #slice_ptr(high_noise.as_slice()), full_count, 0.6f32,
    ) {
        io::eprintln("bottleneck trajectory: high-resolution noise transition failed");
        return 1;
    }
    io::println("bottleneck trajectory: stage=3 pixels=${pixels} steps=8 strength=0.6 shift=9");
    let status: i32 = run_trajectory_packed_impl(
        packed_path, "8", "", final_latent, text_input, text_rows,
        seed +% (2 as u64), true, false, false, 0.0f64, pixels, false,
        final_latent, 9.0f32, 0.6f32,
    );
    io::println("bottleneck trajectory: pixels=${pixels} stages=4+13+8 total_wall_ms=${time::now_millis() - bottleneck_wall_start_ms}");
    return status;
}

fn run_prompt_trajectory_bottleneck_1024_to_host(
    packed_path: str,
    text_input: *f32,
    text_rows: usize,
    seed: u64,
    final_latent: *f32,
) -> i32 {
    return run_prompt_trajectory_bottleneck_to_host(
        packed_path, text_input, text_rows, seed, final_latent, 1024 as usize,
    );
}

fn run_prompt_trajectory_bottleneck_256_to_host(
    packed_path: str,
    text_input: *f32,
    text_rows: usize,
    seed: u64,
    final_latent: *f32,
) -> i32 {
    return run_prompt_trajectory_bottleneck_to_host(
        packed_path, text_input, text_rows, seed, final_latent, 256 as usize,
    );
}

fn run_trajectory_bottleneck_packed(
    packed_path: str,
    fixture_directory: str = "tests/fixtures/trajectory_256_fp32",
) -> i32 {
    let text_path: text::Text = "${fixture_directory}/text_input.f32";
    guard let mapped::MapResult::Ok(text_mapping) = mapped::map_readonly(text_path.view()) else {
        io::eprintln("bottleneck trajectory: could not map ${text_path}");
        return 1;
    };
    let expected_path: text::Text = "${fixture_directory}/latent_step_40.f32";
    guard let mapped::MapResult::Ok(expected_mapping) =
        mapped::map_readonly(expected_path.view()) else {
        io::eprintln("bottleneck trajectory: could not map ${expected_path}");
        return 1;
    };
    let text_rows: usize = 22 as usize;
    let latent_count: usize = (16 as usize) *% (16 as usize) *% IMAGE_CHANNELS;
    if text_mapping.length() != text_rows *% WIDTH *% #size_of::[f32]()
        || expected_mapping.length() != latent_count *% #size_of::[f32]() {
        io::eprintln("bottleneck trajectory: fixture size mismatch");
        return 1;
    }
    guard let option::Option[vec::Vec[f32]]::Some(final_latent) =
        zero_f32_vector(latent_count) else { return 1; };
    let status: i32 = run_prompt_trajectory_bottleneck_to_host(
        packed_path,
        text_mapping.pointer() as *f32,
        text_rows,
        1101 as u64,
        #slice_ptr(final_latent.as_slice()),
        256 as usize,
    );
    if status != (0 as i32) { return status; }
    let error: f64 = host_normalized_rms(
        #slice_ptr(final_latent.as_slice()),
        expected_mapping.pointer() as *f32,
        latent_count,
    );
    io::println("bottleneck trajectory 256: steps=4+13+8 latent_nRMSE=${error} validation=measured-only");
    return 0;
}

// The pinned pipeline casts the scheduler timestep to the BF16 latent dtype
// and then divides by 1000 in BF16, so the model sees bf16(bf16(t) / 1000).
// Rounding only once differs by one BF16 ulp on 12 of the 40 1024 steps.
fn model_timestep(timestep: f32) -> f32 {
    let rounded: f32 = cpu::bf16_to_f32(cpu::f32_to_bf16(timestep));
    return cpu::bf16_to_f32(cpu::f32_to_bf16(rounded / 1000.0f32));
}

#[test]
fn model_timestep_rounds_like_the_bf16_pipeline() {
    // 1024/40 step 6: single rounding gives 0.9296875, the pipeline 0.93359375.
    assert model_timestep(931.3406372070312f32) != cpu::bf16_to_f32(cpu::f32_to_bf16(931.3406372070312f32 / 1000.0f32));
    // The Viggle 4-step timesteps are unaffected.
    assert model_timestep(857.19189453125f32) == cpu::bf16_to_f32(cpu::f32_to_bf16(857.19189453125f32 / 1000.0f32));
    assert model_timestep(1000.0f32) == 1.0f32;
}

const PACK_SHIFT_TERMINAL_UNSET: u32 = 0;
const PACK_SHIFT_TERMINAL_STRETCH: u32 = 1;
const PACK_SHIFT_TERMINAL_NONE: u32 = 2;

// A pack whose metadata says `shift_terminal=none` (for example a few-step
// distillation) uses the unstretched FlowMatch schedule; `0.02` pins the
// stretched one.
fn pack_shift_terminal(packed_path: str) -> u32 {
    return match packed::read_metadata(packed_path) {
        packed::MetadataResult::Ok(metadata) => match metadata.get("shift_terminal") {
            option::Option[str]::Some(value) => {
                if value == "none" { PACK_SHIFT_TERMINAL_NONE }
                else { PACK_SHIFT_TERMINAL_STRETCH }
            }
            option::Option[str]::None => PACK_SHIFT_TERMINAL_UNSET,
        },
        packed::MetadataResult::Err(_message) => PACK_SHIFT_TERMINAL_UNSET,
    };
}

// One log line identifying the pack by its metadata, since the fixed header
// names the base snapshot for every pack, fine-tunes included.
fn print_pack_identity(packed_path: str) {
    match packed::read_metadata(packed_path) {
        packed::MetadataResult::Ok(metadata) => {
            let block: text::Text = metadata.serialize();
            let line: text::Text = block.replacing("\n", " ");
            if line.view().count() == (0 as usize) {
                io::println("trajectory pack: ${packed_path} metadata=none");
            } else {
                io::println("trajectory pack: ${packed_path} ${line}");
            }
        }
        packed::MetadataResult::Err(message) => {
            io::println("trajectory pack: ${packed_path} metadata=invalid (${message})");
        }
    }
}

fn env_switch(name: str) -> str {
    return if env::has_var(name) { "on" } else { "off" };
}

// Every environment switch that can change a trajectory's output, resolved
// once per run so the log records it and a stale export cannot hide.
fn print_trajectory_switches(
    shift_terminal_name: str,
    shift_terminal_source: str,
    profile_skip: str,
    cache_dit_enabled: bool,
    cache_dit_warmup: usize,
) {
    let warmup_name: text::Text = if cache_dit_enabled {
        "${cache_dit_warmup}"
    } else { text::from_str("n/a") };
    let mps_attention_output: str = env_switch("QI_DISABLE_MPS_ATTENTION_OUTPUT");
    let mpsgraph_attention: str = env_switch("QI_DISABLE_MPSGRAPH_ATTENTION");
    let direct_fp16: str = env_switch("QI_DISABLE_DIRECT_FP16_ACTIVATIONS");
    let pack_pread: str = env_switch("QI_DISABLE_PACK_PREAD");
    let weight_ring: str = env_switch("QI_DISABLE_WEIGHT_RING");
    let enable_weight_ring: str = env_switch("QI_ENABLE_WEIGHT_RING");
    let steel: str = env_switch("QI_DISABLE_STEEL_ATTENTION");
    let steel_prefill: str = env_switch("QI_STEEL_PREFILL");
    let sigma_spacing: str = env_switch("QI_TAYLOR_SIGMA_SPACING");
    let full_final_step: str = env_switch("QI_TAYLOR_FULL_FINAL_STEP");
    let early_cap3: str = env_switch("QI_TAYLOR_EARLY_CAP3");
    let cached_block: str = env_switch("QI_PROFILE_CACHED_BLOCK");
    let validate_blocks: str = env_switch("QI_VALIDATE_TRAJECTORY_BLOCKS");
    let validate_diff: str = env_switch("QI_VALIDATE_GPU_CACHE_DIFF");
    io::println("trajectory switches: shift_terminal=${shift_terminal_name} shift_terminal_source=${shift_terminal_source} profile_skip=${profile_skip} disable_mps_attention_output=${mps_attention_output} disable_mpsgraph_attention=${mpsgraph_attention} disable_direct_fp16_activations=${direct_fp16} disable_pack_pread=${pack_pread} enable_weight_ring=${enable_weight_ring} disable_weight_ring=${weight_ring} disable_steel_attention=${steel} steel_prefill=${steel_prefill} cache_dit_warmup=${warmup_name} taylor_sigma_spacing=${sigma_spacing} taylor_full_final_step=${full_final_step} taylor_early_cap3=${early_cap3} profile_cached_block=${cached_block} validate_trajectory_blocks=${validate_blocks} validate_gpu_cache_diff=${validate_diff}");
}

fn run_trajectory_packed_impl(
    packed_path: str,
    requested_steps: str,
    fixture_directory: str,
    final_latent: *f32,
    native_text_input: *f32,
    native_text_rows: usize,
    latent_seed: u64,
    native_inputs: bool,
    validate_reference: bool,
    cache_dit_enabled: bool,
    cache_dit_threshold_value: f64,
    pixels: usize = 256 as usize,
    taylorseer_enabled: bool = false,
    initial_latent: *f32 = 0 as *f32,
    bottleneck_shift: f32 = 0.0f32,
    bottleneck_strength: f32 = 1.0f32,
    q4_eager_expand: bool = false,
    q4_direct_packed: bool = false,
    image_width: usize = 0 as usize,
    image_height: usize = 0 as usize,
) -> i32 {
    if taylorseer_enabled && !cache_dit_enabled {
        io::eprintln("trajectory: TaylorSeer requires Cache-DiT");
        return 2;
    }
    if !mps::load_framework() {
        io::eprintln("trajectory: could not load MetalPerformanceShaders");
        return 1;
    }
    var step_limit: usize = 0 as usize;
    if requested_steps == "1" {
        step_limit = 1 as usize;
    } else if requested_steps == "2" {
        step_limit = 2 as usize;
    } else if requested_steps == "3" {
        step_limit = 3 as usize;
    } else if requested_steps == "4" {
        step_limit = 4 as usize;
    } else if requested_steps == "8" {
        step_limit = 8 as usize;
    } else if requested_steps == "13" {
        step_limit = 13 as usize;
    } else if requested_steps == "25" {
        step_limit = 25 as usize;
    } else if requested_steps == "40" {
        step_limit = 40 as usize;
    } else {
        io::eprintln("trajectory: steps must be 1, 2, 3, 4, 8, 13, 25, or 40");
        return 2;
    }
    let text_rows: usize = if native_inputs { native_text_rows } else { 22 as usize };
    if text_rows == (0 as usize) || text_rows > (512 as usize) {
        io::eprintln("trajectory: text row count must be 1..512, got ${text_rows}");
        return 2;
    }
    let output_width: usize = if image_width == (0 as usize) { pixels } else { image_width };
    let output_height: usize = if image_height == (0 as usize) { pixels } else { image_height };
    if output_width < (128 as usize) || output_height < (128 as usize)
        || output_width % (32 as usize) != (0 as usize)
        || output_height % (32 as usize) != (0 as usize) {
        io::eprintln("trajectory: width and height must be at least 128 and divisible by 32");
        return 2;
    }
    if validate_reference && step_limit == (25 as usize) {
        io::eprintln("trajectory: reference checkpoints require the canonical 40-step schedule");
        return 2;
    }
    // QI_PROFILE_SKIP drops transformer work from every block, so its output is
    // meaningless; only transformer-only benchmarks (no final latent) take it.
    let profile_skip: text::Text = match env::var("QI_PROFILE_SKIP") {
        option::Option[text::Text]::Some(value) => value,
        option::Option[text::Text]::None => text::from_str("none"),
    };
    if !final_latent.is_null() && env::has_var("QI_PROFILE_SKIP") {
        io::eprintln("trajectory: QI_PROFILE_SKIP=${profile_skip} is a benchmark-only ablation that omits transformer work; unset it to generate");
        return 2;
    }
    // Pack metadata owns the schedule. The environment override only applies
    // to packs that do not state shift_terminal, and it is logged.
    let pack_shift: u32 = pack_shift_terminal(packed_path);
    let no_shift_override: bool = env::has_var("QI_EXPERIMENT_NO_SHIFT_TERMINAL");
    if no_shift_override && pack_shift == PACK_SHIFT_TERMINAL_STRETCH {
        io::eprintln("trajectory: QI_EXPERIMENT_NO_SHIFT_TERMINAL conflicts with the pack's shift_terminal=0.02; unset it or change the pack metadata");
        return 2;
    }
    let stretch_terminal: bool = !no_shift_override && pack_shift != PACK_SHIFT_TERMINAL_NONE;
    let shift_terminal_source: str = if pack_shift != PACK_SHIFT_TERMINAL_UNSET {
        "pack"
    } else if no_shift_override { "env" } else { "default" };
    if pack_shift == PACK_SHIFT_TERMINAL_UNSET && no_shift_override {
        io::eprintln("trajectory: QI_EXPERIMENT_NO_SHIFT_TERMINAL overrides the default shift_terminal=0.02");
    }
    let shift_terminal_name: str = if stretch_terminal { "0.02" } else { "none" };
    guard let option::Option[usize]::Some(cache_dit_warmup) = cache_dit_warmup_steps() else {
        io::eprintln("trajectory: QI_CACHE_DIT_WARMUP must be 1, 2, 3, or 4");
        return 2;
    };
    print_pack_identity(packed_path);
    print_trajectory_switches(
        shift_terminal_name, shift_terminal_source, profile_skip.view(), cache_dit_enabled,
        cache_dit_warmup,
    );
    let latent_height: usize = output_height / (16 as usize);
    let latent_width: usize = output_width / (16 as usize);
    let target_rows: usize = latent_height *% latent_width;
    if target_rows > (4096 as usize) {
        io::eprintln("trajectory: output exceeds the verified 4096-token memory ceiling");
        return 2;
    }
    let rows: usize = text_rows +% target_rows;
    let latent_count: usize = target_rows *% IMAGE_CHANNELS;
    var sigmas: [f32; 41] = [0.0f32; 41];
    var timesteps: [f32; 40] = [0.0f32; 40];
    let schedule_steps: usize = if step_limit <= (2 as usize) {
        40 as usize
    } else { step_limit };
    let schedule_ok: bool = if bottleneck_shift > 0.0f32 {
        flow::fill_bottleneck_schedule(
            schedule_steps,
            bottleneck_shift,
            bottleneck_strength,
            #addr_of(sigmas[0]),
            #addr_of(timesteps[0]),
        )
    } else {
        flow::fill_schedule(
            schedule_steps,
            target_rows,
            #addr_of(sigmas[0]),
            #addr_of(timesteps[0]),
            stretch_terminal,
        )
    };
    if !schedule_ok {
        io::eprintln("trajectory: could not construct the ${schedule_steps}-step FlowMatch schedule");
        return 1;
    }
    let packed_load_start_ms: i64 = time::now_millis();
    guard let packed::LoadResult::Ok(weight_file) = packed::load(packed_path) else {
        io::eprintln("trajectory: could not load validated packed file ${packed_path}");
        return 1;
    };
    let packed_load_wall_ms: i64 = time::now_millis() - packed_load_start_ms;

    let metal_pipeline_start_ms: i64 = time::now_millis();
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return 1; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    let device_pointer: *u8 = MTLCreateSystemDefaultDevice();
    if device_pointer.is_null() { return 1; }
    let device_owner: OwnedObjc = OwnedObjc::new(rt::retain(device_pointer));
    let device: metal::Device = metal::Device::from_raw(device_owner.raw());
    guard let option::Option[metal::CommandQueue]::Some(queue) = device.new_command_queue() else { return 1; };
    let queue_owner: OwnedObjc = OwnedObjc::new(queue.raw());
    let options_pointer: *u8 = rt::alloc_init(#str_ptr("MTLCompileOptions\0"));
    if options_pointer.is_null() { return 1; }
    let options_owner: OwnedObjc = OwnedObjc::new(options_pointer);
    let options: metal::CompileOptions = metal::CompileOptions::from_raw(options_owner.raw());
    options.set_fast_math_enabled(false);
    var compile_error: *u8 = 0 as *u8;
    guard let option::Option[metal::Library]::Some(library) = device.new_library_with_source(
        #include_str("../kernels/transformer_block.metal"), options, #addr_of(compile_error) as *u8,
    ) else {
        if !compile_error.is_null() {
            let description: *u8 = rt::msg_id(compile_error, rt::sel(#str_ptr("localizedDescription\0")));
            io::eprintln("trajectory Metal compile: ${bridge::to_text(description)}");
        }
        return 1;
    };
    let library_owner: OwnedObjc = OwnedObjc::new(library.raw());
    guard let option::Option[OwnedObjc]::Some(dense_owner) = pipeline(device, library, "qi_block_linear_32x32") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(int8_owner) = pipeline(device, library, "qi_block_int8_affine_linear_32x32") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(dense_fast_owner) = pipeline(device, library, "qi_block_linear_simdgroup_half_64x32") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(int8_fast_owner) = pipeline(device, library, "qi_block_int8_simdgroup_half_64x32") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(dense_cached_owner) = pipeline(device, library, "qi_block_linear_simdgroup_half_64x64_direct") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(int8_cached_owner) = pipeline(device, library, "qi_block_int8_simdgroup_half_64x64_direct") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(q4_owner) = pipeline(device, library, "qi_block_q4_simdgroup_half_64x64") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(q4_exact_owner) = pipeline(device, library, "qi_block_q4_simdgroup_half_64x64_direct") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(q4_expand_owner) = pipeline(device, library, "qi_q4_weight_to_half") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(q4_direct_owner) = pipeline(device, library, "qi_block_q4_direct_half4_16x32") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(q4_repack_owner) = pipeline(device, library, "qi_q4_repack_direct") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(norm_owner) = pipeline(device, library, "qi_block_layernorm_modulate") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(qk_owner) = pipeline(device, library, "qi_block_qk_norm_rope") else { return 1; };
    let flash_attention: bool = target_rows == (256 as usize) || target_rows == (4096 as usize);
    let use_graph_attention: bool = target_rows == (4096 as usize)
        && !env::has_var("QI_DISABLE_MPSGRAPH_ATTENTION");
    let attention_kernel_name: str = if flash_attention {
        "qi_block_attention_flash128"
    } else {
        "qi_block_attention_simdgroup"
    };
    guard let option::Option[OwnedObjc]::Some(attention_owner) =
        pipeline(device, library, attention_kernel_name) else { return 1; };
    guard let option::Option[OwnedObjc]::Some(residual_owner) = pipeline(device, library, "qi_block_residual") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(swiglu_owner) = pipeline(device, library, "qi_block_swiglu") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(time_owner) = pipeline(device, library, "qi_time_projection") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(silu_owner) = pipeline(device, library, "qi_silu") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(gelu_owner) = pipeline(device, library, "qi_gelu_tanh") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(text_norm_owner) = pipeline(device, library, "qi_zero_center_rms_norm") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(assemble_owner) = pipeline(device, library, "qi_joint_assemble") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(final_norm_owner) = pipeline(device, library, "qi_final_layernorm_modulate") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(cache_copy_owner) = pipeline(device, library, "qi_copy_prefix_kv") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(flash_prepare_owner) = pipeline(device, library, "qi_flash_prepare_kv") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(mps_input_owner) = pipeline(device, library, "qi_mps_input_to_half") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(norm_half_owner) = pipeline(device, library, "qi_block_layernorm_modulate_half") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(swiglu_half_owner) = pipeline(device, library, "qi_block_swiglu_half") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(cache_first_residual_owner) = pipeline(device, library, "qi_cache_first_residual") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(cache_store_residual_owner) = pipeline(device, library, "qi_cache_store_residual") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(cache_apply_residual_owner) = pipeline(device, library, "qi_cache_apply_residual") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(taylor_store_residual_owner) = pipeline(device, library, "qi_taylor_store_residual") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(taylor_apply_residual_owner) = pipeline(device, library, "qi_taylor_apply_residual") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(cache_relative_l1_partials_owner) = pipeline(device, library, "qi_cache_relative_l1_partials") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(cache_relative_l1_finish_owner) = pipeline(device, library, "qi_cache_relative_l1_finish") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(mps_bf16_owner) = pipeline(device, library, "qi_mps_bf16_weight_to_half") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(mps_q8_owner) = pipeline(device, library, "qi_mps_q8_weight_to_half") else { return 1; };
    let pipelines: Pipelines = Pipelines {
        dense_linear: metal::ComputePipelineState::from_raw(dense_owner.raw()),
        dense_linear_fast: metal::ComputePipelineState::from_raw(dense_fast_owner.raw()),
        dense_linear_cached: metal::ComputePipelineState::from_raw(dense_cached_owner.raw()),
        int8_linear: metal::ComputePipelineState::from_raw(int8_owner.raw()),
        int8_linear_fast: metal::ComputePipelineState::from_raw(int8_fast_owner.raw()),
        int8_linear_cached: metal::ComputePipelineState::from_raw(int8_cached_owner.raw()),
        q4_linear: metal::ComputePipelineState::from_raw(q4_owner.raw()),
        q4_linear_exact: metal::ComputePipelineState::from_raw(q4_exact_owner.raw()),
        q4_direct_linear: metal::ComputePipelineState::from_raw(q4_direct_owner.raw()),
        norm: metal::ComputePipelineState::from_raw(norm_owner.raw()),
        qk: metal::ComputePipelineState::from_raw(qk_owner.raw()),
        attention: metal::ComputePipelineState::from_raw(attention_owner.raw()),
        attention_threads: if flash_attention {
            128 as usize
        } else {
            32 as usize
        },
        attention_queries_per_group: if flash_attention {
            8 as usize
        } else {
            2 as usize
        },
        residual: metal::ComputePipelineState::from_raw(residual_owner.raw()),
        swiglu: metal::ComputePipelineState::from_raw(swiglu_owner.raw()),
    };
    let time_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(time_owner.raw());
    let silu_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(silu_owner.raw());
    let gelu_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(gelu_owner.raw());
    let text_norm_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(text_norm_owner.raw());
    let assemble_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(assemble_owner.raw());
    let final_norm_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(final_norm_owner.raw());
    let cache_copy_pipeline: metal::ComputePipelineState = if flash_attention {
        metal::ComputePipelineState::from_raw(flash_prepare_owner.raw())
    } else {
        metal::ComputePipelineState::from_raw(cache_copy_owner.raw())
    };
    let mps_input_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(mps_input_owner.raw());
    let norm_half_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(norm_half_owner.raw());
    let swiglu_half_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(swiglu_half_owner.raw());
    let mps_bf16_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(mps_bf16_owner.raw());
    let mps_q8_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(mps_q8_owner.raw());
    let q4_expand_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(q4_expand_owner.raw());
    let q4_repack_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(q4_repack_owner.raw());
    let cache_first_residual_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(cache_first_residual_owner.raw());
    let cache_store_residual_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(cache_store_residual_owner.raw());
    let cache_apply_residual_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(cache_apply_residual_owner.raw());
    let taylor_store_residual_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(taylor_store_residual_owner.raw());
    let taylor_apply_residual_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(taylor_apply_residual_owner.raw());
    let cache_relative_l1_partials_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(cache_relative_l1_partials_owner.raw());
    let cache_relative_l1_finish_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(cache_relative_l1_finish_owner.raw());
    let metal_pipeline_wall_ms: i64 = time::now_millis() - metal_pipeline_start_ms;

    let storage_and_weights_start_ms: i64 = time::now_millis();
    let ring_wanted: bool = (target_rows == (4096 as usize) || env::has_var("QI_ENABLE_WEIGHT_RING"))
        && weight_file.all_block_matrices_fp16()
        && !cache_dit_enabled
        && !env::has_var("QI_PROFILE_CACHED_BLOCK")
        && !env::has_var("QI_VALIDATE_TRAJECTORY_BLOCKS")
        && !env::has_var("QI_DISABLE_PACK_PREAD")
        && !env::has_var("QI_DISABLE_WEIGHT_RING");
    var ring_regions: [RingRegion; 32] =
        [RingRegion {
        file_begin: 0 as u64, length: 0 as usize,
        tensor_begin: 0 as u64, tensor_end: 0 as u64,
    }; 32];
    var ring_slot_bytes: usize = 0 as usize;
    let ring_prefix_bytes: usize = if ring_wanted {
        plan_weight_ring(weight_file, ring_regions, ring_slot_bytes)
    } else { 0 as usize };
    let use_weight_ring: bool = ring_prefix_bytes > (0 as usize);
    let weight_ring_reason: str = if use_weight_ring {
        if target_rows == (4096 as usize) { "4096-token-default" } else { "explicit-memory-saving" }
    } else { "resident" };
    if ring_wanted && !use_weight_ring {
        io::eprintln("trajectory: pack layout does not allow the weight ring; keeping the resident copy");
    }
    let ring_reader: mapped::PositionalReader = if use_weight_ring {
        guard let option::Option[mapped::PositionalReader]::Some(reader) =
            mapped::open_positional_reader(packed_path) else { return 1; };
        reader
    } else { mapped::inactive_positional_reader() };
    var weight_ring: WeightRing = WeightRing {
        reader: ring_reader,
        slots: [0 as *u8; 3],
        inflight: [0 as *u8; 3],
        regions: ring_regions,
        reads: vec::Vec[thread::JoinHandle[i64]]::with_capacity(WEIGHT_RING_SLOTS),
        next_read: 0 as usize,
        expected_next: 0 as usize,
        total: if use_weight_ring { step_limit *% (32 as usize) } else { 0 as usize },
        ok: true,
        gpu_ms: 0.0f64,
        acquire_wait_ms: 0 as i64,
        retire_wait_ms: 0 as i64,
    };
    if use_weight_ring {
        var slot: usize = 0 as usize;
        while slot < WEIGHT_RING_SLOTS {
            guard let option::Option[metal::Buffer]::Some(slot_buffer) =
                new_buffer(device, ring_slot_bytes as u64) else { return 1; };
            weight_ring.slots[slot] = slot_buffer.raw();
            slot = slot +% (1 as usize);
        }
        // Start the first blocks while the rest of setup runs.
        weight_ring.issue_until(WEIGHT_RING_SLOTS -% (1 as usize));
    }
    guard let option::Option[metal::Buffer]::Some(storage) =
        if !env::has_var("QI_DISABLE_PACK_PREAD") {
        read_packed_storage_buffer(device, packed_path, weight_file, ring_prefix_bytes)
    } else { packed_storage_buffer(device, weight_file) } else { return 1; };
    let storage_owner: OwnedObjc = OwnedObjc::new(storage.raw());
    let q4_model: bool = weight_file.int4_rotated();
    let eager_q4: bool = q4_model && q4_eager_expand;
    let direct_q4: bool = q4_model && q4_direct_packed;
    if eager_q4 && direct_q4 {
        io::eprintln("trajectory: Q4 eager and direct modes are mutually exclusive");
        return 2;
    }
    guard let option::Option[metal::Buffer]::Some(eager_storage) = new_buffer(
        device, if eager_q4 { weight_file.eager_fp16_bytes() } else { 2 as u64 },
    ) else { return 1; };
    let eager_storage_owner: OwnedObjc = OwnedObjc::new(eager_storage.raw());
    guard let option::Option[metal::Buffer]::Some(direct_storage) = new_buffer(
        device, if direct_q4 { weight_file.length() as u64 } else { 2 as u64 },
    ) else { return 1; };
    let direct_storage_owner: OwnedObjc = OwnedObjc::new(direct_storage.raw());
    var eager_expand_gpu_ms: f64 = 0.0f64;
    var direct_repack_gpu_ms: f64 = 0.0f64;
    if eager_q4 {
        guard let option::Option[f64]::Some(expand_ms) = expand_q4_weights_eager(
            queue, q4_expand_pipeline, weight_file, storage, eager_storage,
        ) else { return 1; };
        eager_expand_gpu_ms = expand_ms;
    }
    if direct_q4 {
        guard let option::Option[f64]::Some(repack_ms) = repack_q4_weights_direct(
            queue, q4_repack_pipeline, weight_file, storage, direct_storage,
        ) else { return 1; };
        direct_repack_gpu_ms = repack_ms;
    }
    guard let option::Option[LinearWeight]::Some(img_in_weight) = runtime_linear_weight(weight_file, storage, eager_storage, direct_storage, eager_q4, direct_q4, "img_in.weight", WIDTH as u64, IMAGE_CHANNELS as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(text_in_weight) = runtime_linear_weight(weight_file, storage, eager_storage, direct_storage, eager_q4, direct_q4, "txt_in.in_layer.weight", WIDTH as u64, WIDTH as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(text_out_weight) = runtime_linear_weight(weight_file, storage, eager_storage, direct_storage, eager_q4, direct_q4, "txt_in.out_layer.weight", WIDTH as u64, WIDTH as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(time_1_weight) = runtime_linear_weight(weight_file, storage, eager_storage, direct_storage, eager_q4, direct_q4, "time_text_embed.timestep_embedder.linear_1.weight", WIDTH as u64, 256 as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(time_2_weight) = runtime_linear_weight(weight_file, storage, eager_storage, direct_storage, eager_q4, direct_q4, "time_text_embed.timestep_embedder.linear_2.weight", WIDTH as u64, WIDTH as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(modulation_weight) = runtime_linear_weight(weight_file, storage, eager_storage, direct_storage, eager_q4, direct_q4, "modulation.1.weight", ((4 as usize) *% WIDTH) as u64, WIDTH as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(final_scale_weight) = runtime_linear_weight(weight_file, storage, eager_storage, direct_storage, eager_q4, direct_q4, "norm_out.linear.weight", WIDTH as u64, WIDTH as u64) else { return 1; };
    guard let option::Option[LinearWeight]::Some(proj_out_weight) = runtime_linear_weight(weight_file, storage, eager_storage, direct_storage, eager_q4, direct_q4, "proj_out.weight", IMAGE_CHANNELS as u64, WIDTH as u64) else { return 1; };
    guard let option::Option[metal::Buffer]::Some(text_norm_weight) = packed_vector_buffer(device, weight_file, "txt_in.text_norm.weight", WIDTH as u64) else { return 1; };
    let text_norm_weight_owner: OwnedObjc = OwnedObjc::new(text_norm_weight.raw());
    let storage_and_weights_wall_ms: i64 = time::now_millis() - storage_and_weights_start_ms;

    let buffers_and_prefix_start_ms: i64 = time::now_millis();
    let activation_bytes: u64 = (rows *% WIDTH *% #size_of::[f32]()) as u64;
    let text_bytes: u64 = (text_rows *% WIDTH *% #size_of::[f32]()) as u64;
    let image_input_bytes: u64 = (latent_count *% #size_of::[f32]()) as u64;
    let image_projected_bytes: u64 = (target_rows *% WIDTH *% #size_of::[f32]()) as u64;
    let mlp_bytes: u64 = (rows *% MLP_WIDTH *% #size_of::[f32]()) as u64;
    let per_block_cache_bytes: u64 = (text_rows *% WIDTH *% if flash_attention {
        #size_of::[u16]()
    } else {
        #size_of::[f32]()
    }) as u64;
    let cache_arena_bytes: u64 = (32 as u64) *% per_block_cache_bytes;

    guard let option::Option[metal::Buffer]::Some(dummy) = new_buffer(device, 4 as u64) else { return 1; }; let dummy_owner: OwnedObjc = OwnedObjc::new(dummy.raw());
    guard let option::Option[metal::Buffer]::Some(latents) = if native_inputs {
        new_buffer(device, image_input_bytes)
    } else {
        fixture_buffer(device, fixture_directory, "image_input", image_input_bytes)
    } else { return 1; };
    let latents_owner: OwnedObjc = OwnedObjc::new(latents.raw());
    if native_inputs {
        if !initial_latent.is_null() {
            let latent_values: *f32 = latents.contents() as *f32;
            var latent_index: usize = 0 as usize;
            while latent_index < latent_count {
                latent_values[latent_index] = initial_latent[latent_index];
                latent_index = latent_index +% (1 as usize);
            }
        } else if !fill_seeded_latent(latents.contents() as *f32, latent_count, latent_seed) {
            io::eprintln("trajectory: could not generate the seeded latent");
            return 1;
        }
    }
    guard let option::Option[metal::Buffer]::Some(text_input) = if native_inputs {
        device.new_buffer_with_bytes(
            native_text_input as *u8,
            text_bytes,
            metal::resource_options_m_t_l_resource_storage_mode_shared,
        )
    } else {
        fixture_buffer(device, fixture_directory, "text_input", text_bytes)
    } else { return 1; };
    let text_input_owner: OwnedObjc = OwnedObjc::new(text_input.raw());
    let rope_bytes: u64 = (rows *% HEAD_DIMENSION *% #size_of::[f32]()) as u64;
    guard let option::Option[metal::Buffer]::Some(rope) = if native_inputs {
        new_buffer(device, rope_bytes)
    } else {
        fixture_buffer(device, fixture_directory, "rope", rope_bytes)
    } else { return 1; };
    let rope_owner: OwnedObjc = OwnedObjc::new(rope.raw());
    if native_inputs && !fill_target_rope(
        rope.contents() as *f32, text_rows, latent_height, latent_width,
    ) {
        io::eprintln("trajectory: could not construct dynamic RoPE");
        return 1;
    }
    let startup_inputs_ms: i64 = time::now_millis();
    if validate_reference {
        guard let option::Option[metal::Buffer]::Some(expected_sigmas) = fixture_buffer(device, fixture_directory, "sigmas", ((41 as usize) *% #size_of::[f32]()) as u64) else { return 1; };
        let expected_sigmas_owner: OwnedObjc = OwnedObjc::new(expected_sigmas.raw());
        guard let option::Option[metal::Buffer]::Some(expected_timesteps) = fixture_buffer(device, fixture_directory, "timesteps", ((40 as usize) *% #size_of::[f32]()) as u64) else { return 1; };
        let expected_timesteps_owner: OwnedObjc = OwnedObjc::new(expected_timesteps.raw());
        let sigma_reference: *f32 = expected_sigmas.contents() as *f32;
        let timestep_reference: *f32 = expected_timesteps.contents() as *f32;
        var schedule_index: usize = 0 as usize;
        while schedule_index < (40 as usize) {
            if (sigmas[schedule_index] - sigma_reference[schedule_index]).abs() > 0.000002f32
                || (timesteps[schedule_index] - timestep_reference[schedule_index]).abs() > 0.002f32 {
                io::eprintln("trajectory: scheduler mismatch at step ${schedule_index}");
                return 1;
            }
            schedule_index = schedule_index +% (1 as usize);
        }
        if sigmas[40] != sigma_reference[40] {
            io::eprintln("trajectory: scheduler endpoint mismatch");
            return 1;
        }
        if native_inputs {
            guard let option::Option[metal::Buffer]::Some(expected_noise) = fixture_buffer(device, fixture_directory, "image_input", image_input_bytes) else { return 1; };
            let expected_noise_owner: OwnedObjc = OwnedObjc::new(expected_noise.raw());
            let noise_error: f64 = normalized_rms_buffers(latents, 0 as usize, expected_noise, 0 as usize, latent_count);
            guard let option::Option[metal::Buffer]::Some(expected_rope) = fixture_buffer(device, fixture_directory, "rope", rope_bytes) else { return 1; };
            let expected_rope_owner: OwnedObjc = OwnedObjc::new(expected_rope.raw());
            let rope_error: f64 = normalized_rms_buffers(rope, 0 as usize, expected_rope, 0 as usize, rows *% HEAD_DIMENSION);
            io::println("trajectory native inputs: seed=${latent_seed} noise_nRMSE=${noise_error} rope_nRMSE=${rope_error}");
            if noise_error > (0.000001f64) || rope_error > (0.000001f64) { return 1; }
        }
    }

    guard let option::Option[metal::Buffer]::Some(image_projected) = new_buffer(device, image_projected_bytes) else { return 1; }; let image_projected_owner: OwnedObjc = OwnedObjc::new(image_projected.raw());
    guard let option::Option[metal::Buffer]::Some(text_normalized) = new_buffer(device, text_bytes) else { return 1; }; let text_normalized_owner: OwnedObjc = OwnedObjc::new(text_normalized.raw());
    guard let option::Option[metal::Buffer]::Some(text_hidden) = new_buffer(device, text_bytes) else { return 1; }; let text_hidden_owner: OwnedObjc = OwnedObjc::new(text_hidden.raw());
    guard let option::Option[metal::Buffer]::Some(text_activated) = new_buffer(device, text_bytes) else { return 1; }; let text_activated_owner: OwnedObjc = OwnedObjc::new(text_activated.raw());
    guard let option::Option[metal::Buffer]::Some(text_projected) = new_buffer(device, text_bytes) else { return 1; }; let text_projected_owner: OwnedObjc = OwnedObjc::new(text_projected.raw());
    let conditioning_rows: usize = (2 as usize) *% step_limit;
    guard let option::Option[metal::Buffer]::Some(timestep) = new_buffer(device, (conditioning_rows *% #size_of::[f32]()) as u64) else { return 1; }; let timestep_owner: OwnedObjc = OwnedObjc::new(timestep.raw());
    guard let option::Option[metal::Buffer]::Some(time_projection) = new_buffer(device, (conditioning_rows *% (256 as usize) *% #size_of::[f32]()) as u64) else { return 1; }; let time_projection_owner: OwnedObjc = OwnedObjc::new(time_projection.raw());
    guard let option::Option[metal::Buffer]::Some(time_hidden) = new_buffer(device, (conditioning_rows *% WIDTH *% #size_of::[f32]()) as u64) else { return 1; }; let time_hidden_owner: OwnedObjc = OwnedObjc::new(time_hidden.raw());
    guard let option::Option[metal::Buffer]::Some(time_activated_hidden) = new_buffer(device, (conditioning_rows *% WIDTH *% #size_of::[f32]()) as u64) else { return 1; }; let time_activated_hidden_owner: OwnedObjc = OwnedObjc::new(time_activated_hidden.raw());
    guard let option::Option[metal::Buffer]::Some(time_embedding) = new_buffer(device, (conditioning_rows *% WIDTH *% #size_of::[f32]()) as u64) else { return 1; }; let time_embedding_owner: OwnedObjc = OwnedObjc::new(time_embedding.raw());
    guard let option::Option[metal::Buffer]::Some(activated_time) = new_buffer(device, (conditioning_rows *% WIDTH *% #size_of::[f32]()) as u64) else { return 1; }; let activated_time_owner: OwnedObjc = OwnedObjc::new(activated_time.raw());
    guard let option::Option[metal::Buffer]::Some(modulation_table) = new_buffer(device, (conditioning_rows *% (4 as usize) *% WIDTH *% #size_of::[f32]()) as u64) else { return 1; }; let modulation_table_owner: OwnedObjc = OwnedObjc::new(modulation_table.raw());
    guard let option::Option[metal::Buffer]::Some(final_scale_table) = new_buffer(device, (conditioning_rows *% WIDTH *% #size_of::[f32]()) as u64) else { return 1; }; let final_scale_table_owner: OwnedObjc = OwnedObjc::new(final_scale_table.raw());
    guard let option::Option[metal::Buffer]::Some(modulation) = new_buffer(device, ((2 as usize) *% (4 as usize) *% WIDTH *% #size_of::[f32]()) as u64) else { return 1; }; let modulation_owner: OwnedObjc = OwnedObjc::new(modulation.raw());
    guard let option::Option[metal::Buffer]::Some(first_hidden) = new_buffer(device, activation_bytes) else { return 1; }; let first_hidden_owner: OwnedObjc = OwnedObjc::new(first_hidden.raw());
    guard let option::Option[metal::Buffer]::Some(second_hidden) = new_buffer(device, activation_bytes) else { return 1; }; let second_hidden_owner: OwnedObjc = OwnedObjc::new(second_hidden.raw());

    let startup_conditioning_buffers_ms: i64 = time::now_millis();
    var params: BlockParams = BlockParams { rows: text_rows as u32, width: WIDTH as u32, heads: HEADS as u32, head_dimension: HEAD_DIMENSION as u32, epsilon: 0.000001f32, slot: 0 as u32, input_stride: WIDTH as u32, input_offset: 0 as u32 };
    var total_ms: f64 = 0.0f64;
    guard let option::Option[f64]::Some(text_norm_ms) = dispatch_1d(queue, text_norm_pipeline, text_input, text_norm_weight, text_normalized, dummy, dummy, dummy, #addr_of(params), text_rows) else { return 1; }; total_ms = total_ms + text_norm_ms;
    guard let option::Option[f64]::Some(text_in_ms) = dispatch_weighted_linear(queue, pipelines, text_normalized, text_in_weight, text_hidden, WIDTH, WIDTH, text_rows) else { return 1; }; total_ms = total_ms + text_in_ms;
    guard let option::Option[f64]::Some(gelu_ms) = dispatch_1d(queue, gelu_pipeline, text_hidden, dummy, text_activated, dummy, dummy, dummy, #addr_of(params), text_rows *% WIDTH) else { return 1; }; total_ms = total_ms + gelu_ms;
    guard let option::Option[f64]::Some(text_out_ms) = dispatch_weighted_linear(queue, pipelines, text_activated, text_out_weight, text_projected, WIDTH, WIDTH, text_rows) else { return 1; }; total_ms = total_ms + text_out_ms;

    let startup_text_projection_ms: i64 = time::now_millis();
    guard let option::Option[metal::Buffer]::Some(source_index) = new_buffer(device, (rows *% #size_of::[i32]()) as u64) else { return 1; }; let source_index_owner: OwnedObjc = OwnedObjc::new(source_index.raw());
    let sources: *i32 = source_index.contents() as *i32;
    var row: usize = 0 as usize;
    while row < text_rows { sources[row] = 0 -% (row as i32) -% (1 as i32); row = row +% (1 as usize); }
    while row < rows { sources[row] = (row -% text_rows) as i32; row = row +% (1 as usize); }
    guard let option::Option[metal::Buffer]::Some(target_mask) = new_buffer(device, rows as u64) else { return 1; }; let target_mask_owner: OwnedObjc = OwnedObjc::new(target_mask.raw());
    guard let option::Option[metal::Buffer]::Some(image_ids) = new_buffer(device, (rows *% #size_of::[i32]()) as u64) else { return 1; }; let image_ids_owner: OwnedObjc = OwnedObjc::new(image_ids.raw());
    guard let option::Option[metal::Buffer]::Some(key_valid) = new_buffer(device, rows as u64) else { return 1; }; let key_valid_owner: OwnedObjc = OwnedObjc::new(key_valid.raw());
    let ids: *i32 = image_ids.contents() as *i32;
    row = 0 as usize;
    while row < rows {
        (target_mask.contents())[row] = if row >= text_rows { 1 as u8 } else { 0 as u8 };
        ids[row] = if row >= text_rows { 0 as i32 } else { 0 -% (1 as i32) };
        (key_valid.contents())[row] = 1 as u8;
        row = row +% (1 as usize);
    }
    guard let option::Option[metal::Buffer]::Some(cached_rope) = new_buffer(device, (target_rows *% HEAD_DIMENSION *% #size_of::[f32]()) as u64) else { return 1; }; let cached_rope_owner: OwnedObjc = OwnedObjc::new(cached_rope.raw());
    let rope_values: *f32 = rope.contents() as *f32;
    let cached_rope_values: *f32 = cached_rope.contents() as *f32;
    var copy_index: usize = 0 as usize;
    while copy_index < target_rows *% HEAD_DIMENSION {
        cached_rope_values[copy_index] = rope_values[text_rows *% HEAD_DIMENSION +% copy_index];
        copy_index = copy_index +% (1 as usize);
    }
    guard let option::Option[metal::Buffer]::Some(cached_target_mask) = new_buffer(device, target_rows as u64) else { return 1; }; let cached_target_mask_owner: OwnedObjc = OwnedObjc::new(cached_target_mask.raw());
    row = 0 as usize;
    while row < target_rows { (cached_target_mask.contents())[row] = 1 as u8; row = row +% (1 as usize); }
    guard let option::Option[metal::Buffer]::Some(graph_mask) = new_buffer(
        device,
        if use_graph_attention {
            (rows *% rows *% #size_of::[u16]()) as u64
        } else { #size_of::[u16]() as u64 },
    ) else { return 1; };
    let graph_mask_owner: OwnedObjc = OwnedObjc::new(graph_mask.raw());
    if use_graph_attention {
        let graph_mask_values: *u16 = graph_mask.contents() as *u16;
        var query_row: usize = 0 as usize;
        while query_row < rows {
            var key_row: usize = 0 as usize;
            while key_row < rows {
                let same_image: bool = query_row >= text_rows && key_row >= text_rows;
                graph_mask_values[query_row *% rows +% key_row] =
                    if query_row >= key_row || same_image {
                    0 as u16
                } else { 0xFBFF as u16 };
                key_row = key_row +% (1 as usize);
            }
            query_row = query_row +% (1 as usize);
        }
    }
    let startup_masks_ms: i64 = time::now_millis();
    let graph_prefill_attention: graph_attention::Attention = if use_graph_attention {
        guard let option::Option[graph_attention::Attention]::Some(value) =
            graph_attention::create(rows, rows, true) else { return 1; };
        value
    } else { graph_attention::disabled() };
    let graph_cached_attention: graph_attention::Attention = if use_graph_attention {
        guard let option::Option[graph_attention::Attention]::Some(value) =
            graph_attention::create(target_rows, rows) else { return 1; };
        value
    } else { graph_attention::disabled() };

    let startup_graphs_ms: i64 = time::now_millis();
    let direct_half_activations: bool = (weight_file.all_block_matrices_fp16() || eager_q4)
        && !env::has_var("QI_DISABLE_DIRECT_FP16_ACTIVATIONS");
    let fp32_norm_scratch_bytes: u64 = if direct_half_activations {
        2 as u64
    } else { activation_bytes };
    let fp32_swiglu_scratch_bytes: u64 = if direct_half_activations {
        2 as u64
    } else { mlp_bytes };
    guard let option::Option[metal::Buffer]::Some(norm1) = new_buffer(device, fp32_norm_scratch_bytes) else { return 1; }; let norm1_owner: OwnedObjc = OwnedObjc::new(norm1.raw());
    guard let option::Option[metal::Buffer]::Some(query) = new_buffer(device, activation_bytes) else { return 1; }; let query_owner: OwnedObjc = OwnedObjc::new(query.raw());
    guard let option::Option[metal::Buffer]::Some(key) = new_buffer(device, activation_bytes) else { return 1; }; let key_owner: OwnedObjc = OwnedObjc::new(key.raw());
    guard let option::Option[metal::Buffer]::Some(value) = new_buffer(device, activation_bytes) else { return 1; }; let value_owner: OwnedObjc = OwnedObjc::new(value.raw());
    guard let option::Option[metal::Buffer]::Some(query_rope) = new_buffer(device, activation_bytes) else { return 1; }; let query_rope_owner: OwnedObjc = OwnedObjc::new(query_rope.raw());
    guard let option::Option[metal::Buffer]::Some(key_rope) = new_buffer(device, activation_bytes) else { return 1; }; let key_rope_owner: OwnedObjc = OwnedObjc::new(key_rope.raw());
    guard let option::Option[metal::Buffer]::Some(attended) = new_buffer(device, activation_bytes) else { return 1; }; let attended_owner: OwnedObjc = OwnedObjc::new(attended.raw());
    guard let option::Option[metal::Buffer]::Some(attention_projected) = new_buffer(device, activation_bytes) else { return 1; }; let attention_projected_owner: OwnedObjc = OwnedObjc::new(attention_projected.raw());
    guard let option::Option[metal::Buffer]::Some(residual1) = new_buffer(device, activation_bytes) else { return 1; }; let residual1_owner: OwnedObjc = OwnedObjc::new(residual1.raw());
    guard let option::Option[metal::Buffer]::Some(norm2) = new_buffer(device, fp32_norm_scratch_bytes) else { return 1; }; let norm2_owner: OwnedObjc = OwnedObjc::new(norm2.raw());
    guard let option::Option[metal::Buffer]::Some(gate) = new_buffer(device, mlp_bytes) else { return 1; }; let gate_owner: OwnedObjc = OwnedObjc::new(gate.raw());
    guard let option::Option[metal::Buffer]::Some(projected) = new_buffer(device, mlp_bytes) else { return 1; }; let projected_owner: OwnedObjc = OwnedObjc::new(projected.raw());
    guard let option::Option[metal::Buffer]::Some(swiglu) = new_buffer(device, fp32_swiglu_scratch_bytes) else { return 1; }; let swiglu_buffer_owner: OwnedObjc = OwnedObjc::new(swiglu.raw());
    guard let option::Option[metal::Buffer]::Some(mlp_projected) = new_buffer(device, activation_bytes) else { return 1; }; let mlp_projected_owner: OwnedObjc = OwnedObjc::new(mlp_projected.raw());
    guard let option::Option[metal::Buffer]::Some(cache_key_arena) = new_buffer(device, cache_arena_bytes) else { return 1; }; let cache_key_arena_owner: OwnedObjc = OwnedObjc::new(cache_key_arena.raw());
    guard let option::Option[metal::Buffer]::Some(cache_value_arena) = new_buffer(device, cache_arena_bytes) else { return 1; }; let cache_value_arena_owner: OwnedObjc = OwnedObjc::new(cache_value_arena.raw());
    let workspace: BlockWorkspace = BlockWorkspace { modulation: modulation, rope: rope, target_mask: target_mask, image_ids: image_ids, key_valid: key_valid, dummy: dummy, norm1: norm1, query: query, key: key, value: value, query_rope: query_rope, key_rope: key_rope, attended: attended, attention_projected: attention_projected, residual1: residual1, norm2: norm2, gate: gate, projected: projected, swiglu: swiglu, mlp_projected: mlp_projected };
    let cached_workspace: BlockWorkspace = BlockWorkspace { modulation: modulation, rope: cached_rope, target_mask: cached_target_mask, image_ids: image_ids, key_valid: key_valid, dummy: dummy, norm1: norm1, query: query, key: key, value: value, query_rope: query_rope, key_rope: key_rope, attended: attended, attention_projected: attention_projected, residual1: residual1, norm2: norm2, gate: gate, projected: projected, swiglu: swiglu, mlp_projected: mlp_projected };
    guard let option::Option[metal::Buffer]::Some(mps_half_input) = new_buffer(device, (rows *% MLP_WIDTH *% (2 as usize)) as u64) else { return 1; }; let mps_half_input_owner: OwnedObjc = OwnedObjc::new(mps_half_input.raw());
    let mps_half_weight_bytes: u64 = if weight_file.all_block_matrices_fp16() || eager_q4 {
        2 as u64
    } else { (MLP_WIDTH *% WIDTH *% (2 as usize)) as u64 };
    guard let option::Option[metal::Buffer]::Some(mps_half_weight) = new_buffer(device, mps_half_weight_bytes) else { return 1; }; let mps_half_weight_owner: OwnedObjc = OwnedObjc::new(mps_half_weight.raw());
    // The steel kernel needs the MPS attention-output path (which reads its
    // FP16 output) and the 4096-row cached shape.
    let steel_wanted: bool = use_graph_attention && weight_file.all_block_matrices_fp16()
        && !env::has_var("QI_DISABLE_STEEL_ATTENTION")
        && !env::has_var("QI_DISABLE_MPS_ATTENTION_OUTPUT");
    let steel_library_owner: OwnedObjc = if steel_wanted {
        match create_steel_attention_library(device) {
            option::Option[OwnedObjc]::Some(owner) => owner,
            option::Option[OwnedObjc]::None => OwnedObjc::new(0 as *u8),
        }
    } else { OwnedObjc::new(0 as *u8) };
    let steel_attention_owner: OwnedObjc = match create_steel_attention_pipeline(
        device, steel_library_owner.raw(), target_rows, rows, false,
    ) {
        option::Option[OwnedObjc]::Some(owner) => owner,
        option::Option[OwnedObjc]::None => OwnedObjc::new(0 as *u8),
    };
    let steel_prefill_wanted: bool = env::has_var("QI_STEEL_PREFILL");
    let steel_causal_owner: OwnedObjc = if steel_prefill_wanted {
        match create_steel_attention_pipeline(
            device, steel_library_owner.raw(), text_rows, text_rows, true,
        ) {
            option::Option[OwnedObjc]::Some(owner) => owner,
            option::Option[OwnedObjc]::None => OwnedObjc::new(0 as *u8),
        }
    } else { OwnedObjc::new(0 as *u8) };
    let use_steel_attention: bool = !steel_attention_owner.raw().is_null()
        && (!steel_prefill_wanted || !steel_causal_owner.raw().is_null());
    if steel_wanted && !use_steel_attention {
        io::eprintln("trajectory: steel attention unavailable; using MPSGraph SDPA");
    }
    let mps_workspace: MpsWorkspace = MpsWorkspace {
        device: device,
        input_pipeline: mps_input_pipeline,
        norm_half_pipeline: norm_half_pipeline,
        swiglu_half_pipeline: swiglu_half_pipeline,
        bf16_pipeline: mps_bf16_pipeline,
        q8_pipeline: mps_q8_pipeline,
        half_input: mps_half_input,
        half_weight: mps_half_weight,
        direct_half_activations: direct_half_activations,
        steel_attention: metal::ComputePipelineState::from_raw(steel_attention_owner.raw()),
        steel_causal_attention: metal::ComputePipelineState::from_raw(steel_causal_owner.raw()),
        use_steel_attention: use_steel_attention,
        steel_key_rows: rows,
    };
    guard let option::Option[metal::Buffer]::Some(final_scale) = new_buffer(device, ((2 as usize) *% WIDTH *% #size_of::[f32]()) as u64) else { return 1; }; let final_scale_owner: OwnedObjc = OwnedObjc::new(final_scale.raw());
    guard let option::Option[metal::Buffer]::Some(final_normalized) = new_buffer(device, activation_bytes) else { return 1; }; let final_normalized_owner: OwnedObjc = OwnedObjc::new(final_normalized.raw());
    guard let option::Option[metal::Buffer]::Some(noise_output) = new_buffer(device, (rows *% IMAGE_CHANNELS *% #size_of::[f32]()) as u64) else { return 1; }; let noise_output_owner: OwnedObjc = OwnedObjc::new(noise_output.raw());
    guard let option::Option[metal::Buffer]::Some(cache_first_output) = new_buffer(device, image_projected_bytes) else { return 1; }; let cache_first_output_owner: OwnedObjc = OwnedObjc::new(cache_first_output.raw());
    guard let option::Option[metal::Buffer]::Some(cache_fn_a) = new_buffer(device, image_projected_bytes) else { return 1; }; let cache_fn_a_owner: OwnedObjc = OwnedObjc::new(cache_fn_a.raw());
    guard let option::Option[metal::Buffer]::Some(cache_fn_b) = new_buffer(device, image_projected_bytes) else { return 1; }; let cache_fn_b_owner: OwnedObjc = OwnedObjc::new(cache_fn_b.raw());
    guard let option::Option[metal::Buffer]::Some(cache_middle_residual) = new_buffer(device, image_projected_bytes) else { return 1; }; let cache_middle_residual_owner: OwnedObjc = OwnedObjc::new(cache_middle_residual.raw());
    let taylor_derivative_bytes: u64 = if taylorseer_enabled {
        image_projected_bytes
    } else {
        #size_of::[f32]() as u64
    };
    guard let option::Option[metal::Buffer]::Some(cache_middle_derivative) = new_buffer(device, taylor_derivative_bytes) else { return 1; }; let cache_middle_derivative_owner: OwnedObjc = OwnedObjc::new(cache_middle_derivative.raw());
    guard let option::Option[metal::Buffer]::Some(cache_diff_partials) = new_buffer(device, ((256 as usize) *% (2 as usize) *% #size_of::[f32]()) as u64) else { return 1; }; let cache_diff_partials_owner: OwnedObjc = OwnedObjc::new(cache_diff_partials.raw());
    guard let option::Option[metal::Buffer]::Some(cache_diff_result) = new_buffer(device, ((2 as usize) *% #size_of::[f32]()) as u64) else { return 1; }; let cache_diff_result_owner: OwnedObjc = OwnedObjc::new(cache_diff_result.raw());

    var all_ok: bool = true;
    var total_quantized_matrices: usize = 0 as usize;
    var previous_fn_residual: metal::Buffer = cache_fn_a;
    var current_fn_residual: metal::Buffer = cache_fn_b;
    var have_cache_residual: bool = false;
    var continuous_cached_steps: usize = 0 as usize;
    var total_cached_steps: usize = 0 as usize;
    var have_taylor_derivative: bool = false;
    var last_full_step: usize = 0 as usize;
    // TaylorSeer experiments: extrapolate over sigma distance instead of step
    // count (the shifted schedule is non-uniform), and optionally never
    // predict the final model evaluation.
    let taylor_sigma_spacing: bool = taylorseer_enabled
        && env::has_var("QI_TAYLOR_SIGMA_SPACING");
    let taylor_full_final_step: bool = taylorseer_enabled
        && env::has_var("QI_TAYLOR_FULL_FINAL_STEP");
    // Layout, including how many letters a word gets, settles in the first
    // half; allow only three predicted steps in a row there.
    let taylor_early_cap3: bool = taylorseer_enabled
        && env::has_var("QI_TAYLOR_EARLY_CAP3");
    let buffers_and_prefix_wall_ms: i64 = time::now_millis() - buffers_and_prefix_start_ms;
    io::println("trajectory startup detail: inputs_ms=${startup_inputs_ms - buffers_and_prefix_start_ms} conditioning_buffers_ms=${startup_conditioning_buffers_ms - startup_inputs_ms} text_projection_ms=${startup_text_projection_ms - startup_conditioning_buffers_ms} masks_ms=${startup_masks_ms - startup_text_projection_ms} graphs_ms=${startup_graphs_ms - startup_masks_ms} workspaces_ms=${time::now_millis() - startup_graphs_ms}");
    let if_ring_slots: usize = if use_weight_ring { WEIGHT_RING_SLOTS } else { 0 as usize };
    let resident_pack_bytes: usize = if use_weight_ring { ring_prefix_bytes } else { weight_file.length() };
    let q4_mode_name: str = if q4_model {
        if eager_q4 { "eager-fp16" }
        else if direct_q4 { "direct-packed" }
        else { "destination-expand" }
    } else { "none" };
    io::println(
        "trajectory startup: packed_validation_ms=${packed_load_wall_ms} metal_pipeline_ms=${metal_pipeline_wall_ms} storage_and_weights_ms=${storage_and_weights_wall_ms} q4_mode=${q4_mode_name} q4_expand_gpu_ms=${eager_expand_gpu_ms} q4_repack_gpu_ms=${direct_repack_gpu_ms} buffers_and_prefix_ms=${buffers_and_prefix_wall_ms} direct_fp16_activations=${direct_half_activations} steel_attention=${use_steel_attention} weight_ring=${use_weight_ring} weight_ring_reason=${weight_ring_reason} ring_slots=${if_ring_slots} ring_slot_bytes=${ring_slot_bytes} resident_pack_bytes=${resident_pack_bytes} fp32_activation_scratch_bytes=${(2 as u64) *% fp32_norm_scratch_bytes +% fp32_swiglu_scratch_bytes}",
    );
    let trajectory_wall_start_ms: i64 = time::now_millis();
    let timestep_values: *f32 = timestep.contents() as *f32;
    var conditioning_step: usize = 0 as usize;
    while conditioning_step < step_limit {
        timestep_values[conditioning_step *% (2 as usize)] =
            model_timestep(timesteps[conditioning_step]);
        timestep_values[conditioning_step *% (2 as usize) +% (1 as usize)] = 0.0f32;
        conditioning_step = conditioning_step +% (1 as usize);
    }
    var conditioning_precompute_ms: f64 = 0.0f64;
    params.rows = conditioning_rows as u32;
    params.width = 256 as u32;
    guard let option::Option[f64]::Some(time_projection_ms) = dispatch_1d(
        queue, time_pipeline, timestep, dummy, time_projection, dummy, dummy, dummy,
        #addr_of(params), conditioning_rows *% (256 as usize),
    ) else { return 1; };
    conditioning_precompute_ms = conditioning_precompute_ms + time_projection_ms;
    guard let option::Option[f64]::Some(time_1_ms) = dispatch_weighted_linear_scalar(
        queue, pipelines, time_projection, time_1_weight, time_hidden,
        WIDTH, 256 as usize, conditioning_rows,
    ) else { return 1; };
    conditioning_precompute_ms = conditioning_precompute_ms + time_1_ms;
    params.width = WIDTH as u32;
    guard let option::Option[f64]::Some(time_silu_ms) = dispatch_1d(
        queue, silu_pipeline, time_hidden, dummy, time_activated_hidden, dummy, dummy, dummy,
        #addr_of(params), conditioning_rows *% WIDTH,
    ) else { return 1; };
    conditioning_precompute_ms = conditioning_precompute_ms + time_silu_ms;
    guard let option::Option[f64]::Some(time_2_ms) = dispatch_weighted_linear_scalar(
        queue, pipelines, time_activated_hidden, time_2_weight, time_embedding,
        WIDTH, WIDTH, conditioning_rows,
    ) else { return 1; };
    conditioning_precompute_ms = conditioning_precompute_ms + time_2_ms;
    guard let option::Option[f64]::Some(activated_time_ms) = dispatch_1d(
        queue, silu_pipeline, time_embedding, dummy, activated_time, dummy, dummy, dummy,
        #addr_of(params), conditioning_rows *% WIDTH,
    ) else { return 1; };
    conditioning_precompute_ms = conditioning_precompute_ms + activated_time_ms;
    guard let option::Option[f64]::Some(modulation_ms) = dispatch_weighted_linear_scalar(
        queue, pipelines, activated_time, modulation_weight, modulation_table,
        (4 as usize) *% WIDTH, WIDTH, conditioning_rows,
    ) else { return 1; };
    conditioning_precompute_ms = conditioning_precompute_ms + modulation_ms;
    guard let option::Option[f64]::Some(final_scale_ms) = dispatch_weighted_linear_scalar(
        queue, pipelines, activated_time, final_scale_weight, final_scale_table,
        WIDTH, WIDTH, conditioning_rows,
    ) else { return 1; };
    conditioning_precompute_ms = conditioning_precompute_ms + final_scale_ms;
    total_ms = total_ms + conditioning_precompute_ms;
    io::println(
        "trajectory conditioning: rows=${conditioning_rows} gpu_ms=${conditioning_precompute_ms} batched_steps=${step_limit}",
    );
    var step: usize = 0 as usize;
    while step < step_limit {
        let step_pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
        if step_pool_pointer.is_null() { return 1; }
        let step_pool: OwnedObjc = OwnedObjc::new(step_pool_pointer);
        let step_wall_start_ms: i64 = time::now_millis();
        var step_ms: f64 = 0.0f64;
        let modulation_values: *f32 = modulation.contents() as *f32;
        let modulation_table_values: *f32 = modulation_table.contents() as *f32;
        let modulation_step_offset: usize = step *% (2 as usize) *% (4 as usize) *% WIDTH;
        var conditioning_index: usize = 0 as usize;
        while conditioning_index < (2 as usize) *% (4 as usize) *% WIDTH {
            modulation_values[conditioning_index] =
                modulation_table_values[modulation_step_offset +% conditioning_index];
            conditioning_index = conditioning_index +% (1 as usize);
        }
        let final_scale_values: *f32 = final_scale.contents() as *f32;
        let final_scale_table_values: *f32 = final_scale_table.contents() as *f32;
        let final_scale_step_offset: usize = step *% (2 as usize) *% WIDTH;
        conditioning_index = 0 as usize;
        while conditioning_index < (2 as usize) *% WIDTH {
            final_scale_values[conditioning_index] =
                final_scale_table_values[final_scale_step_offset +% conditioning_index];
            conditioning_index = conditioning_index +% (1 as usize);
        }
        guard let option::Option[f64]::Some(img_ms) = dispatch_weighted_linear(queue, pipelines, latents, img_in_weight, image_projected, WIDTH, IMAGE_CHANNELS, target_rows) else { return 1; }; step_ms = step_ms + img_ms;

        var active_rows: usize = target_rows;
        var cache_mode: u32 = 2 as u32;
        var active_workspace: BlockWorkspace = cached_workspace;
        var current: metal::Buffer = image_projected;
        var next: metal::Buffer = first_hidden;
        if step == (0 as usize) {
            params.rows = rows as u32;
            guard let option::Option[f64]::Some(assemble_ms) = dispatch_1d(queue, assemble_pipeline, text_projected, image_projected, first_hidden, source_index, dummy, dummy, #addr_of(params), rows *% WIDTH) else { return 1; }; step_ms = step_ms + assemble_ms;
            active_rows = rows;
            cache_mode = 1 as u32;
            active_workspace = workspace;
            current = first_hidden;
            next = second_hidden;
        }
        let first_block_input: metal::Buffer = current;
        var cache_dit_cached_step: bool = false;
        var cache_dit_diff: f64 = 0.0f64 - 1.0f64;

        let profile_cached_block: bool = env::has_var("QI_PROFILE_CACHED_BLOCK");
        let validate_trajectory_blocks: bool = env::has_var("QI_VALIDATE_TRAJECTORY_BLOCKS");
        let batch_transformer_step: bool = !cache_dit_enabled
            && !profile_cached_block
            && !validate_trajectory_blocks;
        guard let option::Option[metal::CommandBuffer]::Some(base_transformer_command_buffer) =
            queue.command_buffer() else { return 1; };
        let transformer_command_buffer_owner: OwnedObjc =
            OwnedObjc::new(rt::retain(base_transformer_command_buffer.raw()));
        guard let option::Option[graph_attention::CommandBufferContext]::Some(
            transformer_command_context,
        ) = graph_attention::wrap_command_buffer(
            base_transformer_command_buffer, use_graph_attention,
        ) else { return 1; };
        let transformer_command_buffer: metal::CommandBuffer =
            transformer_command_context.metal();

        var step_quantized_matrices: usize = 0 as usize;
        var block: usize = 0 as usize;
        while block < (32 as usize) {
            let block_metadata_start_ms: i64 = time::now_millis();
            let prefix: text::Text = "transformer_blocks.${block}.";
            let norm_q_name: text::Text = "${prefix}attn.norm_q.weight";
            let norm_k_name: text::Text = "${prefix}attn.norm_k.weight";
            guard let option::Option[metal::Buffer]::Some(norm_q) = packed_vector_buffer(device, weight_file, norm_q_name.view(), HEAD_DIMENSION as u64) else { return 1; }; let norm_q_owner: OwnedObjc = OwnedObjc::new(norm_q.raw());
            guard let option::Option[metal::Buffer]::Some(norm_k) = packed_vector_buffer(device, weight_file, norm_k_name.view(), HEAD_DIMENSION as u64) else { return 1; }; let norm_k_owner: OwnedObjc = OwnedObjc::new(norm_k.raw());
            let q_name: text::Text = "${prefix}attn.to_q.weight"; let k_name: text::Text = "${prefix}attn.to_k.weight"; let v_name: text::Text = "${prefix}attn.to_v.weight";
            let attention_output_name: text::Text = "${prefix}attn.to_out.0.weight"; let gate_name: text::Text = "${prefix}img_mlp.gate_layer.weight"; let projected_name: text::Text = "${prefix}img_mlp.proj.weight"; let mlp_output_name: text::Text = "${prefix}img_mlp.out.weight";
            let global_block: usize = step *% (32 as usize) +% block;
            if use_weight_ring && !weight_ring.acquire(global_block) {
                io::eprintln("trajectory: could not stream block ${block} weights");
                return 1;
            }
            let ring_slot: metal::Buffer = if use_weight_ring { weight_ring.slot(global_block) } else { storage };
            let ring_region: RingRegion = weight_ring.region(global_block);
            guard let option::Option[LinearWeight]::Some(q) = if use_weight_ring { ring_linear_weight(weight_file, ring_slot, ring_region, q_name.view(), WIDTH as u64, WIDTH as u64) } else { runtime_linear_weight(weight_file, storage, eager_storage, direct_storage, eager_q4, direct_q4, q_name.view(), WIDTH as u64, WIDTH as u64) } else { return 1; };
            guard let option::Option[LinearWeight]::Some(k) = if use_weight_ring { ring_linear_weight(weight_file, ring_slot, ring_region, k_name.view(), WIDTH as u64, WIDTH as u64) } else { runtime_linear_weight(weight_file, storage, eager_storage, direct_storage, eager_q4, direct_q4, k_name.view(), WIDTH as u64, WIDTH as u64) } else { return 1; };
            guard let option::Option[LinearWeight]::Some(v) = if use_weight_ring { ring_linear_weight(weight_file, ring_slot, ring_region, v_name.view(), WIDTH as u64, WIDTH as u64) } else { runtime_linear_weight(weight_file, storage, eager_storage, direct_storage, eager_q4, direct_q4, v_name.view(), WIDTH as u64, WIDTH as u64) } else { return 1; };
            guard let option::Option[LinearWeight]::Some(attention_output) = if use_weight_ring { ring_linear_weight(weight_file, ring_slot, ring_region, attention_output_name.view(), WIDTH as u64, WIDTH as u64) } else { runtime_linear_weight(weight_file, storage, eager_storage, direct_storage, eager_q4, direct_q4, attention_output_name.view(), WIDTH as u64, WIDTH as u64) } else { return 1; };
            guard let option::Option[LinearWeight]::Some(gate_weight) = if use_weight_ring { ring_linear_weight(weight_file, ring_slot, ring_region, gate_name.view(), MLP_WIDTH as u64, WIDTH as u64) } else { runtime_linear_weight(weight_file, storage, eager_storage, direct_storage, eager_q4, direct_q4, gate_name.view(), MLP_WIDTH as u64, WIDTH as u64) } else { return 1; };
            guard let option::Option[LinearWeight]::Some(projected_weight) = if use_weight_ring { ring_linear_weight(weight_file, ring_slot, ring_region, projected_name.view(), MLP_WIDTH as u64, WIDTH as u64) } else { runtime_linear_weight(weight_file, storage, eager_storage, direct_storage, eager_q4, direct_q4, projected_name.view(), MLP_WIDTH as u64, WIDTH as u64) } else { return 1; };
            guard let option::Option[LinearWeight]::Some(mlp_output) = if use_weight_ring { ring_linear_weight(weight_file, ring_slot, ring_region, mlp_output_name.view(), WIDTH as u64, MLP_WIDTH as u64) } else { runtime_linear_weight(weight_file, storage, eager_storage, direct_storage, eager_q4, direct_q4, mlp_output_name.view(), WIDTH as u64, MLP_WIDTH as u64) } else { return 1; };
            step_quantized_matrices = step_quantized_matrices +%
                (if q.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize }) +%
                (if k.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize }) +%
                (if v.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize }) +%
                (if attention_output.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize }) +%
                (if gate_weight.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize }) +%
                (if projected_weight.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize }) +%
                (if mlp_output.scheme == PACKED_SCHEME_INT8_AFFINE { 1 as usize } else { 0 as usize });
            let cache_offset: u64 = block as u64 *% per_block_cache_bytes;
            let block_weights: BlockWeights = BlockWeights { norm_q: norm_q, norm_k: norm_k, q: q, k: k, v: v, attention_output: attention_output, gate: gate_weight, projected: projected_weight, mlp_output: mlp_output };
            let block_metadata_wall_ms: i64 = time::now_millis() - block_metadata_start_ms;
            let batch_transformer_block: bool = batch_transformer_step
                || (cache_dit_enabled && !profile_cached_block && block > (0 as usize));
            if use_weight_ring {
                guard let option::Option[metal::CommandBuffer]::Some(block_base_command_buffer) =
                    queue.command_buffer() else { return 1; };
                let block_command_buffer_owner: OwnedObjc =
                    OwnedObjc::new(rt::retain(block_base_command_buffer.raw()));
                guard let option::Option[graph_attention::CommandBufferContext]::Some(
                    block_command_context,
                ) = graph_attention::wrap_command_buffer(
                    block_base_command_buffer, use_graph_attention,
                ) else { return 1; };
                let block_command_buffer: metal::CommandBuffer = block_command_context.metal();
                if !encode_mps_mlp_runtime_block(
                    block_command_buffer, pipelines, mps_workspace, block_weights,
                    active_workspace, current, next, active_rows, cache_mode,
                    cache_copy_pipeline, cache_key_arena, cache_value_arena, cache_offset,
                    text_rows,
                    use_graph_attention, #addr_of(graph_prefill_attention),
                    #addr_of(graph_cached_attention), graph_mask,
                ) { return 1; }
                block_command_buffer.commit();
                weight_ring.committed(global_block, block_command_buffer);
            } else if batch_transformer_block {
                if !encode_mps_mlp_runtime_block(
                    transformer_command_buffer, pipelines, mps_workspace, block_weights,
                    active_workspace, current, next, active_rows, cache_mode,
                    cache_copy_pipeline, cache_key_arena, cache_value_arena, cache_offset,
                    text_rows,
                    use_graph_attention, #addr_of(graph_prefill_attention),
                    #addr_of(graph_cached_attention), graph_mask,
                ) { return 1; }
            } else {
                let block_result: option::Option[f64] = execute_mps_mlp_runtime_block(
                    queue, pipelines, mps_workspace, block_weights, active_workspace,
                    current, next, active_rows, cache_mode, cache_copy_pipeline,
                    cache_key_arena, cache_value_arena, cache_offset, text_rows,
                    use_graph_attention, #addr_of(graph_prefill_attention),
                    #addr_of(graph_cached_attention), graph_mask,
                    profile_cached_block
                        && step == (1 as usize)
                        && (block == (0 as usize) || block == (1 as usize)
                            || block == (31 as usize)),
                    block_metadata_wall_ms,
                    block,
                );
                guard let option::Option[f64]::Some(block_ms) = block_result else { return 1; };
                step_ms = step_ms + block_ms;
                if validate_trajectory_blocks
                    && !finite(
                        "trajectory step ${step +% (1 as usize)} block ${block}",
                    next,
                    active_rows *% WIDTH,
                ) {
                    return 1;
                }
            }
            let swap: metal::Buffer = current; current = next; next = swap;
            if cache_dit_enabled && block == (0 as usize) {
                params.rows = target_rows as u32;
                params.width = WIDTH as u32;
                params.slot = if step == (0 as usize) { text_rows as u32 } else { 0 as u32 };
                guard let option::Option[f64]::Some(first_residual_ms) = dispatch_1d(
                    queue,
                    cache_first_residual_pipeline,
                    first_block_input,
                    current,
                    cache_first_output,
                    current_fn_residual,
                    dummy,
                    dummy,
                    #addr_of(params),
                    target_rows *% WIDTH,
                ) else { return 1; };
                step_ms = step_ms + first_residual_ms;

                let continuous_cache_cap: usize = if taylorseer_enabled
                    && !(taylor_early_cap3 && step *% (2 as usize) < step_limit) {
                    4 as usize
                } else {
                    3 as usize
                };
                let forced_full: bool = step < cache_dit_warmup
                    || !have_cache_residual
                    || continuous_cached_steps >= continuous_cache_cap
                    || (taylor_full_final_step && step +% (1 as usize) == step_limit);
                if !forced_full {
                    guard let option::Option[CacheDiffResult]::Some(diff_result) = gpu_relative_l1(
                        queue,
                        cache_relative_l1_partials_pipeline,
                        cache_relative_l1_finish_pipeline,
                        previous_fn_residual,
                        current_fn_residual,
                        cache_diff_partials,
                        cache_diff_result,
                        target_rows *% WIDTH,
                    ) else { return 1; };
                    cache_dit_diff = diff_result.difference;
                    step_ms = step_ms + diff_result.gpu_ms;
                    if env::has_var("QI_VALIDATE_GPU_CACHE_DIFF") {
                        let host_difference: f64 = host_relative_l1(
                            previous_fn_residual.contents() as *f32,
                            current_fn_residual.contents() as *f32,
                            target_rows *% WIDTH,
                        );
                        io::println("trajectory cache diff validation: gpu=${cache_dit_diff} host=${host_difference} absolute_error=${(cache_dit_diff - host_difference).abs()}");
                    }
                }
                cache_dit_cached_step = !forced_full && cache_dit_should_cache_with_cap(
                    step,
                    have_cache_residual,
                    continuous_cached_steps,
                    cache_dit_diff,
                    cache_dit_threshold_value,
                    continuous_cache_cap,
                    cache_dit_warmup,
                );
                if cache_dit_cached_step {
                    params.slot = 0 as u32;
                    var apply_ms: f64 = 0.0f64;
                    if taylorseer_enabled && have_taylor_derivative {
                        params.epsilon = if taylor_sigma_spacing {
                            taylor_sigma_elapsed(sigmas[last_full_step], sigmas[step])
                        } else { (step -% last_full_step) as f32 };
                        guard let option::Option[f64]::Some(taylor_apply_ms) = dispatch_1d(
                            queue,
                            taylor_apply_residual_pipeline,
                            current,
                            cache_middle_residual,
                            cache_middle_derivative,
                            next,
                            dummy,
                            dummy,
                            #addr_of(params),
                            target_rows *% WIDTH,
                        ) else { return 1; };
                        apply_ms = taylor_apply_ms;
                    } else {
                        guard let option::Option[f64]::Some(cache_apply_ms) = dispatch_1d(
                            queue,
                            cache_apply_residual_pipeline,
                            current,
                            cache_middle_residual,
                            next,
                            dummy,
                            dummy,
                            dummy,
                            #addr_of(params),
                            target_rows *% WIDTH,
                        ) else { return 1; };
                        apply_ms = cache_apply_ms;
                    }
                    step_ms = step_ms + apply_ms;
                    current = next;
                    continuous_cached_steps = continuous_cached_steps +% (1 as usize);
                    total_cached_steps = total_cached_steps +% (1 as usize);
                    break;
                }

                let fn_swap: metal::Buffer = previous_fn_residual;
                previous_fn_residual = current_fn_residual;
                current_fn_residual = fn_swap;
                continuous_cached_steps = 0 as usize;
            }
            block = block +% (1 as usize);
        }
        let batch_cache_dit_tail: bool = cache_dit_enabled
            && !profile_cached_block
            && !cache_dit_cached_step;
        if batch_transformer_step || batch_cache_dit_tail {
            transformer_command_buffer.commit();
            transformer_command_buffer.wait_until_completed();
            step_ms = step_ms +
                (transformer_command_buffer.g_p_u_end_time()
                    - transformer_command_buffer.g_p_u_start_time()) * 1000.0f64;
        }
        if use_weight_ring {
            weight_ring.retire_all();
            step_ms = step_ms + weight_ring.take_gpu_ms();
        }
        let ring_acquire_wait_ms: i64 = weight_ring.take_acquire_wait_ms();
        let ring_retire_wait_ms: i64 = weight_ring.take_retire_wait_ms();
        let expected_step_quantized: usize = if cache_dit_cached_step {
            0 as usize
        } else {
            weight_file.quantized_matrix_count()
        };
        if step_quantized_matrices != expected_step_quantized {
            io::eprintln("trajectory: expected ${expected_step_quantized} Q8 matrices at step ${step +% (1 as usize)}, found ${step_quantized_matrices}");
            return 1;
        }
        total_quantized_matrices = total_quantized_matrices +% step_quantized_matrices;

        if cache_dit_enabled && !cache_dit_cached_step {
            params.rows = target_rows as u32;
            params.width = WIDTH as u32;
            params.slot = if step == (0 as usize) { text_rows as u32 } else { 0 as u32 };
            var store_ms: f64 = 0.0f64;
            if taylorseer_enabled && have_cache_residual {
                let full_step_window: usize = step -% last_full_step;
                params.epsilon = if taylor_sigma_spacing {
                    1.0f32 / taylor_sigma_elapsed(sigmas[last_full_step], sigmas[step])
                } else { 1.0f32 / full_step_window as f32 };
                guard let option::Option[f64]::Some(taylor_store_ms) = dispatch_1d(
                    queue,
                    taylor_store_residual_pipeline,
                    current,
                    cache_first_output,
                    cache_middle_residual,
                    cache_middle_derivative,
                    dummy,
                    dummy,
                    #addr_of(params),
                    target_rows *% WIDTH,
                ) else { return 1; };
                store_ms = taylor_store_ms;
                have_taylor_derivative = true;
            } else {
                guard let option::Option[f64]::Some(cache_store_ms) = dispatch_1d(
                    queue,
                    cache_store_residual_pipeline,
                    current,
                    cache_first_output,
                    cache_middle_residual,
                    dummy,
                    dummy,
                    dummy,
                    #addr_of(params),
                    target_rows *% WIDTH,
                ) else { return 1; };
                store_ms = cache_store_ms;
            }
            step_ms = step_ms + store_ms;
            have_cache_residual = true;
            last_full_step = step;
        }

        params.epsilon = 0.000001f32;
        params.rows = active_rows as u32; params.width = WIDTH as u32;
        guard let option::Option[f64]::Some(final_norm_ms) = dispatch_1d(queue, final_norm_pipeline, current, final_scale, final_normalized, active_workspace.target_mask, dummy, dummy, #addr_of(params), active_rows) else { return 1; }; step_ms = step_ms + final_norm_ms;
        guard let option::Option[f64]::Some(output_ms) = dispatch_weighted_linear(queue, pipelines, final_normalized, proj_out_weight, noise_output, IMAGE_CHANNELS, WIDTH, active_rows) else { return 1; }; step_ms = step_ms + output_ms;
        if !finite("trajectory noise step ${step +% (1 as usize)}", noise_output, active_rows *% IMAGE_CHANNELS) { return 1; }
        let noise_offset: usize = if step == (0 as usize) { text_rows *% IMAGE_CHANNELS } else { 0 as usize };
        flow::euler_step_bf16(
            latents.contents() as *f32,
            (noise_output.contents() as *f32) + noise_offset,
            latents.contents() as *f32,
            latent_count,
            sigmas[step],
            sigmas[step +% (1 as usize)],
        );
        total_ms = total_ms + step_ms;
        let step_wall_ms: i64 = time::now_millis() - step_wall_start_ms;
        let completed_step: usize = step +% (1 as usize);
        let cache_mode_name: str = if cache_dit_cached_step {
            if taylorseer_enabled && have_taylor_derivative {
                "taylor"
            } else {
                "dbcache"
            }
        } else if step == (0 as usize) {
            "extract"
        } else if cache_dit_enabled {
            "full"
        } else {
            "prefix"
        };
        if validate_reference && (
            completed_step == (1 as usize) || completed_step == (2 as usize)
                || completed_step == (40 as usize)
        ) {
            let checkpoint_name: text::Text = if completed_step < (10 as usize) { "latent_step_0${completed_step}" } else { "latent_step_${completed_step}" };
            guard let option::Option[f64]::Some(error) = normalized_rms_fixture(latents, fixture_directory, checkpoint_name.view(), latent_count) else { return 1; };
            let error_limit: f64 = if completed_step == (1 as usize) {
                0.001f64
            } else if completed_step == (2 as usize) {
                0.0015f64
            } else if native_inputs {
                // The native Qwen3-VL path is independently bounded at 4%
                // against the Torch text fixture. Its small prompt-embedding
                // drift accumulates through 40 denoising steps, so preserve
                // the stricter 1.1% fixture-fed gate and give this integrated
                // boundary its own measured 2% budget.
                0.02f64
            } else {
                0.011f64
            };
            if cache_dit_enabled && completed_step == (40 as usize) {
                io::println("trajectory step ${completed_step}: mode=${cache_mode_name} timestep=${timesteps[step]} sigma=${sigmas[step]} gpu_ms=${step_ms} gpu_timing_fragmented=${use_graph_attention} wall_ms=${step_wall_ms} ring_acquire_wait_ms=${ring_acquire_wait_ms} ring_retire_wait_ms=${ring_retire_wait_ms} cache_diff=${cache_dit_diff} cache_steps=${total_cached_steps} latent_nRMSE=${error} validation=measured-only");
                all_ok = finite("trajectory latent step ${completed_step}", latents, latent_count) && all_ok;
            } else {
                io::println("trajectory step ${completed_step}: mode=${cache_mode_name} timestep=${timesteps[step]} sigma=${sigmas[step]} gpu_ms=${step_ms} gpu_timing_fragmented=${use_graph_attention} wall_ms=${step_wall_ms} ring_acquire_wait_ms=${ring_acquire_wait_ms} ring_retire_wait_ms=${ring_retire_wait_ms} latent_nRMSE=${error} limit=${error_limit}");
                all_ok = error <= error_limit && finite("trajectory latent step ${completed_step}", latents, latent_count) && all_ok;
            }
        } else {
            if cache_dit_enabled {
                io::println("trajectory step ${completed_step}: mode=${cache_mode_name} timestep=${timesteps[step]} sigma=${sigmas[step]} gpu_ms=${step_ms} gpu_timing_fragmented=${use_graph_attention} wall_ms=${step_wall_ms} ring_acquire_wait_ms=${ring_acquire_wait_ms} ring_retire_wait_ms=${ring_retire_wait_ms} cache_diff=${cache_dit_diff} cache_steps=${total_cached_steps}");
            } else {
                io::println("trajectory step ${completed_step}: mode=${cache_mode_name} timestep=${timesteps[step]} sigma=${sigmas[step]} gpu_ms=${step_ms} gpu_timing_fragmented=${use_graph_attention} wall_ms=${step_wall_ms} ring_acquire_wait_ms=${ring_acquire_wait_ms} ring_retire_wait_ms=${ring_retire_wait_ms}");
            }
            all_ok = finite("trajectory latent step ${completed_step}", latents, latent_count) && all_ok;
        }
        step = step +% (1 as usize);
    }
    if !final_latent.is_null() {
        let latent_values: *f32 = latents.contents() as *f32;
        var latent_index: usize = 0 as usize;
        while latent_index < latent_count {
            final_latent[latent_index] = latent_values[latent_index];
            latent_index = latent_index +% (1 as usize);
        }
    }
    let trajectory_wall_ms: i64 = time::now_millis() - trajectory_wall_start_ms;
    io::println("trajectory: output=${output_width}x${output_height} tokens=${target_rows} steps=${step_limit} q8_dispatch_matrices=${total_quantized_matrices} prefix_cache_bytes=${(2 as u64) *% cache_arena_bytes} cache_dit=${cache_dit_enabled} taylorseer=${taylorseer_enabled} bottleneck_shift=${bottleneck_shift} bottleneck_strength=${bottleneck_strength} cache_dit_threshold=${cache_dit_threshold_value} cache_dit_steps=${total_cached_steps} shift_terminal=${shift_terminal_name} profile_skip=${profile_skip} total_gpu_ms=${total_ms} gpu_timing_fragmented=${use_graph_attention} total_wall_ms=${trajectory_wall_ms}");
    if all_ok {
        if taylorseer_enabled {
            io::println("Qwen-Image-2.1 TaylorSeer trajectory: complete; quality requires measured acceptance");
        } else if cache_dit_enabled {
            io::println("Qwen-Image-2.1 Cache-DiT trajectory: complete; quality requires measured acceptance");
        } else if validate_reference {
            io::println("Qwen-Image-2.1 latent trajectory prefix: verified");
        } else {
            io::println("Qwen-Image-2.1 native-prompt latent trajectory: complete");
        }
        return 0;
    }
    return 1;
}

fn test_attention_cache(
    fixture_directory: str = "tests/fixtures/attention_cache_fp32",
) -> i32 {
    let cache_rows: usize = 7 as usize;
    let prefix_rows: usize = 5 as usize;
    let target_rows: usize = 2 as usize;
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return 1; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    let device_pointer: *u8 = MTLCreateSystemDefaultDevice();
    if device_pointer.is_null() { io::eprintln("attention cache: no Metal device"); return 1; }
    let device_owner: OwnedObjc = OwnedObjc::new(rt::retain(device_pointer));
    let device: metal::Device = metal::Device::from_raw(device_owner.raw());
    guard let option::Option[metal::CommandQueue]::Some(queue) = device.new_command_queue() else { return 1; };
    let queue_owner: OwnedObjc = OwnedObjc::new(queue.raw());
    let options_pointer: *u8 = rt::alloc_init(#str_ptr("MTLCompileOptions\0"));
    if options_pointer.is_null() { return 1; }
    let options_owner: OwnedObjc = OwnedObjc::new(options_pointer);
    let options: metal::CompileOptions = metal::CompileOptions::from_raw(options_owner.raw());
    options.set_fast_math_enabled(false);
    var compile_error: *u8 = 0 as *u8;
    guard let option::Option[metal::Library]::Some(library) = device.new_library_with_source(
        #include_str("../kernels/transformer_block.metal"), options, #addr_of(compile_error) as *u8,
    ) else {
        if !compile_error.is_null() {
            let description: *u8 = rt::msg_id(compile_error, rt::sel(#str_ptr("localizedDescription\0")));
            io::eprintln("attention cache Metal compile: ${bridge::to_text(description)}");
        }
        return 1;
    };
    let library_owner: OwnedObjc = OwnedObjc::new(library.raw());
    guard let option::Option[OwnedObjc]::Some(attention_owner) = pipeline(device, library, "qi_block_attention") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(copy_owner) = pipeline(device, library, "qi_copy_prefix_kv") else { return 1; };
    let attention_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(attention_owner.raw());
    let copy_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(copy_owner.raw());
    let full_bytes: u64 = (cache_rows *% WIDTH *% #size_of::[f32]()) as u64;
    let prefix_bytes: u64 = (prefix_rows *% WIDTH *% #size_of::[f32]()) as u64;
    let target_bytes: u64 = (target_rows *% WIDTH *% #size_of::[f32]()) as u64;
    guard let option::Option[metal::Buffer]::Some(query) = fixture_buffer(device, fixture_directory, "query", full_bytes) else { return 1; }; let query_owner: OwnedObjc = OwnedObjc::new(query.raw());
    guard let option::Option[metal::Buffer]::Some(key) = fixture_buffer(device, fixture_directory, "key", full_bytes) else { return 1; }; let key_owner: OwnedObjc = OwnedObjc::new(key.raw());
    guard let option::Option[metal::Buffer]::Some(value) = fixture_buffer(device, fixture_directory, "value", full_bytes) else { return 1; }; let value_owner: OwnedObjc = OwnedObjc::new(value.raw());
    guard let option::Option[metal::Buffer]::Some(output) = new_buffer(device, full_bytes) else { return 1; }; let output_owner: OwnedObjc = OwnedObjc::new(output.raw());
    guard let option::Option[metal::Buffer]::Some(image_ids) = new_buffer(device, (cache_rows *% #size_of::[i32]()) as u64) else { return 1; }; let image_ids_owner: OwnedObjc = OwnedObjc::new(image_ids.raw());
    let ids: *i32 = image_ids.contents() as *i32;
    ids[0] = 0; ids[1] = 0; ids[2] = 1; ids[3] = 1; ids[4] = 0 -% (1 as i32); ids[5] = 2; ids[6] = 2;
    guard let option::Option[metal::Buffer]::Some(key_valid) = new_buffer(device, cache_rows as u64) else { return 1; }; let key_valid_owner: OwnedObjc = OwnedObjc::new(key_valid.raw());
    var row: usize = 0 as usize;
    while row < cache_rows { (key_valid.contents())[row] = if row == (4 as usize) { 0 as u8 } else { 1 as u8 }; row = row +% (1 as usize); }
    guard let option::Option[f64]::Some(prefill_ms) = dispatch_attention(
        queue, attention_pipeline, query, key, output, value, image_ids, key_valid,
        cache_rows, cache_rows, key, value, 0 as u64,
    ) else { return 1; };
    var all_ok: bool = compare_fixture("tiled block-causal prefill", output, fixture_directory, "output", cache_rows *% WIDTH, 0.00001f64, 0.00001f64);

    guard let option::Option[metal::Buffer]::Some(cache_key) = new_buffer(device, prefix_bytes) else { return 1; }; let cache_key_owner: OwnedObjc = OwnedObjc::new(cache_key.raw());
    guard let option::Option[metal::Buffer]::Some(cache_value) = new_buffer(device, prefix_bytes) else { return 1; }; let cache_value_owner: OwnedObjc = OwnedObjc::new(cache_value.raw());
    guard let option::Option[metal::Buffer]::Some(dummy) = new_buffer(device, 4 as u64) else { return 1; }; let dummy_owner: OwnedObjc = OwnedObjc::new(dummy.raw());
    guard let option::Option[f64]::Some(copy_ms) = dispatch_copy_prefix(
        queue, copy_pipeline, key, value, cache_key, cache_value,
        0 as u64, prefix_rows, dummy,
    ) else { return 1; };
    all_ok = compare_fixture("cached post-RoPE prefix K", cache_key, fixture_directory, "prefix_key", prefix_rows *% WIDTH, 0.0f64, 0.0f64) && all_ok;
    all_ok = compare_fixture("cached raw prefix V", cache_value, fixture_directory, "prefix_value", prefix_rows *% WIDTH, 0.0f64, 0.0f64) && all_ok;

    guard let option::Option[metal::Buffer]::Some(target_query) = fixture_buffer(device, fixture_directory, "target_query", target_bytes) else { return 1; }; let target_query_owner: OwnedObjc = OwnedObjc::new(target_query.raw());
    guard let option::Option[metal::Buffer]::Some(target_key) = fixture_buffer(device, fixture_directory, "target_key", target_bytes) else { return 1; }; let target_key_owner: OwnedObjc = OwnedObjc::new(target_key.raw());
    guard let option::Option[metal::Buffer]::Some(target_value) = fixture_buffer(device, fixture_directory, "target_value", target_bytes) else { return 1; }; let target_value_owner: OwnedObjc = OwnedObjc::new(target_value.raw());
    guard let option::Option[metal::Buffer]::Some(target_output) = new_buffer(device, target_bytes) else { return 1; }; let target_output_owner: OwnedObjc = OwnedObjc::new(target_output.raw());
    guard let option::Option[f64]::Some(cached_ms) = dispatch_attention(
        queue, attention_pipeline, target_query, target_key, target_output, target_value,
        image_ids, key_valid, target_rows, cache_rows, cache_key, cache_value, 0 as u64,
        prefix_rows, true, prefix_rows,
    ) else { return 1; };
    all_ok = compare_fixture("cached target decode", target_output, fixture_directory, "target_output", target_rows *% WIDTH, 0.00001f64, 0.00001f64) && all_ok;
    io::println("attention cache: prefill_gpu_ms=${prefill_ms} cache_copy_gpu_ms=${copy_ms} cached_gpu_ms=${cached_ms} cache_bytes=${(2 as u64) *% prefix_bytes}");
    if all_ok { io::println("tiled prefill and prefix KV cached decode: verified"); return 0; }
    return 1;
}

fn benchmark_production_gemm_case(
    queue: metal::CommandQueue,
    dense_pipeline: metal::ComputePipelineState,
    int8_pipeline: metal::ComputePipelineState,
    int8_simdgroup_pipeline: metal::ComputePipelineState,
    int8_simdgroup_direct_pipeline: metal::ComputePipelineState,
    int8_simdgroup_64x64_pipeline: metal::ComputePipelineState,
    int8_simdgroup_128_pipeline: metal::ComputePipelineState,
    simdgroup_pipeline: metal::ComputePipelineState,
    simdgroup_half_pipeline: metal::ComputePipelineState,
    simdgroup_half_64_pipeline: metal::ComputePipelineState,
    simdgroup_half_direct_pipeline: metal::ComputePipelineState,
    simdgroup_half_64x64_pipeline: metal::ComputePipelineState,
    simdgroup_half_128_pipeline: metal::ComputePipelineState,
    simdgroup_bfloat_pipeline: metal::ComputePipelineState,
    file: packed::File,
    storage: metal::Buffer,
    input: metal::Buffer,
    output: metal::Buffer,
    reference: metal::Buffer,
    tensor_name: str,
    rows: usize,
    output_columns: usize,
    input_columns: usize,
    expected_scheme: u32,
) -> bool {
    guard let option::Option[LinearWeight]::Some(weight) = packed_linear_weight(
        file, storage, tensor_name, output_columns as u64, input_columns as u64,
    ) else { return false; };
    if weight.scheme != expected_scheme {
        io::eprintln("production GEMM benchmark: unexpected scheme for ${tensor_name}");
        return false;
    }
    let warmup: option::Option[f64] = if weight.scheme == PACKED_SCHEME_INT8_AFFINE {
        dispatch_int8_linear(
            queue, int8_pipeline, input, weight, reference,
            output_columns, input_columns, rows,
        )
    } else {
        dispatch_linear(
            queue, dense_pipeline, input, weight.storage, reference,
            output_columns, input_columns, rows, weight.weights_offset,
        )
    };
    guard let option::Option[f64]::Some(_warmup_ms) = warmup else { return false; };

    let iterations: usize = 3 as usize;
    var total_ms: f64 = 0.0f64;
    var iteration: usize = 0 as usize;
    while iteration < iterations {
        let measured: option::Option[f64] = if weight.scheme == PACKED_SCHEME_INT8_AFFINE {
            dispatch_int8_linear(
                queue, int8_pipeline, input, weight, reference,
                output_columns, input_columns, rows,
            )
        } else {
            dispatch_linear(
                queue, dense_pipeline, input, weight.storage, reference,
                output_columns, input_columns, rows, weight.weights_offset,
            )
        };
        guard let option::Option[f64]::Some(elapsed_ms) = measured else { return false; };
        total_ms = total_ms + elapsed_ms;
        iteration = iteration +% (1 as usize);
    }
    if !finite("production GEMM ${tensor_name}", reference, rows *% output_columns) {
        return false;
    }
    let average_ms: f64 = total_ms / iterations as f64;
    let operations: f64 = 2.0f64 * rows as f64
        * output_columns as f64 * input_columns as f64;
    let throughput_tflops: f64 = operations / (average_ms * 1000000000.0f64);
    let scheme_name: str = if weight.scheme == PACKED_SCHEME_INT8_AFFINE { "q8" } else { "bf16" };
    io::println(
        "production GEMM: kernel=scalar scheme=${scheme_name} rows=${rows} output=${output_columns} input=${input_columns} gpu_ms=${average_ms} tflops=${throughput_tflops} tensor=${tensor_name}",
    );
    if weight.scheme == PACKED_SCHEME_INT8_AFFINE {
        guard let option::Option[f64]::Some(_q8_simdgroup_warmup_ms) =
            dispatch_simdgroup_int8_linear(
                queue, int8_simdgroup_pipeline, input, weight, output,
            output_columns, input_columns, rows,
        ) else { return false; };
        var q8_simdgroup_total_ms: f64 = 0.0f64;
        iteration = 0 as usize;
        while iteration < iterations {
            guard let option::Option[f64]::Some(elapsed_ms) =
                dispatch_simdgroup_int8_linear(
                    queue, int8_simdgroup_pipeline, input, weight, output,
                output_columns, input_columns, rows,
            ) else { return false; };
            q8_simdgroup_total_ms = q8_simdgroup_total_ms + elapsed_ms;
            iteration = iteration +% (1 as usize);
        }
        if !finite("production Q8 SIMD-group GEMM ${tensor_name}", output, rows *% output_columns) {
            return false;
        }
        let q8_simdgroup_average_ms: f64 = q8_simdgroup_total_ms / iterations as f64;
        let q8_simdgroup_tflops: f64 = operations / (q8_simdgroup_average_ms * 1000000000.0f64);
        let q8_simdgroup_error: f64 = normalized_rms_buffers(
            output, 0 as usize, reference, 0 as usize, rows *% output_columns,
        );
        let q8_simdgroup_speedup: f64 = average_ms / q8_simdgroup_average_ms;
        io::println(
            "production GEMM: kernel=simdgroup-half-64x32 scheme=q8 rows=${rows} output=${output_columns} input=${input_columns} gpu_ms=${q8_simdgroup_average_ms} tflops=${q8_simdgroup_tflops} speedup=${q8_simdgroup_speedup} nRMSE=${q8_simdgroup_error} tensor=${tensor_name}",
        );
        if rows == (256 as usize) {
            guard let option::Option[f64]::Some(_direct_warmup_ms) =
                dispatch_simdgroup_int8_linear(
                    queue, int8_simdgroup_direct_pipeline, input, weight, output,
                output_columns, input_columns, rows, 64 as usize, 256 as usize,
            ) else { return false; };
            var direct_total_ms: f64 = 0.0f64;
            iteration = 0 as usize;
            while iteration < iterations {
                guard let option::Option[f64]::Some(elapsed_ms) =
                    dispatch_simdgroup_int8_linear(
                        queue, int8_simdgroup_direct_pipeline, input, weight, output,
                    output_columns, input_columns, rows, 64 as usize, 256 as usize,
                ) else { return false; };
                direct_total_ms = direct_total_ms + elapsed_ms;
                iteration = iteration +% (1 as usize);
            }
            let direct_average_ms: f64 = direct_total_ms / iterations as f64;
            let direct_error: f64 = normalized_rms_buffers(
                output, 0 as usize, reference, 0 as usize, rows *% output_columns,
            );
            io::println(
                "production GEMM: kernel=simdgroup-half-64x32-direct scheme=q8 rows=${rows} output=${output_columns} input=${input_columns} gpu_ms=${direct_average_ms} tflops=${operations / (direct_average_ms * 1000000000.0f64)} speedup=${average_ms / direct_average_ms} nRMSE=${direct_error} tensor=${tensor_name}",
            );
            guard let option::Option[f64]::Some(_tile_64x64_warmup_ms) =
                dispatch_simdgroup_int8_linear(
                    queue, int8_simdgroup_64x64_pipeline, input, weight, output,
                output_columns, input_columns, rows, 64 as usize, 512 as usize, 64 as usize,
            ) else { return false; };
            var tile_64x64_total_ms: f64 = 0.0f64;
            iteration = 0 as usize;
            while iteration < iterations {
                guard let option::Option[f64]::Some(elapsed_ms) =
                    dispatch_simdgroup_int8_linear(
                        queue, int8_simdgroup_64x64_pipeline, input, weight, output,
                    output_columns, input_columns, rows,
                    64 as usize, 512 as usize, 64 as usize,
                ) else { return false; };
                tile_64x64_total_ms = tile_64x64_total_ms + elapsed_ms;
                iteration = iteration +% (1 as usize);
            }
            let tile_64x64_average_ms: f64 = tile_64x64_total_ms / iterations as f64;
            let tile_64x64_error: f64 = normalized_rms_buffers(
                output, 0 as usize, reference, 0 as usize, rows *% output_columns,
            );
            io::println(
                "production GEMM: kernel=simdgroup-half-64x64-direct scheme=q8 rows=${rows} output=${output_columns} input=${input_columns} gpu_ms=${tile_64x64_average_ms} tflops=${operations / (tile_64x64_average_ms * 1000000000.0f64)} speedup=${average_ms / tile_64x64_average_ms} nRMSE=${tile_64x64_error} tensor=${tensor_name}",
            );
        }
        guard let option::Option[f64]::Some(_q8_simdgroup_128_warmup_ms) =
            dispatch_simdgroup_int8_linear(
                queue, int8_simdgroup_128_pipeline, input, weight, output,
            output_columns, input_columns, rows, 128 as usize,
        ) else { return false; };
        var q8_simdgroup_128_total_ms: f64 = 0.0f64;
        iteration = 0 as usize;
        while iteration < iterations {
            guard let option::Option[f64]::Some(elapsed_ms) =
                dispatch_simdgroup_int8_linear(
                    queue, int8_simdgroup_128_pipeline, input, weight, output,
                output_columns, input_columns, rows, 128 as usize,
            ) else { return false; };
            q8_simdgroup_128_total_ms = q8_simdgroup_128_total_ms + elapsed_ms;
            iteration = iteration +% (1 as usize);
        }
        let q8_simdgroup_128_average_ms: f64 = q8_simdgroup_128_total_ms / iterations as f64;
        let q8_simdgroup_128_tflops: f64 =
            operations / (q8_simdgroup_128_average_ms * 1000000000.0f64);
        let q8_simdgroup_128_error: f64 = normalized_rms_buffers(
            output, 0 as usize, reference, 0 as usize, rows *% output_columns,
        );
        io::println(
            "production GEMM: kernel=simdgroup-half-128x32 scheme=q8 rows=${rows} output=${output_columns} input=${input_columns} gpu_ms=${q8_simdgroup_128_average_ms} tflops=${q8_simdgroup_128_tflops} speedup=${average_ms / q8_simdgroup_128_average_ms} nRMSE=${q8_simdgroup_128_error} tensor=${tensor_name}",
        );
    }
    if weight.scheme == PACKED_SCHEME_BF16 {
        guard let option::Option[f64]::Some(_simdgroup_warmup_ms) = dispatch_simdgroup_linear(
            queue, simdgroup_pipeline, input, weight.storage, output,
            output_columns, input_columns, rows, weight.weights_offset,
        ) else { return false; };
        var simdgroup_total_ms: f64 = 0.0f64;
        iteration = 0 as usize;
        while iteration < iterations {
            guard let option::Option[f64]::Some(elapsed_ms) = dispatch_simdgroup_linear(
                queue, simdgroup_pipeline, input, weight.storage, output,
                output_columns, input_columns, rows, weight.weights_offset,
            ) else { return false; };
            simdgroup_total_ms = simdgroup_total_ms + elapsed_ms;
            iteration = iteration +% (1 as usize);
        }
        if !finite("production SIMD-group GEMM ${tensor_name}", output, rows *% output_columns) {
            return false;
        }
        let simdgroup_average_ms: f64 = simdgroup_total_ms / iterations as f64;
        let simdgroup_tflops: f64 = operations / (simdgroup_average_ms * 1000000000.0f64);
        let error: f64 = normalized_rms_buffers(
            output, 0 as usize, reference, 0 as usize, rows *% output_columns,
        );
        let speedup: f64 = average_ms / simdgroup_average_ms;
        io::println(
            "production GEMM: kernel=simdgroup scheme=bf16 rows=${rows} output=${output_columns} input=${input_columns} gpu_ms=${simdgroup_average_ms} tflops=${simdgroup_tflops} speedup=${speedup} nRMSE=${error} tensor=${tensor_name}",
        );
        if error > (0.0001f64) { return false; }

        guard let option::Option[f64]::Some(_half_warmup_ms) = dispatch_simdgroup_linear(
            queue, simdgroup_half_pipeline, input, weight.storage, output,
            output_columns, input_columns, rows, weight.weights_offset,
        ) else { return false; };
        var half_total_ms: f64 = 0.0f64;
        iteration = 0 as usize;
        while iteration < iterations {
            guard let option::Option[f64]::Some(elapsed_ms) = dispatch_simdgroup_linear(
                queue, simdgroup_half_pipeline, input, weight.storage, output,
                output_columns, input_columns, rows, weight.weights_offset,
            ) else { return false; };
            half_total_ms = half_total_ms + elapsed_ms;
            iteration = iteration +% (1 as usize);
        }
        if !finite("production half SIMD-group GEMM ${tensor_name}", output, rows *% output_columns) {
            return false;
        }
        let half_average_ms: f64 = half_total_ms / iterations as f64;
        let half_tflops: f64 = operations / (half_average_ms * 1000000000.0f64);
        let half_error: f64 = normalized_rms_buffers(
            output, 0 as usize, reference, 0 as usize, rows *% output_columns,
        );
        let half_speedup: f64 = average_ms / half_average_ms;
        io::println(
            "production GEMM: kernel=simdgroup-half scheme=bf16 rows=${rows} output=${output_columns} input=${input_columns} gpu_ms=${half_average_ms} tflops=${half_tflops} speedup=${half_speedup} nRMSE=${half_error} tensor=${tensor_name}",
        );

        guard let option::Option[f64]::Some(_half_64_warmup_ms) = dispatch_simdgroup_linear(
            queue, simdgroup_half_64_pipeline, input, weight.storage, output,
            output_columns, input_columns, rows, weight.weights_offset, 64 as usize,
        ) else { return false; };
        var half_64_total_ms: f64 = 0.0f64;
        iteration = 0 as usize;
        while iteration < iterations {
            guard let option::Option[f64]::Some(elapsed_ms) = dispatch_simdgroup_linear(
                queue, simdgroup_half_64_pipeline, input, weight.storage, output,
                output_columns, input_columns, rows, weight.weights_offset, 64 as usize,
            ) else { return false; };
            half_64_total_ms = half_64_total_ms + elapsed_ms;
            iteration = iteration +% (1 as usize);
        }
        if !finite("production half 64x32 SIMD-group GEMM ${tensor_name}", output, rows *% output_columns) {
            return false;
        }
        let half_64_average_ms: f64 = half_64_total_ms / iterations as f64;
        let half_64_tflops: f64 = operations / (half_64_average_ms * 1000000000.0f64);
        let half_64_error: f64 = normalized_rms_buffers(
            output, 0 as usize, reference, 0 as usize, rows *% output_columns,
        );
        let half_64_speedup: f64 = average_ms / half_64_average_ms;
        io::println(
            "production GEMM: kernel=simdgroup-half-64x32 scheme=bf16 rows=${rows} output=${output_columns} input=${input_columns} gpu_ms=${half_64_average_ms} tflops=${half_64_tflops} speedup=${half_64_speedup} nRMSE=${half_64_error} tensor=${tensor_name}",
        );
        if rows == (256 as usize) {
            guard let option::Option[f64]::Some(_direct_warmup_ms) = dispatch_simdgroup_linear(
                queue, simdgroup_half_direct_pipeline, input, weight.storage, output,
                output_columns, input_columns, rows, weight.weights_offset,
                64 as usize, 256 as usize,
            ) else { return false; };
            var direct_total_ms: f64 = 0.0f64;
            iteration = 0 as usize;
            while iteration < iterations {
                guard let option::Option[f64]::Some(elapsed_ms) = dispatch_simdgroup_linear(
                    queue, simdgroup_half_direct_pipeline, input, weight.storage, output,
                    output_columns, input_columns, rows, weight.weights_offset,
                    64 as usize, 256 as usize,
                ) else { return false; };
                direct_total_ms = direct_total_ms + elapsed_ms;
                iteration = iteration +% (1 as usize);
            }
            let direct_average_ms: f64 = direct_total_ms / iterations as f64;
            let direct_error: f64 = normalized_rms_buffers(
                output, 0 as usize, reference, 0 as usize, rows *% output_columns,
            );
            io::println(
                "production GEMM: kernel=simdgroup-half-64x32-direct scheme=bf16 rows=${rows} output=${output_columns} input=${input_columns} gpu_ms=${direct_average_ms} tflops=${operations / (direct_average_ms * 1000000000.0f64)} speedup=${average_ms / direct_average_ms} nRMSE=${direct_error} tensor=${tensor_name}",
            );
            guard let option::Option[f64]::Some(_tile_64x64_warmup_ms) =
                dispatch_simdgroup_linear(
                    queue, simdgroup_half_64x64_pipeline, input, weight.storage, output,
                output_columns, input_columns, rows, weight.weights_offset,
                64 as usize, 512 as usize, 64 as usize,
            ) else { return false; };
            var tile_64x64_total_ms: f64 = 0.0f64;
            iteration = 0 as usize;
            while iteration < iterations {
                guard let option::Option[f64]::Some(elapsed_ms) = dispatch_simdgroup_linear(
                    queue, simdgroup_half_64x64_pipeline, input, weight.storage, output,
                    output_columns, input_columns, rows, weight.weights_offset,
                    64 as usize, 512 as usize, 64 as usize,
                ) else { return false; };
                tile_64x64_total_ms = tile_64x64_total_ms + elapsed_ms;
                iteration = iteration +% (1 as usize);
            }
            let tile_64x64_average_ms: f64 = tile_64x64_total_ms / iterations as f64;
            let tile_64x64_error: f64 = normalized_rms_buffers(
                output, 0 as usize, reference, 0 as usize, rows *% output_columns,
            );
            io::println(
                "production GEMM: kernel=simdgroup-half-64x64-direct scheme=bf16 rows=${rows} output=${output_columns} input=${input_columns} gpu_ms=${tile_64x64_average_ms} tflops=${operations / (tile_64x64_average_ms * 1000000000.0f64)} speedup=${average_ms / tile_64x64_average_ms} nRMSE=${tile_64x64_error} tensor=${tensor_name}",
            );
        }

        guard let option::Option[f64]::Some(_half_128_warmup_ms) = dispatch_simdgroup_linear(
            queue, simdgroup_half_128_pipeline, input, weight.storage, output,
            output_columns, input_columns, rows, weight.weights_offset, 128 as usize,
        ) else { return false; };
        var half_128_total_ms: f64 = 0.0f64;
        iteration = 0 as usize;
        while iteration < iterations {
            guard let option::Option[f64]::Some(elapsed_ms) = dispatch_simdgroup_linear(
                queue, simdgroup_half_128_pipeline, input, weight.storage, output,
                output_columns, input_columns, rows, weight.weights_offset, 128 as usize,
            ) else { return false; };
            half_128_total_ms = half_128_total_ms + elapsed_ms;
            iteration = iteration +% (1 as usize);
        }
        let half_128_average_ms: f64 = half_128_total_ms / iterations as f64;
        let half_128_tflops: f64 = operations / (half_128_average_ms * 1000000000.0f64);
        let half_128_error: f64 = normalized_rms_buffers(
            output, 0 as usize, reference, 0 as usize, rows *% output_columns,
        );
        io::println(
            "production GEMM: kernel=simdgroup-half-128x32 scheme=bf16 rows=${rows} output=${output_columns} input=${input_columns} gpu_ms=${half_128_average_ms} tflops=${half_128_tflops} speedup=${average_ms / half_128_average_ms} nRMSE=${half_128_error} tensor=${tensor_name}",
        );

        guard let option::Option[f64]::Some(_bfloat_warmup_ms) = dispatch_simdgroup_linear(
            queue, simdgroup_bfloat_pipeline, input, weight.storage, output,
            output_columns, input_columns, rows, weight.weights_offset,
        ) else { return false; };
        var bfloat_total_ms: f64 = 0.0f64;
        iteration = 0 as usize;
        while iteration < iterations {
            guard let option::Option[f64]::Some(elapsed_ms) = dispatch_simdgroup_linear(
                queue, simdgroup_bfloat_pipeline, input, weight.storage, output,
                output_columns, input_columns, rows, weight.weights_offset,
            ) else { return false; };
            bfloat_total_ms = bfloat_total_ms + elapsed_ms;
            iteration = iteration +% (1 as usize);
        }
        if !finite("production bfloat SIMD-group GEMM ${tensor_name}", output, rows *% output_columns) {
            return false;
        }
        let bfloat_average_ms: f64 = bfloat_total_ms / iterations as f64;
        let bfloat_tflops: f64 = operations / (bfloat_average_ms * 1000000000.0f64);
        let bfloat_error: f64 = normalized_rms_buffers(
            output, 0 as usize, reference, 0 as usize, rows *% output_columns,
        );
        let bfloat_speedup: f64 = average_ms / bfloat_average_ms;
        io::println(
            "production GEMM: kernel=simdgroup-bfloat scheme=bf16 rows=${rows} output=${output_columns} input=${input_columns} gpu_ms=${bfloat_average_ms} tflops=${bfloat_tflops} speedup=${bfloat_speedup} nRMSE=${bfloat_error} tensor=${tensor_name}",
        );
    }
    return true;
}

fn benchmark_production_gemm(packed_path: str) -> i32 {
    let load_start_ms: i64 = time::now_millis();
    guard let packed::LoadResult::Ok(weight_file) = packed::load(packed_path) else {
        io::eprintln("production GEMM benchmark: could not load ${packed_path}");
        return 1;
    };
    let load_wall_ms: i64 = time::now_millis() - load_start_ms;
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return 1; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    let device_pointer: *u8 = MTLCreateSystemDefaultDevice();
    if device_pointer.is_null() { return 1; }
    let device_owner: OwnedObjc = OwnedObjc::new(rt::retain(device_pointer));
    let device: metal::Device = metal::Device::from_raw(device_owner.raw());
    guard let option::Option[metal::CommandQueue]::Some(queue) = device.new_command_queue() else { return 1; };
    let queue_owner: OwnedObjc = OwnedObjc::new(queue.raw());
    let options_pointer: *u8 = rt::alloc_init(#str_ptr("MTLCompileOptions\0"));
    if options_pointer.is_null() { return 1; }
    let options_owner: OwnedObjc = OwnedObjc::new(options_pointer);
    let options: metal::CompileOptions = metal::CompileOptions::from_raw(options_owner.raw());
    options.set_fast_math_enabled(false);
    var compile_error: *u8 = 0 as *u8;
    guard let option::Option[metal::Library]::Some(library) = device.new_library_with_source(
        #include_str("../kernels/transformer_block.metal"), options,
        #addr_of(compile_error) as *u8,
    ) else {
        if !compile_error.is_null() {
            let description: *u8 = rt::msg_id(
                compile_error, rt::sel(#str_ptr("localizedDescription\0")),
            );
            io::eprintln("production GEMM Metal compile: ${bridge::to_text(description)}");
        }
        return 1;
    };
    let library_owner: OwnedObjc = OwnedObjc::new(library.raw());
    guard let option::Option[OwnedObjc]::Some(dense_owner) =
        pipeline(device, library, "qi_block_linear_32x32") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(int8_owner) =
        pipeline(device, library, "qi_block_int8_affine_linear_32x32") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(int8_simdgroup_owner) =
        pipeline(device, library, "qi_block_int8_simdgroup_half_64x32") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(int8_simdgroup_direct_owner) =
        pipeline(device, library, "qi_block_int8_simdgroup_half_64x32_direct") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(int8_simdgroup_64x64_owner) =
        pipeline(device, library, "qi_block_int8_simdgroup_half_64x64_direct") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(int8_simdgroup_128_owner) =
        pipeline(device, library, "qi_block_int8_simdgroup_half_128x32") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(simdgroup_owner) =
        pipeline(device, library, "qi_block_linear_simdgroup_32x32") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(simdgroup_half_owner) =
        pipeline(device, library, "qi_block_linear_simdgroup_half_32x32") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(simdgroup_half_64_owner) =
        pipeline(device, library, "qi_block_linear_simdgroup_half_64x32") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(simdgroup_half_direct_owner) =
        pipeline(device, library, "qi_block_linear_simdgroup_half_64x32_direct") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(simdgroup_half_64x64_owner) =
        pipeline(device, library, "qi_block_linear_simdgroup_half_64x64_direct") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(simdgroup_half_128_owner) =
        pipeline(device, library, "qi_block_linear_simdgroup_half_128x32") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(simdgroup_bfloat_owner) =
        pipeline(device, library, "qi_block_linear_simdgroup_bfloat_32x32") else { return 1; };
    let dense_pipeline: metal::ComputePipelineState =
        metal::ComputePipelineState::from_raw(dense_owner.raw());
    let int8_pipeline: metal::ComputePipelineState =
        metal::ComputePipelineState::from_raw(int8_owner.raw());
    let int8_simdgroup_pipeline: metal::ComputePipelineState =
        metal::ComputePipelineState::from_raw(int8_simdgroup_owner.raw());
    let int8_simdgroup_direct_pipeline: metal::ComputePipelineState =
        metal::ComputePipelineState::from_raw(int8_simdgroup_direct_owner.raw());
    let int8_simdgroup_64x64_pipeline: metal::ComputePipelineState =
        metal::ComputePipelineState::from_raw(int8_simdgroup_64x64_owner.raw());
    let int8_simdgroup_128_pipeline: metal::ComputePipelineState =
        metal::ComputePipelineState::from_raw(int8_simdgroup_128_owner.raw());
    let simdgroup_pipeline: metal::ComputePipelineState =
        metal::ComputePipelineState::from_raw(simdgroup_owner.raw());
    let simdgroup_half_pipeline: metal::ComputePipelineState =
        metal::ComputePipelineState::from_raw(simdgroup_half_owner.raw());
    let simdgroup_half_64_pipeline: metal::ComputePipelineState =
        metal::ComputePipelineState::from_raw(simdgroup_half_64_owner.raw());
    let simdgroup_half_direct_pipeline: metal::ComputePipelineState =
        metal::ComputePipelineState::from_raw(simdgroup_half_direct_owner.raw());
    let simdgroup_half_64x64_pipeline: metal::ComputePipelineState =
        metal::ComputePipelineState::from_raw(simdgroup_half_64x64_owner.raw());
    let simdgroup_half_128_pipeline: metal::ComputePipelineState =
        metal::ComputePipelineState::from_raw(simdgroup_half_128_owner.raw());
    let simdgroup_bfloat_pipeline: metal::ComputePipelineState =
        metal::ComputePipelineState::from_raw(simdgroup_bfloat_owner.raw());
    guard let option::Option[metal::Buffer]::Some(storage) =
        packed_storage_buffer(device, weight_file) else { return 1; };
    let storage_owner: OwnedObjc = OwnedObjc::new(storage.raw());
    let maximum_elements: usize = (278 as usize) *% MLP_WIDTH;
    let maximum_bytes: u64 = (maximum_elements *% #size_of::[f32]()) as u64;
    guard let option::Option[metal::Buffer]::Some(input) =
        new_buffer(device, maximum_bytes) else { return 1; };
    let input_owner: OwnedObjc = OwnedObjc::new(input.raw());
    guard let option::Option[metal::Buffer]::Some(output) =
        new_buffer(device, maximum_bytes) else { return 1; };
    let output_owner: OwnedObjc = OwnedObjc::new(output.raw());
    guard let option::Option[metal::Buffer]::Some(reference) =
        new_buffer(device, maximum_bytes) else { return 1; };
    let reference_owner: OwnedObjc = OwnedObjc::new(reference.raw());
    let input_values: *f32 = input.contents() as *f32;
    var index: usize = 0 as usize;
    while index < maximum_elements {
        input_values[index] = ((index % (251 as usize)) as f32 - 125.0f32) / 4096.0f32;
        index = index +% (1 as usize);
    }

    var all_ok: bool = true;
    var rows: usize = 256 as usize;
    var row_case: usize = 0 as usize;
    while row_case < (2 as usize) {
        all_ok = benchmark_production_gemm_case(
            queue, dense_pipeline, int8_pipeline, int8_simdgroup_pipeline,
            int8_simdgroup_direct_pipeline, int8_simdgroup_64x64_pipeline,
            int8_simdgroup_128_pipeline,
            simdgroup_pipeline, simdgroup_half_pipeline,
            simdgroup_half_64_pipeline, simdgroup_half_direct_pipeline,
            simdgroup_half_64x64_pipeline,
            simdgroup_half_128_pipeline,
            simdgroup_bfloat_pipeline,
            weight_file, storage, input, output, reference,
            "transformer_blocks.0.attn.to_q.weight", rows, WIDTH, WIDTH,
            PACKED_SCHEME_BF16,
        ) && all_ok;
        all_ok = benchmark_production_gemm_case(
            queue, dense_pipeline, int8_pipeline, int8_simdgroup_pipeline,
            int8_simdgroup_direct_pipeline, int8_simdgroup_64x64_pipeline,
            int8_simdgroup_128_pipeline,
            simdgroup_pipeline, simdgroup_half_pipeline,
            simdgroup_half_64_pipeline, simdgroup_half_direct_pipeline,
            simdgroup_half_64x64_pipeline,
            simdgroup_half_128_pipeline,
            simdgroup_bfloat_pipeline,
            weight_file, storage, input, output, reference,
            "transformer_blocks.0.img_mlp.gate_layer.weight", rows, MLP_WIDTH, WIDTH,
            PACKED_SCHEME_BF16,
        ) && all_ok;
        all_ok = benchmark_production_gemm_case(
            queue, dense_pipeline, int8_pipeline, int8_simdgroup_pipeline,
            int8_simdgroup_direct_pipeline, int8_simdgroup_64x64_pipeline,
            int8_simdgroup_128_pipeline,
            simdgroup_pipeline, simdgroup_half_pipeline,
            simdgroup_half_64_pipeline, simdgroup_half_direct_pipeline,
            simdgroup_half_64x64_pipeline,
            simdgroup_half_128_pipeline,
            simdgroup_bfloat_pipeline,
            weight_file, storage, input, output, reference,
            "transformer_blocks.0.img_mlp.out.weight", rows, WIDTH, MLP_WIDTH,
            PACKED_SCHEME_BF16,
        ) && all_ok;
        all_ok = benchmark_production_gemm_case(
            queue, dense_pipeline, int8_pipeline, int8_simdgroup_pipeline,
            int8_simdgroup_direct_pipeline, int8_simdgroup_64x64_pipeline,
            int8_simdgroup_128_pipeline,
            simdgroup_pipeline, simdgroup_half_pipeline,
            simdgroup_half_64_pipeline, simdgroup_half_direct_pipeline,
            simdgroup_half_64x64_pipeline,
            simdgroup_half_128_pipeline,
            simdgroup_bfloat_pipeline,
            weight_file, storage, input, output, reference,
            "transformer_blocks.28.attn.to_q.weight", rows, WIDTH, WIDTH,
            PACKED_SCHEME_INT8_AFFINE,
        ) && all_ok;
        all_ok = benchmark_production_gemm_case(
            queue, dense_pipeline, int8_pipeline, int8_simdgroup_pipeline,
            int8_simdgroup_direct_pipeline, int8_simdgroup_64x64_pipeline,
            int8_simdgroup_128_pipeline,
            simdgroup_pipeline, simdgroup_half_pipeline,
            simdgroup_half_64_pipeline, simdgroup_half_direct_pipeline,
            simdgroup_half_64x64_pipeline,
            simdgroup_half_128_pipeline,
            simdgroup_bfloat_pipeline,
            weight_file, storage, input, output, reference,
            "transformer_blocks.28.img_mlp.proj.weight", rows, MLP_WIDTH, WIDTH,
            PACKED_SCHEME_INT8_AFFINE,
        ) && all_ok;
        all_ok = benchmark_production_gemm_case(
            queue, dense_pipeline, int8_pipeline, int8_simdgroup_pipeline,
            int8_simdgroup_direct_pipeline, int8_simdgroup_64x64_pipeline,
            int8_simdgroup_128_pipeline,
            simdgroup_pipeline, simdgroup_half_pipeline,
            simdgroup_half_64_pipeline, simdgroup_half_direct_pipeline,
            simdgroup_half_64x64_pipeline,
            simdgroup_half_128_pipeline,
            simdgroup_bfloat_pipeline,
            weight_file, storage, input, output, reference,
            "transformer_blocks.28.img_mlp.out.weight", rows, WIDTH, MLP_WIDTH,
            PACKED_SCHEME_INT8_AFFINE,
        ) && all_ok;
        rows = 278 as usize;
        row_case = row_case +% (1 as usize);
    }
    io::println("production GEMM benchmark: packed_load_wall_ms=${load_wall_ms} iterations=3");
    return if all_ok { 0 } else { 1 };
}

fn benchmark_mps_gemm_case(
    device: metal::Device,
    queue: metal::CommandQueue,
    dense_pipeline: metal::ComputePipelineState,
    int8_pipeline: metal::ComputePipelineState,
    input_conversion_pipeline: metal::ComputePipelineState,
    bf16_conversion_pipeline: metal::ComputePipelineState,
    q8_conversion_pipeline: metal::ComputePipelineState,
    file: packed::File,
    storage: metal::Buffer,
    input: metal::Buffer,
    half_input: metal::Buffer,
    half_weight: metal::Buffer,
    output: metal::Buffer,
    reference: metal::Buffer,
    tensor_name: str,
    output_columns: usize,
    input_columns: usize,
) -> bool {
    let rows: usize = 256 as usize;
    guard let option::Option[LinearWeight]::Some(weight) = packed_linear_weight(
        file, storage, tensor_name, output_columns as u64, input_columns as u64,
    ) else { return false; };
    let reference_result: option::Option[f64] =
        if weight.scheme == PACKED_SCHEME_INT8_AFFINE {
        dispatch_int8_linear(
                queue, int8_pipeline, input, weight, reference,
            output_columns, input_columns, rows,
        )
    } else {
        dispatch_linear(
                queue, dense_pipeline, input, weight.storage, reference,
            output_columns, input_columns, rows, weight.weights_offset,
            if weight.scheme == PACKED_SCHEME_FP16 { 1 as u32 } else { 0 as u32 },
        )
    };
    guard let option::Option[f64]::Some(reference_ms) = reference_result else {
        return false;
    };
    var weight_conversion_ms: f64 = 0.0f64;
    if weight.scheme != PACKED_SCHEME_FP16 {
        guard let option::Option[f64]::Some(conversion_ms) = convert_mps_weight(
            queue, bf16_conversion_pipeline, q8_conversion_pipeline, weight, half_weight,
            output_columns, input_columns,
        ) else { return false; };
        weight_conversion_ms = conversion_ms;
    }
    let mps_weight_buffer: metal::Buffer = if weight.scheme == PACKED_SCHEME_FP16 {
        weight.storage
    } else {
        half_weight
    };
    let mps_weight_offset: u64 = if weight.scheme == PACKED_SCHEME_FP16 {
        weight.weights_offset
    } else {
        0 as u64
    };
    guard let option::Option[mps::Multiplication]::Some(created_operation) = mps::create(
        device, half_input, 0 as u64, mps_weight_buffer, mps_weight_offset,
        output, 0 as u64, rows, output_columns, input_columns,
    ) else {
        io::eprintln("MPS GEMM benchmark: could not create matrix multiplication");
        return false;
    };
    var operation: mps::Multiplication = created_operation;
    guard let option::Option[f64]::Some(_warmup_ms) = dispatch_mps_preconverted_linear(
        queue, input_conversion_pipeline, operation, input, half_input, rows, input_columns,
    ) else { return false; };
    let iterations: usize = 3 as usize;
    var total_ms: f64 = 0.0f64;
    var iteration: usize = 0 as usize;
    while iteration < iterations {
        guard let option::Option[f64]::Some(elapsed_ms) = dispatch_mps_preconverted_linear(
            queue, input_conversion_pipeline, operation,
            input, half_input, rows, input_columns,
        ) else { return false; };
        total_ms = total_ms + elapsed_ms;
        iteration = iteration +% (1 as usize);
    }
    let average_ms: f64 = total_ms / iterations as f64;
    let error: f64 = normalized_rms_buffers(
        output, 0 as usize, reference, 0 as usize, rows *% output_columns,
    );
    let operations: f64 = 2.0f64 * rows as f64
        * output_columns as f64 * input_columns as f64;
    let scheme_name: str = if weight.scheme == PACKED_SCHEME_INT8_AFFINE {
        "q8"
    } else if weight.scheme == PACKED_SCHEME_FP16 {
        "fp16"
    } else {
        "bf16"
    };
    io::println(
        "production MPS GEMM: scheme=${scheme_name} rows=${rows} output=${output_columns} input=${input_columns} scalar_gpu_ms=${reference_ms} weight_conversion_gpu_ms=${weight_conversion_ms} preconverted_gpu_ms=${average_ms} dynamic_conversion_gpu_ms=${average_ms + weight_conversion_ms} preconverted_tflops=${operations / (average_ms * 1000000000.0f64)} nRMSE=${error} tensor=${tensor_name}",
    );
    return error <= (0.0003f64);
}

fn benchmark_mps_gemm(packed_path: str) -> i32 {
    if !mps::load_framework() {
        io::eprintln("MPS GEMM benchmark: could not load MetalPerformanceShaders");
        return 1;
    }
    guard let packed::LoadResult::Ok(weight_file) = packed::load(packed_path) else {
        io::eprintln("MPS GEMM benchmark: could not load ${packed_path}");
        return 1;
    };
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return 1; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    let device_pointer: *u8 = MTLCreateSystemDefaultDevice();
    if device_pointer.is_null() { return 1; }
    let device_owner: OwnedObjc = OwnedObjc::new(rt::retain(device_pointer));
    let device: metal::Device = metal::Device::from_raw(device_owner.raw());
    guard let option::Option[metal::CommandQueue]::Some(queue) =
        device.new_command_queue() else { return 1; };
    let queue_owner: OwnedObjc = OwnedObjc::new(queue.raw());
    let options_pointer: *u8 = rt::alloc_init(#str_ptr("MTLCompileOptions\0"));
    if options_pointer.is_null() { return 1; }
    let options_owner: OwnedObjc = OwnedObjc::new(options_pointer);
    let options: metal::CompileOptions = metal::CompileOptions::from_raw(options_owner.raw());
    options.set_fast_math_enabled(false);
    var compile_error: *u8 = 0 as *u8;
    guard let option::Option[metal::Library]::Some(library) = device.new_library_with_source(
        #include_str("../kernels/transformer_block.metal"), options,
        #addr_of(compile_error) as *u8,
    ) else {
        if !compile_error.is_null() {
            let description: *u8 =
                rt::msg_id(compile_error, rt::sel(#str_ptr("localizedDescription\0")));
            io::eprintln("MPS GEMM Metal compile: ${bridge::to_text(description)}");
        }
        return 1;
    };
    let library_owner: OwnedObjc = OwnedObjc::new(library.raw());
    guard let option::Option[OwnedObjc]::Some(dense_owner) =
        pipeline(device, library, "qi_block_linear_32x32") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(int8_owner) =
        pipeline(device, library, "qi_block_int8_affine_linear_32x32") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(input_conversion_owner) =
        pipeline(device, library, "qi_mps_input_to_half") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(bf16_conversion_owner) =
        pipeline(device, library, "qi_mps_bf16_weight_to_half") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(q8_conversion_owner) =
        pipeline(device, library, "qi_mps_q8_weight_to_half") else { return 1; };
    let dense_pipeline: metal::ComputePipelineState =
        metal::ComputePipelineState::from_raw(dense_owner.raw());
    let int8_pipeline: metal::ComputePipelineState =
        metal::ComputePipelineState::from_raw(int8_owner.raw());
    let input_conversion_pipeline: metal::ComputePipelineState =
        metal::ComputePipelineState::from_raw(input_conversion_owner.raw());
    let bf16_conversion_pipeline: metal::ComputePipelineState =
        metal::ComputePipelineState::from_raw(bf16_conversion_owner.raw());
    let q8_conversion_pipeline: metal::ComputePipelineState =
        metal::ComputePipelineState::from_raw(q8_conversion_owner.raw());
    guard let option::Option[metal::Buffer]::Some(storage) =
        packed_storage_buffer(device, weight_file) else { return 1; };
    let storage_owner: OwnedObjc = OwnedObjc::new(storage.raw());
    let maximum_input_elements: usize = (256 as usize) *% MLP_WIDTH;
    let maximum_output_elements: usize = (256 as usize) *% MLP_WIDTH;
    let maximum_weight_elements: usize = MLP_WIDTH *% WIDTH;
    guard let option::Option[metal::Buffer]::Some(input) = new_buffer(
        device, (maximum_input_elements *% #size_of::[f32]()) as u64,
    ) else { return 1; };
    let input_owner: OwnedObjc = OwnedObjc::new(input.raw());
    guard let option::Option[metal::Buffer]::Some(half_input) = new_buffer(
        device, (maximum_input_elements *% #size_of::[u16]()) as u64,
    ) else { return 1; };
    let half_input_owner: OwnedObjc = OwnedObjc::new(half_input.raw());
    guard let option::Option[metal::Buffer]::Some(half_weight) = new_buffer(
        device, (maximum_weight_elements *% #size_of::[u16]()) as u64,
    ) else { return 1; };
    let half_weight_owner: OwnedObjc = OwnedObjc::new(half_weight.raw());
    guard let option::Option[metal::Buffer]::Some(output) = new_buffer(
        device, (maximum_output_elements *% #size_of::[f32]()) as u64,
    ) else { return 1; };
    let output_owner: OwnedObjc = OwnedObjc::new(output.raw());
    guard let option::Option[metal::Buffer]::Some(reference) = new_buffer(
        device, (maximum_output_elements *% #size_of::[f32]()) as u64,
    ) else { return 1; };
    let reference_owner: OwnedObjc = OwnedObjc::new(reference.raw());
    let input_values: *f32 = input.contents() as *f32;
    var index: usize = 0 as usize;
    while index < maximum_input_elements {
        input_values[index] = ((index % (251 as usize)) as f32 - 125.0f32) / 4096.0f32;
        index = index +% (1 as usize);
    }
    var all_ok: bool = true;
    all_ok = benchmark_mps_gemm_case(
        device, queue, dense_pipeline, int8_pipeline, input_conversion_pipeline,
        bf16_conversion_pipeline, q8_conversion_pipeline, weight_file, storage,
        input, half_input, half_weight, output, reference,
        "transformer_blocks.0.attn.to_q.weight", WIDTH, WIDTH,
    ) && all_ok;
    all_ok = benchmark_mps_gemm_case(
        device, queue, dense_pipeline, int8_pipeline, input_conversion_pipeline,
        bf16_conversion_pipeline, q8_conversion_pipeline, weight_file, storage,
        input, half_input, half_weight, output, reference,
        "transformer_blocks.0.img_mlp.gate_layer.weight",
        MLP_WIDTH, WIDTH,
    ) && all_ok;
    all_ok = benchmark_mps_gemm_case(
        device, queue, dense_pipeline, int8_pipeline, input_conversion_pipeline,
        bf16_conversion_pipeline, q8_conversion_pipeline, weight_file, storage,
        input, half_input, half_weight, output, reference,
        "transformer_blocks.0.img_mlp.out.weight",
        WIDTH, MLP_WIDTH,
    ) && all_ok;
    all_ok = benchmark_mps_gemm_case(
        device, queue, dense_pipeline, int8_pipeline, input_conversion_pipeline,
        bf16_conversion_pipeline, q8_conversion_pipeline, weight_file, storage,
        input, half_input, half_weight, output, reference,
        "transformer_blocks.28.attn.to_q.weight",
        WIDTH, WIDTH,
    ) && all_ok;
    all_ok = benchmark_mps_gemm_case(
        device, queue, dense_pipeline, int8_pipeline, input_conversion_pipeline,
        bf16_conversion_pipeline, q8_conversion_pipeline, weight_file, storage,
        input, half_input, half_weight, output, reference,
        "transformer_blocks.28.img_mlp.proj.weight",
        MLP_WIDTH, WIDTH,
    ) && all_ok;
    all_ok = benchmark_mps_gemm_case(
        device, queue, dense_pipeline, int8_pipeline, input_conversion_pipeline,
        bf16_conversion_pipeline, q8_conversion_pipeline, weight_file, storage,
        input, half_input, half_weight, output, reference,
        "transformer_blocks.28.img_mlp.out.weight",
        WIDTH, MLP_WIDTH,
    ) && all_ok;
    return if all_ok { 0 } else { 1 };
}

fn benchmark_transformer_small_kernels() -> i32 {
    let rows: usize = 256 as usize;
    let activation_elements: usize = rows *% WIDTH;
    let mlp_elements: usize = rows *% MLP_WIDTH;
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return 1; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    let device_pointer: *u8 = MTLCreateSystemDefaultDevice();
    if device_pointer.is_null() { return 1; }
    let device_owner: OwnedObjc = OwnedObjc::new(rt::retain(device_pointer));
    let device: metal::Device = metal::Device::from_raw(device_owner.raw());
    guard let option::Option[metal::CommandQueue]::Some(queue) = device.new_command_queue() else {
        return 1;
    };
    let queue_owner: OwnedObjc = OwnedObjc::new(queue.raw());
    let options_pointer: *u8 = rt::alloc_init(#str_ptr("MTLCompileOptions\0"));
    if options_pointer.is_null() { return 1; }
    let options_owner: OwnedObjc = OwnedObjc::new(options_pointer);
    let options: metal::CompileOptions = metal::CompileOptions::from_raw(options_owner.raw());
    options.set_fast_math_enabled(false);
    var compile_error: *u8 = 0 as *u8;
    guard let option::Option[metal::Library]::Some(library) = device.new_library_with_source(
        #include_str("../kernels/transformer_block.metal"), options,
        #addr_of(compile_error) as *u8,
    ) else {
        if !compile_error.is_null() {
            let description: *u8 = rt::msg_id(
                compile_error, rt::sel(#str_ptr("localizedDescription\0")),
            );
            io::eprintln("small-kernel Metal compile: ${bridge::to_text(description)}");
        }
        return 1;
    };
    let library_owner: OwnedObjc = OwnedObjc::new(library.raw());
    guard let option::Option[OwnedObjc]::Some(norm_owner) =
        pipeline(device, library, "qi_block_layernorm_modulate_scalar") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(norm_simd_owner) =
        pipeline(device, library, "qi_block_layernorm_modulate") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(qk_owner) =
        pipeline(device, library, "qi_block_qk_norm_rope_scalar") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(qk_simd_owner) =
        pipeline(device, library, "qi_block_qk_norm_rope") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(residual_owner) =
        pipeline(device, library, "qi_block_residual") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(swiglu_owner) =
        pipeline(device, library, "qi_block_swiglu") else { return 1; };
    let norm_pipeline: metal::ComputePipelineState =
        metal::ComputePipelineState::from_raw(norm_owner.raw());
    let norm_simd_pipeline: metal::ComputePipelineState =
        metal::ComputePipelineState::from_raw(norm_simd_owner.raw());
    let qk_pipeline: metal::ComputePipelineState =
        metal::ComputePipelineState::from_raw(qk_owner.raw());
    let qk_simd_pipeline: metal::ComputePipelineState =
        metal::ComputePipelineState::from_raw(qk_simd_owner.raw());
    let residual_pipeline: metal::ComputePipelineState =
        metal::ComputePipelineState::from_raw(residual_owner.raw());
    let swiglu_pipeline: metal::ComputePipelineState =
        metal::ComputePipelineState::from_raw(swiglu_owner.raw());

    let activation_bytes: u64 = (activation_elements *% #size_of::[f32]()) as u64;
    let mlp_bytes: u64 = (mlp_elements *% #size_of::[f32]()) as u64;
    guard let option::Option[metal::Buffer]::Some(input) = new_buffer(device, activation_bytes) else { return 1; }; let input_owner: OwnedObjc = OwnedObjc::new(input.raw());
    guard let option::Option[metal::Buffer]::Some(reference) = new_buffer(device, activation_bytes) else { return 1; }; let reference_owner: OwnedObjc = OwnedObjc::new(reference.raw());
    guard let option::Option[metal::Buffer]::Some(candidate) = new_buffer(device, activation_bytes) else { return 1; }; let candidate_owner: OwnedObjc = OwnedObjc::new(candidate.raw());
    guard let option::Option[metal::Buffer]::Some(modulation) = new_buffer(device, ((8 as usize) *% WIDTH *% #size_of::[f32]()) as u64) else { return 1; }; let modulation_owner: OwnedObjc = OwnedObjc::new(modulation.raw());
    guard let option::Option[metal::Buffer]::Some(rope) = new_buffer(device, (rows *% HEAD_DIMENSION *% #size_of::[f32]()) as u64) else { return 1; }; let rope_owner: OwnedObjc = OwnedObjc::new(rope.raw());
    guard let option::Option[metal::Buffer]::Some(norm_weight) = new_buffer(device, (HEAD_DIMENSION *% #size_of::[u16]()) as u64) else { return 1; }; let norm_weight_owner: OwnedObjc = OwnedObjc::new(norm_weight.raw());
    guard let option::Option[metal::Buffer]::Some(target_mask) = new_buffer(device, rows as u64) else { return 1; }; let target_mask_owner: OwnedObjc = OwnedObjc::new(target_mask.raw());
    guard let option::Option[metal::Buffer]::Some(mlp_gate) = new_buffer(device, mlp_bytes) else { return 1; }; let mlp_gate_owner: OwnedObjc = OwnedObjc::new(mlp_gate.raw());
    guard let option::Option[metal::Buffer]::Some(mlp_projected) = new_buffer(device, mlp_bytes) else { return 1; }; let mlp_projected_owner: OwnedObjc = OwnedObjc::new(mlp_projected.raw());
    guard let option::Option[metal::Buffer]::Some(mlp_output) = new_buffer(device, mlp_bytes) else { return 1; }; let mlp_output_owner: OwnedObjc = OwnedObjc::new(mlp_output.raw());
    guard let option::Option[metal::Buffer]::Some(dummy) = new_buffer(device, 4 as u64) else { return 1; }; let dummy_owner: OwnedObjc = OwnedObjc::new(dummy.raw());

    var index: usize = 0 as usize;
    while index < activation_elements {
        (input.contents() as *f32)[index] = ((index % (251 as usize)) as f32 - 125.0f32) / 128.0f32;
        index = index +% (1 as usize);
    }
    index = 0 as usize;
    while index < (8 as usize) *% WIDTH {
        (modulation.contents() as *f32)[index] = ((index % (67 as usize)) as f32 - 33.0f32) / 1024.0f32;
        index = index +% (1 as usize);
    }
    index = 0 as usize;
    while index < rows *% HEAD_DIMENSION {
        (rope.contents() as *f32)[index] = if index % (2 as usize) == (0 as usize) { 1.0f32 } else { 0.0f32 };
        index = index +% (1 as usize);
    }
    index = 0 as usize;
    while index < HEAD_DIMENSION {
        (norm_weight.contents() as *u16)[index] = cpu::f32_to_bf16(1.0f32);
        index = index +% (1 as usize);
    }
    index = 0 as usize;
    while index < rows {
        target_mask.contents()[index] = 1 as u8;
        index = index +% (1 as usize);
    }
    index = 0 as usize;
    while index < mlp_elements {
        (mlp_gate.contents() as *f32)[index] = ((index % (127 as usize)) as f32 - 63.0f32) / 64.0f32;
        (mlp_projected.contents() as *f32)[index] = ((index % (113 as usize)) as f32 - 56.0f32) / 64.0f32;
        index = index +% (1 as usize);
    }
    var params: BlockParams = BlockParams {
        rows: rows as u32, width: WIDTH as u32, heads: HEADS as u32,
        head_dimension: HEAD_DIMENSION as u32, epsilon: 0.000001f32, slot: 0 as u32,
        input_stride: WIDTH as u32, input_offset: 0 as u32,
    };
    guard let option::Option[f64]::Some(_norm_warmup) = dispatch_1d(queue, norm_pipeline, input, modulation, reference, target_mask, dummy, dummy, #addr_of(params), rows) else { return 1; };
    guard let option::Option[f64]::Some(_norm_simd_warmup) = dispatch_simdgroup_1d(queue, norm_simd_pipeline, input, modulation, candidate, target_mask, dummy, dummy, #addr_of(params), rows) else { return 1; };
    guard let option::Option[f64]::Some(_qk_warmup) = dispatch_1d(queue, qk_pipeline, input, norm_weight, reference, rope, dummy, dummy, #addr_of(params), rows *% HEADS) else { return 1; };
    guard let option::Option[f64]::Some(_qk_simd_warmup) = dispatch_simdgroup_1d(queue, qk_simd_pipeline, input, norm_weight, candidate, rope, dummy, dummy, #addr_of(params), rows *% HEADS) else { return 1; };

    let iterations: usize = 10 as usize;
    var norm_ms: f64 = 0.0f64; var norm_simd_ms: f64 = 0.0f64;
    var qk_ms: f64 = 0.0f64; var qk_simd_ms: f64 = 0.0f64;
    var residual_ms: f64 = 0.0f64; var swiglu_ms: f64 = 0.0f64;
    index = 0 as usize;
    while index < iterations {
        guard let option::Option[f64]::Some(norm_value) = dispatch_1d(queue, norm_pipeline, input, modulation, reference, target_mask, dummy, dummy, #addr_of(params), rows) else { return 1; }; norm_ms = norm_ms + norm_value;
        guard let option::Option[f64]::Some(norm_simd_value) = dispatch_simdgroup_1d(queue, norm_simd_pipeline, input, modulation, candidate, target_mask, dummy, dummy, #addr_of(params), rows) else { return 1; }; norm_simd_ms = norm_simd_ms + norm_simd_value;
        guard let option::Option[f64]::Some(qk_value) = dispatch_1d(queue, qk_pipeline, input, norm_weight, reference, rope, dummy, dummy, #addr_of(params), rows *% HEADS) else { return 1; }; qk_ms = qk_ms + qk_value;
        guard let option::Option[f64]::Some(qk_simd_value) = dispatch_simdgroup_1d(queue, qk_simd_pipeline, input, norm_weight, candidate, rope, dummy, dummy, #addr_of(params), rows *% HEADS) else { return 1; }; qk_simd_ms = qk_simd_ms + qk_simd_value;
        params.slot = 1 as u32;
        guard let option::Option[f64]::Some(residual_value) = dispatch_1d(queue, residual_pipeline, input, modulation, candidate, reference, target_mask, dummy, #addr_of(params), activation_elements) else { return 1; }; residual_ms = residual_ms + residual_value;
        params.width = WIDTH as u32;
        guard let option::Option[f64]::Some(swiglu_value) = dispatch_1d(queue, swiglu_pipeline, mlp_gate, mlp_projected, mlp_output, dummy, dummy, dummy, #addr_of(params), mlp_elements) else { return 1; }; swiglu_ms = swiglu_ms + swiglu_value;
        params.slot = 0 as u32;
        index = index +% (1 as usize);
    }
    norm_ms = norm_ms / iterations as f64; norm_simd_ms = norm_simd_ms / iterations as f64;
    qk_ms = qk_ms / iterations as f64; qk_simd_ms = qk_simd_ms / iterations as f64;
    residual_ms = residual_ms / iterations as f64; swiglu_ms = swiglu_ms / iterations as f64;
    guard let option::Option[f64]::Some(_norm_reference) = dispatch_1d(queue, norm_pipeline, input, modulation, reference, target_mask, dummy, dummy, #addr_of(params), rows) else { return 1; };
    guard let option::Option[f64]::Some(_norm_candidate) = dispatch_simdgroup_1d(queue, norm_simd_pipeline, input, modulation, candidate, target_mask, dummy, dummy, #addr_of(params), rows) else { return 1; };
    let norm_error: f64 = normalized_rms_buffers(candidate, 0 as usize, reference, 0 as usize, activation_elements);
    guard let option::Option[f64]::Some(_qk_reference) = dispatch_1d(queue, qk_pipeline, input, norm_weight, reference, rope, dummy, dummy, #addr_of(params), rows *% HEADS) else { return 1; };
    guard let option::Option[f64]::Some(_qk_candidate) = dispatch_simdgroup_1d(queue, qk_simd_pipeline, input, norm_weight, candidate, rope, dummy, dummy, #addr_of(params), rows *% HEADS) else { return 1; };
    let qk_error: f64 = normalized_rms_buffers(candidate, 0 as usize, reference, 0 as usize, activation_elements);
    let scalar_projected_ms: f64 = (2.0f64 * norm_ms + 2.0f64 * qk_ms + 2.0f64 * residual_ms + swiglu_ms) * 32.0f64 * 40.0f64;
    let candidate_projected_ms: f64 = (2.0f64 * norm_simd_ms + 2.0f64 * qk_simd_ms + 2.0f64 * residual_ms + swiglu_ms) * 32.0f64 * 40.0f64;
    io::println("small-kernel benchmark: rows=${rows} iterations=${iterations} layernorm_gpu_ms=${norm_ms} layernorm_simd_gpu_ms=${norm_simd_ms} layernorm_speedup=${norm_ms / norm_simd_ms} layernorm_nRMSE=${norm_error}");
    io::println("small-kernel benchmark: qk_norm_rope_gpu_ms=${qk_ms} qk_simd_gpu_ms=${qk_simd_ms} qk_speedup=${qk_ms / qk_simd_ms} qk_nRMSE=${qk_error} residual_gpu_ms=${residual_ms} swiglu_gpu_ms=${swiglu_ms}");
    io::println("small-kernel benchmark: projected_40_step_32_block_gpu_ms=${scalar_projected_ms} candidate_projected_gpu_ms=${candidate_projected_ms} projected_savings_ms=${scalar_projected_ms - candidate_projected_ms}");
    return if norm_error <= 0.00001f64 && qk_error <= 0.00001f64 { 0 } else { 1 };
}

fn benchmark_production_attention(pixels: str = "256") -> i32 {
    var prefix_rows: usize = 0 as usize;
    var target_rows: usize = 0 as usize;
    var iterations: usize = 0 as usize;
    if pixels == "256" {
        prefix_rows = 22 as usize;
        target_rows = 256 as usize;
        iterations = 3 as usize;
    } else if pixels == "1024" {
        prefix_rows = 31 as usize;
        target_rows = 4096 as usize;
        iterations = 1 as usize;
    } else {
        io::eprintln("production attention benchmark: pixels must be 256 or 1024");
        return 2;
    }
    let full_rows: usize = prefix_rows +% target_rows;
    let padded_key_rows: usize = round_up(full_rows, 64 as usize);
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return 1; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    let device_pointer: *u8 = MTLCreateSystemDefaultDevice();
    if device_pointer.is_null() { return 1; }
    let device_owner: OwnedObjc = OwnedObjc::new(rt::retain(device_pointer));
    let device: metal::Device = metal::Device::from_raw(device_owner.raw());
    guard let option::Option[metal::CommandQueue]::Some(queue) = device.new_command_queue() else { return 1; };
    let queue_owner: OwnedObjc = OwnedObjc::new(queue.raw());
    let options_pointer: *u8 = rt::alloc_init(#str_ptr("MTLCompileOptions\0"));
    if options_pointer.is_null() { return 1; }
    let options_owner: OwnedObjc = OwnedObjc::new(options_pointer);
    let options: metal::CompileOptions = metal::CompileOptions::from_raw(options_owner.raw());
    options.set_fast_math_enabled(false);
    var compile_error: *u8 = 0 as *u8;
    guard let option::Option[metal::Library]::Some(library) = device.new_library_with_source(
        #include_str("../kernels/transformer_block.metal"), options,
        #addr_of(compile_error) as *u8,
    ) else { return 1; };
    let library_owner: OwnedObjc = OwnedObjc::new(library.raw());
    guard let option::Option[OwnedObjc]::Some(attention_owner) =
        pipeline(device, library, "qi_block_attention") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(simdgroup_attention_owner) =
        pipeline(device, library, "qi_block_attention_simdgroup") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(four_query_attention_owner) =
        pipeline(device, library, "qi_block_attention_simdgroup4") else { return 1; };
    guard let option::Option[OwnedObjc]::Some(flash_attention_owner) =
        pipeline(device, library, "qi_block_attention_flash128") else { return 1; };
    let attention_pipeline: metal::ComputePipelineState =
        metal::ComputePipelineState::from_raw(attention_owner.raw());
    let simdgroup_attention_pipeline: metal::ComputePipelineState =
        metal::ComputePipelineState::from_raw(simdgroup_attention_owner.raw());
    let four_query_attention_pipeline: metal::ComputePipelineState =
        metal::ComputePipelineState::from_raw(four_query_attention_owner.raw());
    let flash_attention_pipeline: metal::ComputePipelineState =
        metal::ComputePipelineState::from_raw(flash_attention_owner.raw());
    let full_bytes: u64 = (full_rows *% WIDTH *% #size_of::[f32]()) as u64;
    let target_bytes: u64 = (target_rows *% WIDTH *% #size_of::[f32]()) as u64;
    let prefix_bytes: u64 = (prefix_rows *% WIDTH *% #size_of::[f32]()) as u64;
    let flash_kv_bytes: u64 =
        (padded_key_rows *% WIDTH *% #size_of::[u16]()) as u64;
    guard let option::Option[metal::Buffer]::Some(full_query) = new_buffer(device, full_bytes) else { return 1; }; let full_query_owner: OwnedObjc = OwnedObjc::new(full_query.raw());
    guard let option::Option[metal::Buffer]::Some(full_key) = new_buffer(device, full_bytes) else { return 1; }; let full_key_owner: OwnedObjc = OwnedObjc::new(full_key.raw());
    guard let option::Option[metal::Buffer]::Some(full_value) = new_buffer(device, full_bytes) else { return 1; }; let full_value_owner: OwnedObjc = OwnedObjc::new(full_value.raw());
    guard let option::Option[metal::Buffer]::Some(full_output) = new_buffer(device, full_bytes) else { return 1; }; let full_output_owner: OwnedObjc = OwnedObjc::new(full_output.raw());
    guard let option::Option[metal::Buffer]::Some(full_simdgroup_output) = new_buffer(device, full_bytes) else { return 1; }; let full_simdgroup_output_owner: OwnedObjc = OwnedObjc::new(full_simdgroup_output.raw());
    guard let option::Option[metal::Buffer]::Some(full_four_query_output) = new_buffer(device, full_bytes) else { return 1; }; let full_four_query_output_owner: OwnedObjc = OwnedObjc::new(full_four_query_output.raw());
    guard let option::Option[metal::Buffer]::Some(full_flash_output) = new_buffer(device, full_bytes) else { return 1; }; let full_flash_output_owner: OwnedObjc = OwnedObjc::new(full_flash_output.raw());
    guard let option::Option[metal::Buffer]::Some(full_graph_output) = new_buffer(device, full_bytes) else { return 1; }; let full_graph_output_owner: OwnedObjc = OwnedObjc::new(full_graph_output.raw());
    guard let option::Option[metal::Buffer]::Some(target_query) = new_buffer(device, target_bytes) else { return 1; }; let target_query_owner: OwnedObjc = OwnedObjc::new(target_query.raw());
    guard let option::Option[metal::Buffer]::Some(target_key) = new_buffer(device, target_bytes) else { return 1; }; let target_key_owner: OwnedObjc = OwnedObjc::new(target_key.raw());
    guard let option::Option[metal::Buffer]::Some(target_value) = new_buffer(device, target_bytes) else { return 1; }; let target_value_owner: OwnedObjc = OwnedObjc::new(target_value.raw());
    guard let option::Option[metal::Buffer]::Some(target_output) = new_buffer(device, target_bytes) else { return 1; }; let target_output_owner: OwnedObjc = OwnedObjc::new(target_output.raw());
    guard let option::Option[metal::Buffer]::Some(target_simdgroup_output) = new_buffer(device, target_bytes) else { return 1; }; let target_simdgroup_output_owner: OwnedObjc = OwnedObjc::new(target_simdgroup_output.raw());
    guard let option::Option[metal::Buffer]::Some(target_four_query_output) = new_buffer(device, target_bytes) else { return 1; }; let target_four_query_output_owner: OwnedObjc = OwnedObjc::new(target_four_query_output.raw());
    guard let option::Option[metal::Buffer]::Some(target_flash_output) = new_buffer(device, target_bytes) else { return 1; }; let target_flash_output_owner: OwnedObjc = OwnedObjc::new(target_flash_output.raw());
    guard let option::Option[metal::Buffer]::Some(target_graph_output) = new_buffer(device, target_bytes) else { return 1; }; let target_graph_output_owner: OwnedObjc = OwnedObjc::new(target_graph_output.raw());
    guard let option::Option[metal::Buffer]::Some(flash_key) = new_buffer(device, flash_kv_bytes) else { return 1; }; let flash_key_owner: OwnedObjc = OwnedObjc::new(flash_key.raw());
    guard let option::Option[metal::Buffer]::Some(flash_value) = new_buffer(device, flash_kv_bytes) else { return 1; }; let flash_value_owner: OwnedObjc = OwnedObjc::new(flash_value.raw());
    guard let option::Option[metal::Buffer]::Some(cache_key) = new_buffer(device, prefix_bytes) else { return 1; }; let cache_key_owner: OwnedObjc = OwnedObjc::new(cache_key.raw());
    guard let option::Option[metal::Buffer]::Some(cache_value) = new_buffer(device, prefix_bytes) else { return 1; }; let cache_value_owner: OwnedObjc = OwnedObjc::new(cache_value.raw());
    guard let option::Option[metal::Buffer]::Some(image_ids) = new_buffer(device, (padded_key_rows *% #size_of::[i32]()) as u64) else { return 1; }; let image_ids_owner: OwnedObjc = OwnedObjc::new(image_ids.raw());
    guard let option::Option[metal::Buffer]::Some(key_valid) = new_buffer(device, padded_key_rows as u64) else { return 1; }; let key_valid_owner: OwnedObjc = OwnedObjc::new(key_valid.raw());
    guard let option::Option[metal::Buffer]::Some(graph_mask) = new_buffer(
        device, (full_rows *% full_rows *% #size_of::[u16]()) as u64,
    ) else { return 1; }; let graph_mask_owner: OwnedObjc = OwnedObjc::new(graph_mask.raw());

    let full_query_values: *f32 = full_query.contents() as *f32;
    let full_key_values: *f32 = full_key.contents() as *f32;
    let full_value_values: *f32 = full_value.contents() as *f32;
    let target_query_values: *f32 = target_query.contents() as *f32;
    let target_key_values: *f32 = target_key.contents() as *f32;
    let target_value_values: *f32 = target_value.contents() as *f32;
    let cache_key_values: *f32 = cache_key.contents() as *f32;
    let cache_value_values: *f32 = cache_value.contents() as *f32;
    let flash_key_values: *u16 = flash_key.contents() as *u16;
    let flash_value_values: *u16 = flash_value.contents() as *u16;
    var index: usize = 0 as usize;
    while index < full_rows *% WIDTH {
        full_query_values[index] = ((index % (251 as usize)) as f32 - 125.0f32) / 512.0f32;
        full_key_values[index] = ((index % (239 as usize)) as f32 - 119.0f32) / 509.0f32;
        full_value_values[index] = ((index % (233 as usize)) as f32 - 116.0f32) / 251.0f32;
        flash_key_values[index] = cpu::f32_to_fp16(full_key_values[index]);
        flash_value_values[index] = cpu::f32_to_fp16(full_value_values[index]);
        index = index +% (1 as usize);
    }
    while index < padded_key_rows *% WIDTH {
        flash_key_values[index] = 0 as u16;
        flash_value_values[index] = 0 as u16;
        index = index +% (1 as usize);
    }
    index = 0 as usize;
    while index < prefix_rows *% WIDTH {
        cache_key_values[index] = full_key_values[index];
        cache_value_values[index] = full_value_values[index];
        index = index +% (1 as usize);
    }
    index = 0 as usize;
    while index < target_rows *% WIDTH {
        let full_index: usize = prefix_rows *% WIDTH +% index;
        target_query_values[index] = full_query_values[full_index];
        target_key_values[index] = full_key_values[full_index];
        target_value_values[index] = full_value_values[full_index];
        index = index +% (1 as usize);
    }
    let ids: *i32 = image_ids.contents() as *i32;
    index = 0 as usize;
    while index < padded_key_rows {
        ids[index] = if index < prefix_rows {
            0 -% (index as i32) -% (1 as i32)
        } else { 0 as i32 };
        (key_valid.contents())[index] = if index < full_rows { 1 as u8 } else { 0 as u8 };
        index = index +% (1 as usize);
    }
    let graph_mask_values: *u16 = graph_mask.contents() as *u16;
    var query_row: usize = 0 as usize;
    while query_row < full_rows {
        var key_row: usize = 0 as usize;
        while key_row < full_rows {
            let same_image: bool = query_row >= prefix_rows && key_row >= prefix_rows;
            graph_mask_values[query_row *% full_rows +% key_row] = if query_row >= key_row
                || same_image { 0 as u16 } else { 0xFBFF as u16 };
            key_row = key_row +% (1 as usize);
        }
        query_row = query_row +% (1 as usize);
    }

    guard let option::Option[f64]::Some(_prefill_warmup) = dispatch_attention(
        queue, attention_pipeline, full_query, full_key, full_output, full_value,
        image_ids, key_valid, full_rows, full_rows, cache_key, cache_value, 0 as u64,
    ) else { return 1; };
    guard let option::Option[f64]::Some(_cached_warmup) = dispatch_attention(
        queue, attention_pipeline, target_query, target_key, target_output, target_value,
        image_ids, key_valid, target_rows, full_rows, cache_key, cache_value, 0 as u64,
        prefix_rows, true, prefix_rows,
    ) else { return 1; };
    guard let option::Option[f64]::Some(_prefill_simdgroup_warmup) = dispatch_attention(
        queue, simdgroup_attention_pipeline, full_query, full_key, full_simdgroup_output,
        full_value, image_ids, key_valid, full_rows, full_rows, cache_key, cache_value, 0 as u64,
        0 as usize, true, 0 as usize, 32 as usize,
    ) else { return 1; };
    guard let option::Option[f64]::Some(_cached_simdgroup_warmup) = dispatch_attention(
        queue, simdgroup_attention_pipeline, target_query, target_key, target_simdgroup_output,
        target_value, image_ids, key_valid, target_rows, full_rows, cache_key, cache_value,
        0 as u64, prefix_rows, true, prefix_rows, 32 as usize,
    ) else { return 1; };
    guard let option::Option[f64]::Some(_prefill_four_query_warmup) = dispatch_attention(
        queue, four_query_attention_pipeline, full_query, full_key, full_four_query_output,
        full_value, image_ids, key_valid, full_rows, full_rows, cache_key, cache_value, 0 as u64,
        0 as usize, true, 0 as usize, 32 as usize, WIDTH, 0 as usize, 4 as usize,
    ) else { return 1; };
    guard let option::Option[f64]::Some(_cached_four_query_warmup) = dispatch_attention(
        queue, four_query_attention_pipeline, target_query, target_key, target_four_query_output,
        target_value, image_ids, key_valid, target_rows, full_rows, cache_key, cache_value,
        0 as u64, prefix_rows, true, prefix_rows, 32 as usize, WIDTH, 0 as usize, 4 as usize,
    ) else { return 1; };
    guard let option::Option[f64]::Some(_prefill_flash_warmup) = dispatch_flash_attention(
        queue, flash_attention_pipeline, full_query, flash_key, full_flash_output,
        flash_value, image_ids, key_valid, full_rows, full_rows, padded_key_rows,
    ) else { return 1; };
    guard let option::Option[f64]::Some(_cached_flash_warmup) = dispatch_flash_attention(
        queue, flash_attention_pipeline, target_query, flash_key, target_flash_output,
        flash_value, image_ids, key_valid, target_rows, full_rows, padded_key_rows,
        prefix_rows,
    ) else { return 1; };
    guard let option::Option[graph_attention::Attention]::Some(graph_cached_attention) =
        graph_attention::create(target_rows, full_rows) else { return 1; };
    guard let option::Option[graph_attention::Attention]::Some(graph_prefill_attention) =
        graph_attention::create(full_rows, full_rows, true) else { return 1; };
    guard let option::Option[f64]::Some(_prefill_graph_warmup) = graph_attention::dispatch_masked(
        #addr_of(graph_prefill_attention), queue, full_query, flash_key, flash_value,
        graph_mask, full_graph_output,
    ) else { return 1; };
    guard let option::Option[f64]::Some(_cached_graph_warmup) = graph_attention::dispatch(
        #addr_of(graph_cached_attention), queue, target_query, flash_key, flash_value,
        target_graph_output,
    ) else { return 1; };
    var prefill_total_ms: f64 = 0.0f64;
    var cached_total_ms: f64 = 0.0f64;
    var prefill_simdgroup_total_ms: f64 = 0.0f64;
    var cached_simdgroup_total_ms: f64 = 0.0f64;
    var prefill_four_query_total_ms: f64 = 0.0f64;
    var cached_four_query_total_ms: f64 = 0.0f64;
    var prefill_flash_total_ms: f64 = 0.0f64;
    var cached_flash_total_ms: f64 = 0.0f64;
    var cached_graph_total_ms: f64 = 0.0f64;
    var prefill_graph_total_ms: f64 = 0.0f64;
    index = 0 as usize;
    while index < iterations {
        guard let option::Option[f64]::Some(prefill_ms) = dispatch_attention(
            queue, attention_pipeline, full_query, full_key, full_output, full_value,
            image_ids, key_valid, full_rows, full_rows, cache_key, cache_value, 0 as u64,
        ) else { return 1; };
        guard let option::Option[f64]::Some(cached_ms) = dispatch_attention(
            queue, attention_pipeline, target_query, target_key, target_output, target_value,
            image_ids, key_valid, target_rows, full_rows, cache_key, cache_value, 0 as u64,
            prefix_rows, true, prefix_rows,
        ) else { return 1; };
        guard let option::Option[f64]::Some(prefill_four_query_ms) = dispatch_attention(
            queue, four_query_attention_pipeline, full_query, full_key, full_four_query_output,
            full_value, image_ids, key_valid, full_rows, full_rows, cache_key, cache_value,
            0 as u64, 0 as usize, true, 0 as usize, 32 as usize, WIDTH, 0 as usize,
            4 as usize,
        ) else { return 1; };
        guard let option::Option[f64]::Some(cached_four_query_ms) = dispatch_attention(
            queue, four_query_attention_pipeline, target_query, target_key, target_four_query_output,
            target_value, image_ids, key_valid, target_rows, full_rows, cache_key, cache_value,
            0 as u64, prefix_rows, true, prefix_rows, 32 as usize, WIDTH, 0 as usize,
            4 as usize,
        ) else { return 1; };
        guard let option::Option[f64]::Some(prefill_flash_ms) = dispatch_flash_attention(
            queue, flash_attention_pipeline, full_query, flash_key, full_flash_output,
            flash_value, image_ids, key_valid, full_rows, full_rows, padded_key_rows,
        ) else { return 1; };
        guard let option::Option[f64]::Some(cached_flash_ms) = dispatch_flash_attention(
            queue, flash_attention_pipeline, target_query, flash_key, target_flash_output,
            flash_value, image_ids, key_valid, target_rows, full_rows, padded_key_rows,
            prefix_rows,
        ) else { return 1; };
        guard let option::Option[f64]::Some(cached_graph_ms) = graph_attention::dispatch(
            #addr_of(graph_cached_attention), queue, target_query, flash_key, flash_value,
            target_graph_output,
        ) else { return 1; };
        guard let option::Option[f64]::Some(prefill_graph_ms) = graph_attention::dispatch_masked(
            #addr_of(graph_prefill_attention), queue, full_query, flash_key, flash_value,
            graph_mask, full_graph_output,
        ) else { return 1; };
        guard let option::Option[f64]::Some(prefill_simdgroup_ms) = dispatch_attention(
            queue, simdgroup_attention_pipeline, full_query, full_key, full_simdgroup_output,
            full_value, image_ids, key_valid, full_rows, full_rows, cache_key, cache_value, 0 as u64,
            0 as usize, true, 0 as usize, 32 as usize,
        ) else { return 1; };
        guard let option::Option[f64]::Some(cached_simdgroup_ms) = dispatch_attention(
            queue, simdgroup_attention_pipeline, target_query, target_key,
            target_simdgroup_output, target_value, image_ids, key_valid, target_rows,
            full_rows, cache_key, cache_value, 0 as u64, prefix_rows, true, prefix_rows,
            32 as usize,
        ) else { return 1; };
        prefill_total_ms = prefill_total_ms + prefill_ms;
        cached_total_ms = cached_total_ms + cached_ms;
        prefill_simdgroup_total_ms = prefill_simdgroup_total_ms + prefill_simdgroup_ms;
        cached_simdgroup_total_ms = cached_simdgroup_total_ms + cached_simdgroup_ms;
        prefill_four_query_total_ms = prefill_four_query_total_ms + prefill_four_query_ms;
        cached_four_query_total_ms = cached_four_query_total_ms + cached_four_query_ms;
        prefill_flash_total_ms = prefill_flash_total_ms + prefill_flash_ms;
        cached_flash_total_ms = cached_flash_total_ms + cached_flash_ms;
        cached_graph_total_ms = cached_graph_total_ms + cached_graph_ms;
        prefill_graph_total_ms = prefill_graph_total_ms + prefill_graph_ms;
        index = index +% (1 as usize);
    }
    if !finite("production attention prefill", full_output, full_rows *% WIDTH)
        || !finite("production attention cached", target_output, target_rows *% WIDTH)
        || !finite("production attention four-query prefill", full_four_query_output, full_rows *% WIDTH)
        || !finite("production attention four-query cached", target_four_query_output, target_rows *% WIDTH)
        || !finite("production attention flash prefill", full_flash_output, full_rows *% WIDTH)
        || !finite("production attention flash cached", target_flash_output, target_rows *% WIDTH) {
        return 1;
    }
    let prefill_average_ms: f64 = prefill_total_ms / iterations as f64;
    let cached_average_ms: f64 = cached_total_ms / iterations as f64;
    let prefill_simdgroup_average_ms: f64 = prefill_simdgroup_total_ms / iterations as f64;
    let cached_simdgroup_average_ms: f64 = cached_simdgroup_total_ms / iterations as f64;
    let prefill_four_query_average_ms: f64 = prefill_four_query_total_ms / iterations as f64;
    let cached_four_query_average_ms: f64 = cached_four_query_total_ms / iterations as f64;
    let prefill_flash_average_ms: f64 = prefill_flash_total_ms / iterations as f64;
    let cached_flash_average_ms: f64 = cached_flash_total_ms / iterations as f64;
    let cached_graph_average_ms: f64 = cached_graph_total_ms / iterations as f64;
    let prefill_graph_average_ms: f64 = prefill_graph_total_ms / iterations as f64;
    let projected_trajectory_ms: f64 = (prefill_average_ms
        + (39 as f64) * cached_average_ms) * (32 as f64);
    let simdgroup_projected_trajectory_ms: f64 = (prefill_simdgroup_average_ms
        + (39 as f64) * cached_simdgroup_average_ms) * (32 as f64);
    let four_query_projected_trajectory_ms: f64 = (prefill_four_query_average_ms
        + (39 as f64) * cached_four_query_average_ms) * (32 as f64);
    let flash_projected_trajectory_ms: f64 = (prefill_flash_average_ms
        + (39 as f64) * cached_flash_average_ms) * (32 as f64);
    let prefill_error: f64 = normalized_rms_buffers(
        full_simdgroup_output, 0 as usize, full_output, 0 as usize, full_rows *% WIDTH,
    );
    let cached_error: f64 = normalized_rms_buffers(
        target_simdgroup_output, 0 as usize, target_output, 0 as usize, target_rows *% WIDTH,
    );
    let four_query_prefill_error: f64 = normalized_rms_buffers(
        full_four_query_output, 0 as usize, full_output, 0 as usize, full_rows *% WIDTH,
    );
    let four_query_cached_error: f64 = normalized_rms_buffers(
        target_four_query_output, 0 as usize, target_output, 0 as usize, target_rows *% WIDTH,
    );
    let flash_prefill_error: f64 = normalized_rms_buffers(
        full_flash_output, 0 as usize, full_output, 0 as usize, full_rows *% WIDTH,
    );
    let flash_cached_error: f64 = normalized_rms_buffers(
        target_flash_output, 0 as usize, target_output, 0 as usize, target_rows *% WIDTH,
    );
    let graph_cached_error: f64 = normalized_rms_buffers(
        target_graph_output, 0 as usize, target_output, 0 as usize, target_rows *% WIDTH,
    );
    let graph_prefill_error: f64 = normalized_rms_buffers(
        full_graph_output, 0 as usize, full_output, 0 as usize, full_rows *% WIDTH,
    );
    io::println(
        "production attention benchmark: pixels=${pixels} prefill_rows=${full_rows} prefill_gpu_ms=${prefill_average_ms} cached_query_rows=${target_rows} cached_key_rows=${full_rows} cached_gpu_ms=${cached_average_ms} projected_40_step_32_block_gpu_ms=${projected_trajectory_ms} iterations=${iterations}",
    );
    io::println(
        "production attention benchmark: kernel=simdgroup prefill_gpu_ms=${prefill_simdgroup_average_ms} prefill_speedup=${prefill_average_ms / prefill_simdgroup_average_ms} prefill_nRMSE=${prefill_error} cached_gpu_ms=${cached_simdgroup_average_ms} cached_speedup=${cached_average_ms / cached_simdgroup_average_ms} cached_nRMSE=${cached_error} projected_40_step_32_block_gpu_ms=${simdgroup_projected_trajectory_ms}",
    );
    io::println(
        "production attention benchmark: kernel=simdgroup4 prefill_gpu_ms=${prefill_four_query_average_ms} speedup_vs_simdgroup=${prefill_simdgroup_average_ms / prefill_four_query_average_ms} prefill_nRMSE=${four_query_prefill_error} cached_gpu_ms=${cached_four_query_average_ms} cached_speedup_vs_simdgroup=${cached_simdgroup_average_ms / cached_four_query_average_ms} cached_nRMSE=${four_query_cached_error} projected_40_step_32_block_gpu_ms=${four_query_projected_trajectory_ms}",
    );
    io::println(
        "production attention benchmark: kernel=flash128-fp16-kv prefill_gpu_ms=${prefill_flash_average_ms} speedup_vs_simdgroup4=${prefill_four_query_average_ms / prefill_flash_average_ms} prefill_nRMSE=${flash_prefill_error} cached_gpu_ms=${cached_flash_average_ms} cached_speedup_vs_simdgroup4=${cached_four_query_average_ms / cached_flash_average_ms} cached_nRMSE=${flash_cached_error} projected_40_step_32_block_gpu_ms=${flash_projected_trajectory_ms}",
    );
    io::println(
        "production attention benchmark: kernel=mpsgraph-fp16 prefill_gpu_ms=${prefill_graph_average_ms} prefill_speedup_vs_flash=${prefill_flash_average_ms / prefill_graph_average_ms} prefill_nRMSE=${graph_prefill_error} cached_gpu_ms=${cached_graph_average_ms} cached_speedup_vs_flash=${cached_flash_average_ms / cached_graph_average_ms} cached_nRMSE=${graph_cached_error}",
    );
    return if prefill_error <= 0.00001f64 && cached_error <= 0.00001f64
        && four_query_prefill_error <= 0.00001f64 && four_query_cached_error <= 0.00001f64
        && flash_prefill_error <= 0.001f64 && flash_cached_error <= 0.001f64
        && graph_prefill_error <= 0.001f64 && graph_cached_error <= 0.001f64 {
        0
    } else { 1 };
}

fn benchmark_attention(rows: usize = 4096 as usize) -> i32 {
    if rows == (0 as usize) || rows > (4096 as usize) {
        io::eprintln("attention benchmark: token count must be 1..4096");
        return 2;
    }
    let pool_pointer: *u8 = rt::alloc_init(#str_ptr("NSAutoreleasePool\0"));
    if pool_pointer.is_null() { return 1; }
    let pool: OwnedObjc = OwnedObjc::new(pool_pointer);
    let device_pointer: *u8 = MTLCreateSystemDefaultDevice();
    if device_pointer.is_null() { io::eprintln("attention benchmark: no Metal device"); return 1; }
    let device_owner: OwnedObjc = OwnedObjc::new(rt::retain(device_pointer));
    let device: metal::Device = metal::Device::from_raw(device_owner.raw());
    guard let option::Option[metal::CommandQueue]::Some(queue) = device.new_command_queue() else { return 1; };
    let queue_owner: OwnedObjc = OwnedObjc::new(queue.raw());
    let options_pointer: *u8 = rt::alloc_init(#str_ptr("MTLCompileOptions\0"));
    if options_pointer.is_null() { return 1; }
    let options_owner: OwnedObjc = OwnedObjc::new(options_pointer);
    let options: metal::CompileOptions = metal::CompileOptions::from_raw(options_owner.raw());
    options.set_fast_math_enabled(false);
    var compile_error: *u8 = 0 as *u8;
    guard let option::Option[metal::Library]::Some(library) = device.new_library_with_source(
        #include_str("../kernels/transformer_block.metal"), options, #addr_of(compile_error) as *u8,
    ) else { return 1; };
    let library_owner: OwnedObjc = OwnedObjc::new(library.raw());
    guard let option::Option[OwnedObjc]::Some(attention_owner) = pipeline(device, library, "qi_block_attention") else { return 1; };
    let attention_pipeline: metal::ComputePipelineState = metal::ComputePipelineState::from_raw(attention_owner.raw());
    let activation_bytes: u64 = (rows *% WIDTH *% #size_of::[f32]()) as u64;
    guard let option::Option[metal::Buffer]::Some(query) = new_buffer(device, activation_bytes) else { return 1; }; let query_owner: OwnedObjc = OwnedObjc::new(query.raw());
    guard let option::Option[metal::Buffer]::Some(key) = new_buffer(device, activation_bytes) else { return 1; }; let key_owner: OwnedObjc = OwnedObjc::new(key.raw());
    guard let option::Option[metal::Buffer]::Some(value) = new_buffer(device, activation_bytes) else { return 1; }; let value_owner: OwnedObjc = OwnedObjc::new(value.raw());
    guard let option::Option[metal::Buffer]::Some(output) = new_buffer(device, activation_bytes) else { return 1; }; let output_owner: OwnedObjc = OwnedObjc::new(output.raw());
    let query_values: *f32 = query.contents() as *f32;
    let key_values: *f32 = key.contents() as *f32;
    let value_values: *f32 = value.contents() as *f32;
    var index: usize = 0 as usize;
    while index < rows *% WIDTH {
        query_values[index] = ((index % (251 as usize)) as f32 - 125.0f32) / 512.0f32;
        key_values[index] = ((index % (239 as usize)) as f32 - 119.0f32) / 512.0f32;
        value_values[index] = ((index % (233 as usize)) as f32 - 116.0f32) / 256.0f32;
        index = index +% (1 as usize);
    }
    guard let option::Option[metal::Buffer]::Some(image_ids) = new_buffer(device, (rows *% #size_of::[i32]()) as u64) else { return 1; }; let image_ids_owner: OwnedObjc = OwnedObjc::new(image_ids.raw());
    guard let option::Option[metal::Buffer]::Some(key_valid) = new_buffer(device, rows as u64) else { return 1; }; let key_valid_owner: OwnedObjc = OwnedObjc::new(key_valid.raw());
    index = 0 as usize;
    while index < rows { (image_ids.contents() as *i32)[index] = 0; (key_valid.contents())[index] = 1 as u8; index = index +% (1 as usize); }
    guard let option::Option[f64]::Some(gpu_ms) = dispatch_attention(
        queue, attention_pipeline, query, key, output, value, image_ids, key_valid,
        rows, rows, key, value, 0 as u64,
    ) else { return 1; };
    if !finite("attention benchmark output", output, rows *% WIDTH) { return 1; }
    let temporary_bytes: u64 = (4 as u64) *% activation_bytes;
    let avoided_score_bytes: u64 = rows as u64 *% rows as u64 *% HEADS as u64 *% (4 as u64);
    io::println("tiled attention benchmark: tokens=${rows} gpu_ms=${gpu_ms} activation_bytes=${temporary_bytes} avoided_score_bytes=${avoided_score_bytes}");
    return 0;
}

#[test]
fn block_dimensions_match_pinned_model() {
    assert HEADS *% HEAD_DIMENSION == WIDTH;
    assert MLP_WIDTH == WIDTH *% (3 as usize);
    assert ROWS == (4 as usize);
}

#[test]
fn rectangular_rope_uses_independent_height_and_width_coordinates() {
    var rope: [f32; 1024] = [0.0f32; 1024];
    assert fill_target_rope(#addr_of(rope[0]), 0 as usize, 2 as usize, 4 as usize);
    // Row 0 is at (-1, -2); row 4 is at (0, -2). The first frequency
    // of each spatial axis is 1, so these entries expose the coordinates.
    assert (rope[8] - (-1.0f32).cos()).abs() < 0.000001f32;
    assert (rope[(4 as usize) *% HEAD_DIMENSION +% (8 as usize)] - 1.0f32).abs()
        < 0.000001f32;
    assert (rope[36] - (-2.0f32).cos()).abs() < 0.000001f32;
    assert (rope[HEAD_DIMENSION +% (36 as usize)] - (-1.0f32).cos()).abs()
        < 0.000001f32;
}

#[test]
fn tile_rounding_covers_model_width() {
    assert round_up(WIDTH, OUTPUT_TILE) == WIDTH;
    assert round_up(ROWS, OUTPUT_TILE) == (32 as usize);
    assert round_up((278 as usize), OUTPUT_TILE) == (288 as usize);
    assert round_up((256 as usize), OUTPUT_TILE) == (256 as usize);
}
