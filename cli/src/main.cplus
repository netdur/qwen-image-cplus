// qwen-image-cplus: the command-line client over the public API.
//
// The same source builds on every platform. It speaks only to qwen_image/api
// (and pack_info for a pack's own defaults); qwen_image_runtime installs the
// platform's backend (Metal on macOS, CUDA on Linux). Backend development
// commands live in qwen_image_metal_dev and qwen_image_cuda_dev.

import "qwen_image/api" as qwen_image;
import "qwen_image/generation_control" as control;
import "qwen_image/pack_info" as pack_info;
import "qwen_image_runtime/runtime" as runtime;
import "stdlib/env" as env;
import "stdlib/io" as io;
import "stdlib/option" as option;
import "stdlib/status" as status;
import "stdlib/text" as text;
import "stdlib/vec" as vec;

const USAGE: str = "usage: qwen-image-cplus <command>\n  generate PACKED MODEL_DIR OUTPUT PROMPT WIDTH HEIGHT [SEED] [3|4|6|8|25|40]\n  generate-multi-image-sized PACKED MODEL_DIR OUTPUT PROMPT SEED pack|3|4|6|8|25|40 WIDTH HEIGHT IMAGE [IMAGE ... up to 10]\n  generate-multi-image-512|generate-multi-image-1024 PACKED MODEL_DIR OUTPUT PROMPT SEED pack|3|4|6|8|25|40 IMAGE [IMAGE ... up to 10]\n  info PACKED";

fn parse_u64_decimal(value: str) -> option::Option[u64] {
    if value.count() == (0 as usize) { return option::Option[u64]::None; }
    var result: u64 = 0 as u64;
    var index: usize = 0 as usize;
    while index < value.count() {
        guard let option::Option[u8]::Some(byte) = value.byte_at(index) else {
            return option::Option[u64]::None;
        };
        if byte < (48 as u8) || byte > (57 as u8) {
            return option::Option[u64]::None;
        }
        let digit: u64 = (byte -% (48 as u8)) as u64;
        if result > ((18446744073709551615 as u64) -% digit) / (10 as u64) {
            return option::Option[u64]::None;
        }
        result = result *% (10 as u64) +% digit;
        index = index +% (1 as usize);
    }
    return option::Option[u64]::Some(result);
}

#[test]
fn decimal_seed_parser_checks_syntax_and_overflow() {
    guard let option::Option[u64]::Some(zero) = parse_u64_decimal("0") else {
        assert false;
        return;
    };
    guard let option::Option[u64]::Some(seed) = parse_u64_decimal("1101") else {
        assert false;
        return;
    };
    guard let option::Option[u64]::Some(maximum) = parse_u64_decimal("18446744073709551615") else {
        assert false;
        return;
    };
    assert zero == (0 as u64);
    assert seed == (1101 as u64);
    assert maximum == (18446744073709551615 as u64);
    match parse_u64_decimal("") {
        option::Option[u64]::None => {}
        option::Option[u64]::Some(_) => { assert false; }
    }
    match parse_u64_decimal("-1") {
        option::Option[u64]::None => {}
        option::Option[u64]::Some(_) => { assert false; }
    }
    match parse_u64_decimal("18446744073709551616") {
        option::Option[u64]::None => {}
        option::Option[u64]::Some(_) => { assert false; }
    }
}

// The step counts the API accepts.
fn supported_steps(value: str) -> option::Option[str] {
    if value == "3" { return option::Option[str]::Some("3"); }
    if value == "4" { return option::Option[str]::Some("4"); }
    if value == "6" { return option::Option[str]::Some("6"); }
    if value == "8" { return option::Option[str]::Some("8"); }
    if value == "25" { return option::Option[str]::Some("25"); }
    if value == "40" { return option::Option[str]::Some("40"); }
    return option::Option[str]::None;
}

// Step count a pack's metadata asks for. Packs without a `steps` key keep the
// canonical 40. A count the API cannot run is refused (None) rather than
// replaced, because 40 steps of a few-step distill produce a wrong image.
fn pack_default_steps(packed_path: str) -> option::Option[str] {
    match pack_info::read(packed_path) {
        option::Option[pack_info::PackInfo]::Some(info) => {
            match info.get("steps") {
                option::Option[str]::Some(value) => {
                    match supported_steps(value) {
                        option::Option[str]::Some(steps) => { return option::Option[str]::Some(steps); }
                        option::Option[str]::None => {
                            io::eprintln("pack metadata: steps=${value} is not supported; pass an explicit step count");
                            return option::Option[str]::None;
                        }
                    }
                }
                option::Option[str]::None => {}
            }
        }
        option::Option[pack_info::PackInfo]::None => {}
    }
    return option::Option[str]::Some("40");
}

fn pack_is_distilled(packed_path: str) -> bool {
    return match pack_info::read(packed_path) {
        option::Option[pack_info::PackInfo]::Some(info) => info.is_distilled(),
        option::Option[pack_info::PackInfo]::None => false,
    };
}

fn exit_code(result: qwen_image::GenerateStatus) -> i32 {
    return match result {
        qwen_image::GenerateStatus::Ok => 0,
        qwen_image::GenerateStatus::InvalidArgument => { io::eprintln("generation: invalid arguments"); 2 },
        qwen_image::GenerateStatus::Failed => { io::eprintln("generation: failed"); 1 },
        qwen_image::GenerateStatus::Cancelled => 130,
    };
}

// Diagnostics from the engine go to stderr.
fn print_diagnostic(message: str, context: *u8) {
    io::eprintln(message);
}

fn observer() -> control::Observer {
    return control::Observer {
        callback: 0 as fn(control::Progress, *u8) -> bool,
        diagnostic: print_diagnostic,
        context: 0 as *u8,
    };
}

fn generate() -> i32 {
    let usage: str = "usage: qwen-image-cplus generate PACKED MODEL_DIR OUTPUT PROMPT WIDTH HEIGHT [SEED] [3|4|6|8|25|40]";
    guard let option::Option[text::Text]::Some(packed_path) = env::arg(2 as usize) else { io::eprintln(usage); return 2; };
    guard let option::Option[text::Text]::Some(model_path) = env::arg(3 as usize) else { io::eprintln(usage); return 2; };
    guard let option::Option[text::Text]::Some(output_path) = env::arg(4 as usize) else { io::eprintln(usage); return 2; };
    guard let option::Option[text::Text]::Some(prompt) = env::arg(5 as usize) else { io::eprintln(usage); return 2; };
    guard let option::Option[text::Text]::Some(width_text) = env::arg(6 as usize) else { io::eprintln(usage); return 2; };
    guard let option::Option[text::Text]::Some(height_text) = env::arg(7 as usize) else { io::eprintln(usage); return 2; };
    guard let option::Option[u64]::Some(width) = parse_u64_decimal(width_text.view()) else {
        io::eprintln("generate: width must be an unsigned decimal integer"); return 2;
    };
    guard let option::Option[u64]::Some(height) = parse_u64_decimal(height_text.view()) else {
        io::eprintln("generate: height must be an unsigned decimal integer"); return 2;
    };
    var seed: u64 = 1101 as u64;
    match env::arg(8 as usize) {
        option::Option[text::Text]::Some(seed_text) => {
            guard let option::Option[u64]::Some(parsed) = parse_u64_decimal(seed_text.view()) else {
                io::eprintln("generate: seed must be an unsigned decimal integer"); return 2;
            };
            seed = parsed;
        }
        option::Option[text::Text]::None => {}
    }
    guard let option::Option[str]::Some(pack_steps) = pack_default_steps(packed_path.view()) else { return 2; };
    var steps: str = pack_steps;
    match env::arg(9 as usize) {
        option::Option[text::Text]::Some(steps_text) => {
            guard let option::Option[str]::Some(requested) = supported_steps(steps_text.view()) else {
                io::eprintln("generate: steps must be 3, 4, 6, 8, 25, or 40"); return 2;
            };
            steps = requested;
        }
        option::Option[text::Text]::None => {}
    }
    guard let option::Option[u64]::Some(step_count) = parse_u64_decimal(steps) else { return 2; };
    io::println("generate: output=${width}x${height} steps=${steps}");
    return exit_code(qwen_image::generate_to_png(qwen_image::GenerateRequest {
        packed_path: packed_path.view(),
        model_root: model_path.view(),
        output_path: output_path.view(),
        prompt: prompt.view(),
        pixels: 0 as usize,
        steps: step_count as usize,
        seed: seed,
        cache: qwen_image::CacheMode::None,
        cache_threshold: 0.0f64,
        width: width as usize,
        height: height as usize,
    }, observer()));
}

// generate-multi-image-sized, and the fixed-size 512 / 1024 forms.
fn generate_multi_image(command: str) -> i32 {
    let sized: bool = command == "generate-multi-image-sized";
    let resolution: usize = if command == "generate-multi-image-1024" { 1024 as usize } else { 512 as usize };
    let usage: text::Text = if sized {
        text::from_str("usage: qwen-image-cplus generate-multi-image-sized PACKED MODEL_DIR OUTPUT PROMPT SEED pack|3|4|6|8|25|40 WIDTH HEIGHT IMAGE [IMAGE ... up to 10]")
    } else {
        "usage: qwen-image-cplus ${command} PACKED MODEL_DIR OUTPUT PROMPT SEED pack|3|4|6|8|25|40 IMAGE [IMAGE ... up to 10]"
    };
    guard let option::Option[text::Text]::Some(packed_path) = env::arg(2 as usize) else { io::eprintln(usage.view()); return 2; };
    guard let option::Option[text::Text]::Some(model_path) = env::arg(3 as usize) else { io::eprintln(usage.view()); return 2; };
    guard let option::Option[text::Text]::Some(output_path) = env::arg(4 as usize) else { io::eprintln(usage.view()); return 2; };
    guard let option::Option[text::Text]::Some(prompt) = env::arg(5 as usize) else { io::eprintln(usage.view()); return 2; };
    guard let option::Option[text::Text]::Some(seed_text) = env::arg(6 as usize) else { io::eprintln(usage.view()); return 2; };
    guard let option::Option[u64]::Some(seed) = parse_u64_decimal(seed_text.view()) else {
        io::eprintln("${command}: seed must be an unsigned decimal integer"); return 2;
    };
    guard let option::Option[text::Text]::Some(steps_text) = env::arg(7 as usize) else { io::eprintln(usage.view()); return 2; };
    // `pack` takes the step count from the pack metadata.
    guard let option::Option[str]::Some(pack_steps) = pack_default_steps(packed_path.view()) else { return 2; };
    let requested: str = if steps_text == "pack" { pack_steps } else { steps_text.view() };
    guard let option::Option[str]::Some(steps) = supported_steps(requested) else { io::eprintln(usage.view()); return 2; };
    if pack_is_distilled(packed_path.view()) && steps != pack_steps {
        io::println("${command}: pack kind=distilled steps=${pack_steps}; running the requested ${steps} steps");
    }
    var width: usize = resolution;
    var height: usize = resolution;
    let image_offset: usize = if sized { 10 as usize } else { 8 as usize };
    if sized {
        guard let option::Option[text::Text]::Some(width_text) = env::arg(8 as usize) else { io::eprintln(usage.view()); return 2; };
        guard let option::Option[text::Text]::Some(height_text) = env::arg(9 as usize) else { io::eprintln(usage.view()); return 2; };
        guard let option::Option[u64]::Some(width_value) = parse_u64_decimal(width_text.view()) else { return 2; };
        guard let option::Option[u64]::Some(height_value) = parse_u64_decimal(height_text.view()) else { return 2; };
        width = width_value as usize;
        height = height_value as usize;
    }
    if env::argc() < image_offset { io::eprintln(usage.view()); return 2; }
    let image_count: usize = env::argc() -% image_offset;
    if image_count < (1 as usize) || image_count > (10 as usize) {
        io::eprintln("${command}: provide 1 through 10 image paths");
        return 2;
    }
    var owners: vec::Vec[text::Text] = vec::Vec[text::Text]::with_capacity(image_count);
    var index: usize = 0 as usize;
    while index < image_count {
        guard let option::Option[text::Text]::Some(path) = env::arg(image_offset +% index) else { io::eprintln(usage.view()); return 2; };
        if owners.append(path) != status::Status::Ok { return 1; }
        index = index +% (1 as usize);
    }
    var image_paths: [str; 10] = ["", "", "", "", "", "", "", "", "", ""];
    let owner_values: *text::Text = #slice_ptr(owners.as_slice());
    index = 0 as usize;
    while index < image_count {
        image_paths[index] = owner_values[index].view();
        index = index +% (1 as usize);
    }
    guard let option::Option[u64]::Some(step_count) = parse_u64_decimal(steps) else { return 2; };
    if sized {
        return exit_code(qwen_image::generate_multi_image_sized_to_png(qwen_image::MultiImageSizedGenerateRequest {
            packed_path: packed_path.view(),
            model_root: model_path.view(),
            output_path: output_path.view(),
            prompt: prompt.view(),
            image_paths: #addr_of(image_paths[0]),
            image_count: image_count,
            width: width,
            height: height,
            steps: step_count as usize,
            seed: seed,
        }, observer()));
    }
    return exit_code(qwen_image::generate_multi_image_to_png(qwen_image::MultiImageGenerateRequest {
        packed_path: packed_path.view(),
        model_root: model_path.view(),
        output_path: output_path.view(),
        prompt: prompt.view(),
        image_paths: #addr_of(image_paths[0]),
        image_count: image_count,
        pixels: resolution,
        steps: step_count as usize,
        seed: seed,
    }, observer()));
}

// Prints a pack's policy and metadata.
fn info() -> i32 {
    guard let option::Option[text::Text]::Some(packed_path) = env::arg(2 as usize) else {
        io::eprintln("usage: qwen-image-cplus info PACKED");
        return 2;
    };
    guard let option::Option[pack_info::PackInfo]::Some(pack) = pack_info::read(packed_path.view()) else {
        io::eprintln("info: ${packed_path.view()} is not a readable QIPACK");
        return 1;
    };
    io::println("policy=${pack.policy.view()}");
    var index: usize = 0 as usize;
    while index < pack.entries.count() {
        guard let option::Option[*pack_info::Entry]::Some(entry) = pack.entries.at_ptr(index) else { return 1; };
        io::println("${(*entry).key.view()}=${(*entry).value.view()}");
        index = index +% (1 as usize);
    }
    return 0;
}

fn main() -> i32 {
    guard let option::Option[text::Text]::Some(command) = env::arg(1 as usize) else {
        io::println(USAGE);
        return 0;
    };
    runtime::install();
    let name: str = command.view();
    if name == "generate" { return generate(); }
    if name == "generate-multi-image-sized" || name == "generate-multi-image-512" || name == "generate-multi-image-1024" {
        return generate_multi_image(name);
    }
    if name == "info" { return info(); }
    io::eprintln("unknown command: ${name}");
    io::eprintln(USAGE);
    return 2;
}
