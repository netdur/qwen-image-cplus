            option::Option[text::Text]::None => {
                return tokenizer::run(model_path.view());
            }
        }
    }
    if command == "test-multi-image-prompt" {
        guard let option::Option[text::Text]::Some(model_path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus test-multi-image-prompt MODEL_DIR");
            return 2;
        };
        if !image_conditioning::reference_count_supported(2 as usize) { return 1; }
        return tokenizer::test_multi_image_prompt(model_path.view());
    }
    if command == "test-image-input" {
        guard let option::Option[text::Text]::Some(source_path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus test-image-input SOURCE_OUTPUT");
            return 2;
        };
        return image_input::run_reference(source_path.view());
    }
    if command == "test-vae-encoder" {
        guard let option::Option[text::Text]::Some(model_path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus test-vae-encoder MODEL_DIR IMAGE");
            return 2;
        };
        guard let option::Option[text::Text]::Some(image_path) = env::arg(3 as usize) else {
            io::eprintln("usage: qwen-image-cplus test-vae-encoder MODEL_DIR IMAGE [32|512]");
            return 2;
        };
        let output_resolution: usize = match env::arg(4 as usize) {
            option::Option[text::Text]::Some(value) => {
                guard let option::Option[u64]::Some(parsed) = parse_u64_decimal(value.view())
                    else {
                    io::eprintln("usage: qwen-image-cplus test-vae-encoder MODEL_DIR IMAGE [32|512]");
                    return 2;
                };
                if parsed != (32 as u64) && parsed != (512 as u64) {
                    io::eprintln("VAE encoder test resolution must be 32 or 512");
                    return 2;
                }
                parsed as usize
            }
            option::Option[text::Text]::None => { 512 as usize }
        };
        guard let option::Option[image_input::Image]::Some(input_image) =
            image_input::load_resized(image_path.view(), output_resolution) else {
            io::eprintln("VAE encoder test: could not load ${image_path}");
            return 1;
        };
        let latent_values: usize = input_image.shape.latent_tokens *% (64 as usize);
        var latent: vec::Vec[f32] = vec::Vec[f32]::with_capacity(latent_values);
        var latent_index: usize = 0 as usize;
        while latent_index < latent_values {
            if latent.append(0.0f32) != status::Status::Ok { return 1; }
            latent_index = latent_index +% (1 as usize);
        }
        let encode_status: i32 = vae::encode_sized_from_host(
            model_path.view(),
            #slice_ptr(input_image.vae_pixels.as_slice()),
            input_image.shape.width,
            input_image.shape.height,
            #slice_ptr(latent.as_slice()),
        );
        if encode_status != (0 as i32) { return encode_status; }
        let latent_pointer: *f32 = #slice_ptr(latent.as_slice());
        var latent_min: f32 = latent_pointer[0];
        var latent_max: f32 = latent_pointer[0];
        var latent_abs_sum: f64 = 0.0f64;
        latent_index = 0 as usize;
        while latent_index < latent_values {
            let value: f32 = latent_pointer[latent_index];
            if value < latent_min { latent_min = value; }
            if value > latent_max { latent_max = value; }
            latent_abs_sum = latent_abs_sum + (value as f64).abs();
            latent_index = latent_index +% (1 as usize);
        }
        if latent_max - latent_min < 0.000001f32 || latent_abs_sum < 0.000001f64 {
            io::eprintln("VAE condition encoding: degenerate latent output");
            return 1;
        }
        io::println(
            "VAE condition encoding: output_resolution=${output_resolution} image=${input_image.shape.width}x${input_image.shape.height} latent_tokens=${input_image.shape.latent_tokens} values=${latent_values} min=${latent_min} max=${latent_max} mean_abs=${latent_abs_sum / latent_values as f64} finite_nonzero=verified",
        );
        return 0;
    }
    if command == "test-vision-encoder" {
        guard let option::Option[text::Text]::Some(model_path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus test-vision-encoder MODEL_DIR IMAGE [32|512]");
            return 2;
        };
        guard let option::Option[text::Text]::Some(image_path) = env::arg(3 as usize) else {
            io::eprintln("usage: qwen-image-cplus test-vision-encoder MODEL_DIR IMAGE [32|512]");
            return 2;
        };
        let output_resolution: usize = match env::arg(4 as usize) {
            option::Option[text::Text]::Some(value) => {
                guard let option::Option[u64]::Some(parsed) = parse_u64_decimal(value.view())
                    else { return 2; };
                if parsed != (32 as u64) && parsed != (512 as u64) {
                    io::eprintln("vision encoder test resolution must be 32 or 512");
                    return 2;
                }
                parsed as usize
            }
            option::Option[text::Text]::None => { 512 as usize }
        };
        guard let option::Option[image_input::Image]::Some(input_image) =
            image_input::load_resized(image_path.view(), output_resolution) else {
            io::eprintln("vision encoder test: could not load ${image_path}");
            return 1;
        };
        let output_values: usize = input_image.shape.vision_tokens *% (4096 as usize);
        var visual: vec::Vec[f32] = vec::Vec[f32]::with_capacity(output_values);
        var deepstack: vec::Vec[f32] = vec::Vec[f32]::with_capacity(
            output_values *% (3 as usize),
        );
        var index: usize = 0 as usize;
        while index < output_values {
            if visual.append(0.0f32) != status::Status::Ok { return 1; }
            index = index +% (1 as usize);
        }
        index = 0 as usize;
        while index < output_values *% (3 as usize) {
            if deepstack.append(0.0f32) != status::Status::Ok { return 1; }
            index = index +% (1 as usize);
        }
        let encode_status: i32 = qwen3vl_vision::encode_sized_to_host(
            model_path.view(), #slice_ptr(input_image.vision_pixels.as_slice()),
            input_image.shape.width, input_image.shape.height,
            #slice_ptr(visual.as_slice()), #slice_ptr(deepstack.as_slice()),
        );
        if encode_status != (0 as i32) { return encode_status; }
        let visual_pointer: *f32 = #slice_ptr(visual.as_slice());
        var minimum: f32 = visual_pointer[0];
        var maximum: f32 = visual_pointer[0];
        var mean_abs: f64 = 0.0f64;
        index = 0 as usize;
        while index < output_values {
            let value: f32 = visual_pointer[index];
            if value < minimum { minimum = value; }
            if value > maximum { maximum = value; }
            mean_abs = mean_abs + (value as f64).abs();
            index = index +% (1 as usize);
        }
        if maximum - minimum < 0.000001f32 || mean_abs < 0.000001f64 {
            io::eprintln("vision encoder: degenerate merged output");
            return 1;
        }
        io::println(
            "vision condition encoding: output_resolution=${output_resolution} image=${input_image.shape.width}x${input_image.shape.height} tokens=${input_image.shape.vision_tokens} values=${output_values} min=${minimum} max=${maximum} mean_abs=${mean_abs / output_values as f64} finite_nonzero=verified",
        );
        return 0;
    }
    if command == "test-vision-encoder-oracle" {
        guard let option::Option[text::Text]::Some(model_path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus test-vision-encoder-oracle MODEL_DIR [FIXTURE_DIR]");
