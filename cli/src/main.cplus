    }
    if command == "benchmark-attention" {
        return transformer_block::benchmark_attention();
    }
    if command == "benchmark-production-attention" {
        match env::arg(2 as usize) {
            option::Option[text::Text]::Some(pixels) => {
                return transformer_block::benchmark_production_attention(pixels.view());
            }
            option::Option[text::Text]::None => {
                return transformer_block::benchmark_production_attention();
            }
        }
    }
    if command == "benchmark-transformer-small-kernels" {
        return transformer_block::benchmark_transformer_small_kernels();
    }
    if command == "benchmark-transformer-gemm" {
        guard let option::Option[text::Text]::Some(path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus benchmark-transformer-gemm PACKED");
