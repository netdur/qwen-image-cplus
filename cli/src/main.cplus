fn parse_u64_decimal(value: str) -> option::Option[u64] {
    if value.count() == (0 as usize) { return option::Option[u64]::None; }
    var result: u64 = 0 as u64;
    var index: usize = 0 as usize;
    while index < value.count() {
        guard let option::Option[u8]::Some(byte) = value.byte_at(index) else {
            return option::Option[u64]::None;
        };
        if byte < (48 as u8) || byte > (57 as u8) {
            return option::Option[u64]::None;
        }
        let digit: u64 = (byte -% (48 as u8)) as u64;
        if result > ((18446744073709551615 as u64) -% digit) / (10 as u64) {
            return option::Option[u64]::None;
        }
        result = result *% (10 as u64) +% digit;
        index = index +% (1 as usize);
    }
    return option::Option[u64]::Some(result);
}

fn parse_cache_dit_threshold(value: str) -> option::Option[f64] {
    if value == "0.12" { return option::Option[f64]::Some(0.12f64); }
    if value == "0.14" { return option::Option[f64]::Some(0.14f64); }
    if value == "0.16" { return option::Option[f64]::Some(0.16f64); }
    if value == "0.24" { return option::Option[f64]::Some(0.24f64); }
    return option::Option[f64]::None;
}

fn _run_generation(
    packed_path: str,
    model_root: str,
    output_path: str,
    prompt: str,
    pixels: usize,
    steps: str,
    seed: u64,
    cache: qwen_image::CacheMode,
    cache_threshold: f64,
    width: usize = 0 as usize,
    height: usize = 0 as usize,
) -> i32 {
    guard let option::Option[u64]::Some(step_count) = parse_u64_decimal(steps) else {
        return 2;
    };
    let request: qwen_image::GenerateRequest = qwen_image::GenerateRequest {
        packed_path: packed_path,
        model_root: model_root,
        output_path: output_path,
        prompt: prompt,
        pixels: pixels,
        steps: step_count as usize,
        seed: seed,
        cache: cache,
        cache_threshold: cache_threshold,
        width: width,
        height: height,
    };
    return match qwen_image::generate_to_png(request) {
        qwen_image::GenerateStatus::Ok => 0,
        qwen_image::GenerateStatus::InvalidArgument => 2,
        qwen_image::GenerateStatus::Failed => 1,
    };
}

#[test]
fn decimal_seed_parser_checks_syntax_and_overflow() {
    guard let option::Option[u64]::Some(zero) = parse_u64_decimal("0") else {
        assert false;
        return;
    };
    guard let option::Option[u64]::Some(seed) = parse_u64_decimal("1101") else {
        assert false;
        return;
    };
    guard let option::Option[u64]::Some(maximum) = parse_u64_decimal("18446744073709551615") else {
        assert false;
        return;
    };
    assert zero == (0 as u64);
    assert seed == (1101 as u64);
    assert maximum == (18446744073709551615 as u64);
    match parse_u64_decimal("") {
        option::Option[u64]::None => {}
        option::Option[u64]::Some(_) => { assert false; }
    }
    match parse_u64_decimal("-1") {
        option::Option[u64]::None => {}
        option::Option[u64]::Some(_) => { assert false; }
    }
    match parse_u64_decimal("18446744073709551616") {
        option::Option[u64]::None => {}
        option::Option[u64]::Some(_) => { assert false; }
    }
}

#[test]
fn cache_dit_threshold_parser_accepts_calibration_candidates() {
    guard let option::Option[f64]::Some(low) = parse_cache_dit_threshold("0.12") else {
        assert false;
        return;
    };
    guard let option::Option[f64]::Some(middle_low) = parse_cache_dit_threshold("0.14") else {
        assert false;
        return;
    };
    guard let option::Option[f64]::Some(middle_high) = parse_cache_dit_threshold("0.16") else {
        assert false;
        return;
    };
    guard let option::Option[f64]::Some(high) = parse_cache_dit_threshold("0.24") else {
        assert false;
        return;
    };
    assert low == 0.12f64;
    assert middle_low == 0.14f64;
    assert middle_high == 0.16f64;
    assert high == 0.24f64;
    match parse_cache_dit_threshold("0.15") {
        option::Option[f64]::None => {}
        option::Option[f64]::Some(_) => { assert false; }
    }
}

// Step count a pack's metadata asks for, limited to the counts this command
// supports. Packs without a `steps` key keep the canonical 40. A step count
// the command cannot run is refused (None) rather than replaced, because
// silently running 40 steps of a few-step distill produces a wrong image.
fn pack_default_steps(packed_path: str, allowed: [str; 5]) -> option::Option[str] {
    match packed_model::read_metadata(packed_path) {
        packed_model::MetadataResult::Ok(metadata) => {
            match metadata.get("steps") {
                option::Option[str]::Some(value) => {
                    var index: usize = 0 as usize;
                    while index < (5 as usize) {
                        if allowed[index] == value { return option::Option[str]::Some(allowed[index]); }
                        index = index +% (1 as usize);
                    }
                    io::eprintln("pack metadata: steps=${value} is not supported by this command; pass an explicit step count");
                    return option::Option[str]::None;
                }
                option::Option[str]::None => {}
            }
        }
        packed_model::MetadataResult::Err(_message) => {}
    }
    return option::Option[str]::Some("40");
}

// Commands that fix their own step count and schedule. A kind=distilled pack
// defines both through its metadata, which only generate-1024 honours.
fn command_ignores_pack_steps(command: str) -> bool {
    return command == "generate-256" || command == "generate-256-cache-dit"
        || command == "generate-256-bottleneck" || command == "generate-1024-bottleneck"
        || command == "test-pipeline-256" || command == "test-pipeline-cache-dit-256"
        || command == "test-native-pipeline-256" || command == "test-pipeline-1024-oracle"
        || command == "test-pipeline-cache-dit-1024-oracle"
        || command == "benchmark-process-reuse-256";
}

// Cache policy for generate-1024: an explicit argument wins, otherwise the
// pack's `cache` key, otherwise none.
fn pack_cache_policy(packed_path: str) -> str {
    match packed_model::read_metadata(packed_path) {
        packed_model::MetadataResult::Ok(metadata) => {
            match metadata.get("cache") {
                option::Option[str]::Some(value) => {
                    if value == "taylorseer" { return "taylorseer"; }
                    if value == "cache-dit-0.16" { return "cache-dit-0.16"; }
                }
                option::Option[str]::None => {}
            }
        }
        packed_model::MetadataResult::Err(_message) => {}
    }
    return "none";
}

fn pack_is_distilled(packed_path: str) -> bool {
    return match packed_model::read_metadata(packed_path) {
        packed_model::MetadataResult::Ok(metadata) => packed_model::metadata_is_distilled(metadata),
        packed_model::MetadataResult::Err(_message) => false,
    };
}

fn main() -> i32 {
    if env::argc() < (2 as usize) {
        io::println(
            "usage: qwen-image-cplus <generate PACKED MODEL_DIR OUTPUT PROMPT WIDTH HEIGHT [SEED] [3|4|8|25|40] | probe | probe-stress | test-metal-primitives | test-metal-linear | benchmark-linear | test-metal-int8-linear | benchmark-int8-linear | probe-metal-q4-integer | test-metal-q4-dot | benchmark-metal-q4-dot | benchmark-q4-eager-1024 Q4_PACKED MODEL_DIR OUTPUT PROMPT [SEED] [1|25|40] | benchmark-q4-inference-1024 Q4_PACKED MODEL_DIR OUTPUT PROMPT [SEED] [1|25|40] | benchmark-q4-direct-1024 Q4_PACKED MODEL_DIR OUTPUT PROMPT [SEED] [1|25|40] | test-attention-cache [FIXTURE_DIR] | benchmark-attention | benchmark-production-attention [256|1024] | benchmark-transformer-small-kernels | benchmark-transformer-gemm PACKED | benchmark-mps-gemm PACKED | benchmark-transformer-trajectory-1024 PACKED 1|2|3|4|8|13|25|40 [FIXTURE_ROOT] | benchmark-transformer-trajectory-2048 PACKED [FIXTURE_ROOT] | benchmark-process-reuse-256 PACKED MODEL_DIR OUTPUT PROMPT 0.12|0.24 REQUESTS [SEED] | test-native-inputs [FIXTURE_DIR] | test-transformer-block MODEL_DIR [FIXTURE_DIR] | test-transformer-block-int8 PACKED [FIXTURE_DIR] | test-transformer-mixed PACKED [FIXTURE_DIR] | test-transformer-complete PACKED [FIXTURE_DIR] | test-transformer-scale PACKED 256|512|1024 [FIXTURE_ROOT] | test-transformer-trajectory PACKED 1|2|40 [FIXTURE_DIR] | test-transformer-trajectory-1024 PACKED 1|2|40 FIXTURE_DIR | test-transformer-cache-dit PACKED 0.12|0.24 [FIXTURE_DIR] | test-transformer-cache-dit-1024 PACKED 0.12|0.24 FIXTURE_DIR | test-transformer-taylorseer PACKED 0.12|0.24 [FIXTURE_DIR] | test-transformer-bottleneck PACKED [FIXTURE_DIR] | test-vae-decoder MODEL_DIR small|256|1024|1024-profile|2048|trajectory-1024 [FIXTURE_ROOT] | test-image-output OUTPUT [FIXTURE_DIR] | test-image-input SOURCE_OUTPUT | test-vae-encoder MODEL_DIR IMAGE [32|512] | test-vision-encoder MODEL_DIR IMAGE [32|512] | test-vision-encoder-oracle MODEL_DIR [FIXTURE_DIR] | test-pipeline-256 PACKED MODEL_DIR OUTPUT | test-pipeline-1024-oracle PACKED MODEL_DIR OUTPUT TRAJECTORY_FIXTURE VAE_FIXTURE_ROOT | test-pipeline-cache-dit-256 PACKED MODEL_DIR OUTPUT 0.12|0.24 | test-pipeline-cache-dit-1024-oracle PACKED MODEL_DIR OUTPUT 0.12|0.24 TRAJECTORY_FIXTURE VAE_FIXTURE_ROOT | test-native-pipeline-256 PACKED MODEL_DIR OUTPUT | generate-256 PACKED MODEL_DIR OUTPUT PROMPT [SEED] [25|40] | generate-256-cache-dit PACKED MODEL_DIR OUTPUT PROMPT 0.12|0.24 [SEED] [25|40] | generate-256-bottleneck PACKED MODEL_DIR OUTPUT PROMPT [SEED] | generate-1024 PACKED MODEL_DIR OUTPUT PROMPT [SEED] [3|4|8|25|40] [none|taylorseer|cache-dit-0.16] | generate-1024-cache-dit PACKED MODEL_DIR OUTPUT PROMPT 0.12|0.24 [SEED] [4|25|40] | generate-1024-taylorseer PACKED MODEL_DIR OUTPUT PROMPT 0.12|0.24 [SEED] [4|25|40] | generate-1024-bottleneck PACKED MODEL_DIR OUTPUT PROMPT [SEED] | test-tokenizer MODEL_DIR [FIXTURE_DIR] | test-multi-image-prompt MODEL_DIR | test-text-encoder MODEL_DIR | quantize-block0 MODEL_DIR OUTPUT | quantize-transformer MODEL_DIR OUTPUT | quantize-transformer-q4 MODEL_DIR OUTPUT | verify-packed FILE | verify-packed-source FILE MODEL_DIR | pack-metadata FILE [key=value ...] | inspect FILE | verify-model MODEL_DIR>",
        );
        return 0;
    }

    guard let option::Option[text::Text]::Some(command) = env::arg(1 as usize) else {
        io::eprintln("missing command");
        return 2;
    };

    // QI_PROFILE_SKIP omits transformer work, so it is only meaningful for the
    // transformer-only benchmarks. Refuse it before any image-producing command
    // spends time on the text encoder (the trajectory refuses it again).
    let command_name: str = command.view();
    if env::has_var("QI_PROFILE_SKIP") && (command_name.has_prefix("generate-")
        || command_name.contains("pipeline") || command_name.has_prefix("benchmark-q4-")
        || command_name.has_prefix("benchmark-process-reuse")) {
        io::eprintln("${command}: QI_PROFILE_SKIP is a benchmark-only ablation that omits transformer work; unset it to generate");
        return 2;
    }

    if command_ignores_pack_steps(command_name) {
        match env::arg(2 as usize) {
            option::Option[text::Text]::Some(packed_path) => {
                if pack_is_distilled(packed_path.view()) {
                    io::eprintln("${command}: kind=distilled packs define their own steps and schedule; use generate-1024");
                    return 2;
                }
            }
            option::Option[text::Text]::None => {}
        }
    }

    if command == "probe" {
        return metal_probe::run();
    }
    if command == "probe-stress" {
        return metal_probe::stress();
    }
    if command == "test-metal-primitives" {
        return metal_primitives::run();
    }
    if command == "test-metal-linear" {
        return metal_linear::run_validation();
    }
    if command == "benchmark-linear" {
        return metal_linear::run_benchmark();
    }
    if command == "test-metal-int8-linear" {
        return metal_int8_linear::run_validation();
    }
    if command == "benchmark-int8-linear" {
        return metal_int8_linear::run_benchmark();
    }
    if command == "probe-metal-q4-integer" {
        return metal_q4_dot::run_integer_probe();
    }
    if command == "test-metal-q4-dot" {
        return metal_q4_dot::run_validation();
    }
    if command == "benchmark-metal-q4-dot" {
        return metal_q4_dot::run_benchmark();
    }
    if command == "test-attention-cache" {
        match env::arg(2 as usize) {
            option::Option[text::Text]::Some(fixtures) => {
                return transformer_block::test_attention_cache(fixtures.view());
            }
            option::Option[text::Text]::None => {
                return transformer_block::test_attention_cache();
