        || command == "benchmark-q4-direct-1024" {
        guard let option::Option[text::Text]::Some(packed_path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus generate-1024 PACKED MODEL_DIR OUTPUT PROMPT [SEED] [STEPS] [none|taylorseer|cache-dit-0.16]");
            return 2;
        };
        guard let option::Option[text::Text]::Some(model_path) = env::arg(3 as usize) else {
            io::eprintln("usage: qwen-image-cplus generate-1024 PACKED MODEL_DIR OUTPUT PROMPT [SEED] [STEPS] [none|taylorseer|cache-dit-0.16]");
            return 2;
        };
        guard let option::Option[text::Text]::Some(output_path) = env::arg(4 as usize) else {
            io::eprintln("usage: qwen-image-cplus generate-1024 PACKED MODEL_DIR OUTPUT PROMPT [SEED] [STEPS] [none|taylorseer|cache-dit-0.16]");
            return 2;
        };
        guard let option::Option[text::Text]::Some(prompt) = env::arg(5 as usize) else {
            io::eprintln("usage: qwen-image-cplus generate-1024 PACKED MODEL_DIR OUTPUT PROMPT [SEED] [STEPS] [none|taylorseer|cache-dit-0.16]");
            return 2;
        };
        var seed: u64 = 1101 as u64;
        match env::arg(6 as usize) {
            option::Option[text::Text]::Some(seed_text) => {
                guard let option::Option[u64]::Some(parsed) = parse_u64_decimal(seed_text.view()) else {
                    io::eprintln("generate-1024: seed must be an unsigned decimal integer");
                    return 2;
                };
                seed = parsed;
            }
            option::Option[text::Text]::None => {}
        }
        guard let option::Option[str]::Some(pack_steps) = if command == "generate-1024" {
            pack_default_steps(packed_path.view(), ["3", "4", "8", "25", "40"])
        } else { option::Option[str]::Some("40") } else { return 2; };
        var requested_steps: str = pack_steps;
        match env::arg(7 as usize) {
            option::Option[text::Text]::Some(steps_text) => {
                if steps_text == "1" && command != "generate-1024" {
                    requested_steps = "1";
                } else if (steps_text == "3" || steps_text == "4" || steps_text == "8")
                    && command == "generate-1024" {
                    // Few-step distillation; the pack's shift_terminal
                    // metadata selects its schedule.
                    requested_steps = if steps_text == "3" { "3" }
                    else if steps_text == "4" { "4" } else { "8" };
                } else if steps_text == "25" {
                    requested_steps = "25";
                } else if steps_text == "40" {
                    requested_steps = "40";
                } else {
                    io::eprintln("${command}: steps must be 3, 4, 8, 25, or 40 (Q4 benchmarks: 1, 25, or 40)");
                    return 2;
                }
            }
            option::Option[text::Text]::None => {}
        }
        if command == "benchmark-q4-eager-1024" {
            return pipeline::generate_1024_q4_speed(
                packed_path.view(), model_path.view(), output_path.view(), prompt.view(),
                true, false, seed, requested_steps,
            );
        }
        if command == "benchmark-q4-inference-1024" {
            return pipeline::generate_1024_q4_speed(
                packed_path.view(), model_path.view(), output_path.view(), prompt.view(),
                false, false, seed, requested_steps,
            );
        }
        if command == "benchmark-q4-direct-1024" {
            return pipeline::generate_1024_q4_speed(
                packed_path.view(), model_path.view(), output_path.view(), prompt.view(),
                false, true, seed, requested_steps,
            );
        }
        var cache_policy: str = pack_cache_policy(packed_path.view());
        let cache_from_pack: bool = cache_policy != "none";
        var cache_explicit: bool = false;
        match env::arg(8 as usize) {
            option::Option[text::Text]::Some(cache_text) => {
                cache_explicit = true;
                if cache_text == "none" {
                    cache_policy = "none";
                } else if cache_text == "taylorseer" {
                    cache_policy = "taylorseer";
                } else if cache_text == "cache-dit-0.16" {
                    cache_policy = "cache-dit-0.16";
                } else {
                    io::eprintln("generate-1024: cache must be none, taylorseer, or cache-dit-0.16");
                    return 2;
                }
            }
            option::Option[text::Text]::None => {}
        }
        if cache_policy != "none" {
            if pack_is_distilled(packed_path.view()) {
                io::eprintln("generate-1024: kind=distilled packs cannot use cache=${cache_policy}");
                return 2;
            }
            if requested_steps != "25" && requested_steps != "40" {
                io::eprintln("generate-1024: cache=${cache_policy} needs 25 or 40 steps");
                return 2;
            }
            // A pack's cache default is calibrated for its own step count;
            // other step counts must name the cache policy explicitly.
            if cache_from_pack && !cache_explicit && requested_steps != pack_steps {
                io::eprintln("generate-1024: the pack's cache=${cache_policy} is set for ${pack_steps} steps; pass none or ${cache_policy} explicitly to run ${requested_steps}");
                return 2;
            }
            io::println("generate-1024: cache=${cache_policy} steps=${requested_steps}");
            if cache_policy == "taylorseer" {
                return _run_generation(
                    packed_path.view(), model_path.view(), output_path.view(), prompt.view(),
                    1024 as usize, requested_steps, seed,
                    qwen_image::CacheMode::TaylorSeer, 0.24f64,
                );
            }
            return _run_generation(
                packed_path.view(), model_path.view(), output_path.view(), prompt.view(),
                1024 as usize, requested_steps, seed,
                qwen_image::CacheMode::CacheDiT, 0.16f64,
            );
        }
        if pack_is_distilled(packed_path.view()) && requested_steps != pack_steps {
            io::println("generate-1024: pack kind=distilled steps=${pack_steps}; running the requested ${requested_steps} steps");
        }
        io::println("generate-1024: cache=none steps=${requested_steps}");
        return _run_generation(
            packed_path.view(), model_path.view(), output_path.view(), prompt.view(),
            1024 as usize, requested_steps, seed, qwen_image::CacheMode::None, 0.0f64,
        );
    }
    if command == "generate-1024-bottleneck" {
        guard let option::Option[text::Text]::Some(packed_path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus generate-1024-bottleneck PACKED MODEL_DIR OUTPUT PROMPT [SEED]");
            return 2;
        };
        guard let option::Option[text::Text]::Some(model_path) = env::arg(3 as usize) else {
            io::eprintln("usage: qwen-image-cplus generate-1024-bottleneck PACKED MODEL_DIR OUTPUT PROMPT [SEED]");
            return 2;
        };
        guard let option::Option[text::Text]::Some(output_path) = env::arg(4 as usize) else {
            io::eprintln("usage: qwen-image-cplus generate-1024-bottleneck PACKED MODEL_DIR OUTPUT PROMPT [SEED]");
            return 2;
        };
        guard let option::Option[text::Text]::Some(prompt) = env::arg(5 as usize) else {
            io::eprintln("usage: qwen-image-cplus generate-1024-bottleneck PACKED MODEL_DIR OUTPUT PROMPT [SEED]");
            return 2;
        };
        var seed: u64 = 1101 as u64;
        match env::arg(6 as usize) {
            option::Option[text::Text]::Some(seed_text) => {
                guard let option::Option[u64]::Some(parsed) = parse_u64_decimal(seed_text.view()) else {
                    io::eprintln("generate-1024-bottleneck: seed must be an unsigned decimal integer");
                    return 2;
                };
                seed = parsed;
            }
            option::Option[text::Text]::None => {}
        }
        return pipeline::generate_1024_bottleneck(
            packed_path.view(), model_path.view(), output_path.view(), prompt.view(), seed,
        );
    }
    if command == "generate-1024-cache-dit" || command == "generate-1024-taylorseer" {
        guard let option::Option[text::Text]::Some(packed_path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus generate-1024-cache-dit PACKED MODEL_DIR OUTPUT PROMPT 0.12|0.24 [SEED] [25|40]");
            return 2;
        };
        guard let option::Option[text::Text]::Some(model_path) = env::arg(3 as usize) else {
            io::eprintln("usage: qwen-image-cplus generate-1024-cache-dit PACKED MODEL_DIR OUTPUT PROMPT 0.12|0.24 [SEED] [25|40]");
            return 2;
        };
        guard let option::Option[text::Text]::Some(output_path) = env::arg(4 as usize) else {
            io::eprintln("usage: qwen-image-cplus generate-1024-cache-dit PACKED MODEL_DIR OUTPUT PROMPT 0.12|0.24 [SEED] [25|40]");
            return 2;
        };
        guard let option::Option[text::Text]::Some(prompt) = env::arg(5 as usize) else {
            io::eprintln("usage: qwen-image-cplus generate-1024-cache-dit PACKED MODEL_DIR OUTPUT PROMPT 0.12|0.24 [SEED] [25|40]");
            return 2;
        };
        guard let option::Option[text::Text]::Some(threshold_text) = env::arg(6 as usize) else {
            io::eprintln("usage: qwen-image-cplus generate-1024-cache-dit PACKED MODEL_DIR OUTPUT PROMPT 0.12|0.24 [SEED] [25|40]");
            return 2;
        };
        guard let option::Option[f64]::Some(threshold) = parse_cache_dit_threshold(threshold_text.view()) else {
            io::eprintln("generate-1024-cache-dit: threshold must be 0.12, 0.14, 0.16, or 0.24");
            return 2;
        };
        if pack_is_distilled(packed_path.view()) && !env::has_var("QI_CACHE_DIT_WARMUP") {
            io::eprintln("${command}: kind=distilled packs have no steps to cache; use generate-1024");
            return 2;
        }
        var seed: u64 = 1101 as u64;
        match env::arg(7 as usize) {
            option::Option[text::Text]::Some(seed_text) => {
                guard let option::Option[u64]::Some(parsed) = parse_u64_decimal(seed_text.view()) else {
                    io::eprintln("generate-1024-cache-dit: seed must be an unsigned decimal integer");
                    return 2;
                };
                seed = parsed;
            }
            option::Option[text::Text]::None => {}
        }
        guard let option::Option[str]::Some(cache_pack_steps) = pack_default_steps(
            packed_path.view(), ["4", "25", "40", "40", "40"],
        ) else { return 2; };
        var cache_steps: str = cache_pack_steps;
        match env::arg(8 as usize) {
            option::Option[text::Text]::Some(steps_text) => {
                if steps_text == "25" {
                    cache_steps = "25";
                } else if steps_text == "4" {
                    // Viggle distillation experiment.
                    cache_steps = "4";
                } else if steps_text == "40" {
                    cache_steps = "40";
                } else {
                    io::eprintln("generate-1024-cache-dit: steps must be 4, 25, or 40");
                    return 2;
                }
            }
            option::Option[text::Text]::None => {}
        }
        io::println("${command}: steps=${cache_steps}");
        if command == "generate-1024-taylorseer" {
            return _run_generation(
                packed_path.view(), model_path.view(), output_path.view(), prompt.view(),
                1024 as usize, cache_steps, seed,
                qwen_image::CacheMode::TaylorSeer, threshold,
            );
        }
        return _run_generation(
            packed_path.view(), model_path.view(), output_path.view(), prompt.view(),
            1024 as usize, cache_steps, seed,
            qwen_image::CacheMode::CacheDiT, threshold,
        );
    }
    if command == "benchmark-process-reuse-256" {
        guard let option::Option[text::Text]::Some(packed_path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus benchmark-process-reuse-256 PACKED MODEL_DIR OUTPUT PROMPT 0.12|0.24 REQUESTS [SEED]");
            return 2;
        };
        guard let option::Option[text::Text]::Some(model_path) = env::arg(3 as usize) else {
            io::eprintln("usage: qwen-image-cplus benchmark-process-reuse-256 PACKED MODEL_DIR OUTPUT PROMPT 0.12|0.24 REQUESTS [SEED]");
            return 2;
        };
        guard let option::Option[text::Text]::Some(output_path) = env::arg(4 as usize) else {
            io::eprintln("usage: qwen-image-cplus benchmark-process-reuse-256 PACKED MODEL_DIR OUTPUT PROMPT 0.12|0.24 REQUESTS [SEED]");
            return 2;
        };
        guard let option::Option[text::Text]::Some(prompt) = env::arg(5 as usize) else {
            io::eprintln("usage: qwen-image-cplus benchmark-process-reuse-256 PACKED MODEL_DIR OUTPUT PROMPT 0.12|0.24 REQUESTS [SEED]");
            return 2;
        };
        guard let option::Option[text::Text]::Some(threshold_text) = env::arg(6 as usize) else {
            io::eprintln("usage: qwen-image-cplus benchmark-process-reuse-256 PACKED MODEL_DIR OUTPUT PROMPT 0.12|0.24 REQUESTS [SEED]");
            return 2;
        };
        guard let option::Option[f64]::Some(threshold) = parse_cache_dit_threshold(threshold_text.view()) else {
            io::eprintln("benchmark-process-reuse-256: threshold must be 0.12, 0.14, 0.16, or 0.24");
            return 2;
        };
        guard let option::Option[text::Text]::Some(request_count_text) = env::arg(7 as usize) else {
            io::eprintln("usage: qwen-image-cplus benchmark-process-reuse-256 PACKED MODEL_DIR OUTPUT PROMPT 0.12|0.24 REQUESTS [SEED]");
            return 2;
        };
        guard let option::Option[u64]::Some(request_count_value) =
            parse_u64_decimal(request_count_text.view()) else {
            io::eprintln("benchmark-process-reuse-256: requests must be an integer from 2 through 16");
            return 2;
        };
        if request_count_value < (2 as u64) || request_count_value > (16 as u64) {
            io::eprintln("benchmark-process-reuse-256: requests must be an integer from 2 through 16");
            return 2;
        }
        var seed: u64 = 42 as u64;
        match env::arg(8 as usize) {
            option::Option[text::Text]::Some(seed_text) => {
                guard let option::Option[u64]::Some(parsed) = parse_u64_decimal(seed_text.view()) else {
                    io::eprintln("benchmark-process-reuse-256: seed must be an unsigned decimal integer");
                    return 2;
                };
                seed = parsed;
            }
            option::Option[text::Text]::None => {}
        }
        return pipeline::benchmark_process_reuse_256(
            packed_path.view(),
            model_path.view(),
            output_path.view(),
            prompt.view(),
            request_count_value as usize,
            seed,
            threshold,
        );
    }
    if command == "test-native-pipeline-256" {
        guard let option::Option[text::Text]::Some(packed_path) = env::arg(2 as usize) else {
            io::eprintln("usage: qwen-image-cplus test-native-pipeline-256 PACKED MODEL_DIR OUTPUT");
            return 2;
        };
        guard let option::Option[text::Text]::Some(model_path) = env::arg(3 as usize) else {
            io::eprintln("usage: qwen-image-cplus test-native-pipeline-256 PACKED MODEL_DIR OUTPUT");
