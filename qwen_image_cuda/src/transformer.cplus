// Qwen-Image-2.1 transformer on CUDA (Linux engine).
//
// Equations: tools/generate_transformer_model_fixture.py, the NumPy
// transcription of the pinned Diffusers QwenImage21Transformer2DModel. The
// residual stream and every non-matrix operation stay FP32.
//
// Text rows use the t = 0 modulation and attend causally to text only, so
// their path is independent of the image and of the timestep. prefix() runs
// it once and caches every block's text K (after norm and RoPE) and V; each
// step() then runs only the image rows against [cached text keys | image keys].
//
// Weight modes:
// - Fp16Streamed: the all-FP16 v4 pack. Globals stay resident; each block is
//   uploaded when it runs; matrices run as FP32 SGEMM. For validation.
// - W4A16 / W4A4: a v6 INT4 pack, entirely resident.

import "stdlib/time" as time;
import "qwen_image/file_io" as file_io;
import "qwen_image/generation_control" as control;
import "qwen_image/pack_info" as pack_info;
import "qwen_image/schedule" as fixed_schedule;
import "./cuda" as cuda;
import "./int4_pack" as pack;
import "stdlib/io" as io;
import "stdlib/option" as option;
import "stdlib/status" as status;
import "stdlib/text" as text;
import "stdlib/thread" as thread;
import "stdlib/vec" as vec;


const WIDTH: usize = 4096;
const MLP: usize = 12288;
const HEADS: usize = 32;
const LATENT: usize = 64;
const BLOCKS: usize = 32;
const GLOBALS: usize = 9;
const ROW_ALIGN: usize = 128;
const MODULATION_WIDTH: usize = 16384;
// FP32 scratch for one expanded BF16/FP16 matrix; larger ones run in row slices.
const WEIGHT_SCRATCH_FLOATS: usize = 16777216;
// Device memory left free beyond the resident pack before choosing to stream.
const STREAM_HEADROOM: u64 = 536870912;

const IMG_IN: usize = 0;
const MODULATION: usize = 1;
const NORM_OUT: usize = 2;
const PROJ_OUT: usize = 3;
const TIME_1: usize = 4;
const TIME_2: usize = 5;
const TXT_IN: usize = 6;
const TXT_OUT: usize = 7;
const TEXT_NORM: usize = 8;

const ROLE_NORM_K: usize = 0;
const ROLE_NORM_Q: usize = 1;
const ROLE_Q: usize = 2;
const ROLE_K: usize = 3;
const ROLE_V: usize = 4;
const ROLE_OUT: usize = 5;
const ROLE_GATE: usize = 6;
const ROLE_DOWN: usize = 7;
const ROLE_UP: usize = 8;

enum WeightMode {
    Fp16Streamed,
    W4A16,
    W4A4,
}

fn block_record(block: usize, role: usize) -> usize {
    return GLOBALS +% block *% (9 as usize) +% role;
}

fn expected_name(index: usize) -> text::Text {
    if index == IMG_IN { return text::from_str("img_in.weight"); }
    if index == MODULATION { return text::from_str("modulation.1.weight"); }
    if index == NORM_OUT { return text::from_str("norm_out.linear.weight"); }
    if index == PROJ_OUT { return text::from_str("proj_out.weight"); }
    if index == TIME_1 { return text::from_str("time_text_embed.timestep_embedder.linear_1.weight"); }
    if index == TIME_2 { return text::from_str("time_text_embed.timestep_embedder.linear_2.weight"); }
    if index == TXT_IN { return text::from_str("txt_in.in_layer.weight"); }
    if index == TXT_OUT { return text::from_str("txt_in.out_layer.weight"); }
    if index == TEXT_NORM { return text::from_str("txt_in.text_norm.weight"); }
    let block: usize = (index -% GLOBALS) / (9 as usize);
    let role: usize = (index -% GLOBALS) % (9 as usize);
    let prefix: text::Text = "transformer_blocks.${block}.";
    let suffix: str = if role == ROLE_NORM_K { "attn.norm_k.weight" }
        else if role == ROLE_NORM_Q { "attn.norm_q.weight" }
        else if role == ROLE_Q { "attn.to_q.weight" }
        else if role == ROLE_K { "attn.to_k.weight" }
        else if role == ROLE_V { "attn.to_v.weight" }
        else if role == ROLE_OUT { "attn.to_out.0.weight" }
        else if role == ROLE_GATE { "img_mlp.gate_layer.weight" }
        else if role == ROLE_DOWN { "img_mlp.out.weight" }
        else { "img_mlp.proj.weight" };
    return "${prefix.view()}${suffix}";
}

fn round_rows(rows: usize) -> usize {
    return ((rows +% ROW_ALIGN -% (1 as usize)) / ROW_ALIGN) *% ROW_ALIGN;
}

fn ok(result: i32, what: str) -> bool {
    if result != (0 as i32) {
        io::eprintln("cuda transformer: ${what} failed (cuda status ${result})");
        return false;
    }
    return true;
}

// MARK: - Weights

struct Model {
    mode: WeightMode,
    fd: i32,
    records: pack::Buffer,
    data_offset: u64,
    file_bytes: u64,
    // Resident bytes start at data_offset: the whole data section for INT4
    // packs, only the globals for the streamed FP16 pack.
    resident: cuda::DeviceBuffer,
    resident_end: u64,
    slot: cuda::DeviceBuffer,
    slot_block: usize,
    slot_base: u64,
    // INT4 blocks kept in pinned host memory when streamed; empty otherwise.
    host_blocks: cuda::PinnedBuffer,
    host_base: u64,
    // Asynchronous streaming (INT4 from pinned memory): block b runs from
    // slot b % 2 while block b + 1 uploads into the other on copy_stream.
    // uploaded_* order compute after an upload; computed_* order the next
    // upload into a slot after the block that last read it.
    slot_b: cuda::DeviceBuffer,
    copy_stream: cuda::Stream,
    uploaded_a: cuda::Event,
    uploaded_b: cuda::Event,
    computed_a: cuda::Event,
    computed_b: cuda::Event,
    // FP32 expansion of one BF16/FP16 matrix, and of one norm vector.
    weight_scratch: cuda::DeviceBuffer,
    vector_scratch: cuda::DeviceBuffer,
}

impl Model {
    fn record(this, index: usize) -> pack::PackedRecord {
        return *((this.records.pointer as *pack::PackedRecord) + index);
    }

    fn block_start(this, block: usize) -> u64 {
        return this.record(block_record(block, 0 as usize)).weights_offset;
    }

    fn block_end(this, block: usize) -> u64 {
        return if block +% (1 as usize) < BLOCKS { this.block_start(block +% (1 as usize)) } else { this.file_bytes };
    }

    fn drop(ref this) {
        if this.fd >= (0 as i32) {
            let _closed: i32 = file_io::close(this.fd);
            this.fd = 0 -% (1 as i32);
        }
    }
}

// MARK: - Pack preload

// An INT4 pack's data section read ahead into host memory on worker threads
// while the encoders run, so `load` only uploads it (resident: pageable
// uploads run at full PCIe speed here) or registers it with CUDA and adopts it
// as its streamed block store (registering filled memory takes ~0.2 s for
// 4 GB). Plain memory, because page-locking 4 GB up front (about a second)
// slows the text encoder running beside it.
const PRELOAD_WORKERS: usize = 8;
const PRELOAD_CHUNK: u64 = 8388608;

struct PreloadRead {
    fd: i32,
    opaque destination: *u8,
    start: u64,
    bytes: u64,
    worker: usize,
}

impl PreloadRead: Send {}

fn preload_read(take job: PreloadRead) -> i32 {
    var chunk: u64 = (job.worker as u64) *% PRELOAD_CHUNK;
    while chunk < job.bytes {
        let amount: u64 = if job.bytes -% chunk < PRELOAD_CHUNK { job.bytes -% chunk } else { PRELOAD_CHUNK };
        if !pack::read_exact(job.fd, job.destination + chunk as usize, amount as usize, job.start +% chunk) { return 1; }
        chunk = chunk +% (PRELOAD_WORKERS as u64) *% PRELOAD_CHUNK;
    }
    return 0;
}

struct PreloadJob {
    fd: i32,
    start: u64,
    bytes: u64,
    // Where the coordinator leaves the buffer pointer (the PackPreload's cell).
    opaque result: **u8,
}

impl PreloadJob: Send {}

#[link_name = "malloc"]
extern fn qi_malloc(bytes: usize) -> *u8;
#[link_name = "free"]
extern fn qi_free(pointer: *u8);

fn preload_coordinate(take job: PreloadJob) -> i32 {
    let pinned: *u8 = qi_malloc(job.bytes as usize);
    if pinned.is_null() { return 1; }
    *job.result = pinned;
    var readers: vec::Vec[thread::JoinHandle[i32]] = vec::Vec[thread::JoinHandle[i32]]::with_capacity(PRELOAD_WORKERS);
    var worker: usize = 0 as usize;
    var failed: bool = false;
    while worker < PRELOAD_WORKERS {
        let read: PreloadRead = PreloadRead { fd: job.fd, destination: pinned, start: job.start, bytes: job.bytes, worker: worker };
        if readers.append(thread::spawn_with::[PreloadRead, i32](read, preload_read)) != status::Status::Ok { failed = true; }
        worker = worker +% (1 as usize);
    }
    while true {
        match readers.remove_last() {
            option::Option::Some(handle) => { if handle.join() != (0 as i32) { failed = true; } }
            option::Option::None => { break; }
        }
    }
    return if failed { 1 } else { 0 };
}

struct PackPreload {
    // False when nothing is being read (not an INT4 pack, or starting failed).
    active: bool,
    fd: i32,
    start: u64,
    bytes: u64,
    cell: pack::Buffer,
    coordinator: vec::Vec[thread::JoinHandle[i32]],
    finished: bool,
    succeeded: bool,
}

impl PackPreload {
    // Joins the coordinator (once); true when the whole data section is in.
    fn finish(ref this) -> bool {
        if !this.active { return false; }
        if !this.finished {
            this.finished = true;
            this.succeeded = true;
            while true {
                match this.coordinator.remove_last() {
                    option::Option::Some(handle) => { if handle.join() != (0 as i32) { this.succeeded = false; } }
                    option::Option::None => { break; }
                }
            }
        }
        return this.succeeded;
    }

    // The buffer, still owned by the preload.
    fn buffer(this) -> *u8 {
        if !this.active { return 0 as *u8; }
        return *(this.cell.pointer as **u8);
    }

    // Registers the buffer with CUDA and hands it over; the preload no longer
    // owns it.
    fn take_registered(ref this) -> option::Option[cuda::PinnedBuffer] {
        if !this.active { return option::Option[cuda::PinnedBuffer]::None; }
        let slot: **u8 = this.cell.pointer as **u8;
        let pointer: *u8 = *slot;
        if pointer.is_null() { return option::Option[cuda::PinnedBuffer]::None; }
        *slot = 0 as *u8;
        return cuda::PinnedBuffer::register(pointer, this.bytes);
    }

    fn drop(ref this) {
        let _joined: bool = this.finish();
        if this.active {
            let slot: **u8 = this.cell.pointer as **u8;
            if !(*slot).is_null() {
                qi_free(*slot);
                *slot = 0 as *u8;
            }
        }
        if this.fd >= (0 as i32) {
            let _closed: i32 = file_io::close(this.fd);
            this.fd = 0 -% (1 as i32);
        }
    }
}

// Starts reading `path`'s data section into pinned memory when it is an INT4
// pack (the FP16 pack streams from the file); None otherwise or on failure.
fn inactive_preload() -> PackPreload {
    return PackPreload {
        active: false, fd: 0 -% (1 as i32), start: 0 as u64, bytes: 0 as u64,
        cell: pack::Buffer { pointer: 0 as *u8, length: 0 as usize },
        coordinator: vec::Vec[thread::JoinHandle[i32]]::with_capacity(0 as usize), finished: true, succeeded: false,
    };
}

fn begin_preload(path: str) -> PackPreload {
    let fd: i32 = file_io::open_read(path);
    if fd < (0 as i32) { return inactive_preload(); }
    guard let option::Option[pack::PackedHeader]::Some(header) = pack::read_header(fd) else {
        let _closed: i32 = file_io::close(fd);
        return inactive_preload();
    };
    if !pack::fixed_matches(#addr_of(header.policy[0]), 32 as usize, "transformer:w4a4-h256-g64-v6")
        && !pack::fixed_matches(#addr_of(header.policy[0]), 32 as usize, "transformer:w4a16-g64-v6") {
        let _closed: i32 = file_io::close(fd);
        return inactive_preload();
    }
    guard let option::Option[pack::Buffer]::Some(cell) = pack::Buffer::allocate(8 as usize) else {
        let _closed: i32 = file_io::close(fd);
        return inactive_preload();
    };
    *(cell.pointer as **u8) = 0 as *u8;
    let bytes: u64 = header.file_bytes -% header.data_offset;
    var coordinator: vec::Vec[thread::JoinHandle[i32]] = vec::Vec[thread::JoinHandle[i32]]::with_capacity(1 as usize);
    let job: PreloadJob = PreloadJob { fd: fd, start: header.data_offset, bytes: bytes, result: cell.pointer as **u8 };
    if coordinator.append(thread::spawn_with::[PreloadJob, i32](job, preload_coordinate)) != status::Status::Ok {
        let _closed: i32 = file_io::close(fd);
        return inactive_preload();
    }
    return PackPreload {
        active: true, fd: fd, start: header.data_offset, bytes: bytes, cell: cell, coordinator: coordinator, finished: false,
        succeeded: false,
    };
}

// With `auto_stream`, an INT4 pack stays resident only when the free device
// memory covers it plus STREAM_HEADROOM plus `reserve` (the prefix cache); otherwise its blocks are copied to
// pinned host memory and uploaded one at a time as they run. The FP16 pack is
// always streamed, from the file.
//
// A finished `preload` of the same pack replaces the file reads: resident
// weights upload from its pinned buffer, and a streamed model adopts it.
fn load(path: str, mode: WeightMode, auto_stream: bool = false, reserve: u64 = 0 as u64,
        preload: *PackPreload = 0 as *PackPreload) -> option::Option[Model] {
    let fd: i32 = file_io::open_read(path);
    if fd < (0 as i32) {
        io::eprintln("cuda transformer: could not open ${path}");
        return option::Option[Model]::None;
    }
    guard let option::Option[pack::PackedHeader]::Some(header) = pack::read_header(fd) else {
        let _closed: i32 = file_io::close(fd);
        return option::Option[Model]::None;
    };
    let expected_policy: str = match mode {
        WeightMode::Fp16Streamed => "transformer:all-matrix-f16-v4",
        WeightMode::W4A16 => "transformer:w4a16-g64-v6",
        WeightMode::W4A4 => "transformer:w4a4-h256-g64-v6",
    };
    if !pack::magic_matches(#addr_of(header)) || header.tensor_count != (297 as u32)
        || !pack::fixed_matches(#addr_of(header.policy[0]), 32 as usize, expected_policy) {
        io::eprintln("cuda transformer: ${path} is not a ${expected_policy} pack");
        let _closed: i32 = file_io::close(fd);
        return option::Option[Model]::None;
    }
    guard let option::Option[pack::Buffer]::Some(records) = pack::Buffer::allocate(256 as usize *% (297 as usize)) else {
        let _closed: i32 = file_io::close(fd);
        return option::Option[Model]::None;
    };
    if !pack::read_exact(fd, records.pointer, records.length, header.directory_offset) {
        let _closed: i32 = file_io::close(fd);
        return option::Option[Model]::None;
    }
    var index: usize = 0 as usize;
    while index < (297 as usize) {
        let record: *pack::PackedRecord = (records.pointer as *pack::PackedRecord) + index;
        let name: text::Text = expected_name(index);
        if !pack::fixed_matches(#addr_of((*record).name[0]), 128 as usize, name.view()) {
            io::eprintln("cuda transformer: record ${index} is not ${name.view()}");
            let _closed: i32 = file_io::close(fd);
            return option::Option[Model]::None;
        }
        index = index +% (1 as usize);
    }
    let first_block: u64 = (*((records.pointer as *pack::PackedRecord) + GLOBALS)).weights_offset;
    let streamed: bool = mode == WeightMode::Fp16Streamed
        || (auto_stream && cuda::free_memory() < header.file_bytes -% header.data_offset +% STREAM_HEADROOM +% reserve);
    let resident_end: u64 = if streamed { first_block } else { header.file_bytes };
    guard let option::Option[cuda::DeviceBuffer]::Some(resident) = cuda::DeviceBuffer::allocate(resident_end -% header.data_offset) else {
        io::eprintln("cuda transformer: could not allocate ${resident_end -% header.data_offset} resident bytes");
        let _closed: i32 = file_io::close(fd);
        return option::Option[Model]::None;
    };
    // Largest block span for the streamed slot; one byte otherwise.
    var slot_bytes: u64 = 1 as u64;
    if streamed {
        var block: usize = 0 as usize;
        while block < BLOCKS {
            let start: u64 = (*((records.pointer as *pack::PackedRecord) + block_record(block, 0 as usize))).weights_offset;
            let end: u64 = if block +% (1 as usize) < BLOCKS {
                (*((records.pointer as *pack::PackedRecord) + block_record(block +% (1 as usize), 0 as usize))).weights_offset
            } else { header.file_bytes };
            if end -% start > slot_bytes { slot_bytes = end -% start; }
            block = block +% (1 as usize);
        }
    }
    guard let option::Option[cuda::DeviceBuffer]::Some(slot) = cuda::DeviceBuffer::allocate(slot_bytes) else {
        let _closed: i32 = file_io::close(fd);
        return option::Option[Model]::None;
    };
    // A usable preload covers the whole data section from data_offset.
    let preloaded: bool = !preload.is_null() && (*preload).finish() && (*preload).start == header.data_offset
        && (*preload).bytes == header.file_bytes -% header.data_offset;
    if !preload.is_null() && (*preload).active && !preloaded {
        io::eprintln("cuda transformer: pack preload unusable; reading the file");
    }
    var host_base: u64 = first_block;
    var host_blocks: cuda::PinnedBuffer = cuda::PinnedBuffer::empty();
    var adopted: bool = false;
    if streamed && mode != WeightMode::Fp16Streamed && preloaded {
        match (*preload).take_registered() {
            option::Option::Some(registered) => {
                host_blocks = registered;
                host_base = header.data_offset;
                adopted = true;
            }
            option::Option::None => { io::eprintln("cuda transformer: could not register the preloaded pack"); }
        }
    }
    if !adopted {
        let host_bytes: u64 = if streamed && mode != WeightMode::Fp16Streamed { header.file_bytes -% first_block } else { 1 as u64 };
        guard let option::Option[cuda::PinnedBuffer]::Some(allocated) = cuda::PinnedBuffer::allocate(host_bytes) else {
            io::eprintln("cuda transformer: could not pin ${host_bytes} bytes for streamed blocks");
            let _closed: i32 = file_io::close(fd);
            return option::Option[Model]::None;
        };
        host_blocks = allocated;
        if host_bytes > (1 as u64) && !pack::read_exact(fd, host_blocks.pointer, host_bytes as usize, first_block) {
            let _closed: i32 = file_io::close(fd);
            return option::Option[Model]::None;
        }
    }
    if streamed {
        io::println("cuda transformer: streaming blocks (${free_megabytes()} MB free on the device)");
    }
    let asynchronous: bool = host_blocks.bytes > (1 as u64);
    guard let option::Option[cuda::DeviceBuffer]::Some(slot_b) = cuda::DeviceBuffer::allocate(if asynchronous { slot_bytes } else { 1 as u64 }) else {
        let _closed: i32 = file_io::close(fd);
        return option::Option[Model]::None;
    };
    guard let option::Option[cuda::Stream]::Some(copy_stream) = cuda::Stream::create() else { return option::Option[Model]::None; };
    guard let option::Option[cuda::Event]::Some(uploaded_a) = cuda::Event::create() else { return option::Option[Model]::None; };
    guard let option::Option[cuda::Event]::Some(uploaded_b) = cuda::Event::create() else { return option::Option[Model]::None; };
    guard let option::Option[cuda::Event]::Some(computed_a) = cuda::Event::create() else { return option::Option[Model]::None; };
    guard let option::Option[cuda::Event]::Some(computed_b) = cuda::Event::create() else { return option::Option[Model]::None; };
    guard let option::Option[cuda::DeviceBuffer]::Some(weight_scratch) = cuda::DeviceBuffer::allocate(
        (WEIGHT_SCRATCH_FLOATS *% (4 as usize)) as u64,
    ) else {
        let _closed: i32 = file_io::close(fd);
        return option::Option[Model]::None;
    };
    guard let option::Option[cuda::DeviceBuffer]::Some(vector_scratch) = cuda::DeviceBuffer::allocate((WIDTH *% (4 as usize)) as u64) else {
        let _closed: i32 = file_io::close(fd);
        return option::Option[Model]::None;
    };
    var model: Model = Model {
        mode: mode,
        fd: fd,
        records: records,
        data_offset: header.data_offset,
        file_bytes: header.file_bytes,
        resident: resident,
        resident_end: resident_end,
        slot: slot,
        slot_block: BLOCKS,
        slot_base: 0 as u64,
        host_blocks: host_blocks,
        host_base: host_base,
        slot_b: slot_b,
        copy_stream: copy_stream,
        uploaded_a: uploaded_a,
        uploaded_b: uploaded_b,
        computed_a: computed_a,
        computed_b: computed_b,
        weight_scratch: weight_scratch,
        vector_scratch: vector_scratch,
    };
    let resident_uploaded: bool = if preloaded && !asynchronous {
        cuda::upload(model.resident.pointer, (*preload).buffer(), model.resident_end -% model.data_offset) == (0 as i32)
    } else if asynchronous && model.host_base == model.data_offset {
        cuda::upload(model.resident.pointer, model.host_blocks.pointer, model.resident_end -% model.data_offset) == (0 as i32)
    } else {
        upload_range(model.fd, model.data_offset, model.resident_end, model.resident.pointer)
    };
    if !resident_uploaded {
        io::eprintln("cuda transformer: uploading weights failed");
        return option::Option[Model]::None;
    }
    if asynchronous && (!queue_upload(model, 0 as usize) || !queue_upload(model, 1 as usize)) {
        return option::Option[Model]::None;
    }
    return option::Option[Model]::Some(model);
}

// Bytes of FP16 prefix keys plus values for `rows` prefix rows over all blocks.
fn cache_bytes(rows: usize) -> u64 {
    return (BLOCKS *% rows *% WIDTH *% (2 as usize) *% (2 as usize)) as u64;
}

fn free_megabytes() -> u64 {
    return cuda::free_memory() / (1048576 as u64);
}

// Reads [start, end) of the pack and uploads it to `device` in 64 MiB chunks.
fn upload_range(fd: i32, start: u64, end: u64, device: *u8) -> bool {
    let chunk_bytes: usize = 67108864 as usize;
    guard let option::Option[pack::Buffer]::Some(chunk) = pack::Buffer::allocate(chunk_bytes) else { return false; };
    var position: u64 = start;
    while position < end {
        let remaining: u64 = end -% position;
        let amount: usize = if remaining < chunk_bytes as u64 { remaining as usize } else { chunk_bytes };
        if !pack::read_exact(fd, chunk.pointer, amount, position) { return false; }
        if cuda::upload(device + (position -% start) as usize, chunk.pointer, amount as u64) != (0 as i32) {
            return false;
        }
        position = position +% amount as u64;
    }
    return true;
}

fn asynchronous(model: Model) -> bool {
    return model.host_blocks.bytes > (1 as u64);
}

fn slot_pointer(model: Model, block: usize) -> *u8 {
    return if block % (2 as usize) == (0 as usize) { model.slot.pointer } else { model.slot_b.pointer };
}

// Queues block `block` into its slot on the copy stream, after the block that
// last read that slot has finished on the default stream.
fn queue_upload(ref model: Model, block: usize) -> bool {
    let even: bool = block % (2 as usize) == (0 as usize);
    let computed: *u8 = if even { model.computed_a.handle } else { model.computed_b.handle };
    let uploaded: *u8 = if even { model.uploaded_a.handle } else { model.uploaded_b.handle };
    let start: u64 = model.block_start(block);
    return cuda::wait(model.copy_stream.handle, computed)
        && cuda::upload_async(slot_pointer(model, block), model.host_blocks.pointer + (start -% model.host_base) as usize,
            model.block_end(block) -% start, model.copy_stream.handle)
        && cuda::record(uploaded, model.copy_stream.handle);
}

// Before a block's kernels: the default stream waits for its upload.
fn begin_block(ref model: Model, block: usize) -> bool {
    if !asynchronous(model) { return true; }
    let uploaded: *u8 = if block % (2 as usize) == (0 as usize) { model.uploaded_a.handle } else { model.uploaded_b.handle };
    model.slot_block = block;
    model.slot_base = model.block_start(block);
    return cuda::wait(0 as *u8, uploaded);
}

// After a block's kernels are queued: mark its slot free once they finish and
// queue the block two ahead (cyclically: prefix, then every step) into it.
fn end_block(ref model: Model, block: usize) -> bool {
    if !asynchronous(model) { return true; }
    let computed: *u8 = if block % (2 as usize) == (0 as usize) { model.computed_a.handle } else { model.computed_b.handle };
    return cuda::record(computed, 0 as *u8) && queue_upload(model, (block +% (2 as usize)) % BLOCKS);
}

// Device address of pack byte `offset`, uploading its block first when the
// pack is streamed.
fn device_address(ref model: Model, offset: u64) -> *u8 {
    if offset < model.resident_end {
        return model.resident.pointer + (offset -% model.data_offset) as usize;
    }
    if asynchronous(model) {
        // begin_block selected the running block.
        return slot_pointer(model, model.slot_block) + (offset -% model.slot_base) as usize;
    }
    var block: usize = 0 as usize;
    while block +% (1 as usize) < BLOCKS && offset >= model.block_start(block +% (1 as usize)) {
        block = block +% (1 as usize);
    }
    if model.slot_block != block {
        let start: u64 = model.block_start(block);
        let end: u64 = model.block_end(block);
        let from_host: bool = model.host_blocks.bytes > (1 as u64);
        let uploaded: bool = if from_host {
            cuda::upload(model.slot.pointer, model.host_blocks.pointer + (start -% model.host_base) as usize, end -% start) == (0 as i32)
        } else {
            upload_range(model.fd, start, end, model.slot.pointer)
        };
        if !uploaded {
            io::eprintln("cuda transformer: streaming block ${block} failed");
            return 0 as *u8;
        }
        model.slot_block = block;
        model.slot_base = start;
    }
    return model.slot.pointer + (offset -% model.slot_base) as usize;
}

// FP32 copy of a BF16 norm vector in the model's vector scratch.
fn vector(ref model: Model, index: usize) -> *f32 {
    let record: pack::PackedRecord = model.record(index);
    let source: *u8 = device_address(model, record.weights_offset);
    let result: i32 = cuda::bf16_to_f32(source, model.vector_scratch.pointer as *f32, record.dimensions[0]);
    if result != (0 as i32) { return 0 as *f32; }
    return model.vector_scratch.pointer as *f32;
}

// MARK: - Activations

struct Work {
    rows: usize,  // padded row capacity
    keys: usize,  // attention key capacity
    hidden: cuda::DeviceBuffer,
    normed: cuda::DeviceBuffer,
    q: cuda::DeviceBuffer,
    k: cuda::DeviceBuffer,
    v: cuda::DeviceBuffer,
    attended: cuda::DeviceBuffer,
    projected: cuda::DeviceBuffer,
    gate: cuda::DeviceBuffer,
    up: cuda::DeviceBuffer,
    codes: cuda::DeviceBuffer,
    code_scales: cuda::DeviceBuffer,
    halves: cuda::DeviceBuffer,
    attention_halves: cuda::DeviceBuffer,
    time: cuda::DeviceBuffer,        // [2, 256] projection, then [2, 4096] hidden
    time_hidden: cuda::DeviceBuffer, // [2, 4096]
    modulation: cuda::DeviceBuffer,  // [2, 16384]: row 0 target t, row 1 prefix t = 0
    final_scale: cuda::DeviceBuffer, // [2, 4096]
    timesteps: cuda::DeviceBuffer,   // [2]
}

fn device_floats(count: usize) -> option::Option[cuda::DeviceBuffer] {
    return cuda::DeviceBuffer::allocate((count *% (4 as usize)) as u64);
}

fn allocate_work(rows_needed: usize, keys: usize) -> option::Option[Work] {
    let rows: usize = round_rows(rows_needed);
    guard let option::Option[cuda::DeviceBuffer]::Some(hidden) = device_floats(rows *% WIDTH) else { return option::Option[Work]::None; };
    guard let option::Option[cuda::DeviceBuffer]::Some(normed) = device_floats(rows *% WIDTH) else { return option::Option[Work]::None; };
    guard let option::Option[cuda::DeviceBuffer]::Some(q) = device_floats(rows *% WIDTH) else { return option::Option[Work]::None; };
    guard let option::Option[cuda::DeviceBuffer]::Some(k) = device_floats(rows *% WIDTH) else { return option::Option[Work]::None; };
    guard let option::Option[cuda::DeviceBuffer]::Some(v) = device_floats(rows *% WIDTH) else { return option::Option[Work]::None; };
    guard let option::Option[cuda::DeviceBuffer]::Some(attended) = device_floats(rows *% WIDTH) else { return option::Option[Work]::None; };
    guard let option::Option[cuda::DeviceBuffer]::Some(projected) = device_floats(rows *% WIDTH) else { return option::Option[Work]::None; };
    guard let option::Option[cuda::DeviceBuffer]::Some(gate) = device_floats(rows *% MLP) else { return option::Option[Work]::None; };
    guard let option::Option[cuda::DeviceBuffer]::Some(up) = device_floats(rows *% MLP) else { return option::Option[Work]::None; };
    guard let option::Option[cuda::DeviceBuffer]::Some(codes) = cuda::DeviceBuffer::allocate((rows *% MLP / (2 as usize)) as u64) else { return option::Option[Work]::None; };
    guard let option::Option[cuda::DeviceBuffer]::Some(code_scales) = cuda::DeviceBuffer::allocate((rows *% MLP / (64 as usize) *% (2 as usize)) as u64) else { return option::Option[Work]::None; };
    guard let option::Option[cuda::DeviceBuffer]::Some(halves) = cuda::DeviceBuffer::allocate((rows *% MLP *% (2 as usize)) as u64) else { return option::Option[Work]::None; };
    // FP16 keys and values for every key; flash attention needs no scores.
    let attention_half_count: usize = (2 as usize) *% keys *% WIDTH;
    guard let option::Option[cuda::DeviceBuffer]::Some(attention_halves) = cuda::DeviceBuffer::allocate((attention_half_count *% (2 as usize)) as u64) else { return option::Option[Work]::None; };
    guard let option::Option[cuda::DeviceBuffer]::Some(time) = device_floats(2 as usize *% WIDTH) else { return option::Option[Work]::None; };
    guard let option::Option[cuda::DeviceBuffer]::Some(time_hidden) = device_floats(2 as usize *% WIDTH) else { return option::Option[Work]::None; };
    guard let option::Option[cuda::DeviceBuffer]::Some(modulation) = device_floats(2 as usize *% MODULATION_WIDTH) else { return option::Option[Work]::None; };
    guard let option::Option[cuda::DeviceBuffer]::Some(final_scale) = device_floats(2 as usize *% WIDTH) else { return option::Option[Work]::None; };
    guard let option::Option[cuda::DeviceBuffer]::Some(timesteps) = device_floats(2 as usize) else { return option::Option[Work]::None; };
    let _zeroed: i32 = cuda::zero(hidden.pointer, hidden.bytes);
    return option::Option[Work]::Some(Work {
        rows: rows, keys: keys, hidden: hidden, normed: normed, q: q, k: k, v: v, attended: attended,
        projected: projected, gate: gate, up: up, 
        codes: codes, code_scales: code_scales, halves: halves, attention_halves: attention_halves, time: time, time_hidden: time_hidden,
        modulation: modulation, final_scale: final_scale, timesteps: timesteps,
    });
}

// output[rows, N] = input[rows, K] . W^T for pack record `index`. `rows` must
// be a multiple of 128 for INT4 records.
// `reuse_input` skips quantizing (or converting) `input` when the previous
// INT4 linear already did so for the same input: Q/K/V and gate/up share one.
fn linear(ref model: Model, ref work: Work, index: usize, input: *f32, output: *f32, rows: usize,
          reuse_input: bool = false) -> bool {
    let record: pack::PackedRecord = model.record(index);
    let n: usize = record.dimensions[0] as usize;
    let k: usize = record.dimensions[1] as usize;
    let weights: *u8 = device_address(model, record.weights_offset);
    if weights.is_null() { return false; }
    if record.scheme == (0 as u32) || record.scheme == (1 as u32) {
        // Expand WEIGHT_SCRATCH_FLOATS worth of weight rows at a time.
        let slice_rows: usize = if n *% k <= WEIGHT_SCRATCH_FLOATS { n } else { WEIGHT_SCRATCH_FLOATS / k };
        var first_row: usize = 0 as usize;
        while first_row < n {
            let count: usize = if n -% first_row < slice_rows { n -% first_row } else { slice_rows };
            let source: *u8 = weights + first_row *% k *% (2 as usize);
            let elements: u64 = (count *% k) as u64;
            let converted: i32 = if record.scheme == (0 as u32) {
                cuda::bf16_to_f32(source, model.weight_scratch.pointer as *f32, elements)
            } else {
                cuda::f16_to_f32(source, model.weight_scratch.pointer as *f32, elements)
            };
            if !ok(converted, "weight expansion")
                || !ok(cuda::linear_f32_strided(input, model.weight_scratch.pointer as *f32, output + first_row,
                    rows as i32, count as i32, k as i32, n as i32), "fp32 linear") {
                return false;
            }
            first_row = first_row +% count;
        }
        return true;
    }
    let scales: *u8 = device_address(model, record.scales_offset);
    if record.scheme == (6 as u32) {
        return (reuse_input || ok(cuda::w4a4_quantize_activations(input, work.codes.pointer, work.code_scales.pointer,
                rows as i32, k as i32), "activation quantization"))
            && ok(cuda::w4a4_gemm(work.codes.pointer, work.code_scales.pointer, weights, scales, output,
                rows as i32, n as i32, k as i32), "w4a4 gemm");
    }
    let minimums: *u8 = device_address(model, record.zeros_offset);
    return (reuse_input || ok(cuda::f32_to_f16(input, work.halves.pointer, (rows *% k) as u64), "activation conversion"))
        && ok(cuda::w4a16_gemm(work.halves.pointer, weights, scales, minimums, output,
            rows as i32, n as i32, k as i32), "w4a16 gemm");
}

// Timestep embedding, block modulation, and final scale for [t, 0].
fn condition(ref model: Model, ref work: Work, timestep: f32) -> bool {
    var steps: [f32; 2] = [timestep, 0.0f32];
    if !work.timesteps.upload(#addr_of(steps[0]) as *u8, 8 as u64) { return false; }
    let time: *f32 = work.time.pointer as *f32;
    let hidden: *f32 = work.time_hidden.pointer as *f32;
    let modulation: *f32 = work.modulation.pointer as *f32;
    let final_scale: *f32 = work.final_scale.pointer as *f32;
    return ok(cuda::timestep_projection(work.timesteps.pointer as *f32, time, 2 as i32), "timestep projection")
        && linear(model, work, TIME_1, time, hidden, 2 as usize)
        && ok(cuda::silu(hidden, hidden, (2 as usize *% WIDTH) as u64), "silu")
        && linear(model, work, TIME_2, hidden, time, 2 as usize)
        && ok(cuda::silu(time, time, (2 as usize *% WIDTH) as u64), "silu")
        && linear(model, work, MODULATION, time, modulation, 2 as usize)
        && linear(model, work, NORM_OUT, time, final_scale, 2 as usize);
}

// One transformer block over `rows` rows of work.hidden. Rows below `split`
// use the prefix (t = 0) modulation. Attention keys are
// [prefix_keys cached rows from cache_k/cache_v | this call's own rows];
// `rope_offset` is the RoPE row of the first row here, and query rows whose
// global index is below `causal_rows` see only earlier keys.
// cache_k/cache_v: the prefix's FP16 keys and values for this block (prefix_keys
// rows); store_k/store_v: where a prefix pass writes its own FP16 keys/values.
fn block(ref model: Model, ref work: Work, index: usize, rows: usize, valid_rows: usize, split: usize,
         rope: *f32, rope_offset: usize, cache_k: *u8, cache_v: *u8, prefix_keys: usize,
         causal_rows: usize, store_k: *u8, store_v: *u8, visible_keys: *i32 = 0 as *i32) -> bool {
    return begin_block(model, index)
        && block_body(model, work, index, rows, valid_rows, split, rope, rope_offset, cache_k, cache_v, prefix_keys,
            causal_rows, store_k, store_v, visible_keys)
        && end_block(model, index);
}

fn block_body(ref model: Model, ref work: Work, index: usize, rows: usize, valid_rows: usize, split: usize,
         rope: *f32, rope_offset: usize, cache_k: *u8, cache_v: *u8, prefix_keys: usize,
         causal_rows: usize, store_k: *u8, store_v: *u8, visible_keys: *i32) -> bool {
    let modulation: *f32 = work.modulation.pointer as *f32;
    let stride: i32 = MODULATION_WIDTH as i32;
    let hidden: *f32 = work.hidden.pointer as *f32;
    let normed: *f32 = work.normed.pointer as *f32;
    let q: *f32 = work.q.pointer as *f32;
    let k: *f32 = work.k.pointer as *f32;
    let v: *f32 = work.v.pointer as *f32;
    let keys: usize = prefix_keys +% valid_rows;
    if !ok(cuda::layer_norm_scale(hidden, modulation, stride, normed, rows as i32, WIDTH as i32, split as i32), "layer norm")
        || !linear(model, work, block_record(index, ROLE_Q), normed, q, rows)
        || !linear(model, work, block_record(index, ROLE_K), normed, k, rows, true)
        || !linear(model, work, block_record(index, ROLE_V), normed, v, rows, true) {
        return false;
    }
    let norm_q: *f32 = vector(model, block_record(index, ROLE_NORM_Q));
    if norm_q.is_null() || !ok(cuda::head_norm_rope(q, norm_q, rope, rope_offset as i32, valid_rows as i32, HEADS as i32), "q norm") {
        return false;
    }
    let norm_k: *f32 = vector(model, block_record(index, ROLE_NORM_K));
    if norm_k.is_null() || !ok(cuda::head_norm_rope(k, norm_k, rope, rope_offset as i32, valid_rows as i32, HEADS as i32), "k norm") {
        return false;
    }
    let attended: *f32 = work.attended.pointer as *f32;
    let projected: *f32 = work.projected.pointer as *f32;
    let gate: *f32 = work.gate.pointer as *f32;
    let up: *f32 = work.up.pointer as *f32;
    // attention_halves: FP16 keys and values for [prefix | own rows]. Cached
    // prefix rows are already FP16; this call's rows convert once and, in a
    // prefix pass, are stored for later steps.
    let width: i32 = WIDTH as i32;
    let half_row: usize = WIDTH *% (2 as usize);
    let k_half: *u8 = work.attention_halves.pointer;
    let v_half: *u8 = k_half + keys *% half_row;
    let own_bytes: u64 = (valid_rows *% half_row) as u64;
    if prefix_keys != (0 as usize) {
        let prefix_bytes: u64 = (prefix_keys *% half_row) as u64;
        if !ok(cuda::copy(k_half, cache_k, prefix_bytes), "key cache") || !ok(cuda::copy(v_half, cache_v, prefix_bytes), "value cache") {
            return false;
        }
    }
    let own_k: *u8 = k_half + prefix_keys *% half_row;
    let own_v: *u8 = v_half + prefix_keys *% half_row;
    if !ok(cuda::to_half(k, own_k, (valid_rows *% WIDTH) as u64), "keys to half")
        || !ok(cuda::to_half(v, own_v, (valid_rows *% WIDTH) as u64), "values to half") {
        return false;
    }
    if !store_k.is_null() {
        if !ok(cuda::copy(store_k, own_k, own_bytes), "store keys") || !ok(cuda::copy(store_v, own_v, own_bytes), "store values") {
            return false;
        }
    }
    if !ok(cuda::flash_attention(q, k_half, v_half, attended, valid_rows as i32, keys as i32, HEADS as i32,
            rope_offset as i32, causal_rows as i32, visible_keys), "attention") {
        return false;
    }
    if !linear(model, work, block_record(index, ROLE_OUT), attended, projected, rows)
        || !ok(cuda::gated_residual(hidden, projected, modulation + WIDTH, stride, rows as i32, width, split as i32), "attention residual")
        || !ok(cuda::layer_norm_scale(hidden, modulation + (2 as usize) *% WIDTH, stride, normed, rows as i32, width, split as i32), "layer norm")
        || !linear(model, work, block_record(index, ROLE_GATE), normed, gate, rows)
        || !linear(model, work, block_record(index, ROLE_UP), normed, up, rows, true)
        || !ok(cuda::swiglu(gate, up, gate,
            (rows *% MLP) as u64), "swiglu")
        || !linear(model, work, block_record(index, ROLE_DOWN), gate, projected, rows)
        || !ok(cuda::gated_residual(hidden, projected, modulation + (3 as usize) *% WIDTH, stride, rows as i32, width, split as i32), "mlp residual") {
        return false;
    }
    return true;
}

// MARK: - Text prefix and denoising step

// Cached prefix K and V for every block, FP16: [BLOCKS, text_rows, WIDTH] each.
struct PrefixCache {
    text_rows: usize,
    k: cuda::DeviceBuffer,
    v: cuda::DeviceBuffer,
}

// Runs txt_in and all blocks over the text rows (t = 0 modulation, causal
// attention) and returns their per-block keys and values.
fn prefix(ref model: Model, ref work: Work, text_embeddings: *f32, text_rows: usize, rope: *f32) -> option::Option[PrefixCache] {
    let rows: usize = round_rows(text_rows);
    guard let option::Option[cuda::DeviceBuffer]::Some(cache_k) = cuda::DeviceBuffer::allocate(cache_bytes(text_rows) / (2 as u64)) else {
        return option::Option[PrefixCache]::None;
    };
    guard let option::Option[cuda::DeviceBuffer]::Some(cache_v) = cuda::DeviceBuffer::allocate(cache_bytes(text_rows) / (2 as u64)) else {
        return option::Option[PrefixCache]::None;
    };
    let hidden: *f32 = work.hidden.pointer as *f32;
    let normed: *f32 = work.normed.pointer as *f32;
    let scratch_q: *f32 = work.q.pointer as *f32;
    let scratch_k: *f32 = work.k.pointer as *f32;
    if !ok(cuda::zero(work.normed.pointer, (rows *% WIDTH *% (4 as usize)) as u64), "zero")
        || !work.normed.upload(text_embeddings as *u8, (text_rows *% WIDTH *% (4 as usize)) as u64) {
        return option::Option[PrefixCache]::None;
    }
    let text_norm: *f32 = vector(model, TEXT_NORM);
    if text_norm.is_null()
        || !ok(cuda::rms_norm(normed, text_norm, 1.0f32, scratch_q, rows as i32, WIDTH as i32), "text norm") {
        return option::Option[PrefixCache]::None;
    }
    if !linear(model, work, TXT_IN, scratch_q, scratch_k, rows)
        || !ok(cuda::gelu_tanh(scratch_k, scratch_k, (rows *% WIDTH) as u64), "gelu")
        || !linear(model, work, TXT_OUT, scratch_k, hidden, rows)
        || !condition(model, work, 0.0f32) {
        return option::Option[PrefixCache]::None;
    }
    var index: usize = 0 as usize;
    while index < BLOCKS {
        let store_k: *u8 = cache_k.pointer + index *% text_rows *% WIDTH *% (2 as usize);
        let store_v: *u8 = cache_v.pointer + index *% text_rows *% WIDTH *% (2 as usize);
        if !block(model, work, index, rows, text_rows, rows, rope, 0 as usize, 0 as *u8, 0 as *u8,
                0 as usize, text_rows, store_k, store_v) {
            return option::Option[PrefixCache]::None;
        }
        index = index +% (1 as usize);
    }
    return option::Option[PrefixCache]::Some(PrefixCache { text_rows: text_rows, k: cache_k, v: cache_v });
}

// Image-conditioned prefix. `prompt` holds the text encoder's rows ([prompt_rows,
// 4096] host) and `image_pad` marks which of them are image placeholders; each
// placeholder expands to four rows filled, in order, with the packed condition
// latents ([condition_rows, 64] host). The joint prefix is built on the device
// in that order and run with the block-causal mask: text rows see earlier
// rows, condition rows also see the rest of their own image block. Returns the
// per-block keys and values of all prefix rows (cache.text_rows = prefix rows).
fn prefix_conditioned(ref model: Model, ref work: Work, prompt: *f32, image_pad: *u8, prompt_rows: usize,
                      condition_latents: *f32, condition_rows: usize, rope: *f32) -> option::Option[PrefixCache] {
    var pad_rows: usize = 0 as usize;
    var index: usize = 0 as usize;
    while index < prompt_rows {
        if image_pad[index] != (0 as u8) { pad_rows = pad_rows +% (1 as usize); }
        index = index +% (1 as usize);
    }
    if pad_rows *% (4 as usize) != condition_rows {
        io::eprintln("cuda transformer: ${pad_rows} image placeholders do not cover ${condition_rows} condition rows");
        return option::Option[PrefixCache]::None;
    }
    let prefix_rows: usize = prompt_rows -% pad_rows +% condition_rows;
    let text_padded: usize = round_rows(prompt_rows);
    let condition_padded: usize = round_rows(condition_rows);
    let rows: usize = round_rows(prefix_rows);
    if text_padded > work.rows || condition_padded > work.rows || rows > work.rows {
        io::eprintln("cuda transformer: prefix of ${prefix_rows} rows exceeds the activation buffers");
        return option::Option[PrefixCache]::None;
    }
    guard let option::Option[cuda::DeviceBuffer]::Some(cache_k) = cuda::DeviceBuffer::allocate(cache_bytes(prefix_rows) / (2 as u64)) else {
        io::eprintln("cuda transformer: could not allocate the ${prefix_rows}-row prefix key cache");
        return option::Option[PrefixCache]::None;
    };
    guard let option::Option[cuda::DeviceBuffer]::Some(cache_v) = cuda::DeviceBuffer::allocate(cache_bytes(prefix_rows) / (2 as u64)) else {
        io::eprintln("cuda transformer: could not allocate the ${prefix_rows}-row prefix value cache");
        return option::Option[PrefixCache]::None;
    };
    let hidden: *f32 = work.hidden.pointer as *f32;
    let normed: *f32 = work.normed.pointer as *f32;
    let scratch_q: *f32 = work.q.pointer as *f32;
    let scratch_k: *f32 = work.k.pointer as *f32;
    let scratch_v: *f32 = work.v.pointer as *f32;
    // Text rows: txt_in over every prompt row (placeholder rows are discarded).
    if !ok(cuda::zero(work.normed.pointer, (text_padded *% WIDTH *% (4 as usize)) as u64), "zero")
        || !work.normed.upload(prompt as *u8, (prompt_rows *% WIDTH *% (4 as usize)) as u64) {
        return option::Option[PrefixCache]::None;
    }
    let text_norm: *f32 = vector(model, TEXT_NORM);
    if text_norm.is_null()
        || !ok(cuda::rms_norm(normed, text_norm, 1.0f32, scratch_q, text_padded as i32, WIDTH as i32), "text norm") {
        return option::Option[PrefixCache]::None;
    }
    if !linear(model, work, TXT_IN, scratch_q, scratch_k, text_padded)
        || !ok(cuda::gelu_tanh(scratch_k, scratch_k, (text_padded *% WIDTH) as u64), "gelu")
        || !linear(model, work, TXT_OUT, scratch_k, scratch_v, text_padded) {
        return option::Option[PrefixCache]::None;
    }
    // Condition rows: img_in over the packed latents, into k.
    if !ok(cuda::zero(work.q.pointer, (condition_padded *% WIDTH *% (4 as usize)) as u64), "zero")
        || !work.q.upload(condition_latents as *u8, (condition_rows *% LATENT *% (4 as usize)) as u64)
        || !linear(model, work, IMG_IN, scratch_q, scratch_k, condition_padded) {
        return option::Option[PrefixCache]::None;
    }
    // Assemble the joint prefix into hidden and the visible-key count per row.
    guard let option::Option[pack::Buffer]::Some(visible_host) = pack::Buffer::allocate(prefix_rows *% (4 as usize)) else {
        return option::Option[PrefixCache]::None;
    };
    let visible: *i32 = visible_host.pointer as *i32;
    if !ok(cuda::zero(work.hidden.pointer, (rows *% WIDTH *% (4 as usize)) as u64), "zero") {
        return option::Option[PrefixCache]::None;
    }
    let width: i32 = WIDTH as i32;
    var joint: usize = 0 as usize;
    var next_condition: usize = 0 as usize;
    index = 0 as usize;
    while index < prompt_rows {
        if image_pad[index] == (0 as u8) {
            if !ok(cuda::copy_rows(hidden + joint *% WIDTH, width, scratch_v + index *% WIDTH, width, 1 as i32, width), "text row") {
                return option::Option[PrefixCache]::None;
            }
            visible[joint] = (joint +% (1 as usize)) as i32;
            joint = joint +% (1 as usize);
            index = index +% (1 as usize);
        } else {
            // A run of placeholders is one image block of 4 * run rows.
            var run: usize = 0 as usize;
            while index +% run < prompt_rows && image_pad[index +% run] != (0 as u8) { run = run +% (1 as usize); }
            let block_rows: usize = run *% (4 as usize);
            if !ok(cuda::copy_rows(hidden + joint *% WIDTH, width, scratch_k + next_condition *% WIDTH, width,
                    block_rows as i32, width), "condition rows") {
                return option::Option[PrefixCache]::None;
            }
            var row: usize = 0 as usize;
            while row < block_rows {
                visible[joint +% row] = (joint +% block_rows) as i32;
                row = row +% (1 as usize);
            }
            joint = joint +% block_rows;
            next_condition = next_condition +% block_rows;
            index = index +% run;
        }
    }
    guard let option::Option[cuda::DeviceBuffer]::Some(visible_device) = cuda::DeviceBuffer::allocate((prefix_rows *% (4 as usize)) as u64) else {
        return option::Option[PrefixCache]::None;
    };
    if !visible_device.upload(visible_host.pointer, (prefix_rows *% (4 as usize)) as u64) || !condition(model, work, 0.0f32) {
        return option::Option[PrefixCache]::None;
    }
    index = 0 as usize;
    while index < BLOCKS {
        let store_k: *u8 = cache_k.pointer + index *% prefix_rows *% WIDTH *% (2 as usize);
        let store_v: *u8 = cache_v.pointer + index *% prefix_rows *% WIDTH *% (2 as usize);
        if !block(model, work, index, rows, prefix_rows, rows, rope, 0 as usize, 0 as *u8, 0 as *u8,
                0 as usize, prefix_rows, store_k, store_v, visible_device.pointer as *i32) {
            return option::Option[PrefixCache]::None;
        }
        index = index +% (1 as usize);
    }
    return option::Option[PrefixCache]::Some(PrefixCache { text_rows: prefix_rows, k: cache_k, v: cache_v });
}

// One velocity prediction for `image_rows` latent rows ([image_rows, 64] FP32
// on the device) at `timestep` (0..1000), written to work.q as [image_rows, 64].
fn step_device(ref model: Model, ref work: Work, ref cache: PrefixCache, latent: *f32, image_rows: usize,
               timestep: f32, rope: *f32) -> bool {
    let rows: usize = round_rows(image_rows);
    let hidden: *f32 = work.hidden.pointer as *f32;
    let normed: *f32 = work.normed.pointer as *f32;
    let latent_rows: *f32 = work.q.pointer as *f32;
    if !ok(cuda::zero(work.q.pointer, (rows *% WIDTH *% (4 as usize)) as u64), "zero")
        || !ok(cuda::copy(work.q.pointer, latent as *u8, (image_rows *% LATENT *% (4 as usize)) as u64), "latent copy")
        || !linear(model, work, IMG_IN, latent_rows, hidden, rows)
        || !condition(model, work, timestep) {
        return false;
    }
    var index: usize = 0 as usize;
    while index < BLOCKS {
        let cache_k: *u8 = cache.k.pointer + index *% cache.text_rows *% WIDTH *% (2 as usize);
        let cache_v: *u8 = cache.v.pointer + index *% cache.text_rows *% WIDTH *% (2 as usize);
        if !block(model, work, index, rows, image_rows, 0 as usize, rope, cache.text_rows, cache_k, cache_v,
                cache.text_rows, cache.text_rows, 0 as *u8, 0 as *u8) {
            return false;
        }
        index = index +% (1 as usize);
    }
    return ok(cuda::layer_norm_scale(hidden, work.final_scale.pointer as *f32, WIDTH as i32, normed,
            rows as i32, WIDTH as i32, 0 as i32), "final norm")
        && linear(model, work, PROJ_OUT, normed, latent_rows, rows);
}

// Host-memory wrapper around step_device for fixtures.
fn step(ref model: Model, ref work: Work, ref cache: PrefixCache, latent: *f32, image_rows: usize, timestep: f32,
        rope: *f32, output: *f32) -> bool {
    let bytes: u64 = (image_rows *% LATENT *% (4 as usize)) as u64;
    guard let option::Option[cuda::DeviceBuffer]::Some(device_latent) = cuda::DeviceBuffer::allocate(bytes) else { return false; };
    return device_latent.upload(latent as *u8, bytes)
        && step_device(model, work, cache, device_latent.pointer as *f32, image_rows, timestep, rope)
        && cuda::synchronize()
        && work.q.download(output as *u8, bytes);
}

// MARK: - Scheduler

// FlowMatchEulerDiscreteScheduler as configured by the pinned pipeline for a
// distilled pack (shift_terminal none): sigmas linspace(1, 1/steps) shifted
// exponentially by mu, which grows linearly with the image token count from
// 0.5 at 256 tokens to 0.9 at 8192; the final sigma is 0.
fn sigma(index: usize, steps: usize, image_rows: usize) -> f64 {
    if index >= steps { return 0.0f64; }
    let mu: f64 = 0.5f64 + (0.9f64 - 0.5f64) * ((image_rows as f64) - 256.0f64) / (8192.0f64 - 256.0f64);
    let base: f64 = if steps == (1 as usize) { 1.0f64 } else {
        1.0f64 + ((1.0f64 / (steps as f64)) - 1.0f64) * (index as f64) / ((steps -% (1 as usize)) as f64)
    };
    let shift: f64 = mu.exp();
    return shift / (shift + (1.0f64 / base - 1.0f64));
}

// The schedule a pack's `schedule` metadata selects. Packs without one use
// the shifted linspace above.
enum Schedule {
    Shifted,
    QwenTurbo8,
}

fn pack_schedule(pack_path: str) -> Schedule {
    return match pack_info::read(pack_path) {
        option::Option[pack_info::PackInfo]::Some(info) => match info.get("schedule") {
            option::Option[str]::Some(value) => {
                if value == fixed_schedule::QWEN_TURBO_8 { Schedule::QwenTurbo8 } else { Schedule::Shifted }
            }
            option::Option[str]::None => Schedule::Shifted,
        },
        option::Option[pack_info::PackInfo]::None => Schedule::Shifted,
    };
}

fn schedule_sigma(schedule: Schedule, index: usize, steps: usize, image_rows: usize) -> f64 {
    return match schedule {
        Schedule::Shifted => sigma(index, steps, image_rows),
        Schedule::QwenTurbo8 => fixed_schedule::qwen_turbo_8_sigma(index) as f64,
    };
}

// Wall-clock seconds for phase timings (stdlib/time, portable).
fn seconds() -> f64 {
    return (time::now_millis() as f64) * 0.001f64;
}

// Runs every step from `latents` (device, [image_rows, 64]) in place,
// reporting each finished step to `observer`. 0 on success, 1 on a GPU
// failure, 3 when the observer cancels between steps (the pipeline's codes).
fn denoise(ref model: Model, ref work: Work, ref cache: PrefixCache, latents: *f32, image_rows: usize, steps: usize,
           schedule: Schedule, rope: *f32, observer: control::Observer) -> i32 {
    let fixed_steps: bool = match schedule {
        Schedule::QwenTurbo8 => true,
        Schedule::Shifted => false,
    };
    if fixed_steps && steps != fixed_schedule::QWEN_TURBO_8_STEPS {
        control::diagnose(observer, "This Qwen-Image-2.1-Turbo pack runs exactly 8 steps.");
        return 2;
    }
    var index: usize = 0 as usize;
    while index < steps {
        let started: f64 = seconds();
        let current: f64 = schedule_sigma(schedule, index, steps, image_rows);
        let next: f64 = schedule_sigma(schedule, index +% (1 as usize), steps, image_rows);
        if !step_device(model, work, cache, latents, image_rows, (current * 1000.0f64) as f32, rope)
            || !ok(cuda::euler(latents, work.q.pointer as *f32, (next - current) as f32, (image_rows *% LATENT) as u64), "euler")
            || !cuda::synchronize() {
            return 1;
        }
        io::println("step ${index +% (1 as usize)}/${steps}: sigma ${current} -> ${next}, ${seconds() - started} s");
        index = index +% (1 as usize);
        if !control::report(observer, control::Phase::Denoising, index, steps) { return 3; }
    }
    return 0;
}

#[test]
fn distilled_schedule_matches_the_pipeline_at_512() {
    // Pinned pipeline at 1024 image tokens, four steps (tools/dump_oracle_inputs.py).
    assert (sigma(0 as usize, 4 as usize, 1024 as usize) - 1.0f64).abs() < 0.0000001f64;
    assert (sigma(1 as usize, 4 as usize, 1024 as usize) - 0.8371701836585999f64).abs() < 0.0000001f64;
    assert (sigma(2 as usize, 4 as usize, 1024 as usize) - 0.6315121650695801f64).abs() < 0.0000001f64;
    assert (sigma(3 as usize, 4 as usize, 1024 as usize) - 0.363569974899292f64).abs() < 0.0000001f64;
    assert sigma(4 as usize, 4 as usize, 1024 as usize) == 0.0f64;
}

#[test]
fn turbo_schedule_ignores_the_token_count() {
    assert schedule_sigma(Schedule::QwenTurbo8, 0 as usize, 8 as usize, 1024 as usize) == 1.0f64;
    assert schedule_sigma(Schedule::QwenTurbo8, 7 as usize, 8 as usize, 4096 as usize)
        == schedule_sigma(Schedule::QwenTurbo8, 7 as usize, 8 as usize, 1024 as usize);
    assert schedule_sigma(Schedule::QwenTurbo8, 8 as usize, 8 as usize, 1024 as usize) == 0.0f64;
}

// MARK: - Fixture entry point

fn read_floats(path: str, count: usize) -> option::Option[pack::Buffer] {
    let fd: i32 = file_io::open_read(path);
    if fd < (0 as i32) {
        io::eprintln("cuda transformer: could not open ${path}");
        return option::Option[pack::Buffer]::None;
    }
    let size: i64 = file_io::size(fd);
    guard let option::Option[pack::Buffer]::Some(buffer) = pack::Buffer::allocate(count *% (4 as usize)) else {
        let _closed: i32 = file_io::close(fd);
        return option::Option[pack::Buffer]::None;
    };
    let complete: bool = size == (count *% (4 as usize)) as i64 && pack::read_exact(fd, buffer.pointer, buffer.length, 0 as u64);
    let _closed: i32 = file_io::close(fd);
    if !complete {
        io::eprintln("cuda transformer: ${path} is not ${count} floats");
        return option::Option[pack::Buffer]::None;
    }
    return option::Option[pack::Buffer]::Some(buffer);
}

// Runs the 256px trajectory fixture (22 text rows, 256 image rows) through the
// text prefix and one step with `latent_file` at `timestep`, and writes the
// [256, 64] noise prediction to `output_path` as raw FP32.
fn run_fixture(pack_path: str, mode: WeightMode, fixture: str, latent_file: str, timestep: f32, output_path: str) -> i32 {
    let text_rows: usize = 22 as usize;
    let image_rows: usize = 256 as usize;
    guard let option::Option[pack::Buffer]::Some(text_input) = read_floats("${fixture}/text_input.f32", text_rows *% WIDTH) else { return 1; };
    guard let option::Option[pack::Buffer]::Some(latent) = read_floats(latent_file, image_rows *% LATENT) else { return 1; };
    guard let option::Option[pack::Buffer]::Some(rope_host) = read_floats("${fixture}/rope.f32", (text_rows +% image_rows) *% (128 as usize)) else { return 1; };
    guard let option::Option[cuda::DeviceBuffer]::Some(rope) = cuda::DeviceBuffer::allocate(rope_host.length as u64) else { return 1; };
    if !rope.upload(rope_host.pointer, rope_host.length as u64) { return 1; }
    guard let option::Option[Model]::Some(loaded) = load(pack_path, mode) else { return 1; };
    var model: Model = loaded;
    guard let option::Option[Work]::Some(allocated) = allocate_work(image_rows, text_rows +% image_rows) else {
        io::eprintln("cuda transformer: could not allocate activations");
        return 1;
    };
    var work: Work = allocated;
    guard let option::Option[PrefixCache]::Some(computed) = prefix(model, work, text_input.pointer as *f32, text_rows, rope.pointer as *f32) else {
        return 1;
    };
    var cache: PrefixCache = computed;
    guard let option::Option[pack::Buffer]::Some(result) = pack::Buffer::allocate(image_rows *% LATENT *% (4 as usize)) else { return 1; };
    if !step(model, work, cache, latent.pointer as *f32, image_rows, timestep, rope.pointer as *f32, result.pointer as *f32) {
        return 1;
    }
    let fd: i32 = file_io::create(output_path);
    if fd < (0 as i32) { return 1; }
    let written: bool = pack::write_exact(fd, result.pointer, result.length, 0 as u64);
    let _closed: i32 = file_io::close(fd);
    if !written { return 1; }
    io::println("cuda transformer: wrote ${output_path}");
    return 0;
}

fn file_floats(path: str) -> usize {
    let fd: i32 = file_io::open_read(path);
    if fd < (0 as i32) { return 0 as usize; }
    let size: i64 = file_io::size(fd);
    let _closed: i32 = file_io::close(fd);
    return if size <= (0 as i64) { 0 as usize } else { (size as usize) / (4 as usize) };
}

fn write_floats(path: str, data: *u8, bytes: usize) -> bool {
    let fd: i32 = file_io::create(path);
    if fd < (0 as i32) { return false; }
    let written: bool = pack::write_exact(fd, data, bytes, 0 as u64);
    let _closed: i32 = file_io::close(fd);
    return written;
}

// Denoises from a tools/dump_oracle_inputs.py directory (prompt_embeds.f32,
// noise.f32, rope.f32) and writes the final [image_rows, 64] latents.
fn run_oracle_dump(pack_path: str, mode: WeightMode, dump: str, steps: usize, output_path: str) -> i32 {
    let process_start: f64 = seconds();
    let text_rows: usize = file_floats("${dump}/prompt_embeds.f32") / WIDTH;
    let image_rows: usize = file_floats("${dump}/noise.f32") / LATENT;
    if text_rows == (0 as usize) || image_rows == (0 as usize) {
        io::eprintln("cuda transformer: ${dump} has no prompt_embeds.f32 or noise.f32");
        return 1;
    }
    guard let option::Option[pack::Buffer]::Some(text_input) = read_floats("${dump}/prompt_embeds.f32", text_rows *% WIDTH) else { return 1; };
    guard let option::Option[pack::Buffer]::Some(noise) = read_floats("${dump}/noise.f32", image_rows *% LATENT) else { return 1; };
    guard let option::Option[pack::Buffer]::Some(rope_host) = read_floats("${dump}/rope.f32", (text_rows +% image_rows) *% (128 as usize)) else { return 1; };
    guard let option::Option[cuda::DeviceBuffer]::Some(rope) = cuda::DeviceBuffer::allocate(rope_host.length as u64) else { return 1; };
    guard let option::Option[cuda::DeviceBuffer]::Some(latents) = cuda::DeviceBuffer::allocate(noise.length as u64) else { return 1; };
    if !rope.upload(rope_host.pointer, rope_host.length as u64) || !latents.upload(noise.pointer, noise.length as u64) { return 1; }
    var started: f64 = seconds();
    guard let option::Option[Model]::Some(loaded) = load(pack_path, mode) else { return 1; };
    var model: Model = loaded;
    guard let option::Option[Work]::Some(allocated) = allocate_work(if image_rows > text_rows { image_rows } else { text_rows },
            text_rows +% image_rows) else {
        io::eprintln("cuda transformer: could not allocate activations");
        return 1;
    };
    var work: Work = allocated;
    let _synced: bool = cuda::synchronize();
    io::println("load: ${seconds() - started} s");
    started = seconds();
    guard let option::Option[PrefixCache]::Some(computed) = prefix(model, work, text_input.pointer as *f32, text_rows, rope.pointer as *f32) else {
        return 1;
    };
    var cache: PrefixCache = computed;
    let _prefix_synced: bool = cuda::synchronize();
    io::println("text prefix (${text_rows} rows): ${seconds() - started} s");
    started = seconds();
    if denoise(model, work, cache, latents.pointer as *f32, image_rows, steps, pack_schedule(pack_path),
               rope.pointer as *f32, control::none()) != (0 as i32) { return 1; }
    io::println("denoise (${steps} steps, ${image_rows} image rows): ${seconds() - started} s");
    guard let option::Option[pack::Buffer]::Some(result) = pack::Buffer::allocate(noise.length) else { return 1; };
    if !latents.download(result.pointer, noise.length as u64) || !write_floats(output_path, result.pointer, result.length) { return 1; }
    io::println("total: ${seconds() - process_start} s; wrote ${output_path}");
    return 0;
}

// Denoises an image edit from a tools/dump_oracle_edit.py directory
// (prompt_embeds.f32, image_pad_mask.u8, condition_latents.f32, noise.f32,
// rope.f32) and writes the final [target_rows, 64] latents.
fn run_edit_dump(pack_path: str, mode: WeightMode, dump: str, steps: usize, output_path: str) -> i32 {
    let process_start: f64 = seconds();
    let prompt_rows: usize = file_floats("${dump}/prompt_embeds.f32") / WIDTH;
    let condition_rows: usize = file_floats("${dump}/condition_latents.f32") / LATENT;
    let image_rows: usize = file_floats("${dump}/noise.f32") / LATENT;
    if prompt_rows == (0 as usize) || condition_rows == (0 as usize) || image_rows == (0 as usize) {
        io::eprintln("cuda transformer: ${dump} is missing edit inputs");
        return 1;
    }
    guard let option::Option[pack::Buffer]::Some(prompt) = read_floats("${dump}/prompt_embeds.f32", prompt_rows *% WIDTH) else { return 1; };
    // image_pad_mask.u8 has prompt_rows bytes; read it as prompt_rows / 4 floats' worth of bytes.
    guard let option::Option[pack::Buffer]::Some(pad) = pack::Buffer::allocate(prompt_rows) else { return 1; };
    let pad_fd: i32 = file_io::open_read("${dump}/image_pad_mask.u8");
    if pad_fd < (0 as i32) { return 1; }
    let pad_read: bool = pack::read_exact(pad_fd, pad.pointer, prompt_rows, 0 as u64);
    let _pad_closed: i32 = file_io::close(pad_fd);
    if !pad_read { return 1; }
    guard let option::Option[pack::Buffer]::Some(condition_latents) = read_floats("${dump}/condition_latents.f32", condition_rows *% LATENT) else { return 1; };
    guard let option::Option[pack::Buffer]::Some(noise) = read_floats("${dump}/noise.f32", image_rows *% LATENT) else { return 1; };
    var pad_rows: usize = 0 as usize;
    var index: usize = 0 as usize;
    while index < prompt_rows {
        if pad.pointer[index] != (0 as u8) { pad_rows = pad_rows +% (1 as usize); }
        index = index +% (1 as usize);
    }
    let prefix_rows: usize = prompt_rows -% pad_rows +% condition_rows;
    guard let option::Option[pack::Buffer]::Some(rope_host) = read_floats("${dump}/rope.f32", (prefix_rows +% image_rows) *% (128 as usize)) else { return 1; };
    guard let option::Option[cuda::DeviceBuffer]::Some(rope) = cuda::DeviceBuffer::allocate(rope_host.length as u64) else { return 1; };
    guard let option::Option[cuda::DeviceBuffer]::Some(latents) = cuda::DeviceBuffer::allocate(noise.length as u64) else { return 1; };
    if !rope.upload(rope_host.pointer, rope_host.length as u64) || !latents.upload(noise.pointer, noise.length as u64) { return 1; }
    var started: f64 = seconds();
    let largest: usize = if prefix_rows > image_rows { prefix_rows } else { image_rows };
    guard let option::Option[Work]::Some(allocated) = allocate_work(if largest > prompt_rows { largest } else { prompt_rows },
            prefix_rows +% image_rows) else {
        io::eprintln("cuda transformer: could not allocate activations");
        return 1;
    };
    var work: Work = allocated;
    guard let option::Option[Model]::Some(loaded) = load(pack_path, mode, true, cache_bytes(prefix_rows)) else { return 1; };
    var model: Model = loaded;
    let _synced: bool = cuda::synchronize();
    io::println("load: ${seconds() - started} s");
    started = seconds();
    guard let option::Option[PrefixCache]::Some(computed) = prefix_conditioned(model, work, prompt.pointer as *f32, pad.pointer,
            prompt_rows, condition_latents.pointer as *f32, condition_rows, rope.pointer as *f32) else {
        return 1;
    };
    var cache: PrefixCache = computed;
    let _prefix_synced: bool = cuda::synchronize();
    io::println("conditioned prefix (${prefix_rows} rows: ${prompt_rows -% pad_rows} text, ${condition_rows} condition): ${seconds() - started} s");
    started = seconds();
    if denoise(model, work, cache, latents.pointer as *f32, image_rows, steps, pack_schedule(pack_path),
               rope.pointer as *f32, control::none()) != (0 as i32) { return 1; }
    io::println("denoise (${steps} steps, ${image_rows} image rows): ${seconds() - started} s");
    guard let option::Option[pack::Buffer]::Some(result) = pack::Buffer::allocate(noise.length) else { return 1; };
    if !latents.download(result.pointer, noise.length as u64) || !write_floats(output_path, result.pointer, result.length) { return 1; }
    io::println("total: ${seconds() - process_start} s; wrote ${output_path}");
    return 0;
}
