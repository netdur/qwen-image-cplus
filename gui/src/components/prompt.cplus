import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/component" as component;
import "facet/text_area" as text_area;
import "events/events" as events;
import "stdlib/option" as option;
import "../new_image" as new_image;
import "./style" as style;

struct Prompt {
    clear_sub: events::SignalSubscription[new_image::Change],
}

impl Prompt {
    fn new() -> Prompt {
        return Prompt {
            clear_sub: events::SignalSubscription[new_image::Change]::none(),
        };
    }

    fn on_new(ref this, _change: new_image::Change) {
        match text_area::find("prompt:input") {
            option::Option[text_area::TextArea]::Some(input) => {
                let _input: text_area::TextArea = input.set_text("");
            }
            option::Option::None => {}
        }
    }
}

impl Prompt: component::Component {
    fn build(ref this) -> core::Node {
        let content: core::Node = @ui {
            column(key: "prompt:card") {
                style::caption("PROMPT", "prompt:title")
                text_area("", key: "prompt:input")
                    .height(126.0f64)
                    .grow(1.0f64)
                    .shrink(1.0f64)
            }
            .gap(10.0f64)
        };
        return style::card(content);
    }
}

impl Prompt: component::Lifecycle {
    fn on_attach(ref this, why: component::Attach) {
        if why == component::Attach::Mount {
            this.clear_sub = new_image::watch(this.on_new);
        }
    }
    fn on_detach(ref this, why: component::Detach) {
        if why == component::Detach::Unmount {
            let _cancelled: bool = this.clear_sub.cancel();
        }
    }
}

impl Prompt: core::IntoNode {
    fn into_node(take this) -> core::Node {
        return component::child::[Prompt](this);
    }
}

fn prompt() -> Prompt { return Prompt::new(); }
