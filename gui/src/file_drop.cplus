// File drops onto a facet node's native view: `install` calls `handler` with
// each dropped file path, first with `commit` false (may it be dropped?) and
// then true (it was). macOS and Linux have their own files; on any other
// platform drops are not offered and the app's buttons remain the way in.

import "stdlib/text" as text;

fn install(view: *u8, class_name: *u8,
handler: fn(text::Text, bool, *u8) -> bool, context: *u8 = 0 as *u8) {
    return;
}

fn clear(view: *u8) {
    return;
}
