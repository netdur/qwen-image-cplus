// Native interactions on macOS (AppKit): NSSavePanel, the prompt editor as
// initial first responder, and the text-field editor kept in step. Same
// surface as native_ui.cplus.

import "appkit/appkit" as ak;
import "foundation/foundation" as foundation;
import "facet/text_area" as text_area;
import "objc/runtime" as rt;
import "stdlib/option" as option;
import "stdlib/status" as status;
import "stdlib/text" as text;
import "stdlib/vec" as vec;

fn choose_save_path(suggested: str, on_chosen: fn(text::Text, *u8), context: *u8) -> bool {
    let panel: ak::SavePanel = ak::SavePanel::save_panel();
    panel.set_title("Save Image");
    panel.set_prompt("Save");
    panel.set_name_field_string_value(suggested);
    var types: vec::Vec[text::Text] = vec::new::[text::Text]();
    let _added: status::Status = types.append("png".to_text());
    panel.set_allowed_file_types(types);
    if panel.run_modal() != (1 as i64) { return true; }
    guard let option::Option[ak::URL]::Some(url) = panel.u_r_l() else { return true; };
    guard let option::Option[text::Text]::Some(destination) =
        foundation::URL::from_raw(url.raw()).path() else { return true; };
    on_chosen(destination, context);
    return true;
}

fn focus_prompt(input: text_area::TextArea) -> bool {
    let native: *u8 = input.native();
    if native.is_null() { return false; }
    match ak::ScrollView::from_raw(native).document_view() {
        option::Option[ak::View]::Some(editor) => {
            match editor.window() {
                option::Option[ak::Window]::Some(window) => {
                    window.set_initial_first_responder(editor);
                    return window.make_first_responder(editor.as_responder());
                }
                option::Option::None => {}
            }
        }
        option::Option::None => {}
    }
    return false;
}

fn sync_field_editor(sender: *u8, value: str, caret: u64) {
    if sender.is_null() { return; }
    match ak::TextField::from_raw(sender).as_control().current_editor() {
        option::Option[ak::Text]::Some(editor) => {
            editor.set_string(value);
            editor.set_selected_range(rt::Range { location: caret, length: 0 as u64 });
        }
        option::Option::None => {}
    }
}
