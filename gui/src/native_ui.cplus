// The few native interactions facet does not cover. macOS (AppKit) and Linux
// (GTK 4) have their own files with this surface; this base serves any other
// platform.

import "facet/text_area" as text_area;
import "stdlib/text" as text;

// Asks where to save a PNG, starting from `suggested`, and calls `on_chosen`
// with the chosen path (never, if the user cancels). False when no dialog is
// available.
fn choose_save_path(suggested: str, on_chosen: fn(text::Text, *u8), context: *u8) -> bool {
    return false;
}

// Puts keyboard focus in the prompt editor; true when it took.
fn focus_prompt(input: text_area::TextArea) -> bool {
    let _focused: text_area::TextArea = input.focus();
    return true;
}

// Keeps a native field editor in step after the text was rewritten while it
// is being edited (AppKit keeps its own copy); nothing to do elsewhere.
fn sync_field_editor(sender: *u8, value: str, caret: u64) {
    return;
}
